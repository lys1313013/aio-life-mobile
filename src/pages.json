      { "pagePath": "pages/home/index", "text": "首页", "iconPath": "static/tabs/home.png", "selectedIconPath": "static/tabs/home-active.png" },
      { "pagePath": "pages/time/index", "text": "时迹", "iconPath": "static/tabs/time.png", "selectedIconPath": "static/tabs/time-active.png" },
      { "pagePath": "pages/profile/index", "text": "我的", "iconPath": "static/tabs/profile.png", "selectedIconPath": "static/tabs/profile-active.png" }
    ]
  }
