{
  "pages": [
    { "path": "pages/home/index", "style": { "navigationBarTitleText": "首页" } },
    { "path": "pages/time/index", "style": { "navigationBarTitleText": "时迹" } },
    { "path": "pages/profile/index", "style": { "navigationBarTitleText": "我的" } },
