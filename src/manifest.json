{
  "name": "AIO Life",
  "appid": "",
  "description": "记录生活，留住每一天。",
  "versionName": "0.1.0",
  "versionCode": 100,
  "vueVersion": "3",
  "uni-app-x": {
    "vapor": true,
    "styleIsolationVersion": "2",
    "vapor-render-target": "bytecode"
  },
  "app": {
    "defaultAppTheme": "auto"
  },
  "web": {
    "router": {
      "mode": "hash"
    },
    "title": "AIO Life",
    "darkmode": true
  },
  "mp-weixin": {
    "appid": "",
    "darkmode": true,
    "themeLocation": "theme.json",
    "setting": {
      "urlCheck": true
    },
    "usingComponents": true,
    "resizable": true,
    "lazyCodeLoading": "requiredComponents",
    "optimization": {
      "subPackages": true
    }
  },
  "uniStatistics": {
    "enable": false
  }
}
