<script setup lang="ts">
import { inject } from 'vue';
import { isDark, themeClass } from '../services/theme.ts';
import AppIcon from './AppIcon.uvue';
const props = withDefaults(
  defineProps<{
    label: string;
    icon?: string;
    loading?: boolean;
    disabled?: boolean;
    danger?: boolean;
    compact?: boolean;
    variant?: string;
  }>(),
  { variant: 'primary' },
);
const emit = defineEmits(['click']);
const insideModal = inject('mobile-modal', false);
function activate() {
  if (!props.loading && !props.disabled) emit('click');
}
</script>
<template>
  <button
    role="button"
    class="mobile-button"
    :class="[
      {
        'mobile-button-quiet': variant === 'quiet',
        'mobile-button-ghost': variant === 'ghost',
        'mobile-button-danger': danger,
        'mobile-button-icon': !!icon,
        'mobile-button-compact': compact,
        'mobile-button-modal': insideModal && !icon && !compact,
        'mobile-button-modal-quiet': insideModal && !icon && !compact && variant === 'quiet' && !danger,
      },
      themeClass([
        'mobile-button',
        { 'mobile-button-quiet': variant === 'quiet', 'mobile-button-ghost': variant === 'ghost', 'mobile-button-danger': danger,
          'mobile-button-modal-quiet': insideModal && !icon && !compact && variant === 'quiet' && !danger },
      ]),
    ]"
    :aria-label="label"
    :aria-busy="loading"
    :aria-disabled="loading || disabled"
    :loading="loading"
    :disabled="loading || disabled"
    :hover-class="variant === 'ghost' ? 'none' : 'button-hover'"
    @click="activate"
  >
    <AppIcon
      v-if="icon && !loading"
      :name="icon"
      :size="20"
      :color="danger || (variant !== 'quiet' && variant !== 'ghost') ? '#ffffff' : isDark ? '#e2e4e9' : '#52525b'"
    />
    <slot v-else-if="!icon"><text
      class="mobile-button-label"
      :class="[
        { 'mobile-button-label-muted': !danger && (variant === 'quiet' || variant === 'ghost') },
        themeClass({ 'mobile-button-label-muted': !danger && (variant === 'quiet' || variant === 'ghost') }),
      ]"
    >{{ label }}</text></slot>
  </button>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
.mobile-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: $space-controlMin;
  min-width: $space-controlMin;
  padding: 0 $space-card;
  margin: 0;
  border-radius: 12px;
  background-color: #427bea;
  color: #ffffff;
  @include type-style('body');
  line-height: $space-controlMin;
}
.mobile-button-quiet {
  background-color: #eef2f8;
  color: #334155;
}
.mobile-button-label {
  @include type-style('body');
  letter-spacing: type-tracking('normal');
  color: #ffffff;
}
.mobile-button-label-muted { color: #334155; }
.mobile-button-label-muted-dark { color: #eeeeef; }
.mobile-button-modal {
  box-sizing: border-box;
  min-width: $space-modalActionMin;
  min-height: $space-controlMin;
  padding: 0 $space-modal;
  border-radius: 10px;
  flex-shrink: 0;
}
.mobile-button-danger {
  background-color: #dc3545;
  color: #ffffff;
}
.mobile-button-icon {
  padding: 0;
  width: 44px;
  @include type-style('glyph-medium');
}
.mobile-button-dark {
  background-color: #315b9c;
  color: #ffffff;
}
.mobile-button-quiet-dark {
  background-color: #292c32;
  color: #eeeeef;
}
.mobile-button-danger-dark {
  background-color: #c94050;
  color: #ffffff;
}
.mobile-button-ghost {
  background-color: transparent;
  color: #52525b;
}
.mobile-button-ghost-dark {
  background-color: transparent;
  color: #e2e4e9;
}
.mobile-button-compact {
  // 可见按钮为 32px 高，透明边缘保留至少 44px 的触摸区域。
  box-sizing: border-box;
  height: $space-controlMin;
  padding: 0 $space-inline;
  border: $space-fieldLabel solid transparent;
  background-clip: padding-box;
  border-radius: 14px;
  @include type-style('body');
  line-height: type-leading('compactControl');
}
.mobile-button-modal-quiet {
  background-color: transparent;
  border: $space-hairline solid #e5e7eb;
}
.mobile-button-modal-quiet-dark {
  border-color: #32353c;
}
/* #ifdef WEB || MP-WEIXIN */
.mobile-button::after {
  border: 0;
}
/* #endif */
</style>
