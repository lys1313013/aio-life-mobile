<script setup lang="ts">
import { computed, inject } from 'vue';
import { isDark, themeClass } from '../services/theme.ts';
import AppIcon from './AppIcon.uvue';
const props = withDefaults(
  defineProps<{
    label: string;
    icon?: string;
    loading?: boolean;
    disabled?: boolean;
    danger?: boolean;
    compact?: boolean;
    variant?: string;
  }>(),
  { variant: 'primary' },
);
const emit = defineEmits(['click']);
const insideModal = inject('mobile-modal', false);
// 行内背景覆盖 uni-app 的 disabled/type 默认底色，跨端保留组件自身的主题与变体。
const backgroundColor = computed(() => {
  if (props.danger) return isDark.value ? '#c94050' : '#dc3545';
  if (props.variant === 'ghost' || (insideModal && props.variant === 'quiet' && !props.icon && !props.compact)) return 'transparent';
  if (props.variant === 'quiet') return isDark.value ? '#292c32' : '#eef2f8';
  return isDark.value ? '#315b9c' : '#427bea';
});
function activate() {
  if (!props.loading && !props.disabled) emit('click');
}
</script>
<template>
  <button
    role="button"
    class="mobile-button"
    :class="[
      {
        'mobile-button-disabled': disabled && !loading,
        'mobile-button-quiet': variant === 'quiet',
        'mobile-button-ghost': variant === 'ghost',
        'mobile-button-danger': danger,
        'mobile-button-icon': !!icon,
        'mobile-button-compact': compact,
        'mobile-button-modal': insideModal && !icon && !compact,
        'mobile-button-modal-quiet': insideModal && !icon && !compact && variant === 'quiet' && !danger,
      },
      themeClass([
        'mobile-button',
        { 'mobile-button-quiet': variant === 'quiet', 'mobile-button-ghost': variant === 'ghost', 'mobile-button-danger': danger,
          'mobile-button-modal-quiet': insideModal && !icon && !compact && variant === 'quiet' && !danger },
      ]),
    ]"
    :style="{ backgroundColor }"
    :aria-label="label"
    :aria-busy="loading"
    :aria-disabled="loading || disabled"
    :disabled="loading || disabled"
    :hover-class="loading || disabled ? 'none' : 'mobile-button-pressed'"
    @click="activate"
  >
    <view v-if="loading" class="mobile-button-loading" aria-hidden="true"><view class="mobile-button-spinner" :class="{ 'mobile-button-spinner-muted': !danger && (variant === 'quiet' || variant === 'ghost') }" /></view>
    <view class="mobile-button-content" :class="{ 'mobile-button-content-loading': loading }">
    <AppIcon
      v-if="icon"
      :name="icon"
      :size="20"
      :color="danger || (variant !== 'quiet' && variant !== 'ghost') ? '#ffffff' : isDark ? '#e2e4e9' : '#52525b'"
    />
    <slot v-else-if="!icon"><text
      class="mobile-button-label"
      :class="[
        { 'mobile-button-label-muted': !danger && (variant === 'quiet' || variant === 'ghost') },
        themeClass({ 'mobile-button-label-muted': !danger && (variant === 'quiet' || variant === 'ghost') }),
      ]"
    >{{ label }}</text></slot>
    </view>
  </button>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
.mobile-button {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: $space-controlMin;
  min-width: $space-controlMin;
  padding: 0 $space-card;
  margin: 0;
  border-radius: 12px;
  color: #ffffff;
  @include type-style('body');
  line-height: $space-controlMin;
}
.mobile-button-quiet {
  color: #334155;
}
.mobile-button-label {
  @include type-style('body');
  letter-spacing: type-tracking('normal');
  color: #ffffff;
}
.mobile-button-label-muted { color: #334155; }
.mobile-button-label-muted-dark { color: #eeeeef; }
.mobile-button-modal {
  box-sizing: border-box;
  min-width: $space-modalActionMin;
  min-height: $space-controlMin;
  padding: 0 $space-modal;
  border-radius: 10px;
  flex-shrink: 0;
}
.mobile-button-danger {
  color: #ffffff;
}
.mobile-button-icon {
  padding: 0;
  width: 44px;
  @include type-style('glyph-medium');
}
.mobile-button-dark {
  color: #ffffff;
}
.mobile-button-quiet-dark {
  color: #eeeeef;
}
.mobile-button-danger-dark {
  color: #ffffff;
}
.mobile-button-ghost {
  color: #52525b;
}
.mobile-button-ghost-dark {
  color: #e2e4e9;
}
.mobile-button-compact {
  // 可见按钮为 32px 高，透明边缘保留至少 44px 的触摸区域。
  box-sizing: border-box;
  height: $space-controlMin;
  padding: 0 $space-inline;
  border: $space-fieldLabel solid transparent;

/* #ifndef APP */
background-clip: padding-box;
/* #endif */

  border-radius: 14px;
  @include type-style('body');
  line-height: type-leading('compactControl');
}
.mobile-button-modal-quiet {
  border: $space-hairline solid #e5e7eb;
}
.mobile-button-modal-quiet-dark {
  border-color: #32353c;
}
.mobile-button-content { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.mobile-button-content-loading { opacity: 0; }
.mobile-button-loading { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.mobile-button-spinner { width: 18px; height: 18px; box-sizing: border-box; border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #ffffff; border-radius: 50%; animation: mobile-button-spin 0.8s linear infinite; }
.mobile-button-spinner-muted { border-color: rgba(139, 143, 153, 0.3); border-top-color: #8b8f99; }
.mobile-button-disabled { opacity: 0.5; }
.mobile-button-pressed { opacity: 0.75; }
@keyframes mobile-button-spin { to { transform: rotate(360deg); } }
/* #ifdef WEB || MP-WEIXIN */
.mobile-button::after {
  border: 0;
}
/* #endif */
</style>
