<script setup lang="ts">
const props = defineProps<{ label: string; loading?: boolean; disabled?: boolean }>()
const emit = defineEmits<{ refresh: [] }>()
function activate() { if (!props.loading && !props.disabled) emit('refresh') }
</script>
<template>
  <view class="home-card-header">
    <button role="button" tabindex="0" class="home-card-refresh home-card-drag-area" :aria-label="label" :aria-busy="loading" :disabled="loading || disabled" @click.stop="activate" @keydown.enter.stop.prevent="activate" @keydown.space.stop.prevent="activate" />
    <slot />
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
.home-card-header { position: relative; height: $space-controlMin; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 $space-card; }
// 空白按钮铺在标题与操作下方，既可点按刷新，也可长按整卡排序。
.home-card-refresh { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background-color: transparent; border-radius: 0; }
/* #ifdef WEB || MP-WEIXIN */
.home-card-refresh::after { border: 0; }
/* #endif */
/* #ifdef WEB */
.home-card-refresh:focus-visible { outline: 2px solid #5879ce; outline-offset: -2px; }
/* #endif */
</style>
