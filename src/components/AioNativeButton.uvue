<script setup lang="ts">
const props = withDefaults(defineProps<{ disabled?: boolean; loading?: boolean; hoverClass?: string }>(), {
  disabled: false, loading: false, hoverClass: 'aio-native-button-hover',
})
const emit = defineEmits(['click'])
function activate(event) {
  if (props.disabled || props.loading) return
  emit('click', event)
}
</script>
<template>
  <view role="button" class="aio-native-button"
    :class="{ 'aio-native-button-disabled': disabled }"
    :aria-disabled="disabled || loading" :aria-busy="loading"
    :hover-class="disabled || loading ? 'none' : hoverClass" @click="activate">
    <view v-if="loading" class="aio-native-button-spinner" />
    <slot />
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
// 这里只负责点击和禁用行为。布局由原按钮的 class/style 负责：
// 快捷导航是纵向排列，时间轴记录按分钟决定高度，不能统一强制横排或 44px 高度。
.aio-native-button-disabled { opacity: 0.5; }
.aio-native-button-hover { opacity: 0.75; }
.aio-native-button-spinner { width: 16px; height: 16px; margin-right: $space-detail; border-radius: 8px; border: 2px solid #94a3b8; border-top-color: #ffffff; animation: aio-button-spin 0.8s linear infinite; }
@keyframes aio-button-spin { to { transform: rotate(360deg); } }
</style>
