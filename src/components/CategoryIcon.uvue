<script setup lang="ts">
import { computed } from 'vue'
import catalog from '../services/icons/category-icons.json'
import actionIcons from '../services/icons/action-icons.json'
const props = defineProps<{ icon?: string; color?: string; size?: number }>()
const color = computed(() =>
  /^#[\da-f]{3,8}$/i.test(props.color || '') ? props.color : '#94a3b8',
)
const source = computed(() => {
  const item = actionIcons.icons[props.icon || ''] || catalog.icons[props.icon || '']
  if (!item) return ''
  const body = item.body.replace(/currentColor/g, color.value || '#94a3b8')
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' +
    item.width +
    '" height="' +
    item.height +
    '" viewBox="0 0 ' +
    item.width +
    ' ' +
    item.height +
    '">' +
    body +
    '</svg>'
  const bytes = new Uint8Array(svg.length)
  for (let i = 0; i < svg.length; i++) bytes[i] = svg.charCodeAt(i)
  return 'data:image/svg+xml;base64,' + uni.arrayBufferToBase64(bytes.buffer)
})
</script>
<template>
  <view
    class="category-icon"
    :style="{ width: (size || 24) + 'px', height: (size || 24) + 'px' }"
  >
    <image
      v-if="source"
      class="category-icon-image"
      :src="source"
      mode="aspectFit"
    />
    <view
      v-else
      class="category-icon-dot"
      :style="{ backgroundColor: color }"
    />
  </view>
</template>
<style scoped>
.category-icon {
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.category-icon-image {
  width: 100%;
  height: 100%;
}
.category-icon-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}
</style>
