<script setup lang="ts">
import { computed } from 'vue'
import catalog from '../services/icons/catalog.ts'
import { iconSource } from '../services/icon-source.ts'
const props = defineProps<{ icon?: string; color?: string; size?: number }>()
const color = computed(() =>
  /^#[\da-f]{3,8}$/i.test(props.color || '') ? props.color : '#94a3b8',
)
const source = computed(() => {
  const item = catalog.icons[props.icon || '']
  if (!item) return ''
  const body = item.body.replace(/currentColor/g, color.value || '#94a3b8')
  const svg =
    '<svg xmlns="http://www.w3.org/2000/svg" width="' +
    item.width +
    '" height="' +
    item.height +
    '" viewBox="' + (item.left || 0) + ' ' + (item.top || 0) + ' ' +
    item.width +
    ' ' +
    item.height +
    '">' +
    body +
    '</svg>'
  return iconSource(svg, props.size || 24)
})
</script>
<template>
  <view
    class="category-icon"
    :style="{ width: (size || 24) + 'px', height: (size || 24) + 'px' }"
  >
    <image
      v-if="source"
      class="category-icon-image"
      :style="{ width: (size || 24) + 'px', height: (size || 24) + 'px' }"
      :src="source"
      mode="aspectFit"
    />
    <view
      v-else
      class="category-icon-dot"
      :style="{ backgroundColor: color }"
    />
  </view>
</template>
<style scoped>
.category-icon {
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.category-icon-image {
  width: 100%;
  height: 100%;
}
.category-icon-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}
</style>
