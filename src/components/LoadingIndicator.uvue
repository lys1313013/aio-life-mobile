  <view class="loading-indicator" :class="[{ 'loading-indicator-compact': compact, 'loading-indicator-floating': floating }, themeClass({ 'loading-indicator-floating': floating })]" role="status" :aria-label="label" aria-live="polite">
    <view v-if="floating" class="loading-spinner" :class="themeClass('loading-spinner')" />
    <view v-else class="loading-track" :class="themeClass('loading-track')"><view class="loading-runner" :class="themeClass('loading-runner')" /></view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
.loading-indicator { width: 100%; padding: $space-inline 0; }
