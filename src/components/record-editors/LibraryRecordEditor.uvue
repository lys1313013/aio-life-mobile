<script setup lang="ts">
import ModalMotion from "../ModalMotion.uvue";
import { ref, watch } from 'vue';
import { session } from '../../services/session.ts';
import FormSkeleton from '../FormSkeleton.uvue';
import AdaptiveModal from '../AdaptiveModal.uvue';
import FormField from '../FormField.uvue';
import FormActions from '../FormActions.uvue';
import MobileButton from '../MobileButton.uvue';
import ConfirmAction from '../ConfirmAction.uvue';
import { isRequired } from '../../services/form-required.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { request } from '../../services/api.ts';
import AttachmentField from '../AttachmentField.uvue';
import LibraryCover from '../LibraryCover.uvue';
import { statuses } from '../../services/records/contracts.ts';
import { applyLibraryParse, libraryDraft, libraryPayload, setLibraryCover } from '../../services/records/library-form.ts';
const modalMotion0 = ref<{ close: () => void } | null>(null);

const props = defineProps<{ record?: any; loading?: boolean; loadError?: string }>();
const typeLabels = ['电影', '剧集', '动漫', '纪录片', '其他'];
const statusLabels = ['想看', '在看', '看过', '搁置'];
const emit = defineEmits(['close', 'saved', 'deleted', 'retry']);
const form = ref<any>(null), saving = ref(false), deleting = ref(false), formError = ref('');
const scope = createRecordScope(() => emit('close'));
watch(() => session.token, () => emit('close'), { flush: 'sync' });

const parsing = ref(false), attachmentBusy = ref(false), created = ref(false);
watch(() => [props.record, props.loading, props.loadError], () => {
  if (props.loading || props.loadError) return;
  formError.value = '';
  created.value = false;
  form.value = libraryDraft({ director: '', rating: null, ...props.record });
}, { immediate: true });
function setDate(key, date) {
  form.value[key] = date || null;
}
const retryingCover = ref(false);
async function retryCover() {
  const id = form.value?.retryCoverWorkId;
  if (!id || retryingCover.value) return;
  retryingCover.value = true;
  try {
    await scope.wait(request('/creative-works/' + id + '/cover/retry', 'POST'));
    if (form.value?.retryCoverWorkId === id) {
      form.value.coverImgUrl = '/creative-works/' + id + '/cover';
      form.value.retryCoverWorkId = null;
    }
  } catch (e) {
    if (e.name !== 'PageInactiveError') formError.value = e.message;
  } finally {
    retryingCover.value = false;
  }
}
async function parse() {
  if (saving.value || deleting.value || parsing.value || !form.value.url?.trim()) return;
  parsing.value = true;
  formError.value = '';
  const id = form.value.id;
  try {
    const result = await scope.wait(request<any>('/movie/parse-douban', 'GET', { url: form.value.url.trim() }));
    if (form.value?.id === id) applyLibraryParse(form.value, result);
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    parsing.value = false;
  }
}
async function save() {
  if (saving.value || deleting.value || parsing.value || attachmentBusy.value) return;
  saving.value = true;
  formError.value = '';
  try {
    const payload = libraryPayload(form.value, true);
    if (!created.value) {
      await scope.wait(request('/movie', payload.id ? 'PUT' : 'POST', payload));
      created.value = true;
    }
    const updated = payload.id ? await scope.wait(request<any>('/movie/' + encodeURIComponent(payload.id))) : null;
    emit('saved', updated, payload.status);

  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}

async function remove(item) {
  if (saving.value || deleting.value || parsing.value || attachmentBusy.value) return;
  deleting.value = true;
  try { await scope.wait(request('/movie/' + encodeURIComponent(item.id), 'DELETE')); emit('deleted', item.id); }
  finally { deleting.value = false; }
}

</script>
<template>
<ModalMotion><AdaptiveModal ref="modalMotion0" :loading="loading" :load-error="loadError" :loading-rows="5" @retry="emit('retry')"
        v-if="form || loading || loadError"
        label="编辑观影"
        :busy="deleting || saving || parsing || attachmentBusy"
        @close="emit('close')"
        ><template #loading><FormSkeleton :rows="['field', 'field', 'pair', 'pair', 'pair', 'pair', 'textarea', 'attachment']" :footer="true" /></template><view class="library-link-row ui-field-row"
          ><view class="library-link-field"
            ><FormField compact stretch label="豆瓣链接" v-model="form.url" /></view
          ><MobileButton
            label="解析豆瓣链接"
            icon="ant-design:import-outlined"
            :loading="parsing"
            @click="parse" /></view
        ><FormField :required="isRequired('library', 'title')" label="名称" v-model="form.title" /><view class="ui-field-row">
          <FormField compact stretch
          label="类型"
          kind="selector"
          :model-value="typeLabels[form.type - 1]"
          :options="typeLabels"
          @update:model-value="
            form.type = typeLabels.indexOf($event) + 1
          " />
          <FormField compact stretch
          label="状态"
          kind="selector"
          :model-value="statusLabels[statuses.indexOf(form.status)]"
          :options="statusLabels"
          @update:model-value="
            form.status = statuses[statusLabels.indexOf($event)]
          " />
        </view><view class="ui-field-row">
          <FormField compact stretch
          label="导演/演员"
          v-model="form.director" />
          <FormField compact stretch
          label="评分"
          kind="selector"
          :model-value="form.rating ? String(form.rating) : '未评分'"
          :options="['未评分', '1', '2', '3', '4', '5']"
          @update:model-value="
            form.rating = $event === '未评分' ? null : Number($event)
          " />
        </view><view class="ui-field-row">
          <FormField compact stretch
          :label="form.type === 1 ? '已看时长（分钟）' : form.type === 2 ? '当前集数' : '当前进度'"
          input-type="number"
          v-model="form.currentProgress" />
          <FormField compact stretch
          :label="form.type === 1 ? '总时长（分钟）' : form.type === 2 ? '总集数' : '总进度'"
          input-type="number"
          v-model="form.totalProgress" />
        </view><text v-if="form.type > 2" class="library-progress-hint">按集数或分钟填写，保持两项单位一致</text><view class="ui-field-row">
          <FormField compact stretch
          label="开始日期"
          kind="date"
          :model-value="form.startDate || ''"
          @update:model-value="setDate('startDate', $event)" />
          <FormField compact stretch
          v-if="form.status === 'completed' || form.finishDate"
          label="完成日期"
          kind="date"
          :model-value="form.finishDate || ''"
          @update:model-value="setDate('finishDate', $event)" />
        </view><FormField
          label="短评/备注"
          kind="textarea" textarea-size="compact"
          v-model="form.remark" /><view v-if="!form.fileId && form.coverImgUrl" class="library-external-cover"><LibraryCover file-id="" :url="form.coverImgUrl" :title="form.title" kind="movie" /></view><MobileButton v-if="form.retryCoverWorkId && !form.fileId" label="重试封面" variant="quiet" :loading="retryingCover" @click="retryCover" /><AttachmentField
          :files="form.files"
          images-only :max-count="1"
          upload-path="/file/upload"
          :form-data="{ bizType: 'movie_cover' }"
          :disabled="deleting || saving || parsing"
          @update:files="setLibraryCover(form, $event)"
          @busy-change="attachmentBusy = $event" /><text
          v-if="formError"
          class="library-error ui-section ui-type-body"
          >{{ formError }}</text
        ><template #footer><FormActions>
          <template #secondary><ConfirmAction
            v-if="form.id && !saving && !parsing && !attachmentBusy"
            label="删除记录"
            :message="'确定删除“' + form.title + '”？'"
            :action="() => remove(form)" /></template>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="deleting || saving || parsing || attachmentBusy"
            @click="modalMotion0?.close()" /><MobileButton
            :label="created ? '重新读取' : '保存'"
            :loading="saving"
            :disabled="deleting || parsing || attachmentBusy"
            @click="save" />
        </FormActions></template></AdaptiveModal></ModalMotion>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');
.library-link-row { flex-direction: row; align-items: flex-end; }
.library-link-field { flex: 1; min-width: 0; }
.library-external-cover { width: 96px; height: 144px; margin-bottom: $space-inline; }
.library-progress-hint { @include type-style('caption'); margin-bottom: $space-inline; }
.library-error { color: #e05252; }

</style>
