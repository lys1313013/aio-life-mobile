<script setup lang="ts">
import { themeClass } from '../services/theme.ts'
import { computed } from 'vue'
import CategoryIcon from './CategoryIcon.uvue'
import type { Category, TimeRecord } from '../services/dashboard.ts'
import {
  categoryPath,
  parseDate,
  recordMinutes,
} from '../services/time-format.ts'
import { clockLabel, durationLabel } from '../services/dashboard-format.ts'
const props = defineProps<{ records: TimeRecord[]; categories: Category[]; showDate?: boolean; loading?: boolean; ignoreClick?: () => boolean }>()
const emit = defineEmits(['edit'])
function edit(record: TimeRecord) {
  if (!props.loading && !props.ignoreClick?.()) emit('edit', record)
}
const groups = computed(() => {
  const dates = [...new Set(props.records.map((r) => r.date || ''))].sort()
  return dates.map((date) => ({
    date,
    weekday: '周' + '日一二三四五六'[parseDate(date).getDay()],
    entries: props.records
      .filter((r) => r.date === date)
      .sort((a, b) => a.startTime - b.startTime)
      .map((r) => ({
        ...r,
        category: props.categories.find((c) => c.id === r.categoryId),
        name: categoryPath(r.categoryId, props.categories),
      })),
  }))
})
</script>
<template>
  <view class="record-groups" :class="{ 'day-swipe-empty': !records.length }">
    <view v-if="loading && !records.length" class="record-list" :class="themeClass('record-list')" role="status" aria-label="正在加载时迹清单">
      <view v-for="n in 6" :key="n" class="record-card-cell" :class="[themeClass('record-card-cell'), { 'record-row-divider': n > 1 }]" aria-hidden="true">
        <view class="record-card record-card-summary">
          <view class="record-card-heading"><view class="record-placeholder record-placeholder-category" :class="themeClass('record-placeholder')" /></view>
          <view class="record-card-time"><view class="record-placeholder record-placeholder-time" :class="themeClass('record-placeholder')" /></view>
          <view class="record-card-duration"><view class="record-placeholder record-placeholder-duration" :class="themeClass('record-placeholder')" /></view>
        </view>
      </view>
    </view>
    <view v-for="group in groups" :key="group.date" class="record-group">
      <text v-if="showDate" class="record-group-date" :class="themeClass('record-group-date')"
        >{{ group.date.slice(5) }} · {{ group.weekday }}</text
      >
      <view class="record-list" :class="themeClass('record-list')">
        <view
          v-for="(item, index) in group.entries"
          :key="item.id"
          class="record-card-cell"
          :class="[themeClass('record-card-cell'), { 'record-row-divider': index > 0 }]"
        >
          <button
            role="button"
            class="record-card ui-type-body"
            :aria-label="
              '编辑记录 ' + (item.title || item.category?.name || '未分类')
            "
            @click="edit(item)"
          >
            <view class="record-card-summary">
              <view class="record-card-heading">
                <CategoryIcon
                  :icon="item.category?.icon"
                  :color="item.category?.color"
                  :size="16"
                />
                <text
                  class="record-card-category"
                  :class="themeClass('record-card-category')"
                >{{ item.name }}</text>
              </view>
              <text
                class="record-card-time"
                :class="themeClass('record-card-time')"
              >{{ clockLabel(item.startTime) }}–{{ clockLabel(item.endTime) }}</text>
              <text
                class="record-card-duration"
                :class="themeClass('record-card-duration')"
              >{{ durationLabel(recordMinutes(item)) }}</text>
            </view>
            <text v-if="item.title" class="record-card-title" :class="themeClass('record-card-title')">{{ item.title }}</text>
          </button>
        </view>
      </view>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/platform' as *;
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
@include type-utilities('body');

// 空周期保留手势区域，仍可滑回有记录的日期。
.day-swipe-empty {
/* #ifndef APP */
min-height: 25vh;
/* #endif */
 }


.record-group {
  margin-bottom: $space-section;
}
.record-group-date {
  @include type-style('caption');
  color: $text-secondary-light;
  padding: 0 0 $space-inline;
}
.record-list {
  padding: $space-detail $space-card;
  border-radius: 12px;
  background-color: #ffffff;
  overflow: hidden;
}
.record-card-cell {
  width: 100%;
  box-sizing: border-box;
  border-top-color: #eef1f4;
}
.record-row-divider {
  border-top-width: $space-hairline;
  border-top-style: solid;
}
.record-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: $space-inline 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  text-align: left;
  line-height: type-line('label');
}
.record-card-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}
.record-card-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: $space-inline;
}
.record-card-category {
  flex: 1;
  min-width: 0;
  margin-left: $space-detail;
  @include type-style('caption');
  color: #71717a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-card-time {
  @include type-style('body-strong');
  flex-shrink: 0;
  // 固定数字列宽，长分类和时长变化不挤动起止时间。
  width: 100px;
  white-space: nowrap;
  color: #27272a;
}
.record-card-duration {
  @include type-style('caption');
  flex-shrink: 0;
  // 预留最长单日时长（23h59m）的数字列，保持行间对齐。
  width: 52px;
  margin-left: $space-inline;
  white-space: nowrap;
  text-align: right;
  color: #71717a;
}
.record-card-title {
  margin-top: $space-detail;
  @include type-style('caption');
  color: $text-secondary-light;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-list-dark {
  background-color: #1c1e22;
}
.record-card-cell-dark {
  border-top-color: #2c3038;
}
.record-placeholder {
  height: 12px;
  border-radius: 4px;
  background-color: #e8ecf1;
}
.record-placeholder-category { width: 80%; }
.record-placeholder-time { width: 88px; }
.record-placeholder-duration { width: 100%; }
.record-placeholder-dark { background-color: #30343c; }
.record-card-time-dark {
  color: #eeeeef;
}
.record-card-category-dark,
.record-card-duration-dark {
  color: #b4b4bd;
}
.record-card { @include borderless-button; }

.record-group-date-dark,
.record-card-title-dark { color: $text-secondary-dark; }
</style>
