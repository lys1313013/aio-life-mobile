<script setup lang="ts">
import { getCurrentInstance, nextTick, onMounted, onUnmounted, ref, watch } from 'vue'
import { useWindowResize } from '../services/window-resize.ts'
import { loadChartEngine } from '../services/chart-engine.ts'
import { chartAxisLabel, chartHeight, pieSectorAt } from '../services/chart-options.ts'
// #ifndef MP-WEIXIN
import { createChartSurface } from '../services/chart-options.ts'
// #endif
import { themeClass } from '../services/theme.ts'
import MobileButton from './MobileButton.uvue'
import LoadingIndicator from './LoadingIndicator.uvue'
import typography from '../styles/typography.json'
import spacing from '../styles/spacing.json'

const props = defineProps<{ option: any; label: string; hoverable?: boolean; swipeable?: boolean }>()
const emit = defineEmits(['layout', 'select', 'width', 'hover', 'leave', 'ready', 'swipe'])
const instance = getCurrentInstance()
// #ifndef MP-WEIXIN
const canvasId = 'aio-chart-' + instance?.uid
// #endif
const loading = ref(true), error = ref('')
// #ifdef MP-WEIXIN
const imageSource = ref('')
// #endif
const imageLoading = ref(false)
let chart: any = null, alive = true, generation = 0, scheduled = false
let textContext: any = null
let width = 0
let touchStart: any = null, lastTouch = 0
let selectionSequence = 0
function rect(): Promise<any> {
  return new Promise(resolve => uni.createSelectorQuery().in(instance?.proxy)
    .select('.aio-chart-renderer').boundingClientRect(value => resolve(value)).exec())
}
// #ifndef MP-WEIXIN
function context(): Promise<any> {
  return new Promise((resolve, reject) => uni.createCanvasContextAsync({
    id: canvasId, component: instance?.proxy,
    success(canvas) {
      const ctx = canvas.getContext('2d')
      if (ctx) resolve(ctx)
      else reject(new Error('画布初始化失败'))
    }, fail: reject,
  }))
}
// #endif
function labelWidths(labels: string[]) {
  textContext.save()
  try {
    textContext.font = `${typography.roles.caption.weight} ${typography.roles.caption.size}px ${typography.families.canvas}`
    return labels.map(label => textContext.measureText(label).width)
  } finally {
    textContext.restore()
  }
}
function renderChart() {
  // #ifdef MP-WEIXIN
  // 普通图片参与滚动和裁切，微信端只用离屏画布测量文字。
  const svg = chart.renderToSVGString()
  const utf8 = encodeURIComponent(svg).replace(/%([0-9A-F]{2})/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
  const source = 'data:image/svg+xml;base64,' + uni.arrayBufferToBase64(Uint8Array.from(utf8, char => char.charCodeAt(0)).buffer)
  if (source !== imageSource.value) {
    if (!imageSource.value) imageLoading.value = true
    imageSource.value = source
  }
  // #endif
  // #ifndef MP-WEIXIN
  chart.getZr().flush()
  emit('ready', true)
  // #endif
}
// #ifdef MP-WEIXIN
function imageLoaded() {
  if (!alive || !imageSource.value) return
  imageLoading.value = false
  if (!error.value) emit('ready', true)
}
function imageFailed() {
  if (!alive || !imageSource.value) return
  imageSource.value = ''
  imageLoading.value = false
  error.value = '图表加载失败'
  emit('ready', false)
}
// #endif
function paint() {
  if (!chart || !alive) return
  try {
    chart.setOption(props.option, { notMerge: true })
    error.value = ''
    if (props.option.series[0]?.type === 'pie') {
      renderChart()
      return
    }
    const yAxis = chart.getModel().getComponent('yAxis').axis
    const ticks = yAxis.scale.getTicks()
    let left = props.option.grid.left
    if (props.option.yAxis.axisLine.show) {
      // Measure displayed ticks (e.g. -1万), rather than an unrounded data maximum.
      // Keep only the micro gap between the widest label and the axis.
      left = Math.ceil(Math.max(0, ...labelWidths(ticks.map(tick => chartAxisLabel(tick.value))))) + spacing.micro
      chart.setOption({ grid: { left } })
    }
    const axisTicks = ticks.map(tick => ({
      value: tick.value, label: chartAxisLabel(tick.value),
      top: chart.convertToPixel({ yAxisIndex: 0 }, tick.value) - typography.roles.caption.lineHeight / 2,
    }))
    const labels = props.option.xAxis.data
    const points = labels.map((_, index) => chart.convertToPixel({ xAxisIndex: 0 }, index))
    const annotations = props.option.series.map((item, seriesIndex) => {
      const values = item.data.map(row => row.value)
      const data = item.stack ? chart.getModel().getSeriesByIndex(seriesIndex).getData() : null
      return { name: item.name, color: item.itemStyle.color, points: values.map((value, index) => ({
        x: points[index], y: chart.convertToPixel({ yAxisIndex: 0 }, value), value,
        ...(item.stack ? { bar: data.getItemLayout(index) } : {}),
      })) }
    })
    renderChart()
    emit('layout', { axisTicks, points, labelWidths: labelWidths(labels), series: annotations, left,
      axisTop: chartHeight - props.option.grid.bottom + spacing.detail })
  } catch (_) { error.value = '图表加载失败'; emit('ready', false) }
}
async function initialize() {
  if (!alive) return
  const id = ++generation
  loading.value = true
  emit('ready', false)
  error.value = ''
  try {
    await nextTick()
    const bounds = await rect()
    if (!alive || id !== generation) return
    if (!bounds || Array.isArray(bounds) || bounds.width <= 0) {
      loading.value = false
      return // Hidden tabs resume after a resize/data update.
    }
    width = bounds.width
    emit('width', width)
    const engine = await loadChartEngine()
    if (!alive || id !== generation) return
    // #ifdef MP-WEIXIN
    textContext = engine.chartTextContext()
    chart?.dispose()
    chart = engine.init(null, null, { renderer: 'svg', width, height: chartHeight, ssr: true })
    // #endif
    // #ifndef MP-WEIXIN
    const ctx = await context()
    if (!alive || id !== generation) return
    chart?.dispose()
    textContext = ctx
    chart = engine.init(createChartSurface(ctx), null, {
      renderer: 'canvas', width, height: chartHeight,
      devicePixelRatio: uni.getWindowInfo().pixelRatio || 1, ssr: true,
    })
    // #endif
    paint()
  } catch (_) { if (alive && id === generation) error.value = '图表加载失败' }
  finally { if (alive && id === generation) loading.value = false }
}
async function resize() {
  await nextTick()
  const bounds = await rect()
  if (!alive || !bounds || Array.isArray(bounds) || bounds.width <= 0) return
  if (!chart) { initialize(); return }
  if (width !== bounds.width) {
    width = bounds.width
    emit('width', width)
    chart.resize({ width, height: chartHeight, silent: true })
    paint()
  }
}
function queuePaint() {
  if (scheduled) return
  scheduled = true
  nextTick(() => { scheduled = false; if (chart) paint(); else initialize() })
}
async function select(event, hover = false) {
  if (!chart || !alive || error.value) return
  const sequence = ++selectionSequence
  const touch = event.changedTouches?.[0]
  const clientX = touch?.clientX ?? event.detail?.x ?? event.clientX
  if (typeof clientX !== 'number') return
  const bounds = await rect()
  if (!alive || !chart || sequence !== selectionSequence || !bounds || Array.isArray(bounds)) return
  const x = clientX - bounds.left
  if (props.option.series[0]?.type === 'pie') {
    const clientY = touch?.clientY ?? event.detail?.y ?? event.clientY
    if (typeof clientY !== 'number') return
    const data = chart.getModel().getSeriesByIndex(0).getData()
    const sectors = props.option.series[0].data.map((_, index) => data.getItemLayout(index))
    const index = pieSectorAt(sectors, x, clientY - bounds.top)
    if (index >= 0) emit(hover ? 'hover' : 'select', index)
    else emit('leave')
    return
  }
  if (hover && (x < chart.getOption().grid[0].left || x > width - props.option.grid.right)) {
    emit('leave')
    return
  }
  const index = chart.convertFromPixel({ xAxisIndex: 0 }, x)
  if (Number.isFinite(index)) emit(hover ? 'hover' : 'select', Math.max(0, Math.min(props.option.xAxis.data.length - 1, Math.round(index))))
}
function hover(event) {
  if (props.hoverable && Date.now() - lastTouch > 350) select(event, true)
}
function leave() {
  selectionSequence++
  emit('leave')
}
function mouseLeave() {
  // 触摸结束后的兼容鼠标事件不能立即清除触摸选中态。
  if (Date.now() - lastTouch > 350) leave()
}
function beginTouch(event) {
  leave()
  touchStart = event.touches?.[0] || null
  lastTouch = Date.now()
}
function endTouch(event) {
  lastTouch = Date.now()
  const end = event.changedTouches?.[0]
  if (!touchStart || !end) return
  const dx = end.clientX - touchStart.clientX, dy = end.clientY - touchStart.clientY
  touchStart = null
  if (props.swipeable && Math.abs(dx) >= spacing.controlMin && Math.abs(dx) > Math.abs(dy) * 1.5) {
    emit('swipe', dx > 0 ? 'right' : 'left')
    return
  }
  const distance = Math.hypot(dx, dy)
  if (distance <= spacing.inline) select(event)
}
function cancelTouch() { touchStart = null; leave() }
function click(event) {
  if (Date.now() - lastTouch > 350) select(event)
}
useWindowResize(resize)
onMounted(initialize)
watch(() => props.option, queuePaint, { deep: true })
onUnmounted(() => { alive = false; generation++; chart?.dispose(); chart = null; textContext = null })
</script>

<template>
  <view class="aio-chart-renderer" :aria-busy="loading || imageLoading">
    <!-- #ifdef MP-WEIXIN -->
    <view class="aio-chart-surface" @click="click"
      @touchstart="beginTouch" @touchend="endTouch" @touchcancel="cancelTouch">
      <image v-if="imageSource" :src="imageSource" mode="scaleToFill" class="aio-chart-image"
        aria-hidden="true" @load="imageLoaded" @error="imageFailed" />
    </view>
    <!-- #endif -->
    <!-- #ifndef MP-WEIXIN -->
    <canvas :id="canvasId" :canvas-id="canvasId" type="2d" class="aio-chart-canvas" :class="{ 'aio-chart-canvas-swipe': swipeable }"
      aria-hidden="true" @click="click" @mousemove="hover" @mouseleave="mouseLeave"
      @touchstart="beginTouch" @touchend="endTouch" @touchcancel="cancelTouch" />
    <!-- #endif -->
    <view v-if="loading || imageLoading || error" class="chart-render-state">
      <LoadingIndicator v-if="(loading || imageLoading) && !error" ring label="正在加载图表" />
      <text v-if="error" class="chart-render-message" :class="themeClass('chart-render-message')" role="alert">{{ error }}</text>
      <MobileButton v-if="error" label="重试图表" icon="ant-design:reload-outlined" variant="quiet" @click="initialize" />
    </view>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
.aio-chart-renderer { position: relative; width: 100%; height: 228px; }
.aio-chart-canvas { width: 100%; height: 228px; }
/* #ifdef MP-WEIXIN */
.aio-chart-surface, .aio-chart-image { display: block; width: 100%; height: 100%; }
.aio-chart-image { pointer-events: none; }
/* #endif */
/* #ifdef WEB */
.aio-chart-canvas-swipe { touch-action: pan-y; }
/* #endif */
.chart-render-state { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; gap: $space-inline; }
.chart-render-message { @include type-style('caption'); color: $text-secondary-light; }
.chart-render-message-dark { color: $text-secondary-dark; }
</style>
