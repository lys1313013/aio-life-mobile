 }
.skeleton-cover-dark { background-color: #282a2f; }
.skeleton-tile { gap: $space-section; min-height: 96px; }
.skeleton-date-value { width: 48%; height: 36px; }
.skeleton-progress { width: 100%; height: 5px; margin-top: auto; }
.skeleton-ring { width: 132px; height: 132px; border-radius: 50%; border: 20px solid #e8ecf1; align-self: center; margin: $space-section 0; box-sizing: border-box; }
.skeleton-ring-dark { border-color: #30343c; }
@include skeleton.motion('.skeleton-content');
@media (min-width: 768px) { .skeleton-metrics {
