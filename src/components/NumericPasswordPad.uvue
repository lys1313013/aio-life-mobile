<script setup lang="ts">
import { computed } from 'vue';
import AppIcon from './AppIcon.uvue';
import { isDark, themeClass } from '../services/theme.ts';
const props = withDefaults(defineProps<{ modelValue?: string; title?: string; busy?: boolean; error?: string; recovery?: boolean }>(), { modelValue: '', title: '二级密码', busy: false, error: '', recovery: false });
const emit = defineEmits(['update:modelValue', 'submit', 'recover']);
const rows = [['1', '2', '3'], ['4', '5', '6'], ['7', '8', '9']];
const valid = computed(() => /^[0-9]{4,}$/.test(props.modelValue));
const masked = computed(() => '•'.repeat(Math.min(props.modelValue.length, 16)));
function update(value: string) { if (!props.busy) emit('update:modelValue', value.replace(/[^0-9]/g, '')); }
function submit() { if (!props.busy && valid.value) emit('submit'); }
</script>
<template>
  <view class="pin-pad" :class="themeClass('pin-pad')" :aria-busy="busy">
    <text class="pin-title" :class="themeClass('pin-title')">{{ title }}</text>
    <view class="pin-entry">
      <!-- #ifdef WEB -->
      <view class="pin-input-wrap" aria-label="二级密码"><input :value="modelValue" type="text" :password="true" inputmode="none" :maxlength="-1" :disabled="busy" class="pin-input" :class="themeClass('pin-input')" @input="update($event.detail.value)" @confirm="submit" /><view v-if="!modelValue" class="pin-placeholder-overlay" aria-hidden="true"><text class="pin-placeholder-label" :class="themeClass('pin-placeholder-label')">至少 4 位数字</text></view></view>
      <!-- #endif -->
      <!-- #ifndef WEB -->
      <text class="pin-display" :class="[themeClass('pin-display'), { 'pin-placeholder': !modelValue }]" aria-label="二级密码">{{ masked || '至少 4 位数字' }}</text>
      <!-- #endif -->
      <text v-if="error" class="pin-error" role="alert">{{ error }}</text>
    </view>
    <view v-for="(row, index) in rows" :key="index" class="pin-row">
      <button v-for="digit in row" :key="digit" role="button" :aria-label="digit" style="background-color: transparent;" class="pin-key pin-digit" :class="[themeClass('pin-key'), themeClass('pin-digit')]" :disabled="busy" hover-class="pin-pressed" @click="update(modelValue + digit)"><text class="pin-number" :class="themeClass('pin-number')">{{ digit }}</text></button>
    </view>
    <view class="pin-row">
      <button role="button" aria-label="删除一位" :aria-disabled="busy || !modelValue" style="background-color: transparent;" class="pin-key" :class="[themeClass('pin-key'), { 'pin-disabled': busy || !modelValue }]" :disabled="busy || !modelValue" hover-class="pin-pressed" @click="update(modelValue.slice(0, -1))"><AppIcon name="svg:keypad-backspace" :size="32" :color="isDark ? '#f2f2f7' : '#1c1c1e'" /></button>
      <button role="button" aria-label="0" style="background-color: transparent;" class="pin-key pin-digit" :class="[themeClass('pin-key'), themeClass('pin-digit')]" :disabled="busy" hover-class="pin-pressed" @click="update(modelValue + '0')"><text class="pin-number" :class="themeClass('pin-number')">0</text></button>
      <button role="button" aria-label="确认密码" :aria-busy="busy" :aria-disabled="busy || !valid" style="background-color: transparent;" class="pin-key" :class="[themeClass('pin-key'), { 'pin-disabled': !valid && !busy }]" :disabled="busy || !valid" hover-class="pin-pressed" @click="submit"><view v-if="busy" class="pin-spinner" :class="themeClass('pin-spinner')" /><AppIcon v-else name="svg:keypad-confirm" :size="32" :color="isDark ? '#f2f2f7' : '#1c1c1e'" /></button>
    </view>
    <view v-if="recovery" class="pin-footer"><button role="button" class="pin-recovery" aria-label="忘记密码" :disabled="busy" @click="emit('recover')"><text class="pin-recovery-label" :class="themeClass('pin-recovery-label')">忘记密码</text></button></view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;
.pin-pad { color: #1c1c1e; }
.pin-pad-dark { color: #f2f2f7; }
.pin-title { padding: $space-detail $space-inline; color: #1c1c1e; @include type-style('body-strong'); }
.pin-title-dark { color: #f2f2f7; }
.pin-entry { position: relative; padding: $space-modal $space-inline; padding-bottom: $space-overlayBlock; }
.pin-input-wrap { position: relative; width: 100%; }
.pin-placeholder-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; pointer-events: none; }
.pin-placeholder-label { color: #85858e; @include type-style('label'); }
.pin-placeholder-label-dark { color: #a3a3ac; }
.pin-input { width: 100%; height: $space-controlMin; background-color: transparent; color: #1c1c1e; text-align: center; @include type-style('glyph-large'); }
.pin-input-dark { color: #f2f2f7; }
.pin-display { height: $space-controlMin; text-align: center; color: #1c1c1e; @include type-style('glyph-large'); }
.pin-display-dark { color: #f2f2f7; }
.pin-placeholder { color: #8e8e93; @include type-style('label'); }
.pin-error { position: absolute; bottom: $space-detail; left: 0; right: 0; color: #dc3545; text-align: center; @include type-style('caption'); }
.pin-row { display: flex; flex-direction: row; justify-content: space-around; margin-bottom: $space-inline; }
// 触控键为 56px 圆形；几何尺寸由公共触控下限与卡片间距组合。
.pin-key { display: flex; align-items: center; justify-content: center; width: $space-controlMin + $space-card; height: $space-controlMin + $space-card; min-width: $space-controlMin + $space-card; padding: 0; margin: 0; border: 0; border-radius: 50%; background-color: transparent; }
.pin-key-dark { background-color: transparent; }
.pin-digit { border: $space-hairline solid #dedee4; }
.pin-digit-dark { border-color: #48484f; }
.pin-number { color: #1c1c1e; @include type-style('glyph-large'); }
.pin-number-dark { color: #f2f2f7; }
.pin-key::after, .pin-recovery::after { border: 0; }
.pin-pressed { opacity: 0.65; }
.pin-disabled { opacity: 0.6; }
.pin-footer { flex-direction: row; justify-content: flex-end; }
.pin-recovery { min-height: $space-controlMin; padding: 0 $space-inline; margin: 0; border: 0; background-color: transparent; display: flex; align-items: center; justify-content: center; }
.pin-recovery-label { color: #85858e; @include type-style('caption'); }
.pin-recovery-label-dark { color: #a3a3ac; }
.pin-spinner { width: 20px; height: 20px; border: $space-micro solid #dedee4; border-top-color: #1c1c1e; border-radius: 50%; animation: pin-spin .8s linear infinite; }
.pin-spinner-dark { border-color: #48484f; border-top-color: #f2f2f7; }
@keyframes pin-spin { to { transform: rotate(360deg); } }
</style>
