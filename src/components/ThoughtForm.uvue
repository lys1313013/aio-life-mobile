<script setup lang="ts">
import FormActions from './FormActions.uvue';
import FormField from './FormField.uvue';
import MobileButton from './MobileButton.uvue';
import { isRequired } from '../services/form-required.ts';
import { computed, ref } from 'vue';
import { useWindowResize } from '../services/window-resize.ts';
import spacing from '../styles/spacing.json';

// 首页属于主包，记录列表属于分包；两处共用轻量表单，接口仍由入口管理。
const props = defineProps<{
  form: { content: string; isPinned: number; hiddenContent: boolean; events: { id?: string; content: string }[] };
  editing?: boolean;
  disabled?: boolean;
  error?: string;
}>();
const windowWidth = ref(uni.getWindowInfo().windowWidth);
useWindowResize(() => { windowWidth.value = uni.getWindowInfo().windowWidth; });
const stacked = computed(() => {
  const tools = props.editing ? 4 : 2;
  const requiredWidth = tools * spacing.controlMin + (tools - 1) * spacing.detail
    + 2 * spacing.modalActionMin + 2 * spacing.inline;
  return windowWidth.value - 2 * (spacing.overlayInline + spacing.modal) < requiredWidth;
});
</script>

<template>
  <view class="thought-form">
    <FormField
      label="内容" hide-label :required="isRequired('thought', 'content')"
      kind="textarea" appearance="soft" textarea-size="regular"
      placeholder="这一刻的想法…" v-model="form.content" :disabled="disabled"
    />
    <view v-for="(event, index) in form.events" :key="event.id || index" class="thought-event">
      <FormField
        :label="'关联事件 ' + (index + 1)" hide-label compact stretch
        kind="textarea" appearance="soft" textarea-size="compact"
        placeholder="补充相关事件…" v-model="event.content" :disabled="disabled"
      />
      <MobileButton label="移除此事件" icon="ant-design:close-outlined" variant="ghost" :disabled="disabled" @click="form.events.splice(index, 1)" />
    </view>
    <text v-if="error" class="thought-error" role="alert">{{ error }}</text>
    <FormActions :stacked="stacked">
      <template #secondary>
        <!-- 显式横排容器兼容微信具名插槽；窄屏以整组换行，图标不再各占一行。 -->
        <view class="thought-tools">
          <slot name="secondary" />
          <MobileButton label="新增关联事件" icon="ant-design:plus-outlined" variant="ghost" :disabled="disabled" @click="form.events.push({ content: '' })" />
          <MobileButton v-if="editing" :label="form.hiddenContent ? '显示内容' : '隐藏内容'" :icon="form.hiddenContent ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" variant="ghost" :disabled="disabled" @click="form.hiddenContent = !form.hiddenContent" />
          <MobileButton :label="form.isPinned === 1 ? '取消看板展示' : '展示到看板'" :icon="form.isPinned === 1 ? 'ant-design:star-filled' : 'ant-design:star-outlined'" :variant="form.isPinned === 1 ? 'quiet' : 'ghost'" :aria-pressed="form.isPinned === 1" :disabled="disabled" @click="form.isPinned = form.isPinned === 1 ? 0 : 1" />
        </view>
      </template>
      <slot />
    </FormActions>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;
.thought-form { min-width: 0; }
.thought-event { display: flex; flex-direction: row; align-items: center; gap: $space-detail; margin-bottom: $space-form; }
.thought-tools { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; gap: $space-detail; }
.thought-error { display: flex; @include type-style('body'); color: #e05252; margin-bottom: $space-section; }
</style>
