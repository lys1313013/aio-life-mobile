<script setup lang="ts">
import { isRequired, missingRequired } from '../services/form-required.ts';
import { onUnmounted, ref, watch } from 'vue';
import { onHide } from '@dcloudio/uni-app';
import AdaptiveModal from './AdaptiveModal.uvue';
import MobileButton from './MobileButton.uvue';
import FormField from './FormField.uvue';
import { request } from '../services/api.ts';
import { secondaryLock, finishUnlock, cancelUnlock } from '../services/secondary-lock.ts';
const password = ref('');
const error = ref('');
const saving = ref(false);
watch(
  () => [secondaryLock.menuPath, secondaryLock.token, secondaryLock.visible],
  () => {
    password.value = '';
    error.value = '';
  },
);
onUnmounted(() => {
  password.value = '';
});
onHide(() => {
  password.value = '';
  cancelUnlock();
});
async function unlock() {
  if (saving.value) return;
  if (missingRequired('security', { password: password.value }, 'password')) {
    error.value = '请输入二级密码';
    return;
  }
  saving.value = true;
  error.value = '';
  const path = secondaryLock.menuPath;
  const token = secondaryLock.token;
  try {
    await request(
      '/auth/secondary-verify',
      'POST',
      { password: password.value, menuPath: path },
      true,
      token,
      true,
    );
    if (secondaryLock.menuPath === path && secondaryLock.token === token) finishUnlock();
    password.value = '';
  } catch (reason) {
    if (secondaryLock.visible && secondaryLock.menuPath === path && secondaryLock.token === token)
      error.value = reason.message;
  } finally {
    saving.value = false;
  }
}
</script>
<template>
  <AdaptiveModal
    v-if="secondaryLock.visible"
    label="解锁菜单"
    :busy="saving"
    :show-close="false"
    :max-width="420"
    @close="cancelUnlock"
  >
    <FormField
      label="二级密码"
      :required="isRequired('security', 'password')"
      v-model="password"
      kind="password"
      revealable
      placeholder="请输入二级密码"
      :error="error"
      :disabled="saving"
    />
    <view class="unlock-actions">
      <view class="unlock-action">
        <MobileButton label="取消" variant="quiet" :disabled="saving" @click="cancelUnlock" />
      </view>
      <view class="unlock-action">
        <MobileButton label="解锁" :loading="saving" @click="unlock" />
      </view>
    </view>
  </AdaptiveModal>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;

.unlock-actions {
  display: flex;
  flex-direction: row;
  gap: $space-inline;
}

.unlock-action {
  flex: 1;
  min-width: 0;
}
</style>
