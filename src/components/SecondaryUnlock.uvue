<script setup lang="ts">
import { onUnmounted, ref, watch } from 'vue';
import { onHide } from '@dcloudio/uni-app';
import AdaptiveModal from './AdaptiveModal.uvue';
import NumericPasswordPad from './NumericPasswordPad.uvue';
import SecondaryPasswordEditor from './SecondaryPasswordEditor.uvue';
import { request } from '../services/api.ts';
import { secondaryLock, finishUnlock, cancelUnlock } from '../services/secondary-lock.ts';
const password = ref('');
const error = ref('');
const saving = ref(false);
const recoveryOpen = ref(false);
let revision = 0;
watch(
  () => [secondaryLock.menuPath, secondaryLock.token, secondaryLock.visible],
  () => {
    revision++;
    password.value = '';
    error.value = '';
    saving.value = false;
    if (!secondaryLock.visible) recoveryOpen.value = false;
  },
);
onUnmounted(() => {
  revision++;
  password.value = '';
});
onHide(() => {
  revision++;
  password.value = '';
  cancelUnlock();
});
async function unlock() {
  if (saving.value) return;
  if (!/^[0-9]{4,}$/.test(password.value)) {
    error.value = '至少输入 4 位纯数字';
    return;
  }
  saving.value = true;
  error.value = '';
  const v = revision;
  const path = secondaryLock.menuPath;
  const token = secondaryLock.token;
  try {
    await request(
      '/auth/secondary-verify',
      'POST',
      { password: password.value, menuPath: path },
      true,
      token,
      true,
    );
    if (v === revision && secondaryLock.visible && secondaryLock.menuPath === path && secondaryLock.token === token) {
      password.value = '';
      finishUnlock();
    }
  } catch (reason) {
    if (v === revision && secondaryLock.visible && secondaryLock.menuPath === path && secondaryLock.token === token)
      error.value = reason.message;
  } finally {
    if (v === revision) saving.value = false;
  }
}
</script>
<template>
  <AdaptiveModal v-if="secondaryLock.visible && !recoveryOpen" label="解锁菜单" :busy="saving" :show-close="false" :max-width="320" dense @close="cancelUnlock">
    <NumericPasswordPad v-model="password" :busy="saving" :error="error" recovery @update:modelValue="error = ''" @submit="unlock" @recover="password = ''; error = ''; recoveryOpen = true" />
  </AdaptiveModal>
  <SecondaryPasswordEditor v-if="secondaryLock.visible && recoveryOpen" mode="recovery" @close="recoveryOpen = false" />
</template>
