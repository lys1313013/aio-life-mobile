<script setup lang="ts">
import { buttonLabelClasses } from '../services/button-label.ts'
import { computed, nextTick, onUnmounted, ref, watch } from 'vue'
import { clampTimeSelection, resolveTimeWheelSelection } from '../services/time-selection.ts'
import spacing from '../styles/spacing.json'
import { isDark, themeClass } from '../services/theme.ts'
import { useWindowResize } from '../services/window-resize.ts'
// #ifdef MP-WEIXIN
import { registerModal } from '../services/modal-presence.ts'
import WeixinModalBackGuard from './WeixinModalBackGuard.uvue'
// #endif

const props = withDefaults(defineProps<{
  value: number; min?: number; max?: number; label?: string;
  anchor: { left: number; top: number; width: number; height: number };
}>(), {
  min: 0, max: 1439, label: '结束时间',
})
const emit = defineEmits(['change', 'close'])
// #ifdef MP-WEIXIN
onUnmounted(registerModal())
// #endif
const selected = ref(props.min <= props.max ? clampTimeSelection(props.value, props.min, props.max) : props.value)
// 分钟列使用当天绝对分钟，00/59 两侧天然相邻，小时跟随选中分钟。
const hourSelection = ref([Math.floor(selected.value / 60)])
const hours = Array.from({ length: 24 }, (_, index) => index)
const minutes = Array.from({ length: 1440 }, (_, index) => index)
const minuteRowHeight = spacing.controlMin - spacing.detail
const minuteScrollTop = ref(selected.value * minuteRowHeight)
// 保留原生滚轮定位所需行高，隐藏各端指示框（包括 H5 伪元素横线）。
const hourIndicatorStyle = `height: ${minuteRowHeight}px; opacity: 0;`
const viewport = ref(uni.getWindowInfo())
useWindowResize(() => { viewport.value = uni.getWindowInfo() })
const placement = computed(() => {
  const info = viewport.value
  const inset = spacing.overlayInline
  const minTop = (info.safeAreaInsets?.top || 0) + spacing.inline
  const maxBottom = info.windowHeight - (info.safeAreaInsets?.bottom || 0) - spacing.inline
  // 只水平居中，垂直沿用字段下方优先的定位；空间不足时缩减行数或改放上方。
  const width = Math.min(spacing.controlMin * 7, info.windowWidth - inset * 2)
  const toolbarHeight = spacing.controlMin
  const reservedHeight = toolbarHeight + spacing.section
  const below = props.anchor.top + props.anchor.height + spacing.detail
  const belowSpace = maxBottom - below
  const aboveSpace = props.anchor.top - spacing.detail - minTop
  const useAbove = belowSpace < reservedHeight + minuteRowHeight * 3 && aboveSpace > belowSpace
  const availableHeight = Math.max(0, useAbove ? aboveSpace : belowSpace)
  const fittingRows = Math.floor((availableHeight - reservedHeight) / minuteRowHeight)
  const rows = Math.max(1, Math.min(7, fittingRows % 2 === 0 ? fittingRows - 1 : fittingRows))
  const height = reservedHeight + rows * minuteRowHeight
  const top = Math.max(minTop, Math.min(
    useAbove ? props.anchor.top - spacing.detail - height : below,
    maxBottom - height,
  ))
  return { left: (info.windowWidth - width) / 2, top, width, rows }
})
const panelStyle = computed(() => ({
  left: placement.value.left + 'px', top: placement.value.top + 'px', width: placement.value.width + 'px',
}))
const wheelStyle = computed(() => ({ height: placement.value.rows * minuteRowHeight + 'px' }))
const spacerStyle = computed(() => ({ height: (placement.value.rows - 1) / 2 * minuteRowHeight + 'px' }))
let minuteSnapTimer: ReturnType<typeof setTimeout> | null = null
let ignoreInitialMinuteScroll = true
let minuteActualTop = minuteScrollTop.value
let minuteTouching = false
let minuteSnapRequest = 0
let active = true
const available = computed(() => props.min <= props.max)
const nowMinute = ref(currentMinute())
const nowDisabled = computed(() => !available.value || isDisabled(nowMinute.value))
function currentMinute() { const now = new Date(); return now.getHours() * 60 + now.getMinutes() }
function isDisabled(value: number) { return !available.value || value < props.min || value > props.max }
function hourDisabled(hour: number) { return !available.value || hour * 60 > props.max || hour * 60 + 59 < props.min }
const maskStyle = computed(() => {
  const color = isDark.value ? '28, 30, 34' : '255, 255, 255'
  return `background-image: linear-gradient(180deg, rgba(${color}, 0.65), rgba(${color}, 0)), linear-gradient(0deg, rgba(${color}, 0.65), rgba(${color}, 0));`
})
async function change(event, field: string) {
  const raw = [...event.detail.value]
  const previous = selected.value
  if (field === 'hour') hourSelection.value = raw
  selected.value = resolveTimeWheelSelection(previous, raw[0], field, props.min, props.max)
  // Hour change occurs on native picker input; align the absolute-minute scroll view.
  await nextTick()
  if (!active) return
  alignSelection()
}
function changeMinute(event) {
  if (!available.value) return
  const scrollTop = Math.max(0, Number(event.detail.scrollTop) || 0)
  const index = Math.min(minutes.length - 1, Math.round(scrollTop / minuteRowHeight))
  if (ignoreInitialMinuteScroll) {
    ignoreInitialMinuteScroll = false
    if (Math.abs(scrollTop - selected.value * minuteRowHeight) > minuteRowHeight / 2) return
  }
  minuteActualTop = scrollTop
  minuteSnapRequest++
  const next = clampTimeSelection(index, props.min, props.max)
  if (next !== selected.value) {
    selected.value = next
    hourSelection.value = [Math.floor(next / 60)]
  }
  scheduleMinuteSnap()
}
function clearMinuteSnap() {
  if (minuteSnapTimer) clearTimeout(minuteSnapTimer)
  minuteSnapTimer = null
}
function scheduleMinuteSnap() {
  clearMinuteSnap()
  if (minuteTouching) return
  // 惯性滚动每次通知都重新计时，停滚后再吸附；手指按住时不抢滚动位置。
  minuteSnapTimer = setTimeout(() => {
    minuteSnapTimer = null
    snapMinute()
  }, 120)
}
async function snapMinute() {
  if (!active || minuteTouching) return
  const request = ++minuteSnapRequest
  // scroll-top 绑定值不会随用户滚动更新。先同步真实位置，再写目标值，
  // 即使舍入后的分钟没变，也能触发 uni 重新定位，消除停在两行之间的情况。
  minuteScrollTop.value = minuteActualTop
  await nextTick()
  if (!active || minuteTouching || request !== minuteSnapRequest) return
  minuteScrollTop.value = selected.value * minuteRowHeight
}
function startMinuteTouch() {
  minuteTouching = true
  minuteSnapRequest++
  clearMinuteSnap()
}
function endMinuteTouch() {
  minuteTouching = false
  scheduleMinuteSnap()
}
function selectMinute(minute: number) {
  if (isDisabled(minute)) return
  selected.value = minute
  alignSelection()
}
function alignSelection() {
  const hour = Math.floor(selected.value / 60)
  if (hourSelection.value[0] !== hour) hourSelection.value = [hour]
  clearMinuteSnap()
  snapMinute()
}
watch(() => [props.value, props.min, props.max], () => {
  const next = available.value ? clampTimeSelection(props.value, props.min, props.max) : props.value
  // 外部值或可选范围变化时重新对齐，滚轮草稿仅在确认时应用。
  if (next === selected.value) return
  selected.value = next
  alignSelection()
  ignoreInitialMinuteScroll = true
})
// 弹层停留期间保持“此刻”的禁用状态准确，点击时再次读取最新时间。
const clockTimer = setInterval(() => { nowMinute.value = currentMinute() }, 1000)
onUnmounted(() => {
  active = false
  minuteSnapRequest++
  clearInterval(clockTimer)
  clearMinuteSnap()
})
function confirmSelection() {
  if (isDisabled(selected.value)) return
  emit('change', selected.value)
  emit('close')
}
function useCurrentTime() {
  nowMinute.value = currentMinute()
  if (nowDisabled.value) return
  emit('change', nowMinute.value)
  emit('close')
}
</script>

<template>
  <!-- 脱离编辑弹窗滚动区，水平居中并保持字段附近的垂直位置，避免被表单裁切。 -->
  <!-- #ifdef MP-WEIXIN -->
  <root-portal :enable="true">
    <WeixinModalBackGuard @close="emit('close')" />
  <!-- #endif -->
  <view class="time-end-mask" @click="emit('close')">
    <view class="time-end-panel" :class="themeClass('time-end-panel')" :style="panelStyle"
      role="dialog" :aria-label="'选择' + label" aria-modal="true" @click.stop>
      <view class="time-end-wheels">
        <picker-view class="time-end-wheel" :style="wheelStyle" :value="hourSelection" :immediate-change="true"
          :indicator-style="hourIndicatorStyle" :mask-style="maskStyle"
          @change="change($event, 'hour')">
          <picker-view-column>
            <view v-for="hour in hours" :key="hour" class="time-end-item">
              <text class="time-end-number" :class="[themeClass('time-end-number'), { 'time-option-disabled': hourDisabled(hour), 'time-end-number-selected': Math.floor(selected / 60) === hour }, themeClass({ 'time-end-number-selected': Math.floor(selected / 60) === hour })]" :aria-selected="Math.floor(selected / 60) === hour" :aria-disabled="hourDisabled(hour)">{{ String(hour).padStart(2, '0') }}</text>
            </view>
          </picker-view-column>
        </picker-view>
        <view class="time-end-wheel time-end-minute-wheel" :style="wheelStyle">
          <scroll-view class="time-end-minute-scroll" :scroll-y="true" :scroll-top="minuteScrollTop"
            :scroll-with-animation="false" :show-scrollbar="false" @scroll="changeMinute"
            @touchstart="startMinuteTouch" @touchend="endMinuteTouch" @touchcancel="endMinuteTouch">
            <view class="time-end-minute-spacer" :style="spacerStyle" />
            <view v-for="minute in minutes" :key="minute" class="time-end-item" @click="selectMinute(minute)">
              <text class="time-end-number" :class="[themeClass('time-end-number'), { 'time-option-disabled': isDisabled(minute), 'time-end-number-selected': selected === minute }, themeClass({ 'time-end-number-selected': selected === minute })]" :aria-selected="selected === minute" :aria-disabled="isDisabled(minute)">{{ String(minute % 60).padStart(2, '0') }}</text>
            </view>
            <view class="time-end-minute-spacer" :style="spacerStyle" />
          </scroll-view>
          <view class="time-end-minute-mask" :style="maskStyle" />
        </view>
      </view>
      <view class="time-end-toolbar">
        <button role="button" class="time-end-action" :class="themeClass('time-end-action')"
          aria-label="取消" @click="emit('close')"><text :class="buttonLabelClasses(['time-end-action', themeClass('time-end-action')])">取消</text></button>
        <button role="button" class="time-end-action time-end-primary" :class="[themeClass('time-end-primary'), { 'time-option-disabled': nowDisabled }]"
          :aria-label="label + '设为此刻'" :disabled="nowDisabled" @click="useCurrentTime"><text :class="buttonLabelClasses(['time-end-action time-end-primary', [themeClass('time-end-primary'), { 'time-option-disabled': nowDisabled }]])">此刻</text></button>
        <button role="button" class="time-end-action time-end-primary" :class="[themeClass('time-end-primary'), { 'time-option-disabled': !available }]"
          aria-label="确定" :disabled="!available" @click="confirmSelection"><text :class="buttonLabelClasses(['time-end-action time-end-primary', [themeClass('time-end-primary'), { 'time-option-disabled': !available }]])">确定</text></button>
      </view>
    </view>
  </view>
  <!-- #ifdef MP-WEIXIN -->
  </root-portal>
  <!-- #endif -->
</template>

<style scoped lang="scss">
@use '../styles/platform' as *;
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;

.time-end-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  background-color: rgba(0, 0, 0, 0.2);
}
.time-end-panel {
  position: absolute;
  background-color: #ffffff;
  border-radius: 12px;
  box-shadow: 0 $space-detail $space-modal rgba(0, 0, 0, 0.18);
  overflow: hidden;
}
.time-end-panel-dark { background-color: #1c1e22; }
.time-end-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 $space-inline;
}
.time-end-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: $space-controlMin;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0 $space-inline;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  @include type-style('body');
  color: #27272a;
}
.time-end-action { @include borderless-button; }
.time-end-action-dark { color: #eeeeef; }
.time-end-primary { color: #1d4ed8; }
.time-end-primary-dark { color: #9bbcff; }
.time-end-wheels {
  flex-direction: row;
  align-self: center;
  margin-top: $space-section;
  width: $space-controlMin * 5;
  max-width: 100%;
}
.time-end-wheel {
  width: 50%;
  // 七行滚轮，与选中行的原生 indicator 高度一致；短视口自动缩减行数。
  // 滚轮滑动行可更紧凑，工具栏按钮仍保留 controlMin 点击区。
  height: ($space-controlMin - $space-detail) * 7;
}
.time-end-minute-wheel { position: relative; overflow: hidden; }
.time-end-minute-scroll { width: 100%; height: 100%; }
.time-end-minute-spacer { height: ($space-controlMin - $space-detail) * 3; }
.time-end-minute-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background-size: 100% 50%, 100% 50%;
  background-position: top, bottom;
  background-repeat: no-repeat;
  pointer-events: none;
}
.time-end-item {
  height: $space-controlMin - $space-detail;
  align-items: center;
  justify-content: center;
}
.time-end-number {
  @include type-style('body');
  color: #27272a;
}
.time-end-number-dark { color: #eeeeef; }
.time-end-number-selected { @include type-style('body-strong'); color: #1d4ed8; }
.time-end-number-selected-dark { color: #9bbcff; }
.time-option-disabled { opacity: 0.3; }


/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.time-end-action-label { @include type-style('body'); color: #27272a; }
.time-end-action-dark-label { color: #eeeeef; }
.time-end-primary-label {  color: #1d4ed8; }
.time-end-primary-dark-label {  color: #9bbcff; }
</style>
