<script setup lang="ts">
import { computed, ref } from 'vue'
import spacing from '../styles/spacing.json'
import { isDark, themeClass } from '../services/theme.ts'

const props = defineProps<{ value: number }>()
const emit = defineEmits(['change', 'close'])
const selection = ref([Math.floor(props.value / 60), props.value % 60])
const hours = Array.from({ length: 24 }, (_, index) => String(index).padStart(2, '0'))
const minutes = Array.from({ length: 60 }, (_, index) => String(index).padStart(2, '0'))
const safeBottom = uni.getWindowInfo().safeAreaInsets?.bottom || 0
const maskStyle = computed(() => {
  const color = isDark.value ? '28, 30, 34' : '255, 255, 255'
  return `background-image: linear-gradient(180deg, rgba(${color}, 0.95), rgba(${color}, 0.6)), linear-gradient(0deg, rgba(${color}, 0.95), rgba(${color}, 0.6));`
})
function change(event) {
  selection.value = event.detail.value
}
function confirm() {
  emit('change', selection.value[0] * 60 + selection.value[1])
}
function useCurrentTime() {
  const now = new Date()
  emit('change', now.getHours() * 60 + now.getMinutes())
}
</script>

<template>
  <view class="time-end-mask" @click="emit('close')">
    <view class="time-end-panel" :class="themeClass('time-end-panel')"
      :style="{ paddingBottom: safeBottom + 'px' }"
      role="dialog" aria-label="选择结束时间" aria-modal="true" @click.stop>
      <view class="time-end-toolbar" :class="themeClass('time-end-toolbar')">
        <button role="button" class="time-end-action" :class="themeClass('time-end-action')"
          @click="emit('close')">取消</button>
        <button role="button" class="time-end-action time-end-primary" :class="themeClass('time-end-primary')"
          aria-label="结束时间设为此刻" @click="useCurrentTime">此刻</button>
        <button role="button" class="time-end-action time-end-primary time-end-confirm" :class="themeClass('time-end-primary')"
          @click="confirm">完成</button>
      </view>
      <picker-view class="time-end-wheel" :value="selection"
        :indicator-style="'height: ' + spacing.controlMin + 'px;'" :mask-style="maskStyle"
        @change="change">
        <picker-view-column>
          <view v-for="hour in hours" :key="hour" class="time-end-item">
            <text class="time-end-number" :class="themeClass('time-end-number')">{{ hour }}</text>
          </view>
        </picker-view-column>
        <picker-view-column>
          <view v-for="minute in minutes" :key="minute" class="time-end-item">
            <text class="time-end-number" :class="themeClass('time-end-number')">{{ minute }}</text>
          </view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;

.time-end-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  justify-content: flex-end;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.4);
}
.time-end-panel {
  width: 100%;
  max-width: 600px;
  background-color: #ffffff;
  border-radius: 12px 12px 0 0;
  overflow: hidden;
}
.time-end-panel-dark { background-color: #1c1e22; }
.time-end-toolbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 $space-inline;
  border-bottom: 1px solid #e5e7eb;
}
.time-end-toolbar-dark { border-bottom-color: #45474d; }
.time-end-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: $space-controlMin;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0 $space-inline;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  @include type-style('body');
  color: #27272a;
}
/* #ifdef WEB || MP-WEIXIN */
.time-end-action::after { border: 0; }
/* #endif */
.time-end-action-dark { color: #eeeeef; }
.time-end-primary { color: #1d4ed8; }
.time-end-primary-dark { color: #9bbcff; }
.time-end-wheel {
  width: 100%;
  // 五行滚轮，与选中行的原生 indicator 高度一致。
  height: $space-controlMin * 5;
}
.time-end-item {
  height: $space-controlMin;
  align-items: center;
  justify-content: center;
}
.time-end-number {
  @include type-style('body');
  color: #27272a;
}
.time-end-number-dark { color: #eeeeef; }
</style>
