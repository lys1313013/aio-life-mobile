<script setup lang="ts">
import { buttonLabelClasses } from '../services/button-label.ts'
import { computed, nextTick, onUnmounted, ref, watch } from 'vue'
import { clampTimeSelection, resolveTimeWheelSelection } from '../services/time-selection.ts'
import { clockLabel } from '../services/dashboard-format.ts'
import spacing from '../styles/spacing.json'
import { isDark, themeClass } from '../services/theme.ts'

const props = withDefaults(defineProps<{ value: number; min?: number; max?: number; label?: string; showNow?: boolean }>(), {
  min: 0, max: 1439, label: '结束时间', showNow: true,
})
const emit = defineEmits(['change', 'close', 'preview'])
const selected = ref(props.min <= props.max ? clampTimeSelection(props.value, props.min, props.max) : props.value)
// 分钟列使用当天绝对分钟，00/59 两侧天然相邻，小时跟随选中分钟。
// 原生 picker 分列管理，联动校正不会产生包含另一列旧值的 change 事件。
const hourSelection = ref([Math.floor(selected.value / 60)])
const minuteSelection = ref([selected.value])
const hours = Array.from({ length: 24 }, (_, index) => index)
const minutes = Array.from({ length: 1440 }, (_, index) => index)
const available = computed(() => props.min <= props.max)
const nowMinute = ref(currentMinute())
const nowDisabled = computed(() => !available.value || isDisabled(nowMinute.value))
function currentMinute() { const now = new Date(); return now.getHours() * 60 + now.getMinutes() }
function isDisabled(value: number) { return !available.value || value < props.min || value > props.max }
function hourDisabled(hour: number) { return !available.value || hour * 60 > props.max || hour * 60 + 59 < props.min }
const safeBottom = uni.getWindowInfo().safeAreaInsets?.bottom || 0
const maskStyle = computed(() => {
  const color = isDark.value ? '28, 30, 34' : '255, 255, 255'
  return `background-image: linear-gradient(180deg, rgba(${color}, 0.95), rgba(${color}, 0.6)), linear-gradient(0deg, rgba(${color}, 0.95), rgba(${color}, 0.6));`
})
async function change(event, field: string) {
  const raw = [...event.detail.value]
  const previous = selected.value
  if (field === 'hour') hourSelection.value = raw
  else minuteSelection.value = raw
  selected.value = resolveTimeWheelSelection(previous, raw[0], field, props.min, props.max)
  if (available.value) emit('preview', selected.value)
  // 先接收原生位置，再回弹到合法值；同值赋值也能纠正原生滚轮。
  await nextTick()
  alignSelection()
}
function alignSelection() {
  hourSelection.value = [Math.floor(selected.value / 60)]
  minuteSelection.value = [selected.value]
}
watch(() => [props.value, props.min, props.max], () => {
  selected.value = available.value ? clampTimeSelection(props.value, props.min, props.max) : props.value
  alignSelection()
})
// 弹层停留期间保持“此刻”的禁用状态准确，点击时再次读取最新时间。
const clockTimer = setInterval(() => { nowMinute.value = currentMinute() }, 1000)
onUnmounted(() => clearInterval(clockTimer))
function confirm() {
  if (available.value && !isDisabled(selected.value)) emit('change', selected.value)
}
function useCurrentTime() {
  nowMinute.value = currentMinute()
  if (!nowDisabled.value) emit('change', nowMinute.value)
}
</script>

<template>
  <view class="time-end-mask" @click="emit('close')">
    <view class="time-end-panel" :class="themeClass('time-end-panel')"
      :style="{ paddingBottom: safeBottom + 'px' }"
      role="dialog" :aria-label="'选择' + label" aria-modal="true" @click.stop>
      <view class="time-end-toolbar" :class="themeClass('time-end-toolbar')">
        <button role="button" class="time-end-action" :class="themeClass('time-end-action')"
          @click="emit('close')"><text :class="buttonLabelClasses(['time-end-action', themeClass('time-end-action')])">取消</text></button>
        <button v-if="showNow" role="button" class="time-end-action time-end-primary" :class="[themeClass('time-end-primary'), { 'time-option-disabled': nowDisabled }]"
          :aria-label="label + '设为此刻'" :disabled="nowDisabled" @click="useCurrentTime"><text :class="buttonLabelClasses(['time-end-action time-end-primary', [themeClass('time-end-primary'), { 'time-option-disabled': nowDisabled }]])">此刻</text></button>
        <button role="button" class="time-end-action time-end-primary time-end-confirm" :class="themeClass('time-end-primary')"
          :disabled="!available || isDisabled(selected)" @click="confirm"><text :class="buttonLabelClasses(['time-end-action time-end-primary time-end-confirm', themeClass('time-end-primary')])">完成</text></button>
      </view>
      <text class="time-end-bounds" :class="themeClass('time-end-bounds')" aria-label="可选时间范围">{{ available ? clockLabel(min) + ' – ' + clockLabel(max) : '暂无可选时间' }}</text>
      <view class="time-end-wheels">
        <picker-view class="time-end-wheel" :value="hourSelection"
          :indicator-style="'height: ' + (spacing.controlMin - spacing.inline) + 'px;'" :mask-style="maskStyle"
          @change="change($event, 'hour')">
          <picker-view-column>
            <view v-for="hour in hours" :key="hour" class="time-end-item">
              <text class="time-end-number" :class="[themeClass('time-end-number'), { 'time-option-disabled': hourDisabled(hour) }]" :aria-disabled="hourDisabled(hour)">{{ String(hour).padStart(2, '0') }}</text>
            </view>
          </picker-view-column>
        </picker-view>
        <picker-view class="time-end-wheel" :value="minuteSelection"
          :indicator-style="'height: ' + (spacing.controlMin - spacing.inline) + 'px;'" :mask-style="maskStyle"
          @change="change($event, 'minute')">
          <picker-view-column>
            <view v-for="minute in minutes" :key="minute" class="time-end-item">
              <text class="time-end-number" :class="[themeClass('time-end-number'), { 'time-option-disabled': isDisabled(minute) }]" :aria-disabled="isDisabled(minute)">{{ String(minute % 60).padStart(2, '0') }}</text>
            </view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;

.time-end-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  justify-content: flex-end;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.4);
}
.time-end-panel {
  width: 100%;
  max-width: 600px;
  background-color: #ffffff;
  border-radius: 12px 12px 0 0;
  overflow: hidden;
}
.time-end-panel-dark { background-color: #1c1e22; }
.time-end-toolbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 $space-inline;
  border-bottom: 1px solid #e5e7eb;
}
.time-end-toolbar-dark { border-bottom-color: #45474d; }
.time-end-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: $space-controlMin;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0 $space-inline;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  @include type-style('body');
  color: #27272a;
}
/* #ifdef WEB || MP-WEIXIN */
.time-end-action::after { border: 0; }
/* #endif */
.time-end-action-dark { color: #eeeeef; }
.time-end-primary { color: #1d4ed8; }
.time-end-primary-dark { color: #9bbcff; }
.time-end-bounds {
  @include type-style('caption');
  padding: $space-detail $space-modal;
  text-align: center;
  color: #6b7280;
}
.time-end-bounds-dark { color: #a1a1aa; }
.time-end-wheels {
  flex-direction: row;
  align-self: center;
  width: $space-controlMin * 4;
}
.time-end-wheel {
  width: 50%;
  // 五行滚轮，与选中行的原生 indicator 高度一致。
  // 滚轮滑动行可更紧凑，工具栏按钮仍保留 controlMin 点击区。
  height: ($space-controlMin - $space-inline) * 5;
}
.time-end-item {
  height: $space-controlMin - $space-inline;
  align-items: center;
  justify-content: center;
}
.time-end-number {
  @include type-style('body');
  color: #27272a;
}
.time-end-number-dark { color: #eeeeef; }
.time-option-disabled { opacity: 0.3; }


/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.time-end-action-label { @include type-style('body'); color: #27272a; }
.time-end-primary-label {  color: #1d4ed8; }
.time-end-primary-dark-label {  color: #9bbcff; }
</style>
