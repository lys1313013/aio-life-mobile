<script setup lang="ts">
import AppIcon from './AppIcon.uvue'
import CategoryIcon from './CategoryIcon.uvue'
import { isDark, themeClass } from '../services/theme.ts'
defineProps<{ label: string; icon?: string; text?: string; loading?: boolean; disabled?: boolean }>()
defineEmits<{ click: [] }>()
</script>
<template>
  <button role="button" class="dashboard-action" :class="{ 'dashboard-action-pill': !!text }" :aria-label="label" :aria-busy="loading" :loading="loading" :disabled="loading || disabled" :hover-class="isDark ? 'dashboard-action-pressed-dark' : 'dashboard-action-pressed'" @click="$emit('click')">
    <view v-if="!loading" class="action-content" :class="[{ 'action-pill': !!text }, text ? themeClass('action-pill') : '']">
      <text v-if="text" class="action-text" :class="themeClass('action-text')">{{ text }}</text>
      <view v-if="!icon || icon === 'lucide:plus'" class="action-plus" :class="{ 'action-plus-small': !!text }">
        <AppIcon name="lucide:plus" :size="text ? 14 : 18" :color="isDark ? '#a1a1aa' : '#71717a'" />
      </view>
      <CategoryIcon v-else :icon="icon" :size="16" :color="isDark ? '#b4b4bd' : '#71717a'" />
    </view>
  </button>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
.dashboard-action { display: flex; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; min-width: 44px; height: 44px; line-height: 20px; padding: 0; margin: 0 (-$space-inline) 0 0; border: 0; border-radius: 22px; background-color: transparent; }
.dashboard-action-pill { margin-right: 0; }
.dashboard-action-pressed { background-color: #f4f4f5; }
.dashboard-action-pressed-dark { background-color: #292d35; }
.action-content { flex-direction: row; align-items: center; justify-content: center; }
.action-pill { min-width: 44px; height: 22px; padding: 0 $space-inline; border-radius: 11px; background-color: #f8f8f9; }
.action-pill-dark { background-color: #27292f; }
.action-text { color: #3f3f46; font-family: monospace; font-size: 12px; line-height: 12px; margin-right: $space-detail; }
.action-text-dark { color: #e4e4e7; }
.action-plus { width: 24px; height: 24px; align-items: center; justify-content: center; flex-shrink: 0; }
.action-plus-small { width: 14px; height: 14px; }
