<script setup lang="ts">
import AppIcon from './AppIcon.uvue';
import { themePalette } from '../services/theme.ts';

defineProps<{ label: string; open?: boolean; active?: boolean; description?: string; disabled?: boolean }>();
defineEmits(['click']);
</script>

<template>
  <button class="filter-trigger" :class="{ 'filter-trigger-disabled': disabled }" role="button" hover-class="none" :aria-label="label"
    :aria-expanded="!!open" :aria-description="active ? (description || '已启用筛选') : undefined" :disabled="disabled"
    @click="$emit('click')">
    <AppIcon name="ant-design:filter-outlined" :color="active ? themePalette().tabSelectedColor : undefined" />
    <view v-if="active" class="filter-trigger-dot" :style="{ backgroundColor: themePalette().tabSelectedColor }" aria-hidden="true" />
  </button>
</template>

