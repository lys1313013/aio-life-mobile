<script setup lang="ts">
import { appTextColor } from '../services/app-layout.ts'

import LoadingIndicator from './LoadingIndicator.uvue';
import AppIcon from './AppIcon.uvue'
import { onUnmounted, ref, watch } from 'vue';
import { authFileUrl } from '../services/attachments.ts';
import { session } from '../services/session.ts';
import { isDark } from '../services/theme.ts';
const props = defineProps<{
  fileId: string;
  url: string;
  title: string;
  kind: string;
  compact?: boolean;
  tiny?: boolean;
  naturalRatio?: boolean;
}>();
const emit = defineEmits<{ ratio: [value: number] }>();
const source = ref(''),
  loading = ref(false),
  failed = ref(false);
let generation = 0;
function release(url: string) {
  // #ifdef WEB
  if (url.startsWith('blob:')) URL.revokeObjectURL(url);
  // #endif
}
async function load() {
  const current = ++generation;
  release(source.value);
  source.value = '';
  failed.value = false;
  if (props.naturalRatio) emit('ratio', 2 / 3);
  loading.value = !!(props.fileId || props.url);
  if (!loading.value) return;
  try {
    const url = props.fileId ? await authFileUrl(props.fileId) : props.url;
    if (current !== generation) {
      release(url);
      return;
    }
    source.value = url;
  } catch (_) {
    if (current === generation) {
      failed.value = true;
      loading.value = false;
    }
  }
}
function imageLoad(event: any) {
  loading.value = false;
  if (!props.naturalRatio) return;
  const width = Number(event.detail?.width);
  const height = Number(event.detail?.height);
  if (Number.isFinite(width) && Number.isFinite(height) && width > 0 && height > 0) {
    emit('ratio', width / height);
  }
}
function imageError() {
  failed.value = true;
  loading.value = false;
  if (props.naturalRatio) emit('ratio', 2 / 3);
}
watch(() => [props.fileId, props.url, session.token], load, {
  immediate: true,
});
onUnmounted(() => {
  generation++;
  release(source.value);
});
</script>
<template>
  <view class="library-cover" :class="{ 'library-cover-dark': isDark }">
    <image
      v-if="source && !failed"
      class="library-cover-image"
      :src="source"
      :mode="naturalRatio ? 'aspectFit' : 'aspectFill'"
      :aria-label="title + ' 封面'"
      @load="imageLoad"
      @error="imageError"
    />
    <view v-if="!source || failed || loading" class="library-cover-fallback" :class="{ 'library-cover-compact': compact }">
      <AppIcon :name="kind === 'movie' ? 'lucide:clapperboard' : 'lucide:book-open'" :size="28" color="#8b8f99" />
      <text v-if="!compact" class="library-cover-title">{{ title }}</text>
      <LoadingIndicator v-if="loading" compact label="正在加载封面" />
      <button :style="appTextColor()"
        role="button"
        v-if="failed && !tiny"
        class="library-cover-retry"
        aria-label="重试封面"
        @click.stop="load"
        @keydown.stop
      >
<AppIcon name="ant-design:reload-outlined" />
</button>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
.library-cover {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #e8ecf1;
  color: #788698;
}
.library-cover-dark {
  background-color: #252b34;
  color: #a1afc0;
}
.library-cover-image {
  width: 100%;
  height: 100%;
}
.library-cover-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: $space-overlayBlock $space-inline $space-inline;
  align-items: center;
  justify-content: center;
  gap: $space-inline;
}
.library-cover-symbol {
  @include type-style('glyph-large');
}
.library-cover-compact { padding: 0; gap: 0; }
.library-cover-title {
  @include type-style('badge');

  text-align: center;
  max-height: 48px;
  overflow: hidden;
}
.library-cover-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  @include type-style('glyph-medium');
  line-height: $space-controlMin;
  background-color: transparent;

/* #ifndef APP */
color: inherit;
/* #endif */

}
/* #ifdef WEB || MP-WEIXIN */
.library-cover-retry::after {
  border: 0;
}
/* #endif */
</style>
