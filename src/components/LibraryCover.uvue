<script setup lang="ts">

import ImagePlaceholder from './ImagePlaceholder.uvue';
import AppIcon from './AppIcon.uvue';
import { useImageSource } from '../services/use-image-source.ts';
import { isDark } from '../services/theme.ts';
const props = defineProps<{
  fileId: string;
  url: string;
  title: string;
  kind: string;
  compact?: boolean;
  tiny?: boolean;
  naturalRatio?: boolean;
}>();
const emit = defineEmits<{ ratio: [value: number] }>();
const { source, loading, failed, load, imageLoad: settled, imageError: fail } = useImageSource(() => ({ fileId: props.fileId, url: props.url }), () => { if (props.naturalRatio) emit('ratio', 2 / 3); });
function imageLoad(event: any) {
  settled();
  if (!props.naturalRatio) return;
  const width = Number(event.detail?.width);
  const height = Number(event.detail?.height);
  if (Number.isFinite(width) && Number.isFinite(height) && width > 0 && height > 0) {
    emit('ratio', width / height);
  }
}
function imageError() {
  fail();
  if (props.naturalRatio) emit('ratio', 2 / 3);
}
</script>
<template>
  <view class="library-cover" :class="{ 'library-cover-dark': isDark }">
    <image
      v-if="source && !failed" :key="source"
      class="library-cover-image"
      :src="source"
      :mode="naturalRatio ? 'aspectFit' : 'aspectFill'"
      :aria-label="title + ' 封面'"
      @load="imageLoad"
      @error="imageError"
    />
    <ImagePlaceholder v-if="loading || !source || failed" :loading="loading" :failed="failed" :retryable="!tiny" @retry="load"><view class="library-cover-fallback" :class="{ 'library-cover-compact': compact }">
      <AppIcon :name="kind === 'movie' ? 'lucide:clapperboard' : 'lucide:book-open'" :size="28" color="#8b8f99" />
      <text v-if="!compact" class="library-cover-title">{{ title }}</text>
    </view></ImagePlaceholder>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
.library-cover {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #e8ecf1;
  color: #788698;
}
.library-cover-dark {
  background-color: #252b34;
  color: #a1afc0;
}
.library-cover-image {
  width: 100%;
  height: 100%;
}
.library-cover-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: $space-overlayBlock $space-inline $space-inline;
  align-items: center;
  justify-content: center;
  gap: $space-inline;
}
.library-cover-symbol {
  @include type-style('glyph-large');
}
.library-cover-compact { padding: 0; gap: 0; }
.library-cover-title {
  @include type-style('badge');

  text-align: center;
  max-height: 48px;
  overflow: hidden;
}
</style>
