<script setup lang="ts">
import { onUnmounted, ref, watch } from 'vue';
import { authFileUrl } from '../services/attachments.ts';
import { session } from '../services/session.ts';
import MobileButton from './MobileButton.uvue';
const props = withDefaults(defineProps<{ fileId?: string; placeholder?: string }>(), { fileId: '', placeholder: '◇' });
const source = ref(''), loading = ref(false), failed = ref(false);
let generation = 0;
function release() {
  // #ifdef WEB
  if (source.value.startsWith('blob:')) URL.revokeObjectURL(source.value);
  // #endif
  source.value = '';
}
async function load() {
  const revision = ++generation;
  release();
  failed.value = false;
  loading.value = !!props.fileId;
  if (!props.fileId || !session.token) { loading.value = false; return; }
  try {
    const url = await authFileUrl(props.fileId);
    if (revision !== generation) {
      // #ifdef WEB
      if (url.startsWith('blob:')) URL.revokeObjectURL(url);
      // #endif
      return;
    }
    source.value = url;
  } catch { if (revision === generation) failed.value = true; }
  finally { if (revision === generation) loading.value = false; }
}
watch(() => [props.fileId, session.token], load, { immediate: true });
onUnmounted(() => { generation++; release(); });
</script>
<template>
  <view class="record-cover" :aria-busy="loading">
    <image v-if="source && !failed" class="record-cover-image" :src="source" mode="aspectFill" @error="failed = true" />
    <view v-else class="record-cover-placeholder">
      <text class="record-cover-symbol">{{ placeholder }}</text>
      <text v-if="loading" class="record-cover-hint">加载中</text>
      <view v-if="failed" @click.stop><MobileButton label="重试封面" icon="ant-design:reload-outlined" variant="quiet" @click="load" /></view>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
.record-cover { width: 100%; height: 100%; }
.record-cover-image { width: 100%; height: 100%; }
.record-cover-placeholder { flex: 1; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(148,163,184,0.08); gap: $space-detail; }
.record-cover-symbol { font-size: 32px; opacity: 0.5; }
.record-cover-hint { font-size: 12px; color: #8b8f99; }
</style>
