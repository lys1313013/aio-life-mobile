<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import ChartCanvas from './ChartCanvas.uvue'
import { appTextColor } from '../services/app-layout.ts'
import { isDark, themeClass } from '../services/theme.ts'
import { buildChartOption, colorChartSeries, validateChartData } from '../services/chart-options.ts'
import type { ChartSeries } from '../services/chart-options.ts'
import typography from '../styles/typography.json'
import spacing from '../styles/spacing.json'

const props = withDefaults(defineProps<{
  label: string; labels: string[]; series: ChartSeries[]; kind?: string; unit?: string;
  compact?: boolean; periodControls?: boolean; selectable?: boolean;
  hidePeriodSelector?: boolean; hideLegend?: boolean; hideScale?: boolean; hideTitle?: boolean;
  hideValues?: boolean; showEndValues?: boolean;
}>(), { kind: 'line', unit: '' })
const selected = ref(0), hidden = ref<string[]>([]), touched = ref(false), width = ref(280)
const layout = ref<any>({ axisTicks: [], points: [], series: [], left: 0, axisTop: 0 })
const colored = computed(() => colorChartSeries(props.series))
const visible = computed(() => colored.value.filter(item => props.series.length <= 1 || !hidden.value.includes(item.name)))
const interactive = computed(() => props.periodControls || props.selectable || !props.hidePeriodSelector)
// All line charts have a real left Y axis. Preserve the compact bar-chart modes.
const showScale = computed(() => props.kind !== 'bar' || (!props.hideScale && !props.periodControls))
const error = computed(() => {
  try { validateChartData(props.labels, props.series); return '' }
  catch (reason) { return reason.message }
})
const option = computed(() => buildChartOption(props.labels, visible.value, {
  dark: isDark.value, kind: props.kind, selected: selected.value,
  selectionActive: interactive.value && (touched.value || props.kind === 'bar'),
  showScale: showScale.value, width: width.value,
}))
watch(() => props.labels.join('|'), (_, previous) => {
  const oldLabel = previous?.split('|')[selected.value]
  const index = oldLabel ? props.labels.indexOf(oldLabel) : -1
  selected.value = index >= 0 ? index : Math.max(0, props.labels.length - 1)
  touched.value = false
}, { immediate: true })
function select(index: number) {
  if (!interactive.value || !props.labels.length) return
  selected.value = Math.max(0, Math.min(props.labels.length - 1, index))
  touched.value = true
}
function toggle(name: string) {
  hidden.value = hidden.value.includes(name) ? hidden.value.filter(item => item !== name) : [...hidden.value, name]
}
function displayNumber(value: number) {
  if (!props.compact && !props.periodControls) return String(value)
  return value.toFixed(props.unit === '%' ? 1 : 2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
}
const selectionText = computed(() => props.labels[selected.value] + ' ' + visible.value
  .map(item => item.name + displayNumber(item.values[selected.value] ?? 0) + props.unit).join('，'))
const axisLabels = computed(() => {
  const count = props.labels.length
  const slots = Math.max(2, Math.floor((width.value - layout.value.left) / 72))
  const step = Math.max(1, Math.ceil((count - 1) / (slots - 1)))
  return props.labels.flatMap((label, index) => {
    if (index !== count - 1 && index % step !== 0) return []
    const x = layout.value.points[index]
    if (!Number.isFinite(x)) return []
    const labelWidth = Math.min(width.value, label.length * typography.roles.caption.size)
    return [{ label, index, left: Math.max(0, Math.min(width.value - labelWidth, x - labelWidth / 2)), width: labelWidth }]
  })
})
const endLabels = computed(() => {
  if (!props.showEndValues || props.kind === 'bar') return []
  const rows = layout.value.series.filter(item => item.points.length).map(item => {
    const point = item.points[item.points.length - 1]
    return { name: item.name, color: item.color, text: displayNumber(point.value) + props.unit,
      top: Math.max(0, point.y - typography.roles['chart-label'].lineHeight - spacing.detail) }
  }).sort((a, b) => a.top - b.top)
  for (let i = 1; i < rows.length; i++) rows[i].top = Math.max(rows[i].top, rows[i - 1].top + typography.roles['chart-label'].lineHeight + spacing.micro)
  return rows
})
const extremeLabels = computed(() => {
  if (!props.periodControls || props.kind !== 'bar') return []
  return layout.value.series.flatMap(item => {
    const values = item.points.map(point => point.value)
    if (!values.length) return []
    return [...new Set([values.indexOf(Math.max(...values)), values.indexOf(Math.min(...values))])].map(index => {
      const point = item.points[index]
      const text = String(Math.round(point.value * 100) / 100) + props.unit
      const labelWidth = text.length * typography.roles['chart-label'].size
      return { key: item.name + index, text, left: Math.max(0, Math.min(width.value - labelWidth, point.x - labelWidth / 2)),
        top: Math.max(0, point.y - typography.roles['chart-label'].lineHeight - spacing.detail), width: labelWidth }
    })
  })
})
</script>

<template>
  <view class="mini-chart aio-chart" :class="[themeClass('mini-chart'), { 'mini-chart-period': periodControls }]" role="figure" :aria-label="label">
    <view class="mini-chart-header" :class="{ 'chart-header-title-hidden': hideTitle }">
      <text v-if="!hideTitle" class="mini-chart-title" :style="appTextColor()">{{ label }}</text>
      <text v-if="unit && showScale" class="chart-unit" :class="themeClass('chart-unit')">{{ unit }}</text>
      <slot name="actions" />
    </view>
    <view v-if="!hideLegend && series.length > 1" class="chart-legend-compact">
      <button v-for="item in colored" :key="item.name" class="chart-legend-button" role="button"
        :class="{ 'chart-legend-hidden': hidden.includes(item.name) }" :aria-label="item.name"
        :aria-pressed="!hidden.includes(item.name)" @click="toggle(item.name)">
        <view class="chart-legend-swatch" :style="{ backgroundColor: item.color }" />
        <text class="chart-legend-name" :style="appTextColor()">{{ item.name }}</text>
      </button>
    </view>
    <text v-if="error" class="mini-chart-error" role="alert">{{ error }}</text>
    <template v-else-if="labels.length">
      <view class="mini-chart-plot" :role="interactive ? 'slider' : undefined" :tabindex="interactive ? 0 : undefined"
        :aria-label="interactive ? label + '，点击图表查看数值' : undefined" :aria-valuemin="interactive ? 0 : undefined"
        :aria-valuemax="interactive ? labels.length - 1 : undefined" :aria-valuenow="interactive ? selected : undefined"
        :aria-valuetext="interactive ? selectionText : undefined"
        @keydown.left.prevent="select(selected - 1)" @keydown.right.prevent="select(selected + 1)">
        <ChartCanvas :option="option" :label="label" @layout="layout = $event" @width="width = $event" @select="select" />
        <view v-if="showScale" class="chart-y-axis" :style="{ width: layout.left + 'px' }" :aria-label="'Y 轴，单位 ' + unit">
          <text v-for="tick in layout.axisTicks" :key="tick.value" class="chart-y-tick" :class="themeClass('chart-y-tick')"
            :style="{ top: tick.top + 'px', width: Math.max(0, layout.left - spacing.inline) + 'px' }">{{ tick.label }}</text>
        </view>
        <text v-for="item in axisLabels" :key="item.index" class="chart-x-label" :class="themeClass('chart-x-label')"
          :style="{ top: layout.axisTop + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.label }}</text>
        <text v-for="item in endLabels" :key="item.name" class="chart-end-label" :class="themeClass('chart-end-label')"
          :style="{ top: item.top + 'px', color: item.color }" :aria-label="item.name + '总金额'">{{ item.text }}</text>
        <text v-for="item in extremeLabels" :key="item.key" class="chart-extreme-label" :class="themeClass('chart-extreme-label')"
          :style="{ top: item.top + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.text }}</text>
      </view>
      <view v-if="periodControls" class="chart-period-value" aria-live="polite">
        <text class="chart-period-label" :style="appTextColor()">{{ labels[selected] }}{{ visible.map(item => item.name).join(' / ') }}</text>
        <text v-for="item in visible" :key="item.name" class="chart-period-amount" :style="appTextColor()">{{ displayNumber(item.values[selected] ?? 0) }}{{ unit }}</text>
      </view>
      <template v-else-if="!hideValues">
        <text v-if="interactive && (touched || compact)" class="chart-selected-label" :class="themeClass('chart-selected-label')" aria-live="polite">{{ labels[selected] }}</text>
        <view class="mini-chart-values" :class="{ 'chart-values-compact': compact }" aria-live="polite">
          <view v-for="item in visible" :key="item.name" class="chart-value-item" :class="{ 'chart-value-inline': !compact }">
            <view v-if="!compact" class="chart-legend-swatch" :style="{ backgroundColor: item.color }" />
            <text class="chart-value-label" :class="themeClass('chart-value-label')">{{ item.name }}</text>
            <text class="chart-value-number" :class="themeClass('chart-value-number')">{{ displayNumber(item.values[selected] ?? 0) }}{{ unit }}</text>
          </view>
        </view>
      </template>
    </template>
    <text v-else class="mini-chart-empty" :class="themeClass('mini-chart-empty')">暂无数据</text>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
.mini-chart { min-width: 0; padding: $space-card; border-radius: 16px; background-color: #ffffff; margin-bottom: $space-section; }
.mini-chart-dark { background-color: #1c1e22; }
.mini-chart-period { margin-bottom: 0; }
.mini-chart-header { flex-direction: row; align-items: center; gap: $space-inline; }
.chart-header-title-hidden { justify-content: flex-end; }
.mini-chart-title { flex: 1; @include type-style('body-strong'); }
.chart-unit { @include type-style('caption'); color: $text-secondary-light; }
.mini-chart-plot { position: relative; width: 100%; height: 228px; margin-top: $space-inline; }
.chart-y-axis { position: absolute; left: 0; top: 0; height: 228px; pointer-events: none; }
.chart-y-tick { position: absolute; left: 0; text-align: right; @include type-style('caption'); color: $text-secondary-light; }
.chart-x-label { position: absolute; text-align: center; @include type-style('caption'); color: $text-secondary-light; pointer-events: none; }
.chart-legend-compact { flex-direction: row; flex-wrap: wrap; gap: $space-inline; }
.chart-legend-button { flex-direction: row; align-items: center; gap: $space-detail; min-width: $space-controlMin; min-height: $space-controlMin; padding: 0; margin: 0; border: 0; background-color: transparent; }
.chart-legend-name { @include type-style('caption'); }
.chart-legend-hidden { opacity: 0.4; }
.chart-legend-swatch { width: 6px; height: 6px; border-radius: 3px; }
.mini-chart-values { flex-direction: row; flex-wrap: wrap; gap: $space-inline; margin-top: $space-inline; }
.chart-values-compact { flex-wrap: nowrap; }
.chart-value-item { min-width: 0; flex: 1; gap: $space-detail; }
.chart-value-inline { flex: none; flex-direction: row; align-items: center; }
.chart-value-label { @include type-style('caption'); color: $text-secondary-light; }
.chart-value-number { @include type-style('caption-strong'); color: #27272a; font-variant-numeric: tabular-nums; }
.chart-selected-label { @include type-style('caption'); color: $text-secondary-light; margin-top: $space-detail; }
.chart-period-value { flex-direction: row; justify-content: center; align-items: center; gap: $space-inline; margin-top: $space-inline; }
.chart-period-label { @include type-style('caption'); }
.chart-period-amount { @include type-style('title'); }
.chart-end-label { position: absolute; right: $space-detail; @include type-style('chart-label'); background-color: #ffffff; pointer-events: none; }
.chart-end-label-dark { background-color: #1c1e22; }
.chart-extreme-label { position: absolute; text-align: center; @include type-style('chart-label'); color: $text-secondary-light; pointer-events: none; }
.mini-chart-error { @include type-style('label'); color: #e05260; padding: $space-section 0; }
.mini-chart-empty { @include type-style('body'); color: $text-secondary-light; padding: $space-section 0; }
.chart-value-number-dark { color: #eeeeef; }
.chart-unit-dark, .chart-y-tick-dark, .chart-x-label-dark, .chart-value-label-dark,
.chart-selected-label-dark, .chart-extreme-label-dark, .mini-chart-empty-dark { color: $text-secondary-dark; }
/* #ifdef WEB || MP-WEIXIN */
.chart-legend-button::after { border: 0; }
/* #endif */
</style>
