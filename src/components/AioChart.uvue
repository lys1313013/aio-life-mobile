<script setup lang="ts">
import { computed, getCurrentInstance, nextTick, onMounted, onUnmounted, ref, watch } from 'vue'
import ChartCanvas from './ChartCanvas.uvue'
import LoadingIndicator from './LoadingIndicator.uvue'
import { appTextColor } from '../services/app-layout.ts'
import { isDark, themeClass } from '../services/theme.ts'
import { buildChartOption, colorChartSeries, layoutChartAxisLabels, layoutStackedBarLabels, validateChartData } from '../services/chart-options.ts'
import type { ChartSeries } from '../services/chart-options.ts'
import typography from '../styles/typography.json'
import spacing from '../styles/spacing.json'
import { useWindowResize } from '../services/window-resize.ts'

const props = withDefaults(defineProps<{
  label: string; labels: string[]; series: ChartSeries[]; kind?: string; unit?: string;
  compact?: boolean; periodControls?: boolean; selectable?: boolean;
  hidePeriodSelector?: boolean; hideLegend?: boolean; hideScale?: boolean; hideTitle?: boolean; hideUnit?: boolean;
  hideValues?: boolean; showEndValues?: boolean; showBarValues?: boolean; xLabels?: string[]; loading?: boolean;
  stacked?: boolean; swipeable?: boolean; floatingTooltip?: boolean; showExtremes?: boolean;
  hideStackLabels?: boolean; plotMinWidth?: number; visiblePoints?: number; scrollToEnd?: boolean; scrollKey?: string;
}>(), { kind: 'line', unit: '', plotMinWidth: 0 })
const emit = defineEmits(['swipe'])
const selected = ref(0), hidden = ref<string[]>([]), touched = ref(false), width = ref(280)
const layout = ref<any>({ axisTicks: [], points: [], series: [], left: 0, axisTop: 0 })
const instance = getCurrentInstance()
const scrollLeft = ref(0), viewportWidth = ref(0)
// 折线按点之间的间隔计算宽度，扣除纵轴和右侧留白，避免一屏挤入更多点。
const plotWidth = computed(() => {
  const count = props.visiblePoints ?? 0
  if (count <= 1 || props.labels.length <= count || !viewportWidth.value) return props.plotMinWidth
  const inset = layout.value.left + spacing.inline
  return Math.max(props.plotMinWidth, inset + Math.max(0, viewportWidth.value - inset) * (props.labels.length - 1) / (count - 1))
})
async function resetScroll() {
  await nextTick()
  uni.createSelectorQuery().in(instance?.proxy).select('.mini-chart-viewport').boundingClientRect(bounds => {
    if (!bounds || Array.isArray(bounds)) return
    viewportWidth.value = bounds.width
    scrollLeft.value = props.scrollToEnd ? Math.max(0, plotWidth.value - bounds.width) : 0
  }).exec()
}
watch(() => [props.scrollKey, plotWidth.value, props.labels.length], resetScroll)
onMounted(resetScroll)
useWindowResize(resetScroll)
function plotScroll(event) {
  scrollLeft.value = event.detail.scrollLeft
  dismissTooltip()
}
const colored = computed(() => colorChartSeries(props.series))
const visible = computed(() => colored.value.filter(item => (!props.stacked && props.series.length <= 1) || !hidden.value.includes(item.name)))
const interactive = computed(() => props.periodControls || props.selectable || !props.hidePeriodSelector)
const periodTrend = computed(() => props.periodControls && props.kind === 'bar')
const selectionTooltip = computed(() => periodTrend.value || props.stacked || props.floatingTooltip)
let tooltipTimer: ReturnType<typeof setTimeout> | undefined
function dismissTooltip() {
  clearTimeout(tooltipTimer)
  if (selectionTooltip.value) touched.value = false
}
onUnmounted(() => clearTimeout(tooltipTimer))
watch(() => [props.loading, props.series], dismissTooltip)
const showScale = computed(() => props.kind !== 'bar' || !props.hideScale)
const error = computed(() => {
  try { validateChartData(props.labels, props.series); return '' }
  catch (reason) { return reason.message }
})
const option = computed(() => buildChartOption(props.xLabels ?? props.labels, visible.value, {
  dark: isDark.value, kind: props.kind, selected: selected.value,
  selectionActive: interactive.value && (touched.value || (props.kind === 'bar' && !periodTrend.value && !props.stacked)),
  showScale: showScale.value, width: width.value, roundedBars: periodTrend.value || props.showBarValues,
  stacked: props.stacked,
}))
watch(() => props.labels.join('|'), (_, previous) => {
  const oldLabel = previous?.split('|')[selected.value]
  const index = oldLabel ? props.labels.indexOf(oldLabel) : -1
  selected.value = index >= 0 ? index : Math.max(0, props.labels.length - 1)
  touched.value = false
}, { immediate: true })
function select(index: number) {
  if (props.loading || !interactive.value || !props.labels.length) return
  selected.value = Math.max(0, Math.min(props.labels.length - 1, index))
  touched.value = true
  if (selectionTooltip.value) {
    clearTimeout(tooltipTimer)
    tooltipTimer = setTimeout(dismissTooltip, 3000)
  }
}
function selectWithKeyboard(index: number) {
  select(index)
  if (!plotWidth.value || !viewportWidth.value) return
  const x = layout.value.points[selected.value]
  if (!Number.isFinite(x)) return
  if (x < scrollLeft.value + layout.value.left || x > scrollLeft.value + viewportWidth.value - spacing.inline) {
    scrollLeft.value = Math.max(0, Math.min(plotWidth.value - viewportWidth.value, x - viewportWidth.value / 2))
  }
}
function hoverSelect(index: number) {
  if (!selectionTooltip.value) return
  select(index)
  clearTimeout(tooltipTimer)
}
function toggle(name: string) {
  dismissTooltip()
  hidden.value = hidden.value.includes(name) ? hidden.value.filter(item => item !== name) : [...hidden.value, name]
}
function displayNumber(value: number) {
  if (!props.compact && !props.periodControls) return String(value)
  return value.toFixed(props.unit === '%' ? 1 : 2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
}
const selectionText = computed(() => props.labels[selected.value] + ' ' + visible.value
  .map(item => item.name + displayNumber(item.values[selected.value] ?? 0) + props.unit).join('，'))
const axisLabels = computed(() => layoutChartAxisLabels(
  props.xLabels ?? props.labels, layout.value.points, width.value, layout.value.labelWidths ?? [],
))
const endLabels = computed(() => {
  if (!props.showEndValues || props.kind === 'bar') return []
  const rows = layout.value.series.filter(item => item.points.length).map(item => {
    const point = item.points[item.points.length - 1]
    return { name: item.name, color: item.color, text: displayNumber(point.value) + props.unit,
      top: Math.max(0, point.y - typography.roles['chart-label'].lineHeight - spacing.detail) }
  }).sort((a, b) => a.top - b.top)
  for (let i = 1; i < rows.length; i++) rows[i].top = Math.max(rows[i].top, rows[i - 1].top + typography.roles['chart-label'].lineHeight + spacing.micro)
  return rows
})
const barLabels = computed(() => {
  if (!props.showBarValues || props.kind !== 'bar' || props.loading) return []
  return layout.value.series.flatMap(item => item.points.map((point, index) => {
    const text = displayNumber(point.value)
    const labelWidth = Math.min(width.value - layout.value.left, text.length * typography.roles['chart-label'].size)
    return { key: item.name + index, text, width: labelWidth,
      left: Math.max(layout.value.left, Math.min(width.value - labelWidth, point.x - labelWidth / 2)),
      top: Math.max(0, point.y - typography.roles['chart-label'].lineHeight - spacing.detail) }
  }))
})
const stackLabels = computed(() => props.stacked && !props.loading
  ? layoutStackedBarLabels(layout.value.series, width.value, layout.value.left)
  : { segments: [], totals: [] })
const tooltipText = computed(() => (props.stacked ? visible.value.filter(item => item.values[selected.value] > 0) : visible.value)
  .map(item => (visible.value.length > 1 ? item.name + ' ' : '') + displayNumber(item.values[selected.value] ?? 0) + props.unit).join('，'))
const stackTooltip = computed(() => props.labels[selected.value] + ' · 合计 ' + visible.value.reduce((sum, item) => sum + (item.values[selected.value] ?? 0), 0) + props.unit + '\n' + tooltipText.value)
const extremeLabels = computed(() => {
  if ((!periodTrend.value && !props.showExtremes) || props.showBarValues || props.loading || !props.labels.length) return []
  const left = props.showExtremes ? scrollLeft.value + layout.value.left : layout.value.left
  const right = props.showExtremes && viewportWidth.value ? scrollLeft.value + viewportWidth.value - spacing.inline : width.value
  return layout.value.series.flatMap(item => {
    // 滚动后重新选择当前视口内的极值，标签也限制在可见区域内。
    const points = item.points.map((point, index) => ({ ...point, index })).filter(point => !props.showExtremes
      || (Number.isFinite(point.value) && point.x >= left - 1 && point.x <= right + 1))
    const values = points.map(point => point.value)
    if (!values.length) return []
    const indices = [...new Set([values.indexOf(Math.max(...values)), values.indexOf(Math.min(...values))])]
    const rows = indices.map(index => {
      const point = points[index]
      const text = displayNumber(point.value)
      const labelWidth = Math.min(right - left, text.length * typography.roles['chart-label'].size)
      return { key: item.name + point.index, text, width: labelWidth,
        left: Math.max(left, Math.min(right - labelWidth, point.x - labelWidth / 2)),
        top: Math.max(0, point.y - typography.roles['chart-label'].lineHeight - spacing.detail) }
    })
    if (rows.length === 2) {
      const [high, low] = rows
      const line = typography.roles['chart-label'].lineHeight + spacing.detail
      if (Math.abs(high.top - low.top) < line && high.left < low.left + low.width && low.left < high.left + high.width) {
        high.top = Math.max(0, low.top - line)
      }
    }
    return rows
  })
})
</script>

<template>
  <view class="mini-chart aio-chart" :class="[themeClass('mini-chart'), { 'mini-chart-period': periodControls }]" role="figure" :aria-label="label">
    <view class="mini-chart-header" :class="{ 'chart-header-title-hidden': hideTitle }">
      <text v-if="!hideTitle" class="mini-chart-title" :style="appTextColor()">{{ label }}</text>
      <text v-if="!hideUnit && !periodTrend && unit && showScale" class="chart-unit" :class="themeClass('chart-unit')">{{ unit }}</text>
      <slot name="actions" />
    </view>
    <scroll-view v-if="!hideLegend && stacked" direction="horizontal" :scroll-x="true" :show-scrollbar="false" class="chart-legend-scroll" aria-label="分类图例，可横向滚动">
      <view class="chart-legend-row">
        <button v-for="item in colored" :key="item.name" class="chart-legend-button" role="button"
          :class="{ 'chart-legend-hidden': hidden.includes(item.name) }" :aria-label="item.name"
          :disabled="loading" :aria-pressed="!hidden.includes(item.name)" @click="toggle(item.name)">
          <view class="chart-stack-swatch" :class="{ 'chart-legend-swatch-hidden': hidden.includes(item.name) }" :style="{ backgroundColor: item.color }" />
          <text class="chart-legend-name" :class="[themeClass('chart-legend-name'), { 'chart-legend-name-hidden': hidden.includes(item.name), 'chart-legend-name-hidden-dark': hidden.includes(item.name) && isDark }]">{{ item.name }}</text>
        </button>
      </view>
    </scroll-view>
    <view v-else-if="!hideLegend && series.length > 1" class="chart-legend-compact">
      <button v-for="item in colored" :key="item.name" class="chart-legend-button" role="button"
        :class="{ 'chart-legend-hidden': hidden.includes(item.name) }" :aria-label="item.name"
        :disabled="loading" :aria-pressed="!hidden.includes(item.name)" @click="toggle(item.name)">
        <view class="chart-legend-swatch" :class="{ 'chart-legend-swatch-hidden': hidden.includes(item.name) }" :style="{ backgroundColor: item.color }" />
        <text class="chart-legend-name" :class="[themeClass('chart-legend-name'), { 'chart-legend-name-hidden': hidden.includes(item.name), 'chart-legend-name-hidden-dark': hidden.includes(item.name) && isDark }]">{{ item.name }}</text>
      </button>
    </view>
    <text v-if="error" class="mini-chart-error" role="alert">{{ error }}</text>
    <template v-else-if="loading || labels.length || periodTrend || stacked">
      <view class="mini-chart-viewport">
      <scroll-view class="chart-plot-scroll" direction="horizontal" :scroll-x="plotWidth > 0" :show-scrollbar="false"
        :scroll-left="scrollLeft" :aria-label="plotWidth > 0 ? label + '，可横向滚动查看数据' : undefined" @scroll="plotScroll">
      <view class="mini-chart-plot" :style="{ minWidth: plotWidth + 'px' }" :role="interactive && labels.length ? 'slider' : undefined" :tabindex="interactive && labels.length ? 0 : undefined"
        :aria-label="interactive ? label + '，点击图表查看数值' : undefined" :aria-valuemin="interactive ? 0 : undefined"
        :aria-valuemax="interactive ? labels.length - 1 : undefined" :aria-valuenow="interactive ? selected : undefined"
        :aria-valuetext="interactive ? selectionText : undefined"
        @keydown.left.prevent="selectWithKeyboard(selected - 1)" @keydown.right.prevent="selectWithKeyboard(selected + 1)"
        @keydown.esc="dismissTooltip" @blur="dismissTooltip">
        <view v-if="loading" class="chart-loading-plot" aria-busy="true"><LoadingIndicator ring label="正在加载图表" /></view>
        <view v-else-if="!labels.length" class="chart-empty-plot"><text class="mini-chart-empty" :class="themeClass('mini-chart-empty')">暂无数据</text></view>
        <ChartCanvas v-else :key="plotWidth" :option="option" :label="label" :hoverable="selectionTooltip" :swipeable="swipeable"
          @swipe="dismissTooltip(); emit('swipe', $event)" @hover="hoverSelect" @leave="dismissTooltip" @layout="layout = $event" @width="width = $event" @select="select" />
        <text v-for="item in axisLabels" :key="item.index" class="chart-x-label" :class="themeClass('chart-x-label')"
          :style="{ top: layout.axisTop + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.label }}</text>
        <text v-for="item in endLabels" :key="item.name" class="chart-end-label" :class="themeClass('chart-end-label')"
          :style="{ top: item.top + 'px', color: item.color }" :aria-label="item.name + '总金额'">{{ item.text }}</text>
        <text v-for="item in extremeLabels" :key="item.key" class="chart-extreme-label" :class="themeClass('chart-extreme-label')"
          :style="{ top: item.top + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.text }}</text>
        <text v-for="item in barLabels" :key="item.key" class="chart-extreme-label" :class="themeClass('chart-extreme-label')"
          :style="{ top: item.top + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.text }}</text>
        <text v-for="item in (hideStackLabels ? [] : stackLabels.segments)" :key="item.key" class="chart-stack-label"
          :style="{ top: item.top + 'px', left: item.left + 'px', width: item.width + 'px', color: item.color }">{{ item.text }}</text>
        <text v-for="item in stackLabels.totals" :key="item.key" class="chart-stack-total chart-extreme-label" :class="themeClass('chart-extreme-label')"
          :style="{ top: item.top + 'px', left: item.left + 'px', width: item.width + 'px' }">{{ item.text }}</text>
      </view>
      </scroll-view>
        <view v-if="showScale && !loading && labels.length" class="chart-y-axis" :class="themeClass('chart-y-axis')" :style="{ width: layout.left + 'px' }" :aria-label="'Y 轴，单位 ' + unit">
          <text v-for="tick in layout.axisTicks" :key="tick.value" class="chart-y-tick" :class="themeClass('chart-y-tick')"
            :style="{ top: tick.top + 'px', width: Math.max(0, layout.left - spacing.micro) + 'px' }">{{ tick.label }}</text>
        </view>
        <view v-if="selectionTooltip && touched && !loading && labels.length" class="chart-tooltip" :class="themeClass('chart-tooltip')" role="tooltip" aria-live="polite">
          <template v-if="floatingTooltip">
            <text class="chart-tooltip-date" :class="themeClass('chart-tooltip-date')">{{ labels[selected] }}</text>
            <view v-for="item in visible" :key="item.name" class="chart-tooltip-row">
              <view class="chart-legend-swatch" :style="{ backgroundColor: item.color }" />
              <text class="chart-tooltip-text" :class="themeClass('chart-tooltip-text')">{{ item.name + ' ' + displayNumber(item.values[selected] ?? 0) + unit }}</text>
            </view>
          </template>
          <text v-else class="chart-tooltip-text" :class="themeClass('chart-tooltip-text')">{{ stacked ? stackTooltip : tooltipText }}</text>
        </view>
      </view>
      <template v-if="!periodControls && !hideValues">
        <text v-if="interactive && (touched || compact)" class="chart-selected-label" :class="themeClass('chart-selected-label')" aria-live="polite">{{ loading ? '—' : labels[selected] }}</text>
        <view class="mini-chart-values" :class="{ 'chart-values-compact': compact }" aria-live="polite">
          <view v-for="item in visible" :key="item.name" class="chart-value-item" :class="{ 'chart-value-inline': !compact }">
            <view v-if="!compact" class="chart-legend-swatch" :style="{ backgroundColor: item.color }" />
            <text class="chart-value-label" :class="themeClass('chart-value-label')">{{ item.name }}</text>
            <text class="chart-value-number" :class="themeClass('chart-value-number')">{{ loading ? '—' : displayNumber(item.values[selected] ?? 0) + unit }}</text>
          </view>
        </view>
      </template>
    </template>
    <text v-else class="mini-chart-empty" :class="themeClass('mini-chart-empty')">暂无数据</text>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/platform' as *;
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
.mini-chart { min-width: 0; padding: $space-card; border-radius: 16px; background-color: #ffffff; margin-bottom: $space-section; }
.mini-chart-dark { background-color: #1c1e22; }
.mini-chart-period { margin-bottom: 0; }
.mini-chart-header { display: flex; flex-direction: row; align-items: center; gap: $space-inline; }
.chart-header-title-hidden { justify-content: flex-end; }
.mini-chart-title { flex: 1; @include type-style('body-strong'); }
.chart-unit { @include type-style('caption'); color: $text-secondary-light; }
.mini-chart-viewport { position: relative; min-width: 0; margin-top: $space-inline; }
.chart-plot-scroll { width: 100%; height: 228px; }
.mini-chart-plot { position: relative; width: 100%; height: 228px; }
.chart-loading-plot { height: 228px; display: flex; align-items: center; justify-content: center; }
.chart-y-axis { position: absolute; left: 0; top: 0; height: 228px; background-color: #ffffff; pointer-events: none; }
.chart-y-axis-dark { background-color: #1c1e22; }
.chart-y-tick { position: absolute; left: 0; text-align: right; white-space: nowrap; font-family: type-family('canvas'); @include type-style('caption'); color: $text-secondary-light; }
.chart-x-label { position: absolute; text-align: center; white-space: nowrap; font-family: type-family('canvas'); @include type-style('caption'); color: $text-secondary-light; pointer-events: none; }
.chart-legend-compact { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-inline; }
.chart-legend-scroll { width: 100%; min-width: 0; height: $space-controlMin; white-space: nowrap; }
.chart-legend-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: $space-section;
  height: $space-controlMin;
  // 全部图例撑开内容宽度，不能把超出部分裁掉而不给 scroll-view 滚动范围。
  @include intrinsic-width;
}
.chart-stack-swatch { width: 18px; height: 10px; border-radius: 2px; flex-shrink: 0; }
.chart-stack-label { position: absolute; text-align: center; @include type-style('chart-label'); pointer-events: none; }
.chart-legend-button { display: flex; flex-direction: row; flex-shrink: 0; align-items: center; gap: $space-detail; min-width: $space-controlMin; min-height: $space-controlMin; padding: 0; margin: 0; border: 0; background-color: transparent; }
.chart-legend-name { @include type-style('caption'); color: #27272a; }
.chart-legend-name-dark { color: #eeeeef; }
.chart-legend-name-hidden { color: $text-secondary-light; }
.chart-legend-name-hidden-dark { color: $text-secondary-dark; }
.chart-legend-swatch-hidden { opacity: 0.4; }
.chart-legend-swatch { width: 6px; height: 6px; border-radius: 3px; }
.mini-chart-values { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-inline; margin-top: $space-inline; }
.chart-values-compact { flex-wrap: nowrap; }
.chart-value-item { display: flex; flex-direction: column; min-width: 0; flex: 1; gap: $space-detail; }
.chart-value-inline { flex: none; flex-direction: row; align-items: center; }
.chart-value-label { @include type-style('caption'); color: $text-secondary-light; }
.chart-value-number { @include type-style('caption-strong'); color: #27272a; font-variant-numeric: tabular-nums; }
.chart-selected-label { @include type-style('caption'); color: $text-secondary-light; margin-top: $space-detail; }
.chart-tooltip { position: absolute; top: $space-detail; right: $space-detail; max-width: 100%; padding: $space-detail $space-inline; box-sizing: border-box; border-radius: 6px; background-color: #f4f6fa; border: 1px solid #e8ecf1; pointer-events: none; }
.chart-tooltip-dark { background-color: #2a2e36; border-color: #3c414b; }
.chart-tooltip-date { @include type-style('caption'); color: $text-secondary-light; }
.chart-tooltip-date-dark { color: $text-secondary-dark; }
.chart-tooltip-row { display: flex; flex-direction: row; align-items: center; gap: $space-detail; margin-top: $space-detail; }
.chart-tooltip-text { @include type-style('caption'); color: #27272a; font-variant-numeric: tabular-nums; }
.chart-tooltip-text-dark { color: #eeeeef; }
.chart-extreme-label { position: absolute; text-align: center; @include type-style('chart-label'); color: $text-secondary-light; pointer-events: none; }
.chart-extreme-label-dark { color: $text-secondary-dark; }
.chart-empty-plot { height: 228px; align-items: center; justify-content: center; }
.chart-end-label { position: absolute; right: $space-detail; @include type-style('chart-label'); background-color: #ffffff; pointer-events: none; }
.chart-end-label-dark { background-color: #1c1e22; }
.mini-chart-error { @include type-style('label'); color: #e05260; padding: $space-section 0; }
.mini-chart-empty { @include type-style('body'); color: $text-secondary-light; padding: $space-section 0; }
.chart-value-number-dark { color: #eeeeef; }
.chart-unit-dark, .chart-y-tick-dark, .chart-x-label-dark, .chart-value-label-dark,
.chart-selected-label-dark, .mini-chart-empty-dark { color: $text-secondary-dark; }
.chart-legend-button { @include borderless-button; }
</style>
