<script setup lang="ts">
import ContentSkeleton from './ContentSkeleton.uvue';
import LoadingIndicator from './LoadingIndicator.uvue';
import AppIcon from './AppIcon.uvue'
import { themeClass } from '../services/theme.ts'
import { recordChanged } from '../services/time-changes.ts'
import { computed, ref, onMounted, onUnmounted } from 'vue'
import AdaptiveModal from './AdaptiveModal.uvue'
import CategoryIcon from './CategoryIcon.uvue'
import type { Category, TimeRecord } from '../services/dashboard.ts'
import { getDateRecords, todayDate } from '../services/dashboard.ts'
import {
  getCategories,
  getRecord,
  recommendNext,
  createRecord,
  updateRecord,
  deleteRecord,
  getExerciseTypes,
  getRelateTypes,
  getRelated,
} from '../services/time.ts'
import {
  categoryPath,
  clockMinutes,
  recordMinutes,
  validateRecord,
  adjustRecordTime,
  durationEnd,
  shiftDate,
} from '../services/time-format.ts'
import { clockLabel, durationLabel } from '../services/dashboard-format.ts'
import { restoreSession, session } from '../services/session.ts'

const props = defineProps<{ recordId?: string; initialDate?: string }>()
const emit = defineEmits(['close'])
const id = ref(''),
  date = ref(todayDate()),
  loading = ref(true),
  saving = ref(false),
  deleting = ref(false)
const errorText = ref(''),
  ready = ref(false),
  full = ref(false),
  confirmDelete = ref(false)
const categories = ref<Category[]>([]),
  existing = ref<TimeRecord[]>([])
const form = ref<TimeRecord>({
  id: '',
  date: date.value,
  categoryId: '',
  startTime: 0,
  endTime: 59,
  title: '',
  description: '',
  exercises: [],
})
const choosingCategory = ref(false)
const categoryOptions = computed(() =>
  categories.value.filter((category) => category.isEnabled !== 0),
)
const categoryName = computed(() =>
  form.value.categoryId
    ? categoryPath(form.value.categoryId, categories.value)
    : '选择分类',
)
const selectedCategory = computed(() =>
  categories.value.find((item) => item.id === form.value.categoryId),
)
const duration = computed(() => recordMinutes(form.value))
const isExercise = computed(
  () =>
    categoryName.value.split(' / ').includes('运动') ||
    (form.value.exercises || []).length > 0,
)
const exerciseTypes = ref<{ id: string; dictLabel: string }[]>([]),
  exerciseLoading = ref(false),
  exerciseError = ref('')
const relateTypes = ref<{ label: string; value: number }[]>([])
const relatedType = computed(
  () =>
    relateTypes.value.find((t) => categoryName.value.includes(t.label))
      ?.value ||
    form.value.relateType ||
    0,
)
const choosingRelated = ref(false),
  relatedLoading = ref(false),
  relatedError = ref(''),
  relatedSearch = ref(''),
  relatedAll = ref(false)
const relatedItems = ref<{ id: string; title: string }[]>([]),
  relatedPage = ref(0),
  relatedTotal = ref(0)
const layoutKey = computed(() =>
  JSON.stringify([
    ready.value,
    loading.value,
    full.value,
    form.value,
    errorText.value,
    relatedError.value,
    exerciseError.value,
    exerciseTypes.value,
  ]),
)
const selectionKey = computed(() =>
  JSON.stringify([
    choosingCategory.value,
    categoryOptions.value,
    relatedItems.value,
    relatedError.value,
    relatedLoading.value,
  ]),
)
let active = true,
  generation = 0,
  relatedGeneration = 0
let autoDate = false
let repeating: ReturnType<typeof setInterval> | null = null
let suppressClickUntil = 0
onMounted(() => {
  uni.hideTabBar({ animation: false })
  restoreSession()
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  id.value = props.recordId || ''
  date.value = props.initialDate || todayDate()
  autoDate = !props.initialDate && !id.value
  initialize()
})
onUnmounted(() => {
  uni.showTabBar({ animation: false })
  stopAdjust()
  active = false
  generation++
  relatedGeneration++
})
function report(error) {
  if (error.name === 'SessionExpiredError') {
    uni.reLaunch({ url: '/pages/login/index' })
    return ''
  }
  return error.message || '操作失败，请重试'
}
async function initialize() {
  const serial = ++generation,
    token = session.token
  loading.value = true
  ready.value = false
  errorText.value = ''
  full.value = false
  try {
    const cats = await getCategories()
    if (!active || serial !== generation || token !== session.token) return
    categories.value = cats
    if (id.value) {
      const detail = await getRecord(id.value)
      if (!detail) throw new Error('这条记录已不存在')
      const day = detail.date || date.value
      const records = await getDateRecords(day)
      if (!active || serial !== generation || token !== session.token) return
      date.value = day
      existing.value = records
      form.value = {
        ...detail,
        date: day,
        exercises: (detail.exercises || []).map((e) => ({
          exerciseTypeId: e.exerciseTypeId,
          exerciseCount: e.exerciseCount,
          description: e.description,
        })),
      }
    } else {
      let result
      if (autoDate) {
        const yesterday = shiftDate(todayDate(), -1)
        const previous = await recommendNext(yesterday)
        if (
          previous.records.length &&
          previous.recommend &&
          Math.max(...previous.records.map((r) => r.endTime)) < 1439 - 60
        ) {
          result = previous
          date.value = yesterday
        }
        autoDate = false
      }
      result = result || (await recommendNext(date.value))
      if (!active || serial !== generation || token !== session.token) return
      existing.value = result.items
      if (!result.recommend) {
        full.value = true
        return
      }
      form.value = {
        id: '',
        date: date.value,
        categoryId: form.value.categoryId || result.recommend.categoryId || '',
        startTime: result.recommend.startTime,
        endTime: result.recommend.endTime,
        title: form.value.title || '',
        description: form.value.description || '',
        exercises: form.value.exercises || [],
        relateId: form.value.relateId,
        relateType: form.value.relateType,
      }
    }
    ready.value = true
    loadOptions()
  } catch (error) {
    if (active && serial === generation) errorText.value = report(error)
  } finally {
    if (serial === generation) loading.value = false
  }
}
async function loadOptions() {
  try {
    relateTypes.value = await getRelateTypes()
  } catch (error) {
    if (active) relatedError.value = report(error)
  }
  if (isExercise.value) loadExercises()
}
async function loadExercises() {
  if (exerciseLoading.value) return
  exerciseLoading.value = true
  exerciseError.value = ''
  try {
    exerciseTypes.value = (await getExerciseTypes()).dictDetailList || []
  } catch (error) {
    if (active) exerciseError.value = report(error)
  } finally {
    exerciseLoading.value = false
  }
}
function selectCategory(category: Category) {
  form.value.categoryId = category.id
  choosingCategory.value = false
  if (isExercise.value && exerciseTypes.value.length === 0) loadExercises()
}
function changeDate(event) {
  autoDate = false
  date.value = event.detail.value
  initialize()
}
function changeStart(event) {
  form.value.startTime = clockMinutes(event.detail.value)
}
function changeEnd(event) {
  form.value.endTime = clockMinutes(event.detail.value)
}
function changeDuration(event, unit: string) {
  const value = Number(event.detail.value)
  if (!Number.isInteger(value) || value < 0) {
    errorText.value = '时长须为非负整数'
    return
  }
  const minutes =
    unit === 'hours'
      ? value * 60 + (duration.value % 60)
      : Math.floor(duration.value / 60) * 60 + value
  form.value.endTime = durationEnd(form.value, existing.value, minutes)
  errorText.value = ''
}
function adjust(field: string, minutes: number) {
  form.value[field] = adjustRecordTime(
    form.value,
    existing.value,
    field,
    minutes,
  )
}
function tapAdjust(field: string, minutes: number) {
  if (Date.now() < suppressClickUntil) return
  adjust(field, minutes)
}
function startAdjust(field: string, minutes: number) {
  stopAdjust()
  suppressClickUntil = Number.POSITIVE_INFINITY
  adjust(field, minutes)
  repeating = setInterval(() => adjust(field, minutes), 100)
}
function stopAdjust() {
  if (repeating) {
    clearInterval(repeating)
    suppressClickUntil = Date.now() + 350
  }
  repeating = null
}
function goBack() {
  stopAdjust()
  if (!saving.value && !deleting.value) emit('close')
}
async function submit() {
  if (!ready.value || saving.value || deleting.value) return
  errorText.value = validateRecord(form.value, existing.value)
  if (errorText.value) return
  saving.value = true
  const token = session.token
  try {
    // 保存前重新拉取当天记录，避免编辑期间另一个端新增记录造成重叠。
    const latest = await getDateRecords(form.value.date || date.value)
    if (!active || token !== session.token) return
    const validation = validateRecord(form.value, latest)
    if (validation) {
      errorText.value = validation
      existing.value = latest
      return
    }
    const payload = {
      id: form.value.id,
      date: form.value.date,
      categoryId: form.value.categoryId,
      startTime: form.value.startTime,
      endTime: form.value.endTime,
      relateId: form.value.relateId,
      relateType: form.value.relateType,
      title: form.value.title?.trim() || '',
      description: form.value.description || '',
      exercises: (form.value.exercises || []).map((e) => ({
        ...e,
        exerciseCount:
          e.exerciseCount == null ? undefined : Number(e.exerciseCount),
      })),
    }
    if (id.value) await updateRecord(payload)
    else {
      const body = Object.assign({}, payload)
      delete body.id
      payload.id = await createRecord(body as TimeRecord)
    }
    if (!active || token !== session.token) return
    recordChanged(payload)
    uni.showToast({ title: '已保存', icon: 'success' })
    emit('close')
  } catch (error) {
    if (active) errorText.value = report(error)
  } finally {
    saving.value = false
  }
}
async function remove() {
  if (saving.value || deleting.value) return
  deleting.value = true
  errorText.value = ''
  const token = session.token
  try {
    await deleteRecord(id.value)
    if (!active || token !== session.token) return
    recordChanged(null, id.value)
    uni.showToast({ title: '已删除', icon: 'success' })
    emit('close')
  } catch (error) {
    if (active) errorText.value = report(error)
  } finally {
    deleting.value = false
  }
}
function exerciseName(typeId: string) {
  return (
    exerciseTypes.value.find((e) => e.id === typeId)?.dictLabel ||
    (typeId ? '已选运动' : '选择运动')
  )
}
function addExercise() {
  const exercises = form.value.exercises || []
  const lastExercise = exercises[exercises.length - 1]
  form.value.exercises = [
    ...exercises,
    {
      exerciseTypeId: lastExercise?.exerciseTypeId || '',
      exerciseCount: lastExercise?.exerciseCount,
    },
  ]
  if (exerciseTypes.value.length === 0) loadExercises()
}
async function openRelated() {
  choosingRelated.value = true
  await searchRelated()
}
async function searchRelated(more = false) {
  if (more && relatedLoading.value) return
  const serial = ++relatedGeneration,
    type = relatedType.value
  const page = more ? relatedPage.value + 1 : 1
  relatedLoading.value = true
  relatedError.value = ''
  try {
    const result = await getRelated(
      type,
      relatedSearch.value.trim(),
      page,
      relatedAll.value,
    )
    if (!active || serial !== relatedGeneration || relatedType.value !== type)
      return
    relatedItems.value = more
      ? [
          ...relatedItems.value,
          ...result.items.filter(
            (r) => !relatedItems.value.some((i) => i.id === r.id),
          ),
        ]
      : result.items
    relatedPage.value = page
    relatedTotal.value = Number(result.total)
  } catch (error) {
    if (serial === relatedGeneration) relatedError.value = report(error)
  } finally {
    if (serial === relatedGeneration) relatedLoading.value = false
  }
}
function selectRelated(item) {
  form.value.relateId = item.id
  form.value.relateType = relatedType.value
  form.value.title = item.title.startsWith('《')
    ? item.title
    : '《' + item.title + '》'
  choosingRelated.value = false
}
function clearRelated() {
  form.value.relateId = null
  form.value.relateType = null
}
function retryOptions() {
  relatedError.value = ''
  loadOptions()
}
function closeSelection() {
  choosingCategory.value = false
  choosingRelated.value = false
}
function changeRelatedScope(event) {
  relatedAll.value = event.detail.value
  searchRelated()
}
</script>

<template>
  <AdaptiveModal
    :label="id ? '编辑时迹' : '记录时间'"
    :show-close="false"
    :busy="saving || deleting"
    :content-key="layoutKey"
    @close="goBack"
  >
    <view class="editor-content">
      <view v-if="loading" class="state-card"
         :class="themeClass('state-card')"><ContentSkeleton variant="form" label="正在加载时迹详情" /></view
      >
      <view v-if="full" class="state-card"
         :class="themeClass('state-card')"><text class="empty-title" :class="themeClass('empty-title')">该天已录入完毕</text
        ><picker mode="date" :value="date" @change="changeDate"
          ><view class="picker-field"
            ><text class="action-label">选择其他日期</text></view
          ></picker
        ></view
      >
      <view v-if="!ready && errorText" class="state-card"
         :class="themeClass('state-card')"><text class="error-text" role="alert" :class="themeClass('error-text')">{{ errorText }}</text
        ><button role="button" class="text-action" @click="initialize">
          重试加载
        </button></view
      >
      <view v-if="ready" class="editor-form">
        <view class="form-card">
          <picker
            v-if="!id"
            mode="date"
            :value="date"
            :disabled="!!id || saving || deleting"
            @change="changeDate"
            ><view class="field-row"
              ><text class="field-label"><text class="required-mark">*</text>日期</text
              ><text class="field-value" :class="themeClass('field-value')">{{ date }}</text></view
            ></picker
          >
          <view class="title-field"
            ><text class="field-label">标题</text
            ><input
              v-model="form.title"
              class="title-input"
              placeholder="标题"
              aria-label="记录标题"
              :maxlength="50"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
          :class="themeClass('title-input')" /></view>
          <button
            role="button"
            aria-label="选择分类"
            class="field-row field-button"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            @click="choosingCategory = true"
          >
            <text class="field-label"><text class="required-mark">*</text>分类</text
            ><view class="category-value"
              ><CategoryIcon
                v-if="selectedCategory"
                :icon="selectedCategory.icon"
                :color="selectedCategory.color"
                :size="18"
              /><text class="field-value selected-category-name" :class="themeClass('field-value')">{{
                categoryName
              }}</text></view
            ><AppIcon name="ant-design:right-outlined" />
          </button>
        </view>
        <view class="form-card">
          <view class="time-fields">
            <view
              v-for="field in ['startTime', 'endTime']"
              :key="field"
              class="time-column"
            >
              <text class="field-label"><text class="required-mark">*</text>{{ field === 'startTime' ? '开始时间' : '结束时间' }}</text>
              <view class="time-control" :class="themeClass('time-control')">
                <button
                  role="button"
                  class="time-step-button"
                  hover-class="step-pressed"
                  :aria-label="(field === 'startTime' ? '开始时间 ' : '结束时间 ') + '-1 分钟'"
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, -1)"
                  @longpress="startAdjust(field, -1)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                ><AppIcon name="ant-design:minus-outlined" :size="18" /></button>
                <picker
                  class="time-picker"
                  mode="time"
                  :aria-label="field === 'startTime' ? '开始时间' : '结束时间'"
                  :value="clockLabel(form[field])"
                  :disabled="saving || deleting"
                  @change="field === 'startTime' ? changeStart($event) : changeEnd($event)"
                ><view class="time-field"><text class="time-number" :class="themeClass('time-number')">{{ clockLabel(form[field]) }}</text></view></picker>
                <button
                  role="button"
                  class="time-step-button"
                  hover-class="step-pressed"
                  :aria-label="(field === 'startTime' ? '开始时间 ' : '结束时间 ') + '+1 分钟'"
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, 1)"
                  @longpress="startAdjust(field, 1)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                ><AppIcon name="ant-design:plus-outlined" :size="18" /></button>
              </view>
              <view class="quick-row"
                ><button
                  v-for="delta in [-30, 30]"
                  :key="delta"
                  role="button"
                  class="duration-step"
                  hover-class="step-pressed"
                  :aria-label="
                    (field === 'startTime' ? '开始时间 ' : '结束时间 ') +
                    (delta > 0 ? '+' : '') +
                    delta +
                    ' 分钟'
                  "
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, delta)"
                  @longpress="startAdjust(field, delta)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                >
                  <text class="step-face"
                     :class="themeClass('step-face')">{{ delta > 0 ? '+' : '' }}{{ delta }}</text
                  >
                </button></view
              >
            </view>
          </view>
          <view class="duration-fields"
            ><text class="field-label">时长</text
            ><input
              type="number"
              :value="String(Math.floor(duration / 60))"
              :disabled="saving || deleting"
              class="duration-input"
              aria-label="时长小时"
              @input="changeDuration($event, 'hours')"
            :class="themeClass('duration-input')" /><text class="duration-unit">时</text
            ><input
              type="number"
              :value="String(duration % 60)"
              :disabled="saving || deleting"
              class="duration-input"
              aria-label="时长分钟"
              @input="changeDuration($event, 'minutes')"
            :class="themeClass('duration-input')" /><text class="duration-unit">分</text></view
          >
        </view>
        <view class="form-card"
          ><text class="field-label">描述</text
          ><textarea
            v-model="form.description"
            class="description-input"
            placeholder="描述信息"
            aria-label="记录备注"
            :maxlength="200"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            :auto-height="true"
          :class="themeClass('description-input')" />
        </view>
        <view v-if="relatedType" class="form-card"
          ><text class="section-label" :class="themeClass('section-label')">{{
            relatedType === 1 ? '关联阅读' : '关联观影'
          }}</text
          ><button
            role="button"
            class="field-row field-button"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            @click="openRelated"
          >
            <text class="field-value" :class="themeClass('field-value')">{{
              form.relateId ? form.title || '已关联记录' : '选择记录'
            }}</text
            ><AppIcon name="ant-design:right-outlined" /></button
          ><button
            v-if="form.relateId && !id"
            role="button"
            class="small-action"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            @click="clearRelated"
           :class="themeClass('small-action')">
            清除关联
          </button></view
        >
        <view v-if="relatedError && !choosingRelated" class="form-error"
          ><text class="error-text" :class="themeClass('error-text')">{{ relatedError }}</text
          ><button role="button" class="small-action" @click="retryOptions" :class="themeClass('small-action')">
            重试关联选项
          </button></view
        >
        <view v-if="isExercise" class="form-card"
          ><text class="section-label" :class="themeClass('section-label')">运动明细</text
          ><LoadingIndicator v-if="exerciseLoading" label="正在加载运动项目" />
          <view v-if="exerciseError"
            ><text class="error-text" :class="themeClass('error-text')">{{ exerciseError }}</text
            ><button role="button" class="small-action" @click="loadExercises" :class="themeClass('small-action')">
              重试运动类型
            </button></view
          ><view
            v-for="(item, index) in form.exercises"
            :key="index"
            class="exercise-row"
            ><picker
              :range="exerciseTypes"
              range-key="dictLabel"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
              @change="
                item.exerciseTypeId =
                  exerciseTypes[Number($event.detail.value)].id
              "
              ><view class="exercise-picker"
                ><text class="field-value" :class="themeClass('field-value')">{{
                  exerciseName(item.exerciseTypeId)
                }}</text></view
              ></picker
            ><input
              v-model="item.exerciseCount"
              type="digit"
              class="count-input"
              aria-label="运动数量"
              placeholder="数量"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
            :class="themeClass('count-input')" /><button
              role="button"
              class="remove-exercise"
              :aria-label="'移除运动 ' + (index + 1)"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
              @click="form.exercises.splice(index, 1)"
            >
<AppIcon name="ant-design:close-outlined" />
</button></view
          ><button
            role="button"
            class="small-action"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            @click="addExercise"
           :class="themeClass('small-action')">
            添加运动
          </button></view
        >
        <view v-if="ready && errorText" class="form-error"
          ><text class="error-text" role="alert" :class="themeClass('error-text')">{{ errorText }}</text></view
        >
        <view class="editor-actions">
          <view v-if="id" class="delete-anchor"
            ><button
              role="button"
              class="delete-button"
              aria-label="删除记录"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
              @click="confirmDelete = !confirmDelete"
             :class="themeClass('delete-button')">
              <AppIcon name="ant-design:delete-outlined" color="#df5661" /></button
            ><view v-if="confirmDelete" class="delete-confirm"
               :class="themeClass('delete-confirm')"><text class="field-value" :class="themeClass('field-value')">删除这条时间记录？</text
              ><text class="muted-text">关联的运动明细也会删除</text
              ><view class="confirm-actions"
                ><button
                  role="button"
                  class="small-action"
                  :disabled="deleting"
                  :aria-disabled="deleting"
                  @click="confirmDelete = false"
                 :class="themeClass('small-action')">
                  取消</button
                ><button
                  role="button"
                  class="delete-button"
                  :disabled="deleting"
                  :aria-disabled="deleting"
                  :loading="deleting"
                  @click="remove"
                 :class="themeClass('delete-button')">
                  确认删除
                </button></view
              ></view
            ></view
          >
          <view class="actions-spacer" /><button
            role="button"
            class="cancel-action"
            :disabled="saving || deleting"
            @click="goBack"
           :class="themeClass('cancel-action')">
            取消
          </button>
          <button
            role="button"
            class="save-button"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            :loading="saving"
            @click="submit"
          >
            保存
          </button></view
        >
      </view>
      <button
        v-if="!ready"
        role="button"
        class="cancel-action state-cancel"
        @click="goBack"
       :class="themeClass('cancel-action')">
        取消
      </button>
    </view>
  </AdaptiveModal>
  <AdaptiveModal
    v-if="choosingCategory || choosingRelated"
    :show-close="false"
    :content-key="selectionKey"
    :max-width="choosingCategory ? 500 : 600"
    :label="choosingCategory ? '选择分类' : '选择关联记录'"
    @close="closeSelection"
  >
    <view class="selection-panel"
      ><view v-if="!choosingCategory" class="selection-heading">
        <text class="section-label" :class="themeClass('section-label')">选择关联记录</text>
        <button
          role="button"
          class="close-selection"
          aria-label="关闭选择"
          @click="closeSelection"
        >
<AppIcon name="ant-design:close-outlined" />
</button>
      </view>
      <view v-if="!choosingCategory"
        ><view class="search-row"
          ><input
            v-model="relatedSearch"
            class="search-input related-search"
            placeholder="搜索名称"
            aria-label="搜索关联记录"
            confirm-type="search"
            @confirm="searchRelated()"
          :class="themeClass('search-input')" /><button role="button" class="small-action" @click="searchRelated()" :class="themeClass('small-action')">
            搜索
          </button></view
        ><view class="field-row"
          ><text class="muted-text">显示全部记录</text
          ><switch :checked="relatedAll" @change="changeRelatedScope" /></view
      ></view>
      <view
        class="selection-scroll"
        :class="{ 'category-selection': choosingCategory }"
        ><view v-if="choosingCategory" class="category-grid"
          ><button
            v-for="item in categoryOptions"
            :key="item.id"
            role="button"
            class="category-option"
            :aria-label="categoryPath(item.id, categories)"
            :aria-pressed="item.id === form.categoryId"
            :class="[({ 'category-selected': item.id === form.categoryId }), themeClass(({ 'category-selected': item.id === form.categoryId }))]"
            @click="selectCategory(item)"
          >
            <CategoryIcon :icon="item.icon" :color="item.color" :size="24" />
            <text class="category-name" :class="themeClass('category-name')">{{
              categoryPath(item.id, categories)
            }}</text></button
          ><text v-if="!categoryOptions.length" class="muted-text"
            >暂无分类</text
          ></view
        ><template v-else
          ><text v-if="relatedError" class="error-text" :class="themeClass('error-text')">{{ relatedError }}</text
          ><button
            v-for="item in relatedItems"
            :key="item.id"
            role="button"
            class="related-option"
            @click="selectRelated(item)"
          >
            <text class="field-value" :class="themeClass('field-value')">{{ item.title }}</text></button
          ><LoadingIndicator v-if="relatedLoading" label="正在加载关联记录" />
          <text
            v-else-if="!relatedItems.length && !relatedError"
            class="muted-text"
            >暂无匹配记录</text
          ><button
            v-if="relatedError || relatedItems.length < relatedTotal"
            role="button"
            class="small-action"
            :disabled="relatedLoading"
            @click="searchRelated(!relatedError)"
           :class="themeClass('small-action')">
            {{ relatedError ? '重试' : '加载更多' }}
          </button></template
        ></view
      >
    </view>
  </AdaptiveModal>
</template>

