/* 首页与时迹共用：时间、附属记录、标题和描述。 */
.compact-fields,
.compact-notes {
  gap: $space-form;
  margin-bottom: $space-form;
}
.compact-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-section;
  min-height: 52px;
  padding: $space-detail $space-section;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  box-sizing: border-box;
}
.compact-category {
  width: 100%;
  margin: 0;
  background-color: transparent;
  text-align: left;
  line-height: type-line('title');
}
.compact-value {
  flex: 1;
  min-width: 0;
  @include type-style('body');
  color: #27272a;
}
.compact-time-range {
  flex-direction: row;
  align-items: center;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  background-color: #f7f8fa;
  padding: $space-inline 0;
}
.compact-time-arrow {
  position: relative;
  width: 100%;
  height: type-line('glyph-chevron');
}
// 1px 横线保持清晰，较小的尖端仅承担方向提示；长度随时长文字自适应。
.compact-time-arrow-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 1px;
  height: 1px;
  background-color: #8b8f99;
}
.compact-time-arrow-head {
  position: absolute;
  top: 50%;
  right: 1px;
  width: 6px;
  height: 6px;
  margin-top: -3px;
  box-sizing: border-box;
  border-top: 1px solid #8b8f99;
  border-right: 1px solid #8b8f99;
  transform: rotate(45deg);
}
.compact-time-summary {
  flex-shrink: 0;
  align-items: center;
