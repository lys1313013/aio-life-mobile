<script setup lang="ts">
import CalendarPicker from './CalendarPicker.uvue';
import { buttonLabelClasses } from '../services/button-label.ts'
import LoadingIndicator from './LoadingIndicator.uvue';
import ContentSkeleton from './ContentSkeleton.uvue';
import spacing from '../styles/spacing.json'
import AppIcon from './AppIcon.uvue'
import { themeClass } from '../services/theme.ts'
import { recordChanged } from '../services/time-changes.ts'
import { computed, ref, watch, onMounted, onUnmounted } from 'vue'
import AdaptiveModal from './AdaptiveModal.uvue'
import FormActions from './FormActions.uvue'
import FormField from './FormField.uvue'
import TimeEndPicker from './TimeEndPicker.uvue'
import CategoryIcon from './CategoryIcon.uvue'
import TimeRelatedSelector from './TimeRelatedSelector.uvue'
import type { Category, TimeRecord } from '../services/dashboard.ts'
import { getDateRecords, todayDate } from '../services/dashboard.ts'
import {
  getCategories,
  getRecord,
  recommendNext,
  createRecord,
  updateRecord,
  updateRelatedStatus,
  deleteRecord,
  getExerciseTypes,
  getRelateTypes,
} from '../services/time.ts'
import {
  categoryPath,
  recordMinutes,
  validateRecord,
  adjustRecordTime,
  durationEnd,
} from '../services/time-format.ts'
import { timeSelectionBounds } from '../services/time-selection.ts'
import { clockLabel } from '../services/dashboard-format.ts'
import { restoreSession, session } from '../services/session.ts'

const props = withDefaults(defineProps<{ recordId?: string; initialDate?: string; compact?: boolean }>(), { compact: true })
const emit = defineEmits(['close'])
const id = ref(''),
  date = ref(todayDate()),
  loading = ref(true),
  saving = ref(false),
  deleting = ref(false)
const errorText = ref(''),
  ready = ref(false),
  full = ref(false),
  confirmDelete = ref(false)
const categories = ref<Category[]>([]),
  existing = ref<TimeRecord[]>([])
const form = ref<TimeRecord>({
  id: '',
  date: date.value,
  categoryId: '',
  startTime: 0,
  endTime: 59,
  title: '',
  description: '',
  exercises: [],
})
const choosingCategory = ref(false)
const choosingTime = ref('')
const previewTime = ref<number | null>(null)
watch(choosingTime, () => { previewTime.value = null })
const pickerBounds = computed(() => timeSelectionBounds(form.value, existing.value, choosingTime.value))
const categoryOptions = computed(() =>
  categories.value.filter((category) => category.isEnabled !== 0),
)
const categoryName = computed(() =>
  form.value.categoryId
    ? categoryPath(form.value.categoryId, categories.value)
    : '选择分类',
)
const selectedCategory = computed(() =>
  categories.value.find((item) => item.id === form.value.categoryId),
)
const previewRecord = computed(() =>
  choosingTime.value && previewTime.value !== null
    ? { ...form.value, [choosingTime.value]: previewTime.value }
    : form.value,
)
const duration = computed(() => recordMinutes(previewRecord.value))
const displayDate = computed(() => {
  const [year, month, day] = date.value.split('-').map(Number)
  const weekday = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][new Date(year, month - 1, day).getDay()]
  const prefix = year === new Date().getFullYear() ? '' : year + '年'
  return `${prefix}${month}月${day}日  ${weekday}`
})
const displayDuration = computed(() => {
  const hours = Math.floor(duration.value / 60), minutes = duration.value % 60
  return (hours ? hours + '小时' : '') + (minutes || !hours ? minutes + '分' : '')
})
const isExercise = computed(
  () =>
    categoryName.value.split(' / ').includes('运动') ||
    (form.value.exercises || []).length > 0,
)
interface ExerciseGroup {
  typeId: string
  indices: number[]
  total: number
}
const choosingExercise = ref(false)
const addingExerciseType = ref(false)
const selectedExerciseTypeId = ref('')
const editingExerciseIndex = ref<number | null>(null)
const exerciseTypeDraft = ref('')
const exerciseCountDraft = ref('')
const exerciseEditError = ref('')
watch([exerciseTypeDraft, exerciseCountDraft], () => { exerciseEditError.value = '' })
const exerciseGroups = computed<ExerciseGroup[]>(() => {
  const groups: ExerciseGroup[] = []
  ;(form.value.exercises || []).forEach((item, index) => {
    let group = groups.find((entry) => entry.typeId === item.exerciseTypeId)
    if (!group) {
      group = { typeId: item.exerciseTypeId, indices: [], total: 0 }
      groups.push(group)
    }
    group.indices.push(index)
    const count = Number(item.exerciseCount)
    if (item.exerciseCount != null && Number.isFinite(count)) group.total += count
  })
  return groups
})
const activeExerciseGroup = computed(() =>
  exerciseGroups.value.find((group) => group.typeId === selectedExerciseTypeId.value) ||
  exerciseGroups.value[0] ||
  null,
)
const activeExerciseTabIndex = computed(() =>
  exerciseGroups.value.findIndex((group) => group.typeId === activeExerciseGroup.value?.typeId),
)
const exerciseSelectionKey = computed(() => JSON.stringify([exerciseTypes.value, exerciseLoading.value, exerciseError.value]))
const exerciseTypes = ref<{ id: string; dictLabel: string; icon?: string; color?: string }[]>([]),
  exerciseLoading = ref(false),
  exerciseError = ref('')
const editingExerciseType = computed(() => exerciseTypes.value.find((item) => item.id === exerciseTypeDraft.value))
const editingExerciseNumber = computed(() => {
  const index = editingExerciseIndex.value
  if (index === null) return 1
  return (form.value.exercises || []).filter((item, itemIndex) =>
    item.exerciseTypeId === exerciseTypeDraft.value && (index < 0 || itemIndex < index),
  ).length + 1
})
const relateTypes = ref<{ label: string; value: number }[]>([])
const relatedType = computed(
  () =>
    relateTypes.value.find((t) => categoryName.value.includes(t.label))
      ?.value ||
    form.value.relateType ||
    0,
)
const relatedError = ref('')
const relatedStatus = ref('')
watch(() => [form.value.relateId, relatedType.value], () => { relatedStatus.value = '' }, { flush: 'sync' })
const relatedLayoutRevision = ref(0)
const layoutKey = computed(() =>
  JSON.stringify([
    ready.value,
    loading.value,
    full.value,
    form.value,
    errorText.value,
    relatedError.value,
    relatedStatus.value,
    relatedLayoutRevision.value,
    exerciseError.value,
    exerciseTypes.value,
    selectedExerciseTypeId.value,
  ]),
)
const selectionKey = computed(() => JSON.stringify(categoryOptions.value))
let active = true, generation = 0
let repeating: ReturnType<typeof setInterval> | null = null
let suppressClickUntil = 0
onMounted(() => {
  restoreSession()
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  id.value = props.recordId || ''
  date.value = props.initialDate || todayDate()
  initialize()
})
onUnmounted(() => {
  stopAdjust()
  active = false
  generation++
})
function report(error) {
  if (error.name === 'SessionExpiredError') {
    uni.reLaunch({ url: '/pages/login/index' })
    return ''
  }
  return error.message || '操作失败，请重试'
}
async function initialize() {
  choosingTime.value = ''
  const serial = ++generation,
    token = session.token
  loading.value = true
  ready.value = false
  errorText.value = ''
  full.value = false
  try {
    const cats = await getCategories()
    if (!active || serial !== generation || token !== session.token) return
    categories.value = cats
    if (id.value) {
      const detail = await getRecord(id.value)
      if (!detail) throw new Error('这条记录已不存在')
      const day = detail.date || date.value
      const records = await getDateRecords(day)
      if (!active || serial !== generation || token !== session.token) return
      date.value = day
      existing.value = records
      form.value = {
        ...detail,
        date: day,
        exercises: (detail.exercises || []).map((e) => ({
          id: e.id,
          exerciseTypeId: e.exerciseTypeId,
          exerciseCount: e.exerciseCount,
          description: e.description,
        })),
      }
    } else {
      const result = await recommendNext(date.value)
      if (!active || serial !== generation || token !== session.token) return
      existing.value = result.records
      if (!result.recommend) {
        full.value = true
        return
      }
      form.value = {
        id: '',
        date: date.value,
        categoryId: form.value.categoryId || result.recommend.categoryId || '',
        startTime: result.recommend.startTime,
        endTime: result.recommend.endTime,
        title: form.value.title || '',
        description: form.value.description || '',
        exercises: form.value.exercises || [],
        relateId: form.value.relateId,
        relateType: form.value.relateType,
      }
    }
    ready.value = true
    loadOptions()
  } catch (error) {
    if (active && serial === generation) errorText.value = report(error)
  } finally {
    if (serial === generation) loading.value = false
  }
}
async function loadOptions() {
  try {
    relateTypes.value = await getRelateTypes()
  } catch (error) {
    if (active) relatedError.value = report(error)
  }
  if (isExercise.value) loadExercises()
}
async function loadExercises() {
  if (exerciseLoading.value) return
  exerciseLoading.value = true
  exerciseError.value = ''
  try {
    exerciseTypes.value = (await getExerciseTypes()).dictDetailList || []
  } catch (error) {
    if (active) exerciseError.value = report(error)
  } finally {
    exerciseLoading.value = false
  }
}
function selectCategory(category: Category) {
  const previousRelatedType = relatedType.value
  form.value.categoryId = category.id
  if (relatedType.value !== previousRelatedType) clearRelated()
  choosingCategory.value = false
  if (isExercise.value && exerciseTypes.value.length === 0) loadExercises()
}
function changeDate(event) {
  date.value = event.detail.value
  initialize()
}
function changeTime(minutes: number) {
  if (saving.value || deleting.value || !choosingTime.value) return
  const bounds = pickerBounds.value
  if (minutes < bounds.min || minutes > bounds.max) return
  form.value[choosingTime.value] = minutes
  choosingTime.value = ''
}
function changeDuration(event, unit: string) {
  const value = Number(event.detail.value)
  if (!Number.isInteger(value) || value < 0) {
    errorText.value = '时长须为非负整数'
    return
  }
  const minutes =
    unit === 'hours'
      ? value * 60 + (duration.value % 60)
      : Math.floor(duration.value / 60) * 60 + value
  form.value.endTime = durationEnd(form.value, existing.value, minutes)
  errorText.value = ''
}
function adjust(field: string, minutes: number) {
  form.value[field] = adjustRecordTime(
    form.value,
    existing.value,
    field,
    minutes,
  )
}
function tapAdjust(field: string, minutes: number) {
  if (Date.now() < suppressClickUntil) return
  adjust(field, minutes)
}
function startAdjust(field: string, minutes: number) {
  stopAdjust()
  suppressClickUntil = Number.POSITIVE_INFINITY
  adjust(field, minutes)
  repeating = setInterval(() => adjust(field, minutes), 100)
}
function stopAdjust() {
  if (repeating) {
    clearInterval(repeating)
    suppressClickUntil = Date.now() + 350
  }
  repeating = null
}
function goBack() {
  stopAdjust()
  if (!saving.value && !deleting.value) emit('close')
}
async function submit() {
  if (!ready.value || saving.value || deleting.value) return
  errorText.value = validateRecord(form.value, existing.value)
  if (errorText.value) return
  saving.value = true
  const token = session.token
  try {
    // 保存前重新拉取当天记录，避免编辑期间另一个端新增记录造成重叠。
    const latest = await getDateRecords(form.value.date || date.value)
    if (!active || token !== session.token) return
    const validation = validateRecord(form.value, latest)
    if (validation) {
      errorText.value = validation
      existing.value = latest
      return
    }
    const payload = {
      id: form.value.id,
      date: form.value.date,
      categoryId: form.value.categoryId,
      startTime: form.value.startTime,
      endTime: form.value.endTime,
      relateId: form.value.relateId,
      relateType: form.value.relateType,
      title: form.value.title?.trim() || '',
      description: form.value.description || '',
      exercises: (form.value.exercises || []).map((e) => ({
        ...e,
        exerciseCount:
          e.exerciseCount == null ? undefined : Number(e.exerciseCount),
      })),
    }
    if (id.value) await updateRecord(payload)
    else {
      const body = Object.assign({}, payload)
      delete body.id
      payload.id = await createRecord(body as TimeRecord)
      // 状态另走关联记录接口；部分成功后重试必须更新同一条时迹，不能重复新增。
      id.value = payload.id
      form.value.id = payload.id
    }
    if (!active || token !== session.token) return
    recordChanged(payload)
    if (relatedStatus.value && payload.relateId && payload.relateType) {
      try {
        await updateRelatedStatus(payload.relateType, payload.relateId, relatedStatus.value)
      } catch (error) {
        if (active && token === session.token) errorText.value = '时迹已保存，状态更新失败：' + report(error) + '，请再次保存重试'
        return
      }
    }
    if (!active || token !== session.token) return
    uni.showToast({ title: '已保存', icon: 'success' })
    emit('close')
  } catch (error) {
    if (active) errorText.value = report(error)
  } finally {
    saving.value = false
  }
}
async function remove() {
  if (saving.value || deleting.value) return
  deleting.value = true
  errorText.value = ''
  const token = session.token
  try {
    await deleteRecord(id.value)
    if (!active || token !== session.token) return
    recordChanged(null, id.value)
    uni.showToast({ title: '已删除', icon: 'success' })
    emit('close')
  } catch (error) {
    if (active) errorText.value = report(error)
  } finally {
    deleting.value = false
  }
}
function exerciseType(typeId: string) {
  return exerciseTypes.value.find((item) => item.id === typeId)
}
function exerciseName(typeId: string) {
  return (
    exerciseType(typeId)?.dictLabel ||
    (typeId ? '已选运动' : '选择运动')
  )
}
function exerciseCountLabel(index: number) {
  const count = form.value.exercises?.[index]?.exerciseCount
  return count == null ? '未填写' : count + '次'
}
function openExerciseSelection(forNewType = false) {
  if (saving.value || deleting.value) return
  addingExerciseType.value = forNewType
  choosingExercise.value = true
  if (!exerciseTypes.value.length) loadExercises()
}
function selectExercise(typeId: string) {
  if (saving.value || deleting.value) return
  choosingExercise.value = false
  if (addingExerciseType.value && editingExerciseIndex.value === null) {
    openExerciseEditor(-1, typeId)
  } else {
    exerciseTypeDraft.value = typeId
  }
}
function openExerciseEditor(index: number, typeId = '') {
  if (saving.value || deleting.value) return
  const item = index >= 0 ? form.value.exercises?.[index] : null
  exerciseTypeDraft.value = item?.exerciseTypeId || typeId
  const matching = (form.value.exercises || []).filter((entry) => entry.exerciseTypeId === typeId)
  const previous = matching[matching.length - 1]
  exerciseCountDraft.value = item?.exerciseCount == null
    ? previous?.exerciseCount == null ? '' : String(previous.exerciseCount)
    : String(item.exerciseCount)
  exerciseEditError.value = ''
  editingExerciseIndex.value = index
}
function closeExerciseEditor() {
  editingExerciseIndex.value = null
  exerciseEditError.value = ''
}
function saveExerciseSet() {
  if (editingExerciseIndex.value === null) return
  if (!exerciseTypeDraft.value || !/^\d+$/.test(exerciseCountDraft.value.trim())) {
    exerciseEditError.value = '请选择运动类型并填写有效次数'
    return
  }
  const count = Number(exerciseCountDraft.value.trim())
  if (!Number.isSafeInteger(count)) {
    exerciseEditError.value = '次数超出有效范围'
    return
  }
  const item = { exerciseTypeId: exerciseTypeDraft.value, exerciseCount: count }
  if (editingExerciseIndex.value >= 0) {
    const previous = form.value.exercises?.[editingExerciseIndex.value]
    if (previous) form.value.exercises[editingExerciseIndex.value] = { ...previous, ...item }
  } else {
    form.value.exercises = [...(form.value.exercises || []), item]
  }
  selectedExerciseTypeId.value = exerciseTypeDraft.value
  closeExerciseEditor()
}
function removeExerciseSet() {
  if (editingExerciseIndex.value === null || editingExerciseIndex.value < 0) return
  removeExerciseSetAt(editingExerciseIndex.value)
  closeExerciseEditor()
}
function removeExerciseSetAt(index: number) {
  if (saving.value || deleting.value) return
  form.value.exercises?.splice(index, 1)
}
function selectRelated(item) {
  relatedStatus.value = ''
  form.value.relateId = item.id
  form.value.relateType = relatedType.value
  form.value.title = item.title.startsWith('《')
    ? item.title
    : '《' + item.title + '》'
}
function clearRelated() {
  relatedStatus.value = ''
  form.value.relateId = null
  form.value.relateType = null
}
function retryOptions() {
  relatedError.value = ''
  loadOptions()
}
function closeSelection() {
  choosingCategory.value = false
}
</script>

<template>
  <AdaptiveModal
    :label="id ? '编辑时迹' : '记录时间'"
    :show-close="false"
    :max-width="compact ? 440 : 600"
    :vertical-inset="spacing.overlayBlock + spacing.modal"
    :busy="saving || deleting"
    :content-key="layoutKey"
    @close="goBack"
  >
    <view class="editor-content">
      <view v-if="loading" class="editor-loading">
        <view v-if="compact" class="editor-loading-skeleton" aria-hidden="true">
          <view class="compact-fields">
            <view class="compact-row editor-placeholder editor-loading-row" :class="themeClass('editor-placeholder')" />
            <view class="compact-row editor-placeholder editor-loading-row" :class="themeClass('editor-placeholder')" />
            <view class="compact-time-range editor-placeholder" :class="themeClass('editor-placeholder')"><view class="compact-time-field" /></view>
          </view>
          <view class="compact-notes">
            <view class="compact-title editor-placeholder" :class="themeClass('editor-placeholder')" />
            <view class="compact-description editor-placeholder" :class="themeClass('editor-placeholder')" />
          </view>
        </view>
        <ContentSkeleton v-else variant="form" :rows="4" label="正在加载时迹详情" />
        <view class="editor-loading-status">
          <LoadingIndicator compact label="正在加载时迹详情" />
          <text class="loading-label" :class="themeClass('loading-label')" aria-hidden="true">正在加载</text>
        </view>
      </view>
      <view v-if="full" class="state-card"
         :class="themeClass('state-card')"><text class="empty-title" :class="themeClass('empty-title')">该天已录入完毕</text
        ><CalendarPicker :value="date" @change="changeDate"
           label="选择日期"><view class="picker-field"
            ><text class="action-label ui-type-body">选择其他日期</text></view
          ></CalendarPicker></view
      >
      <view v-if="!ready && errorText" class="state-card"
         :class="themeClass('state-card')"><text class="error-text" role="alert" :class="themeClass('error-text')">{{ errorText }}</text
        ><button role="button" class="text-action" @click="initialize"><text :class="buttonLabelClasses(['text-action'])">重试加载</text></button></view
      >
      <view v-if="ready" class="editor-form">
        <view v-if="compact" class="compact-fields">
          <CalendarPicker class="compact-date" :value="date" :disabled="!!id || saving || deleting"
            label="记录日期" @change="changeDate">
            <view class="compact-row" :class="themeClass('compact-row')">
              <AppIcon name="ant-design:calendar-outlined" :size="22" color="#8b8f99" />
              <text class="compact-value" :class="themeClass('compact-value')">{{ displayDate }}</text>
            </view>
          </CalendarPicker>
          <button role="button" aria-label="选择分类" class="compact-row compact-category ui-type-body"
            :class="themeClass('compact-row')" :disabled="saving || deleting"
            @click="choosingCategory = true">
            <CategoryIcon v-if="selectedCategory" :icon="selectedCategory.icon" :color="selectedCategory.color" :size="22" />
            <AppIcon v-else name="ant-design:appstore-outlined" :size="22" color="#8b8f99" />
            <text class="compact-value" :class="themeClass('compact-value')">{{ categoryName }}</text>
            <AppIcon name="ant-design:right-outlined" :size="18" color="#8b8f99" />
          </button>
          <view class="compact-time-section">
            <view class="compact-time-range" :class="themeClass('compact-time-range')">
              <button role="button" class="compact-time-picker end-time-trigger" aria-label="开始时间"
                :disabled="saving || deleting" @click="choosingTime = 'startTime'">
                <view class="compact-time-field">
                  <text class="compact-time-label" :class="themeClass('compact-time-label')">开始</text>
                  <text class="compact-time-number" :class="themeClass('compact-time-number')">{{ clockLabel(previewRecord.startTime) }}</text>
                </view>
              </button>
              <view class="compact-time-summary">
                <text class="compact-duration" :class="themeClass('compact-duration')" aria-label="记录时长">{{ displayDuration }}</text>
                <view class="compact-time-arrow" aria-hidden="true">
                  <view class="compact-time-arrow-line" />
                  <view class="compact-time-arrow-head" />
                </view>
              </view>
              <button role="button" class="compact-time-picker end-time-trigger" aria-label="结束时间"
                :disabled="saving || deleting" @click="choosingTime = 'endTime'">
                <view class="compact-time-field">
                  <text class="compact-time-label" :class="themeClass('compact-time-label')">结束</text>
                  <text class="compact-time-number" :class="themeClass('compact-time-number')">{{ clockLabel(previewRecord.endTime) }}</text>
                </view>
              </button>
            </view>
          </view>

        </view>
        <template v-else>
        <view class="form-card">
          <CalendarPicker
            v-if="!id"
            :value="date"
            :disabled="!!id || saving || deleting"
            @change="changeDate"
             label="选择日期"><view class="field-row"
              ><view class="required-field-label"><text class="required-mark">*</text><text class="field-label">日期</text></view
              ><text class="field-value" :class="themeClass('field-value')">{{ date }}</text></view
            ></CalendarPicker>
          <view class="title-field"
            ><text class="field-label">标题</text
            ><input
              v-model="form.title"
              class="title-input"
              :placeholder-class="'time-editor-placeholder ' + themeClass('time-editor-placeholder')"
              placeholder="标题"
              aria-label="记录标题"
              :maxlength="50"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
          :class="themeClass('title-input')" /></view>
          <button
            role="button"
            aria-label="选择分类"
            class="field-row field-button ui-type-body"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            @click="choosingCategory = true"
          >
            <view class="required-field-label"><text class="required-mark">*</text><text class="field-label">分类</text></view
            ><view class="category-value"
              ><CategoryIcon
                v-if="selectedCategory"
                :icon="selectedCategory.icon"
                :color="selectedCategory.color"
                :size="18"
              /><text class="field-value selected-category-name" :class="themeClass('field-value')">{{
                categoryName
              }}</text></view
            ><AppIcon name="ant-design:right-outlined" />
          </button>
        </view>
        <view class="form-card">
          <view class="time-fields">
            <view
              v-for="field in ['startTime', 'endTime']"
              :key="field"
              class="time-column"
            >
              <view class="required-field-label"><text class="required-mark">*</text><text class="field-label">{{ field === 'startTime' ? '开始时间' : '结束时间' }}</text></view>
              <view class="time-control" :class="themeClass('time-control')">
                <button
                  role="button"
                  class="time-step-button ui-type-body"
                  hover-class="step-pressed"
                  :aria-label="(field === 'startTime' ? '开始时间 ' : '结束时间 ') + '-1 分钟'"
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, -1)"
                  @longpress="startAdjust(field, -1)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                ><AppIcon name="ant-design:minus-outlined" :size="18" /></button>
                <button role="button" class="time-picker end-time-trigger"
                  :aria-label="field === 'startTime' ? '开始时间' : '结束时间'"
                  :disabled="saving || deleting" @click="choosingTime = field">
                  <view class="time-field"><text class="time-number" :class="themeClass('time-number')">{{ clockLabel(previewRecord[field]) }}</text></view>
                </button>
                <button
                  role="button"
                  class="time-step-button ui-type-body"
                  hover-class="step-pressed"
                  :aria-label="(field === 'startTime' ? '开始时间 ' : '结束时间 ') + '+1 分钟'"
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, 1)"
                  @longpress="startAdjust(field, 1)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                ><AppIcon name="ant-design:plus-outlined" :size="18" /></button>
              </view>
              <view class="quick-row"
                ><button
                  v-for="delta in [-30, 30]"
                  :key="delta"
                  role="button"
                  class="duration-step ui-type-body"
                  hover-class="step-pressed"
                  :aria-label="
                    (field === 'startTime' ? '开始时间 ' : '结束时间 ') +
                    (delta > 0 ? '+' : '') +
                    delta +
                    ' 分钟'
                  "
                  :disabled="saving || deleting"
                  @click="tapAdjust(field, delta)"
                  @longpress="startAdjust(field, delta)"
                  @touchend="stopAdjust"
                  @touchcancel="stopAdjust"
                >
                  <text class="step-face"
                     :class="themeClass('step-face')">{{ delta > 0 ? '+' : '' }}{{ delta }}</text
                  >
                </button></view
              >
            </view>
          </view>
          <view class="duration-fields"
            ><text class="field-label">时长</text
            ><input
              type="number"
              :value="String(Math.floor(duration / 60))"
              :disabled="saving || deleting"
              class="duration-input"
              aria-label="时长小时"
              @input="changeDuration($event, 'hours')"
            :class="themeClass('duration-input')" /><text class="duration-unit">时</text
            ><input
              type="number"
              :value="String(duration % 60)"
              :disabled="saving || deleting"
              class="duration-input"
              aria-label="时长分钟"
              @input="changeDuration($event, 'minutes')"
            :class="themeClass('duration-input')" /><text class="duration-unit">分</text></view
          >
        </view>
        <view class="form-card"
          ><text class="field-label">描述</text
          ><textarea
            v-model="form.description"
            class="description-input"
            :placeholder-class="'time-editor-placeholder ' + themeClass('time-editor-placeholder')"
            placeholder="描述信息"
            aria-label="记录备注"
            :maxlength="200"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            :auto-height="true"
          :class="themeClass('description-input')" />
        </view>
        </template>
        <view v-if="relatedType" class="form-card">
          <TimeRelatedSelector :type="relatedType" :relate-id="form.relateId" :title="form.title"
            :status="relatedStatus" :disabled="saving || deleting" @status-change="relatedStatus = $event"
            @select="selectRelated" @clear="clearRelated" @resize="relatedLayoutRevision++" />
        </view>
        <view v-if="relatedError" class="form-error"
          ><text class="error-text" :class="themeClass('error-text')">{{ relatedError }}</text
          ><button role="button" class="small-action" @click="retryOptions" :class="themeClass('small-action')"><text :class="buttonLabelClasses(['small-action', themeClass('small-action')])">重试关联选项</text></button></view
        >
        <view v-if="isExercise" class="form-card">
          <view class="exercise-heading">
            <text class="exercise-heading-label" :class="themeClass('exercise-heading-label')">运动明细</text>
            <button role="button" class="exercise-add ui-type-body" aria-label="添加运动"
              :disabled="saving || deleting" @click="openExerciseSelection(true)">
              <AppIcon name="ant-design:plus-outlined" :size="20" color="#4e7ee3" />
            </button>
          </view>
          <scroll-view v-if="exerciseGroups.length" direction="horizontal" :scroll-x="true" :show-scrollbar="false"
            :scroll-into-view="'time-exercise-tab-' + activeExerciseTabIndex" :scroll-with-animation="true"
            class="exercise-tab-scroll">
            <view class="exercise-tabs">
              <button v-for="(group, groupIndex) in exerciseGroups" :key="group.typeId" :id="'time-exercise-tab-' + groupIndex" role="button" class="exercise-tab"
                :aria-label="exerciseName(group.typeId) + '，' + group.indices.length + '组，共' + group.total + '次'"
                :aria-pressed="activeExerciseGroup?.typeId === group.typeId"
                @click="selectedExerciseTypeId = group.typeId">
                <view class="exercise-tab-heading">
                  <CategoryIcon :icon="exerciseType(group.typeId)?.icon || 'lucide:dumbbell'" :color="exerciseType(group.typeId)?.color || '#4e7ee3'" :size="16" />
                  <text class="exercise-tab-name" :class="[{ 'exercise-tab-name-active': activeExerciseGroup?.typeId === group.typeId }, themeClass('exercise-tab-name')]">{{ exerciseName(group.typeId) }}</text>
                </view>
                <text class="exercise-tab-summary" :class="[{ 'exercise-tab-summary-active': activeExerciseGroup?.typeId === group.typeId }, themeClass('exercise-tab-summary')]">{{ group.indices.length }}组 · {{ group.total }}次</text>
              </button>
            </view>
          </scroll-view>
          <view v-if="activeExerciseGroup" class="exercise-set-grid">
            <view v-for="(exerciseIndex, groupIndex) in activeExerciseGroup.indices" :key="exerciseIndex"
              class="exercise-set-tile" :class="themeClass('exercise-set-tile')">
              <button role="button" class="exercise-set-edit"
                :aria-label="exerciseName(activeExerciseGroup.typeId) + '第' + (groupIndex + 1) + '组，' + exerciseCountLabel(exerciseIndex) + '，编辑'"
                :disabled="saving || deleting" @click="openExerciseEditor(exerciseIndex)">
                <text class="exercise-set-order" :class="themeClass('exercise-set-order')">第{{ groupIndex + 1 }}组</text>
                <text class="exercise-set-value" :class="themeClass('exercise-set-value')">{{ form.exercises?.[exerciseIndex]?.exerciseCount ?? '未填写' }}</text>
              </button>
              <button role="button" class="exercise-set-remove"
                :aria-label="'删除' + exerciseName(activeExerciseGroup.typeId) + '第' + (groupIndex + 1) + '组'"
                :disabled="saving || deleting" @click.stop="removeExerciseSetAt(exerciseIndex)">
                <AppIcon name="ant-design:close-outlined" :size="12" color="#8b8f99" />
              </button>
            </view>
            <button role="button" class="exercise-set-tile exercise-set-add" :class="themeClass('exercise-set-tile')"
              :aria-label="'为' + exerciseName(activeExerciseGroup.typeId) + '加一组'"
              :disabled="saving || deleting" @click="openExerciseEditor(-1, activeExerciseGroup.typeId)">
              <AppIcon name="ant-design:plus-outlined" :size="20" color="#4e7ee3" />
            </button>
          </view>
        </view>
        <view v-if="compact" class="compact-notes">
          <input v-model="form.title" class="compact-title" :class="themeClass('compact-title')"
            :placeholder-class="'time-editor-placeholder ' + themeClass('time-editor-placeholder')"
            placeholder="标题" aria-label="记录标题" :maxlength="50" :disabled="saving || deleting" />
          <textarea v-model="form.description" class="compact-description" :class="themeClass('compact-description')"
            :placeholder-class="'time-editor-placeholder ' + themeClass('time-editor-placeholder')"
            placeholder="描述" aria-label="记录备注" :maxlength="200" :disabled="saving || deleting" :auto-height="true" />
        </view>
        <view v-if="ready && errorText" class="form-error"
          ><text class="error-text" role="alert" :class="themeClass('error-text')">{{ errorText }}</text></view
        >

      </view>
    </view>
    <template #footer>
        <FormActions>
          <template #secondary>
          <view v-if="ready && id" class="delete-anchor"
            ><button
              role="button"
              class="delete-button"
              aria-label="删除记录"
              :disabled="saving || deleting"
              :aria-disabled="saving || deleting"
              @click="confirmDelete = !confirmDelete"
             :class="themeClass('delete-button')">
              <AppIcon name="ant-design:delete-outlined" color="#df5661" /></button
            ><view v-if="confirmDelete" class="delete-confirm"
               :class="themeClass('delete-confirm')"><text class="field-value" :class="themeClass('field-value')">删除这条时间记录？</text
              ><view class="confirm-actions"
                ><button
                  role="button"
                  class="small-action"
                  :disabled="deleting"
                  :aria-disabled="deleting"
                  @click="confirmDelete = false"
                 :class="themeClass('small-action')"><text :class="buttonLabelClasses(['small-action', themeClass('small-action')])">取消</text></button
                ><button
                  role="button"
                  class="delete-button"
                  :disabled="deleting"
                  :aria-disabled="deleting"
                  :loading="deleting"
                  @click="remove"
                 :class="themeClass('delete-button')"><text :class="buttonLabelClasses(['delete-button', themeClass('delete-button')])">确认删除</text></button></view
              ></view
            ></view
          >
          </template>
          <button
            role="button"
            class="cancel-action"
            :disabled="saving || deleting"
            @click="goBack"
           :class="themeClass('cancel-action')">
            <text class="action-label action-label-cancel" :class="themeClass('action-label-cancel')">取消</text>
          </button>
          <view v-if="loading" class="editor-loading-action editor-placeholder" :class="themeClass('editor-placeholder')" aria-hidden="true" />
          <button
            role="button"
            v-if="ready"
            class="save-button"
            :disabled="saving || deleting"
            :aria-disabled="saving || deleting"
            :loading="saving"
            :aria-busy="saving"
            @click="submit"
          >
            <text class="action-label">保存</text>
          </button>
        </FormActions>
    </template>
  </AdaptiveModal>
  <AdaptiveModal
    v-if="choosingCategory"
    :show-close="false"
    :content-key="selectionKey"
    :max-width="500"
    label="选择分类"
    @close="closeSelection"
  >
    <view class="selection-panel"><view class="selection-scroll category-selection"
        ><view class="category-grid"
          ><button
            v-for="item in categoryOptions"
            :key="item.id"
            role="button"
            class="category-option ui-type-body"
            :aria-label="categoryPath(item.id, categories)"
            :aria-pressed="item.id === form.categoryId"
            :class="[({ 'category-selected': item.id === form.categoryId }), themeClass(({ 'category-selected': item.id === form.categoryId }))]"
            @click="selectCategory(item)"
          >
            <CategoryIcon :icon="item.icon" :color="item.color" :size="24" />
            <text class="category-name" :class="themeClass('category-name')">{{
              categoryPath(item.id, categories)
            }}</text></button
          ><text v-if="!categoryOptions.length" class="muted-text"
            >暂无分类</text
          ></view
        ></view
      >
    </view>
  </AdaptiveModal>
  <AdaptiveModal v-if="editingExerciseIndex !== null" :label="editingExerciseIndex < 0 ? '添加一组' : '编辑运动组'" :show-close="false" :dense="true"
    :max-width="400" :content-key="JSON.stringify([exerciseTypeDraft, exerciseCountDraft, exerciseEditError])" @close="closeExerciseEditor">
    <view class="exercise-edit-panel">
      <text class="exercise-edit-order" :class="themeClass('exercise-edit-order')">第{{ editingExerciseNumber }}组</text>
      <button role="button" class="exercise-edit-field exercise-edit-type" :class="themeClass('exercise-edit-field')" aria-label="修改运动类型" @click="openExerciseSelection(false)">
        <view class="exercise-edit-icon" :class="themeClass('exercise-edit-icon')">
          <CategoryIcon :icon="editingExerciseType?.icon || 'lucide:dumbbell'" :color="editingExerciseType?.color || '#4e7ee3'" :size="20" />
        </view>
        <text class="exercise-edit-type-name" :class="themeClass('exercise-edit-type-name')">{{ exerciseName(exerciseTypeDraft) }}</text>
      </button>
      <FormField label="本组次数" hide-label compact>
        <input :value="exerciseCountDraft" type="number" class="exercise-edit-field exercise-edit-count" :class="[themeClass('exercise-edit-field'), themeClass('exercise-edit-count')]"
          aria-label="本组次数" placeholder="数量" :placeholder-class="'time-editor-placeholder ' + themeClass('time-editor-placeholder')"
          @input="exerciseCountDraft = String($event.detail.value)" />
      </FormField>
      <text v-if="exerciseEditError" class="error-text" role="alert" :class="themeClass('error-text')">{{ exerciseEditError }}</text>
      <FormActions>
        <template #secondary>
          <button v-if="editingExerciseIndex >= 0" role="button" class="exercise-edit-delete" aria-label="删除本组" @click="removeExerciseSet">
            <AppIcon name="ant-design:delete-outlined" :size="18" color="#df5661" />
          </button>
        </template>
        <button role="button" class="save-button exercise-edit-save" @click="saveExerciseSet"><text class="action-label">保存</text></button>
      </FormActions>
    </view>
  </AdaptiveModal>
  <AdaptiveModal v-if="choosingExercise" label="选择运动" :show-close="false"
    :max-width="500" :content-key="exerciseSelectionKey" @close="choosingExercise = false">
    <LoadingIndicator v-if="exerciseLoading" label="正在加载运动项目" />
    <view v-else-if="exerciseError" class="form-error">
      <text class="error-text" :class="themeClass('error-text')">{{ exerciseError }}</text>
      <button role="button" class="small-action" :class="themeClass('small-action')" @click="loadExercises"><text :class="buttonLabelClasses(['small-action', themeClass('small-action')])">重试运动类型</text></button>
    </view>
    <view v-else class="category-grid">
      <button v-for="item in exerciseTypes" :key="item.id" role="button" class="category-option ui-type-body"
        :aria-label="item.dictLabel" :aria-pressed="item.id === exerciseTypeDraft"
        :class="[{ 'category-selected': item.id === exerciseTypeDraft }, themeClass({ 'category-selected': item.id === exerciseTypeDraft })]"
        @click="selectExercise(item.id)">
        <CategoryIcon :icon="item.icon || 'lucide:dumbbell'" :color="item.color || '#1890ff'" :size="24" />
        <text class="category-name" :class="themeClass('category-name')">{{ item.dictLabel }}</text>
      </button>
      <text v-if="!exerciseTypes.length" class="muted-text">暂无运动类型</text>
    </view>
  </AdaptiveModal>

  <TimeEndPicker v-if="choosingTime" :value="form[choosingTime]"
    :min="pickerBounds.min" :max="pickerBounds.max"
    :label="choosingTime === 'startTime' ? '开始时间' : '结束时间'"
    :show-now="choosingTime === 'endTime'"
    @preview="previewTime = $event" @change="changeTime" @close="choosingTime = ''" />
</template>

<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
@include type-utilities('body');

.editor-content {
  width: 100%;
}
.form-card {
  margin-bottom: $space-form;
}
.title-field {
  margin: 0 0 $space-form;
}
.field-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: $space-controlMin;
}
.field-button {
  border: 0;
  padding: 0;
  margin: 0;
  border-radius: 0;
  background-color: transparent;
  line-height: type-line('title');
  text-align: left;
}
.field-label {
  @include type-style('label');

  color: #8b8f99;
  margin-right: $space-inline;
  flex-shrink: 0;
}
.required-field-label { display: flex; flex-direction: row; align-items: center; }
.required-mark {
  margin-right: $space-detail;
  @include type-style('label');
  color: #df5661;
}
.duration-unit {
  @include type-style('label');

  color: #8b8f99;
  flex-shrink: 0;
}
.category-value {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  margin-right: $space-inline;
}
.selected-category-name {
  margin-left: $space-fieldLabel;
}
.field-value {
  @include type-style('body');
  color: #27272a;
  flex-shrink: 1;
}
.time-column {
  padding: 0 $space-detail;
  flex: 1;
  width: 50%;
  min-width: 0;
}
.time-control {
  flex-direction: row;
  align-items: center;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  margin-top: $space-inline;
}
.time-step-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
.time-picker {
  flex: 1;
  min-width: 0;
}
.duration-fields {
  flex-direction: row;
  align-items: center;
  margin-top: $space-section;
}
.time-fields {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 0 (-$space-detail);
}
.time-field {
  width: 100%;
  padding: 0;
  align-items: center;
}
.time-number {
  width: 100%;
  text-align: center;
  @include type-style('metric-small');
  line-height: $space-controlMin;
  color: #27272a;

}
.time-divider {
  @include type-style('glyph-medium');
  color: #b4b4bd;
}
.quick-row {
  flex-wrap: nowrap;
  margin: $space-detail (-$space-detail) 0;
  flex-direction: row;
  justify-content: space-between;
}
.small-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: $space-controlMin;
  line-height: $space-controlMin;
  padding: 0 $space-inline;
  margin: 0;
  border: 0;
  background-color: transparent;
  @include type-style('label');
  color: #4e7ee3;
}
.duration-input {
  flex: 1;
  width: 0;
  height: $space-controlMin;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 0 $space-inline;
  @include type-style('body');
  margin: 0 $space-inline;
  color: #27272a;
  text-align: right;
}
.duration-step {
  display: flex;
  width: 50%;
  height: $space-controlMin;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 $space-detail;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
.step-face {
  width: 100%;
  height: 28px;
  line-height: type-leading('stepControl');
  border: 1px solid #e5e7eb;
  border-radius: 4px;
  text-align: center;
  @include type-style('caption');
  color: #52525b;
}
.step-pressed {
  opacity: 0.55;
}
.title-input {
  @include type-style('body');
  height: $space-controlMin;
  margin-top: $space-inline;
  padding: 0 $space-section;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  color: #27272a;
}
.description-input {
  width: 100%;
  min-height: 60px;
  margin-top: $space-inline;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  @include type-style('body');

  color: #71717a;
  padding: $space-inline;
}
.close-selection {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  line-height: $space-controlMin;
  padding: 0;
  margin: 0;
  border: 0;
  @include type-style('glyph-large');
  background-color: transparent;
  color: #8b8f99;
}
.form-error {
  padding: $space-inline $space-detail $space-section;
}
.cancel-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-modalActionMin;
  height: $space-controlMin;
  line-height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: $space-hairline solid #e5e7eb;
  border-radius: 10px;
  background-color: transparent;
  color: #71717a;
  @include type-style('body');
}
.save-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: $space-modalActionMin;
  height: $space-controlMin;
  line-height: $space-controlMin;
  border: 0;
  padding: 0;
  margin: 0;
  border-radius: 10px;
  // 覆盖平台 disabled 默认配色，保存期间只显示 loading，不改变按钮颜色。
  background-color: #4e7ee3 !important;
  color: #ffffff !important;
  @include type-style('body');
}
.delete-anchor {
  overflow: visible;
  position: relative;
}
.action-label {
  @include type-style('body');
  letter-spacing: type-tracking('normal');
  color: #ffffff;
}
.action-label-cancel { color: #71717a; }
.action-label-cancel-dark { color: #b4b4bd; }
.state-cancel {
  align-self: flex-end;
  margin-top: $space-section;
}
.delete-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: $space-controlMin;
  line-height: $space-controlMin;
  padding: 0 $space-section;
  margin: 0;
  border: 0;
  color: #c65353;
  background-color: transparent;
  @include type-style('body');
}
.delete-confirm {
  position: absolute;
  bottom: 48px;
  left: 0;
  width: 240px;
  z-index: 2;
  border: 1px solid #e5e7eb;
  padding: $space-modal;
  border-radius: 14px;
  background-color: #ffffff;
}
.confirm-actions {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: $space-inline;
}
.selection-panel {
  width: 100%;
}
.selection-heading {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.selection-scroll {
  margin-top: $space-section;
}
.search-input {
  height: $space-controlMin;
  background-color: #f0f2f5;
  border-radius: 10px;
  padding: 0 $space-section;
  @include type-style('body');
  color: #27272a;
}
.search-row {
  flex-direction: row;
}
.related-search {
  flex: 1;
}
.category-selection {
  margin-top: 0;
}
.category-grid {
  flex-direction: row;
  flex-wrap: wrap;
}
.category-option {
  display: flex;
  width: 25%;
  min-height: 76px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: $space-inline $space-detail;
  margin: 0;
  border: 1px solid transparent;
  border-radius: 6px;
  background-color: transparent;
  line-height: type-line('caption');
}
.category-name {
  @include type-style('label');

  color: #52525b;
  text-align: center;
  margin-top: $space-inline;
}
.category-selected {
  border-color: #52525b;
}
.related-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 52px;
  line-height: type-line('title');
  padding: $space-card;
  margin: 0;
  border: 0;
  border-radius: 6px;
  background-color: transparent;
  text-align: left;
}

  .time-control-dark,
  .title-input-dark,
  .description-input-dark,
  .duration-input-dark,
  .delete-confirm-dark {
    border-color: #32353c;
  }
  .cancel-action-dark {
    border-color: #32353c;
    color: #b4b4bd;
  }
  .delete-confirm-dark {
    background-color: #1c1e22;
  }
  .field-value-dark,
  .time-number-dark,
  .duration-input-dark,
  .title-input-dark,
  .search-input-dark {
    color: #eeeeef;
  }
  .description-input-dark {
    color: #b4b4bd;
  }
  .search-input-dark {
    background-color: #282b32;
  }
  .category-name-dark,
  .step-face-dark {
    color: #d4d4d8;
  }
  .step-face-dark {
    border-color: #42454d;
  }
  .category-selected-dark {
    border-color: #d4d4d8;
  }
  .cancel-action-dark {
    border-color: #32353c;
    color: #b4b4bd;
  }
  .small-action-dark {
    color: #8eb1fb;
  }
  .delete-button-dark {
    color: #ed9191;
  }

@media (max-width: 359px) {
  .time-fields {
    flex-direction: column;
    gap: $space-section;
  }
  .time-column {
    width: 100%;
  }
}

.editor-loading { position: relative; }
.editor-loading-skeleton { width: 100%; }
.editor-placeholder { background-color: #edf0f4; border-color: transparent; }
.editor-placeholder-dark { background-color: #2b3038; }
.editor-loading-row { margin-bottom: $space-form; }
.editor-loading-action { width: $space-modalActionMin; height: $space-controlMin; border-radius: 10px; }
.editor-loading-status {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  gap: $space-detail;
}
.loading-label { @include type-style('label');  color: #71717a; }
.loading-label-dark { color: #a1a1aa; }

/* 首页与时迹共用：时间、附属记录、标题和描述。 */
.compact-fields,
.compact-notes {
  gap: $space-form;
  margin-bottom: $space-form;
}
.compact-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-section;
  min-height: 52px;
  padding: $space-detail $space-section;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  box-sizing: border-box;
}
.compact-category {
  width: 100%;
  margin: 0;
  background-color: transparent;
  text-align: left;
  line-height: type-line('title');
}
.compact-value {
  flex: 1;
  min-width: 0;
  @include type-style('body');
  color: #27272a;
}
.compact-time-range {
  flex-direction: row;
  align-items: center;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  background-color: #f7f8fa;
  padding: $space-inline 0;
}
.compact-time-arrow {
  position: relative;
  width: 100%;
  height: type-line('glyph-chevron');
}
// 1px 横线保持清晰，较小的尖端仅承担方向提示；长度随时长文字自适应。
.compact-time-arrow-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 1px;
  height: 1px;
  background-color: #8b8f99;
}
.compact-time-arrow-head {
  position: absolute;
  top: 50%;
  right: 1px;
  width: 6px;
  height: 6px;
  margin-top: -3px;
  box-sizing: border-box;
  border-top: 1px solid #8b8f99;
  border-right: 1px solid #8b8f99;
  transform: rotate(45deg);
}
.compact-time-summary {
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: $space-detail;
  padding-top: $space-detail;
}
.compact-time-picker {
  flex: 1;
  min-width: 0;
}
.end-time-trigger {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
// 临时禁用只阻止操作，保留表单底色，避免深浅主题下闪出原生浅色按钮。
.compact-category,
.end-time-trigger,
.field-button,
.time-step-button,
.duration-step,
.exercise-add,
.exercise-tab,
.exercise-edit-type,
.exercise-edit-delete,
.small-action,
.cancel-action,
.delete-button {
  background-color: transparent !important;
}
/* #ifdef WEB || MP-WEIXIN */
.end-time-trigger::after { border: 0; }
/* #endif */
.compact-time-field {
  align-items: center;
  justify-content: center;
  min-height: 64px;
}
.compact-time-label {
  @include type-style('label');

  color: $text-secondary-light;
}
.compact-time-number {
  @include type-style('time-value');

  color: #27272a;
}
.compact-duration {
  padding: 0 $space-detail;
  text-align: center;
  @include type-style('caption');

  color: $text-secondary-light;
}
.compact-title,
.compact-description {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 0 $space-section;
  @include type-style('body');
  color: #27272a;
}
.compact-title { height: $space-controlMin; }
.compact-description {
  min-height: 72px;
  line-height: type-line('body');
  padding: $space-inline $space-section;
}
/* #ifdef APP */
// 原生渲染器不支持 gap，使用同一组间距 token 给实际相邻项留白。
.compact-date, .compact-category, .compact-title { margin-bottom: $space-form; }
.compact-value { margin-left: $space-section; margin-right: $space-section; }
.compact-duration { margin-bottom: $space-detail; }
/* #endif */
.compact-row-dark,
.compact-time-range-dark,
.compact-title-dark,
.compact-description-dark { border-color: #32353c; }
.compact-time-range-dark { background-color: #23262b; }
.compact-value-dark,
.compact-time-number-dark,
.compact-title-dark,
.compact-description-dark { color: #eeeeef; }

.exercise-heading {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.exercise-heading-label { @include type-style('title'); color: #27272a; }
.exercise-heading-label-dark { color: #eeeeef; }
.exercise-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}
.exercise-tab-scroll { width: 100%; min-width: 0; margin-top: $space-detail; white-space: nowrap; }
.exercise-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  // 按全部标签撑开内容宽度，让 scroll-view 获得真实的横向滚动范围。
  /* #ifndef APP */
  width: max-content;
  /* #endif */
  /* #ifdef APP */
  flex-shrink: 0;
  /* #endif */
}
.exercise-tab {
  flex-shrink: 0;
  min-height: $space-controlMin + $space-section;
  margin: 0 $space-section 0 0;
  padding: $space-detail $space-detail $space-inline;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  text-align: left;
}
.exercise-tab-heading { display: flex; flex-direction: row; align-items: center; gap: $space-detail; }
.exercise-tab-name { @include type-style('body-strong'); color: #52525b; white-space: nowrap; }
.exercise-tab-summary { @include type-style('caption'); color: #71717a; white-space: nowrap; }
.exercise-tab-name-dark { color: #b4b4bd; }
.exercise-tab-summary-dark { color: #8b8f99; }
.exercise-tab-name-active,
.exercise-tab-summary-active { color: #4e7ee3; }
.exercise-set-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: $space-section;
  max-width: 440px;
}
.exercise-set-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  box-sizing: border-box;
  width: 31%;
  min-height: $space-controlMin + $space-section * 2;
  margin: 0 0 $space-inline;
  padding: 0;
  border: $space-hairline solid #e5e7eb;
  border-radius: 10px;
  background-color: #f7f8fa;
  text-align: left;
}
.exercise-set-tile-dark { border-color: #32353c; background-color: #23262b; }
.exercise-set-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: $space-controlMin + $space-section * 2;
  margin: 0;
  padding: $space-inline;
  border: 0;
  background-color: transparent;
}
.exercise-set-remove {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: flex-end;
  box-sizing: border-box;
  width: $space-controlMin;
  height: $space-controlMin;
  padding: $space-detail;
  margin: 0;
  border: 0;
  background-color: transparent;
}
.exercise-set-order { @include type-style('caption'); position: relative; top: -$space-detail; align-self: flex-start; color: #71717a; }
.exercise-set-order-dark { color: #a1a1aa; }
.exercise-set-value { @include type-style('metric-small'); width: 100%; text-align: center; color: #27272a; }
.exercise-set-value-dark { color: #eeeeef; }
.exercise-set-add { align-items: center; }
// AdaptiveModal 已提供四周内边距，表单只负责字段间距，避免底部重复留白。
.exercise-edit-panel { gap: $space-section; }
.exercise-edit-order { @include type-style('label'); color: #71717a; }
.exercise-edit-order-dark { color: #b4b4bd; }
.exercise-edit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: $space-controlMin - $space-inline;
  height: $space-controlMin - $space-inline;
  border-radius: 10px;
  background-color: #eaf0ff;
}
.exercise-edit-icon-dark { background-color: #26334c; }
.exercise-edit-field {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: $space-controlMin + $space-inline;
  padding: 0 $space-card;
  border: $space-hairline solid #d4d4d8;
  border-radius: 10px;
  background-color: transparent;
  text-align: left;
}
.exercise-edit-field-dark { border-color: #3f424b; }
.exercise-edit-type {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: $space-inline;
  margin: 0;
}
.exercise-edit-type-name { @include type-style('body'); color: #27272a; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exercise-edit-type-name-dark { color: #eeeeef; }
.exercise-edit-count {
  @include type-style('body');
  color: #27272a;
}
.exercise-edit-count-dark { color: #eeeeef; }
.exercise-edit-save { width: $space-modalActionMin + $space-modal; }
.exercise-edit-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  padding: 0;
  margin: 0;
  border: 0;
  background-color: transparent;
}

/* #ifdef WEB || MP-WEIXIN */
.exercise-add::after,
.exercise-tab::after,
.exercise-set-tile::after,
.exercise-set-edit::after,
.exercise-set-remove::after,
.exercise-edit-type::after,
.exercise-edit-delete::after,
.compact-category::after,
.cancel-action::after,
.field-button::after,
.small-action::after,
.duration-step::after,
.time-step-button::after,
.save-button::after,
.delete-button::after,
.close-selection::after,
.category-option::after,
.related-option::after {
  border: 0;
}
/* #endif */


.compact-time-label-dark,
.compact-duration-dark { color: $text-secondary-dark; }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.text-action-label { @include type-style('body'); color: #5b8ff9; }
.small-action-label { @include type-style('label'); color: #4e7ee3; }
.delete-button-label { color: #c65353; @include type-style('body'); }
.small-action-dark-label { color: #8eb1fb; }
.delete-button-dark-label { color: #ed9191; }
</style>

<!-- 微信原生 placeholder 不携带 scoped 标记，使用独立命名的非 scoped 类。 -->
<style lang="scss">
@use '../styles/typography' as *;
@use '../styles/text-colors' as *;
.time-editor-placeholder {
  @include type-style('body');
  color: $text-secondary-light;
}
.time-editor-placeholder-dark { color: $text-secondary-dark; }
</style>
