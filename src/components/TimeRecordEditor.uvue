}
.editor-placeholder { color: $text-secondary-light; }
.editor-placeholder-dark { color: $text-secondary-dark; }
.compact-title { height: $space-controlMin; }
.compact-description {
  min-height: 72px;
  line-height: type-line('body');
  padding: $space-inline $space-section;
}
.compact-save { flex: 1; @include type-style('body'); border-radius: 10px; }
.compact-row-dark,
.compact-time-range-dark,
.compact-title-dark,
.compact-description-dark { border-color: #32353c; }
