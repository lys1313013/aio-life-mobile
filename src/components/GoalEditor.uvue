<script setup lang="ts">
import ModalMotion from "./ModalMotion.uvue";
import { request } from '../services/api.ts';
import { refreshGoalRows } from '../services/goal-progress.ts';
import { queryVariables, readVariableValues, variableKind, variableSources, writeVariableValues } from '../services/goal-query-variables.ts';
import MobileSwitch from './MobileSwitch.uvue';
import { computed, ref, watch } from 'vue';
import AppIcon from './AppIcon.uvue';
import AdaptiveModal from './AdaptiveModal.uvue';
import ConfirmAction from './ConfirmAction.uvue';
import FormActions from './FormActions.uvue';
import FormField from './FormField.uvue';
import MobileButton from './MobileButton.uvue';
import { isRequired } from '../services/form-required.ts';
import { createRecordScope } from '../services/records/page-scope.ts';
import { session } from '../services/session.ts';
import { themeClass } from '../services/theme.ts';
import { dateTime, goalDateRange, goalPayload, goalTypes, statuses, statusLabels, textTags } from '../services/records/contracts.ts';
const modalMotion0 = ref<{ close: () => void } | null>(null);

const props = defineProps<{ saveRecord: (payload: any) => Promise<any>; deleteRecord: (id: string) => Promise<unknown> }>();
const emit = defineEmits(['saved', 'deleted']);
const form = ref<any>(null), saving = ref(false), formError = ref('');
const detailsOpen = ref(false);
const previewing = ref(false), previewText = ref('');
const variableValues = ref<any>({});
const variableDefinition = computed(() => {
  try { return { fields: queryVariables(form.value?.progressQuery || ''), error: '' }; }
  catch (error) { return { fields: [], error: error.message }; }
});
function resetVariables() {
  try { variableValues.value = readVariableValues(form.value.progressQuery, form.value.progressVariables, form.value.progressVariableBindings); }
  catch (error) { variableValues.value = {}; formError.value = error.message; }
}
function sourceLabel(variable) { return variableSources.find(source => source.value === variableValues.value[variable.name]?.source)?.label || ''; }
function selectSource(variable, label) { variableValues.value[variable.name].source = variableSources.find(source => source.label === label)?.value || 'fixed'; }
function queryForm() {
  return { ...form.value, ...(form.value.progressMode === 'graphql' ? writeVariableValues(form.value.progressQuery, variableValues.value) : {}) };
}
watch(variableDefinition, ({ fields }) => {
  for (const variable of fields) variableValues.value[variable.name] ??= { source: 'fixed', value: '' };
});
watch([form, variableValues], () => { previewText.value = ''; }, { deep: true });
const detailSummary = computed(() => {
  if (!form.value) return '';
  return [form.value.description ? '描述' : '', form.value.content ? '行动计划' : '', form.value.tags ? '标签' : ''].filter(Boolean).join('、');
});
const scope = createRecordScope((clearData) => {
  // 浏览器切到后台保留草稿；真正离页、账号变化或权限过期仍清除。
  // #ifdef WEB
  if (!clearData && document.visibilityState === 'hidden') return;
  // #endif
  form.value = null;
});
watch(() => session.token, () => { form.value = null; });
function open(item = null, pinned = false) {
  if (saving.value) return;
  formError.value = '';
  previewText.value = '';
  detailsOpen.value = false;
  form.value = item
    ? { progressMode: 'manual', progressQuery: '', progressVariables: '{}', progressVariableBindings: '{}', progressValuePath: '', targetOperator: 'gte', ...item, isPinned: item.isPinned === 1 ? 1 : 0, tags: textTags(item.tags) }
    : {
        title: '',
        isPinned: pinned ? 1 : 0,
        type: 1,
        status: 'in_progress',
        description: '',
        content: '',
        tags: '',
        progressMode: 'manual', progressQuery: '', progressVariables: '{}', progressVariableBindings: '{}', progressValuePath: '', targetOperator: 'gte',
        currentValue: '',
        targetValue: '',
        startDate: null,
        endDate: null,
      };
  resetVariables();
}
function setType(label) {
  const type = goalTypes.indexOf(label) + 1;
  form.value.type = type;
  Object.assign(form.value, goalDateRange(type));
}
function setDate(key, date) {
  form.value[key] = dateTime(date, form.value[key]?.slice(11, 16) || '00:00');
}
function setTime(key, time) {
  form.value[key] = dateTime(
    form.value[key]?.slice(0, 10) || new Date().toISOString().slice(0, 10),
    time,
  );
}
async function save() {
  if (saving.value || previewing.value || !form.value) return;
  let payload;
  try { payload = goalPayload(queryForm()); }
  catch (error) { formError.value = error.message; return; }
  saving.value = true;
  formError.value = '';
  try {
    const saved = await scope.wait(props.saveRecord(payload));
    const [latest] = await scope.wait(refreshGoalRows([{ ...payload, ...saved, id: payload.id || saved.id }], request));
    emit('saved', latest);
    form.value = null;
  } catch (error) {
    if (error.name !== 'PageInactiveError') formError.value = error.message;
  } finally { saving.value = false; }
}
async function previewQuery() {
  if (previewing.value) return;
  previewing.value = true; previewText.value = ''; formError.value = '';
  try {
    const stamp = JSON.stringify([form.value, variableValues.value]);
    const result = await scope.wait(request<any>('/goals/progress/preview', 'POST', goalPayload(queryForm(), true)));
    if (!form.value || JSON.stringify([form.value, variableValues.value]) !== stamp) return;
    previewText.value = '当前值 ' + result.currentValue + ' · ' + result.progressPercent + '% · ' + (result.achieved ? '已达标' : '未达标');
  } catch (error) { if (error.name !== 'PageInactiveError') formError.value = error.message; }
  finally { previewing.value = false; }
}
async function remove(item) {
  if (saving.value) return;
  saving.value = true;
  try {
    await scope.wait(props.deleteRecord(item.id));
    emit('deleted', item.id);
    form.value = null;
  } finally { saving.value = false; }
}
defineExpose({ open });
</script>
<template>
      <ModalMotion><AdaptiveModal ref="modalMotion0" v-if="form" label="编辑目标" :show-close="false" :busy="saving || previewing" @close="form = null">
        <view class="goal-title-row ui-field-row"><FormField :required="isRequired('goal', 'title')" appearance="soft" compact stretch label="标题" v-model="form.title" /><MobileButton label="关闭" icon="ant-design:close-outlined" variant="quiet" :disabled="saving" @click="form = null" /></view>
        <view class="filters ui-field-row">
          <FormField :required="isRequired('goal', 'type')" appearance="soft" compact stretch label="类型" kind="selector" :model-value="goalTypes[form.type - 1]" :options="goalTypes" @update:model-value="setType($event)" />
          <FormField :required="isRequired('goal', 'status')" appearance="soft" compact stretch label="状态" kind="selector" :model-value="statusLabels[statuses.indexOf(form.status)]" :options="statusLabels" @update:model-value="form.status = statuses[statusLabels.indexOf($event)]" />
        </view>
        <FormField appearance="soft" label="进度来源" kind="selector" :model-value="form.progressMode === 'graphql' ? 'GraphQL 查询' : '手动填写'" :options="['手动填写', 'GraphQL 查询']" @update:model-value="form.progressMode = $event === 'GraphQL 查询' ? 'graphql' : 'manual'" />
        <view class="filters ui-field-row">
          <FormField v-if="form.progressMode !== 'graphql'" appearance="soft" compact stretch label="当前值" input-type="digit" v-model="form.currentValue" />
          <FormField appearance="soft" compact stretch label="目标值" input-type="digit" v-model="form.targetValue" />
        </view>
        <FormField appearance="soft" label="达标条件" kind="selector" :model-value="form.targetOperator === 'gt' ? '超过目标值（＞）' : '达到目标值（≥）'" :options="['达到目标值（≥）', '超过目标值（＞）']" @update:model-value="form.targetOperator = $event === '超过目标值（＞）' ? 'gt' : 'gte'" />
        <view v-if="form.progressMode === 'graphql'">
          <FormField appearance="soft" label="GraphQL 查询" kind="textarea" textarea-size="regular" v-model="form.progressQuery" />
          <text v-if="variableDefinition.error" role="alert" class="record-error ui-type-body">{{ variableDefinition.error }}</text>
          <view v-for="variable in variableDefinition.fields" :key="variable.name">
            <template v-if="variableValues[variable.name]">
              <FormField v-if="variable.type.replaceAll('!', '') === 'String'" appearance="soft" :label="variable.name + '来源'" kind="selector" :model-value="sourceLabel(variable)" :options="variableSources.map(source => source.label)" @update:model-value="selectSource(variable, $event)" />
              <template v-if="variableValues[variable.name].source === 'fixed'">
                <FormField v-if="variableKind(variable) === 'boolean'" appearance="soft" :required="variable.required" :label="variable.name" kind="selector" :model-value="variableValues[variable.name].value === 'true' ? '是' : variableValues[variable.name].value === 'false' ? '否' : ''" :options="['是', '否']" @update:model-value="variableValues[variable.name].value = $event === '是' ? 'true' : 'false'" />
                <FormField v-else appearance="soft" :required="variable.required" :label="variable.name" :kind="variableKind(variable) === 'json' ? 'textarea' : 'text'" :input-type="variableKind(variable) === 'number' ? 'digit' : 'text'" v-model="variableValues[variable.name].value" />
              </template>
            </template>
          </view>
          <FormField appearance="soft" label="结果路径" placeholder="progress.exerciseCount.max" v-model="form.progressValuePath" />
          <MobileButton label="执行预览" :loading="previewing" :disabled="saving" @click="previewQuery" />
          <text v-if="previewText" role="status" class="goal-query-result ui-type-body">{{ previewText }}</text>
        </view>
        <view class="filters ui-field-row"
          ><FormField appearance="soft" compact stretch
            label="开始日期"
            kind="date"
            :model-value="form.startDate?.slice(0, 10) || ''"
            @update:model-value="setDate('startDate', $event)" /><FormField appearance="soft" compact stretch
            label="开始时间"
            kind="time"
            :model-value="form.startDate?.slice(11, 16) || ''"
            @update:model-value="setTime('startDate', $event)"
        /></view>
        <view class="filters ui-field-row"
          ><FormField appearance="soft" compact stretch
            label="结束日期"
            kind="date"
            :model-value="form.endDate?.slice(0, 10) || ''"
            @update:model-value="setDate('endDate', $event)" /><FormField appearance="soft" compact stretch
            label="结束时间"
            kind="time"
            :model-value="form.endDate?.slice(11, 16) || ''"
            @update:model-value="setTime('endDate', $event)"
        /></view>
        <button hover-class="none" class="goal-more-toggle" :class="themeClass('goal-more-toggle')" role="button" aria-label="补充资料" :aria-expanded="detailsOpen" :disabled="saving" @click="detailsOpen = !detailsOpen">
          <text class="goal-more-label" :class="themeClass('goal-more-label')">补充资料</text>
          <text v-if="detailSummary && !detailsOpen" class="goal-more-summary" :class="themeClass('goal-more-summary')">{{ detailSummary }}</text>
          <AppIcon :name="detailsOpen ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="16" />
        </button>
        <view v-if="detailsOpen">
        <FormField appearance="soft" label="描述" kind="textarea" v-model="form.description" /><FormField appearance="soft"
          label="行动计划"
          kind="textarea"
          v-model="form.content"
        /><FormField appearance="soft" label="标签" placeholder="多个标签用逗号分隔" v-model="form.tags" />
        </view>
        <FormField appearance="soft" label="添加到首页"><MobileSwitch :checked="form.isPinned === 1" :disabled="saving" aria-label="添加到首页" @change="form.isPinned = $event.detail.value ? 1 : 0" /></FormField>
        <template #footer>
        <view class="goal-footer">
        <text v-if="formError" role="alert" class="record-error ui-type-body">{{ formError }}</text>
        <FormActions>
          <template #secondary><ConfirmAction v-if="form.id" label="删除目标" :action="() => remove(form)" /></template>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving"
            @click="modalMotion0?.close()" /><MobileButton label="保存" :loading="saving" @click="save"
        />
        </FormActions>
        </view>
        </template>
      </AdaptiveModal></ModalMotion>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@use '../styles/text-colors' as *;
@include type-utilities('body');
.filters { flex-direction: row; flex-wrap: wrap; }
.goal-title-row { align-items: flex-end; }
.goal-footer { gap: $space-inline; }
.goal-more-toggle { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: $space-inline; min-height: $space-controlMin; width: 100%; padding: 0; margin: 0; background-color: transparent; color: #27272a; }
.goal-more-toggle-dark { color: #eeeeef; }
.goal-more-label { @include type-style('label'); color: #27272a; }
.goal-more-label-dark { color: #eeeeef; }
.goal-more-summary { flex: 1; min-width: 0; text-align: right; @include type-style('caption'); color: $text-secondary-light; }
.goal-more-summary-dark { color: $text-secondary-dark; }
.goal-query-result { white-space: pre-wrap; word-break: break-all; margin-top: $space-inline; }
.record-error { color: #e05252; }
</style>
