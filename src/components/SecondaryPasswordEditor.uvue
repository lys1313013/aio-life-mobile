<script setup lang="ts">
import { onUnmounted, ref, watch } from 'vue';
import { onHide } from '@dcloudio/uni-app';
import AdaptiveModal from './AdaptiveModal.uvue';
import NumericPasswordPad from './NumericPasswordPad.uvue';
import FormField from './FormField.uvue';
import MobileButton from './MobileButton.uvue';
import { request } from '../services/api.ts';
import { session } from '../services/session.ts';
import { themeClass } from '../services/theme.ts';
const props = withDefaults(defineProps<{ mode?: string }>(), { mode: 'create' });
const emit = defineEmits(['close', 'saved']);
const step = ref(props.mode === 'recovery' ? 'code' : props.mode === 'change' ? 'old' : 'new');
const resetting = ref(props.mode === 'recovery');
const password = ref(''), first = ref(''), oldPassword = ref(''), code = ref(''), error = ref(''), busy = ref(false), sending = ref(false);
let revision = 0;
function clear() { revision++; password.value = ''; first.value = ''; oldPassword.value = ''; code.value = ''; error.value = ''; busy.value = false; sending.value = false; }
watch(() => session.token, () => { clear(); emit('close'); });
onUnmounted(clear);
onHide(() => { clear(); emit('close'); });
function startRecovery() { clear(); resetting.value = true; step.value = 'code'; }
async function sendCode() {
  if (sending.value || busy.value) return;
  const v = revision; sending.value = true; error.value = '';
  try { await request('/auth/send-reset-secondary-password-code', 'POST'); if (v === revision) uni.showToast({ title: '验证码已发送', icon: 'none' }); }
  catch (e) { if (v === revision) error.value = e.message; }
  finally { if (v === revision) sending.value = false; }
}
async function submit() {
  if (busy.value) return;
  error.value = '';
  if (step.value === 'old') { if (!/^[0-9]{4,}$/.test(password.value)) { error.value = '至少输入 4 位纯数字'; return; } oldPassword.value = password.value; password.value = ''; step.value = 'new'; return; }
  if (step.value === 'code') { if (!code.value.trim()) { error.value = '请输入邮箱验证码'; return; } step.value = 'new'; return; }
  if (!/^[0-9]{4,}$/.test(password.value)) { error.value = '至少输入 4 位纯数字'; return; }
  if (step.value === 'new') { first.value = password.value; password.value = ''; step.value = 'confirm'; return; }
  if (password.value !== first.value) { error.value = '两次输入的密码不一致'; return; }
  const v = revision, token = session.token; busy.value = true;
  try {
    if (resetting.value) await request('/auth/reset-secondary-password', 'POST', { code: code.value.trim(), password: first.value });
    else await request('/auth/secondary-password', 'PUT', { password: first.value, ...(oldPassword.value ? { oldPassword: oldPassword.value } : {}) });
    if (v !== revision || token !== session.token) return;
    clear(); emit('saved'); emit('close');
  } catch (e) { if (v === revision) { error.value = e.message; if (resetting.value) step.value = 'code'; else if (oldPassword.value) { step.value = 'old'; password.value = oldPassword.value; } } }
  finally { if (v === revision) busy.value = false; }
}
</script>
<template>
  <AdaptiveModal label="二级密码" :max-width="320" :busy="busy || sending" :show-close="false" dense :content-key="step" @close="emit('close')">
    <view v-if="step === 'code'" class="pin-editor-form">
      <text class="pin-editor-title" :class="themeClass('pin-editor-title')">找回二级密码</text>
      <FormField v-model="code" label="邮箱验证码" placeholder="绑定邮箱收到的验证码" :required="true" />
      <MobileButton label="发送验证码" variant="quiet" :loading="sending" @click="sendCode" />
      <text v-if="error" class="pin-editor-error" role="alert">{{ error }}</text>
      <MobileButton label="下一步" @click="submit" />
    </view>
    <NumericPasswordPad v-else v-model="password" :title="step === 'old' ? '验证旧二级密码' : step === 'new' ? '设置数字二级密码' : '再次输入密码'" :recovery="step === 'old'" :error="error" :busy="busy" @update:modelValue="error = ''" @submit="submit" @recover="startRecovery" />
  </AdaptiveModal>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;
.pin-editor-form { gap: $space-form; }
.pin-editor-title { color: #1c1c1e; @include type-style('body-strong'); }
.pin-editor-title-dark { color: #f2f2f7; }
.pin-editor-error { color: #dc3545; @include type-style('caption'); }
</style>
