<script setup lang="ts">
import { appTextColor } from '../services/app-layout.ts'

import { computed, getCurrentInstance, nextTick, onMounted, onUpdated, ref } from 'vue';
import { themeClass } from '../services/theme.ts';
import { pickerValue } from '../services/mobile-ui.ts';
import AppIcon from './AppIcon.uvue';
import RequiredMark from './RequiredMark.uvue';
const props = withDefaults(
  defineProps<{
    label: string;
    required?: boolean;
    hideLabel?: boolean;
    compact?: boolean;
    stretch?: boolean;
    modelValue?: string;
    kind?: string;
    options?: string[];
    error?: string;
    disabled?: boolean;
    placeholder?: string;
    password?: boolean;
    revealable?: boolean;
    inputType?: string;
    appearance?: 'soft';
    textareaSize?: 'regular' | 'compact';
  }>(),
  { modelValue: '', kind: 'text', options: () => [], hideLabel: false },
);
const inputClasses = computed(() => [
  themeClass('form-field-input'),
  {
    'form-field-input-soft': props.appearance === 'soft',
    'form-field-textarea-compact': props.kind === 'textarea' && (props.textareaSize === 'compact' || (props.appearance === 'soft' && props.textareaSize !== 'regular')),
  },
  themeClass({ 'form-field-input-soft': props.appearance === 'soft' }),
]);
const instance = getCurrentInstance();
const passwordVisible = ref(false);
function syncWebLabel() {
  // #ifdef WEB
  nextTick(() => {
    const root = instance?.proxy?.$el;
    const input = root?.querySelector?.('input, textarea');
    if (input) {
      input.setAttribute('aria-label', props.label);
      input.setAttribute('aria-required', String(!!props.required));
    }
  });
  // #endif
}
onMounted(syncWebLabel);
onUpdated(syncWebLabel);
const emit = defineEmits(['update:modelValue']);
function change(event) {
  emit('update:modelValue', pickerValue(props.kind, event.detail.value, props.options));
}
</script>
<template>
  <view class="form-field ui-form-field" :class="[themeClass('form-field'), { 'ui-field-compact': compact, 'ui-field-stretch': stretch }]">
    <view v-if="!hideLabel" class="form-field-heading ui-field-label">
      <RequiredMark v-if="required" />
      <text :style="appearance === 'soft' ? {} : appTextColor()" class="form-field-label" :class="[{ 'form-field-label-soft': appearance === 'soft' }, themeClass({ 'form-field-label-soft': appearance === 'soft' })]">{{ label }}</text>
      <view v-if="$slots.labelAction" class="form-field-label-action"><slot name="labelAction" /></view>
    </view>
    <slot>
      <picker
        v-if="kind === 'date' || kind === 'time' || kind === 'selector'"
        class="form-field-picker"
        :mode="kind"
        :value="kind === 'selector' ? Math.max(0, options.indexOf(modelValue)) : modelValue"
        :range="options"
        :disabled="disabled"
        :aria-label="label"
        :aria-required="!!required"
        @change="change"
        ><view class="form-field-input form-field-picker-input ui-input-inset" :class="inputClasses"
          ><text :style="modelValue ? appTextColor() : {}" class="form-field-picker-value" :class="[{ 'form-field-placeholder': !modelValue }, themeClass({ 'form-field-placeholder': !modelValue })]">{{ modelValue || placeholder || '请选择' }}</text
          ><view v-if="kind === 'selector'" class="form-field-picker-arrow"><AppIcon name="ant-design:down-outlined" :size="12" /></view></view
        ></picker
      >
      <textarea
        v-else-if="kind === 'textarea'"
        class="form-field-input ui-input-inset form-field-textarea ui-pad-card"
        :class="inputClasses"
        :value="modelValue"
        :placeholder="placeholder"
        :disabled="disabled"
        :aria-label="label"
        :aria-required="!!required"
        :maxlength="-1"
        @input="change"
        @blur="change"
      />
      <view
        v-else-if="kind === 'password' && revealable"
        class="form-field-input form-field-password"
        :class="inputClasses"
      >
        <input :style="appTextColor()"
          class="form-field-password-value ui-input-inset"
          :value="modelValue"
          :password="!passwordVisible"
          :placeholder="placeholder"
          :disabled="disabled"
          :aria-label="label"
        :aria-required="!!required"
          @input="change"
          @blur="change"
        />
        <button
          class="form-field-password-toggle ui-type-body"
          role="button"
          :aria-label="passwordVisible ? '隐藏密码' : '显示密码'"
          :aria-pressed="passwordVisible"
          :disabled="disabled"
          @click="passwordVisible = !passwordVisible"
        >
          <AppIcon :name="passwordVisible ? 'ant-design:eye-invisible-outlined' : 'ant-design:eye-outlined'" :size="20" />
        </button>
      </view>
      <input
        v-else
        class="form-field-input ui-input-inset"
        :class="inputClasses"
        :value="modelValue"
        :type="inputType || 'text'"
        :password="password || kind === 'password'"
        :placeholder="placeholder"
        :disabled="disabled"
        :aria-label="label"
        :aria-required="!!required"
        @input="change"
        @blur="change"
      />
    </slot>
    <text v-if="error" class="form-field-error" role="alert">{{ error }}</text>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/text-colors' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@include type-utilities('body');

.form-field {
  min-width: 0;
  color: #27272a;
}
.form-field-dark {
  color: #eeeeef;
}
.form-field-label {
  @include type-style('label');

}
.form-field-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-detail;
}
.form-field-label-action { margin-left: auto; flex-shrink: 0; }
.form-field-input {
  min-height: $space-controlMin;

  border-radius: 10px;
  background-color: #ffffff;
  border: 1px solid #d8dde4;
  justify-content: center;
  @include type-style('body');
  color: #27272a;
}
.form-field-input-dark {
  background-color: #1c1e22;
  border-color: #363940;
  color: #eeeeef;
}
.form-field-picker {
  min-width: 0;
  width: 100%;
}
.form-field-password {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.form-field-password-value {
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;

/* #ifndef APP */
color: inherit;
/* #endif */

  @include type-style('body');
}
.form-field-password-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}
/* #ifdef WEB || MP-WEIXIN */
.form-field-password-toggle::after { border: 0; }
/* #endif */
.form-field-picker-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: $space-inline;
  min-width: 0;
}
.form-field-picker-value {
  @include type-style('body');
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.form-field-picker-arrow {
  flex-shrink: 0;
}
.form-field-textarea {
  box-sizing: border-box;
  height: 120px;
  width: 100%;
  // 多行文本从顶部输入，不继承单行控件的垂直居中。
  justify-content: flex-start;
}
.form-field-error {
  color: #e05260;
  @include type-style('label');
  margin-top: $space-fieldLabel;
}
.form-field-label-soft { color: #707784; }
.form-field-label-soft-dark { color: #a0a6b1; }
.form-field-input-soft {
  border-color: transparent;
  background-color: #f2f4f7;
}
.form-field-input-soft-dark {
  background-color: #272a30;
  color: #dce0e7;
}
.form-field-placeholder { color: $text-secondary-light; }
.form-field-placeholder-dark { color: $text-secondary-dark; }
.form-field-textarea-compact {
  // 两行短备注；长内容仍可在输入框内滚动。
  height: 64px;
}

</style>
