<script setup lang="ts">
import { getCurrentInstance, nextTick, onMounted, onUpdated, ref } from 'vue';
import { themeClass } from '../services/theme.ts';
import { pickerValue } from '../services/mobile-ui.ts';
import AppIcon from './AppIcon.uvue';
const props = withDefaults(
  defineProps<{
    label: string;
    hideLabel?: boolean;
    compact?: boolean;
    stretch?: boolean;
    modelValue?: string;
    kind?: string;
    options?: string[];
    error?: string;
    disabled?: boolean;
    placeholder?: string;
    password?: boolean;
    revealable?: boolean;
    inputType?: string;
  }>(),
  { modelValue: '', kind: 'text', options: () => [], hideLabel: false },
);
const instance = getCurrentInstance();
const passwordVisible = ref(false);
function syncWebLabel() {
  // #ifdef WEB
  nextTick(() => {
    const root = instance?.proxy?.$el;
    const input = root?.querySelector?.('input, textarea');
    if (input) input.setAttribute('aria-label', props.label);
  });
  // #endif
}
onMounted(syncWebLabel);
onUpdated(syncWebLabel);
const emit = defineEmits(['update:modelValue']);
function change(event) {
  emit('update:modelValue', pickerValue(props.kind, event.detail.value, props.options));
}
</script>
<template>
  <view class="form-field ui-form-field" :class="[themeClass('form-field'), { 'ui-field-compact': compact, 'ui-field-stretch': stretch }]">
    <text v-if="!hideLabel" class="form-field-label ui-field-label">{{ label }}</text>
    <slot>
      <picker
        v-if="kind === 'date' || kind === 'time' || kind === 'selector'"
        class="form-field-picker"
        :mode="kind"
        :value="kind === 'selector' ? Math.max(0, options.indexOf(modelValue)) : modelValue"
        :range="options"
        :disabled="disabled"
        :aria-label="label"
        @change="change"
        ><view class="form-field-input form-field-picker-input ui-input-inset" :class="themeClass('form-field-input')"
          ><text class="form-field-picker-value">{{ modelValue || placeholder || '请选择' }}</text
          ><view v-if="kind === 'selector'" class="form-field-picker-arrow"><AppIcon name="ant-design:down-outlined" :size="12" /></view></view
        ></picker
      >
      <textarea
        v-else-if="kind === 'textarea'"
        class="form-field-input ui-input-inset form-field-textarea ui-pad-card"
        :class="themeClass('form-field-input')"
        :value="modelValue"
        :placeholder="placeholder"
        :disabled="disabled"
        :aria-label="label"
        :maxlength="-1"
        @input="change"
        @blur="change"
      />
      <view
        v-else-if="kind === 'password' && revealable"
        class="form-field-input form-field-password"
        :class="themeClass('form-field-input')"
      >
        <input
          class="form-field-password-value ui-input-inset"
          :value="modelValue"
          :password="!passwordVisible"
          :placeholder="placeholder"
          :disabled="disabled"
          :aria-label="label"
          @input="change"
          @blur="change"
        />
        <button
          class="form-field-password-toggle"
          role="button"
          :aria-label="passwordVisible ? '隐藏密码' : '显示密码'"
          :aria-pressed="passwordVisible"
          :disabled="disabled"
          @click="passwordVisible = !passwordVisible"
        >
          <AppIcon :name="passwordVisible ? 'ant-design:eye-invisible-outlined' : 'ant-design:eye-outlined'" :size="20" />
        </button>
      </view>
      <input
        v-else
        class="form-field-input ui-input-inset"
        :class="themeClass('form-field-input')"
        :value="modelValue"
        :type="inputType || 'text'"
        :password="password || kind === 'password'"
        :placeholder="placeholder"
        :disabled="disabled"
        :aria-label="label"
        @input="change"
        @blur="change"
      />
    </slot>
    <text v-if="error" class="form-field-error" role="alert">{{ error }}</text>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
.form-field {
  min-width: 0;
  color: #27272a;
}
.form-field-dark {
  color: #eeeeef;
}
.form-field-label {
  font-size: 14px;

}
.form-field-input {
  min-height: $space-controlMin;

  border-radius: 10px;
  background-color: #ffffff;
  border: 1px solid #d8dde4;
  justify-content: center;
  font-size: 15px;
  color: #27272a;
}
.form-field-input-dark {
  background-color: #1c1e22;
  border-color: #363940;
  color: #eeeeef;
}
.form-field-picker {
  min-width: 0;
  width: 100%;
}
.form-field-password {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.form-field-password-value {
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;
  color: inherit;
  font-size: 15px;
}
.form-field-password-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
}
/* #ifdef WEB || MP-WEIXIN */
.form-field-password-toggle::after { border: 0; }
/* #endif */
.form-field-picker-input {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: $space-inline;
  min-width: 0;
}
.form-field-picker-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.form-field-picker-arrow {
  flex-shrink: 0;
}
.form-field-textarea {
  height: 120px;
  width: 100%;

}
.form-field-error {
  color: #e05260;
  font-size: 13px;
  margin-top: $space-fieldLabel;
}
</style>
