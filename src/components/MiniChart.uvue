<script setup lang="ts">
import { useWindowResize } from '../services/window-resize.ts'
useWindowResize(measure)
import { appTextColor, appButtonTextColor } from '../services/app-layout.ts'

import {
  computed,
  getCurrentInstance,
  nextTick,
  onMounted,
  onUnmounted,
  onUpdated,
  ref,
  watch,
} from "vue";
import MobileButton from "./MobileButton.uvue";
import { themeClass } from "../services/theme.ts";
import { chartGeometry } from "../services/mobile-ui.ts";
import spacing from "../styles/spacing.json";
import typography from "../styles/typography.json";
const props = withDefaults(
  defineProps<{
    label: string;
    labels: string[];
    series: { name: string; color?: string; values: number[] }[];
    kind?: string;
    unit?: string;
    compact?: boolean;
    periodControls?: boolean;
    selectable?: boolean;
    hidePeriodSelector?: boolean;
    hideScale?: boolean;
    hideValues?: boolean;
    showEndValues?: boolean;
  }>(),
  { kind: "line", unit: "" },
);
const width = ref(280),
  hidden = ref<string[]>([]),
  selected = ref(0);
const instance = getCurrentInstance();
let active = true,
  measuring = false;
const palette = ["#427bea", "#e05260", "#20a574", "#e7a638", "#9560c6"];
const coloredSeries = computed(() =>
  props.series.map((item, index) => ({
    ...item,
    color: /^#[\da-f]{6}$/i.test(item.color || "")
      ? item.color
      : palette[index % palette.length],
  })),
);
const visible = computed(() =>
  coloredSeries.value.filter(
    (item) => props.series.length <= 1 || !hidden.value.includes(item.name),
  ),
);
const labelStep = typography.roles["chart-label"].lineHeight + spacing.detail;
const geometry = computed(() => {
  try {
    // Reserve room for two staggered extreme labels without increasing chart height.
    const inset = props.showEndValues
      ? labelStep * Math.max(1, visible.value.length - 1)
      : props.periodControls && props.kind === "bar" ? labelStep * 2 : 0;
    const bottomInset = props.showEndValues ? labelStep : 0;
    const chart = chartGeometry(props.labels, visible.value, width.value, 180 - inset - bottomInset);
    return {
      ...chart,
      zero: chart.zero + inset,
      series: chart.series.map((item) => ({
        ...item,
        points: item.points.map((point) => ({ ...point, y: point.y + inset })),
        segments: item.segments.map((segment) => ({ ...segment, top: segment.top + inset })),
      })),
      error: "",
    };
  } catch (reason) {
    return { min: 0, max: 1, zero: 180, series: [], error: reason.message };
  }
});
const endLabels = computed(() => {
  if (!props.showEndValues || props.kind === "bar") return [];
  const endpoints = geometry.value.series
    .filter((item) => item.points.length)
    .map((item) => ({ ...item, point: item.points[item.points.length - 1] }))
    .sort((a, b) => a.point.y - b.point.y);
  const placed = endpoints.map((item, index) => ({
    name: item.name,
    color: item.color,
    text: displayNumber(item.point.value) + props.unit,
    right: Math.min(
      width.value - item.point.x,
      Math.max(0, width.value - (displayNumber(item.point.value) + props.unit).length * typography.roles["chart-label"].size),
    ),
    // Highest and middle lines label above; the lowest line labels below.
    top: endpoints.length > 1 && index === endpoints.length - 1
      ? item.point.y + spacing.detail
      : item.point.y - labelStep,
  }));
  // Close or equal endpoints keep separate labels, preserving top/bottom placement.
  for (let index = placed.length - 2; index >= 0; index--) {
    placed[index].top = Math.min(placed[index].top, placed[index + 1].top - labelStep);
  }
  return placed;
});
const extremeLabels = computed(() => {
  if (!props.periodControls || props.kind !== "bar") return [];
  return geometry.value.series.flatMap((item, seriesIndex) => {
    const values = item.points.map((point) => point.value);
    if (!values.length) return [];
    // Ties use the first matching month; a single/all-equal series needs one label.
    const indices = [...new Set([values.indexOf(Math.max(...values)), values.indexOf(Math.min(...values))])];
    const groupWidth = width.value / props.labels.length;
    const barWidth = Math.max(3, groupWidth / (visible.value.length + 1));
    const placed: { left: number; top: number; width: number }[] = [];
    return indices.map((index) => {
      const point = item.points[index];
      const text = String(Math.round(point.value * 100) / 100) + props.unit;
      const labelWidth = Math.min(width.value, text.length * typography.roles["chart-label"].size);
      const center = index * groupWidth + (seriesIndex + 1) * barWidth;
      const left = Math.max(0, Math.min(width.value - labelWidth, center - labelWidth / 2));
      let top = Math.min(geometry.value.zero, point.y) - labelStep;
      if (placed.some((other) => left < other.left + other.width && left + labelWidth > other.left && Math.abs(top - other.top) < labelStep)) top -= labelStep;
      placed.push({ left, top, width: labelWidth });
      return {
        key: item.name + index,
        label: props.labels[index] + item.name + text,
        text,
        style: { left: left + "px", top: top + "px", width: labelWidth + "px" },
      };
    });
  });
});
// Charts select values directly by default; explicitly hidden selectors stay static.
const interactive = computed(() => props.periodControls || props.selectable || !props.hidePeriodSelector);
// Start with the latest period and keep the selected period on refresh.
watch(
  () => props.labels.join("|"),
  (_, previous) => {
    if (!props.compact && !interactive.value) return;
    const previousLabel = previous?.split("|")[selected.value];
    const index = previousLabel ? props.labels.indexOf(previousLabel) : -1;
    selected.value = index >= 0 ? index : Math.max(0, props.labels.length - 1);
  },
  { immediate: true },
);
function displayNumber(value: number) {
  if (!props.compact && !props.periodControls && !props.selectable) return String(value);
  return value
    .toFixed(props.unit === "%" ? 1 : 2)
    .replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}
function scaleNumber(value: number) {
  if (!props.compact && !props.periodControls && !props.selectable) return String(value);
  return Math.abs(value) >= 10000
    ? (value / 10000).toFixed(1) + "万"
    : String(Math.round(value * 100) / 100);
}
const selection = computed(() =>
  props.hidePeriodSelector && !props.periodControls && !props.selectable
    ? Math.max(0, props.labels.length - 1)
    : Math.min(selected.value, Math.max(0, props.labels.length - 1)),
);
function selectPeriod(event) {
  if (!interactive.value) return;
  const x = event.detail?.x ?? event.clientX;
  if (typeof x !== 'number') return;
  uni.createSelectorQuery().in(instance?.proxy).select('.mini-chart-plot')
    .boundingClientRect((rect) => {
      if (!active || !rect || Array.isArray(rect) || rect.width <= 0) return;
      const position = (x - rect.left) / rect.width;
      const index = props.kind === 'bar'
        ? Math.floor(position * props.labels.length)
        : Math.round(position * (props.labels.length - 1));
      selected.value = Math.max(0, Math.min(props.labels.length - 1, index));
    }).exec();
}
async function measure() {
  if (!active || measuring) return;
  measuring = true;
  await nextTick();
  uni
    .createSelectorQuery()
    .in(instance?.proxy)
    .select(".mini-chart-plot")
    .boundingClientRect((rect) => {
      if (active && rect && !Array.isArray(rect) && rect.width > 0)
        width.value = rect.width;
      measuring = false;
    })
    .exec();
}
onMounted(() => {
  measure();
});
onUpdated(measure);
onUnmounted(() => {
  active = false;
});
function toggle(name) {
  hidden.value = hidden.value.includes(name)
    ? hidden.value.filter((value) => value !== name)
    : [...hidden.value, name];
}
function barStyle(point, index, seriesIndex) {
  const groupWidth = width.value / props.labels.length,
    barWidth = Math.max(3, groupWidth / (visible.value.length + 1));
  return {
    left: index * groupWidth + seriesIndex * barWidth + barWidth / 2 + "px",
    top: Math.min(geometry.value.zero, point.y) + "px",
    height: Math.max(1, Math.abs(geometry.value.zero - point.y)) + "px",
    width: barWidth + "px",
    backgroundColor: visible.value[seriesIndex].color,
    opacity: interactive.value && index !== selection.value ? 0.45 : 1,
  };
}
</script>
<template>
  <view
    class="mini-chart"
    :class="[themeClass('mini-chart'), { 'mini-chart-compact': compact, 'mini-chart-period': periodControls }]"
    role="figure"
    :aria-label="label"
    ><view v-if="compact || periodControls" class="mini-chart-header"
      ><text :style="appTextColor()" class="mini-chart-title">{{ label }}</text
      ><slot name="actions" /></view
    ><text v-else :style="appTextColor()" class="mini-chart-title">{{ label }}</text
    ><view v-if="compact && series.length > 1" class="chart-legend-compact">
      <button :style="appTextColor()"
        v-for="item in coloredSeries"
        :key="item.name"
        class="chart-legend-button"
        role="button"
        :class="{ 'chart-legend-hidden': hidden.includes(item.name) }"
        :aria-label="item.name"
        :aria-pressed="!hidden.includes(item.name)"
        @click="toggle(item.name)"
      >
        <view
          class="chart-legend-swatch"
          :style="{ backgroundColor: item.color }"
        /><text :style="appButtonTextColor(!hidden.includes(item.name))" class="ui-type-caption">{{ item.name }}</text>
      </button> </view
    ><view v-else-if="!compact && series.length > 1" class="mini-chart-legend"
      ><MobileButton
        v-for="item in series"
        :key="item.name"
        :label="item.name"
        :variant="hidden.includes(item.name) ? 'quiet' : 'primary'"
        @click="toggle(item.name)"><text :style="appButtonTextColor(!hidden.includes(item.name))" class="ui-type-caption">{{ item.name }}</text></MobileButton></view
    ><text v-if="geometry.error" class="mini-chart-error" role="alert">{{
      geometry.error
    }}</text
    ><template v-else-if="labels.length"
      ><view v-if="!periodControls && !hideScale" class="mini-chart-scale"
        ><text class="ui-type-caption mini-chart-tick" :class="themeClass('mini-chart-tick')">{{ scaleNumber(geometry.max) }}{{ unit }}</text
        ><text class="ui-type-caption mini-chart-tick" :class="themeClass('mini-chart-tick')">{{ scaleNumber(geometry.min) }}{{ unit }}</text></view
      ><view :class="{ 'chart-coordinate': periodControls }">
      <view class="mini-chart-plot" :class="{ 'chart-plot-interactive': periodControls, 'chart-plot-selectable': interactive && !periodControls }"
        :role="interactive ? 'slider' : undefined"
        :tabindex="interactive ? 0 : undefined"
        :aria-label="interactive ? label + '，点击图表查看数值' : undefined"
        :aria-valuemin="interactive ? 0 : undefined"
        :aria-valuemax="interactive ? labels.length - 1 : undefined"
        :aria-valuenow="interactive ? selection : undefined"
        :aria-valuetext="interactive ? labels[selection] + ' ' + visible.map((item) => item.name + displayNumber(item.values[selection] ?? 0) + unit).join('，') : undefined"
        @click="selectPeriod"
        @keydown.left.prevent="interactive && (selected = Math.max(0, selection - 1))"
        @keydown.right.prevent="interactive && (selected = Math.min(labels.length - 1, selection + 1))"
        ><view
          class="mini-chart-zero"
          :style="{ top: geometry.zero + 'px' }" /><view
          v-for="(item, seriesIndex) in geometry.series"
          :key="item.name"
          class="mini-chart-series"
          ><template v-if="kind === 'bar'"
            ><view
              v-for="(point, index) in item.points"
              :key="index"
              class="mini-chart-bar"
              :style="barStyle(point, index, seriesIndex)" /></template
          ><template v-else
            ><view
              v-for="(segment, index) in item.segments"
              :key="index"
              class="mini-chart-line"
              :style="{
                left: segment.left + 'px',
                top: segment.top + 'px',
                width: segment.length + 'px',
                backgroundColor: item.color,
                transform: 'rotate(' + segment.angle + 'deg)',
              }" /><view
              v-for="(point, index) in compact && item.points.length > 18
                ? []
                : item.points"
              :key="index"
              class="mini-chart-dot"
              :style="{
                left: point.x - 3 + 'px',
                top: point.y - 3 + 'px',
                backgroundColor: item.color,
              }" /></template></view>
        <text v-for="item in extremeLabels" :key="item.key" class="chart-extreme-label" :class="themeClass('chart-extreme-label')" :style="item.style" :aria-label="item.label">{{ item.text }}</text>
        <text
          v-for="item in endLabels"
          :key="item.name"
          class="chart-end-label"
          :class="themeClass('chart-end-label')"
          :style="{ top: item.top + 'px', right: item.right + 'px', color: item.color }"
          :aria-label="item.name + '总金额'"
        >{{ item.text }}</text>
      </view></view
      ><view v-if="periodControls" class="chart-month-axis">
        <text v-for="(month, index) in labels" :key="month" class="chart-month-label" :class="[themeClass('chart-month-label'), { 'chart-month-selected': index === selection }]">{{ month }}</text>
      </view><view v-else class="mini-chart-axis"
        ><text class="ui-type-caption mini-chart-tick" :class="themeClass('mini-chart-tick')">{{ labels[0] }}</text
        ><text class="ui-type-caption mini-chart-tick" :class="themeClass('mini-chart-tick')">{{ labels[labels.length - 1] }}</text></view
      ><view v-if="periodControls" class="chart-period-controls">
        <view class="chart-period-value" aria-live="polite">
          <text class="chart-period-label">{{ labels[selection] }}{{ visible.map((item) => item.name).join(' / ') }}</text>
          <text v-for="item in visible" :key="item.name" class="chart-period-amount">{{ displayNumber(item.values[selection] ?? 0) }}{{ unit }}</text>
        </view>
      </view><text
        v-if="interactive && !periodControls"
        class="chart-selected-label mini-chart-tick"
        :class="themeClass('mini-chart-tick')"
        aria-live="polite"
      >{{ labels[selection] }}</text><view
        v-if="!periodControls && !hideValues"
        class="mini-chart-values"
        :class="{ 'chart-values-compact': compact }"
        ><template v-if="!compact"
          ><text class="ui-type-body"
            v-for="item in visible"
            :key="item.name"
            :style="{ color: item.color }"
            >{{ item.name }} {{ item.values[selection] }}{{ unit }}</text
          ></template
        >
        <template v-else
          ><view
            v-for="item in visible"
            :key="item.name"
            class="chart-value-item"
            :style="{ color: item.color }"
          >
            <text class="chart-value-label">{{
              item.name
            }}</text>
            <text class="chart-value-number">
              {{ displayNumber(item.values[selection] ?? 0) }}{{ unit }}</text
            >
          </view></template
        ></view
      ></template
    ><text v-else class="mini-chart-empty" :class="themeClass('mini-chart-empty')">暂无数据</text></view
  >
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/text-colors' as *;
@use "../styles/spacing-tokens" as *;
@include type-utilities('caption', 'body');

.mini-chart {
  padding: $space-card;
  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;
  margin-bottom: $space-section;
}
.mini-chart-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.mini-chart-title {
  @include type-style('body-strong');

}
.mini-chart-legend {
  flex-direction: row;
  flex-wrap: wrap;
  gap: $space-inline;
  margin: $space-section 0;
}
.mini-chart-plot {
  height: 180px;
  width: 100%;
  position: relative;
  overflow: visible;
}
.mini-chart-series {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 180px;
  overflow: visible;
}
.mini-chart-line {
  position: absolute;
  height: 2px;
  transform-origin: left center;
}
.mini-chart-dot {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 3px;
}
.mini-chart-bar {
  position: absolute;
  border-radius: 3px;
}
.mini-chart-zero {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background-color: #a1a6b0;
}
.mini-chart-scale {
  flex-direction: row;
  justify-content: space-between;
  @include type-style('caption');
  margin-bottom: $space-inline;
}
.mini-chart-axis {
  flex-direction: row;
  justify-content: space-between;
  @include type-style('caption');
  margin: $space-inline 0 $space-modal;
}
.mini-chart-values {
  flex-direction: row;
  flex-wrap: wrap;
  gap: $space-section;
  @include type-style('body');
}
.mini-chart-error {
  color: #e05260;
  @include type-style('label');
}
.mini-chart-empty {
  color: $text-secondary-light;
  @include type-style('body');
  margin-top: $space-modal;
}
.mini-chart-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: $space-inline;
}
.mini-chart-compact {
  min-width: 0;
}
.chart-legend-compact {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: $space-inline;
  margin-bottom: $space-inline;
}
.chart-legend-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: $space-detail;
  min-height: 44px;
  min-width: 44px;
  padding: 0;
  margin: 0;
  background-color: transparent;

/* #ifndef APP */
color: inherit;
/* #endif */

  border: 0;
  border-radius: 0;
  @include type-style('caption');
  line-height: $space-controlMin;
}
.chart-legend-hidden {
  opacity: 0.4;
}
.chart-legend-swatch {
  width: 7px;
  height: 7px;
  border-radius: 4px;
}
.chart-values-compact {
  display: flex;
  flex-direction: row;
  gap: $space-inline;
  margin-top: $space-inline;
}
.chart-value-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: $space-detail;
}
.chart-value-label {
  @include type-style('badge');
}
.chart-value-number {
  @include type-style('caption-strong');

  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
/* #ifdef WEB || MP-WEIXIN */
.chart-legend-button::after {
  border: 0;
}
/* #endif */

.mini-chart-tick { color: $text-secondary-light; }
.mini-chart-tick-dark, .mini-chart-empty-dark { color: $text-secondary-dark; }
.chart-coordinate { display: flex; flex-direction: row; gap: $space-inline; margin-top: $space-section; overflow: visible; }
.chart-extreme-label { position: absolute; text-align: center; white-space: nowrap; pointer-events: none; @include type-style('chart-label'); color: $text-secondary-light; }
.chart-extreme-label-dark { color: $text-secondary-dark; }
.chart-end-label {
  @include type-style('chart-label');
  position: absolute;
  right: 0;

/* #ifndef APP */
max-width: 100%;
/* #endif */
/* #ifdef APP */
flex-shrink: 1;
/* #endif */

  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
  background-color: #ffffff;
}
.chart-end-label-dark { background-color: #1c1e22; }
.chart-plot-interactive { flex: 1; min-width: 0; width: auto; cursor: pointer; }
.chart-plot-selectable { cursor: pointer; }
.chart-selected-label { @include type-style('caption'); }
.chart-month-axis { display: flex; flex-direction: row; margin-top: $space-inline; }
.chart-month-label { flex: 1; text-align: center; color: $text-secondary-light; @include type-style('chart-label'); }
.chart-month-label-dark { color: $text-secondary-dark; }
.chart-month-selected { color: #427bea; }
.mini-chart-period { margin-bottom: 0; }
.chart-period-controls { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: $space-inline; margin-top: $space-inline; }
.chart-period-value { flex: 1; min-width: 0; flex-direction: row; justify-content: center;
/* #ifndef APP */
align-items: baseline;
/* #endif */
/* #ifdef APP */
align-items: flex-end;
/* #endif */
 gap: $space-inline; }
.chart-period-label { @include type-style('caption'); }
.chart-period-amount { @include type-style('title'); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
</style>
