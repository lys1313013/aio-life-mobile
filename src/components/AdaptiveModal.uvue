<script setup lang="ts">
import PageState from "./PageState.uvue";
import ContentSkeleton from "./ContentSkeleton.uvue";
import { useWindowResize } from '../services/window-resize.ts'
useWindowResize(resize)
import spacing from '../styles/spacing.json'
import MobileButton from './MobileButton.uvue'
import { modalAvailableHeight } from '../services/mobile-ui.ts'
import { themeClass } from '../services/theme.ts'
// #ifdef MP-WEIXIN
import { registerModal } from '../services/modal-presence.ts'
import WeixinModalBackGuard from './WeixinModalBackGuard.uvue'
// #endif
import {
  computed,
  getCurrentInstance,
  nextTick,
  onMounted,
  onUnmounted,
  onUpdated,
  provide,
  ref,
  watch,
} from 'vue'
const props = withDefaults(defineProps<{
  openingMotion?: boolean
  openingOrigin?: string
  loading?: boolean
  loadError?: string
  loadingRows?: number
  maxWidth?: number
  verticalInset?: number
  label: string
  busy?: boolean
  showClose?: boolean
  bare?: boolean
  fill?: boolean
  dense?: boolean
  contentKey?: string
}>(), { showClose: false, bare: false, loading: false, loadError: '', loadingRows: 3 })
const motionReady = ref(false)
const emit = defineEmits(['close', 'reachbottom', 'retry'])
provide('mobile-modal', true)
// #ifdef MP-WEIXIN
const releaseModal = registerModal()
onUnmounted(releaseModal)
// #endif
const instance = getCurrentInstance()
const contentHeight = ref(props.bare ? spacing.controlMin : 160)
const footerHeight = ref(0)
const windowHeight = ref(uni.getWindowInfo().windowHeight)
const keyboardHeight = ref(0)
const viewportTop = ref(0)
const useViewportFrame = ref(!!props.fill)
// #ifdef APP
let keyboardListenerId: number | null = null
// #endif
const safeTop = ref(uni.getWindowInfo().safeAreaInsets?.top || 0)
const safeBottom = ref(uni.getWindowInfo().safeAreaInsets?.bottom || 0)
const verticalInset = computed(() => props.verticalInset ?? spacing.overlayBlock)
const availableHeight = computed(() => modalAvailableHeight(windowHeight.value, keyboardHeight.value, safeTop.value, safeBottom.value, verticalInset.value))
// footer 在滚动区域外；短表单仍按内容收缩，长表单仅正文滚动。
const height = computed(() => props.fill
  ? availableHeight.value
  : Math.min(contentHeight.value, Math.max(0, availableHeight.value - footerHeight.value)))
let active = true
let measuring = false
let pending = false
// #ifdef WEB
let contentObserver: ResizeObserver | null = null
// #endif
async function measure() {
  if (!active || props.fill) return
  if (measuring) {
    pending = true
    return
  }
  measuring = true
  await nextTick()
  if (!active) { measuring = false; return }
  // #ifdef WEB
  const root = instance?.proxy?.$el
  for (const selector of ['.modal-content', '.modal-footer']) {
    const node = root?.querySelector?.(selector)
    if (node) contentObserver?.observe(node)
  }
  // #endif
  // CSS 缩放会改变 boundingClientRect，测量布局高度避免动画期间反复缩小。
  // #ifdef WEB
  const contentNode = root?.querySelector?.('.modal-content')
  if (contentNode) {
    contentHeight.value = contentNode.offsetHeight
    footerHeight.value = root?.querySelector?.('.modal-footer')?.offsetHeight || 0
    motionReady.value = true
    measuring = false
    if (pending) { pending = false; measure() }
    return
  }
  // #endif
  const query = uni.createSelectorQuery().in(instance?.proxy)
  if (instance?.slots?.footer) {
    query.select('.modal-footer').boundingClientRect((rect) => {
      if (active) footerHeight.value = rect && !Array.isArray(rect) ? Math.ceil(rect.height) : 0
    })
  } else {
    footerHeight.value = 0
  }
  query.select('.modal-content')
    .boundingClientRect((rect) => {
      if (active && rect && !Array.isArray(rect) && rect.height > 0)
        contentHeight.value = Math.ceil(rect.height)
      motionReady.value = true
      measuring = false
      if (pending) {
        pending = false
        measure()
      }
    })
    .exec()
}
function resize() {
  const info = uni.getWindowInfo()
  windowHeight.value = info.windowHeight
  safeTop.value = info.safeAreaInsets?.top || 0
  safeBottom.value = info.safeAreaInsets?.bottom || 0
  // H5 软键盘可能只缩小 visualViewport，不触发 uni 的窗口高度变化。
  // #ifdef WEB
  if (window.visualViewport) {
    useViewportFrame.value = true
    windowHeight.value = window.visualViewport.height
    viewportTop.value = window.visualViewport.offsetTop
  }
  // #endif
  measure()
}
function keyboard(event) {
  keyboardHeight.value = event.height || 0
  resize()
}
onMounted(() => {
  if (props.fill) motionReady.value = true
  resize()
  measure()
  // Vapor 的插槽内容更新不一定触发容器的 onUpdated。
  // #ifdef WEB
  window.visualViewport?.addEventListener('resize', resize)
  window.visualViewport?.addEventListener('scroll', resize)
  if (typeof ResizeObserver !== 'undefined') contentObserver = new ResizeObserver(measure)
  nextTick(measure)
  // #endif

  // #ifdef APP
  keyboardListenerId = uni.onKeyboardHeightChange(keyboard)
  // #endif
  // #ifdef MP-WEIXIN
  uni.onKeyboardHeightChange(keyboard)
  // #endif
})
onUpdated(measure)
watch(() => props.contentKey, measure, { flush: 'post' })
watch(() => props.fill, resize, { flush: 'post' })
onUnmounted(() => {
  active = false
  // #ifdef WEB
  window.visualViewport?.removeEventListener('resize', resize)
  window.visualViewport?.removeEventListener('scroll', resize)
  contentObserver?.disconnect()
  contentObserver = null
  // #endif

  // #ifdef APP
  if (keyboardListenerId !== null) uni.offKeyboardHeightChange(keyboardListenerId)
  keyboardListenerId = null
  // #endif
  // #ifdef MP-WEIXIN
  uni.offKeyboardHeightChange(keyboard)
  // #endif
})
</script>
<template>
  <!-- 微信滚动容器会影响 fixed 子节点；整层挂到页面根部，嵌套弹窗也不受父层裁切。 -->
  <!-- #ifdef MP-WEIXIN -->
  <root-portal :enable="true">
    <WeixinModalBackGuard :busy="busy" @close="emit('close')" />
  <!-- #endif -->
  <view class="modal-mask" :class="[themeClass('modal-mask'), { 'modal-mask-loading': bare, 'modal-mask-enter': openingMotion && !bare }, themeClass({ 'modal-mask-loading': bare })]" :style="{ paddingTop: (verticalInset + safeTop) + 'px', paddingBottom: (verticalInset + safeBottom + keyboardHeight) + 'px', ...(useViewportFrame ? { top: viewportTop + 'px', height: windowHeight + 'px', bottom: 'auto' } : {}) }" @click="!busy && emit('close')">
    <!-- 模糊层独立于内容，避免改变内嵌确认框 / picker 的 fixed 定位参照。 -->
    <!-- #ifdef WEB || MP-WEIXIN -->
    <view v-if="!bare" class="modal-backdrop" aria-hidden="true" />
    <!-- #endif -->
    <view
      class="modal-panel"
      :style="{ maxWidth: (maxWidth || 600) + 'px', transformOrigin: openingOrigin || '50% 50%' }"
      role="dialog"
      :aria-label="label"
      aria-modal="true"
      @click.stop
      :class="[themeClass('modal-panel'), { 'modal-panel-bare': bare, 'modal-panel-wait': openingMotion && !bare && !motionReady, 'modal-panel-enter': openingMotion && !bare && motionReady }]">
      <!-- #ifdef WEB || MP-WEIXIN -->
      <view v-if="!bare" class="modal-surface" :class="themeClass('modal-surface')" aria-hidden="true" />
      <!-- #endif -->
      <view v-if="fill" class="modal-fill" :style="{ height: height + 'px' }">
        <view class="modal-fill-body"><PageState v-if="loading || loadError" :loading="loading" :error="loadError" :inherit-initializing="false" @retry="emit('retry')"><template #loading><slot name="loading"><ContentSkeleton variant="form" :rows="loadingRows" /></slot></template></PageState><slot v-else /></view>
        <view v-if="$slots.footer && !loading && !loadError" class="modal-fill-footer"><slot name="footer" /></view>
      </view>
      <template v-else>
      <scroll-view
        @scrolltolower="emit('reachbottom')"
        direction="vertical"
        :scroll-y="true"
        :show-scrollbar="false"
        class="modal-scroll"
        :style="{ height: height + 'px' }"
      >
        <view class="modal-content" :class="{ 'modal-content-bare': bare, 'modal-content-dense': dense, 'modal-content-with-close': showClose !== false }"><view v-if="showClose !== false" class="modal-close"><MobileButton label="关闭" icon="ant-design:close-outlined" variant="ghost" :disabled="busy" @click="emit('close')" /></view><PageState v-if="loading || loadError" :loading="loading" :error="loadError" :inherit-initializing="false" @retry="emit('retry')"><template #loading><slot name="loading"><ContentSkeleton variant="form" :rows="loadingRows" /></slot></template></PageState><slot v-else /></view>
      </scroll-view>
      <view v-if="$slots.footer && !loading && !loadError" class="modal-footer"><slot name="footer" /></view>
      </template>
    </view>
  </view>
  <!-- #ifdef MP-WEIXIN -->
  </root-portal>
  <!-- #endif -->
</template>
<style scoped lang="scss">
@use "../styles/theme-tokens" as *;
@use '../styles/spacing-tokens' as *;
.modal-mask {
  padding: $space-overlayBlock $space-overlayInline;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;

  align-items: center;
  justify-content: center;
  background-color: rgba(18, 24, 38, 0.28);
}
.modal-panel {
  position: relative;
  width: 100%;
  max-width: 600px;
  border-radius: 20px;
  background-color: $theme-surface-light;
  color: #27272a;
  box-shadow: 0 24px 80px -16px rgba(15, 23, 42, 0.3), 0 4px 16px -4px rgba(15, 23, 42, 0.14);
  overflow: hidden;
}
.modal-scroll {
  position: relative;
  width: 100%;
}
.modal-content {
  padding: $space-modal;
  // 首行内容与弹窗圆角之间保留更充足的留白。
  padding-top: $space-modalTop;
}
.modal-content-dense { padding-top: $space-modal; }
.modal-content-with-close { padding-top: $space-detail; }
.modal-close { align-items: flex-end; margin-bottom: $space-inline; }
.modal-content-bare { padding: 0; }
.modal-fill { display: flex; flex-direction: column; min-height: 0; }
.modal-fill-body { padding: $space-modal; display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }
.modal-footer,
.modal-fill-footer { position: relative; flex-shrink: 0; padding: 0 $space-modal $space-modal; }
.modal-mask-dark {
  background-color: rgba(0, 0, 0, 0.48);
}
.modal-panel-dark {
  background-color: $theme-surface-dark;
  color: #e7e9ee;
  box-shadow: 0 24px 80px -16px rgba(0, 0, 0, 0.6), 0 4px 16px -4px rgba(0, 0, 0, 0.32);
}
/* 原生 App 使用上面的实色面板；H5 / 微信按渲染器能力增强。 */
/* #ifdef WEB || MP-WEIXIN */
.modal-backdrop,
.modal-surface {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}
.modal-surface {
  border-radius: 20px;
}
.modal-panel {
  /* 内描边不占布局尺寸，保持内容测高和滚动区域不变。 */
  outline: 1px solid rgba(255, 255, 255, 0.72);
  outline-offset: -1px;
}
.modal-panel-dark {
  outline-color: rgba(255, 255, 255, 0.12);
}
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .modal-backdrop {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .modal-panel,
  .modal-panel-dark {
    background-color: transparent;
  }
  .modal-surface {
    background-color: rgba(255, 255, 255, 0.97);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    backdrop-filter: blur(8px) saturate(120%);
  }
  .modal-surface-dark {
    background-color: rgba(28, 30, 34, 0.97);
  }
}
/* #endif */
.modal-panel-bare { background-color: transparent; border-radius: 0; box-shadow: none; outline: none; }
.modal-mask-loading { background-color: rgba(18, 24, 38, 0.08); }
.modal-mask-loading-dark { background-color: rgba(0, 0, 0, 0.16); }
// 动画结束后不保留 transform，避免改变内部 picker / 确认框的 fixed 参照。
.modal-panel-wait { opacity: 0; }
.modal-mask-enter { animation: modal-mask-appear 220ms ease-out; }
.modal-panel-enter { animation: modal-panel-appear 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
@keyframes modal-mask-appear { from { background-color: transparent; } }
// 原生端使用位移淡入，测高不受缩放影响。
@keyframes modal-panel-appear { from { opacity: 0; transform: translateY($space-section); } to { opacity: 1; transform: translateY(0); } }
/* #ifdef WEB */
@keyframes modal-panel-appear { from { opacity: 0; transform: scale(0.88); } to { opacity: 1; transform: scale(1); } }
@media (prefers-reduced-motion: reduce) {
  .modal-panel-enter, .modal-mask-enter { animation: none; }
}
/* #endif */
</style>
