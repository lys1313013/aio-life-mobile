<script setup lang="ts">
import { useWindowResize } from '../services/window-resize.ts'
useWindowResize(resize)
import spacing from '../styles/spacing.json'
import MobileButton from './MobileButton.uvue'
import { modalAvailableHeight } from '../services/mobile-ui.ts'
import { themeClass } from '../services/theme.ts'
import {
  computed,
  getCurrentInstance,
  nextTick,
  onMounted,
  onUnmounted,
  onUpdated,
  provide,
  ref,
  watch,
} from 'vue'
const props = withDefaults(defineProps<{
  maxWidth?: number
  verticalInset?: number
  label: string
  busy?: boolean
  showClose?: boolean
  bare?: boolean
  contentKey?: string
}>(), { showClose: false, bare: false })
const emit = defineEmits(['close', 'reachbottom'])
provide('mobile-modal', true)
const instance = getCurrentInstance()
const contentHeight = ref(props.bare ? spacing.controlMin : 160)
const windowHeight = ref(uni.getWindowInfo().windowHeight)
const keyboardHeight = ref(0)
// #ifdef APP
let keyboardListenerId: number | null = null
// #endif
const safeTop = ref(uni.getWindowInfo().safeAreaInsets?.top || 0)
const safeBottom = ref(uni.getWindowInfo().safeAreaInsets?.bottom || 0)
const verticalInset = computed(() => props.verticalInset ?? spacing.overlayBlock)
const height = computed(() =>
  Math.min(
    contentHeight.value,
    modalAvailableHeight(windowHeight.value, keyboardHeight.value, safeTop.value, safeBottom.value, verticalInset.value),
  ),
)
let active = true
let measuring = false
let pending = false
// #ifdef WEB
let contentObserver: ResizeObserver | null = null
// #endif
async function measure() {
  if (!active) return
  if (measuring) {
    pending = true
    return
  }
  measuring = true
  await nextTick()
  uni
    .createSelectorQuery()
    .in(instance?.proxy)
    .select('.modal-content')
    .boundingClientRect((rect) => {
      if (active && rect && !Array.isArray(rect) && rect.height > 0)
        contentHeight.value = Math.ceil(rect.height)
      measuring = false
      if (pending) {
        pending = false
        measure()
      }
    })
    .exec()
}
function resize() {
  const info = uni.getWindowInfo()
  windowHeight.value = info.windowHeight
  safeTop.value = info.safeAreaInsets?.top || 0
  safeBottom.value = info.safeAreaInsets?.bottom || 0
  measure()
}
function keyboard(event) {
  keyboardHeight.value = event.height || 0
  resize()
}
onMounted(() => {
  measure()
  // Vapor 的插槽内容更新不一定触发容器的 onUpdated。
  // #ifdef WEB
  nextTick(() => {
    if (!active) return
    const content = instance?.proxy?.$el?.querySelector?.('.modal-content')
    if (content && typeof ResizeObserver !== 'undefined') {
      contentObserver = new ResizeObserver(measure)
      contentObserver.observe(content)
    }
  })
  // #endif

  // #ifdef APP
  keyboardListenerId = uni.onKeyboardHeightChange(keyboard)
  // #endif
  // #ifdef MP-WEIXIN
  uni.onKeyboardHeightChange(keyboard)
  // #endif
})
onUpdated(measure)
watch(() => props.contentKey, measure, { flush: 'post' })
onUnmounted(() => {
  active = false
  // #ifdef WEB
  contentObserver?.disconnect()
  contentObserver = null
  // #endif

  // #ifdef APP
  if (keyboardListenerId !== null) uni.offKeyboardHeightChange(keyboardListenerId)
  keyboardListenerId = null
  // #endif
  // #ifdef MP-WEIXIN
  uni.offKeyboardHeightChange(keyboard)
  // #endif
})
</script>
<template>
  <view class="modal-mask ui-modal-mask" :class="[themeClass('modal-mask'), { 'modal-mask-loading': bare }, themeClass({ 'modal-mask-loading': bare })]" :style="{ paddingTop: (verticalInset + safeTop) + 'px', paddingBottom: (verticalInset + safeBottom + keyboardHeight) + 'px' }" @click="!busy && emit('close')">
    <!-- 模糊层独立于内容，避免改变内嵌确认框 / picker 的 fixed 定位参照。 -->
    <!-- #ifdef WEB || MP-WEIXIN -->
    <view v-if="!bare" class="modal-backdrop" aria-hidden="true" />
    <!-- #endif -->
    <view
      class="modal-panel"
      :style="{ maxWidth: (maxWidth || 600) + 'px' }"
      role="dialog"
      :aria-label="label"
      aria-modal="true"
      @click.stop
      :class="[themeClass('modal-panel'), { 'modal-panel-bare': bare }]">
      <!-- #ifdef WEB || MP-WEIXIN -->
      <view v-if="!bare" class="modal-surface" :class="themeClass('modal-surface')" aria-hidden="true" />
      <!-- #endif -->
      <scroll-view
        @scrolltolower="emit('reachbottom')"
        direction="vertical"
        :scroll-y="true"
        :show-scrollbar="false"
        class="modal-scroll"
        :style="{ height: height + 'px' }"
      >
        <view class="modal-content ui-modal-content" :class="{ 'modal-content-bare': bare }"><view v-if="showClose !== false" class="modal-close ui-mb-sm"><MobileButton label="关闭" icon="ant-design:close-outlined" variant="ghost" :disabled="busy" @click="emit('close')" /></view><slot /></view>
      </scroll-view>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;

  align-items: center;
  justify-content: center;
  background-color: rgba(18, 24, 38, 0.28);
}
.modal-panel {
  position: relative;
  width: 100%;
  max-width: 600px;
  border-radius: 20px;
  background-color: #ffffff;
  box-shadow: 0 24px 80px -16px rgba(15, 23, 42, 0.3), 0 4px 16px -4px rgba(15, 23, 42, 0.14);
  overflow: hidden;
}
.modal-scroll {
  position: relative;
  width: 100%;
}
.modal-content {
  // 首行内容与弹窗圆角之间保留更充足的留白。
  padding-top: $space-modalTop;
}
.modal-close { align-items: flex-end;  }
.modal-content-bare { padding: 0; }
.modal-mask-dark {
  background-color: rgba(0, 0, 0, 0.48);
}
.modal-panel-dark {
  background-color: #1c1e22;
  box-shadow: 0 24px 80px -16px rgba(0, 0, 0, 0.6), 0 4px 16px -4px rgba(0, 0, 0, 0.32);
}
/* 原生 App 使用上面的实色面板；H5 / 微信按渲染器能力增强。 */
/* #ifdef WEB || MP-WEIXIN */
.modal-backdrop,
.modal-surface {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}
.modal-surface {
  border-radius: 20px;
}
.modal-panel {
  /* 内描边不占布局尺寸，保持内容测高和滚动区域不变。 */
  outline: 1px solid rgba(255, 255, 255, 0.72);
  outline-offset: -1px;
}
.modal-panel-dark {
  outline-color: rgba(255, 255, 255, 0.12);
}
@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
  .modal-backdrop {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .modal-panel,
  .modal-panel-dark {
    background-color: transparent;
  }
  .modal-surface {
    background-color: rgba(255, 255, 255, 0.97);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    backdrop-filter: blur(8px) saturate(120%);
  }
  .modal-surface-dark {
    background-color: rgba(28, 30, 34, 0.97);
  }
}
/* #endif */
.modal-panel-bare { background-color: transparent; border-radius: 0; box-shadow: none; outline: none; }
.modal-mask-loading { background-color: rgba(18, 24, 38, 0.08); }
.modal-mask-loading-dark { background-color: rgba(0, 0, 0, 0.16); }
</style>
