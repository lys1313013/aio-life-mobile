<script setup lang="ts">
import { computed } from 'vue';
import { themeClass } from '../services/theme.ts';
const props = withDefaults(defineProps<{ rows: string[]; footer?: boolean; actions?: boolean; expandPrimary?: boolean; label?: string; flat?: boolean }>(), {
  footer: true, actions: true, label: '正在加载记录详情',
});
const fieldShape = computed(() => {
  const shape = props.flat ? 'form-skeleton-block' : 'form-skeleton-outline';
  return [shape, themeClass(shape)];
});
</script>
<template>
  <view class="form-skeleton" role="status" :aria-label="label" aria-live="polite">
    <view aria-hidden="true">
      <view v-for="(row, index) in rows" :key="index" class="form-skeleton-row"
        :class="{ 'form-skeleton-section': row === 'section', 'form-skeleton-flush': row === 'toggle' || row === 'attachment' || (!actions && index === rows.length - 1) }">
        <view v-for="column in (row === 'pair' ? 2 : 1)" :key="column" class="form-skeleton-field">
          <view v-if="!['section', 'picker-control', 'control', 'controls', 'appearance', 'toggle', 'attachment', 'thought'].includes(row)" class="form-skeleton-label">
            <view class="form-skeleton-line form-skeleton-caption" :class="themeClass('form-skeleton-line')" />
          </view>
          <view v-if="row === 'section'" class="form-skeleton-line form-skeleton-caption" :class="themeClass('form-skeleton-line')" />
          <view v-else-if="row === 'controls' || row === 'appearance'" class="form-skeleton-options">
            <view v-for="n in (row === 'appearance' ? 2 : 4)" :key="n" class="form-skeleton-option form-skeleton-outline" :class="[themeClass('form-skeleton-outline'), { 'form-skeleton-appearance-button': row === 'appearance' && n === 2 }]" />
          </view>
          <view v-else-if="row === 'switch' || row === 'toggle'" class="form-skeleton-inline">
            <view v-if="row === 'switch'" class="form-skeleton-outline form-skeleton-switch" :class="themeClass('form-skeleton-outline')" />
            <view v-else class="form-skeleton-line form-skeleton-caption" :class="themeClass('form-skeleton-line')" />
          </view>
          <view v-else class="form-skeleton-input" :class="[fieldShape, { 'form-skeleton-picker': row === 'picker-control', 'form-skeleton-textarea': row === 'textarea', 'form-skeleton-thought': row === 'thought', 'form-skeleton-upload': row === 'attachment' }]">
            <view v-if="!flat && row !== 'attachment'" class="form-skeleton-line" :class="themeClass('form-skeleton-line')" />
          </view>
        </view>
      </view>
      <view v-if="actions" class="form-skeleton-actions" :class="{ 'form-skeleton-footer': footer }">
        <view v-for="n in (expandPrimary ? 1 : 2)" :key="n" class="form-skeleton-button" :class="[fieldShape, { 'form-skeleton-primary': expandPrimary }]">
          <view v-if="!flat" class="form-skeleton-line" :class="themeClass('form-skeleton-line')" />
        </view>
      </view>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/form-control';
@use '../styles/skeleton';
@use '../styles/spacing-tokens' as *;
@use '../styles/typography' as *;
.form-skeleton-outline { @include form-control.surface; }
.form-skeleton-outline-dark { @include form-control.dark; }
.form-skeleton-line { @include skeleton.shape; @include skeleton.pulse; height: $space-inline; width: 36%; max-width: 96px; }
.form-skeleton-line-dark { @include skeleton.dark; }
.form-skeleton-block { @include skeleton.shape; @include skeleton.pulse; box-sizing: border-box; }
.form-skeleton-block-dark { @include skeleton.dark; }
.form-skeleton-caption { width: 24%; max-width: 52px; }
.form-skeleton-row { flex-direction: row; gap: $space-inline; margin-bottom: $space-form; }
.form-skeleton-section { height: type-line('body-strong'); align-items: center; margin-bottom: $space-inline; }
.form-skeleton-flush { margin-bottom: 0; }
.form-skeleton-field { flex: 1; min-width: 0; }
.form-skeleton-label { height: type-line('label'); justify-content: center; margin-bottom: $space-fieldLabel; }
.form-skeleton-input { height: $space-controlMin; justify-content: center; padding: 0 $space-card; }
.form-skeleton-picker { height: $space-controlMin + $space-inline; }
.form-skeleton-textarea, .form-skeleton-thought { justify-content: flex-start; padding-top: $space-card; }
.form-skeleton-textarea { height: 64px; }
.form-skeleton-thought { height: 120px; }
.form-skeleton-upload { width: 104px; height: 104px; border-style: dashed; }
.form-skeleton-inline { height: $space-controlMin; justify-content: center; }
.form-skeleton-switch { margin-left: ($space-controlMin - $space-switchTrackWidth) * 0.5; width: $space-switchTrackWidth; height: $space-switchTrackHeight; border-radius: $space-switchTrackHeight; }
.form-skeleton-options, .form-skeleton-actions { flex-direction: row; gap: $space-inline; }
.form-skeleton-option { width: $space-controlMin; height: $space-controlMin; }
.form-skeleton-appearance-button { width: $space-modalActionMin; }
.form-skeleton-actions { justify-content: flex-end; }
.form-skeleton-button { width: $space-modalActionMin; height: $space-controlMin; align-items: center; justify-content: center; }
.form-skeleton-primary { flex: 1; }
.form-skeleton-footer { padding-top: $space-modal; }
@include skeleton.motion('.form-skeleton-line, .form-skeleton-block');
</style>
