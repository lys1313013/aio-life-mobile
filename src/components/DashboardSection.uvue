<script setup lang="ts">
import CategoryIcon from './CategoryIcon.uvue'
import { isDark, themeClass } from '../services/theme.ts'
defineProps<{ title: string; icon?: string; height?: number; loading?: boolean; error?: string; compact?: boolean; flushTop?: boolean }>()
defineEmits<{ refresh: [] }>()
</script>
<template>
  <view class="dashboard-section" :class="themeClass('dashboard-section')" :style="height ? { height: height + 'px' } : {}">
    <view class="section-heading" :class="{ 'section-heading-compact': compact }">
      <view class="section-label"><CategoryIcon v-if="icon" :icon="icon" :size="16" :color="isDark ? '#d4d4d8' : '#52525b'" /><text class="section-title" :class="[{ 'section-title-with-icon': !!icon }, themeClass('section-title')]">{{ title }}</text></view>
      <slot name="actions" />

    </view>
    <view v-if="error" class="section-error" role="alert">
      <text class="section-error-text" :class="themeClass('section-error-text')">{{ error }}</text>
      <button
        role="button"
        class="section-retry"
        :aria-label="'重试' + title"
        :disabled="loading"
        @click="$emit('refresh')"
       :class="themeClass('section-retry')">
        重试
      </button>
    </view>
    <view v-else-if="loading" class="section-loading"
      ><view class="skeleton" :class="themeClass('skeleton')"></view
      ><view class="skeleton skeleton-short" :class="themeClass('skeleton')"></view
      ><view class="skeleton" :class="themeClass('skeleton')"></view
      ><text class="loading-caption">加载中…</text></view
    >
    <view v-else class="section-content" :class="{ 'section-content-flush-top': flushTop }"><slot /></view>
  </view>
</template>
