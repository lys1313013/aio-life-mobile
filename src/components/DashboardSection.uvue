<script setup lang="ts">
import { buttonLabelClasses } from '../services/button-label.ts'
import ContentSkeleton from './ContentSkeleton.uvue';
import LoadingIndicator from './LoadingIndicator.uvue';
import CategoryIcon from './CategoryIcon.uvue'
import LifeMenuIcon from './LifeMenuIcon.uvue'
import { isDark, themeClass } from '../services/theme.ts'
defineProps<{ title: string; icon?: string; iconColor?: string; height?: number; autoHeight?: boolean; loading?: boolean; updating?: boolean; retainContent?: boolean; error?: string; compact?: boolean; flushTop?: boolean; skeleton?: string }>()
defineEmits<{ refresh: [] }>()
</script>
<template>
  <view class="dashboard-section" :class="themeClass('dashboard-section')" :style="autoHeight ? { height: 'auto' } : height ? { height: height + 'px' } : {}">
    <view class="section-heading" :class="{ 'section-heading-compact': compact }">
      <view class="section-label"><LifeMenuIcon v-if="icon" :icon="icon" :size="16" :color="iconColor" /><text class="section-title" :class="[{ 'section-title-with-icon': !!icon }, themeClass('section-title')]">{{ title }}</text></view>
      <slot name="actions" />
      <LoadingIndicator v-if="updating" class="section-updating" compact :label="'正在更新' + title" />
      <button v-else-if="error && retainContent" role="button" class="section-update-retry" :aria-label="'重试' + title + '：' + error" @click="$emit('refresh')"><CategoryIcon icon="lucide:rotate-cw" :size="18" :color="isDark ? '#a9bfff' : '#5879ce'" /></button>
    </view>
    <view v-if="error && !retainContent" class="section-error" role="alert">
      <text class="section-error-text" :class="themeClass('section-error-text')">{{ error }}</text>
      <button
        role="button"
        class="section-retry"
        :aria-label="'重试' + title"
        :disabled="loading"
        @click="$emit('refresh')"
       :class="themeClass('section-retry')"><text :class="buttonLabelClasses(['section-retry', themeClass('section-retry')])">重试</text></button>
    </view>
    <slot v-else-if="loading" name="loading"><view class="section-loading"><ContentSkeleton compact :variant="skeleton || 'list'" :rows="2" :label="'正在加载' + title" /></view></slot>
    <view v-else class="section-content" :class="{ 'section-content-flush-top': flushTop, 'section-content-auto': autoHeight }"><slot /></view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
.dashboard-section {
  box-sizing: border-box;
  height: 260px;
  background-color: #ffffff;
  border: 1px solid #e8e8ed;
  border-radius: 14px;
  overflow: hidden;
}
.section-updating { position: absolute; right: $space-card + $space-controlMin; }
.section-heading {
  position: relative;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0 $space-card;
  height: $space-controlMin;
  flex-shrink: 0;
}
.section-update-retry { width: $space-controlMin; height: $space-controlMin; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background-color: transparent; border: 0; }
.section-title {
  color: #18181b;
  @include type-style('title');

}
.section-heading-compact { height: $space-controlMin; padding-top: 0; padding-bottom: 0; }
.section-label { flex-direction: row; align-items: center; }
.section-title-with-icon { margin-left: $space-inline; }
.section-content {
  flex: 1;
  min-height: 0;
  padding: $space-fieldLabel $space-card $space-card;
}
.section-content-flush-top { padding-top: 0; }
.section-content-auto { flex: none; }

.section-error,
.section-loading {
  flex: 1;
  padding: $space-section;
  justify-content: center;
}
.section-error {
  align-items: center;
}
.section-error-text {
  color: #bc4949;
  @include type-style('caption');
  text-align: center;
}
.section-retry {
  margin: $space-section 0 0;
  padding: $space-detail $space-card;
  min-height: $space-controlMin;
  @include type-style('caption');
  color: #3662da;
  background-color: #eef2ff;
  border-radius: 8px;
}
  .dashboard-section-dark {
    background-color: #1c1e22;
    border-color: #303238;
  }
  .section-title-dark {
    color: #ececf0;
  }
  .section-error-text-dark {
    color: #f7a3a3;
  }
  .section-retry-dark {
    color: #a9bfff;
    background-color: #29334b;
  }

/* #ifdef WEB || MP-WEIXIN */
.section-retry::after, .section-update-retry::after {
  border: 0;
}
/* #endif */

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.section-retry-label { @include type-style('caption'); color: #3662da; }
.section-retry-dark-label { color: #a9bfff; }
</style>
