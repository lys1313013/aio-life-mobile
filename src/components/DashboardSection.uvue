<script setup lang="ts">
import ContentSkeleton from './ContentSkeleton.uvue';
import LoadingIndicator from './LoadingIndicator.uvue';
import CategoryIcon from './CategoryIcon.uvue'
import LifeMenuIcon from './LifeMenuIcon.uvue'
import HomeCardHeader from './HomeCardHeader.uvue'
import { isDark, themeClass } from '../services/theme.ts'
defineProps<{ title: string; caption?: string; icon?: string; iconColor?: string; height?: number; autoHeight?: boolean; loading?: boolean; updating?: boolean; retainContent?: boolean; error?: string; compact?: boolean; flushTop?: boolean; skeleton?: string; navigable?: boolean; titleLabel?: string; locked?: boolean; refreshDisabled?: boolean }>()
defineEmits<{ refresh: []; navigate: []; unlock: [] }>()
</script>
<template>
  <view class="dashboard-section" :class="themeClass('dashboard-section')" :style="autoHeight && !locked ? { height: 'auto' } : height ? { height: height + 'px' } : {}">
    <HomeCardHeader class="section-heading" :label="'刷新' + title + (caption ? ' ' + caption : '')" :loading="loading || updating" :disabled="refreshDisabled || locked" @refresh="$emit('refresh')">
      <button v-if="navigable" role="button" class="section-label heading-link" :aria-label="titleLabel || '查看' + title" @click.stop="$emit('navigate')"><LifeMenuIcon v-if="icon" :icon="icon" :size="16" :color="iconColor" /><text class="section-title" :class="[{ 'section-title-with-icon': !!icon }, themeClass('section-title')]">{{ title }}</text></button>
      <view v-else class="section-label section-label-static"><LifeMenuIcon v-if="icon" :icon="icon" :size="16" :color="iconColor" /><text class="section-title" :class="[{ 'section-title-with-icon': !!icon }, themeClass('section-title')]">{{ title }}</text></view>
      <text v-if="caption" class="section-caption" :class="themeClass('section-caption')">{{ caption }}</text>
      <slot name="actions" />
      <LoadingIndicator v-if="updating" class="section-updating" compact :label="'正在更新' + title" />
      <button v-else-if="error && retainContent" role="button" class="section-update-retry" :disabled="refreshDisabled" :aria-label="'重试' + title + '：' + error" @click.stop="$emit('refresh')"><CategoryIcon icon="lucide:rotate-cw" :size="18" :color="isDark ? '#a9bfff' : '#5879ce'" /></button>
    </HomeCardHeader>
    <button v-if="locked" role="button" class="section-unlock" :class="themeClass('section-unlock')" :aria-label="'解锁' + title" :disabled="refreshDisabled" hover-class="section-unlock-pressed" @click.stop="$emit('unlock')"><CategoryIcon icon="ant-design:lock-outlined" :size="24" :color="isDark ? '#a1a1aa' : '#71717a'" /></button>
    <view v-else-if="error && !retainContent" class="section-error" role="alert">
      <text class="section-error-text" :class="themeClass('section-error-text')">{{ error }}</text>
      <button
        role="button"
        class="section-retry"
        :aria-label="'重试' + title"
        :disabled="loading || refreshDisabled"
        @click="$emit('refresh')"
       :class="themeClass('section-retry')"><text class="section-retry-label" :class="themeClass('section-retry-label')">重试</text></button>
    </view>
    <slot v-else-if="loading" name="loading"><view class="section-loading"><ContentSkeleton compact :variant="skeleton || 'list'" :rows="2" :label="'正在加载' + title" /></view></slot>
    <view v-else class="section-content" :class="{ 'section-content-auto': autoHeight }"><slot /></view>
  </view>
</template>
<style scoped lang="scss">
@use '../styles/platform' as *;
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;
.dashboard-section {
  position: relative;
  box-sizing: border-box;
  height: 260px;
  background-color: #ffffff;
  border: 1px solid #e8e8ed;
  border-radius: 14px;
  overflow: hidden;
}
.section-updating { position: absolute; right: $space-card + $space-controlMin; }
.section-update-retry { position: relative; z-index: 1; width: $space-controlMin; height: $space-controlMin; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background-color: transparent; border: 0; }
.section-title {
  color: #18181b;
  @include type-style('title');

}
.section-label { display: flex; position: relative; z-index: 1; flex-direction: row; align-items: center; flex-shrink: 0; }
.heading-link { box-sizing: border-box; height: $space-controlMin; min-width: $space-controlMin; margin: 0; padding: $space-inline 0 0; border: 0; border-radius: 0; background-color: transparent; }
.section-label-static { transform: translateY($space-detail); }
.section-title-with-icon { margin-left: $space-inline; }
.section-caption {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 50%;
  @include type-style('caption');
  color: #71717a;
  text-align: center;
  pointer-events: none;
}
.section-caption-dark { color: #a1a1aa; }
.section-content {
  flex: 1;
  min-height: 0;
  padding: 0 $space-card $space-card;
}
.section-content-auto { flex: none; }

.section-error,
.section-loading {
  flex: 1;
  padding: $space-section;
  justify-content: center;
}
.section-error {
  align-items: center;
}
.section-unlock { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; width: $space-controlMin; height: $space-controlMin; padding: 0; margin: 0; border: 0; border-radius: 50%; background-color: #f4f4f5; }
.section-unlock-dark { background-color: #27292f; }
.section-unlock-pressed { opacity: 0.65; }
.section-error-text {
  color: #bc4949;
  @include type-style('caption');
  text-align: center;
}
.section-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: $space-section 0 0;
  padding: $space-detail $space-card;
  min-height: $space-controlMin;
  background-color: #eef2ff;
  border-radius: 8px;
}
  .dashboard-section-dark {
    background-color: #1c1e22;
    border-color: #303238;
  }
  .section-title-dark {
    color: #ececf0;
  }
  .section-error-text-dark {
    color: #f7a3a3;
  }
  .section-retry-dark {
    background-color: #29334b;
  }

.section-unlock, .section-retry, .section-update-retry, .heading-link { @include borderless-button; }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.section-retry-label { @include type-style('caption'); color: #3662da; }
.section-retry-label-dark { color: #a9bfff; }
</style>
