<script setup lang="ts">
defineProps<{ title: string; loading?: boolean; error?: string }>()
defineEmits<{ refresh: [] }>()
</script>
<template>
  <view class="dashboard-section">
    <view class="section-heading">
      <text class="section-title">{{ title }}</text>
      <button
        role="button"
        class="refresh-button"
        :aria-label="'刷新' + title"
        :disabled="loading"
        :loading="loading"
        @click="$emit('refresh')"
      >
        <text v-if="!loading" class="refresh-icon">↻</text>
      </button>
    </view>
    <view v-if="error" class="section-error" role="alert">
      <text class="section-error-text">{{ error }}</text>
      <button
        role="button"
        class="section-retry"
        :aria-label="'重试' + title"
        :disabled="loading"
        @click="$emit('refresh')"
      >
        重试
      </button>
    </view>
    <view v-else-if="loading" class="section-loading"
      ><view class="skeleton"></view
      ><view class="skeleton skeleton-short"></view
      ><view class="skeleton"></view
      ><text class="loading-caption">加载中…</text></view
    >
    <view v-else class="section-content"><slot /></view>
  </view>
</template>
