<script setup lang="ts">
import LoadingIndicator from './LoadingIndicator.uvue';
import MobileButton from './MobileButton.uvue';
withDefaults(defineProps<{ loading?: boolean; hasMore?: boolean }>(), { hasMore: true });
const emit = defineEmits(['load']);
</script>
<template>
  <view v-if="hasMore" class="load-more"
    ><LoadingIndicator v-if="loading" compact label="正在加载更多" /><MobileButton
      v-else
      label="继续加载"
      variant="quiet"
      :loading="loading"
      @click="emit('load')"
  /></view>
</template>
<style scoped lang="scss">
@use '../styles/spacing-tokens' as *;
.load-more {
  align-items: center;
  padding: $space-card;
}
</style>
