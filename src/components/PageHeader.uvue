<script setup lang="ts">
import { useWindowResize } from '../services/window-resize.ts'
useWindowResize(updateLayout)
import { computed, onMounted, ref, type PropType } from 'vue'
import AppIcon from './AppIcon.uvue'
import LoadingIndicator from './LoadingIndicator.uvue'
import { secondaryLock } from '../services/secondary-lock.ts'
import spacing from '../styles/spacing.json'
import { navigationContentLayout } from '../services/navigation-layout.ts'
import { refreshNativeTheme, themeClass, type ThemeAppearance } from '../services/theme.ts'
const props = defineProps({
  title: { type: String, required: true },
  back: { type: Boolean, default: false },
  contentMaxWidth: { type: Number, default: spacing.contentMax },
  contentMinWidth: { type: Number, default: 0 },
  actionsMinWidth: { type: Number, default: 0 },
  compactActions: { type: Boolean, default: false },
  extensionOpen: { type: Boolean, default: false },
  paper: { type: Boolean, default: false },
  appearance: { type: String as PropType<ThemeAppearance> },
})
onMounted(refreshNativeTheme)
defineEmits(['back'])
const windowInfo = ref(uni.getWindowInfo())
function readCapsule() {
  // #ifdef MP-WEIXIN
  return uni.getMenuButtonBoundingClientRect()
  // #endif
  // #ifndef MP-WEIXIN
  return null
  // #endif
}
const capsule = ref(readCapsule())
const layout = computed(() => navigationContentLayout(windowInfo.value, capsule.value, spacing, props))
const statusBarHeight = computed(() => layout.value.statusBarHeight)
const navigationHeight = computed(() => layout.value.navigationHeight)
const rightInset = computed(() => layout.value.rightInset)
const wrapActions = computed(() => layout.value.wrapActions)
const actionsHeight = computed(() => layout.value.actionsHeight)
const headerHeight = computed(() => layout.value.headerHeight)
function updateLayout() {
  windowInfo.value = uni.getWindowInfo()
  capsule.value = readCapsule()
}
onMounted(() => {
  // #ifdef MP-WEIXIN
  // 首帧已有窗口和胶囊尺寸，仅在宿主尚未返回有效尺寸时补测。
  if (windowInfo.value.windowWidth > 0 && capsule.value?.width > 0 && capsule.value?.height > 0) return
  // #endif
  updateLayout()
})

</script>

<template>
  <!-- 保留导航高度，固定定位后不遮住首屏内容。 -->
  <view class="navigation-placeholder" :class="{ 'navigation-placeholder-animated': $slots.extension }" :style="{ height: statusBarHeight + headerHeight + (extensionOpen ? spacing.controlMin + spacing.inline : 0) + 'px' }">
  <view class="page-navigation" :style="{ paddingTop: statusBarHeight + 'px' }" :class="[themeClass('page-navigation', appearance), { 'page-navigation-paper': paper }, themeClass({ 'page-navigation-paper': paper }, appearance)]">
    <view class="navigation-row" :style="{ height: navigationHeight + 'px', paddingLeft: layout.leftInset + 'px', paddingRight: rightInset + 'px' }">
      <button
        v-if="back"
        role="button"
        class="navigation-button"
        hover-class="none"
        aria-label="返回"
        @click="$emit('back')"
      >
        <AppIcon name="weui:back-outlined" :size="28" :appearance="appearance" />
      </button>
      <view class="navigation-content">
        <slot><text class="navigation-title" :class="themeClass('navigation-title', appearance)">{{ title }}</text></slot>
        <view v-if="actionsMinWidth > 0 && !wrapActions" class="navigation-actions"><slot name="actions" :wrapped="false" /></view>
      </view>
      <LoadingIndicator v-if="secondaryLock.checking" compact label="正在加载" />
    </view>
    <view v-if="wrapActions" class="navigation-actions-row" :class="{ 'navigation-actions-compact': compactActions }" :style="{ height: actionsHeight + 'px' }">
      <view class="navigation-actions-content" :style="{ maxWidth: (contentMaxWidth - spacing.page * 2) + 'px' }"><slot name="actions" :wrapped="true" /></view>
    </view>
    <slot name="extension" />
  </view>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/platform' as *;
@use '../styles/theme-tokens' as *;
@use '../styles/typography' as *;
@use '../styles/spacing-tokens' as *;

.navigation-placeholder {
  flex-shrink: 0;
}
.navigation-placeholder-animated { transition: height 200ms ease-out; }
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) {
  .navigation-placeholder-animated { transition: none; }
}
/* #endif */
.page-navigation {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f0f2f5;
  /* #ifdef APP */
  transition: background-color 800ms ease-in;
  /* #endif */
}
.navigation-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  gap: $space-detail;
}
.navigation-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}
.navigation-actions {
  flex-shrink: 0;
  flex-direction: row;
  margin-left: auto;
  padding-left: $space-inline;
}
.navigation-actions-row {
  box-sizing: border-box;
  padding: 0 $space-page $space-detail;
}
.navigation-actions-compact {
  padding-bottom: 0;
}
.navigation-actions-content {
  width: 100%;
  max-width: $space-contentMax - 2 * $space-page;
  margin-left: auto;
  margin-right: auto;
  flex-direction: row;
  justify-content: flex-end;
}
.navigation-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #242428;
  @include type-style('title');

}
.navigation-button {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  width: $space-controlMin;
  height: $space-controlMin;
  line-height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22px;
  background-color: transparent;
  align-items: center;
  justify-content: center;
}

  .page-navigation-dark {
    background-color: #111215;
  }
  .page-navigation-paper { background-color: $theme-surface-light; }
  .page-navigation-paper-dark { background-color: $theme-page-dark; }
  .navigation-title-dark {
    color: #eeeeef;
  }
  .navigation-button { @include borderless-button; }
/* #ifdef WEB */
.navigation-button:focus-visible {
  outline: 2px solid #93b4fc;
  outline-offset: 2px;
}
/* #endif */

</style>
