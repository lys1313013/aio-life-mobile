<script setup lang="ts">
defineProps({
  title: { type: String, required: true },
  back: { type: Boolean, default: false },
})
defineEmits(['back'])
let statusBarHeight = 0
let navigationHeight = 48
// #ifdef APP
statusBarHeight = uni.getWindowInfo().statusBarHeight || 0
// #endif
// #ifdef MP-WEIXIN
const capsule = uni.getMenuButtonBoundingClientRect()
statusBarHeight = uni.getWindowInfo().statusBarHeight || 0
navigationHeight =
  capsule.height + Math.max(capsule.top - statusBarHeight, 4) * 2
// #endif
</script>

<template>
  <view class="page-navigation" :style="{ paddingTop: statusBarHeight + 'px' }">
    <view class="navigation-row" :style="{ height: navigationHeight + 'px' }">
      <text class="navigation-title">{{ title }}</text>
      <button
        v-if="back"
        role="button"
        class="navigation-button"
        aria-label="返回"
        @click="$emit('back')"
      >
        <text class="navigation-symbol">‹</text>
      </button>
    </view>
  </view>
</template>

