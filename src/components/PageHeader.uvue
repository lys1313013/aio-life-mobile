<script setup lang="ts">
import { useWindowResize } from '../services/window-resize.ts'
useWindowResize(updateLayout)
import { computed, onMounted, ref } from 'vue'
import AppIcon from './AppIcon.uvue'
import LoadingIndicator from './LoadingIndicator.uvue'
import { secondaryLock } from '../services/secondary-lock.ts'
import spacing from '../styles/spacing.json'
import { navigationLayout } from '../services/navigation-layout.ts'
import { refreshNativeTheme, themeClass } from '../services/theme.ts'
onMounted(refreshNativeTheme)
const props = defineProps({
  title: { type: String, required: true },
  back: { type: Boolean, default: false },
  contentMinWidth: { type: Number, default: 0 },
  actionsMinWidth: { type: Number, default: 0 },
})
defineEmits(['back'])
const statusBarHeight = ref(0)
const navigationHeight = ref(48)
const rightInset = ref(spacing.page)
const availableWidth = ref(0)
const wrapActions = computed(() => props.actionsMinWidth > 0 && availableWidth.value < props.contentMinWidth + spacing.inline + props.actionsMinWidth)
const headerHeight = computed(() => navigationHeight.value + (wrapActions.value ? spacing.controlMin + spacing.detail : 0))
function updateLayout() {
  const windowInfo = uni.getWindowInfo()
  let capsule = null
  // #ifdef MP-WEIXIN
  capsule = uni.getMenuButtonBoundingClientRect()
  // #endif
  const layout = navigationLayout(windowInfo, capsule, spacing)
  statusBarHeight.value = layout.statusBarHeight
  navigationHeight.value = layout.navigationHeight
  rightInset.value = layout.rightInset
  availableWidth.value = Math.min(windowInfo.windowWidth - spacing.page - layout.rightInset, spacing.contentMax - 2 * spacing.page) - (props.back ? spacing.controlMin + spacing.detail : 0)
}
updateLayout()
onMounted(() => {
  updateLayout()

})

</script>

<template>
  <!-- 保留导航高度，固定定位后不遮住首屏内容。 -->
  <view class="navigation-placeholder" :style="{ height: statusBarHeight + headerHeight + 'px' }">
  <view class="page-navigation" :style="{ paddingTop: statusBarHeight + 'px' }" :class="themeClass('page-navigation')">
    <view class="navigation-row ui-header-inset" :style="{ height: navigationHeight + 'px', paddingRight: rightInset + 'px' }">
      <button
        v-if="back"
        role="button"
        class="navigation-button ui-type-body"
        hover-class="navigation-button-pressed"
        aria-label="返回"
        @click="$emit('back')"
      >
        <AppIcon name="ant-design:left-outlined" :size="20" />
      </button>
      <view class="navigation-content" :class="{ 'navigation-content-wide': !back }">
        <slot><text class="navigation-title" :class="themeClass('navigation-title')">{{ title }}</text></slot>
        <view v-if="actionsMinWidth > 0 && !wrapActions" class="navigation-actions"><slot name="actions" /></view>
      </view>
      <LoadingIndicator v-if="secondaryLock.checking" compact label="正在加载" />
    </view>
    <view v-if="wrapActions" class="navigation-actions-row ui-header-inset">
      <view class="navigation-actions-content"><slot name="actions" /></view>
    </view>
  </view>
  </view>
</template>

<style scoped lang="scss">
@use '../styles/typography' as *;
@use '../styles/spacing.scss';
@use '../styles/spacing-tokens' as *;
@include type-utilities('body');

.navigation-placeholder {
  flex-shrink: 0;
}
.page-navigation {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f0f2f5;
}
.navigation-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  gap: $space-detail;
}
.navigation-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}
.navigation-content-wide {
  max-width: $space-contentMax - 2 * $space-page;
  margin-left: auto;
  margin-right: auto;
}
.navigation-actions {
  flex-shrink: 0;
  flex-direction: row;
  margin-left: auto;
  padding-left: $space-inline;
}
.navigation-actions-row {
  height: $space-controlMin + $space-detail;
  box-sizing: border-box;
  padding-bottom: $space-detail;
}
.navigation-actions-content {
  width: 100%;
  max-width: $space-contentMax - 2 * $space-page;
  margin-left: auto;
  margin-right: auto;
  flex-direction: row;
  justify-content: flex-end;
}
.navigation-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #242428;
  @include type-style('title');

}
.navigation-button {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  width: 44px;
  height: 44px;
  line-height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22px;
  background-color: transparent;
  align-items: center;
  justify-content: center;
}
.navigation-button-pressed {
  opacity: 0.65;
  transform: scale(0.94);
}

  .page-navigation-dark {
    background-color: #111215;
  }
  .navigation-title-dark {
    color: #eeeeef;
  }
  /* #ifdef WEB || MP-WEIXIN */
.navigation-button::after {
  border: 0;
}
/* #endif */
/* #ifdef WEB */
.navigation-button:focus-visible {
  outline: 2px solid #93b4fc;
  outline-offset: 2px;
}
/* #endif */

</style>
