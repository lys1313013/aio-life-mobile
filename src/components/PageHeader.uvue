<script setup lang="ts">
import { onMounted } from 'vue'
import AppIcon from './AppIcon.uvue'
import { refreshNativeTheme, themeClass } from '../services/theme.ts'
onMounted(refreshNativeTheme)
defineProps({
  title: { type: String, required: true },
  back: { type: Boolean, default: false },
})
defineEmits(['back'])
let statusBarHeight = 0
let navigationHeight = 48
// #ifdef APP
statusBarHeight = uni.getWindowInfo().statusBarHeight || 0
// #endif
// #ifdef MP-WEIXIN
const capsule = uni.getMenuButtonBoundingClientRect()
statusBarHeight = uni.getWindowInfo().statusBarHeight || 0
navigationHeight =
  capsule.height + Math.max(capsule.top - statusBarHeight, 4) * 2
// #endif
</script>

<template>
  <!-- 保留导航高度，固定定位后不遮住首屏内容。 -->
  <view class="navigation-placeholder" :style="{ height: statusBarHeight + navigationHeight + 'px' }">
  <view class="page-navigation" :style="{ paddingTop: statusBarHeight + 'px' }" :class="themeClass('page-navigation')">
    <view class="navigation-row ui-header-inset" :style="{ height: navigationHeight + 'px' }">
      <text class="navigation-title" :class="themeClass('navigation-title')">{{ title }}</text>
      <button
        v-if="back"
        role="button"
        class="navigation-button"
        hover-class="navigation-button-pressed"
        aria-label="返回"
        @click="$emit('back')"
      >
        <AppIcon name="ant-design:left-outlined" :size="20" />
      </button>
    </view>
  </view>
  </view>
</template>

