<script setup lang="ts">
import { computed } from "vue";
import CategoryIcon from "./CategoryIcon.uvue";
import icons from "../services/icons/catalog.ts";
import { isDark } from "../services/theme.ts";
const props = defineProps<{ icon?: string; color?: string; size?: number }>();
const icon = computed(() =>
  icons.icons[props.icon || ""] ? props.icon : "lucide:layout-dashboard",
);
</script>
<template>
  <CategoryIcon :icon="icon" :color="color || (isDark ? '#e4e4e7' : '#27272a')" :size="size || 26" />
</template>
