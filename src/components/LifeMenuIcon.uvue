<script setup lang="ts">
import { computed } from "vue";
import CategoryIcon from "./CategoryIcon.uvue";
import icons from "../services/icons/category-icons.json";
const props = defineProps<{ icon?: string; color?: string; size?: number }>();
const brandImage = computed(() => {
  if (props.icon === "svg:weread") return "/static/weread.png";
  if (props.icon === "svg:shanbay") return "/static/platforms/shanbay.png";
  return "";
});
const icon = computed(() =>
  icons.icons[props.icon || ""] ? props.icon : "lucide:layout-dashboard",
);
</script>
<template>
  <image
    v-if="brandImage"
    class="life-brand"
    :style="{ width: (size || 26) + 'px', height: (size || 26) + 'px' }"
    :src="brandImage"
    mode="aspectFit"
  />
  <CategoryIcon v-else :icon="icon" :color="color || '#5b8ff9'" :size="size || 26" />
</template>
<style scoped>
.life-brand {
  width: 26px;
  height: 26px;
}
</style>
