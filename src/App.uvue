<script setup lang="ts">
import { onHide, onLaunch } from '@dcloudio/uni-app'
import { restoreSession } from './services/session.ts'
import { installUnlockLifecycle, invalidateUnlocks } from './services/secondary-lock.ts'
import { needsMenuCheck, checkMenuAccess, installMenuAccessWarmup } from './services/menu-access.ts'

import { initializeTheme } from './services/theme.ts'

onLaunch(() => { installUnlockLifecycle(needsMenuCheck, checkMenuAccess); initializeTheme(); restoreSession(); installMenuAccessWarmup() })
onHide(invalidateUnlocks)
</script>

