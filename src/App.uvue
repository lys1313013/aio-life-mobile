<script setup lang="ts">
import { onHide, onLaunch } from '@dcloudio/uni-app'
import { restoreSession } from './services/session.ts'
import { installUnlockLifecycle, invalidateUnlocks } from './services/secondary-lock.ts'
import { needsMenuCheck, checkMenuAccess, installMenuAccessWarmup } from './services/menu-access.ts'

import { initializeTheme } from './services/theme.ts'
// #ifdef WEB
import { getCurrentInstance } from 'vue'
import { installPageMotion } from './services/page-motion.ts'
const pageRouter = getCurrentInstance()?.appContext.config.globalProperties.$router
onLaunch(() => installPageMotion(pageRouter))
// #endif
// #ifdef MP-WEIXIN
import { installMiniProgramUpdates } from './services/mini-program-updates.ts'
// #endif

onLaunch(() => { installUnlockLifecycle(needsMenuCheck, checkMenuAccess); initializeTheme(); restoreSession(); installMenuAccessWarmup() })
// #ifdef MP-WEIXIN
onLaunch(() => installMiniProgramUpdates(uni))
// #endif
onHide(invalidateUnlocks)
</script>

<style lang="scss">
@use "./styles/theme-tokens" as *;
@use 'styles/platform' as *;
@use './styles/typography' as *;
@use './styles/spacing-tokens' as *;
/* Vapor 使用简单类选择器；主题色显式传递，不依赖浏览器 DOM。 */
// 容器使用统一正文尺度；文字节点另行显式引用，兼容不继承样式的 App 端。
.page, .tab-page, .dashboard-page, .mobile-page, .modal-panel {
  @include type-style('body');
}
.page {
  flex: 1;
  /* #ifndef APP */
  min-height: 100%;
  /* #endif */
  background-color: $theme-page-light;
}

.screen {
  width: 100%;
  max-width: $space-contentMax;
  align-self: center;
  padding: $space-page;
  padding-top: $space-overlayBlock * 2;
  padding-bottom: $space-overlayBlock;
}
.brand { flex-direction: row; align-items: center; }
.brand-mark {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  background-color: #39765e;
}
.brand-symbol { @include type-style('glyph-medium'); color: #ffffff;  }
.brand-name { margin-left: $space-inline; @include type-style('brand');  color: #203b2f; }
.ink { color: #203b2f; }
.muted { color: #75847a; }

.primary-button {
  width: 100%;
  height: 52px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 16px;
  background-color: #39765e;
  color: #ffffff;
  @include type-style('body');

  align-items: center;
  justify-content: center;
}
.primary-disabled { opacity: 0.65; }
.error-text { @include type-style('label');  color: #b74437; }

.icon-button {
  width: 42px;
  height: 42px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 14px;
  background-color: #e9eee7;
  color: #39765e;
  @include type-style('glyph-large');
  line-height: type-leading('legacyIcon');
  align-items: center;
  justify-content: center;
}

.footer-note { @include type-style('caption'); color: #8b988f;  text-align: center; }

  .page-dark { background-color: $theme-page-dark; }
  .ink-dark, .brand-name-dark { color: #e4ece6; }
  .muted-dark { color: #a0afa5; }
  .error-text-dark { color: #ffb4a8; }
  .icon-button-dark { background-color: #28372d; color: #abd4b9; }

.tab-page { flex: 1; height: 100%; background-color: $theme-page-light; }
/* #ifdef APP */
.tab-page { transition: background-color 800ms ease-in; }
/* #endif */
.tab-scroll { flex: 1; height: 0; }
.tab-content { width: 100%; max-width: $space-contentMax; align-self: center; padding: $space-page; padding-bottom: calc($space-page + env(safe-area-inset-bottom)); }
.state-card { background-color: $theme-surface-light; border-radius: 16px; padding: $space-section $space-card; align-items: center; }
.muted-text { @include type-style('label');  color: #8b8f99; }
.empty-title { @include type-style('body');  color: #52525b; margin-bottom: $space-inline; }
.text-action { @include type-style('body'); padding: $space-detail $space-card; margin-top: $space-section; border: 0; background-color: transparent; color: #5b8ff9; }

  .tab-page-dark { background-color: $theme-page-dark; }
  .state-card-dark { background-color: $theme-surface-dark; }
  .empty-title-dark { color: #d4d4d8; }

/* #ifdef MP-WEIXIN */
// 微信切换页面时会先绘制宿主 page；底色不能等业务组件挂载后才填充。
// 宿主根选择器只用于初始化背景，业务节点仍由响应式主题类管理手动主题。
:global(page) { background-color: $theme-page-light; }
@media (prefers-color-scheme: dark) {
  :global(page) { background-color: $theme-page-dark; }
}
/* #endif */

/* #ifdef WEB */
// 页面进退与主题切换分别管理快照，返回时旧页面位于上层向右退场。
:global(.aio-page-motion::view-transition-old(root)),
:global(.aio-page-motion::view-transition-new(root)) { animation: none; mix-blend-mode: normal; }
:global(.aio-page-motion::view-transition-old(root)) { z-index: 1; }
:global(.aio-page-motion::view-transition-new(root)) { z-index: 2; }
:global(.aio-page-motion-back::view-transition-old(root)) { z-index: 2; }
:global(.aio-page-motion-back::view-transition-new(root)) { z-index: 1; }
// 关闭后立刻返回时，整页快照不再捕获尚在退场的旧弹窗。
:global(.aio-page-motion .modal-mask[data-modal-leaving="true"]) { visibility: hidden; }
// 往返沿同一条圆形路径：浅色展开新快照，深色收拢旧浅色快照。
:global(.aio-theme-transition::view-transition-old(root)),
:global(.aio-theme-transition::view-transition-new(root)) {
  animation: none;
  mix-blend-mode: normal;
}
:global(.aio-theme-transition::view-transition-old(root)) { z-index: 1; }
:global(.aio-theme-transition::view-transition-new(root)) { z-index: 2; }
:global(.aio-theme-transition-dark::view-transition-old(root)) { z-index: 2; }
:global(.aio-theme-transition-dark::view-transition-new(root)) { z-index: 1; }
// 快照捕获最终的开关状态，避免把滑块的初始帧冻结在新主题中。
:global(.aio-theme-transition .mobile-switch-track),
:global(.aio-theme-transition .mobile-switch-thumb) { transition: none !important; }
:global(.aio-theme-transition .mobile-switch-disabled) { opacity: 1 !important; }
page { min-height: 100%; }
:global(.uni-tabbar) { background-color: var(--aio-tab-background, #ffffff) !important; }
:global(.uni-tabbar-border) { background-color: var(--aio-tab-border, #ffffff) !important; }
/* uni-app x H5 系统图片预览默认 999，需高于编辑弹窗（1100）。 */
:global(uni-page[data-page="uni:previewImage"]) { z-index: 1400 !important; }
/* 原生 Web picker 的默认层级低于编辑弹窗。 */
:global(.uni-picker-container) { z-index: 1200 !important; }
/* 弹层挂载到 body，滚轮、遮罩和操作栏必须统一跟随应用主题，不能混入系统配色。 */
:global(.uni-picker-container) { --uni-picker-arrow-color: var(--aio-tab-background, #ffffff); }
:global(.uni-picker-select), :global(.uni-picker-custom),
:global(.uni-picker-content), :global(.uni-picker-header) {
  background-color: var(--aio-tab-background, #ffffff) !important;
  color: var(--aio-native-text, #27272a) !important;
}
:global(.uni-picker-item), :global(.uni-picker-action-cancel) { color: var(--aio-native-text, #27272a) !important; }
:global(.uni-picker-action-confirm), :global(.uni-picker-select .uni-picker-item.selected) {
  color: var(--aio-native-accent, #1d4ed8) !important;
}
:global(.uni-picker-select .uni-picker-item:hover) { background-color: transparent !important; }
:global(.uni-picker-select .uni-picker-item.selected) {
  background-color: var(--aio-native-active, #edf3ff) !important;
}
:global(.uni-picker-content .uni-picker-item:hover) { background-color: transparent !important; }
:global(.uni-picker-container .uni-picker-view-mask) {
  background-image: linear-gradient(180deg, rgba(var(--aio-native-surface-rgb, 255, 255, 255), 0.95), rgba(var(--aio-native-surface-rgb, 255, 255, 255), 0.6)),
    linear-gradient(0deg, rgba(var(--aio-native-surface-rgb, 255, 255, 255), 0.95), rgba(var(--aio-native-surface-rgb, 255, 255, 255), 0.6)) !important;
}
:global(.uni-picker-header::after),
:global(.uni-picker-container .uni-picker-view-indicator::before),
:global(.uni-picker-container .uni-picker-view-indicator::after) {
  border-color: var(--aio-native-border, #d4d4d8) !important;
}
/* Web 的页面容器已扣除 tabBar 高度，移除框架重复的底部占位。 */
uni-app.uni-app--showtabbar uni-page-body::after { display: none; }
/* #endif */
.navigation-button, .date-step, .text-action, .signout-button, .icon-button, .primary-button, .cancel-button, .confirm-button, .retry-button { @include borderless-button; }
</style>
