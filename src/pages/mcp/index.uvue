<script setup lang="ts">
import { computed, onUnmounted, ref } from "vue";
import MobilePage from "../../components/MobilePage.uvue";
import PageHeader from "../../components/PageHeader.uvue";
import MobileButton from "../../components/MobileButton.uvue";
import AppIcon from "../../components/AppIcon.uvue";
import PageState from "../../components/PageState.uvue";
import FormField from "../../components/FormField.uvue";
import FormActions from "../../components/FormActions.uvue";
import AdaptiveModal from "../../components/AdaptiveModal.uvue";
import { toolFields, buildToolArguments } from "./services/mcp-schema.ts";
import { toolGroups, toolPresentation } from "./services/presentation.ts";
import { fetchTools, callTool } from "../../services/domains/social.ts";
import { useDomainPage } from "../../services/domains/page-session.ts";
import { apiUrl } from "../../services/api.ts";
import { isDark, themeClass } from "../../services/theme.ts";

const guideOpen = ref(false);
let serviceAddress = apiUrl("/mcp");
// #ifdef WEB
serviceAddress = new URL(serviceAddress, window.location.origin).toString();
// #endif
const clientConfig = JSON.stringify(
  {
    mcpServers: {
      "aio-life": {
        type: "streamable-http",
        url: serviceAddress,
        headers: { Authorization: "Bearer <your-api-key>" },
      },
    },
  },
  null,
  2,
);
const tools = ref<any[]>([]);
const keyword = ref("");
const activeGroup = ref("all");
const loading = ref(false);
const refreshing = ref(false);
const busy = ref(false);
const error = ref("");
const callError = ref("");
const current = ref<any>(null);
const args = ref<Record<string, any>>({});
const result = ref<any>(null);
let alive = true;
let stamp = 0;
let callStamp = 0;
onUnmounted(() => {
  alive = false;
  callStamp++;
});
async function load() {
  const requestStamp = ++stamp;
  loading.value = true;
  error.value = "";
  try {
    const data = await fetchTools();
    if (alive && stamp === requestStamp) tools.value = data;
  } catch (e) {
    if (alive && stamp === requestStamp) error.value = e.message;
  } finally {
    if (alive && stamp === requestStamp) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
useDomainPage(
  (refresh) => {
    alive = true;
    if (refresh) return load();
  },
  (clear) => {
    alive = false;
    stamp++;
    callStamp++;
    if (clear) tools.value = [];
    current.value = null;
    guideOpen.value = false;
    args.value = {};
    result.value = null;
    busy.value = false;
    loading.value = false;
    refreshing.value = false;
  },
  { loading: () => loading.value, error: () => error.value, keys: () => ['mcp'] },
);
const groups = computed(() =>
  toolGroups.filter(
    (group) =>
      group.value === "all" ||
      tools.value.some((tool) => toolPresentation(tool).group === group.value),
  ),
);
const filtered = computed(() =>
  tools.value.filter((tool) => {
    const info = toolPresentation(tool);
    return (
      (activeGroup.value === "all" || info.group === activeGroup.value) &&
      (info.title + " " + tool.name + " " + tool.description)
        .toLowerCase()
        .includes(keyword.value.trim().toLowerCase())
    );
  }),
);
const groupIcons: Record<string, string> = {
  time: "ant-design:clock-circle-outlined",
  plan: "ant-design:check-outlined",
  learn: "ant-design:book-outlined",
  life: "ant-design:appstore-outlined",
  other: "ant-design:appstore-outlined",
};
const fields = computed(() => toolFields(current.value?.inputSchema || {}));
const resultText = computed(
  () =>
    result.value?.content
      ?.map((item) => {
        if (!item.text) return JSON.stringify(item, null, 2);
        try {
          return JSON.stringify(JSON.parse(item.text), null, 2);
        } catch {
          return item.text;
        }
      })
      .join("\n") || "无返回内容",
);
function open(tool: any) {
  if (busy.value) return;
  current.value = tool;
  args.value = {};
  result.value = null;
  callError.value = "";
}
function close() {
  if (!busy.value) current.value = null;
}
async function run() {
  if (busy.value || !current.value) return;
  const requestStamp = ++callStamp;
  callError.value = "";
  result.value = null;
  try {
    const data = buildToolArguments(current.value.inputSchema, args.value);
    busy.value = true;
    const value = await callTool(current.value.name, data);
    if (alive && callStamp === requestStamp) result.value = value;
  } catch (e) {
    if (alive && callStamp === requestStamp) callError.value = e.message;
  } finally {
    if (alive && callStamp === requestStamp) busy.value = false;
  }
}
function copy(value: string) {
  uni.setClipboardData({
    data: value,
    fail: () => uni.showToast({ title: "复制失败，请长按复制", icon: "none" }),
  });
}
function manageKeys() {
  guideOpen.value = false;
  uni.navigateTo({ url: "/pages/mcp/api-keys" });
}
</script>

<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
  >
    <PageHeader title="MCP 工具" back @back="uni.navigateBack()">
      <text class="navigation-title" :class="themeClass('navigation-title')"
        >MCP 工具</text
      >
      <MobileButton
        label="连接配置"
        icon="ant-design:setting-outlined"
        variant="ghost"
        @click="guideOpen = true"
      />
    </PageHeader>
    <view class="body ui-page-body" :class="themeClass('body')">
      <view class="connection ui-card" :class="themeClass('surface')">
        <view class="connection-icon" :class="themeClass('connection-icon')"
          ><AppIcon
            name="ant-design:link-outlined"
            :size="22"
            :color="isDark ? '#9bbcff' : '#427bea'"
        /></view>
        <view class="connection-info">
          <view class="connection-heading"
            ><text class="connection-title" :class="themeClass('primary-text')"
              >AIO Life</text
            ><text class="protocol" :class="themeClass('secondary-text')"
              >Streamable HTTP</text
            ></view
          >
          <text
            class="connection-address"
            :class="themeClass('secondary-text')"
            selectable
            >{{ serviceAddress }}</text
          >
        </view>
        <MobileButton
          label="复制服务地址"
          icon="ant-design:copy-outlined"
          variant="ghost"
          @click="copy(serviceAddress)"
        />
      </view>
      <view class="tool-toolbar ui-toolbar"
        ><FormField
          v-model="keyword"
          compact
          stretch
          hide-label
          label="搜索工具"
          placeholder="搜索名称或描述" /><MobileButton
          v-if="keyword"
          label="清除搜索"
          icon="ant-design:close-outlined"
          variant="ghost"
          @click="keyword = ''"
      /></view>
      <scroll-view
        direction="horizontal"
        :scroll-x="true"
        :show-scrollbar="false"
        class="group-scroll"
      >
        <view class="group-tabs">
          <button
            v-for="group in groups"
            :key="group.value"
            role="button"
            :aria-label="group.label"
            :aria-pressed="activeGroup === group.value"
            class="group-tab"
            :class="[
              { 'group-tab-active': activeGroup === group.value },
              themeClass({ 'group-tab-active': activeGroup === group.value }),
            ]"
            @click="activeGroup = group.value"
          >
            <text
              class="group-label"
              :class="[
                { 'group-label-active': activeGroup === group.value },
                themeClass([
                  'secondary-text',
                  { 'group-label-active': activeGroup === group.value },
                ]),
              ]"
              >{{ group.label }}</text
            >
          </button>
        </view>
      </scroll-view>
      <view class="list-caption"
        ><text class="caption" :class="themeClass('secondary-text')"
          >工具目录</text
        ><text class="caption" :class="themeClass('secondary-text')"
          >{{ filtered.length }} 个工具</text
        ></view
      >
      <PageState
        skeleton="list"
        :loading="loading"
        :error="error"
        :has-content="tools.length > 0"
        :empty="!loading && !filtered.length"
        :empty-text="tools.length ? '没有匹配的工具' : '暂无 MCP 工具'"
        @retry="load"
      >
        <view
          v-if="filtered.length"
          class="tool-list"
          :class="themeClass('surface')"
        >
          <button
            v-for="(tool, index) in filtered"
            :key="tool.name"
            role="button"
            :aria-label="'输入参数并调用 ' + tool.name"
            class="tool-row"
            :class="[{ 'tool-row-divided': index > 0 }, themeClass('tool-row')]"
            hover-class="tool-row-pressed"
            @click="open(tool)"
          >
            <view class="tool-icon"
              ><AppIcon
                :name="groupIcons[toolPresentation(tool).group]"
                :size="20"
                :color="isDark ? '#a7afbe' : '#657085'"
            /></view>
            <view class="tool-content">
              <view class="tool-labels"
                ><view class="tool-heading"
                  ><text
                    class="tool-title"
                    :class="themeClass('primary-text')"
                    >{{ toolPresentation(tool).title }}</text
                  ><text
                    class="parameter-count"
                    :class="themeClass('secondary-text')"
                    >{{
                      Object.keys(tool.inputSchema?.properties || {}).length
                        ? Object.keys(tool.inputSchema.properties).length +
                          " 参数"
                        : "无参数"
                    }}</text
                  ></view
                >
                <text class="tool-name" :class="themeClass('secondary-text')">{{
                  tool.name
                }}</text></view
              >
              <text
                class="tool-description"
                :class="themeClass('secondary-text')"
                >{{ toolPresentation(tool).summary }}</text
              >
            </view>
            <view class="tool-open"
              ><AppIcon
                name="ant-design:right-outlined"
                :size="14"
                color="#8792a5"
            /></view>
          </button>
        </view>
      </PageState>
    </view>

    <AdaptiveModal
      v-if="guideOpen"
      label="连接配置"
      :max-width="600"
      @close="guideOpen = false"
    >
      <view class="panel-heading"
        ><text class="panel-title" :class="themeClass('primary-text')"
          >连接 AIO Life</text
        ><MobileButton
          label="关闭配置"
          icon="ant-design:close-outlined"
          variant="ghost"
          @click="guideOpen = false"
      /></view>
      <view class="config-block" :class="themeClass('config-block')"
        ><view class="config-heading"
          ><text class="caption" :class="themeClass('secondary-text')"
            >服务地址</text
          ><MobileButton
            label="复制服务地址"
            icon="ant-design:copy-outlined"
            variant="ghost"
            @click="copy(serviceAddress)" /></view
        ><text
          class="config-code"
          :class="themeClass('primary-text')"
          selectable
          >{{ serviceAddress }}</text
        ></view
      >
      <view class="config-facts"
        ><text class="caption" :class="themeClass('secondary-text')"
          >Streamable HTTP</text
        ><text class="caption" :class="themeClass('secondary-text')"
          >Bearer API Key</text
        ></view
      >
      <view class="config-heading"
        ><text class="section-title" :class="themeClass('primary-text')"
          >客户端配置</text
        ><MobileButton
          label="复制客户端配置"
          icon="ant-design:copy-outlined"
          variant="ghost"
          @click="copy(clientConfig)"
      /></view>
      <view class="config-block" :class="themeClass('config-block')"
        ><text
          class="config-code"
          :class="themeClass('primary-text')"
          selectable
          >{{ clientConfig }}</text
        ></view
      >
      <view class="panel-actions"
        ><FormActions
          ><MobileButton
            label="管理 API Key"
            @click="manageKeys" /></FormActions
      ></view>
    </AdaptiveModal>

    <AdaptiveModal
      v-if="current"
      :label="current.name"
      :busy="busy"
      :max-width="640"
      @close="close"
    >
      <view class="panel-heading"
        ><text class="panel-title" :class="themeClass('primary-text')">{{
          toolPresentation(current).title
        }}</text
        ><MobileButton
          label="关闭工具"
          icon="ant-design:close-outlined"
          variant="ghost"
          :disabled="busy"
          @click="close"
      /></view>
      <text class="modal-tool-name" :class="themeClass('secondary-text')">{{
        current.name
      }}</text>
      <text class="modal-description" :class="themeClass('secondary-text')">{{
        current.description
      }}</text>
      <view class="section-heading"
        ><text class="section-title" :class="themeClass('primary-text')"
          >输入参数</text
        ><text class="caption" :class="themeClass('secondary-text')">{{
          fields.length
        }}</text></view
      >
      <text
        v-if="!fields.length"
        class="no-params"
        :class="themeClass('secondary-text')"
        >无需填写参数，可直接调用。</text
      >
      <view v-for="field in fields" :key="field.name" class="parameter-field">
        <FormField
          compact
          :label="field.name"
          :required="field.isRequired"
          :disabled="busy"
          :kind="
            field.enum || field.type === 'boolean'
              ? 'selector'
              : field.type === 'object' || field.type === 'array'
                ? 'textarea'
                : 'text'
          "
          :options="
            field.enum?.map((value) => String(value)) || ['true', 'false']
          "
          :placeholder="
            field.type === 'object' || field.type === 'array'
              ? '输入 JSON'
              : '请输入'
          "
          v-model="args[field.name]"
        />
        <text class="field-description" :class="themeClass('secondary-text')"
          >{{ field.type
          }}{{ field.description ? " · " + field.description : "" }}</text
        >
      </view>
      <text v-if="callError" class="error" role="alert">{{ callError }}</text>
      <view v-if="result" class="result">
        <view class="config-heading"
          ><text class="section-title" :class="themeClass('primary-text')">{{
            result.isError ? "调用失败" : "返回结果"
          }}</text
          ><MobileButton
            label="复制返回结果"
            icon="ant-design:copy-outlined"
            variant="ghost"
            @click="copy(resultText)"
        /></view>
        <view class="config-block" :class="themeClass('config-block')"
          ><text
            class="result-code"
            :class="[
              { error: result.isError },
              themeClass({ 'primary-text': !result.isError }),
            ]"
            selectable
            >{{ resultText }}</text
          ></view
        >
      </view>
      <view class="panel-actions"
        ><FormActions
          ><MobileButton
            label="关闭"
            variant="quiet"
            :disabled="busy"
            @click="close" /><MobileButton
            label="执行工具"
            icon="ant-design:play-circle-outlined"
            :loading="busy"
            @click="run" /></FormActions
      ></view>
    </AdaptiveModal>
  </MobilePage>
</template>

<style scoped lang="scss">
