  margin-top: $space-inline;
  overflow-wrap: anywhere;
}
.no-params {
  display: flex;
  @include type-style("label");
  color: $text-secondary-light;
  padding: $space-inline 0;
}
.parameter-field {
  display: flex;
  flex-direction: column;
  margin-bottom: $space-form;
}
.field-description {
  @include type-style("caption");
  color: $text-secondary-light;
  margin-top: $space-detail;
  overflow-wrap: anywhere;
}
.result {
  margin-top: $space-section;
}
.result-code {
  @include type-style("caption");
  font-family: type-family('mono');
  color: #263248;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.error {
  display: flex;
  @include type-style("label");
  color: #d14d55;
  margin-top: $space-inline;
  overflow-wrap: anywhere;
}
