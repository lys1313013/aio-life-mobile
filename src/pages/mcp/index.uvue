<script setup lang="ts">
import { computed, onMounted, onUnmounted, ref } from 'vue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import PageState from '../../components/PageState.uvue';
import FormField from '../../components/FormField.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { toolFields, buildToolArguments } from './services/mcp-schema.ts';
import { fetchTools, callTool } from '../../services/domains/social.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { apiUrl } from '../../services/api.ts';
import { themeClass } from '../../services/theme.ts';
const guideOpen = ref(false);
let serviceAddress = apiUrl('/mcp');
// #ifdef WEB
serviceAddress = new URL(serviceAddress, window.location.origin).toString();
// #endif
const clientConfig = JSON.stringify({mcpServers: {'aio-life': {type: 'streamable-http', url: serviceAddress, headers: {Authorization: 'Bearer <your-api-key>'}}}}, null, 2);
const tools = ref<any[]>([]),
  keyword = ref(''),
  loading = ref(false),
  refreshing = ref(false),
  busy = ref(false),
  error = ref(''),
  callError = ref(''),
  current = ref<any>(null),
  args = ref<Record<string, any>>({}),
  result = ref<any>(null);
let alive = true,
  stamp = 0;
onUnmounted(() => {
  alive = false;
});
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await fetchTools();
    if (alive && stamp === current) tools.value = data;
  } catch (e) {
    if (alive) error.value = e.message;
  } finally {
    if (alive) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    tools.value = [];
    current.value = null;
    args.value = {};
    result.value = null;
    loading.value = false;
    refreshing.value = false;
  },
);
const filtered = computed(() =>
  tools.value.filter((item) =>
    (item.name + ' ' + item.description).toLowerCase().includes(keyword.value.toLowerCase()),
  ),
);
const fields = computed(() => toolFields(current.value?.inputSchema || {}));
function open(tool: any) {
  current.value = tool;
  args.value = {};
  result.value = null;
  callError.value = '';
}
async function run() {
  if (busy.value) return;
  callError.value = '';
  try {
    const data = buildToolArguments(current.value.inputSchema, args.value);
    busy.value = true;
    const currentStamp = stamp;
    const value = await callTool(current.value.name, data);
    if (alive && stamp === currentStamp) result.value = value;
  } catch (e) {
    callError.value = e.message;
  } finally {
    busy.value = false;
  }
}
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="MCP 工具" back @back="uni.navigateBack()" /><view
      class="body ui-page-body"
      :class="themeClass('body')"
      ><view class="tool-toolbar ui-toolbar">
        <FormField compact stretch hide-label label="搜索工具名称或描述" placeholder="搜索工具名称或描述" v-model="keyword" />
        <MobileButton label="配置指南" icon="ant-design:question-circle-outlined" variant="quiet" @click="guideOpen = !guideOpen" />
      </view>
      <view v-if="guideOpen" class="guide ui-card" :class="themeClass('guide')">
        <view class="guide-body ui-gap-sm">
          <text class="title">配置指南</text>
          <text class="description" :class="themeClass('description')">服务地址</text><text class="config-code" selectable>{{ serviceAddress }}</text>
          <text class="description" :class="themeClass('description')">传输类型</text><text class="ui-type-body">Streamable HTTP</text>
          <text class="description" :class="themeClass('description')">认证方式</text><text class="config-code" selectable>Authorization: Bearer &lt;API Key&gt;</text>
          <MobileButton label="管理 API Key" icon="ant-design:key-outlined" variant="quiet" @click="uni.navigateTo({url:'/pages/profile/preferences?section=keys'})" />
          <text class="description" :class="themeClass('description')">客户端配置</text><text class="config-code" selectable>{{ clientConfig }}</text>
        </view>
      </view>
      <text class="description ui-section" :class="themeClass('description')">{{ keyword ? filtered.length + ' / ' : '' }}{{ tools.length }} 个工具</text>
      <PageState skeleton="list" :loading="loading" :error="error" :empty="!loading && !filtered.length" @retry="load">
        <view class="tool-grid">
          <view v-for="tool in filtered" :key="tool.name" class="tool ui-card" :class="themeClass('tool')">
            <view class="tool-heading ui-row">
              <view class="tool-identity">
                <text class="tool-name" :class="themeClass('tool-name')">{{ tool.name }}</text>
                <text class="parameter-count" :class="themeClass('parameter-count')">{{ Object.keys(tool.inputSchema?.properties || {}).length }} 参数</text>
              </view>
              <MobileButton :label="'输入参数并调用 ' + tool.name" icon="ant-design:play-circle-outlined" variant="quiet" @click="open(tool)" />
            </view>
            <text class="tool-description" :class="themeClass('tool-description')">{{ tool.description }}</text>
          </view>
        </view>
      </PageState></view
    ><AdaptiveModal v-if="current" :label="current.name" :busy="busy" @close="current = null"
      ><text class="tool-modal-name">{{ current.name }}</text
      ><text class="ui-type-body tool-content">{{ current.description }}</text><text v-if="!fields.length" class="description ui-section" :class="themeClass('description')">该工具无需输入参数</text
      ><view v-for="field in fields" :key="field.name"
        ><FormField
          :label="
            field.name + ((current.inputSchema.required || []).includes(field.name) ? ' *' : '')
          "
          :kind="
            field.enum || field.type === 'boolean'
              ? 'selector'
              : field.type === 'object' || field.type === 'array'
                ? 'textarea'
                : 'text'
          "
          :options="field.enum?.map((value) => String(value)) || ['true', 'false']"
          v-model="args[field.name]"
        /><text v-if="field.description" class="description ui-section" :class="themeClass('description')">{{ field.description }}</text></view
      ><text v-if="callError" class="error ui-py-section ui-type-body">{{ callError }}</text
      ><MobileButton label="执行工具" :loading="busy" @click="run" /><view
        v-if="result"
        class="result ui-gap-md ui-mt-section"
        ><text v-if="result.isError" class="error ui-py-section ui-type-body">工具返回错误</text
        ><text class="ui-type-body tool-content" v-for="(item, index) in result.content" :key="index" selectable>{{
          item.text || JSON.stringify(item)
        }}</text></view
      ></AdaptiveModal
    ></MobilePage
  >
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/text-colors' as *;
@include type-utilities('body');

.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.tool-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: $space-section;
}
.tool-heading { align-items: flex-start; }
.tool-identity { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: $space-detail; }
.tool-name { font-family: type-family('mono'); @include type-style('body-strong');   color: #2563b8; overflow-wrap: anywhere; }
.tool-name-dark { color: #8cb4fb; }
.parameter-count { padding: $space-micro $space-detail; border-radius: 4px; @include type-style('badge'); color: #547092; background-color: #edf3fc; }
.parameter-count-dark { color: #a8bfdf; background-color: #263448; }
.tool-description { color: $text-secondary-light; @include type-style('label');  overflow-wrap: anywhere; }
.tool-description-dark { color: $text-secondary-dark; }
@media (min-width: 768px) { .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.tool {
  min-width: 0;
  margin-bottom: 0;
  gap: $space-inline;
  background-color: #ffffff;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
}
.title {

  @include type-style('title');
  display: block;
}
.description {
  color: $text-secondary-light;
  @include type-style('label');
  display: block;
}
.error {
  color: #dc5454;
  display: block;
}
.result {
  display: flex;
  flex-direction: column;
}
.guide { background-color: #ffffff; border-radius: 14px; }
.guide-heading { align-items: center; justify-content: space-between; }
.guide-body { display: flex; flex-direction: column; }
.guide-dark, .tool-dark { background-color: #1c1e22; }
.config-code { font-family: type-family('mono'); @include type-style('caption'); overflow-wrap: anywhere; white-space: pre-wrap; }

.description-dark { color: $text-secondary-dark; }
.description { overflow-wrap: anywhere; }
.tool-modal-name { @include type-style('title'); font-family: type-family('mono'); display: block; overflow-wrap: anywhere; }
.tool-content { @include type-style('prose'); white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
