<script setup lang="ts">
import { usePageRefresh } from '../../services/page-refresh.ts'
import { useAppLayout } from '../../services/app-layout.ts'
const { appGridItem } = useAppLayout()

import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import { computed, ref, watch } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import AioChart from '../../components/AioChart.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import CategoryIcon from '../../components/CategoryIcon.uvue';
import { exerciseDistributionChart, exerciseMonthlyChart } from './services/exercise-chart.ts';
import ExerciseDistributionChart from './components/ExerciseDistributionChart.uvue';
import ExerciseMonthlyChart from './components/ExerciseMonthlyChart.uvue';
import ExerciseRecordRow from './components/ExerciseRecordRow.uvue';
import LoadMore from '../../components/LoadMore.uvue';
import { isDark } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { fetchDictionary } from '../../services/dictionary.ts';
import { todayDate } from '../../services/dashboard.ts';
import {
  fetchExercisePage,
  fetchExerciseStatistics,
  saveExercise,
  deleteExercises,
} from './services/exercise.ts';
const rows = ref<any[]>([]),
  recordRows = ref<any[]>([]),
  types = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  typeFilter = ref('全部类型'),
  startDate = ref(''),
  endDate = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref(''),
  saved = ref(false),
  selected = ref<string[]>([]);
const renderPageSize = 20;
const selecting = ref(false), swipedId = ref('');
const choosingExercise = ref(false);
const selectedExerciseType = computed(() => exerciseType(form.value?.exerciseTypeId));
watch(form, () => { choosingExercise.value = false; });
const page = ref(0), hasMoreRows = ref(false), revealing = ref(false), moreError = ref('');
const statisticsLoading = ref(false), statisticsError = ref('');
const chartType = ref('');
const statisticsReady = ref(false), recordsReady = ref(false);
let generation = 0,
  autoCreate = false;
let statisticsRevision = 0;
const scope = createRecordScope((clear) => {
  generation++;
  refreshing.value = false;
  loading.value = false;
  statisticsLoading.value = false;
  revealing.value = false;
  form.value = null;
  selected.value = [];
  selecting.value = false;
  swipedId.value = '';
  if (clear) {
    rows.value = [];
    recordRows.value = [];
    types.value = [];
    page.value = 0;
    hasMoreRows.value = false;
    statisticsReady.value = false;
    recordsReady.value = false;
    chartType.value = '';
    statisticsError.value = '';
  }
});
onLoad((query) => {
  autoCreate = query?.create === '1';
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value || statisticsLoading.value, error: () => error.value || statisticsError.value, keys: () => ['exerciseRecord', 'exerciseType', 'timeRecord', 'userDictData', 'userDictType'] })
onShow(() => refreshOnShow());
// 统计使用服务端按日/类型聚合结果，明细列表仅保留已加载的分页。
const filtered = computed(() => rows.value);
const visibleRows = computed(() => recordRows.value);
const recordGroups = computed(() => {
  const groups: { date: string; items: any[] }[] = [];
  for (const item of visibleRows.value) {
    let group = groups[groups.length - 1];
    if (!group || group.date !== item.exerciseDate) {
      group = { date: item.exerciseDate, items: [] };
      groups.push(group);
    }
    group.items.push(item);
  }
  return groups;
});
watch([typeFilter, startDate, endDate], () => {
  selected.value = [];
  swipedId.value = '';
  load();
});
function filters() {
  return [types.value.find((t) => (t.dictLabel || t.label) === typeFilter.value)?.id || '', startDate.value, endDate.value] as const;
}
function pageFinished(result, pageNumber) {
  const total = result.total == null ? null : Number(result.total);
  if (total != null && (!/^[0-9]+$/.test(String(result.total)) || !Number.isSafeInteger(total))) throw new Error('分页总数异常');
  return result.items.length < renderPageSize || (total != null && pageNumber * renderPageSize >= total);
}
async function revealMore(retry = false) {
  if (loading.value || error.value || revealing.value || form.value || !hasMoreRows.value || (moreError.value && !retry)) return;
  const current = generation, next = page.value + 1;
  revealing.value = true;
  moreError.value = '';
  try {
    const result = await scope.wait(fetchExercisePage(next, ...filters()));
    if (current !== generation) return;
    const finished = pageFinished(result, next);
    const seen = new Set(recordRows.value.map(item => item.id));
    const additional = result.items.filter(item => {
      if (seen.has(item.id)) return false;
      seen.add(item.id);
      return true;
    });
    recordRows.value = [...recordRows.value, ...additional];
    page.value = next;
    hasMoreRows.value = !finished;
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === generation) moreError.value = e.message;
  } finally {
    if (current === generation) revealing.value = false;
  }
}
const recordCount = computed(() => filtered.value.reduce((sum, item) => sum + item.recordCount, 0));
const counts = computed(() => {
  const unique = new Set(
    filtered.value.map((item) => item.exerciseDate + '_' + item.exerciseTypeId),
  );
  return unique.size;
});
const quantity = computed(() =>
  filtered.value.reduce((sum, item) => sum + Number(item.exerciseCount || 0), 0),
);
const monthly = computed(() => exerciseMonthlyChart(filtered.value, types.value, isDark.value));
const visibleTypes = computed(() => {
  const all = [...types.value];
  for (const item of filtered.value)
    if (!all.some((type) => type.id === item.exerciseTypeId))
      all.push({ id: item.exerciseTypeId, dictLabel: item.exerciseTypeId });
  return all;
});
const distribution = computed(() => exerciseDistributionChart(filtered.value, types.value, isDark.value));
// 每日运动量只统计单个类型，默认最近使用的类型，避免混合不同运动的计量单位。
const dailyGroup = computed(() => {
  const values = new Map<string, number>();
  for (const item of filtered.value) {
    if (item.exerciseTypeId !== chartType.value) continue;
    values.set(item.exerciseDate, (values.get(item.exerciseDate) || 0) + Number(item.exerciseCount || 0));
  }
  const points = [...values].sort((a, b) => a[0].localeCompare(b[0])).map(([label, value]) => ({ label, value }));
  return {
    label: name(chartType.value),
    points,
    xLabels: points.map((item, index) => index > 0 && item.label.slice(0, 4) === points[index - 1].label.slice(0, 4)
      ? item.label.slice(5) : item.label),
  };
});
function name(id) {
  return (
    types.value.find((item) => item.id === id)?.dictLabel ||
    types.value.find((item) => item.id === id)?.label ||
    id
  );
}
function exerciseType(id) {
  return types.value.find((item) => item.id === id);
}
async function loadStatistics(current = generation) {
  const revision = ++statisticsRevision;
  statisticsLoading.value = true;
  statisticsError.value = '';
  try {
    const result = await scope.wait(fetchExerciseStatistics(...filters()));
    if (current !== generation || revision !== statisticsRevision) return;
    rows.value = result;
    statisticsReady.value = true;
    if (!chartType.value) chartType.value = result[0]?.exerciseTypeId || types.value[0]?.id || '';
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === generation && revision === statisticsRevision) statisticsError.value = e.message;
  } finally {
    if (current === generation && revision === statisticsRevision) statisticsLoading.value = false;
  }
}
async function refresh() {
  if (refreshing.value) return;
  refreshing.value = true;
  try { await load(); } finally { refreshing.value = false; }
}
async function load() {
  const current = ++generation;
  loading.value = true;
  revealing.value = false;
  moreError.value = '';
  error.value = '';
  try {
    const dict = await scope.wait(fetchDictionary('exercise_type', true));
    if (current !== generation) return;
    types.value = dict.dictDetailList || [];
    if (startDate.value && endDate.value && startDate.value > endDate.value) {
      error.value = '开始日期不能晚于结束日期';
      return;
    }
    // 明细和统计互不阻塞，统计失败也可以查看和编辑已取得的明细。
    await Promise.all([
      loadStatistics(current),
      (async () => {
        const result = await scope.wait(fetchExercisePage(1, ...filters()));
        if (current !== generation) return;
        const finished = pageFinished(result, 1);
        recordRows.value = result.items;
        recordsReady.value = true;
        page.value = 1;
        hasMoreRows.value = !finished;
        loading.value = false;
        if (!chartType.value) chartType.value = result.items[0]?.exerciseTypeId || types.value[0]?.id || '';
        if (autoCreate) { autoCreate = false; open(); }
      })(),
    ]);
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === generation) error.value = e.message;
  } finally {
    if (current === generation) loading.value = false;
  }
}
function open(item = null) {
  swipedId.value = '';
  saved.value = false;
  formError.value = '';
  form.value = item
    ? { ...item, exerciseCount: String(item.exerciseCount ?? '') }
    : {
        exerciseTypeId:
          types.value.find((t) => (t.dictLabel || t.label) === typeFilter.value)?.id ||
          types.value[0]?.id ||
          '',
        exerciseDate: todayDate(),
        exerciseCount: '',
        description: '',
      };
}
function selectExerciseType(id: string) {
  if (!form.value || saving.value) return;
  form.value.exerciseTypeId = id;
  choosingExercise.value = false;
}
async function save() {
  if (saving.value) return;
  if (missingRequired('exercise', form.value)) {
    formError.value = '请选择运动类型和日期';
    return;
  }
  const count = form.value.exerciseCount === '' ? null : Number(form.value.exerciseCount);
  if (count != null && (!Number.isInteger(count) || count < 0)) {
    formError.value = '运动数量必须为非负整数';
    return;
  }
  saving.value = true;
  formError.value = '';
  try {
    if (!saved.value) {
      const payload = { ...form.value, exerciseCount: count };
      const ok = await scope.wait(saveExercise(payload));
      if (!ok) throw new Error('保存失败');
      saved.value = true;
    }
    await load();
    if (error.value) throw new Error(error.value);
    form.value = null;
  } catch (e) {
    if (e.name !== 'PageInactiveError') formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(ids) {
  await scope.wait(deleteExercises(ids));
  const removed = new Set(ids);
  recordRows.value = recordRows.value.filter((row) => !removed.has(row.id));
  selected.value = selected.value.filter((id) => !removed.has(id));
  // offset 分页删除后需要重新定位第一页，避免下一页跳过被删除记录之后的数据。
  if (hasMoreRows.value) await load();
  else await loadStatistics();
}
function toggle(id) {
  selected.value = selected.value.includes(id)
    ? selected.value.filter((value) => value !== id)
    : [...selected.value, id];
}
function toggleSelection() {
  swipedId.value = '';
  selecting.value = !selecting.value;
  selected.value = [];
}
</script>
<template>
  <MobilePage :refreshing="refreshing" :scroll-locked="!!form" @refresh="refresh" @reachbottom="revealMore()" @scroll="swipedId = ''"
    ><view class="exercise-page ui-page-body" :class="{ 'exercise-page-dark': isDark }"
      ><PageHeader title="运动记录" :back="true" @back="uni.navigateBack()" /><FormField
        label="运动类型"
        kind="selector"
        v-model="typeFilter"
        :options="['全部类型', ...types.map((t) => t.dictLabel || t.label)]"
 /><view class="date-filters ui-field-row"
        ><FormField compact stretch label="开始日期" kind="date" v-model="startDate" /><FormField compact stretch
          label="结束日期"
          kind="date"
          v-model="endDate" /><MobileButton
          v-if="startDate || endDate"
          label="清除日期筛选"
          icon="ant-design:close-outlined"
          variant="quiet"
          @click="
            startDate = '';
            endDate = '';
          " /></view
      ><text v-if="startDate && endDate && startDate > endDate" class="error ui-section ui-type-body"
        >开始日期不能晚于结束日期</text
      ><view class="metrics ui-row ui-section" :class="{ 'metrics-three': typeFilter !== '全部类型' }"
        ><MetricCard :style="appGridItem(2, 'inline', [[600, typeFilter === '全部类型' ? 2 : 3]], false)" :loading="statisticsLoading && !statisticsReady" label="运动次数" :value="statisticsReady ? counts : '—'" /><MetricCard :style="appGridItem(2, 'inline', [[600, typeFilter === '全部类型' ? 2 : 3]], false)" :loading="statisticsLoading && !statisticsReady"
          v-if="typeFilter !== '全部类型'"
          label="运动量"
          :value="statisticsReady ? quantity : '—'" /><MetricCard :style="appGridItem(2, 'inline', [[600, typeFilter === '全部类型' ? 2 : 3]], false)" :loading="statisticsLoading && !statisticsReady" label="记录" :value="statisticsReady ? recordCount : '—'" /></view
      ><view class="statistics-region">
        <LoadingIndicator v-if="statisticsLoading && statisticsReady" floating label="正在更新统计" />
        <PageState v-if="statisticsError" :error="statisticsError" @retry="loadStatistics()" />
<ExerciseMonthlyChart
          :loading="statisticsLoading && !statisticsReady"
          :labels="monthly.labels"
          :series="monthly.series"
          :reset-key="typeFilter + '_' + startDate + '_' + endDate"
        /><ExerciseDistributionChart
          :loading="statisticsLoading && !statisticsReady"
          :items="distribution"
        /><AioChart
          :loading="statisticsLoading && !statisticsReady"
          label="每日运动量"
          hide-values floating-tooltip show-extremes
          :visible-points="30" scroll-to-end
          :scroll-key="chartType + '_' + startDate + '_' + endDate"
          :labels="dailyGroup.points.map((item) => item.label)"
          :x-labels="dailyGroup.xLabels"
          :series="[{ name: dailyGroup.label, values: dailyGroup.points.map((item) => item.value) }]"
        >
          <template #actions>
            <picker class="daily-type-picker" mode="selector" aria-label="每日运动量类型"
              :value="Math.max(0, visibleTypes.findIndex(type => type.id === chartType))"
              :range="visibleTypes.map(type => type.dictLabel || type.label)"
              :disabled="!visibleTypes.length"
              @change="chartType = visibleTypes[Number($event.detail.value)]?.id || ''">
              <view class="daily-type-control">
                <text class="daily-type-label" :class="{ 'daily-type-label-dark': isDark }">{{ dailyGroup.label || '选择类型' }}</text>
                <AppIcon name="ant-design:down-outlined" :size="12" />
              </view>
            </picker>
          </template>
        </AioChart>
      </view>
      <view class="record-region">
      <LoadingIndicator v-if="loading && recordsReady" floating label="正在更新记录" />
      <PageState skeleton="list" :loading="loading && !recordsReady" :has-content="recordsReady" :error="error" :empty="!recordRows.length" @retry="load">
        <view class="record-toolbar">
          <text class="record-list-title">{{ selecting ? '已选 ' + selected.length + ' 条' : '运动记录' }}</text>
          <ConfirmAction v-if="selected.length" :label="'删除所选 ' + selected.length + ' 条记录'" :action="() => remove(selected)">
            <template #default="{ open: confirm, busy }"><MobileButton :label="'删除所选 ' + selected.length + ' 条记录'" icon="ant-design:delete-outlined" variant="ghost" :loading="busy" @click="confirm" /></template>
          </ConfirmAction>
          <MobileButton :label="selecting ? '完成选择' : '批量选择'" :icon="selecting ? 'ant-design:close-outlined' : 'ant-design:check-square-outlined'" variant="ghost" @click="toggleSelection" />
        </view>
        <view v-for="group in recordGroups" :key="group.date" class="record-group">
          <text class="record-date" :class="{ 'record-secondary-dark': isDark }">{{ group.date }}</text>
          <view class="record-surface" :class="{ 'record-surface-dark': isDark }">
            <ExerciseRecordRow v-for="(item, index) in group.items" :key="item.id"
              :item="item" :label="name(item.exerciseTypeId)"
              :icon="exerciseType(item.exerciseTypeId)?.icon || 'mdi:run'"
              :color="exerciseType(item.exerciseTypeId)?.color || '#5b8ff9'"
              :selecting="selecting" :selected="selected.includes(item.id)"
              :revealed="swipedId === item.id" :divided="index > 0"
              :action="() => remove([item.id])"
              @edit="open(item)" @select="toggle(item.id)"
              @reveal="swipedId = item.id" @close="swipedId === item.id && (swipedId = '')" />
          </view>
        </view>
        <LoadMore :loading="revealing" :has-more="hasMoreRows" :error="moreError" @load="revealMore(true)" /></PageState></view></view>
    <template #fixed>
      <FloatingActionButton v-if="!form" label="新增运动" :disabled="loading || !!error" @click="open()" />
      <!-- 录入层放在页面滚动容器外，避免微信原生输入和背景滚动相互影响。 -->
      <AdaptiveModal v-if="form" :label="form.id ? '编辑运动记录' : '新增运动记录'" :busy="saving" @close="form = null"
        ><FormField :required="isRequired('exercise', 'exerciseTypeId')"
          label="运动类型">
          <button role="button" class="exercise-type-control" :class="{ 'exercise-type-control-dark': isDark }"
            aria-label="选择运动类型" :aria-expanded="choosingExercise" :aria-required="isRequired('exercise', 'exerciseTypeId')"
            :disabled="saving" @click="choosingExercise = true">
            <CategoryIcon :icon="selectedExerciseType?.icon || 'lucide:dumbbell'" :color="selectedExerciseType?.color || '#1890ff'" :size="24" />
            <text class="exercise-type-value" :class="{ 'exercise-type-text-dark': isDark }">{{ name(form.exerciseTypeId) || '请选择' }}</text>
            <AppIcon name="ant-design:down-outlined" :size="12" />
          </button>
        </FormField><view class="ui-field-row">
          <FormField compact stretch :required="isRequired('exercise', 'exerciseDate')" label="运动日期" kind="date" v-model="form.exerciseDate" />
          <FormField compact stretch
          label="运动数量"
          input-type="number"
          v-model="form.exerciseCount" />
        </view><FormField
          label="备注"
          kind="textarea" textarea-size="compact"
          v-model="form.description" /><text v-if="formError" class="error ui-section ui-type-body">{{ formError }}</text
        ><FormActions>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving"
            @click="form = null" /><MobileButton
            :label="saved ? '重新读取' : '保存'"
            :loading="saving"
            @click="save" />
        </FormActions></AdaptiveModal>
      <AdaptiveModal v-if="form && choosingExercise" label="选择运动" :max-width="500"
        :content-key="JSON.stringify(types)" @close="choosingExercise = false">
        <view class="exercise-type-grid">
          <button v-for="item in types" :key="item.id" role="button" class="exercise-type-option"
            :aria-label="item.dictLabel || item.label || item.id" :aria-pressed="item.id === form.exerciseTypeId"
            :class="{ 'exercise-type-selected': item.id === form.exerciseTypeId, 'exercise-type-selected-dark': isDark && item.id === form.exerciseTypeId }"
            @click="selectExerciseType(item.id)">
            <CategoryIcon :icon="item.icon || 'lucide:dumbbell'" :color="item.color || '#1890ff'" :size="24" />
            <text class="exercise-type-name" :class="{ 'exercise-type-text-dark': isDark }">{{ item.dictLabel || item.label || item.id }}</text>
          </button>
          <text v-if="!types.length" class="exercise-type-empty" :class="{ 'exercise-type-text-dark': isDark }">暂无运动类型</text>
        </view>
      </AdaptiveModal>
    </template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.exercise-page {
  color: #27272a;
  padding-bottom: 80px; /* 浮动新增按钮避让 */
}
.exercise-page-dark {
  color: #eeeeef;
}
.toolbar,
.metrics {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.error {
  color: #e05252;
}
.exercise-type-control {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: $space-inline $space-card;
  border: 1px solid #d8dde4;
  border-radius: 10px;
  background-color: #ffffff;
  text-align: left;
}
.exercise-type-control-dark { background-color: #1c1e22; border-color: #363940; }
.exercise-type-value { @include type-style('body'); flex: 1; min-width: 0; color: #27272a; }
.exercise-type-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.exercise-type-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 25%;
  min-height: 76px; /* 与时迹图标网格一致的触控区域 */
  margin: 0;
  padding: $space-inline $space-detail;
  border: 1px solid transparent;
  border-radius: 6px;
  background-color: transparent;
}
.exercise-type-name { @include type-style('label'); color: #52525b; text-align: center; margin-top: $space-inline; }
.exercise-type-empty { @include type-style('body'); color: $text-secondary-light; }
.exercise-type-text-dark { color: #d4d4d8; }
.exercise-type-selected { border-color: #52525b; }
.exercise-type-selected-dark { border-color: #d4d4d8; }
/* #ifdef WEB || MP-WEIXIN */
.exercise-type-control::after, .exercise-type-option::after { border: 0; }
/* #endif */
.statistics-region { position: relative; }
.daily-type-picker { min-width: 0; max-width: 50%; flex-shrink: 1; }
.daily-type-control { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: $space-detail; min-width: $space-controlMin; min-height: $space-controlMin; }
.daily-type-label { @include type-style('body'); min-width: 0; color: $text-secondary-light; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.daily-type-label-dark { color: $text-secondary-dark; }
.record-region { position: relative; }
.record-toolbar { flex-direction: row; align-items: center; gap: $space-detail; margin-top: $space-inline; }
.record-list-title { @include type-style('title'); flex: 1; }
.record-group { margin-bottom: $space-section; gap: $space-inline; }
.record-date { @include type-style('caption'); color: $text-secondary-light; padding-left: $space-card; }
.record-surface { background-color: #ffffff; border-radius: 12px; overflow: hidden; }
.record-surface-dark { background-color: #1c1e22; }
.date-filters { align-items: flex-end; }
.metrics {
/* #ifndef APP */
display: grid;
