<script setup lang="ts">
import ModalMotion from "../../components/ModalMotion.uvue";
import { usePageRefresh } from '../../services/page-refresh.ts'
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import { computed, onUnmounted, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageSearch from '../../components/PageSearch.uvue';
import FilterTrigger from '../../components/FilterTrigger.uvue';
import FilterSheet from '../../components/FilterSheet.uvue';
import spacing from '../../styles/spacing.json';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import AttachmentField from '../../components/AttachmentField.uvue';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { useAppLayout } from '../../services/app-layout.ts';
import { isDark, themeClass } from '../../services/theme.ts';
import { tagsText, tagsList, recordId } from '../../services/records/contracts.ts';
import {
  fetchHonors,
  fetchHonorCategories,
  saveHonor,
  deleteHonor,
  toggleHonorTop,
} from './services/honor.ts';
const modalMotion0 = ref<{ close: () => void } | null>(null);
const { appGridCell } = useAppLayout();
const gridBreakpoints = [[600, 3], [1000, 4]];
const skeletonCount = 6;
function honorCell(index: number, length: number) {
  return appGridCell(index, length, 2, 'section', gridBreakpoints);
}

const attachmentBusy = ref(false);
const rows = ref<any[]>([]),
  categories = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref(''),
  busy = ref('');
const levels = ['school', 'district', 'city', 'province', 'national', 'international', 'other'],
  levelLabels = ['校级', '区级', '市级', '省级', '国家级', '国际级', '其他'];
const keyword = ref(''),
  categoryFilter = ref('全部分类'),
  levelFilter = ref('全部级别');
const searchOpen = ref(false);
const filtersOpen = ref(false);
const defaultFilters = { category: '全部分类', level: '全部级别' };
const filterDraft = ref({ ...defaultFilters });
const hasFilters = computed(() => categoryFilter.value !== defaultFilters.category || levelFilter.value !== defaultFilters.level);
function openFilters() {
  searchOpen.value = false;
  filterDraft.value = { category: categoryFilter.value, level: levelFilter.value };
  filtersOpen.value = true;
}
function applyFilters() {
  categoryFilter.value = filterDraft.value.category;
  levelFilter.value = filterDraft.value.level;
  filtersOpen.value = false;
}
const filtered = computed(() =>
  rows.value
    .filter(
      (item) =>
        (!keyword.value ||
          [item.title, item.description, item.issuer, tagsText(item.tags)].some((text) =>
            (text || '').toLowerCase().includes(keyword.value.toLowerCase()),
          )) &&
        (categoryFilter.value === '全部分类' ||
          item.categoryId === categories.value.find((c) => c.name === categoryFilter.value)?.id) &&
        (levelFilter.value === '全部级别' ||
          item.level === levels[levelLabels.indexOf(levelFilter.value)]),
    )
    .slice()
    .sort((a, b) => (b.isTop || 0) - (a.isTop || 0) || b.honorDate.localeCompare(a.honorDate)),
);
const scope = createRecordScope((clearData) => {
  filtersOpen.value = false;
  form.value = null;
  if (clearData) {
    rows.value = [];
    categories.value = [];
  }
});
let alive = true,
  generation = 0;
onUnmounted(() => {
  alive = false;
  generation++;
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['honorRecords', 'honorCategories'] })
onShow(() => refreshOnShow());
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    const [data, categoryData] = await scope.wait(
      Promise.all([fetchHonors(), fetchHonorCategories()]),
    );
    if (alive && current === generation) {
      rows.value = data;
      categories.value = categoryData;
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  formError.value = '';
  form.value = item
    ? { ...item, tags: tagsText(item.tags), files: (item.files || []).map((file) => ({ ...file })) }
    : {
        title: '',
        honorDate: new Date().toLocaleDateString('sv-SE'),
        description: '',
        issuer: '',
        level: '',
        categoryId: null,
        customCategory: '',
        tags: '',
        files: [],
        isPublic: 1,
        isTop: 0,
      };
}
async function save() {
  if (saving.value || attachmentBusy.value) return;
  if (missingRequired('honor', form.value)) {
    formError.value = '请输入标题和获得日期';
    return;
  }
  const payload = {
    ...form.value,
    title: form.value.title.trim(),
    fileIds: form.value.files.map((file) => recordId(file.id)),
    tags: tagsList(form.value.tags),
  };
  saving.value = true;
  formError.value = '';
  try {
    const saved = await scope.wait(saveHonor(payload));
    const row = { ...payload, ...saved, files: payload.files };
    const index = rows.value.findIndex((r) => r.id === row.id);
    if (index >= 0) rows.value[index] = row;
    else rows.value.push(row);
    form.value = null;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  await scope.wait(deleteHonor(item.id));
  rows.value = rows.value.filter((r) => r.id !== item.id);
}
async function top(item) {
  if (busy.value) return;
  busy.value = item.id;
  try {
    await scope.wait(toggleHonorTop(item.id));
    item.isTop = item.isTop === 1 ? 0 : 1;
    const row = rows.value.find(value => value.id === item.id);
    if (row) row.isTop = item.isTop;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    error.value = e.message;
  } finally {
    busy.value = '';
  }
}
function categoryName(item) {
  return categories.value.find((c) => c.id === item.categoryId)?.name || item.customCategory || '';
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)"
    ><view class="honor-page ui-page-body" :class="{ 'honor-page-dark': isDark }"
      ><PageSearch v-model="keyword" v-model:open="searchOpen" title="荣誉" label="搜索荣誉" back
        :actions-min-width="spacing.controlMin" @back="uni.navigateBack()">
        <template #trailing-actions>
          <FilterTrigger label="筛选荣誉" :open="filtersOpen" :active="hasFilters" @click="openFilters" />
        </template>
      </PageSearch>
      <FilterSheet :open="filtersOpen" @close="filtersOpen = false" @reset="filterDraft = { ...defaultFilters }" @apply="applyFilters">
        <FormField label="分类" kind="selector" v-model="filterDraft.category" :options="[defaultFilters.category, ...categories.map(c => c.name)]" />
        <FormField label="级别" kind="selector" v-model="filterDraft.level" :options="[defaultFilters.level, ...levelLabels]" />
      </FilterSheet>
      <PageState skeleton="list" :loading="loading" :error="error" :empty="!filtered.length" @retry="load()">
        <template #loading>
          <view class="honor-grid" role="status" aria-label="正在加载荣誉" aria-live="polite">
            <view v-for="n in skeletonCount" :key="n" class="honor-card ui-pad-card"
              :class="{ 'honor-card-dark': isDark }" :style="honorCell(n - 1, skeletonCount)" aria-hidden="true">
              <view class="honor-skeleton">
                <view class="honor-skeleton-shape honor-skeleton-badge" :class="themeClass('honor-skeleton-shape')" />
                <view class="honor-skeleton-shape honor-skeleton-title" :class="themeClass('honor-skeleton-shape')" />
                <view class="honor-skeleton-shape honor-skeleton-issuer" :class="themeClass('honor-skeleton-shape')" />
                <view class="honor-skeleton-description">
                  <view class="honor-skeleton-shape honor-skeleton-line" :class="themeClass('honor-skeleton-shape')" />
                  <view class="honor-skeleton-shape honor-skeleton-line-short" :class="themeClass('honor-skeleton-shape')" />
                </view>
                <view class="honor-skeleton-shape honor-skeleton-date" :class="themeClass('honor-skeleton-shape')" />
              </view>
            </view>
          </view>
        </template>

        <view class="honor-grid">
          <view v-for="(item, index) in filtered" :key="item.id" class="honor-card ui-pad-card"
            :class="{ 'honor-card-dark': isDark }" :style="honorCell(index, filtered.length)"
            role="button" :aria-label="'编辑荣誉：' + item.title" tabindex="0" @click="open(item)" @keydown.enter.self="open(item)" @keydown.space.self.prevent="open(item)">
            <view v-if="item.level || categoryName(item) || item.isTop === 1" class="honor-badges ui-row">
              <text v-if="item.level" class="honor-badge level-badge">{{ levelLabels[levels.indexOf(item.level)] || item.level }}</text>
              <text v-if="categoryName(item)" class="honor-badge" :class="{ 'honor-badge-next': item.level }">{{ categoryName(item) }}</text>
              <view v-if="item.isTop === 1" :class="{ 'honor-badge-next': item.level || categoryName(item) }">
                <AppIcon name="ant-design:star-filled" :size="14" color="#e5ad42" />
              </view>
            </view>
            <text class="honor-title" :class="{ 'honor-title-dark': isDark }">{{ item.title }}</text>
            <text v-if="item.issuer" class="honor-secondary honor-issuer" :class="{ 'secondary-text-dark': isDark }">{{ item.issuer }}</text>
            <text :max-lines="3" v-if="item.description" class="honor-content" :class="[{ 'honor-content-dark': isDark }, { 'secondary-text-dark': isDark }]">{{ item.description }}</text>
            <view v-if="item.tags && item.tags.length" class="honor-tags"><text v-for="tag in item.tags" :key="tag" class="honor-tag" :class="{ 'secondary-text-dark': isDark }">{{ tag }}</text></view>
            <view class="honor-date"><AppIcon name="ant-design:calendar-outlined" :size="13" color="#8b8f99" /><text class="honor-secondary honor-date-text" :class="{ 'secondary-text-dark': isDark }">{{ item.honorDate?.slice(0, 10) }}</text><view class="footer-spacer" /><AppIcon v-if="item.isPublic !== 1" name="ant-design:lock-outlined" :size="13" color="#b77927" aria-label="私密" /></view>
          </view>
        </view>
      </PageState
      ><ModalMotion><AdaptiveModal ref="modalMotion0"
        v-if="form"
        label="编辑荣誉"
        :busy="saving || attachmentBusy"
        @close="form = null"
        >
        <FormField :required="isRequired('honor', 'title')" appearance="soft" label="标题" v-model="form.title" />
        <view class="ui-field-row">
          <FormField :required="isRequired('honor', 'honorDate')" appearance="soft" compact stretch label="获得日期" kind="date" v-model="form.honorDate" />
          <FormField class="honor-field-next" appearance="soft" compact stretch label="级别" kind="selector" :model-value="levelLabels[levels.indexOf(form.level)] || '未设置'" :options="['未设置', ...levelLabels]" @update:model-value="form.level = levels[levelLabels.indexOf($event)] || ''" />
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="颁发机构" v-model="form.issuer" />
          <FormField class="honor-field-next" appearance="soft" compact stretch label="分类" kind="selector" :model-value="categories.find((c) => c.id === form.categoryId)?.name || '自定义'" :options="['自定义', ...categories.map((c) => c.name)]" @update:model-value="form.categoryId = categories.find((c) => c.name === $event)?.id || null" />
        </view>
        <FormField appearance="soft"
          v-if="!form.categoryId"
          label="自定义分类"
          v-model="form.customCategory" /><FormField appearance="soft"
          label="描述"
          kind="textarea"
          v-model="form.description" /><view class="ui-field-row"><FormField appearance="soft" compact stretch label="标签" placeholder="多个标签用逗号分隔" v-model="form.tags" /><FormField class="honor-field-next" appearance="soft" compact stretch
          label="公开"
          kind="selector"
          :model-value="form.isPublic === 1 ? '公开' : '私密'"
          :options="['公开', '私密']"
          @update:model-value="form.isPublic = $event === '公开' ? 1 : 0" /></view><AttachmentField
          :files="form.files"
          upload-path="/file/upload"
          :form-data="{ bizType: 'honor_record' }"
          @update:files="form.files = $event"
          @busy-change="attachmentBusy = $event" /><text v-if="formError" class="honor-error ui-section ui-type-body">{{
          formError
        }}</text
        ><template #footer><FormActions>
          <template #secondary><ConfirmAction v-if="form.id" label="删除荣誉" :action="() => remove(form)" @success="form = null" /><MobileButton v-if="form.id" :label="form.isTop === 1 ? '取消置顶' : '置顶荣誉'" :icon="form.isTop === 1 ? 'ant-design:star-filled' : 'ant-design:star-outlined'" variant="quiet" :loading="!!busy" @click="top(form)" /></template>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving || attachmentBusy"
            @click="modalMotion0?.close()" /><MobileButton
            label="保存"
            :loading="saving"
            :disabled="attachmentBusy"
            @click="save" />
        </FormActions></template></AdaptiveModal></ModalMotion></view
  ><template #fixed><FloatingActionButton label="新增荣誉" :disabled="loading || !!error" @click="open()" /></template></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/skeleton';
@include type-utilities('body');

.honor-page {
  padding-bottom: 80px; /* 浮动新增按钮避让 */
  color: #27272a;
}
.honor-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.metrics {
  flex-direction: row;
}
.honor-card {
  box-sizing: border-box;
  min-width: 0;
  background-color: #ffffff;
  border-radius: 16px;
}
.honor-card-dark {
  background-color: #1c1e22;
}
.honor-skeleton { @include skeleton.pulse; }
.honor-skeleton-shape { @include skeleton.shape; }
.honor-skeleton-badge { width: 40%; height: type-line('badge'); }
.honor-skeleton-title { width: 75%; height: type-line('title'); margin-top: $space-inline; }
.honor-skeleton-issuer { width: 60%; height: type-line('label'); margin-top: $space-inline; }
.honor-skeleton-description { margin-top: $space-inline; }
.honor-skeleton-line, .honor-skeleton-line-short { height: type-line('body') - $space-detail; }
.honor-skeleton-line { width: 92%; }
.honor-skeleton-line-short { width: 75%; margin-top: $space-detail; }
.honor-skeleton-date { width: 46%; height: type-line('label'); margin-top: $space-section + $space-detail; }
.honor-skeleton-shape-dark { @include skeleton.dark; }
@include skeleton.motion('.honor-skeleton');
.honor-title {
  flex: none;
  color: #27272a;
  @include type-style('title');
  @include wrap-long-text;
}
.honor-title-dark { color: #eeeeef; }
.honor-content {
  @include type-style('body');

}
.honor-secondary {
  color: $text-secondary-light;
  @include type-style('label');
}
.honor-error {
  color: #e05252;
}
.honor-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
/* #ifndef APP */
.honor-grid { gap: $space-section; }
.honor-card { width: calc((100% - #{$space-section}) / 2); }
@media (min-width: 600px) { .honor-card { width: calc((100% - #{$space-section * 2}) / 3); } }
@media (min-width: 1000px) { .honor-card { width: calc((100% - #{$space-section * 3}) / 4); } }
/* #endif */
/* #ifdef APP */
.honor-field-next { margin-left: $space-inline; }
.honor-badge-next { margin-left: $space-inline; }
.honor-tag { margin-right: $space-detail; margin-bottom: $space-detail; }
/* #endif */
.honor-badges { flex-wrap: wrap; align-items: center; margin-bottom: $space-inline; }
.honor-badge { @include type-style('badge');  color: #4177c1; background-color: rgba(74,144,226,0.12); border-radius: 4px; padding: 0 $space-detail; }
.level-badge { color: #b77927; background-color: rgba(229,173,66,0.12); }
.honor-issuer, .honor-content, .honor-tags { margin-top: $space-inline; }
.honor-date { flex-direction: row; align-items: center; margin-top: auto; padding-top: $space-section; }
.honor-date-text { margin-left: $space-inline; }
.footer-spacer { flex: 1; }
.honor-tags { flex-direction: row; flex-wrap: wrap; }
/* #ifndef APP */
.honor-tags { gap: $space-detail; }
/* #endif */
.honor-tag { @include type-style('badge');  color: $text-secondary-light; border-radius: 4px; padding: 0 $space-detail; background-color: rgba(128,138,153,0.1); }
.honor-content { color: $text-secondary-light;
@include wrap-long-text;

@include clamp-text(3);
 overflow: hidden; }
.honor-content-dark { color: $text-secondary-dark; }
/* #ifdef WEB */
.honor-card:focus-visible { outline: 2px solid #417ce8; outline-offset: 2px; }
/* #endif */

.secondary-text-dark { color: $text-secondary-dark; }
</style>
