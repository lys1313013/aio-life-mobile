@use '../../styles/spacing-tokens' as *;
@include type-utilities('body', 'label', 'title');

.library-page {
  position: relative;
  padding-bottom: 64px;
  color: #27272a;
}
.library-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.library-ranking { align-self: center; flex-direction: row; max-width: 100%; border-radius: 3px; background-color: #ffe298; }
.library-ranking-wrap { flex-wrap: wrap; justify-content: center; }
.library-rank, .library-rank-name { @include type-style('badge'); color: #624407; padding: 0 $space-detail; }
.library-rank { background-color: #ffd365; }
.library-rank-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.library-filter-options { flex-wrap: wrap; }
.library-filter-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: calc((100% - #{$space-inline}) / 2);
  min-height: $space-controlMin;
  margin: 0;
  padding: $space-detail $space-modal;
  border: 0;
  border-radius: 10px;
  background-color: #f0f2f5;
  @include borderless-button;
}
.library-filter-option-dark { background-color: #282b31; }
.library-filter-option-selected { background-color: #e3ecff; }
.library-filter-option-selected-dark { background-color: #2c3953; }
.library-filter-option-text {
  color: #27272a;
  text-align: center;
  @include type-style('body');
  @include wrap-long-text;
}
.library-filter-text-dark { color: #eeeeef; }
.library-filter-check { position: absolute; right: $space-detail; bottom: $space-detail; }
.library-filter-empty { min-height: $space-controlMin; justify-content: center; }
.metrics {
  flex-direction: row;
  flex-wrap: wrap;
}
.library-grid {
  flex-direction: row;
  flex-wrap: wrap;

}
.library-card {
  width: calc((100% - #{$space-section * 2}) / 3);

  box-sizing: border-box;
  min-width: 0;
}
.library-poster {
  $cover-width: 88%;
  position: relative;
  border-radius: 6px;
  overflow: hidden;
  background-color: #e6e9ed;
  align-self: center;
  width: $cover-width;
  padding-top: ($cover-width * math.div(4, 3));
}
.library-status {
  position: absolute;
  right: 0;
  top: 0;
  padding: $space-detail $space-inline;
  border-bottom-left-radius: 6px;
  color: #ffffff;
  background-color: #737e90;
  @include type-style('chart-label');

}
.library-status-in_progress {
  background-color: #3b82f6;
}
.library-status-completed {
  background-color: #22a06b;
}
.library-status-on_hold {
  background-color: #c77d18;
}
.library-date {
  @include type-style('badge');

  text-align: center;
  color: $text-secondary-light;
}
.library-opening {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
  @include type-style('caption');
}
.library-link-row {
  flex-direction: row;
  align-items: center;
}
.library-link-field {
  flex: 1;
  min-width: 0;
}
/* #ifdef WEB */
.library-filter-option:focus-visible { outline: 2px solid #93b4fc; outline-offset: -2px; }
.library-poster:focus-visible { outline: 2px solid #427bea; outline-offset: $space-micro; }
/* #endif */
@media (min-width: 640px) {
  .library-card {
    width: calc((100% - #{$space-section * 3}) / 4);
  }
}
@media (min-width: 768px) {
  .library-card {
    width: calc((100% - #{$space-section * 4}) / 5);
  }
}
@media (min-width: 1200px) {
  .library-card {
    width: calc((100% - #{$space-section * 6}) / 7);
  }
}
.library-content {
  @include type-style('body');

}
.library-secondary {
  color: $text-secondary-light;
  @include type-style('label');
}
.library-error {
  color: #e05252;
}

.record-secondary-dark { color: $text-secondary-dark; }
</style>
