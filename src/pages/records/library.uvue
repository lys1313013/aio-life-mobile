<script setup lang="ts">
import ReadingShelf from './components/ReadingShelf.uvue';
import ModalMotion from "../../components/ModalMotion.uvue";
import { readPageTotal, mergePageItems, hasMorePageItems } from '../../services/pagination.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import LibraryRecordEditor from '../../components/record-editors/LibraryRecordEditor.uvue';
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import { computed, onUnmounted, ref } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import spacing from '../../styles/spacing.json';
import PageSearch from '../../components/PageSearch.uvue';
import MovieStatusTabs from './components/MovieStatusTabs.uvue';
import CategoryPager from '../../components/CategoryPager.uvue';
import FilterTrigger from '../../components/FilterTrigger.uvue';
import FilterSheet from '../../components/FilterSheet.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import FormActions from '../../components/FormActions.uvue';
import PageState from '../../components/PageState.uvue';
import LoadMore from '../../components/LoadMore.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import LibraryCover from '../../components/LibraryCover.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import { session } from '../../services/session.ts';
import { isDark, themePalette } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { statuses } from '../../services/records/contracts.ts';
import { chooseImportFile } from './services/import-file.ts';
import { parseDoubanWorkbook } from './services/douban-import.ts';
import {
  fetchLibrary,
  fetchLibraryDetail,
  fetchRankings,
  previewDoubanImport,
  importDouban,
} from './services/media.ts';
const kind = ref('movie'),
  title = computed(() => (kind.value === 'movie' ? '观影' : '阅读记录')),
  typeLabels = computed(() =>
    kind.value === 'movie'
      ? ['电影', '剧集', '动漫', '纪录片', '其他']
      : ['书籍', '文章/网页'],
  );
const readingStatusLabels = ['想读', '在读', '读过', '搁置'];
const movieStatuses = [
  { status: 'not_started', label: '未开始' },
  { status: 'in_progress', label: '进行中' },
  { status: 'on_hold', label: '已暂停' },
  { status: 'completed', label: '已完成' },
];
const libraryPageSize = 30;
function createList() {
  return {
    rows: [] as any[], page: 1, total: null as number | null, loaded: false, ended: false, revision: 0,
    loading: false, loadingMore: false, refreshing: false, error: '', moreError: '',
  };
}
const readList = ref(createList());
const moviePages = ref(movieStatuses.map(group => ({
  ...group, ...createList(), count: null as number | null, contentRevision: 0,
})));
const movieIndex = ref(1);
const movieProgress = ref<number | null>(null);
const moviePager = ref<{ measure: () => void; ignoreClick: () => boolean } | null>(null);
const currentList = computed(() => kind.value === 'movie' ? moviePages.value[movieIndex.value] : readList.value);
const movieTabs = computed(() => moviePages.value.map(({ label, count }) => ({
  label, count: count ?? '—', ariaLabel: count == null ? label : label + '，' + count + ' 条',
})));
const rankingOptions = ref<Array<{ id: string; name: string }>>([]);
const rankingId = ref('');
const rankingIndex = computed({
  get: () => rankingOptions.value.findIndex(list => list.id === rankingId.value) + 1,
  set: (index: number) => { rankingId.value = rankingOptions.value[index - 1]?.id || ''; },
});
const rankingStatus = ref<'idle' | 'loading' | 'ready' | 'error'>('idle');
let rankingRequest = 0;
function rankingDisplayName(name: string) {
  return (name === '豆瓣电影Top250' || name === '豆瓣读书Top250') ? '豆瓣 Top250' : name;
}
const rankingLabels = computed(() => rankingOptions.value.map(list => rankingDisplayName(list.name)));
const keyword = ref(''),
  searchDraft = ref(''),
  searchOpen = ref(false),
  typeIndex = ref(0),
  readingStatusIndex = ref(0),
  entryLoading = ref(false),
  editing = ref('');
const readingGroups = [
  { status: 'in_progress', label: '在读' }, { status: 'completed', label: '读过' },
  { status: 'not_started', label: '想读' }, { status: 'on_hold', label: '搁置' },
];
const previewSize = 6;
type ReadingGroup = { status: string; label: string; items: any[]; total: number | null; hasMore: boolean };
const previews = ref<ReadingGroup[]>([]);
const overview = computed(() => kind.value === 'read' && readingStatusIndex.value === 0);
const readingShelves = computed<ReadingGroup[]>(() => overview.value ? previews.value : [{
  label: readingStatusLabels[readingStatusIndex.value - 1], status: statuses[readingStatusIndex.value - 1],
  items: readList.value.rows, total: readList.value.total, hasMore: false,
}]);
const listKey = computed(() => JSON.stringify([kind.value, keyword.value, typeIndex.value, readingStatusIndex.value, rankingId.value]));
const filtersOpen = ref(false);
const defaultFilters = { type: 0, status: 0, ranking: 0 };
const filterDraft = ref({ ...defaultFilters });
const hasFilters = computed(() => typeIndex.value > 0 || readingStatusIndex.value > 0 || !!rankingId.value);
const filterAccent = computed(() => themePalette().tabSelectedColor);
const filterGroups = computed<Array<{ key: keyof typeof defaultFilters; label: string; options: string[] }>>(() => [
  { key: 'type', label: '类型', options: typeLabels.value },
  ...(kind.value === 'read' ? [{ key: 'status' as const, label: '阅读状态', options: readingStatusLabels }] : []),
  { key: 'ranking', label: '榜单', options: rankingLabels.value },
]);
const form = ref<any>(null);
const advancedImport = ref(false);
const importingOpen = ref(false),
  importRequest = ref<any>(null),
  preview = ref<any>(null),
  localIssues = ref<any[]>([]),
  importText = ref(''),
  importName = ref(''),
  importBusy = ref(false),
  importError = ref(''),
  importResult = ref<any>(null),
  policy = ref('跳过重复');
const issues = computed(() => [
  ...localIssues.value,
  ...(preview.value?.errors || []),
]);
const movieSwitcherDisabled = computed(() => !!(form.value || filtersOpen.value || importingOpen.value || entryLoading.value || editing.value));
const scope = createRecordScope((clear) => {
  form.value = null;
  filtersOpen.value = false;
  entryLoading.value = false;
  importingOpen.value = false;
  rankingRequest++;
  if (rankingStatus.value === 'loading') rankingStatus.value = 'idle';
  if (clear) {
    rankingOptions.value = [];
    rankingIndex.value = 0;
    rankingStatus.value = 'idle';
    requestedEdit = '';
    requestedCreate = false;
    resetLists();
    importRequest.value = null;
    preview.value = null;
    importText.value = '';
    importResult.value = null;
  }
});
let alive = true,
  generation = 0;
let requestedEdit = '', requestedCreate = false;
onLoad((options) => {
  kind.value = options?.kind === 'read' ? 'read' : 'movie';
  if (kind.value === 'read' && statuses.includes(options?.shelf)) {
    readingStatusIndex.value = statuses.indexOf(options.shelf) + 1;
    keyword.value = searchDraft.value = options.title || '';
    typeIndex.value = [1, 2].includes(Number(options.type)) ? Number(options.type) : 0;
    rankingId.value = options.rankingListId || '';
  }
  requestedEdit = options?.editId || '';
  requestedCreate = options?.create === '1';
});
const refreshOnShow = usePageRefresh(() => reload(), {
  loading: () => currentList.value.loading, error: () => currentList.value.error,
  keys: () => ['read-record', 'movie', 'userDictData', 'userDictType'],
});
async function loadRankings() {
  if (!session.token || rankingStatus.value === 'loading' || rankingStatus.value === 'ready') return;
  const current = ++rankingRequest;
  rankingStatus.value = 'loading';
  try {
    const lists = await scope.wait(fetchRankings(kind.value));
    if (current !== rankingRequest) return;
    rankingOptions.value = lists;
    rankingStatus.value = 'ready';
  } catch (error) {
    if (current === rankingRequest) rankingStatus.value = error.name === 'PageInactiveError' ? 'idle' : 'error';
  }
}
onShow(() => {
  refreshOnShow();
  void loadRankings();
});
onUnmounted(() => {
  alive = false;
  generation++;
});
function resetLists(keepCurrentMovie = false) {
  generation++;
  readList.value = createList();
  previews.value = [];
  moviePages.value = moviePages.value.map((group, index) => {
    if (keepCurrentMovie && index === movieIndex.value) {
      return { ...group, loading: false, loadingMore: false, refreshing: false };
    }
    return { ...group, ...createList(), count: keepCurrentMovie ? group.count : null, contentRevision: generation };
  });
}
function submitSearch() {
  searchDraft.value = searchDraft.value.trim();
  if (keyword.value !== searchDraft.value) {
    keyword.value = searchDraft.value;
    resetLists();
  }
  void reload();
}
function openFilters() {
  searchOpen.value = false;
  filterDraft.value = { type: typeIndex.value, status: readingStatusIndex.value, ranking: rankingIndex.value };
  filtersOpen.value = true;
  if (rankingStatus.value === 'idle') void loadRankings();
}
function toggleFilter(key: keyof typeof defaultFilters, value: number) {
  filterDraft.value[key] = filterDraft.value[key] === value ? 0 : value;
}
function applyFilters() {
  filtersOpen.value = false;
  const { type, status, ranking } = filterDraft.value;
  if (type === typeIndex.value && status === readingStatusIndex.value && ranking === rankingIndex.value) return;
  typeIndex.value = type;
  readingStatusIndex.value = status;
  rankingIndex.value = ranking;
  resetLists();
  void reload();
}
function openShelf(status: string) {
  let url = '/pages/records/library?kind=read&shelf=' + status;
  if (keyword.value) url += '&title=' + encodeURIComponent(keyword.value);
  if (typeIndex.value) url += '&type=' + typeIndex.value;
  if (rankingId.value) url += '&rankingListId=' + encodeURIComponent(rankingId.value);
  uni.navigateTo({ url });
}
async function fetchPreviews(filters: Record<string, any>) {
  // 多取一本，在服务端未提供 total 时也能判断是否需要“查看全部”。
  const groups = await Promise.all(readingGroups.map(async group => {
    const data = await fetchLibrary('read', { ...filters, statuses: [group.status], page: 1, pageSize: previewSize + 1 });
    const count = readPageTotal(data.total);
    const items = mergePageItems([], data.items);
    return { ...group, items: items.slice(0, previewSize), total: count,
      hasMore: (count ?? items.length) > previewSize };
  }));
  return groups.filter(group => group.items.length > 0);
}
function libraryFilters() {
  return {
    ...(rankingId.value ? { rankingListId: rankingId.value } : {}),
    title: keyword.value.trim(),
    ...(typeIndex.value > 0 ? { type: typeIndex.value } : {}),
  };
}
function selectMovieStatus(index: number) {
  const target = moviePages.value[index];
  if (!target || index === movieIndex.value || movieSwitcherDisabled.value) return;
  movieIndex.value = index;
  if ((!target.loaded || target.error) && !target.loading) void load();
}
function loadMore() {
  const target = currentList.value;
  if (overview.value || target.error || target.moreError) return;
  void load(false, true);
}
let countRequest = 0;
function reload(refresh = false) {
  if (refresh) void loadRankings();
  if (kind.value === 'movie') {
    const request = ++countRequest;
    const current = generation;
    const filters = libraryFilters();
    for (const [index, target] of moviePages.value.entries()) {
      if (index === movieIndex.value) continue;
      const revision = target.revision;
      void scope.wait(fetchLibrary('movie', { ...filters, statuses: [target.status], page: 1, pageSize: 1 }))
        .then(data => {
          if (alive && current === generation && request === countRequest && (!target.loaded || revision === target.revision)) {
            target.count = readPageTotal(data.total);
          }
        }).catch(() => {
          // 数量查询失败时保留上次结果。切换到该状态或下拉刷新可以重新查询。
        });
    }
  }
  return load(refresh);
}
async function load(refresh = false, more = false) {
  const moviePage = kind.value === 'movie' ? moviePages.value[movieIndex.value] : null;
  const target = moviePage ?? readList.value;
  if (more && (target.loading || !target.rows.length || !hasMorePageItems(target.rows.length, target.total, target.ended))) return;
  const current = generation;
  const revision = ++target.revision;
  const isCurrent = () => alive && current === generation && revision === target.revision;
  const next = more ? target.page + 1 : 1;
  target.loading = true;
  target.loadingMore = more;
  target.refreshing = refresh;
  target.error = '';
  target.moreError = '';
  try {
    const filters = libraryFilters();
    if (overview.value) {
      const groups = await scope.wait(fetchPreviews(filters));
      if (!isCurrent()) return;
      previews.value = groups;
    } else {
      const status = moviePage?.status ?? statuses[readingStatusIndex.value - 1];
      const data = await scope.wait(fetchLibrary(kind.value, {
        ...filters, page: next, pageSize: libraryPageSize,
        ...(status ? { statuses: [status] } : {}),
      }));
      if (!isCurrent()) return;
      const nextTotal = readPageTotal(data.total);
      target.rows = mergePageItems(more ? target.rows : [], data.items);
      target.page = next;
      target.ended = !data.items.length;
      target.total = nextTotal;
      if (moviePage) moviePage.count = nextTotal;
    }
    target.loaded = true;
    if (target !== currentList.value) return;
    if (requestedEdit) {
      // 首页入口可能不在列表首屏，始终读取完整详情后再允许编辑。
      entryLoading.value = true;
      const detail = await scope.wait(fetchLibraryDetail(kind.value, requestedEdit));
      if (!isCurrent()) return;
      setEditForm(detail);
      requestedEdit = '';
      requestedCreate = false;
    } else if (requestedCreate) {
      requestedCreate = false;
      open();
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (isCurrent()) {
      if (more) target.moreError = e.message;
      else target.error = e.message;
    }
  } finally {
    if (isCurrent()) {
      target.loading = false;
      target.loadingMore = false;
      target.refreshing = false;
      if (target === currentList.value) entryLoading.value = false;
    }
  }
}
function setEditForm(detail) {
  if (!detail?.id) throw Error('记录不存在或已删除');
  form.value = {
    ...detail,
    files: detail.fileId
      ? [{ id: detail.fileId, fileName: detail.title + ' 封面' }]
      : [],
  };
}
async function open(item = null) {
  if (editing.value || entryLoading.value || (item && moviePager.value?.ignoreClick())) return;
  if (!item) {
    form.value = {
      title: '',
      type: 1,
      status: 'not_started',
      director: '',
      author: '',
      url: '',
      coverImgUrl: '',
      fileId: '',
      files: [],
      totalProgress: 0,
      currentProgress: 0,
      startDate: null,
      finishDate: null,
      rating: null,
      remark: '',
    };
    return;
  }
  editing.value = item.id;
  try {
    const detail = await scope.wait(fetchLibraryDetail(kind.value, item.id));
    setEditForm(detail);
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    currentList.value.error = e.message;
  } finally {
    editing.value = '';
  }
}
function saved(updated, status: string) {
  form.value = null;
  if (kind.value === 'read') {
    void load();
  } else {
    if (!updated) {
      searchDraft.value = ''; keyword.value = ''; typeIndex.value = 0;
      const index = movieStatuses.findIndex(group => group.status === status);
      if (index >= 0) movieIndex.value = index;
    }
    resetLists(!!updated);
    void reload();
  }
}
function deleted(id) {
  if (kind.value === 'read') {
    form.value = null;
    void load();
    return;
  }
  form.value = null;
  currentList.value.rows = currentList.value.rows.filter(row => row.id !== id);
  resetLists(true);
  void reload();
}
function openImport() {
  searchOpen.value = false;
  importingOpen.value = true;
  advancedImport.value = false;
  importRequest.value = null;
  preview.value = null;
  localIssues.value = [];
  importResult.value = null;
  importError.value = '';
  importText.value = '';
  importName.value = '';
}
async function chooseWorkbook() {
  if (importBusy.value) return;
  importBusy.value = true;
  importError.value = '';
  preview.value = null;
  importRequest.value = null;
  importResult.value = null;
  try {
    const file = await scope.wait(chooseImportFile(['xlsx'], true));
    const parsed = parseDoubanWorkbook(file.data);
    localIssues.value = parsed.issues;
    importRequest.value = parsed.request;
    importName.value = file.name;
    preview.value = await scope.wait(previewDoubanImport(parsed.request));
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    importError.value = e.message;
  } finally {
    importBusy.value = false;
  }
}
async function previewText() {
  if (importBusy.value) return;
  importBusy.value = true;
  importError.value = '';
  importRequest.value = null;
  preview.value = null;
  importResult.value = null;
  try {
    const data = JSON.parse(importText.value);
    if (!Array.isArray(data.records)) throw Error('导入内容缺少 records');
    localIssues.value = [];
    importRequest.value = data;
    preview.value = await scope.wait(previewDoubanImport(data));
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    importError.value = e.message;
  } finally {
    importBusy.value = false;
  }
}
function pasteImport() {
  uni.getClipboardData({
    success: (result) => {
      importText.value = result.data;
    },
    fail: () => {
      importError.value = '无法读取剪贴板，请手动粘贴';
    },
  });
}
async function submitImport() {
  if (
    importBusy.value ||
    !importRequest.value ||
    !preview.value ||
    issues.value.length ||
    importResult.value
  )
    return;
  importBusy.value = true;
  importError.value = '';
  try {
    importResult.value = await scope.wait(
      importDouban({
        ...importRequest.value,
        duplicatePolicy: policy.value === '覆盖重复' ? 'overwrite' : 'skip',
      }),
    );
    resetLists(true);
    await reload();
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    importError.value = e.message;
  } finally {
    importBusy.value = false;
  }
}
</script>
<template>
  <MobilePage :scroll-locked="kind === 'movie'" :refreshing="kind === 'read' && readList.refreshing"
    @refresh="reload(true)" @reachbottom="loadMore"
    ><view class="library-page ui-page-body" :class="{ 'library-page-dark': isDark }"
      ><PageSearch v-model="searchDraft" v-model:open="searchOpen" :title="title" :label="'搜索' + title"
        :content-min-width="spacing.controlMin" :actions-min-width="spacing.controlMin * (kind === 'movie' ? 2 : 1)" back manual :active="!!keyword" :loading="currentList.loading"
        @search="submitSearch" @dismiss="searchDraft = keyword" @layout="moviePager?.measure()" @back="uni.navigateBack()">
        <template v-if="kind === 'movie'" #actions>
          <MobileButton label="豆瓣导入" icon="ant-design:upload-outlined" variant="ghost" @click="openImport" />
        </template>
        <template #trailing-actions>
          <FilterTrigger :label="'筛选' + title" :open="filtersOpen" :active="hasFilters" @click="openFilters" />
        </template>
      </PageSearch>
      <LoadingIndicator v-if="entryLoading" floating label="正在加载记录详情" />
      <template v-if="kind === 'movie'">
        <MovieStatusTabs :items="movieTabs" :current="movieIndex" :progress="movieProgress"
          :disabled="movieSwitcherDisabled" @change="selectMovieStatus" />
        <CategoryPager ref="moviePager" :items="moviePages" :current="movieIndex" track-progress :disabled="movieSwitcherDisabled"
          :refreshing="currentList.refreshing" :layout-key="searchOpen" tabs-selector=".movie-status-tabs"
          @change="selectMovieStatus" @progress="movieProgress = $event" @refresh="reload(true)" @reachbottom="loadMore">
          <template #default="{ item: moviePage }">
            <PageState skeleton="media"
              :loading="!moviePage.loadingMore && (moviePage.loading || (!moviePage.loaded && !moviePage.error))"
              :has-content="moviePage.loaded"
              :content-key="listKey + ':' + moviePage.status + ':' + moviePage.contentRevision + ':' + (moviePage.loaded ? '' : moviePage.count)"
              :error="moviePage.error" :empty="!moviePage.rows.length" @retry="reload()">
              <template #loading>
                <view v-if="moviePage.count === 0" class="library-empty-loading ui-pad-card">
                  <LoadingIndicator compact label="正在加载观影记录" />
                </view>
                <view v-else class="library-grid ui-gap-md ui-section" role="status" aria-label="正在加载观影记录">
                  <view v-for="n in Math.min(moviePage.count ?? 9, libraryPageSize)" :key="n" class="library-card" aria-hidden="true">
                    <view class="library-poster"><ContentSkeleton variant="cover" /></view>
                  </view>
                </view>
              </template>
              <view v-if="moviePage.rows.length" class="library-grid ui-gap-md ui-section">
                <view v-for="item in moviePage.rows" :key="item.id" class="library-card ui-gap-sm">
                  <view
                    class="library-poster"
                    role="button"
                    tabindex="0"
                    aria-label="编辑记录"
                    :aria-description="item.title"
                    :aria-busy="editing === item.id"
                    @click="open(item)"
                    @keydown.enter="open(item)"
                    @keydown.space.prevent="open(item)"
                  >
                    <LibraryCover
                      :file-id="item.fileId || ''"
                      :url="item.coverImgUrl || ''"
                      :title="item.title"
                      :kind="kind"
                    />
                    <view v-if="editing === item.id" class="library-opening"
                      ><LoadingIndicator compact label="正在加载记录详情" /></view
                    >
                  </view>
                  <view v-for="badge in item.rankings" :key="badge.rankingListId" class="library-ranking" :class="{ 'library-ranking-wrap': badge.name === '豆瓣电影Top250' }" :aria-label="rankingDisplayName(badge.name) + (badge.rank == null ? '' : ' 第' + badge.rank + '名')">
                    <text v-if="badge.rank != null" class="library-rank">No.{{ badge.rank }}</text>
                    <text class="library-rank-name">{{ rankingDisplayName(badge.name) }}</text>
                  </view>
                  <text v-if="item.finishDate" class="library-date" :class="{ 'record-secondary-dark': isDark }">{{
                    item.finishDate.slice(0, 10)
                  }}</text>
                </view>
              </view>
            </PageState>
            <LoadMore :error="moviePage.moreError" :loading="moviePage.loadingMore"
              :has-more="hasMorePageItems(moviePage.rows.length, moviePage.total, moviePage.ended)"
              @load="load(false, true)" />
          </template>
        </CategoryPager>
      </template>
      <template v-else>
        <PageState skeleton="media" :loading="readList.loading && !readList.loadingMore"
          :has-content="readList.loaded" :content-key="listKey"
          :error="readList.error" :empty="overview ? !previews.length : !readList.rows.length" @retry="load()">
          <template #loading>
            <view class="ui-gap-md">
              <ReadingShelf v-for="group in (overview ? readingGroups.slice(0, 3) : readingShelves)" :key="group.status"
                :status="group.status" :label="group.label" :items="[]" :total="null" :placeholders="group.status === 'completed' ? 6 : 3" />
            </view>
          </template>
          <view class="ui-gap-md">
            <ReadingShelf v-for="group in readingShelves" v-show="group.items.length > 0" :key="group.status"
              :status="group.status" :label="group.label" :items="group.items" :total="group.total"
              :has-more="group.hasMore" :editing="editing" @open="open" @all="openShelf(group.status)" />
          </view>
        </PageState>
        <LoadMore v-if="!overview" :error="readList.moreError" :loading="readList.loadingMore"
          :has-more="hasMorePageItems(readList.rows.length, readList.total, readList.ended)" @load="load(false, true)" />
      </template>
      <FilterSheet :open="filtersOpen" :content-key="rankingStatus + ':' + rankingOptions.length"
        :summary="kind === 'movie' && currentList.loaded ? (currentList.total == null ? '已加载 ' + currentList.rows.length : currentList.total) + ' 条' : ''"
        @close="filtersOpen = false" @reset="filterDraft = { ...defaultFilters }" @apply="applyFilters">
          <view class="ui-gap-md">
            <view v-for="group in filterGroups" :key="group.key" class="ui-gap-sm" role="group" :aria-label="group.label">
              <text class="ui-type-label" :class="{ 'library-filter-text-dark': isDark }">{{ group.label }}</text>
              <view v-if="group.options.length" class="library-filter-options ui-row">
                <button v-for="(option, index) in group.options" :key="index" class="library-filter-option"
                  :class="{
                    'library-filter-option-dark': isDark,
                    'library-filter-option-selected': filterDraft[group.key] === index + 1,
                    'library-filter-option-selected-dark': isDark && filterDraft[group.key] === index + 1,
                  }"
                  role="button" hover-class="none" :aria-label="option" :aria-pressed="filterDraft[group.key] === index + 1"
                  @click="toggleFilter(group.key, index + 1)">
                  <text class="library-filter-option-text" :class="{ 'library-filter-text-dark': isDark }"
                    :style="{ color: filterDraft[group.key] === index + 1 ? filterAccent : undefined }">{{ option }}</text>
                  <view v-if="filterDraft[group.key] === index + 1" class="library-filter-check" aria-hidden="true">
                    <AppIcon name="ant-design:check-outlined" :size="12" :color="filterAccent" />
                  </view>
                </button>
              </view>
              <MobileButton v-else-if="rankingStatus === 'loading' || rankingStatus === 'error'"
                :label="rankingStatus === 'loading' ? '加载榜单' : '重试榜单'" :loading="rankingStatus === 'loading'"
                variant="quiet" @click="loadRankings()" />
              <view v-else class="library-filter-empty">
                <text class="library-secondary" :class="{ 'record-secondary-dark': isDark }">暂无榜单</text>
              </view>
            </view>
          </view>
      </FilterSheet>
      <ModalMotion><LibraryRecordEditor v-if="form" :record="form" :kind="kind" @close="form = null" @saved="saved" @deleted="deleted" /></ModalMotion>
      <ModalMotion><AdaptiveModal
        v-if="importingOpen"
        label="豆瓣观影导入"
        :busy="importBusy"
        @close="importingOpen = false"
        ><text class="library-secondary" :class="{ 'record-secondary-dark': isDark }">选择 douban-exporter 导出的 .xlsx 文件，预览无误后再导入。</text><MobileButton
          label="选择 Excel"
          variant="quiet"
          :loading="importBusy"
          @click="chooseWorkbook" /><text
          v-if="importName"
          class="library-secondary"
           :class="{ 'record-secondary-dark': isDark }">{{ importName }}</text
        ><MobileButton :label="advancedImport ? '收起 JSON 导入' : '更多方式：JSON 导入'" variant="quiet" :disabled="importBusy" @click="advancedImport = !advancedImport" /><view v-if="advancedImport"><text class="library-secondary" :class="{ 'record-secondary-dark': isDark }">粘贴与 Excel 导入请求相同的 JSON 对象：format 为 aio-life-movie-import，version 为 1，source 为 douban，另含 doubanUserId 和 records 数组。每条记录包含 rowNumber、doubanSubjectId、title、type、status；type 可为 movie / series / animation / documentary / other，status 可为 not_started / in_progress / completed / on_hold，markedDate 使用 yyyy-MM-dd。</text><FormField
          label="JSON 导入内容"
          kind="textarea"
          v-model="importText" /><view class="ui-toolbar"
          ><MobileButton
            label="粘贴导入内容"
            icon="lucide:clipboard-paste"
            variant="quiet"
            :disabled="importBusy"
            @click="pasteImport" /><MobileButton
            label="预览内容"
            :loading="importBusy"
            @click="previewText" /></view></view
        ><template v-if="preview"
          ><view class="metrics ui-row ui-section"
            ><MetricCard label="可新增" :value="preview.newCount" /><MetricCard
              label="重复"
              :value="preview.duplicateCount" /><MetricCard
              label="错误"
              :value="issues.length" /></view
          ><FormField
            label="重复处理"
            kind="selector"
            v-model="policy"
            :options="['跳过重复', '覆盖重复']"
          /><view
            v-for="record in importRequest.records"
            :key="record.rowNumber"
            class="import-row ui-section ui-gap-sm"
            ><text class="library-content"
              >{{ record.rowNumber }} · {{ record.title }}</text
            ><text class="library-secondary"
               :class="{ 'record-secondary-dark': isDark }">{{
                preview.duplicates.some(
                  (item) => item.rowNumber === record.rowNumber,
                )
                  ? '重复'
                  : '新增'
              }}
              · {{ record.markedDate || '' }}</text
            ></view
          ></template
        ><text
          v-for="issue in issues"
          :key="issue.rowNumber + issue.message"
          class="library-error ui-section ui-type-body"
          >第{{ issue.rowNumber }}行：{{ issue.message }}</text
        ><text v-if="importError" class="library-error ui-section ui-type-body">{{ importError }}</text
        ><text v-if="importResult" class="library-content"
          >新增 {{ importResult.createdCount }} · 覆盖
          {{ importResult.updatedCount }} · 跳过
          {{ importResult.skippedCount }}</text
        ><template #footer><FormActions
          ><MobileButton
            label="关闭导入"
            variant="quiet"
            :disabled="importBusy"
            @click="importingOpen = false" /><MobileButton
            label="导入"
            :loading="importBusy"
            :disabled="!preview || !!issues.length || !!importResult"
            @click="submitImport" /></FormActions></template
      ></AdaptiveModal></ModalMotion> </view
    ><template #fixed
      ><FloatingActionButton
        :label="'新增' + title"
        :disabled="entryLoading"
        @click="open()" /></template
  ></MobilePage>
</template>
<style scoped lang="scss">
@use 'sass:math';
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body', 'label', 'title');

.library-page {
  position: relative;
  padding-bottom: 64px;
  color: #27272a;
}
.library-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.library-ranking { align-self: center; flex-direction: row; max-width: 100%; border-radius: 3px; background-color: #ffe298; }
.library-ranking-wrap { flex-wrap: wrap; justify-content: center; }
.library-rank, .library-rank-name { @include type-style('badge'); color: #624407; padding: 0 $space-detail; }
.library-rank { background-color: #ffd365; }
.library-rank-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.library-filter-options { flex-wrap: wrap; }
.library-filter-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: calc((100% - #{$space-inline}) / 2);
  min-height: $space-controlMin;
  margin: 0;
  padding: $space-detail $space-modal;
  border: 0;
  border-radius: 10px;
  background-color: #f0f2f5;
  @include borderless-button;
}
.library-filter-option-dark { background-color: #282b31; }
.library-filter-option-selected { background-color: #e3ecff; }
.library-filter-option-selected-dark { background-color: #2c3953; }
.library-filter-option-text {
  color: #27272a;
  text-align: center;
  @include type-style('body');
  @include wrap-long-text;
}
.library-filter-text-dark { color: #eeeeef; }
.library-filter-check { position: absolute; right: $space-detail; bottom: $space-detail; }
.library-filter-empty { min-height: $space-controlMin; justify-content: center; }
.metrics {
  flex-direction: row;
  flex-wrap: wrap;
}
.library-grid {
  flex-direction: row;
  flex-wrap: wrap;

}
.library-empty-loading {
  box-sizing: border-box;
  min-height: type-line('body') + $space-card * 2;
  align-items: center;
  justify-content: center;
}
.library-card {
  width: calc((100% - #{$space-section * 2}) / 3);

  box-sizing: border-box;
  min-width: 0;
}
.library-poster {
  $cover-width: 88%;
  position: relative;
  border-radius: 6px;
  overflow: hidden;
  background-color: #e6e9ed;
  align-self: center;
  width: $cover-width;
  padding-top: ($cover-width * math.div(4, 3));
}
.library-date {
  @include type-style('badge');

  text-align: center;
  color: $text-secondary-light;
}
.library-opening {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
  @include type-style('caption');
}
.library-link-row {
  flex-direction: row;
  align-items: center;
}
.library-link-field {
  flex: 1;
  min-width: 0;
}
/* #ifdef WEB */
.library-filter-option:focus-visible { outline: 2px solid #93b4fc; outline-offset: -2px; }
.library-poster:focus-visible { outline: 2px solid #427bea; outline-offset: $space-micro; }
/* #endif */
@media (min-width: 640px) {
  .library-card {
    width: calc((100% - #{$space-section * 3}) / 4);
  }
}
@media (min-width: 768px) {
  .library-card {
    width: calc((100% - #{$space-section * 4}) / 5);
  }
}
@media (min-width: 1200px) {
  .library-card {
    width: calc((100% - #{$space-section * 6}) / 7);
  }
}
.library-content {
  @include type-style('body');

}
.library-secondary {
  color: $text-secondary-light;
  @include type-style('label');
}
.library-error {
  color: #e05252;
}

.record-secondary-dark { color: $text-secondary-dark; }
</style>
