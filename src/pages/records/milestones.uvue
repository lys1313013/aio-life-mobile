<script setup lang="ts">
import { useAppLayout } from '../../services/app-layout.ts';
const { appWidthBelow } = useAppLayout();
import ModalMotion from "../../components/ModalMotion.uvue";
import { usePageRefresh } from '../../services/page-refresh.ts'
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onUnmounted, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import FilterTrigger from '../../components/FilterTrigger.uvue';
import FilterSheet from '../../components/FilterSheet.uvue';
import spacing from '../../styles/spacing.json';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isDark } from '../../services/theme.ts';
import { tagsText, tagsList } from '../../services/records/contracts.ts';
import { fetchEvents, saveEvent, deleteEvent } from './services/events.ts';
const modalMotion0 = ref<{ close: () => void } | null>(null);

const rows = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref('');
const types = ['life', 'study', 'work', 'other'],
  labels = ['生活', '学业', '工作', '其他'];
const filtersOpen = ref(false);
const defaultFilters = { type: '全部类型', tag: '全部标签', start: '', end: '' };
const filterDraft = ref({ ...defaultFilters });
const filterError = computed(() => filterDraft.value.start && filterDraft.value.end && filterDraft.value.start > filterDraft.value.end
  ? '开始日期不能晚于结束日期' : '');
const hasFilters = computed(() => typeFilter.value !== '全部类型' || tagFilter.value !== '全部标签' || !!start.value || !!end.value);
const typeFilter = ref('全部类型'),
  tagFilter = ref('全部标签'),
  start = ref(''),
  end = ref('');
const allTags = computed(() => [
  ...new Set(rows.value.flatMap((item) => item.tags || [])),
]);
const filtered = computed(() =>
  rows.value
    .filter(
      (item) =>
        (typeFilter.value === '全部类型' ||
          item.type === types[labels.indexOf(typeFilter.value)]) &&
        (tagFilter.value === '全部标签' ||
          (item.tags || []).includes(tagFilter.value)) &&
        (!start.value || item.date >= start.value) &&
        (!end.value || item.date <= end.value),
    )
    .slice()
    .sort((a, b) => b.date.localeCompare(a.date)),
);
const scope = createRecordScope((clearData) => {
  filtersOpen.value = false;
  form.value = null;
  if (clearData) rows.value = [];
});
let alive = true,
  generation = 0;
onUnmounted(() => {
  alive = false;
  generation++;
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['milestones'] })
onShow(() => refreshOnShow());
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    const data = await scope.wait(fetchEvents('milestone'));
    if (alive && current === generation) rows.value = data;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  formError.value = '';
  form.value = item
    ? { ...item, endDate: item.endDate || '', tags: tagsText(item.tags) }
    : {
        title: '',
        date: new Date().toLocaleDateString('sv-SE'),
        endDate: '',
        description: '',
        type: 'life',
        tags: '',
      };
}
async function save() {
  if (saving.value) return;
  if (missingRequired('milestone', form.value)) {
    formError.value = '请输入标题和日期';
    return;
  }
  if (form.value.endDate && form.value.endDate < form.value.date) {
    formError.value = '结束日期不能早于开始日期';
    return;
  }
  const payload = {
    ...form.value,
    title: form.value.title.trim(),
    endDate: form.value.endDate || null,
    tags: tagsList(form.value.tags),
  };
  saving.value = true;
  formError.value = '';
  try {
    const saved = await scope.wait(saveEvent('milestone', payload));
    const row = { ...payload, ...saved };
    const index = rows.value.findIndex((r) => r.id === row.id);
    if (index >= 0) rows.value[index] = row;
    else rows.value.push(row);
    form.value = null;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  await scope.wait(deleteEvent('milestone', item.id));
  rows.value = rows.value.filter((r) => r.id !== item.id);
}
function openFilters() {
  filterDraft.value = { type: typeFilter.value, tag: tagFilter.value, start: start.value, end: end.value };
  filtersOpen.value = true;
}
function applyFilters() {
  if (filterError.value) return;
  const draft = filterDraft.value;
  typeFilter.value = draft.type;
  tagFilter.value = draft.tag;
  start.value = draft.start;
  end.value = draft.end;
  filtersOpen.value = false;
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)"
    ><view class="event-page ui-page-body" :class="{ 'event-page-dark': isDark }"
      ><PageHeader title="里程碑" back :actions-min-width="spacing.controlMin" @back="uni.navigateBack()">
        <template #actions>
          <FilterTrigger label="筛选里程碑" :open="filtersOpen" :active="hasFilters" @click="openFilters" />
        </template>
      </PageHeader>
      <FilterSheet :open="filtersOpen" :error="filterError" @close="filtersOpen = false"
        @reset="filterDraft = { ...defaultFilters }" @apply="applyFilters">
        <FormField label="类型" kind="selector" v-model="filterDraft.type" :options="[defaultFilters.type, ...labels]" />
        <FormField label="标签" kind="selector" v-model="filterDraft.tag" :options="[defaultFilters.tag, ...allTags]" />
        <view class="ui-field-row">
          <FormField compact stretch label="开始日期" placeholder="开始日期" kind="date" v-model="filterDraft.start" />
          <FormField compact stretch label="结束日期" placeholder="结束日期" kind="date" v-model="filterDraft.end" />
        </view>
      </FilterSheet>
      <PageState skeleton="timeline" :loading="loading" :error="error" :empty="!filtered.length" @retry="load()">
<template #loading><view v-for="n in 3" :key="n" class="timeline-entry" :class="{ 'timeline-entry-dark': isDark }"><view class="timeline-dot" :class="{ 'timeline-dot-dark': isDark }" /><view class="event-card ui-card" :class="{ 'event-card-dark': isDark }"><ContentSkeleton variant="tile" /></view></view></template>

        <template v-for="(item, index) in filtered" :key="item.id"
          ><text
            v-if="index === 0 || item.date.slice(0, 4) !== filtered[index - 1].date.slice(0, 4)"
            class="year-title ui-section"
            >{{ item.date.slice(0, 4) }}年</text
          ><text v-if="index === 0 || item.date.slice(0, 7) !== filtered[index - 1].date.slice(0, 7)" class="month-title">{{ item.date.slice(5, 7) }}月</text>
          <view class="timeline-entry" :class="{ 'timeline-entry-dark': isDark }">
            <view class="timeline-dot" :class="['dot-' + item.type, { 'timeline-dot-dark': isDark }]" />
            <view class="event-card ui-card" :class="{ 'event-card-dark': isDark }" role="button" :aria-label="'编辑里程碑：' + item.title" tabindex="0" @click="open(item)" @keydown.enter.self="open(item)" @keydown.space.self.prevent="open(item)"
            ><view class="toolbar ui-row"
              ><text class="event-title">{{ item.title }}</text><text class="type-badge" :class="'badge-' + item.type">{{ labels[types.indexOf(item.type)] || item.type }}</text
              ></view
            ><text class="event-secondary"
              :class="{ 'secondary-text-dark': isDark }">{{ item.date }}{{ item.endDate ? ' → ' + item.endDate : '' }}</text
            ><text v-if="item.description" class="event-content">{{ item.description }}</text
            ><view v-if="item.tags && item.tags.length" class="event-tags"><text v-for="tag in item.tags" :key="tag" class="event-tag" :class="{ 'secondary-text-dark': isDark }">{{ tag }}</text></view></view></view
          ></template
        > </PageState
      ><ModalMotion><AdaptiveModal ref="modalMotion0" v-if="form" label="编辑里程碑" :busy="saving" @close="form = null"
        ><FormField :required="isRequired('milestone', 'title')" label="标题" v-model="form.title" /><view class="ui-field-row" :class="{ 'milestone-dates-with-clear': !!form.endDate, 'milestone-dates-stacked': !!form.endDate && appWidthBelow(480) }">
          <FormField compact stretch
          label="开始日期" :required="isRequired('milestone', 'date')"
          kind="date"
          v-model="form.date" />
          <view class="milestone-end-date">
            <FormField compact stretch label="结束日期" kind="date" v-model="form.endDate" />
            <MobileButton v-if="form.endDate" class="milestone-end-clear" label="清空结束日期" icon="ant-design:close-outlined"
              variant="quiet" @click="form.endDate = ''" />
          </view>
        </view><view class="ui-field-row">
          <FormField compact stretch
          label="类型"
          kind="selector"
          :model-value="labels[types.indexOf(form.type)] || form.type"
          :options="labels"
          @update:model-value="form.type = types[labels.indexOf($event)]" />
          <FormField compact stretch label="标签" placeholder="多个标签用逗号分隔" v-model="form.tags" />
        </view><FormField
          label="描述"
          kind="textarea" textarea-size="compact"
          v-model="form.description" /><text
          v-if="formError"
          class="event-error ui-section ui-type-body"
          >{{ formError }}</text
        ><template #footer><FormActions>
          <template #secondary><ConfirmAction v-if="form.id" label="删除里程碑" :action="() => remove(form)" @success="form = null" /></template>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving"
            @click="modalMotion0?.close()" /><MobileButton
            label="保存"
            :loading="saving"
            @click="save" />
        </FormActions></template></AdaptiveModal></ModalMotion></view
  ><template #fixed><FloatingActionButton label="新增里程碑" :disabled="loading || !!error" @click="open()" /></template></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.event-page {
  padding-bottom: 80px; /* 浮动新增按钮避让 */
  color: #27272a;
}
.event-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.event-card {
  background-color: #ffffff;
  border-radius: 16px;
}
.event-card-dark {
  background-color: #1c1e22;
}
.event-title {
  flex: 1;
  @include type-style('title');

}
.year-title {
  @include type-style('heading');

}
.event-content {
  @include type-style('body');

}
.event-secondary {
  color: $text-secondary-light;
  @include type-style('label');
}
.event-error {
  color: #e05252;
}
.timeline-entry { position: relative; overflow: visible; margin-left: $space-inline; padding-left: $space-modal; border-left: $space-hairline solid #dfe3e9; }
.month-title { margin-left: calc($space-inline + $space-modal); color: #5986db; @include type-style('caption-strong');  margin-bottom: $space-section; }
.timeline-dot { position: absolute; top: 22px; left: -$space-detail; width: 9px; height: 9px; border-radius: 5px; background-color: #5986db; border: 2px solid #ffffff; }
.dot-work { background-color: #77be7b; } .dot-life { background-color: #5986db; } .dot-study { background-color: #bd8ee2; }
.type-badge { @include type-style('badge'); color: #5986db; background-color: rgba(89,134,219,0.12); padding: $space-micro $space-detail; border-radius: 4px; }
.badge-work { color: #72a851; background-color: rgba(114,168,81,0.12); }
.badge-study { color: #ac7bd1; background-color: rgba(172,123,209,0.12); }
.event-card { border-radius: 10px; }
.event-title { min-width: 0; @include type-style('title');  }
.event-tags { flex-direction: row; flex-wrap: wrap; gap: $space-detail; }
.event-tag { color: $text-secondary-light; background-color: rgba(128, 138, 153, 0.1); border-radius: 4px; padding: $space-micro $space-detail; @include type-style('badge'); }
.event-card { min-height: $space-controlMin; }
.event-content {
@include wrap-long-text;
 }
.type-badge { flex-shrink: 0; }
.timeline-entry-dark { border-color: #343840; }
.timeline-dot-dark { border-color: #1c1e22; }
/* #ifdef WEB */
.event-card:focus-visible { outline: 2px solid #417ce8; outline-offset: 2px; }
/* #endif */

.secondary-text-dark { color: $text-secondary-dark; }
.milestone-end-date { flex: 1; min-width: 0; flex-direction: row; align-items: flex-end; gap: $space-detail; }
/* #ifdef APP */
.milestone-dates-stacked { flex-direction: column; }
.milestone-end-clear { margin-left: $space-detail; }
/* #endif */
@media (max-width: 479px) {
  .milestone-dates-with-clear { flex-direction: column; }
}
</style>
