<script setup lang="ts">
import { readPageTotal, mergePageItems, hasMorePageItems } from '../../services/pagination.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { useWindowResize } from '../../services/window-resize.ts'
useWindowResize(resizeNotes)
import ThoughtForm from '../../components/ThoughtForm.uvue';
import { missingRequired } from '../../services/form-required.ts';
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onUnmounted, ref } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import LoadMore from '../../components/LoadMore.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import NoteEditor from './NoteEditor.uvue';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isDark } from '../../services/theme.ts';
import { fetchNotes, saveNote, deleteNote, fetchNoteById, fetchMemoById } from './services/notes.ts';
const kind = ref('think'),
  title = computed(() => (kind.value === 'think' ? '闪念' : '笔记'));
const rows = ref<any[]>([]),
  page = ref(1),
  total = ref<number | null>(null),
  keyword = ref(''),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  revealing = ref('');
const windowWidth = ref(uni.getWindowInfo().windowWidth);
const noteColumnCount = computed(() => kind.value === 'memo' && windowWidth.value >= 1000 ? 3 : 2);
const noteColumns = computed(() => {
  // 与 Web 一样按顺序分列；追加分页不会移动已有卡片。
  const count = noteColumnCount.value;
  const columns: any[][] = Array.from({ length: count }, () => []);
  rows.value.forEach((item, index) => columns[index % count].push(item));
  return columns;
});
function resizeNotes() {
  windowWidth.value = uni.getWindowInfo().windowWidth;
}

const created = ref(false);
const form = ref<any>(null),
  saving = ref(false),
  formError = ref('');
const scope = createRecordScope((clearData) => {
  form.value = null;
  if (clearData) {
    rows.value = [];
    total.value = null;
    created.value = false;
    requestedEdit = '';
    requestedCreate = false;
  }
});
let requestedEdit = '';
let requestedCreate = false;
let alive = true,
  generation = 0;
onLoad((options) => {
  kind.value = options?.kind === 'memo' ? 'memo' : 'think';
  requestedEdit = String(options?.id || options?.editId || '');
  requestedCreate = options?.create === '1';
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['memo', 'thought'] })
onShow(() => refreshOnShow());
onUnmounted(() => {
  alive = false;
  generation++;
});
const moreError = ref(''), pageEnded = ref(false);
function loadMore() {
  if (loading.value || error.value || moreError.value) return;
  load(false, true);
}
async function load(refresh = false, more = false) {
  if (more && (loading.value || !rows.value.length || !hasMorePageItems(rows.value.length, total.value, pageEnded.value))) return;
  const current = ++generation,
    nextPage = more ? page.value + 1 : 1;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  moreError.value = '';
  try {
    const data = await scope.wait(fetchNotes(kind.value, nextPage, keyword.value.trim()));
    if (alive && current === generation) {
      const nextTotal = readPageTotal(data.total);
      rows.value = mergePageItems(more ? rows.value : [], data.items);
      pageEnded.value = !data.items.length;
      total.value = nextTotal;
      page.value = nextPage;
      if (requestedEdit) {
        const selected = kind.value === 'memo'
          ? await scope.wait(fetchMemoById(requestedEdit))
          : (await scope.wait(fetchNoteById(requestedEdit))).items[0];
        if (!alive || current !== generation) return;
        if (!selected) throw new Error('记录不存在或已删除');
        open(selected);
        requestedEdit = '';
      } else if (requestedCreate) {
        requestedCreate = false;
        open();
      }
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (alive && current === generation) (more ? moreError : error).value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  created.value = false;
  formError.value = '';
  form.value = item
    ? { ...item, events: (item.events || []).map((event) => ({ ...event })) }
    : { title: '', content: '', hiddenContent: false, isPinned: 0, events: [] };
}
async function save() {
  if (saving.value) return;
  if (missingRequired(kind.value === 'memo' ? 'memo' : 'thought', form.value)) {
    formError.value = kind.value === 'memo' ? '请输入标题和内容' : '请输入内容';
    return;
  }
  const payload = {
    ...form.value,
    content: form.value.content.trim(),
    events: form.value.events
      .filter((event) => event.content.trim())
      .map((event) => ({ ...event, content: event.content.trim() })),
  };
  saving.value = true;
  formError.value = '';
  try {
    if (!created.value) {
      await scope.wait(saveNote(kind.value, payload));
      created.value = true;
    }
    if (payload.id) {
      const selected =
        kind.value === 'think' ? (await scope.wait(fetchNoteById(payload.id))).items[0] : payload;
      if (!selected) throw Error('保存成功，请重试读取');
      const index = rows.value.findIndex((row) => row.id === payload.id);
      if (index >= 0) rows.value[index] = selected;
    } else {
      const data = await scope.wait(fetchNotes(kind.value, 1, keyword.value.trim()));
      const nextTotal = readPageTotal(data.total);
      rows.value = mergePageItems([], data.items);
      page.value = 1;
      pageEnded.value = !data.items.length;
      total.value = nextTotal;
    }
    form.value = null;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function reveal(item) {
  if (revealing.value || !item.hiddenContent) return;
  revealing.value = item.id;
  try {
    await scope.wait(saveNote(kind.value, { id: item.id, hiddenContent: false }));
    item.hiddenContent = false;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    uni.showToast({ title: e.message || '显示失败，请重试', icon: 'none' });
  } finally {
    revealing.value = '';
  }
}
async function remove(item) {
  await scope.wait(deleteNote(kind.value, item.id));
  rows.value = rows.value.filter((row) => row.id !== item.id);
  if (total.value != null) total.value = Math.max(0, total.value - 1);
}
function displayDate(value) {
  if (kind.value !== 'memo') return String(value || '').slice(0, 16);
  const timestamp = new Date(String(value || '').replace(' ', 'T')).getTime();
  if (!Number.isFinite(timestamp)) return '';
  const days = Math.max(0, Math.floor((Date.now() - timestamp) / 86400000));
  return days < 1 ? '今天' : days < 30 ? days + ' 天前' : days < 365 ? Math.floor(days / 30) + ' 个月前' : Math.floor(days / 365) + ' 年前';
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)" @reachbottom="loadMore"
    ><view class="notes-page ui-page-body" :class="{ 'notes-page-dark': isDark }">
      <PageHeader :title="title" :back="true" @back="uni.navigateBack()" /><view class="ui-toolbar"
        ><FormField compact stretch hide-label label="搜索内容" placeholder="搜索内容…" v-model="keyword" /><MobileButton
          label="搜索"
          icon="ant-design:search-outlined"
          :loading="loading"
          @click="load()"
      /></view>
      <PageState skeleton="list"
        :loading="loading && !rows.length"
        :error="error"
        :empty="!rows.length"
        @retry="load()"
      >
<template #loading>
          <view class="notes-grid">
            <view v-for="column in noteColumnCount" :key="column" class="notes-column">
              <view v-for="n in 3" :key="n" class="note-card ui-card" :class="{ 'note-card-dark': isDark }"><ContentSkeleton variant="tile" /></view>
            </view>
          </view>
        </template>

        <view class="notes-grid"><view
          v-for="(column, columnIndex) in noteColumns"
          :key="columnIndex"
          class="notes-column"
        ><view
          v-for="item in column"
          :key="item.id"
          class="note-card ui-card"
          :class="{ 'note-card-dark': isDark }"
          role="button" :aria-label="'编辑' + title + (!item.hiddenContent && item.title ? '：' + item.title : '')" tabindex="0" @click="open(item)" @keydown.enter.self="open(item)" @keydown.space.self.prevent="open(item)"
        >
          <view
            class="note-preview"
            :class="{ 'note-preview-hidden': kind === 'memo' && item.hiddenContent }"
            :aria-hidden="item.hiddenContent ? 'true' : 'false'"
          >
            <view class="note-preview-text" :class="{ 'note-preview-blurred': kind === 'memo' && item.hiddenContent }">
              <text :max-lines="2" v-if="kind === 'memo' && item.title" class="note-title">{{ item.title }}</text>
              <text :max-lines="8" v-if="kind === 'memo' || !item.hiddenContent" class="note-content" :class="{ 'note-content-memo': kind === 'memo' }">{{ item.content }}</text>
              <text v-else class="note-secondary" :class="{ 'secondary-text-dark': isDark }">••••••</text>
            </view>
            <view v-if="kind === 'memo' && item.hiddenContent" class="note-frost" :class="{ 'note-frost-dark': isDark }" />
          </view>
          <view class="note-footer ui-row">
            <AppIcon v-if="kind === 'think' && item.isPinned === 1" name="ant-design:pushpin-filled" :size="13" color="#6989bc" aria-label="已展示到看板" /><text class="note-date" :class="{ 'secondary-text-dark': isDark }">{{ displayDate(item.updateTime || item.createTime) }}</text>
            <view v-if="kind === 'think' && (item.events || []).length" class="note-event-count"><AppIcon name="ant-design:link-outlined" :size="12" color="#8b8f99" /><text class="note-event-value ui-type-badge" :class="{ 'secondary-text-dark': isDark }">{{ item.events.length }}</text></view>
            <button v-if="item.hiddenContent" class="note-visibility ui-type-body" role="button" aria-label="显示内容" :loading="revealing === item.id" :disabled="!!revealing" @click.stop="reveal(item)" @keydown.enter.stop @keydown.space.stop>
              <AppIcon v-if="revealing !== item.id" name="ant-design:eye-outlined" :size="16" color="#8b8f99" />
            </button>
          </view>
        </view></view></view> </PageState
      ><LoadMore :error="moreError" :loading="loading" :has-more="hasMorePageItems(rows.length, total, pageEnded)" @load="load(false, true)" />
      <NoteEditor v-if="form && kind === 'memo'" :form="form" :saving="saving" :created="created" :error="formError" :remove="async () => { await remove(form); form = null; }" @save="save" @close="form = null" />
      <AdaptiveModal v-if="form && kind === 'think'" :label="form.id ? '编辑闪念' : '新增闪念'" :max-width="560" :busy="saving" :content-key="JSON.stringify([form.events.length, formError])" @close="form = null">
        <ThoughtForm :form="form" :editing="!!form.id" :disabled="saving || created" :error="formError">
          <template #secondary>
            <ConfirmAction v-if="form.id" label="删除闪念" :action="async () => { await remove(form); form = null; }">
              <template #default="{ open, busy: deleting }"><MobileButton label="删除闪念" icon="ant-design:delete-outlined" variant="ghost" :disabled="saving || created" :loading="deleting" @click="open" /></template>
            </ConfirmAction>
          </template>
          <MobileButton label="取消" variant="quiet" :disabled="saving" @click="form = null" />
          <MobileButton :label="created && !saving ? '重新读取' : '保存'" :loading="saving" @click="save" />
        </ThoughtForm>
      </AdaptiveModal> </view>
    <template #fixed><FloatingActionButton :label="'新增' + title" @click="open()" /></template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('badge', 'body');

.notes-page {
  padding-bottom: 80px; /* 浮动新增按钮避让 */
  color: #27272a;
}
.notes-page-dark {
  color: #eeeeef;
}
.notes-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-section; align-items: flex-start; }
.note-card { width: 100%; min-width: 0; box-sizing: border-box; }
.notes-column { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: $space-section; }
.note-preview { position: relative; overflow: hidden; border-radius: 6px; }
.note-preview-text { display: flex; flex-direction: column; gap: $space-inline; }
.note-preview-hidden { user-select: none; }
.note-preview-blurred { opacity: 0; }
.note-frost {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background-color: rgba(255, 255, 255, 0.2);
  pointer-events: none;
}
.note-frost-dark { background-color: rgba(28, 30, 34, 0.2); }
/* #ifdef WEB || MP-WEIXIN */
.note-preview-blurred {
  opacity: 0.45;
  filter: blur(7px);
  pointer-events: none;
  user-select: none;
  // 柔化文字轮廓的边缘，避免出现一块被裁切的矩形磨砂贴片。
  -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, rgba(0, 0, 0, 0.7) 70%, transparent 100%);
  mask-image: radial-gradient(ellipse at center, #000 35%, rgba(0, 0, 0, 0.7) 70%, transparent 100%);
}
.note-frost {
  background: radial-gradient(ellipse at 35% 25%, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.08) 75%);
}
.note-frost-dark {
  background: radial-gradient(ellipse at 35% 25%, rgba(28, 30, 34, 0.35), rgba(28, 30, 34, 0.08) 75%);
}
/* #endif */
.note-footer { align-items: center; justify-content: space-between; gap: $space-detail; margin-top: $space-inline; }
.note-card {
  margin: 0;
  background-color: #ffffff;
  border-radius: 10px;
}
.note-card-dark {
  background-color: #1c1e22;
}
.note-title {
  flex: 1;
  @include type-style('body-strong');

/* #ifndef APP */
display: -webkit-box;
/* #endif */
/* #ifdef APP */
text-overflow: ellipsis;
/* #endif */

/* #ifndef APP */
-webkit-line-clamp: 2;
/* #endif */

/* #ifndef APP */
-webkit-box-orient: vertical;
/* #endif */

  overflow: hidden;
}
.note-content {
  @include type-style('body');

  white-space: pre-wrap;

/* #ifndef APP */
word-break: break-word;
/* #endif */
/* #ifdef APP */
word-break: break-all;
/* #endif */

/* #ifndef APP */
display: -webkit-box;
/* #endif */
/* #ifdef APP */
text-overflow: ellipsis;
/* #endif */

/* #ifndef APP */
-webkit-line-clamp: 8;
/* #endif */

/* #ifndef APP */
-webkit-box-orient: vertical;
/* #endif */

  overflow: hidden;
}
.note-content-memo {
/* #ifndef APP */
-webkit-line-clamp: 10;
/* #endif */
 }
.note-event-value { @include type-style('badge'); color: $text-secondary-light; }
.note-secondary {
  color: $text-secondary-light;
  @include type-style('label');
  flex: 1;
}
.note-date { flex: 1; min-width: 0; color: $text-secondary-light; @include type-style('badge');  }
.note-event-count { flex-direction: row; align-items: center; gap: $space-micro; color: $text-secondary-light; @include type-style('badge'); }
.note-visibility { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: $space-controlMin; height: $space-controlMin; margin: (-$space-inline) (-$space-inline) (-$space-inline) 0; padding: 0; border: 0; background-color: transparent; }
.note-title {
/* #ifndef APP */
word-break: break-word;
/* #endif */
/* #ifdef APP */
word-break: break-all;
/* #endif */
 }
/* #ifdef WEB || MP-WEIXIN */
.note-visibility::after { border: 0; }
.note-card:focus-visible { outline: 2px solid #417ce8; outline-offset: 2px; }
/* #endif */

.secondary-text-dark { color: $text-secondary-dark; }
</style>
