<script setup lang="ts">
import { appTextColor, useAppLayout } from '../../services/app-layout.ts'

import { buttonLabelClasses } from '../../services/button-label.ts'
import { isRequired, missingRequired } from '../../services/form-required.ts';
import AppIcon from '../../components/AppIcon.uvue';
import { computed, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import MiniChart from '../../components/MiniChart.uvue';
import { isDark } from '../../services/theme.ts';
import { dateLabel, parseDate } from '../../services/time-format.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isMobileBrowser, wereadAppLink, wereadBrowserLink, wereadWebLink } from './services/weread-links.ts';
// #ifdef APP-ANDROID
import { openWereadBook, openWereadWeb } from '../../uni_modules/aio-weread-launcher';
// #endif
import {
  fetchWereadConnection,
  connectWeread,
  disconnectWeread,
  syncWeread,
  fetchWereadStats,
  fetchWereadNotes,
  fetchWereadProgress,
  fetchWereadBookLink,
} from './services/weread.ts';
const connection = ref<any>({ connected: false }),
  snapshot = ref<any>(null),
  stats = ref<any>({}),
  loading = ref(false),
  syncing = ref(false),
  error = ref(''),
  tab = ref('阅读看板'),
  mode = ref('年'),
  date = ref(dateLabel(new Date())),
  statsLoading = ref(false),
  settings = ref(false),
  keyInput = ref(''),
  saving = ref(false),
  settingsError = ref(''),
  keyword = ref(''),
  status = ref('全部图书'),
  sort = ref('最近阅读'),
  detail = ref<any>(null),
  progress = ref<any>(null),
  detailLoading = ref(false),
  detailError = ref(''),
  selectedBook = ref(''),
  notes = ref<any>(null),
  notesLoading = ref(false),
  notesError = ref(''),
  noteKind = ref('划线'),
  noteQuery = ref(''),
  copyError = ref('');
const openingBooks = ref<Record<string, boolean>>({});
const bookLinks = ref<Record<string, string>>({});
const bookLinkErrors = ref<Record<string, string>>({});
const showWebFallback = ref<Record<string, boolean>>({});
function bookLink(book) {
  return wereadWebLink(book?.deepLink) || bookLinks.value[book?.bookId] || '';
}
async function openRankBook(book) {
  if (!book || openingBooks.value[book.bookId]) return;
  const scheme = wereadAppLink(book.bookId);
  // #ifdef WEB
  if (scheme && isMobileBrowser(navigator.userAgent, navigator.maxTouchPoints)) {
    showWebFallback.value[book.bookId] = true;
    window.location.assign(wereadBrowserLink(book.bookId, navigator.userAgent, bookLink(book)));
    return;
  }
  // #endif
  // #ifdef APP-ANDROID
  if (scheme) {
    showWebFallback.value[book.bookId] = true;
    bookLinkErrors.value[book.bookId] = '';
    if (!openWereadBook(book.bookId)) {
      bookLinkErrors.value[book.bookId] = '无法打开微信读书，可使用网页版阅读';
    }
    return;
  }
  // #endif
  await openWebBook(book);
}
async function openWebBook(book) {
  if (!book || openingBooks.value[book.bookId]) return;
  bookLinkErrors.value[book.bookId] = '';
  const link = bookLink(book);
  if (link) { openLink(link); return; }
  if (!book.bookId) return;
  const id = book.bookId;
  openingBooks.value[id] = true;
  bookLinkErrors.value[id] = '';
  // #ifdef WEB
  const target = window.open('about:blank', '_blank');
  if (target) target.opener = null;
  // #endif
  try {
    const result = await scope.wait(fetchWereadBookLink(id));
    const resolved = bookLink(result);
    if (!resolved) throw new Error('暂无可用链接，点击重试');
    bookLinks.value[id] = resolved;
    // #ifdef WEB
    if (target && !target.closed) target.location.replace(resolved);
    else bookLinkErrors.value[id] = '链接已就绪，请再次点击打开';
    // #endif
    // #ifndef WEB
    openLink(resolved);
    // #endif
  } catch (e) {
    // #ifdef WEB
    target?.close();
    // #endif
    if (e.name !== 'PageInactiveError') bookLinkErrors.value[id] = e.message || '打开失败，点击重试';
  } finally {
    openingBooks.value[id] = false;
  }
}
const { appGridItem } = useAppLayout();
const modes = { 周: 'weekly', 月: 'monthly', 年: 'annually', 累计: 'overall' };
const disconnecting = ref(false);
let generation = 0,
  statsRevision = 0,
  detailRevision = 0,
  notesRevision = 0,
  appliedMode = '年',
  appliedDate = date.value;
const scope = createRecordScope((clear) => {
  settings.value = false;
  keyInput.value = '';
  detail.value = null;
  detailRevision++;
  notesRevision++;
  if (clear) {
    connection.value = { connected: false };
    snapshot.value = null;
    stats.value = {};
    notes.value = null;
    selectedBook.value = '';
    bookLinks.value = {};
    bookLinkErrors.value = {};
    showWebFallback.value = {};
  }
});
onShow(() => initialize());
const notebooks = computed(() => snapshot.value?.notebooks?.books || []);
const notebookMap = computed(() => new Map(notebooks.value.map((notebook) => [notebook.bookId, notebook])));
const books = computed(() =>
  [...(snapshot.value?.shelf?.books || [])]
    .filter(
      (book) =>
        (book.title + ' ' + (book.author || ''))
          .toLowerCase()
          .includes(keyword.value.toLowerCase()) &&
        (status.value === '全部图书' ||
          (status.value === '已读完' && book.finishReading === 1) ||
          (status.value === '未读完' && book.finishReading !== 1) ||
          (status.value === '有笔记' && notebooks.value.some((n) => n.bookId === book.bookId))),
    )
    .sort(
      sort.value === '书名排序'
        ? (a, b) => a.title.localeCompare(b.title, 'zh-CN')
        : (a, b) => (b.readUpdateTime || 0) - (a.readUpdateTime || 0),
    ),
);
const trend = computed(() =>
  Object.entries(stats.value.readTimes || {})
    .sort((a, b) => Number(a[0]) - Number(b[0]))
    .map(([time, value]) => ({
      label: readingPeriod(time),
      value: Math.round(Number(value) / 60),
    })),
);
const noteItems = computed(() => {
  if (!notes.value) return [];
  const chapters = new Map((notes.value.marks?.chapters || []).map((c) => [c.chapterUid, c.title]));
  const reviews = notes.value.reviews || [];
  const items =
    noteKind.value === '划线'
      ? (notes.value.marks?.updated || []).map((mark) => ({
          id: mark.bookmarkId,
          text: mark.markText,
          chapter: chapters.get(mark.chapterUid) || '划线',
          time: mark.createTime,
          thought: reviews
            .filter(
              (r) =>
                r.review.type === 1 &&
                mark.range != null &&
                r.review.chapterUid === mark.chapterUid &&
                r.review.range === mark.range,
            )
            .map((r) => r.review.content)
            .join('\n'),
        }))
      : reviews
          .filter((r) => (noteKind.value === '想法' ? r.review.type === 1 : r.review.type !== 1))
          .map(({ review: r }) => ({
            id: r.reviewId,
            text: r.abstract || '',
            thought: r.content || '',
            chapter: r.chapterName || '书评',
            time: r.createTime,
          }));
  return items.filter((item) =>
    (item.text + ' ' + item.thought).toLowerCase().includes(noteQuery.value.toLowerCase()),
  );
});
// 原生运行时的 locale 参数支持不同，显式按上海时区生成短标签。
function readingPeriod(seconds) {
  const day = new Date((Number(seconds) + 8 * 60 * 60) * 1000);
  const year = day.getUTCFullYear(), month = day.getUTCMonth() + 1;
  return mode.value === '年' ? month + '月'
    : mode.value === '累计' ? year + '年'
      : month + '/' + day.getUTCDate();
}
function readingTime(seconds) {
  if (seconds == null) return '—';
  const minutes = Math.floor(Math.max(0, Number(seconds)) / 60);
  const hours = Math.floor(minutes / 60);
  return hours ? hours + '小时' + (minutes % 60 ? minutes % 60 + '分' : '') : minutes + '分钟';
}
function readingDate(seconds) {
  return seconds ? new Date(Number(seconds) * 1000).toLocaleString('zh-CN') : '—';
}
function safeLink(url) {
  return typeof url === 'string' && /^https?:\/\//.test(url) ? url : '';
}
async function initialize() {
  const current = ++generation;
  loading.value = true;
  error.value = '';
  try {
    const result = await scope.wait(fetchWereadConnection());
    if (current !== generation) return;
    connection.value = result;
    if (result.connected && !snapshot.value) await refresh();
  } catch (e) {
    if (e.name !== 'PageInactiveError') error.value = e.message;
  } finally {
    if (current === generation) loading.value = false;
  }
}
async function refresh() {
  if (syncing.value || saving.value) return;
  syncing.value = true;
  error.value = '';
  try {
    const result = await scope.wait(syncWeread(modes[mode.value], timestamp()));
    snapshot.value = result;
    stats.value = result.stats || {};
    connection.value.lastSyncTime = result.lastSyncTime;
    notesRevision++;
    notes.value = null;
    selectedBook.value = '';
  } catch (e) {
    if (e.name !== 'PageInactiveError') error.value = e.message;
  } finally {
    syncing.value = false;
  }
}
function timestamp() {
  if (mode.value === '累计') return 0;
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date.value) || dateLabel(parseDate(date.value)) !== date.value)
    throw new Error('请选择有效日期');
  const [year, month, day] = date.value.split('-').map(Number);
  // Android 的本地化日期与字符串解析存在差异；按上海时区零点生成秒时间戳。
  return Math.floor((Date.UTC(year, month - 1, day) - 8 * 60 * 60 * 1000) / 1000);
}
async function changeMode() {
  if (statsLoading.value || syncing.value) return;
  const current = ++statsRevision;
  statsLoading.value = true;
  error.value = '';
  try {
    if (date.value > dateLabel(new Date()))
      throw new Error('请选择当前或过去的日期');
    const result = await scope.wait(fetchWereadStats(modes[mode.value], timestamp()));
    if (current === statsRevision) {
      stats.value = result;
      appliedMode = mode.value;
      appliedDate = date.value;
    }
  } catch (e) {
    if (e.name !== 'PageInactiveError') {
      error.value = e.message;
      mode.value = appliedMode;
      date.value = appliedDate;
    }
  } finally {
    if (current === statsRevision) statsLoading.value = false;
  }
}
async function saveConnection() {
  if (saving.value || disconnecting.value) return;
  if (missingRequired('weread', { keyInput: keyInput.value }) || !/^wrk-[\w-]+$/.test(keyInput.value.trim())) {
    settingsError.value = '请输入有效的微信读书 Key';
    return;
  }
  saving.value = true;
  settingsError.value = '';
  try {
    const result = await scope.wait(connectWeread(keyInput.value.trim()));
    connection.value = result;
    snapshot.value = null;
    stats.value = {};
    notes.value = null;
    detail.value = null;
    selectedBook.value = '';
    keyInput.value = '';
    settings.value = false;
    saving.value = false;
    await refresh();
  } catch (e) {
    if (e.name !== 'PageInactiveError') settingsError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function disconnect() {
  if (saving.value || disconnecting.value) return;
  disconnecting.value = true;
  try {
    await scope.wait(disconnectWeread());
    connection.value = { connected: false };
    snapshot.value = null;
    stats.value = {};
    notes.value = null;
    detail.value = null;
    selectedBook.value = '';
    settings.value = false;
    keyInput.value = '';
    notesRevision++;
    detailRevision++;
  } finally {
    disconnecting.value = false;
  }
}
async function showBook(book) {
  const current = ++detailRevision;
  detail.value = book;
  progress.value = null;
  detailLoading.value = true;
  detailError.value = '';
  try {
    const result = await scope.wait(fetchWereadProgress(book.bookId));
    if (current === detailRevision && detail.value?.bookId === book.bookId) progress.value = result;
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === detailRevision) detailError.value = e.message;
  } finally {
    if (current === detailRevision) detailLoading.value = false;
  }
}
async function selectNotebook(id) {
  const current = ++notesRevision;
  if (selectedBook.value !== id) notes.value = null;
  selectedBook.value = id;
  notesLoading.value = true;
  notesError.value = '';
  noteQuery.value = '';
  try {
    const result = await scope.wait(fetchWereadNotes(id));
    if (current === notesRevision) notes.value = result;
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === notesRevision) notesError.value = e.message;
  } finally {
    if (current === notesRevision) notesLoading.value = false;
  }
}
function showNotes() {
  const id = detail.value.bookId;
  detailRevision++;
  detail.value = null;
  tab.value = '阅读笔记';
  selectNotebook(id);
}
function copy(text) {
  copyError.value = '';
  uni.setClipboardData({
    data: text,
    fail: () => {
      copyError.value = '复制失败，可长按选择文本';
    },
  });
}
function openLink(url) {
  if (!safeLink(url)) return;
  // #ifdef WEB
  window.open(url, '_blank', 'noopener,noreferrer');
  // #endif
  // #ifdef APP-ANDROID
  if (!openWereadWeb(url)) uni.showToast({ title: '无法打开链接', icon: 'none' });
  // #endif
  // #ifdef APP-IOS
  plus.runtime.openURL(url);
  // #endif
  // #ifdef MP-WEIXIN
  uni.setClipboardData({ data: url });
  // #endif
}
</script>
<template>
  <MobilePage :refreshing="syncing || loading" @refresh="connection.connected ? refresh() : initialize()"
    ><view class="weread-page ui-page-body" :class="{ 'weread-page-dark': isDark }"
      ><PageHeader title="微信读书" :back="true" @back="uni.navigateBack()" /><view class="ui-toolbar"
        ><MobileButton
          label="连接设置"
          icon="ant-design:setting-outlined"
          variant="quiet"
          :disabled="syncing || statsLoading"
          @click="settings = true"
        /></view
      ><PageState skeleton="media" :loading="loading" :error="error" @retry="connection.connected ? refresh() : initialize()"
        ><MobileButton
          v-if="!connection.connected"
          label="连接微信读书"
          @click="settings = true"
        /><template v-if="snapshot"
          ><view class="weread-tabs ui-row ui-section"><button v-for="label in ['阅读看板', '我的书架', '阅读笔记']" :key="label" role="button" class="weread-tab" :class="{ 'weread-tab-dark': isDark, 'weread-tab-active': tab === label }" :aria-pressed="tab === label" @click="tab = label"><text :class="buttonLabelClasses(['weread-tab', { 'weread-tab-dark': isDark, 'weread-tab-active': tab === label }])">{{ label }}</text></button></view><view v-if="tab === '阅读看板'"
            ><view class="toolbar dashboard-filters ui-row ui-section"
              ><view class="dashboard-filter"><FormField compact
                label="周期"
                kind="selector"
                v-model="mode"
                :options="['周', '月', '年', '累计']"
                :disabled="statsLoading || syncing"
                @update:model-value="changeMode" /></view><view v-if="mode !== '累计'" class="dashboard-filter dashboard-date"><FormField compact
                label="统计日期"
                kind="date"
                v-model="date"
                :disabled="statsLoading || syncing"
                @update:model-value="changeMode" /></view></view
            ><view class="metrics dashboard-metrics ui-row ui-section"
              ><view class="dashboard-metric" :style="appGridItem(2, 'inline', [[600, 4]])"><MetricCard value-kind="text" :loading="statsLoading" label="阅读时长" :value="readingTime(stats.totalReadTime)" /></view><view class="dashboard-metric" :style="appGridItem(2, 'inline', [[600, 4]])"><MetricCard
                label="阅读天数"
                :loading="statsLoading"
                :value="stats.readDays ?? '—'"
                unit="天" /></view><view class="dashboard-metric" :style="appGridItem(2, 'inline', [[600, 4]])"><MetricCard
                label="日均阅读"
                value-kind="text" :loading="statsLoading"
                :value="readingTime(stats.dayAverageReadTime)" /></view><view class="dashboard-metric" :style="appGridItem(2, 'inline', [[600, 4]])"><MetricCard
                label="已读完"
                unit="本" :loading="statsLoading"
                :value="
                  stats.readStat?.find((item) => item.stat === '读完')?.counts ?? '—'
                " /></view></view
            ><MiniChart
              label="阅读时长趋势"
              kind="bar"
              :labels="trend.map((item) => item.label)"
              :series="[{ name: '阅读时长', values: trend.map((item) => item.value) }]"
              unit="分钟"
            /><view class="card ui-card" :class="{ 'card-dark': isDark }"
              ><text :style="appTextColor()" class="title">阅读最多的书</text
              ><view v-for="(item, index) in stats.readLongest || []" :key="index" class="rank-row ui-row"
                :role="item.book?.bookId || bookLink(item.book) ? 'button' : undefined"
                :tabindex="item.book?.bookId || bookLink(item.book) ? 0 : undefined"
                :aria-label="item.book?.bookId || bookLink(item.book) ? '在微信读书打开：' + item.book?.title : undefined"
                :aria-busy="!!openingBooks[item.book?.bookId]"
                @click="openRankBook(item.book)" @keydown.enter.self="openRankBook(item.book)" @keydown.space.self.prevent="openRankBook(item.book)">
                <text class="rank-number" :class="{ 'record-secondary-dark': isDark }">{{ String(index + 1).padStart(2, '0') }}</text>
                <image v-if="safeLink(item.book?.cover || item.albumInfo?.cover)" class="rank-cover" :src="safeLink(item.book?.cover || item.albumInfo?.cover)" mode="aspectFit" />
                <view class="rank-body ui-gap-sm"><text :max-lines="2" :style="appTextColor()" class="rank-title">{{ item.book?.title || item.albumInfo?.name }}</text><text class="secondary" :class="{ 'record-secondary-dark': isDark }">{{ readingTime(item.readTime) }}</text><text v-if="bookLinkErrors[item.book?.bookId]" class="secondary" role="alert">{{ bookLinkErrors[item.book?.bookId] }}</text></view>
                <MobileButton v-if="openingBooks[item.book?.bookId]" label="打开中" icon="ant-design:export-outlined" icon-only :loading="true" />
                <view v-if="showWebFallback[item.book?.bookId]" @click.stop>
                  <MobileButton label="网页版阅读" icon="ant-design:link-outlined" icon-only variant="quiet" :loading="!!openingBooks[item.book?.bookId]" @click="openWebBook(item.book)" />
                </view>
              </view
              ></view
            ></view
          ><view v-else-if="tab === '我的书架'"
            ><view class="weread-search ui-row ui-section" :class="{ 'weread-search-dark': isDark }"><AppIcon name="ant-design:search-outlined" :size="18" color="#8b8f99" /><input :style="appTextColor()" class="weread-search-input" aria-label="搜索书名或作者" placeholder="搜索书名、作者" v-model="keyword" confirm-type="search" /></view><view class="toolbar ui-row ui-section"
              ><FormField compact stretch hide-label
                label="阅读状态"
                kind="selector"
                v-model="status"
                :options="['全部图书', '已读完', '未读完', '有笔记']" /><FormField compact stretch hide-label
                label="排序"
                kind="selector"
                v-model="sort"
                :options="['最近阅读', '书名排序']" /></view
            ><text class="secondary" :class="{ 'record-secondary-dark': isDark }">{{ books.length }} 本</text
            ><view class="weread-shelf"><view
              v-for="book in books"
              :key="book.bookId"
              class="weread-book-card"
              :class="{ 'weread-book-card-dark': isDark }"
              role="button" tabindex="0" :aria-label="'书籍详情：' + book.title" @click="showBook(book)" @keydown.enter="showBook(book)" @keydown.space.prevent="showBook(book)"
              ><view class="book-cover-stage" :class="{ 'book-cover-stage-dark': isDark }">
                <image v-if="safeLink(book.cover)" :src="safeLink(book.cover)" class="cover" :aria-label="book.title + '封面'" mode="aspectFit" />
                <AppIcon v-else name="lucide:book-open" :size="32" color="#8b8f99" />
                <text class="book-status" :class="{ 'book-status-completed': book.finishReading === 1 }">{{ book.finishReading === 1 ? '已读完' : '未读完' }}</text>
              </view><view class="book-body ui-gap-sm">
                <text :style="appTextColor()" class="book-title">{{ book.title }}</text>
                <text class="book-author" :class="{ 'record-secondary-dark': isDark }">{{ book.author || '作者未知' }}</text>
                <view class="book-meta ui-row"><text class="book-notes" :class="{ 'record-secondary-dark': isDark }">{{ notebookMap.has(book.bookId) ? (notebookMap.get(book.bookId)?.noteCount || 0) + ' 划线 · ' + (notebookMap.get(book.bookId)?.reviewCount || 0) + ' 点评' : '暂无笔记' }}</text><text v-if="notebookMap.get(book.bookId)?.readingProgress != null" class="book-progress">{{ notebookMap.get(book.bookId)?.readingProgress }}%</text></view>
              </view></view></view><text v-if="!books.length" class="secondary" :class="{ 'record-secondary-dark': isDark }">没有匹配的图书</text></view
          ><view v-else
            ><FormField
              label="笔记本"
              kind="selector"
              :model-value="notebooks.find((n) => n.bookId === selectedBook)?.book.title || ''"
              :options="notebooks.map((n) => n.book.title)"
              @update:model-value="
                selectNotebook(notebooks.find((n) => n.book.title === $event)?.bookId || '')
              "
            /><view class="toolbar ui-row"
              ><FormField compact stretch
                label="笔记类型"
                kind="selector"
                v-model="noteKind"
                :options="['划线', '想法', '书评']" /></view
            ><FormField label="搜索笔记" v-model="noteQuery" /><PageState skeleton="list"
              :loading="notesLoading"
              :error="notesError"
              :empty="!noteItems.length"
              @retry="selectNotebook(selectedBook)"
              ><view
                v-for="item in noteItems"
                :key="item.id"
                class="card ui-card"
                :class="{ 'card-dark': isDark }"
                ><view class="toolbar ui-row"
                  ><text :style="appTextColor()" class="title">{{ item.chapter }}</text
                  ><MobileButton
                    label="复制笔记"
                    icon="ant-design:copy-outlined"
                    variant="quiet"
                    @click="copy([item.text, item.thought].filter(Boolean).join('\n'))" /></view
                ><text :style="appTextColor()" class="note-excerpt" selectable>{{ item.text }}</text
                ><text v-if="item.thought" :style="appTextColor()" class="note-thought" :class="{ 'note-thought-dark': isDark }" selectable>{{ item.thought }}</text
                ><text class="secondary" :class="{ 'record-secondary-dark': isDark }">{{ readingDate(item.time) }}</text></view
              ></PageState
            ><text v-if="copyError" class="error ui-section ui-type-body">{{ copyError }}</text></view
          ></template
        ></PageState
      ><AdaptiveModal
        v-if="settings"
        label="微信读书连接"
        :busy="saving || disconnecting"
        @close="
          settings = false;
          keyInput = '';
        "
        ><FormField :required="isRequired('weread', 'keyInput')"
          label="微信读书 Key"
          v-model="keyInput"
          :password="true"
          :disabled="saving || disconnecting" /><text class="secondary"
           :class="{ 'record-secondary-dark': isDark }">凭证保存在账号绑定中，仅用于读取你的微信读书数据。</text
        ><MobileButton
          label="获取微信读书 Key"
          variant="quiet"
          @click="openLink('https://weread.qq.com/r/weread-skills')" /><text
          v-if="settingsError"
          class="error ui-section ui-type-body"
          >{{ settingsError }}</text
        ><view class="toolbar ui-row"
          ><ConfirmAction
            v-if="connection.connected"
            label="断开微信读书"
            message="断开连接并清除保存的 Key？"
            :action="disconnect" /><MobileButton
            label="验证并保存"
            :loading="saving"
            :disabled="disconnecting"
            @click="saveConnection" /></view></AdaptiveModal
      ><AdaptiveModal
        v-if="detail"
        label="书籍详情"
        :content-key="String(detailLoading)"
        @close="
          detailRevision++;
          detail = null;
        "
        ><view class="detail-heading ui-row"><image v-if="safeLink(detail.cover)" class="detail-cover" :src="safeLink(detail.cover)" mode="aspectFit" /><view class="detail-heading-body ui-gap-sm"><text :style="appTextColor()" class="title">{{ detail.title }}</text><text class="secondary" :class="{ 'record-secondary-dark': isDark }">{{ detail.author }}</text></view></view
        ><PageState skeleton="form" :retain-content="false" :loading="detailLoading" :error="detailError" @retry="showBook(detail)"
          ><view class="metrics ui-row ui-section"
            ><MetricCard
              label="阅读进度"
              :value="progress?.book?.progress ?? '—'"
              unit="%" /><MetricCard
              label="累计阅读"
              :value="readingTime(progress?.book?.readingTime)" /></view
          ><view class="detail-meta ui-row ui-section"><text class="secondary" :class="{ 'record-secondary-dark': isDark }">最近阅读 {{ readingDate(progress?.book?.updateTime) }}</text><text class="detail-status" :class="{ 'record-secondary-dark': isDark }">{{ detail.finishReading === 1 ? '已读完' : '未读完' }}</text></view></PageState
        ><view class="toolbar ui-row"
          ><MobileButton label="查看笔记" @click="showNotes" /><MobileButton
            v-if="detail.bookId || bookLink(detail)"
            label="微信读书打开"
            icon="ant-design:export-outlined"
            variant="quiet"
            :loading="!!openingBooks[detail.bookId]"
            @click="openRankBook(detail)" /><MobileButton v-if="showWebFallback[detail.bookId]" label="网页版阅读" icon="ant-design:link-outlined" icon-only variant="quiet" :loading="!!openingBooks[detail.bookId]" @click="openWebBook(detail)" /></view><text v-if="bookLinkErrors[detail.bookId]" class="secondary" role="alert">{{ bookLinkErrors[detail.bookId] }}</text></AdaptiveModal></view
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.weread-page {
  color: #27272a;
}
.weread-page-dark {
  color: #eeeeef;
}
.toolbar,
.metrics {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.card {
  border-radius: 16px;
  background-color: #ffffff;
}
.card-dark {
  background-color: #1c1e22;
}
.title {
  min-width: 0;
  overflow-wrap: anywhere;
  @include type-style('title');

  flex: 1;
}
.secondary {
  @include type-style('label');
  color: $text-secondary-light;
}
.cover {
  width: 60px;
  height: 84px;
  flex-shrink: 0;
}
.book-body {
  flex: 1;
}
.error {
  color: #e05252;
}

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }

</style>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
