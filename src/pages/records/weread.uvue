.weread-search { flex-direction: row; align-items: center; padding: 0 $space-card; background-color: #fff; border-radius: 10px; }
.weread-search-dark { background-color: #1c1e22; }
.weread-search-input { flex: 1; min-width: 0; height: $space-controlMin;
/* #ifndef APP */
color: inherit;
/* #endif */
 @include type-style('body'); }
.weread-shelf { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-section; margin-top: $space-section; }
.weread-book-card { width: calc((100% - #{$space-section}) / 2); min-width: 0; box-sizing: border-box; overflow: hidden; border-radius: 12px; background-color: #fff; }
.weread-book-card-dark { background-color: #1c1e22; }
.book-cover-stage { position: relative; height: 174px; display: flex; align-items: center; justify-content: center; background-color: #edf0f5; }
.book-cover-stage-dark { background-color: #252a33; }
.cover { width: 104px; height: 140px; }
.book-status { position: absolute; top: $space-inline; right: $space-inline; padding: $space-micro $space-detail; border-radius: 4px; color: #586578; background-color: #e5eaf2; @include type-style('chart-label'); }
.book-status-completed { color: #178552; background-color: #dcf6e8; }
.book-body { min-width: 0; padding: $space-card; }
.book-title {
/* #ifndef APP */
display: -webkit-box;
/* #endif */
/* #ifdef APP */
text-overflow: ellipsis;
/* #endif */

/* #ifndef APP */
-webkit-line-clamp: 2;
/* #endif */

/* #ifndef APP */
-webkit-box-orient: vertical;
/* #endif */
 overflow: hidden; @include type-style('body-strong');   height: calc(#{type-line('body')} * 2); }
.book-author { color: $text-secondary-light; @include type-style('caption');  white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.book-meta { flex-direction: row; align-items: center; flex-wrap: wrap; gap: $space-detail; }
.book-notes { color: $text-secondary-light; @include type-style('caption'); }
.book-progress { margin-left: auto; color: #427bea; @include type-style('badge'); }
.rank-row { min-height: $space-controlMin; margin-top: $space-section; flex-direction: row; align-items: center; }
.rank-number { width: 22px; color: $text-secondary-light; @include type-style('caption'); }
.rank-cover { width: 36px; height: 48px; flex-shrink: 0; }
.rank-body { flex: 1; min-width: 0; }
.rank-title {
/* #ifndef APP */
display: -webkit-box;
/* #endif */
/* #ifdef APP */
text-overflow: ellipsis;
/* #endif */

/* #ifndef APP */
-webkit-line-clamp: 2;
/* #endif */

/* #ifndef APP */
-webkit-box-orient: vertical;
/* #endif */
 overflow: hidden; @include type-style('body');  }
.detail-heading { flex-direction: row; align-items: center; }
.detail-cover { width: 66px; height: 90px; flex-shrink: 0; }
.detail-heading-body { flex: 1; min-width: 0; }
/* #ifdef WEB */
.weread-book-card:focus-visible { outline: 2px solid #427bea; outline-offset: $space-micro; }
/* #endif */
@media (min-width: 600px) { .weread-book-card { width: calc((100% - #{$space-section} * 2) / 3); } }
@media (min-width: 900px) { .weread-book-card { width: calc((100% - #{$space-section} * 3) / 4); } }
.dashboard-filter { flex: 1; min-width: 0; }
.metrics { align-items: stretch; }
.dashboard-metric { width: calc((100% - #{$space-inline}) / 2); min-width: 0; }
/* #ifdef APP */
// 原生 flex 不依赖 gap；列宽从同一份间距配置计算。
.dashboard-metrics { gap: 0; justify-content: space-between; margin-bottom: $space-section - $space-inline; }
.dashboard-filters { gap: 0; }
.dashboard-date { margin-left: $space-inline; }
/* #endif */
.detail-meta { align-items: center; flex-wrap: wrap; }
.detail-status { color: $text-secondary-light; @include type-style('caption'); margin-left: auto; }
@media (min-width: 600px) { .dashboard-metric { width: calc((100% - #{$space-inline} * 3) / 4); } }

.note-excerpt, .note-thought { @include type-style('prose'); white-space: pre-wrap; overflow-wrap: anywhere; }
