.weread-tabs { flex-direction: row; }
.weread-tab { flex: 1; margin: 0; padding: 0 $space-inline; min-height: $space-controlMin; border-radius: 0; background-color: transparent; color: $text-secondary-light; @include type-style('body'); }
.weread-tab::after { border: 0; }
.weread-tab-dark { color: $text-secondary-dark; }
