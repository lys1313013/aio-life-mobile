<script setup lang="ts">
import ImagePlaceholder from '../../../components/ImagePlaceholder.uvue';
import { useImageSource } from '../../../services/use-image-source.ts';
import AppIcon from '../../../components/AppIcon.uvue';
const props = defineProps<{ fileId?: string; state?: string; title: string }>();
const emit = defineEmits<{ (event: 'retry'): void }>();
const { source, loading, failed, load, imageLoad, imageError } = useImageSource(() => ({ fileId: props.fileId }));
function retry() { if (props.state === 'FAILED') emit('retry'); else load(); }
</script>
<template>
  <view class="video-cover">
    <image v-if="source && !failed" :key="source" class="video-cover-image" :src="source" :aria-label="title + ' 封面'" mode="aspectFill" @load="imageLoad" @error="imageError" />
    <ImagePlaceholder v-if="!source || failed || loading || state === 'FAILED'" :loading="loading || (state === 'PENDING' && !failed)" :failed="failed || state === 'FAILED'" label="正在加载视频封面" @retry="retry"><AppIcon name="ant-design:play-circle-outlined" :size="28" color="#8b8f99" /></ImagePlaceholder>
  </view>
</template>
<style scoped lang="scss">
.video-cover { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.video-cover-image { width: 100%; height: 100%; }
</style>
