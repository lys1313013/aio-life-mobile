<script setup lang="ts">
import LibraryCover from '../../../components/LibraryCover.uvue'
import AppIcon from '../../../components/AppIcon.uvue'
import LoadingIndicator from '../../../components/LoadingIndicator.uvue'
import ContentSkeleton from '../../../components/ContentSkeleton.uvue'
import { isDark } from '../../../services/theme.ts'

defineProps<{
  label: string; status: string; items: any[]; total: number | null;
  hasMore?: boolean; placeholders?: number; editing?: string
}>()
const emit = defineEmits(['open', 'all'])
function finishedDate(date: string) {
  return Number(date.slice(5, 7)) + '月' + Number(date.slice(8, 10)) + '日'
}
function rankingName(name: string) {
  return name === '豆瓣读书Top250' ? '豆瓣 Top250' : name
}
function rankingDescription(rankings: Array<{ name: string; rank: number | null }> | null | undefined) {
  return rankings?.map(badge => rankingName(badge.name) + (badge.rank == null ? '' : ' 第' + badge.rank + '名')).join('，') || undefined
}
</script>

<template>
  <view class="reading-shelf ui-gap-sm" role="group" :aria-label="label">
    <view class="shelf-heading ui-row">
      <text class="shelf-label" :class="{ 'shelf-text-dark': isDark }">{{ label }}</text>
      <text v-if="!placeholders" class="shelf-count" :class="{ 'shelf-secondary-dark': isDark }">{{ total == null ? '已显示 ' + items.length + ' 本' : total + '本' }}</text>
      <button v-if="hasMore" class="shelf-all" hover-class="none" role="button"
        :aria-label="'查看全部' + label + '记录'" @click="emit('all')">
        <text class="shelf-more-label" :class="{ 'shelf-secondary-dark': isDark }">查看全部</text>
        <AppIcon name="ant-design:right-outlined" :size="14" />
      </button>
    </view>
    <view class="shelf-grid ui-gap-md">
      <view v-for="n in placeholders || 0" :key="n" class="shelf-book ui-gap-sm">
        <view class="shelf-cover"><ContentSkeleton variant="cover" /></view>
        <view class="shelf-copy ui-gap-xs"><ContentSkeleton variant="caption" /><ContentSkeleton v-if="status === 'completed'" variant="caption" /></view>
      </view>
      <view v-for="book in items" :key="book.id" class="shelf-book ui-gap-sm" role="button" tabindex="0"
        :aria-label="'编辑《' + book.title + '》'" :aria-description="rankingDescription(book.rankings)" :aria-busy="editing === book.id"
        @click="emit('open', book)" @keydown.enter.self="emit('open', book)" @keydown.space.self.prevent="emit('open', book)">
        <view class="shelf-cover">
          <LibraryCover :file-id="book.fileId || ''" :url="book.coverImgUrl || ''" :title="book.title" kind="read" compact />
          <view v-if="editing === book.id" class="shelf-opening"><LoadingIndicator compact label="正在加载记录详情" /></view>
        </view>
        <view class="shelf-copy ui-gap-xs">
          <text class="shelf-title" :class="{ 'shelf-text-dark': isDark }" :max-lines="2">{{ book.title }}</text>
          <text v-if="status === 'completed' && book.finishDate" class="shelf-date" :class="{ 'shelf-secondary-dark': isDark }">{{ finishedDate(book.finishDate) }}</text>
          <view v-for="badge in book.rankings" :key="badge.rankingListId" class="shelf-badge" :class="{ 'shelf-badge-dark': isDark }">
            <text v-if="badge.rank != null" class="shelf-rank" :class="{ 'shelf-rank-dark': isDark }">No.{{ badge.rank }}</text>
            <text class="shelf-rank-name" :class="{ 'shelf-rank-name-dark': isDark }">{{ rankingName(badge.name) }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<style scoped lang="scss">
@use '../../../styles/platform' as *;
@use '../../../styles/spacing.scss';
@use '../../../styles/spacing-tokens' as *;
@use '../../../styles/typography' as *;
@use '../../../styles/text-colors' as *;
.shelf-heading { min-height: $space-controlMin; align-items: center; }
.shelf-label { @include type-style('title'); color: #27272a; }
.shelf-count, .shelf-date { @include type-style('caption'); color: $text-secondary-light; }
.shelf-all {
  display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: $space-detail;
  margin: 0 0 0 auto; padding: 0; min-height: $space-controlMin; min-width: $space-controlMin;
  background-color: transparent; border: 0; @include borderless-button;
}
.shelf-more-label { @include type-style('label'); color: $text-secondary-light; }
.shelf-grid { flex-direction: row; flex-wrap: wrap; }
.shelf-book {
  width: calc((100% - #{$space-section}) / 2); min-width: 0;
  flex-direction: row; align-items: center;
}
// 书封尺寸固定，骨架、图片和无封面占位使用相同的 3:4 比例。
.shelf-cover { width: 54px; height: 72px; flex-shrink: 0; position: relative; border-radius: 4px; overflow: hidden; }
.shelf-copy { flex: 1; min-width: 0; }
.shelf-title { @include type-style('body-strong'); @include wrap-long-text; @include clamp-text(2); color: #27272a; }
.shelf-badge {
  flex-direction: row; flex-wrap: wrap; align-self: flex-start; align-items: center; max-width: 100%;
  border-radius: 3px; background-color: #ffe298;
}
.shelf-badge-dark { background-color: #46381e; }
.shelf-rank, .shelf-rank-name { padding: 0 $space-detail; color: #624407; }
.shelf-rank {
  flex-shrink: 0; border-radius: 3px; background-color: #ffd365;
  @include type-style('badge-strong');
}
.shelf-rank-name { max-width: 100%; box-sizing: border-box; @include type-style('badge'); @include wrap-long-text; }
.shelf-rank-dark { color: #ffdc96; background-color: #624407; }
.shelf-rank-name-dark { color: #ffdc96; }
.shelf-text-dark { color: #eeeeef; }
.shelf-secondary-dark { color: $text-secondary-dark; }
.shelf-opening { position: absolute; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; background-color: rgba(0,0,0,.45); }
/* #ifdef WEB */
.shelf-book:focus-visible, .shelf-all:focus-visible { outline: 2px solid #427bea; outline-offset: $space-micro; }
/* #endif */
</style>
