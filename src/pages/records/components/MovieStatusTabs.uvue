<script setup lang="ts">
import { computed, ref, onMounted, onUnmounted } from 'vue';
import CategoryTabs from '../../../components/CategoryTabs.uvue';
// #ifdef WEB
import { bindHorizontalWheel } from '../../../services/pager-mouse-drag.ts';
// #endif

const props = defineProps<{ items: any[]; current: number; progress: number | null; disabled: boolean }>();
const emit = defineEmits(['change']);
const root = ref(null);
const fits = ref(false);
const swipeEnabled = computed(() => fits.value && !props.disabled);
let touchOrigin: { x: number; y: number } | null = null;
let suppressTapUntil = 0;

function step(direction: number) {
  const index = props.current + direction;
  if (index >= 0 && index < props.items.length) emit('change', index);
}
function swipe(dx: number, dy: number) {
  if (!swipeEnabled.value || Math.abs(dx) < 32 || Math.abs(dx) <= Math.abs(dy)) return;
  suppressTapUntil = Date.now() + 350;
  step(-Math.sign(dx));
}
function touchStart(event) {
  const point = event.touches[0];
  touchOrigin = swipeEnabled.value && event.touches.length === 1 && point
    ? { x: point.clientX, y: point.clientY } : null;
}
function touchEnd(event) {
  const start = touchOrigin;
  touchOrigin = null;
  const point = event.changedTouches[0];
  if (start && point && event.touches.length === 0) swipe(point.clientX - start.x, point.clientY - start.y);
}
function touchCancel() { touchOrigin = null; }
function select(index: number) {
  if (Date.now() >= suppressTapUntil) emit('change', index);
}

// #ifdef WEB
let release: (() => void) | undefined;
onMounted(() => {
  const element = root.value?.$el || root.value;
  if (!element) return;
  let origin: { x: number; y: number } | null = null;
  const down = (event: MouseEvent) => {
    if (swipeEnabled.value && event.button === 0) origin = { x: event.clientX, y: event.clientY };
  };
  const up = (event: MouseEvent) => {
    const start = origin;
    origin = null;
    if (start) swipe(event.clientX - start.x, event.clientY - start.y);
  };
  const blur = () => { origin = null; };
  const releaseWheel = bindHorizontalWheel(element, step, () => swipeEnabled.value);
  element.addEventListener('mousedown', down);
  document.addEventListener('mouseup', up);
  window.addEventListener('blur', blur);
  release = () => {
    element.removeEventListener('mousedown', down);
    document.removeEventListener('mouseup', up);
    window.removeEventListener('blur', blur);
    releaseWheel();
  };
});
onUnmounted(() => release?.());
// #endif
</script>

<template>
  <view ref="root" class="movie-status-tabs" @touchstart="touchStart" @touchend="touchEnd" @touchcancel="touchCancel">
    <CategoryTabs :items="items" :current="current" :progress="progress" :disabled="disabled" :scrollable="!swipeEnabled"
      label="观影状态" id-prefix="movie-status" variant="underline" @fit="fits = $event" @change="select" />
  </view>
</template>

<style scoped lang="scss">
@use '../../../styles/spacing-tokens' as *;
.movie-status-tabs { margin-bottom: $space-section; }
</style>
