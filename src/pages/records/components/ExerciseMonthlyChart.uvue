<script setup lang="ts">
import { computed, ref, watch } from 'vue'
import AioChart from '../../../components/AioChart.uvue'
import MobileButton from '../../../components/MobileButton.uvue'
import { isDark } from '../../../services/theme.ts'
import type { ChartSeries } from '../../../services/chart-options.ts'
import { exerciseMonthWindow } from '../services/exercise-chart.ts'

const props = defineProps<{ labels: string[]; series: ChartSeries[]; loading?: boolean; resetKey?: string }>()
const page = ref(0)
const monthWindow = computed(() => exerciseMonthWindow(props.labels, props.series, page.value))
watch(() => [props.resetKey, props.labels[props.labels.length - 1]], () => { page.value = 0 })
function changePage(older: boolean) {
  if (props.loading || (older ? !monthWindow.value.hasOlder : !monthWindow.value.hasNewer)) return
  page.value = monthWindow.value.page + (older ? 1 : -1)
}
</script>

<template>
  <AioChart label="每月运动次数" kind="bar" unit="次" stacked hide-unit hide-values swipeable
    :loading="loading" :labels="monthWindow.labels" :x-labels="monthWindow.xLabels" :series="monthWindow.series"
    @swipe="changePage($event === 'right')">
    <template #actions>
      <view class="monthly-controls">
        <MobileButton label="查看更早的六个月" icon="ant-design:left-outlined" variant="ghost" :disabled="loading || !monthWindow.hasOlder" @click="changePage(true)" />
        <text class="monthly-year" :class="{ 'monthly-year-dark': isDark }" :aria-label="monthWindow.year + '年'">{{ monthWindow.year }}</text>
        <MobileButton label="查看更新的六个月" icon="ant-design:right-outlined" variant="ghost" :disabled="loading || !monthWindow.hasNewer" @click="changePage(false)" />
      </view>
    </template>
  </AioChart>
</template>

<style scoped lang="scss">
@use '../../../styles/spacing-tokens' as *;
@use '../../../styles/typography' as *;
@use '../../../styles/text-colors' as *;
.monthly-controls { display: flex; flex-direction: row; align-items: center; gap: $space-micro; }
.monthly-year { @include type-style('caption'); min-width: $space-controlMin; text-align: center; color: $text-secondary-light; }
.monthly-year-dark { color: $text-secondary-dark; }
</style>
