<script setup lang="ts">
import CategoryTabs from "../../components/CategoryTabs.uvue";
import { openExternalLink } from '../../services/external-link.ts'
import { readPageTotal, mergePageItems, hasMorePageItems } from '../../services/pagination.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { appTextColor } from '../../services/app-layout.ts'

import VideoCover from './components/VideoCover.uvue';
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import { computed, ref, onUnmounted } from 'vue';
import { onLoad, onShow, onHide } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import { isDark } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import CategoryPager from '../../components/CategoryPager.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import {
  statuses,
  statusLabels as statusNames,
  dateTime,
} from '../../services/records/contracts.ts';
import {
  fetchVideoPage,
  fetchVideoCovers,
  retryVideoCover,
  saveVideo,
  deleteVideo,
  fetchVideoCounts,
  fetchVideoStatistics,
  parseVideoLink,
  extractVideoId,
} from './services/video.ts';
const counts = ref<any>({}),
  statistics = ref<any>({}),
  refreshing = ref(false),
  status = ref('进行中'),
  keyword = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  parsing = ref(false),
  formError = ref(''),
  saved = ref(false);
const showMore = ref(false);
const durationInput = ref('00:00:00');
const watchedDurationInput = ref('00:00:00');
const statusLabels = {
  not_started: '未开始',
  in_progress: statusNames[1],
  completed: statusNames[2],
  on_hold: '已暂停',
};
const statusTabs = ['未开始', '进行中', '已暂停', '已完成', '全部状态'];
const statusIndex = computed(() => statusTabs.indexOf(status.value));
const pages = ref(statusTabs.map(label => ({
  label, rows: [] as any[], loading: false, loaded: false, stale: false, error: '', revision: 0,
})));
const currentPage = computed(() => pages.value[statusIndex.value]);
const rows = computed({ get: () => currentPage.value.rows, set: value => { currentPage.value.rows = value; } });
const loading = computed(() => currentPage.value.loading);
const error = computed(() => currentPage.value.error);
const summaryLoaded = ref(false), summaryLoading = ref(false), summaryError = ref('');
const visiblePages = computed(() => pages.value.map(page => ({ ...page,
  filtered: page.rows.filter(item => [item.title, item.ownerName, item.notes].join(' ').toLowerCase().includes(keyword.value.toLowerCase())),
})));
const pager = ref(null);
let disposed = false, pageActive = true;
onHide(() => { pageActive = false; });
onUnmounted(() => { disposed = true; });
function selectStatus(label: string) {
  if (!label || label === status.value || form.value) return;
  stopCoverPolling();
  status.value = label;
  void loadPage(statusIndex.value);
  pollCovers();
}
function pageChanged(index) { selectStatus(statusTabs[index]); }
let generation = 0,
  formRevision = 0;
let requestedEdit = '';
let requestedCreate = false;
onLoad((options) => {
  requestedEdit = String(options?.id || '');
  requestedCreate = options?.create === '1';
  if (requestedEdit) status.value = '全部状态';
});
const scope = createRecordScope((clear) => {
  formRevision++;
  form.value = null;
  if (clear) {
    requestedEdit = '';
    requestedCreate = false;
    pages.value = statusTabs.map(label => ({ label, rows: [], loading: false, loaded: false, stale: false, error: '', revision: 0 }));
    summaryLoaded.value = false;
    counts.value = {};
    statistics.value = {};
  }
});
let coverTimer: ReturnType<typeof setTimeout> | undefined;
let coverRevision = 0;
function stopCoverPolling() { coverRevision++; clearTimeout(coverTimer); }
onHide(stopCoverPolling);
onUnmounted(stopCoverPolling);
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['b-video', 'userDictData', 'userDictType'] })
onShow(() => { pageActive = true; refreshOnShow(); pollCovers(); });
function pollCovers() {
  clearTimeout(coverTimer);
  const ids = rows.value.filter(item => item.coverState === 'PENDING').map(item => item.id);
  if (!ids.length) return;
  const revision = coverRevision;
  coverTimer = setTimeout(async () => {
    try {
      const values = [];
      for (let index = 0; index < ids.length; index += 100)
        values.push(...await scope.wait(fetchVideoCovers(ids.slice(index, index + 100))));
      if (revision !== coverRevision) return;
      for (const cover of values) {
        const item = rows.value.find(item => item.id === cover.id);
        if (item) { item.coverFileId = cover.coverFileId; item.coverState = cover.coverState; }
      }
      pollCovers();
    } catch { /* 查询失败停止轮询，保留当前封面；下拉刷新可恢复。 */ }
  }, 3000);
}
async function retryCover(item) {
  if (pager.value?.ignoreClick()) return;
  if (item.coverState !== 'FAILED') return;
  item.coverState = 'PENDING';
  try { await scope.wait(retryVideoCover(item.id)); pollCovers(); }
  catch (e) { item.coverState = 'FAILED'; if (e.name !== 'PageInactiveError') uni.showToast({ title: e.message || '重试失败', icon: 'none' }); }
}
function formatSeconds(value) {
  const seconds = Math.max(0, Math.floor(Number(value) || 0));
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor(seconds / 60) % 60;
  return hours ? hours + '小时' + (minutes ? minutes + '分' : '')
    : minutes ? minutes + '分钟' : seconds + '秒';
}
function clockDuration(value) {
  const seconds = Math.max(0, Math.floor(Number(value) || 0));
  return [Math.floor(seconds / 3600), Math.floor(seconds / 60) % 60, seconds % 60]
    .map((part) => String(part).padStart(2, '0')).join(':');
}
// 与 Web 一致显示 HH:mm:ss；只在提交边界转换为接口秒数。
function parseClockDuration(value: string) {
  const match = /^(\d+):([0-5]\d):([0-5]\d)$/.exec(value.trim());
  if (!match) return NaN;
  const seconds = Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3]);
  return Number.isSafeInteger(seconds) ? seconds : NaN;
}
function syncDurationInputs() {
  durationInput.value = clockDuration(form.value.duration);
  watchedDurationInput.value = clockDuration(form.value.watchedDuration);
}
function canPlay(url) {
  return /^https:\/\/([\w-]+\.)?bilibili\.com\//.test(String(url || ''));
}
function videoProgress(item) {
  if (item.status === 'completed') return 100;
  return Math.max(0, Math.min(100, Math.round(item.duration
    ? Number(item.watchedDuration || 0) / Number(item.duration) * 100
    : Number(item.progress || 0))));
}
async function refresh() {
  if (refreshing.value) return;
  refreshing.value = true;
  try { await load(); } finally { refreshing.value = false; }
}
const pageRequests = new Map<object, { revision: number; promise: Promise<void> }>();
function invalidatePages() {
  // 保存、删除或刷新后，之前发出的请求不能把旧数据重新标为有效缓存。
  pages.value.forEach(page => { page.revision++; page.stale = true; page.loading = false; });
}
async function loadPage(index: number, force = false) {
  const target = pages.value[index];
  const revision = target.revision;
  const pending = pageRequests.get(target);
  if (pending && pending.revision === revision) return pending.promise;
  if (target.loaded && !target.stale && !force) return;
  const selectedStatus = statuses.find(code => statusLabels[code] === target.label) || '';
  target.loading = true;
  target.error = '';
  const request = (async () => {
    try {
      let data = [], page = 1;
      while (true) {
        const result = await scope.wait(fetchVideoPage(page++, selectedStatus));
        if (revision !== target.revision) return;
        const total = readPageTotal(result.total);
        data = mergePageItems(data, result.items);
        if (!hasMorePageItems(data.length, total, result.items.length === 0)) break;
      }
      target.rows = data;
      target.loaded = true;
      target.stale = false;
      if (target === currentPage.value) pollCovers();
    } catch (e) {
      if (revision === target.revision && e.name !== 'PageInactiveError') target.error = e.message;
    } finally {
      if (revision === target.revision) target.loading = false;
      if (pageRequests.get(target)?.revision === revision) pageRequests.delete(target);
    }
  })();
  pageRequests.set(target, { revision, promise: request });
  return request;
}
async function loadSummary() {
  const current = ++generation;
  summaryLoading.value = true;
  summaryError.value = '';
  try {
    const [statusCounts, stats] = await scope.wait(Promise.all([fetchVideoCounts(), fetchVideoStatistics()]));
    if (current !== generation) return;
    counts.value = statusCounts;
    statistics.value = stats;
    summaryLoaded.value = true;
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === generation) summaryError.value = e.message;
  } finally {
    if (current === generation) summaryLoading.value = false;
  }
}
async function load() {
  stopCoverPolling();
  invalidatePages();
  const index = statusIndex.value;
  await Promise.all([loadSummary(), loadPage(index, true)]);
  if (disposed || !pageActive || index !== statusIndex.value || error.value) return;
  if (requestedEdit) {
    const selected = rows.value.find(item => item.id === requestedEdit);
    if (!selected) { currentPage.value.error = '记录不存在或已删除'; return; }
    open(selected);
    requestedEdit = '';
  } else if (requestedCreate) {
    open();
    requestedCreate = false;
  }
}
function open(item = null) {
  if (loading.value || pager.value?.ignoreClick()) return;
  formRevision++;
  saved.value = false;
  showMore.value = false;
  formError.value = '';
  form.value = item
    ? {
        ...item,
        duration: String(item.duration || 0),
        watchedDuration: String(item.watchedDuration || 0),
        episodes: String(item.episodes || 1),
        currentEpisode: String(item.currentEpisode || 1),
        date: (item.lastWatched || '').slice(0, 10),
        time: (item.lastWatched || '').slice(11, 16),
      }
    : {
        title: '',
        url: '',
        cover: '',
        duration: '0',
        watchedDuration: '0',
        episodes: '1',
        currentEpisode: '1',
        status: 'not_started',
        date: '',
        time: '',
        notes: '',
        bvid: '',
        aid: '',
        description: '',
        ownerName: '',
        pagesInfo: '[]',
      };
  syncDurationInputs();
}
async function parse() {
  if (parsing.value || saving.value) return;
  const current = formRevision;
  parsing.value = true;
  formError.value = '';
  try {
    const result = await scope.wait(parseVideoLink(form.value.url));
    if (current === formRevision && form.value) {
      form.value = {
        ...form.value,
        ...result,
        duration: String(result.duration),
        watchedDuration: String(result.watchedDuration),
        episodes: String(result.episodes),
        currentEpisode: String(result.currentEpisode),
      };
      syncDurationInputs();
    }
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === formRevision) {
      formError.value = e.message;
      showMore.value = true;
    }
  } finally {
    parsing.value = false;
  }
}
function updateEpisode(value) {
  form.value.currentEpisode = value;
  const episode = Number(value);
  try {
    const pages = JSON.parse(form.value.pagesInfo || '[]');
    if (pages.length && Number.isInteger(episode)) {
      form.value.watchedDuration = String(
        pages
          .slice(0, Math.max(0, episode - 1))
          .reduce((sum, p) => sum + Number(p.duration || 0), 0),
      );
      watchedDurationInput.value = clockDuration(form.value.watchedDuration);
    }
  } catch {}
}
async function save() {
  if (saving.value || parsing.value) return;
  if (missingRequired('video', form.value)) {
    formError.value = '请输入标题和视频链接';
    return;
  }
  const duration = parseClockDuration(durationInput.value),
    watchedDuration = parseClockDuration(watchedDurationInput.value),
    episodes = Number(form.value.episodes),
    currentEpisode = Number(form.value.currentEpisode);
  if (
    [duration, watchedDuration, episodes, currentEpisode].some(
      (value) => !Number.isInteger(value),
    ) ||
    duration < 0 ||
    watchedDuration < 0 ||
    watchedDuration > duration ||
    episodes < 1 ||
    currentEpisode < 1 ||
    currentEpisode > episodes
  ) {
    showMore.value = true;
    formError.value = '时长请用 时:分:秒（如 01:20:00），并检查时长与集数范围';
    return;
  }
  saving.value = true;
  formError.value = '';
  try {
    if (!saved.value) {
      const id = extractVideoId(form.value.url);
      const payload = {
        ...form.value,
        ...id,
        duration,
        watchedDuration: form.value.status === 'completed' ? duration : watchedDuration,
        episodes,
        currentEpisode,
        lastWatched: dateTime(form.value.date, form.value.time),
      };
      if (!(await scope.wait(saveVideo(payload)))) throw new Error('保存失败');
      saved.value = true;
    }
    await load();
    if (error.value) throw new Error(error.value);
    form.value = null;
  } catch (e) {
    if (e.name !== 'PageInactiveError') formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  if (!(await scope.wait(deleteVideo(item.id)))) throw new Error('删除失败');
  pages.value.forEach(page => { page.rows = page.rows.filter(row => row.id !== item.id); page.stale = true; });
  await load();
  if (error.value) throw new Error(error.value);
}
function play(url) {
  if (!canPlay(url)) return;
  openExternalLink(url);
}
const statusCategories = computed(() => statusTabs.map(label => ({ label: label === '全部状态' ? '全部' : label, count: summaryLoaded.value ? (label === '全部状态' ? Object.values(counts.value).reduce((sum, count) => sum + Number(count), 0) : counts.value[statuses.find(code => statusLabels[code] === label)] || 0) : null })));

</script>
<template>
  <MobilePage :scroll-locked="true" :refresh-disabled="true"
    ><view class="video-page ui-page-body" :class="{ 'video-page-dark': isDark }"
      ><PageHeader title="视频观看" :back="true" @back="uni.navigateBack()" /><view class="ui-toolbar"
        ><FormField compact stretch hide-label label="搜索视频" placeholder="搜索视频、UP主或笔记" v-model="keyword" /></view
      ><view class="video-summary ui-row ui-section" :class="{ 'summary-pending': !summaryLoaded, 'summary-pending-dark': !summaryLoaded && isDark }" :aria-busy="summaryLoading"><view class="summary-panel ui-card" :class="{ 'summary-panel-dark': isDark }"><text class="secondary" :class="{ 'record-secondary-dark': isDark }">学习总数</text><text class="summary-number" :aria-hidden="!summaryLoaded" :class="{ 'summary-value-pending': !summaryLoaded, 'summary-value-pending-dark': !summaryLoaded && isDark }">{{ Object.values(counts).reduce((sum, count) => sum + Number(count), 0) }}</text><text class="secondary" :class="{ 'record-secondary-dark': isDark, 'summary-value-pending': !summaryLoaded, 'summary-value-pending-dark': !summaryLoaded && isDark }">{{ counts.completed || 0 }} 已完成 · {{ counts.in_progress || 0 }} 进行中 · {{ counts.not_started || 0 }} 未开始</text></view><view class="summary-panel ui-card" :class="{ 'summary-panel-dark': isDark }"><text class="secondary" :class="{ 'record-secondary-dark': isDark }">已学时长</text><text class="summary-number summary-duration" :aria-hidden="!summaryLoaded" :class="{ 'summary-value-pending': !summaryLoaded, 'summary-value-pending-dark': !summaryLoaded && isDark }">{{ formatSeconds(statistics.studiedSeconds) }}</text><text class="secondary" :class="{ 'record-secondary-dark': isDark, 'summary-value-pending': !summaryLoaded, 'summary-value-pending-dark': !summaryLoaded && isDark }">剩余预估 {{ formatSeconds(statistics.unstudiedSeconds) }}</text></view><LoadingIndicator v-if="summaryLoading" label="正在加载视频统计" floating /><MobileButton v-if="summaryError && !summaryLoading" class="summary-retry" label="重试视频统计" variant="quiet" @click="loadSummary" /></view><CategoryTabs class="status-scroll ui-section" :items="statusCategories" :current="statusIndex" variant="underline" label="视频状态" id-prefix="video-status" item-class="status-tab" label-class="status-label" count-class="status-count" :disabled="!!form" @change="selectStatus(statusTabs[$event])" />
      <CategoryPager ref="pager" class="video-pager" :items="visiblePages" :current="statusIndex" :disabled="!!form" :refreshing="refreshing" :layout-key="[summaryLoaded, counts, statistics, summaryError]" tabs-selector=".status-scroll" @change="pageChanged" @refresh="refresh"><template #default="{ item: videoPage, index, active }"><view class="video-page-content" :class="{ 'video-page-active': active }">
      <PageState skeleton="media" :loading="videoPage.loading || (!videoPage.loaded && !videoPage.error)" :has-content="videoPage.loaded" :error="videoPage.error" :empty="!videoPage.filtered.length" @retry="loadPage(index, true)"
        >
<template #loading><view class="video-grid"><view v-for="n in 6" :key="n" class="video-card" :class="{ 'video-card-dark': isDark }"><view class="video-poster"><ContentSkeleton variant="cover" /></view><view class="video-body video-skeleton-body" aria-hidden="true"><text class="video-title video-skeleton-line" :class="{ 'video-skeleton-line-dark': isDark }">占位标题</text><view class="video-meta ui-row"><text class="video-meta-text video-skeleton-line" :class="{ 'video-skeleton-line-dark': isDark }">占位作者</text><text class="episode">&#160;</text></view><view class="video-meta ui-row"><text class="video-meta-text video-skeleton-line" :class="{ 'video-skeleton-line-dark': isDark }">00:00:00 / 00:00:00</text><text class="episode">&#160;</text></view><view class="progress-track" :class="{ 'progress-track-dark': isDark }" /></view></view></view></template>
<view class="video-grid"><view v-for="item in videoPage.filtered" :key="item.id" class="video-card" :class="{ 'video-card-dark': isDark }" role="button" tabindex="0" :aria-label="'编辑视频：' + item.title" @click="open(item)" @keydown.enter="open(item)" @keydown.space.prevent="open(item)"><view class="video-poster" :class="{ 'video-poster-dark': isDark }"><VideoCover :file-id="item.coverFileId" :state="item.coverState" :title="item.title" @retry="retryCover(item)" /><text class="video-status" :class="'video-status-' + item.status">{{ statusLabels[item.status] }}</text><text class="video-duration">{{ clockDuration(item.duration) }}</text></view><view class="video-body"><text :max-lines="2" class="video-title">{{ item.title }}</text><view class="video-meta ui-row"><text class="video-meta-text" :class="{ 'record-secondary-dark': isDark }">{{ item.ownerName || '' }}</text><text class="episode">{{ item.currentEpisode || 1 }}/{{ item.episodes || 1 }}</text></view><view class="video-meta ui-row"><text class="video-meta-text" :class="{ 'record-secondary-dark': isDark }">{{ clockDuration(item.watchedDuration) }} / {{ clockDuration(item.duration) }}</text><text class="episode">{{ videoProgress(item) }}%</text></view><view class="progress-track" :class="{ 'progress-track-dark': isDark }"><view class="progress-fill" :style="{ width: (videoProgress(item)) + '%' }" /></view></view></view></view></PageState
      ></view></template></CategoryPager><AdaptiveModal
        v-if="form"
        label="编辑学习视频"
        :busy="saving || parsing"
        @close="
          formRevision++;
          form = null;
        "
        ><view class="ui-field-row video-link-row">
          <FormField appearance="soft" :required="isRequired('video', 'url')" compact stretch label="视频链接" placeholder="粘贴 B 站视频链接" v-model="form.url" />
          <MobileButton label="解析视频" variant="quiet" :loading="parsing" :disabled="saving" @click="parse" />
        </view>
        <FormField appearance="soft" :required="isRequired('video', 'title')" label="标题" placeholder="视频标题" v-model="form.title" />
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="状态" kind="selector"
            :model-value="statusLabels[form.status]"
            :options="statuses.map((code) => statusLabels[code])"
            @update:model-value="form.status = statuses.find((code) => statusLabels[code] === $event) || 'not_started'" />
          <FormField appearance="soft" compact stretch label="当前集数" input-type="number" :model-value="form.currentEpisode" @update:model-value="updateEpisode">
            <template #labelAction><text class="video-field-context" :class="{ 'record-secondary-dark': isDark }">共 {{ form.episodes }} 集</text></template>
          </FormField>
        </view>
        <FormField appearance="soft" label="已学习时长" placeholder="00:00:00（时:分:秒）" v-model="watchedDurationInput">
          <template #labelAction><text class="video-field-context" :class="{ 'record-secondary-dark': isDark }">共 {{ durationInput }}</text></template>
        </FormField>
        <FormField appearance="soft" label="学习笔记" kind="textarea" textarea-size="compact" placeholder="记下收获或下次继续的位置" v-model="form.notes" />
        <button class="video-more-toggle" :class="{ 'video-more-toggle-dark': isDark }" role="button"
          :aria-label="showMore ? '收起更多信息' : '更多信息'" :aria-expanded="showMore" @click="showMore = !showMore">
          <text class="video-more-label" :style="appTextColor()">更多信息</text>
          <AppIcon :name="showMore ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="14" />
        </button>
        <view v-if="showMore" class="video-more-fields">
          <FormField appearance="soft" label="UP主" v-model="form.ownerName" />
          <FormField appearance="soft" label="封面链接" v-model="form.cover" />
          <view class="ui-field-row">
            <FormField appearance="soft" compact stretch label="总集数" input-type="number" v-model="form.episodes" />
            <FormField appearance="soft" compact stretch label="总时长" placeholder="00:00:00（时:分:秒）" v-model="durationInput" />
          </view>
          <view class="ui-field-row">
            <FormField appearance="soft" compact stretch label="最近观看日期" kind="date" v-model="form.date" />
            <FormField appearance="soft" compact stretch label="最近观看时间" kind="time" v-model="form.time" />
          </view>
          <FormField appearance="soft" label="视频简介" kind="textarea" textarea-size="compact" v-model="form.description" />
        </view>
        <text v-if="formError" class="error ui-section ui-type-body" role="alert">{{ formError }}</text>
        <template #footer><FormActions>
          <template #secondary><ConfirmAction v-if="form.id" label="删除视频" :action="() => remove(form)" /><MobileButton v-if="canPlay(form.url)" label="播放视频" icon="ant-design:play-circle-outlined" variant="quiet" @click="play(form.url)" /></template>
          <MobileButton label="取消" variant="quiet" :disabled="saving || parsing"
            @click="formRevision++; form = null;" />
          <MobileButton :label="saved ? '重新读取' : '保存'" :loading="saving" :disabled="parsing" @click="save" />
        </FormActions></template></AdaptiveModal></view>
    <template #fixed><FloatingActionButton label="新增视频" :disabled="loading || !!error" @click="open()" /></template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';

@use '../../styles/spacing-tokens' as *;
.video-link-row { align-items: flex-end; }
.video-field-context { @include type-style('caption'); color: $text-secondary-light; }
.video-more-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0 0 $space-form;
  padding: 0;
  background-color: transparent;
  color: $text-secondary-light;
}
.video-more-toggle-dark { color: $text-secondary-dark; }
.video-more-label { @include type-style('label'); }
.video-more-toggle { @include borderless-button; }
.video-page {
  color: #27272a;
}
.video-page-dark {
  color: #eeeeef;
}
.toolbar,
.metrics {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.card {
  border-radius: 16px;
  background-color: #ffffff;
}
.card-dark {
  background-color: #1c1e22;
}
.title {
  flex: 1;
  @include type-style('title');

}
.secondary {
  @include type-style('label');
  color: $text-secondary-light;
}
.cover {
  width: 100%;
  height: 120px;
  flex-shrink: 0;
}
.error {
  color: #e05252;
}
</style>

<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing-tokens' as *;
@include type-utilities('label', 'body');

.video-summary { position: relative; align-items: stretch; flex-wrap: wrap; }
.summary-panel { flex: 1; min-width: 140px; margin: 0; gap: $space-inline; background-color: #fff; border-radius: 12px; }
.summary-panel-dark { background-color: #1c1e22; }
.summary-number { @include type-style('metric');  }
.status-scroll { width: 100%; }

.video-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-section; }
.video-card { box-sizing: border-box; width: calc((100% - #{$space-section}) / 2); background-color: #fff; border-radius: 8px; overflow: hidden; }
.video-card-dark { background-color: #1c1e22; }
.video-poster { position: relative; height: 0; padding-top: 62.5%; background-color: #eef0f3; }
.video-status, .video-duration { position: absolute; background-color: #427bea; color: white; padding: $space-detail; @include type-style('badge'); }
.video-status { top: $space-detail; left: $space-detail; border-radius: 4px; }
.video-duration { bottom: $space-detail; right: $space-detail; background-color: #0008; }
.video-body { padding: $space-card; display: flex; flex-direction: column; gap: $space-inline; }
.video-title {
@include clamp-text(2);
 overflow: hidden; @include type-style('body-strong'); min-height: type-line('body-strong') * 2; }
.video-meta { justify-content: space-between; gap: $space-detail; }
.video-meta-text { color: $text-secondary-light; @include type-style('caption'); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.episode { flex-shrink: 0; color: #427bea; @include type-style('badge'); }
.progress-track { height: 5px; background-color: #eef0f3; border-radius: 5px; overflow: hidden; }
.progress-fill { height: 5px; background-color: #427bea; }
/* #ifdef WEB */
.video-card:focus-visible { outline: 2px solid #427bea; outline-offset: $space-micro; }
/* #endif */
@media (min-width: 600px) { .video-card { width: calc((100% - #{$space-section} * 2) / 3); } }
@media (min-width: 1000px) { .video-card { width: calc((100% - #{$space-section} * 3) / 4); } }
.summary-duration { @include type-style('metric-compact'); }
.cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.video-cover-empty { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.video-poster-dark, .progress-track-dark { background-color: #292d35; }
.video-status-completed { background-color: #22a06b; }
.video-status-on_hold { background-color: #b87925; }
.video-status-not_started { background-color: #737e90; }

.record-secondary-dark { color: $text-secondary-dark; }
</style>

<style scoped lang="scss">
@use '../../styles/spacing-tokens' as *;
.summary-pending { opacity: 0.65; }
.summary-value-pending { color: transparent; background-color: #e8ecf1; border-radius: 4px; }
.summary-value-pending-dark { background-color: #30343c; }
.summary-retry { position: absolute; right: $space-detail; top: $space-detail; }
.video-skeleton-line { color: transparent; background-color: #e8ecf1; border-radius: 4px; }
.video-skeleton-line-dark { background-color: #30343c; }
</style>
