<script setup lang="ts">
import CategoryTabs from "../../components/CategoryTabs.uvue";
import CategoryPager from '../../components/CategoryPager.uvue';
import { readPageTotal, mergePageItems, hasMorePageItems } from '../../services/pagination.ts';
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { usePageRefresh } from '../../services/page-refresh.ts'
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import { computed, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import CategoryIcon from '../../components/CategoryIcon.uvue';
import CategoryAppearancePicker from './CategoryAppearancePicker.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { isDark, themeClass } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import {
  fetchCategoryTypes,
  fetchCategoryPage,
  saveCategory,
  deleteCategory,
} from './services/exercise.ts';
const pager = ref(null);
const categoryCache = ref<Record<string, any>>({});
const rows = ref<any[]>([]),
  types = ref<any[]>([]),
  type = ref('exercise_type'),
  loading = ref(false),
  error = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref(''),
  busyId = ref(''),
  saved = ref(false);
const statusFilter = ref('全部');
const refreshing = ref(false);
const loadedType = ref('');
const editingIndex = computed(() => form.value?.id ? rows.value.findIndex((item) => item.id === form.value.id) : -1);
const categoryTabs = computed(() => types.value.filter((item) => item.value !== 'bank_tag'));
const categoryIndex = computed(() => Math.max(0, categoryTabs.value.findIndex((item) => item.value === type.value)));
let generation = 0;
const scope = createRecordScope((clear) => {
  form.value = null;
  if (clear) {
    rows.value = [];
    types.value = [];
    loadedType.value = '';
    categoryCache.value = {};
  }
});
const refreshOnShow = usePageRefresh(() => { categoryCache.value = {}; return load(); }, { loading: () => loading.value, error: () => error.value, keys: () => ['userDictData', 'userDictType'] })
onShow(() => refreshOnShow());
function selectType(value: string) {
  if (type.value === value || form.value || busyId.value || saving.value) return;
  if (loadedType.value === type.value) categoryCache.value[type.value] = { rows: rows.value, loaded: true, error: error.value };
  generation++;
  type.value = value;
  const cached = categoryCache.value[value];
  rows.value = cached?.rows || [];
  loadedType.value = cached?.loaded ? value : '';
  error.value = cached?.error || '';
  loading.value = false;
  if (!cached?.loaded || cached.error) void load();
}
const categoryPages = computed(() => (categoryTabs.value.length ? categoryTabs.value : [{ value: type.value, label: '分类' }]).map(tab => {
  const state = tab.value === type.value ? { rows: rows.value, loaded: loadedType.value === type.value, loading: loading.value, error: error.value } : categoryCache.value[tab.value] || { rows: [], loaded: false, error: '' };
  return { ...tab, ...state, filtered: state.rows.filter(item => statusFilter.value === '全部' || (statusFilter.value === '已启用' ? item.isEnabled === 1 : item.isEnabled === 0)) };
}));
async function refresh() {
  if (refreshing.value) return;
  refreshing.value = true;
  categoryCache.value = {};
  try {
    await load();
  } finally {
    refreshing.value = false;
  }
}
async function load() {
  const current = ++generation;
  const selectedType = type.value;
  loading.value = true;
  error.value = '';
  try {
    const options = await scope.wait(fetchCategoryTypes());
    let data = [];
    let page = 1;
    while (true) {
      const result = await scope.wait(fetchCategoryPage(page++, selectedType));
      if (current !== generation) return;
      const total = readPageTotal(result.total);
      data = mergePageItems(data, result.items);
      if (!hasMorePageItems(data.length, total, result.items.length === 0)) break;
    }
    if (current === generation) {
      types.value = options;
      rows.value = data.sort((a, b) => Number(a.sortOrder || 0) - Number(b.sortOrder || 0));
      loadedType.value = selectedType;
    }
  } catch (e) {
    if (e.name !== 'PageInactiveError' && current === generation) error.value = e.message;
  } finally {
    if (current === generation) loading.value = false;
  }
}
function open(item = null) {
  if (pager.value?.ignoreClick()) return;
  saved.value = false;
  formError.value = '';
  form.value = item
    ? { ...item, sortOrder: String(item.sortOrder ?? 0) }
    : {
        dictType: type.value,
        dictLabel: '',
        dictValue: '',
        color: '#4ecdc4',
        icon: '',
        sortOrder: String((rows.value.length + 1) * 10),
        isEnabled: 1,
        remark: '',
      };
}
async function save() {
  if (saving.value || busyId.value || loading.value) return;
  if (missingRequired('recordCategory', form.value)) {
    formError.value = '请输入分类名称';
    return;
  }
  const sort = Number(form.value.sortOrder);
  if (!Number.isInteger(sort) || sort < 0) {
    formError.value = '排序必须是非负整数';
    return;
  }
  saving.value = true;
  formError.value = '';
  try {
    if (!saved.value) {
      await scope.wait(saveCategory({ ...form.value, sortOrder: sort }));
      saved.value = true;
    }
    await load();
    if (error.value) throw new Error(error.value);
    form.value = null;
  } catch (e) {
    if (e.name !== 'PageInactiveError') formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function toggle(item, enabled: boolean) {
  if (busyId.value || loading.value) return;
  const selectedType = type.value;
  busyId.value = item.id;
  error.value = '';
  try {
    await scope.wait(saveCategory({ ...item, isEnabled: enabled ? 1 : 0 }));
    if (type.value === selectedType) {
      rows.value = rows.value.map((row) => row.id === item.id ? { ...row, isEnabled: enabled ? 1 : 0 } : row);
    }
  } catch (e) {
    if (e.name !== 'PageInactiveError' && type.value === selectedType) error.value = e.message;
  } finally {
    busyId.value = '';
  }
}
async function remove(item) {
  await scope.wait(deleteCategory(item.id));
  await load();
  if (error.value) throw new Error(error.value);
}
async function move(index, offset) {
  if (busyId.value || saving.value || loading.value) return;
  const item = rows.value[index],
    other = rows.value[index + offset];
  if (!item || !other || item.isReadonly === 'Y' || other.isReadonly === 'Y') return;
  const movedId = item.id;
  busyId.value = movedId;
  formError.value = '';
  try {
    const ordered = [...rows.value];
    [ordered[index], ordered[index + offset]] = [ordered[index + offset], ordered[index]];
    for (let i = 0; i < ordered.length; i++) {
      if (ordered[i].isReadonly === 'Y') continue;
      await scope.wait(saveCategory({ ...ordered[i], sortOrder: i * 10 }));
    }
    // 同步已保存的顺序，避免并发刷新使表单回填旧排序。
    if (form.value?.id === movedId) form.value = { ...form.value, sortOrder: String((index + offset) * 10) };
    await load();
    if (error.value) formError.value = error.value;
  } catch (e) {
    if (e.name !== 'PageInactiveError') formError.value = e.message;
  } finally {
    busyId.value = '';
  }
}
function cannotMove(offset: number) {
  const index = editingIndex.value;
  return loading.value || saving.value || !!busyId.value || index < 0 || !rows.value[index + offset]
    || rows.value[index]?.isReadonly === 'Y' || rows.value[index + offset]?.isReadonly === 'Y';
}
</script>
<template>
  <MobilePage :scroll-locked="true" :refresh-disabled="true"
    ><view class="categories-page ui-page-body" :class="{ 'categories-page-dark': isDark }"
      ><PageHeader title="分类管理" :back="true" @back="uni.navigateBack()" /><view class="ui-toolbar"
        ><CategoryTabs class="category-type-scroll" :items="categoryTabs" :current="categoryIndex" variant="underline" label="分类类型" id-prefix="category-type" item-class="category-type-tab" :disabled="!!form || !!busyId || saving" @change="selectType(categoryTabs[$event].value)" /></view>
      <FormField label="状态" kind="selector" :options="['全部', '已启用', '已禁用']" v-model="statusFilter" />
      <CategoryPager ref="pager" :items="categoryPages" :current="categoryIndex" :disabled="!!form || !!busyId || saving" :refreshing="refreshing" tabs-selector=".category-type-scroll" @change="selectType(categoryPages[$event].value)" @refresh="refresh"><template #default="{ item: categoryPage, active }">
      <view class="category-list" :class="{ 'category-page-active': active }">
        <PageState :loading="categoryPage.loading || (!categoryPage.loaded && !categoryPage.error)" :has-content="categoryPage.loaded" :error="categoryPage.error" :empty="!categoryPage.filtered.length" empty-text="暂无符合条件的分类" @retry="load">
          <template #refreshing>
            <view v-if="!refreshing" class="category-update-progress" role="status" aria-label="正在更新分类">
              <view class="category-update-runner" :class="{ 'category-update-runner-dark': isDark }" />
            </view>
          </template>
          <template #loading>
            <view class="category-loading" role="status" aria-label="正在加载分类" aria-live="polite">
              <!-- 使用明确的循环变量名，避免与微信编译器生成的主题字段重名。 -->
              <view v-for="skeletonRowIndex in 5" :key="skeletonRowIndex" class="category-row category-row-skeleton" :class="themeClass('category-row')" aria-hidden="true">
                <view class="category-placeholder category-placeholder-icon" :class="themeClass('category-placeholder')" />
                <view class="category-copy">
                  <view class="category-placeholder category-placeholder-name" :class="themeClass('category-placeholder')" />
                </view>
                <view class="category-actions">
                  <view v-for="skeletonActionIndex in 3" :key="skeletonActionIndex" class="category-placeholder-action">
                    <view class="category-placeholder category-placeholder-icon" :class="themeClass('category-placeholder')" />
                  </view>
                </view>
              </view>
            </view>
          </template>
          <view v-for="item in categoryPage.filtered" :key="item.id" class="category-row" :class="{ 'category-row-dark': isDark }">
            <CategoryIcon :icon="item.icon" :color="item.color" />
            <view class="category-copy">
              <text class="category-name" :class="{ 'category-name-dark': isDark, 'category-name-disabled': item.isEnabled === 0, 'category-name-disabled-dark': item.isEnabled === 0 && isDark }">{{ item.dictLabel }}</text>
              <text v-if="item.isReadonly === 'Y'" class="secondary" :class="{ 'record-secondary-dark': isDark }">只读分类</text>
            </view>
            <view class="category-actions">
              <MobileSwitch :checked="item.isEnabled === 1" :disabled="!!busyId || loading"
                :loading="busyId === item.id" :aria-label="'启用分类：' + item.dictLabel"
                @change="toggle(item, $event.detail.value)" />
              <MobileButton label="编辑分类" icon="ant-design:edit-outlined" variant="ghost"
                :disabled="item.isReadonly === 'Y' || !!busyId || loading" @click="open(item)" />
              <ConfirmAction label="删除分类" :message="item.userId === '0' ? '公共分类会在你的分类列表中停用' : '确认删除分类？'" :action="() => remove(item)">
                <template #default="{ open: confirmRemove, busy }">
                  <MobileButton label="删除分类" icon="ant-design:delete-outlined" variant="ghost"
                    :loading="busy" :disabled="!!busyId || loading" @click="confirmRemove" />
                </template>
              </ConfirmAction>
            </view>
          </view>
        </PageState>
      </view></template></CategoryPager>
    </view>
    <template #fixed>
      <FloatingActionButton v-if="!form" label="新增分类" :disabled="loading || !!error || !!busyId" @click="open()" />
      <AdaptiveModal v-if="form" :label="form.id ? '编辑分类' : '新增分类'" :busy="saving || !!busyId" @close="form = null"
        ><FormField :required="isRequired('recordCategory', 'dictLabel')" label="名称" v-model="form.dictLabel" /><FormField
          label="分类标识"
          v-model="form.dictValue" />
        <CategoryAppearancePicker v-model:icon="form.icon" v-model:color="form.color" :disabled="saving || !!busyId" />
        <view class="ui-field-row">
          <FormField compact stretch label="排序" input-type="number" v-model="form.sortOrder" />
          <FormField compact stretch label="状态" kind="selector" :model-value="form.isEnabled === 0 ? '停用' : '启用'" :options="['启用', '停用']" @update:model-value="form.isEnabled = $event === '停用' ? 0 : 1" />
        </view>
        <FormField
          label="备注"
          kind="textarea"
          v-model="form.remark" /><text v-if="formError" class="error ui-section ui-type-body">{{ formError }}</text
        ><template #footer><FormActions>
          <template #secondary>
            <MobileButton v-if="form.id" label="上移分类" icon="ant-design:arrow-up-outlined" variant="ghost"
              :disabled="cannotMove(-1)" @click="move(editingIndex, -1)" />
            <MobileButton v-if="form.id" label="下移分类" icon="ant-design:arrow-down-outlined" variant="ghost"
              :disabled="cannotMove(1)" @click="move(editingIndex, 1)" />
          </template>
          <MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving || !!busyId"
            @click="form = null" /><MobileButton
            :label="saved ? '重新读取' : '保存'"
            :loading="saving"
            :disabled="!!busyId || loading"
            @click="save" />
        </FormActions></template></AdaptiveModal>
    </template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.categories-page {
  color: #27272a;
}
.categories-page-dark {
  color: #eeeeef;
}
.category-type-scroll {
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;
  white-space: nowrap;
}

.category-list {
  // 末行滚动到顶部后，仍可避开通用悬浮新增按钮。
  padding-bottom: 80px;
}
// 更新进度放在列表上方已有的间距内，不覆盖分类操作，也不改变内容高度。
.category-update-progress { position: absolute; top: -$space-inline; left: 0; right: 0; height: $space-micro; overflow: hidden; pointer-events: none; }
.category-update-runner { width: 30%; height: 100%; background-color: #7198df; border-radius: $space-micro; animation: category-update-slide 1.35s ease-in-out infinite; }
.category-update-runner-dark { background-color: #91b4ff; }
@keyframes category-update-slide { from { transform: translateX(-100%); } to { transform: translateX(434%); } }
.category-row {
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  padding: $space-inline $space-card;
  margin-bottom: $space-inline;
  border-radius: 12px;
  background-color: #ffffff;
}
.category-row-dark { background-color: #1c1e22; }
.category-copy { flex: 1; min-width: 0; gap: $space-detail; }
.category-name {
  color: #27272a;
  overflow-wrap: anywhere;
  @include type-style('body-strong');
}
.category-name-dark { color: #eeeeef; }
.category-name-disabled { color: $text-secondary-light; }
.category-name-disabled-dark { color: $text-secondary-dark; }
.category-actions { flex-direction: row; align-items: center; flex-shrink: 0; gap: $space-detail; }
.category-loading { animation: category-skeleton-breathe 1.8s ease-in-out infinite; }
.category-row-skeleton { min-height: $space-controlMin + $space-inline * 2; box-sizing: border-box; }
.category-placeholder { background-color: #e8ecf1; border-radius: 5px; flex-shrink: 0; }
.category-placeholder-dark { background-color: #30343c; }
.category-placeholder-icon { width: 24px; height: 24px; flex-shrink: 0; }
.category-placeholder-name { width: 72%; height: 16px; }
.category-placeholder-action { width: $space-controlMin; align-items: center; justify-content: center; }
@keyframes category-skeleton-breathe { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) { .category-loading { animation: none; } }
/* #endif */
.category-status-row { align-items: flex-end; }
.category-icon-preview { min-height: $space-controlMin; width: $space-controlMin; align-items: center; justify-content: center; }
.secondary {
  color: $text-secondary-light;
  @include type-style('label');
}
.error {
  color: #e05252;
}

.record-secondary-dark { color: $text-secondary-dark; }
</style>
