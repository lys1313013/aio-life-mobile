<script setup lang="ts">
import AnniversaryRecordEditor from '../../components/record-editors/AnniversaryRecordEditor.uvue';
import { appTextColor } from '../../services/app-layout.ts'

import { buttonLabelClasses } from '../../services/button-label.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onUnmounted, ref } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isDark } from '../../services/theme.ts';
import {
  fetchEvents,
  deleteEvent,
  setAnniversaryPinned,
  daysFromToday,
} from './services/events.ts';
const rows = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  form = ref<any>(null);
const colors = [
  'from-pink-400 to-rose-500',
  'from-cyan-400 to-blue-500',
  'from-orange-400 to-red-500',
  'from-purple-400 to-indigo-500',
  'from-emerald-400 to-teal-500',
  'from-gray-700 to-gray-900',
];
const gradients = [
  ['#f472b6', '#f43f5e'],
  ['#22d3ee', '#3b82f6'],
  ['#fb923c', '#ef4444'],
  ['#c084fc', '#6366f1'],
  ['#34d399', '#14b8a6'],
  ['#374151', '#111827'],
];
const activeMenu = ref('');
const pinningId = ref('');
let pendingEditId = '';
onLoad((query) => {
  pendingEditId = String(query?.editId || '');
  if (query?.create === '1') {
    open();
    form.value.isPinned = query?.home === '1' ? 1 : 0;
  }
});
const sortedRows = computed(() => [...rows.value].sort((a, b) =>
  Math.abs(daysFromToday(a.targetDate)) - Math.abs(daysFromToday(b.targetDate)),
));
function cardStyle(color) {
  const palette = gradients[colors.indexOf(color)] || gradients[0];
  return { backgroundColor: palette[1], backgroundImage: `linear-gradient(135deg, ${palette[0]}, ${palette[1]})` };
}
const emoji = ['🎉', '🎂', '❤️', '💍', '🎓', '👶', '🏠', '🚗', '✈️', '💼', '💪', '🌟'];
const scope = createRecordScope((clearData) => {
  form.value = null;
  activeMenu.value = '';
  if (clearData) rows.value = [];
});
let alive = true,
  generation = 0;
onUnmounted(() => {
  alive = false;
  generation++;
});
onShow(() => load());
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    const data = await scope.wait(fetchEvents('anniversary'));
    if (alive && current === generation) {
      rows.value = data;
      if (pendingEditId) {
        const item = data.find((row) => row.id === pendingEditId);
        pendingEditId = '';
        if (item) open(item);
        else uni.showToast({ title: '纪念日已删除或不可访问', icon: 'none' });
      }
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  if (pinningId.value) return;
  activeMenu.value = '';
  form.value = item
    ? { ...item, isPinned: item.isPinned === 1 ? 1 : 0 }
    : {
        title: '',
        isPinned: 0,
        targetDate: new Date().toLocaleDateString('sv-SE'),
        note: '',
        color: colors[0],
        icon: emoji[0],
      };
}
function saved(row) {
  const index = rows.value.findIndex(item => item.id === row.id);
  if (index >= 0) rows.value[index] = row;
  else rows.value.push(row);
  form.value = null;
}
function deleted(id) {
  rows.value = rows.value.filter(row => row.id !== id);
  form.value = null;
}
async function togglePinned(item) {
  if (pinningId.value) return;
  pinningId.value = item.id;
  try {
    const saved = await scope.wait(setAnniversaryPinned(item.id, item.isPinned === 1 ? 0 : 1));
    const index = rows.value.findIndex((row) => row.id === item.id);
    if (index >= 0) rows.value[index] = { ...rows.value[index], ...saved };
  } catch (e) {
    if (e.name !== 'PageInactiveError') uni.showToast({ title: e.message || '固定失败，请重试', icon: 'none' });
  } finally {
    pinningId.value = '';
  }
}
async function remove(item) {
  await scope.wait(deleteEvent('anniversary', item.id));
  rows.value = rows.value.filter((r) => r.id !== item.id);
}
</script>
<template>
  <view class="anniversary-shell">
    <PageHeader title="纪念日" :back="true" @back="uni.navigateBack()" />
    <MobilePage :refreshing="refreshing" @refresh="load(true)">
      <view class="event-page ui-page-body" :class="{ 'event-page-dark': isDark }">
        <view v-if="activeMenu" class="menu-dismiss" @click="activeMenu = ''" />
        <PageState skeleton="list" :loading="loading" :error="error" :empty="!rows.length" @retry="load()">
<template #loading><view class="event-grid ui-gap-md" ><view v-for="n in 6" :key="n" class="event-card ui-pad-card ui-gap-sm" :style="cardStyle('')"><ContentSkeleton variant="date-tile" /></view></view></template>

          <view class="event-grid ui-gap-md">
            <view v-for="item in sortedRows" :key="item.id" class="event-card ui-pad-card ui-gap-sm"
              :class="{ 'event-card-active': activeMenu === item.id }" :style="cardStyle(item.color)">
              <view class="event-card-header">
                <text class="event-emoji">{{ item.icon || '🎉' }}</text>
                <view class="event-actions ui-row"><button class="event-more ui-type-body" role="button" :aria-label="item.isPinned === 1 ? '取消固定到首页' : '固定到首页'" :loading="pinningId === item.id" :disabled="!!pinningId" @click="togglePinned(item)"><AppIcon v-if="pinningId !== item.id" :name="item.isPinned === 1 ? 'ant-design:pushpin-filled' : 'ant-design:pushpin-outlined'" :size="20" color="#ffffff" /></button><button class="event-more ui-type-body" role="button" :aria-label="'更多操作：' + item.title"
                  :aria-expanded="activeMenu === item.id" aria-haspopup="true"
                  @click="activeMenu = activeMenu === item.id ? '' : item.id">
                  <view class="more-dot" /><view class="more-dot" /><view class="more-dot" />
                </button></view>
              </view>
              <view v-if="activeMenu === item.id" class="event-menu ui-pad-xs" :class="{ 'event-menu-dark': isDark }">
                <button :style="appTextColor()" class="event-menu-item" role="button" aria-label="编辑纪念日" @click="open(item)"><text :class="buttonLabelClasses(['event-menu-item'])">编辑</text></button>
                <ConfirmAction label="删除纪念日" :message="'确定删除“' + item.title + '”？'"
                  :action="() => remove(item)" @success="activeMenu = ''">
                  <template #default="{ open: confirmDelete, busy }">
                    <button :style="appTextColor()" class="event-menu-item event-menu-delete" role="button" aria-label="删除纪念日"
                      :loading="busy" :disabled="busy" @click="confirmDelete"><text :class="buttonLabelClasses(['event-menu-item event-menu-delete'])">删除</text></button>
                  </template>
                </ConfirmAction>
              </view>
              <view class="event-count ui-section">
                <text class="event-label">{{ daysFromToday(item.targetDate) === 0 ? '就是今天' : daysFromToday(item.targetDate) > 0 ? '还有' : '已经' }}</text>
                <view class="count-row ui-gap-xs">
                  <text class="day-count">{{ Math.abs(daysFromToday(item.targetDate)) }}</text>
                  <text class="event-unit">天</text>
                </view>
              </view>
              <view class="event-details ui-gap-sm">
                <text class="event-title">{{ item.title }}</text>
                <text class="event-date">{{ item.targetDate }}</text>
                <text v-if="item.note" class="event-note">{{ item.note }}</text>
              </view>
            </view>
          </view>
        </PageState>
        <AnniversaryRecordEditor v-if="form" :record="form"  @close="form = null" @saved="saved" @deleted="deleted" />
      </view>
      <template #fixed><FloatingActionButton label="新增纪念日" @click="open()" /></template>
    </MobilePage>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.anniversary-shell {
  flex: 1;
  height: 100%;
  min-height: 0;
}
.event-page {
  padding-bottom: 80px;
  color: #27272a;
}
.event-page-dark { color: #eeeeef; }
.toolbar { flex-direction: row; align-items: center; }
.event-grid { flex-direction: row; flex-wrap: wrap; }
.event-card {
  box-sizing: border-box;
  position: relative;
  width: calc((100% - #{$space-section}) / 2);
  min-width: 0;
  border-radius: 16px;
  color: #ffffff;
}
.event-card-active { z-index: 101; }
.event-card-header { flex-direction: row; justify-content: space-between; align-items: center; }
.event-emoji { @include type-style('emoji'); line-height: $space-controlMin; }
.event-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: $space-tight;
  width: 44px;
  height: 44px;
  margin: (-$space-fieldLabel) (-$space-fieldLabel) (-$space-fieldLabel) 0;
  padding: 0;
  border: 0;
  border-radius: 22px;
  background-color: transparent;
}
.more-dot { width: 3px; height: 3px; border-radius: 2px; background-color: #ffffff; }
.menu-dismiss { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; }
.event-menu {
  position: absolute;
  top: 50px;
  right: $space-inline;
  z-index: 102;
  width: 128px;
  border-radius: 12px;
  background-color: #ffffff;
  color: #27272a;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.16);
}
.event-menu-dark { background-color: #292c32; color: #eeeeef; }
.event-menu-item {
  width: 120px;
  min-height: 44px;
  margin: 0;
  padding: 0 $space-card;
  border: 0;
  border-radius: 8px;
  background-color: transparent;

/* #ifndef APP */
color: inherit;
/* #endif */

  @include type-style('body');
  line-height: $space-controlMin;
  text-align: left;
}
.event-menu-delete { color: #e05260; }
.event-count { align-items: center; }
.event-label { @include type-style('caption'); opacity: 0.9; }
.count-row { flex-direction: row;
/* #ifndef APP */
align-items: baseline;
/* #endif */
/* #ifdef APP */
align-items: flex-end;
/* #endif */
 justify-content: center; }
.day-count { font-variant-numeric: tabular-nums; letter-spacing: type-tracking('display'); @include type-style('display');   }
.event-unit { @include type-style('label'); opacity: 0.8; }
.event-title {
/* #ifndef APP */
word-break: break-word;
/* #endif */
/* #ifdef APP */
word-break: break-all;
/* #endif */
 @include type-style('title');   }
.event-date { align-self: flex-start; border-radius: 4px; padding: $space-micro $space-detail; background-color: rgba(255,255,255,0.12); @include type-style('caption'); opacity: 0.9; }
.event-note { @include type-style('caption');  opacity: 0.8; }
.event-error { color: #e05252; }
/* #ifdef WEB || MP-WEIXIN */
.event-more::after, .event-menu-item::after { border: 0; }
/* #endif */
@media (min-width: 600px) {
  .event-grid { }
  .event-card { width: calc((100% - #{$space-section * 2}) / 3); }
  .day-count { font-variant-numeric: tabular-nums; letter-spacing: type-tracking('display'); @include type-style('display-wide');  }
}
@media (min-width: 1000px) { .event-card { width: calc((100% - #{$space-section * 3}) / 4); } }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.event-menu-item-label {
/* #ifndef APP */
color: inherit;
/* #endif */
 @include type-style('body'); text-align: left; }
.event-menu-delete-label {  color: #e05260; }
</style>
