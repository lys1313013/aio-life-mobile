<script setup lang="ts">
import ModalMotion from "../../components/ModalMotion.uvue";
import { useWindowResize } from '../../services/window-resize.ts'
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import { computed, getCurrentInstance, nextTick, onMounted, onUnmounted, ref, watch } from 'vue';
import AppIcon from '../../components/AppIcon.uvue';
import spacing from '../../styles/spacing.json';
import { categoryColor, isBidirectional, layoutGraph, layoutEdges, relationColor as getRelationColor } from './services/relationship-layout.ts';
import type { GraphDot } from './services/relationship-motion.ts';
import { createRelationshipMotion } from './services/relationship-motion.ts';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { fetchGraph } from './services/relationship.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { isDark, themeClass } from '../../services/theme.ts';
const graph = ref<any>({ nodes: [], edges: [] }),
  keyword = ref(''),
  searchOpen = ref(false),
  searchFocus = ref(false),
  selectedId = ref(''),
  loading = ref(false),
  loaded = ref(false),
  visible = ref(false),
  helpOpen = ref(false),
  error = ref('');
let stamp = 0, alive = true, navigating = false;
onUnmounted(() => {
  alive = false;
  stamp++;
});
const zoom = ref(1);
const panX = ref(0);
const panY = ref(0);
const instance = getCurrentInstance();
const initialWindow = uni.getWindowInfo();
const viewport = ref({ left: 0, top: 48, width: initialWindow.windowWidth, height: Math.max(1, initialWindow.windowHeight - 48) });
const pins = ref<Record<string, { x: number; y: number }>>({});
const layout = computed(() => layoutGraph(graph.value.nodes, graph.value.edges, viewport.value.width, viewport.value.height));
const graphNodes = computed(() => layout.value.nodes.map(node => ({ ...node, ...pins.value[node.id] })));
const graphEdges = computed(() => layoutEdges(graphNodes.value, graph.value.edges));
const graphLabels = computed(() => graphEdges.value.filter(edge => edge.showLabel && isFocused(edge)));
const categoryById = computed(() => new Map(graphNodes.value.map(node => [node.id, node.category])));
const connected = computed(() => {
  const ids = new Set([selectedId.value]);
  for (const edge of graphEdges.value) {
    if (edge.source === selectedId.value) ids.add(edge.target);
    if (edge.target === selectedId.value) ids.add(edge.source);
  }
  return ids;
});
const matches = computed(() => {
  const query = keyword.value.trim().toLocaleLowerCase();
  return query ? graph.value.nodes.filter(node => node.name.toLocaleLowerCase().includes(query)) : [];
});
const showMatches = computed(() => searchOpen.value && !!keyword.value.trim());
const motion = createRelationshipMotion();
const dots = ref<GraphDot[]>([]);
const reducedMotion = ref(false);
const canAnimate = computed(() => visible.value && graphEdges.value.length > 0 && !helpOpen.value && !reducedMotion.value);
let motionTimer = 0;
let previousFrame = 0;
let pathsChanged = false;
function syncMotion() {
  if (motionTimer) clearInterval(motionTimer);
  motionTimer = 0;
  if (!canAnimate.value) {
    dots.value = [];
    return;
  }
  previousFrame = Date.now();
  motionTimer = setInterval(() => {
    const now = Date.now();
    // #ifdef WEB
    if (document.hidden) { previousFrame = now; return; }
    // #endif
    dots.value = motion.step(Math.min(now - previousFrame, 100), zoom.value);
    previousFrame = now;
  }, 33);
}
watch(() => graph.value, () => { pathsChanged = true; }, { flush: 'sync' });
watch(graphEdges, edges => {
  motion.setPaths(edges, pathsChanged);
  pathsChanged = false;
}, { immediate: true });
watch(canAnimate, syncMotion);
let removeMotionPreference = () => {};
onMounted(() => {
  resizeGraph();
  // #ifdef WEB
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => { reducedMotion.value = preference.matches; };
  update();
  preference.addEventListener('change', update);
  removeMotionPreference = () => preference.removeEventListener('change', update);
  // #endif
});
onUnmounted(() => {
  removeMotionPreference();
  if (motionTimer) clearInterval(motionTimer);
});

function isFocused(edge: { source: string; target: string }) {
  return selectedId.value === edge.source || selectedId.value === edge.target;
}
function relationColor(type: string) { return getRelationColor(type, isDark.value); }
function lineColor(edge: { source: string; target: string; relationType: string }) {
  return isFocused(edge) ? relationColor(edge.relationType) : isDark.value ? '#abb4c0' : '#747575';
}
function fitGraph() {
  const frame = viewport.value;
  if (!graphNodes.value.length) return;
  const xs = graphNodes.value.map(node => node.x);
  const ys = graphNodes.value.map(node => node.y);
  const left = Math.min(...xs), right = Math.max(...xs);
  const top = Math.min(...ys), bottom = Math.max(...ys);
  const scale = Math.min(1, frame.width / (right - left + 88), frame.height / (bottom - top + 116));
  zoom.value = scale;
  panX.value = (frame.width - (left + right) * scale) / 2;
  panY.value = (frame.height - (top + bottom) * scale) / 2;
}
function resetGraph() {
  pins.value = {};
  selectedId.value = '';
  fitGraph();
}
async function resizeGraph() {
  await nextTick();
  if (!instance?.proxy) return;
  uni.createSelectorQuery().in(instance.proxy).select('.topology').boundingClientRect(rect => {
    if (!rect || Array.isArray(rect) || !rect.width || !rect.height) return;
    const changed = rect.width !== viewport.value.width || rect.height !== viewport.value.height;
    viewport.value = { left: rect.left, top: rect.top, width: rect.width, height: rect.height };
    if (changed) fitGraph();
  }).exec();
}
useWindowResize(resizeGraph);
function changeZoom(scale: number, x: number, y: number) {
  const next = Math.max(0.25, Math.min(3, zoom.value * scale));
  const ratio = next / zoom.value;
  panX.value = x - (x - panX.value) * ratio;
  panY.value = y - (y - panY.value) * ratio;
  zoom.value = next;
}
function graphWheel(event: any) {
  if (!Number.isFinite(event.deltaY)) return;
  changeZoom(Math.exp(-Math.max(-100, Math.min(100, event.deltaY)) * 0.0025),
    event.clientX - viewport.value.left, event.clientY - viewport.value.top);
}
let touchX = 0;
let touchY = 0;
let pinchDistance = 0;
let dragId = '';
let dragged = false;
const dragThreshold = 8;
function graphStart(event: any, id = '') {
  const touch = event.touches?.[0];
  if (!touch) return;
  closeSearch();
  const second = event.touches[1];
  touchX = touch.clientX;
  touchY = touch.clientY;
  pinchDistance = second ? Math.hypot(second.clientX - touchX, second.clientY - touchY) : 0;
  dragged = !!second;
  dragId = second ? '' : id;
}
function graphMove(event: any) {
  const touch = event.touches?.[0];
  if (!touch) return;
  const second = event.touches[1];
  if (second) {
    const distance = Math.hypot(second.clientX - touch.clientX, second.clientY - touch.clientY);
    if (distance && pinchDistance) changeZoom(distance / pinchDistance,
      (touch.clientX + second.clientX) / 2 - viewport.value.left,
      (touch.clientY + second.clientY) / 2 - viewport.value.top);
    pinchDistance = distance;
    dragged = true;
    dragId = '';
  } else if (pinchDistance) {
    pinchDistance = 0;
  } else {
    const dx = touch.clientX - touchX, dy = touch.clientY - touchY;
    if (dragged || Math.hypot(dx, dy) >= dragThreshold) {
      dragged = true;
      const node = dragId ? graphNodes.value.find(item => item.id === dragId) : null;
      if (node) {
        selectedId.value = dragId;
        pins.value = { ...pins.value, [dragId]: { x: node.x + dx / zoom.value, y: node.y + dy / zoom.value } };
      } else {
        panX.value += dx;
        panY.value += dy;
      }
    } else return;
  }
  touchX = touch.clientX;
  touchY = touch.clientY;
}
function graphEnd(event: any) {
  if (event.touches?.length) return;
  if (!dragged && dragId) {
    // #ifdef WEB
    if (event.cancelable) event.preventDefault();
    // #endif
    openPerson(dragId);
  }
  dragId = '';
  pinchDistance = 0;
}
function graphCancel() {
  dragged = true;
  dragId = '';
  pinchDistance = 0;
}
function graphClick(id: string, event: any) {
  // #ifdef WEB
  if (event.pointerType !== 'touch' && !event.sourceCapabilities?.firesTouchEvents) {
    openPerson(id);
    return;
  }
  // #endif
  if (!dragged) openPerson(id);
}
function navigatePerson(url: string, id = '') {
  if (!visible.value || navigating) return;
  closeSearch();
  if (id) selectedId.value = id;
  navigating = true;
  uni.navigateTo({
    url,
    complete: () => { navigating = false; },
  });
}
function openPerson(id: string) {
  navigatePerson('/pages/relationship/person?id=' + encodeURIComponent(id), id);
}
function addPerson() {
  navigatePerson('/pages/relationship/person-edit');
}
function closeSearch() {
  searchFocus.value = false;
  searchOpen.value = false;
}
async function toggleSearch() {
  if (searchOpen.value) {
    closeSearch();
    return;
  }
  searchOpen.value = true;
  await nextTick();
  if (!searchOpen.value) return;
  // #ifdef WEB
  const input = instance?.proxy?.$el?.querySelector?.('.search-input input');
  input?.setAttribute('aria-label', '搜索人物并定位');
  // #endif
  searchFocus.value = true;
}
function locate(id: string) {
  const node = graphNodes.value.find(item => item.id === id);
  if (!node) return;
  keyword.value = node.name;
  closeSearch();
  selectedId.value = id;
  panX.value = viewport.value.width / 2 - node.x * zoom.value;
  panY.value = viewport.value.height / 2 - node.y * zoom.value;
}
function clearSearch() {
  keyword.value = '';
  selectedId.value = '';
}
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await fetchGraph();
    if (alive && current === stamp) {
      graph.value = data;
      if (selectedId.value && !data.nodes.some(node => node.id === selectedId.value)) selectedId.value = '';
      const firstLoad = !loaded.value;
      loaded.value = true;
      if (firstLoad) fitGraph();
    }
  } catch (e) {
    if (alive && current === stamp) error.value = e.message;
  } finally {
    if (alive && current === stamp) {
      loading.value = false;
    }
  }
}
useDomainPage(
  (refresh) => {
    alive = true;
    visible.value = true;
    if (refresh) return load();
  },
  (clear) => {
    alive = false;
    stamp++;
    visible.value = false;
    if (clear) {
      graph.value = { nodes: [], edges: [] };
      loaded.value = false;
      pins.value = {};
      clearSearch();
    }
    graphCancel();
    closeSearch();
    helpOpen.value = false;
    loading.value = false;
  },
  { loading: () => loading.value, error: () => error.value, keys: () => ['relationships'] },
);
</script>
<template>
  <MobilePage full-bleed>
    <PageHeader title="关系图谱" back paper :actions-min-width="spacing.controlMin" @back="uni.navigateBack()">
      <template #actions>
        <MobileButton :label="searchOpen ? '收起人物搜索' : '展开人物搜索'" icon="lucide:search" variant="ghost"
          :aria-expanded="searchOpen" @click="toggleSearch" />
      </template>
    </PageHeader>
    <view class="graph-panel" :class="themeClass('graph-panel')" @click="closeSearch">
      <view
        class="topology"
        aria-label="关系拓扑图"
        @touchstart.stop="graphStart($event)"
        @touchmove.stop.prevent="graphMove"
        @touchend.stop="graphEnd"
        @touchcancel.stop="graphCancel"
        @wheel.prevent="graphWheel"
      >
        <view class="graph-world" :style="{ width: layout.width + 'px', height: layout.height + 'px', transform: 'translate(' + panX + 'px,' + panY + 'px) scale(' + zoom + ')' }">
          <view v-for="edge in graphEdges" :key="edge.index" class="graph-edge-layer" aria-hidden="true">
            <view
              v-for="(part, index) in edge.segments"
              :key="index"
              class="graph-link"
              :style="{ left: part.x + 'px', top: part.y + 'px', width: part.length + 'px',
                backgroundColor: lineColor(edge), opacity: isFocused(edge) ? 0.85 : selectedId ? 0.2 : 0.5,
                transform: 'rotate(' + part.angle + 'deg)' }"
            >
              <view v-if="isFocused(edge) && !isBidirectional(edge) && edge.source !== edge.target && part.length > 9"
                class="graph-arrow" :style="{ borderLeftColor: lineColor(edge) }" />
            </view>
          </view>
          <text v-for="edge in graphLabels" :key="edge.index" class="graph-edge-label" :class="themeClass('graph-edge-label')"
            :style="{ left: edge.labelX + 'px', top: edge.labelY + 'px', color: relationColor(edge.relationType) }">{{ edge.relationType }}</text>
          <view v-for="(dot, index) in dots" :key="index" class="graph-light" aria-hidden="true"
            :style="{ left: (dot.x - 1.6 / zoom) + 'px', top: (dot.y - 1.6 / zoom) + 'px',
              width: 3.2 / zoom + 'px', height: 3.2 / zoom + 'px', backgroundColor: categoryColor(categoryById.get(dot.target), isDark) }" />
          <button
            v-for="node in graphNodes"
            :key="node.id"
            hover-class="none"
            role="button"
            class="graph-node-button"
            :class="{ 'graph-node-muted': selectedId && !connected.has(node.id) }"
            :aria-label="node.name"
            :aria-pressed="selectedId === node.id"
            :style="{ left: node.x - 34 + 'px', top: node.y - 32 + 'px' }"
            @touchstart.stop="graphStart($event, node.id)"
            @click.stop="graphClick(node.id, $event)"
          >
            <view class="graph-node-visual">
              <view class="graph-node-marker">
                <view class="graph-node-dot" :style="{ width: node.radius * 2 + 'px', height: node.radius * 2 + 'px', backgroundColor: categoryColor(node.category, isDark) }" />
              </view>
              <text class="node-name" :class="[themeClass('node-name'), { 'node-name-selected': selectedId === node.id }]"
                :style="{ bottom: 22 + node.radius + spacing.detail + 'px' }">{{ node.name }}</text>
            </view>
          </button>
        </view>
      </view>

      <view v-if="loaded && !graphNodes.length" class="graph-empty">
        <text class="detail-caption" :class="themeClass('detail-caption')">暂无人物</text>
      </view>
      <view class="graph-state" :class="{ 'graph-state-overlay': loaded }">
        <PageState
          :loading="loading"
          :has-content="loaded"
          :error="error"
          :style="loaded && (loading || error) ? { minHeight: spacing.controlMin + 'px' } : {}"
          @retry="load"
        >
          <template #loading><LoadingIndicator ring label="正在加载关系图谱" /></template>
        </PageState>
      </view>

      <view class="graph-search" :class="{ 'graph-search-open': searchOpen }" @click.stop @keydown.esc="closeSearch">
        <view class="search-box" :class="[{ 'search-box-open': searchOpen }, themeClass({ 'search-box-open': searchOpen })]">
          <view class="search-entry" :class="{ 'search-entry-open': searchOpen }" :aria-hidden="!searchOpen">
            <input class="search-input" :class="themeClass('search-input')" aria-label="搜索人物并定位" placeholder="搜索"
              v-model="keyword" confirm-type="search" :disabled="!searchOpen" :focus="searchFocus"
              @confirm="matches.length && locate(matches[0].id)" />
            <MobileButton v-if="searchOpen && keyword" label="清空搜索" icon="ant-design:close-outlined" variant="ghost" @click="clearSearch" />
          </view>
        </view>
        <scroll-view v-if="showMatches" scroll-y direction="vertical" class="search-results" :class="themeClass('search-results')"
          :style="{ height: Math.max(1, Math.min(matches.length, 5)) * spacing.controlMin + 'px' }">
          <button v-for="item in matches" :key="item.id" class="search-result" :class="themeClass('search-result')"
            hover-class="none" role="button" :aria-label="item.name" @click="locate(item.id)">
            <view class="search-result-dot" :style="{ backgroundColor: categoryColor(item.category, isDark) }" />
            <text class="search-result-name">{{ item.name }}</text>
          </button>
          <text v-if="!matches.length" class="search-empty" :class="themeClass('search-empty')">未找到匹配人物</text>
        </scroll-view>
      </view>

      <view v-if="graphNodes.length" class="graph-tools" :class="themeClass('graph-tools')" aria-label="图谱工具">
        <MobileButton label="适应画布" icon="ant-design:fullscreen-outlined" variant="ghost" @click="fitGraph" />
        <MobileButton label="重置布局" icon="ant-design:reload-outlined" variant="ghost" @click="resetGraph" />
        <MobileButton label="图谱操作说明" icon="ant-design:question-circle-outlined" variant="ghost" @click="helpOpen = true" />
      </view>
    </view>
    <template #fixed>
      <FloatingActionButton full-width label="新增人物" :right="spacing.overlayBlock" :bottom="spacing.overlayBlock" @click="addPerson" />
    </template>
    <ModalMotion><AdaptiveModal v-if="helpOpen" label="图谱操作说明" :max-width="380" @close="helpOpen = false">
      <text class="detail detail-ink" :class="themeClass('detail-ink')">轻点人物查看详情，拖动可调整人物位置。拖动画布可平移，双指或滚轮可缩放。</text>
    </AdaptiveModal></ModalMotion>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/theme-tokens' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('label', 'body', 'badge');

.graph-panel { position: relative; flex: 1; min-height: 0; overflow: hidden; background-color: $theme-surface-light; }
.graph-panel-dark { background-color: $theme-surface-dark; }
.topology { position: absolute; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; }
/* 拖动的人物和连线可以越过世界坐标边界，由外层画布裁切。 */
.graph-world { position: absolute; transform-origin: 0 0; overflow: visible; }
.graph-edge-layer { position: absolute; top: 0; right: 0; bottom: 0; left: 0; overflow: visible; pointer-events: none; }
.graph-link { position: absolute; height: $space-hairline; transform-origin: 0 0; pointer-events: none; overflow: visible; }
.graph-arrow { position: absolute; right: 0; top: -3px; width: 0; height: 0; border-top: 3px solid transparent; border-bottom: 3px solid transparent; border-left: 5px solid; }
.graph-edge-label { position: absolute; @include type-style('badge'); white-space: nowrap; transform: translate(-50%, -50%); padding: 0 $space-detail; background-color: $theme-surface-light; pointer-events: none; }
.graph-edge-label-dark { background-color: $theme-surface-dark; }
.graph-light { position: absolute; border-radius: 50%; pointer-events: none; opacity: 0.85; }
/* 68 × 54 的点击区覆盖圆点和姓名，布局的碰撞间距预留相同高度。 */
.graph-node-button { position: absolute; display: flex; width: 68px; height: 54px; min-height: 54px; margin: 0; padding: 0; overflow: visible; @include button-background(transparent); }
.graph-node-muted { opacity: 0.42; }
.graph-node-visual { position: relative; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.graph-node-marker { position: absolute; top: 10px; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; }
.graph-node-dot { border-radius: 50%; pointer-events: none; }
.node-name { position: absolute; left: 0; right: 0; @include block-content; @include type-style('label'); text-align: center; color: #263248; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none; }
.node-name-dark { color: #e7e9ee; }
.node-name-selected { @include type-style('label-strong'); }
/* #ifdef WEB */
.topology { touch-action: none; }
.node-name { text-shadow: 0 0 3px $theme-surface-light, 0 0 5px $theme-surface-light; }
.node-name-dark { text-shadow: 0 0 3px $theme-surface-dark, 0 0 5px $theme-surface-dark; }
/* #endif */
.graph-state, .graph-empty { position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%); align-items: center; }
.graph-empty { pointer-events: none; }
.graph-state-overlay { top: $space-detail; left: $space-detail; right: auto; width: $space-controlMin + $space-detail; transform: none; z-index: 1; }
.graph-search {
  position: absolute;
  top: $space-card;
  right: $space-overlayInline;
  width: 0;
  max-width: 66%;
  z-index: 3;
  pointer-events: none;
  transition: width 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.graph-search-open { width: 208px; pointer-events: auto; }
.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: $space-controlMin;
  overflow: hidden;
  border: $space-hairline solid transparent;
  border-radius: 12px;
  background-color: transparent;
  transition-property: background-color, border-color;
  transition-duration: 220ms;
  transition-timing-function: ease-out;
}
.search-box-open { background-color: $theme-surface-light; border-color: #e1e4ea; }
.search-box-open-dark { background-color: $theme-surface-dark; border-color: #363941; }
.search-entry { flex: 1; min-width: 0; flex-direction: row; align-items: center; overflow: hidden; opacity: 0; transition: opacity 180ms ease-out; }
.search-entry-open { opacity: 1; }
.search-input { flex: 1; min-width: 0; height: $space-controlMin; margin-left: $space-card; @include type-style('body'); color: #263248; }
.search-input-dark { color: #e7e9ee; }
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) {
  .graph-search, .search-box, .search-entry { transition: none; }
}
/* #endif */
.search-results { margin-top: $space-detail; border-radius: 12px; background-color: $theme-surface-light; box-shadow: 0 4px 18px rgba(24, 32, 44, 0.12); }
.search-results-dark { background-color: $theme-surface-dark; }
.search-result { width: 100%; min-height: $space-controlMin; margin: 0; padding: 0 $space-card; display: flex; flex-direction: row; align-items: center; gap: $space-inline; text-align: left; @include button-background(transparent); color: #263248; }
.search-result-dark { color: #e7e9ee; }
.search-result-dot { width: 7px; height: 7px; border-radius: 50%; }
.search-result-name { flex: 1; min-width: 0; @include type-style('body'); }
.search-empty { min-height: $space-controlMin; padding: $space-card; color: $text-secondary-light; @include type-style('label'); }
.search-empty-dark { color: $text-secondary-dark; }
.graph-tools { position: absolute; left: $space-overlayBlock; bottom: calc($space-overlayBlock + env(safe-area-inset-bottom)); display: flex; flex-direction: row; align-items: center; padding: 0 $space-detail; border-radius: 12px; background-color: $theme-surface-light; box-shadow: 0 2px 12px rgba(24, 32, 44, 0.1); }
.graph-tools-dark { background-color: $theme-surface-dark; box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25); }
.graph-node-button, .search-result { @include borderless-button; }
.detail-ink { color: #263248; }
.detail-ink-dark { color: #e7e9ee; }
.detail { @include block-content; @include type-style('body'); @include wrap-long-text; }
