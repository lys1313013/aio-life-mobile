<script setup lang="ts">
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import { computed, onUnmounted, ref, watch } from 'vue';
import AppIcon from '../../components/AppIcon.uvue';
import spacing from '../../styles/spacing.json';
import { layoutGraph, layoutEdges, categoryColors, relationColor as getRelationColor } from '../../services/domains/relationship-layout.ts';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import {
  fetchGraph,
  searchPeople,
  fetchPerson,
  savePerson,
  deletePerson,
  saveRelationship,
  deleteRelationship,
} from '../../services/domains/social.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { isDark, themeClass } from '../../services/theme.ts';
const graph = ref<any>({ nodes: [], edges: [] }),
  keyword = ref(''),
  category = ref('全部'),
  results = ref<any[] | null>(null),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  busy = ref(false),
  formError = ref(''),
  person = ref<any>(null),
  draft = ref<any>(null),
  relation = ref<any>(null);
const personDetailFields = computed(() =>
  ['description', 'tags', 'birthday', 'phone', 'email', 'school', 'socialLinks', 'notes']
    .filter((key) => String(person.value?.[key] ?? '').trim().length > 0),
);
let detailStamp = 0,
  stamp = 0,
  alive = true;
onUnmounted(() => {
  alive = false;
  stamp++;
});
const zoom = ref(1),
  panX = ref(0),
  panY = ref(0),
  dragged = ref(false),
  showLabels = ref(true),
  showRelations = ref(false),
  viewport = ref(uni.getWindowInfo());
function relationColor(type: string) { return getRelationColor(type, isDark.value); }
const categories = ['全部', '亲属', '社会', '情感', '其他'];
let touchX = 0,
  touchY = 0;
// 与 MobilePage 内容宽度一致；数值留给节点、触控区和画布几何约束。
const canvasWidth = computed(() => Math.min(viewport.value.windowWidth, spacing.contentMax) - spacing.page * 2);
const canvasHeight = computed(() => Math.max(440, Math.min(560, viewport.value.windowHeight - 260)));
const filteredNodes = computed(() => graph.value.nodes.filter(
  item => category.value === '全部' || item.category === category.value,
));
const filteredEdges = computed(() => {
  const ids = new Set(filteredNodes.value.map(item => item.id));
  return graph.value.edges.filter(edge => ids.has(edge.source) && ids.has(edge.target));
});
const layout = computed(() => layoutGraph(filteredNodes.value, filteredEdges.value, canvasWidth.value, canvasHeight.value));
const graphNodes = computed(() => layout.value.nodes);
const graphEdges = computed(() => layoutEdges(graphNodes.value, filteredEdges.value));
function resetGraph() {
  zoom.value = 1;
  panX.value = (canvasWidth.value - layout.value.width) / 2;
  panY.value = (canvasHeight.value - layout.value.height) / 2;
}
function changeZoom(factor: number) {
  const next = Math.max(0.5, Math.min(2, zoom.value * factor));
  const ratio = next / zoom.value;
  panX.value = canvasWidth.value / 2 - (canvasWidth.value / 2 - panX.value) * ratio;
  panY.value = canvasHeight.value / 2 - (canvasHeight.value / 2 - panY.value) * ratio;
  zoom.value = next;
}
function resizeGraph() {
  viewport.value = uni.getWindowInfo();
  resetGraph();
}
uni.onWindowResize(resizeGraph);
onUnmounted(() => uni.offWindowResize(resizeGraph));
watch([category, canvasWidth, canvasHeight], resetGraph);
function graphStart(event: any) {
  const touch = event.touches?.[0];
  if (!touch) return;
  touchX = touch.clientX;
  touchY = touch.clientY;
  dragged.value = false;
}
function graphMove(event: any) {
  const touch = event.touches?.[0];
  if (!touch) return;
  const dx = touch.clientX - touchX,
    dy = touch.clientY - touchY;
  if (Math.abs(dx) + Math.abs(dy) > 2) dragged.value = true;
  panX.value += dx;
  panY.value += dy;
  touchX = touch.clientX;
  touchY = touch.clientY;
}
function graphClick(id: string) {
  if (!dragged.value) detail(id);
}
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await fetchGraph();
    if (alive && current === stamp) {
      graph.value = data;
      results.value = null;
      resetGraph();
    }
  } catch (e) {
    if (alive && current === stamp) error.value = e.message;
  } finally {
    if (alive && current === stamp) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    graph.value = { nodes: [], edges: [] };
    person.value = null;
    draft.value = null;
    relation.value = null;
    results.value = null;
    loading.value = false;
    refreshing.value = false;
  },
);
const people = computed(() =>
  (results.value || graph.value.nodes).filter(
    (item) => category.value === '全部' || item.category === category.value,
  ),
);
function clearSearch() {
  stamp++;
  keyword.value = '';
  results.value = null;
  error.value = '';
  loading.value = false;
  refreshing.value = false;
}
async function search() {
  if (!keyword.value.trim()) {
    clearSearch();
    return;
  }
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await searchPeople(keyword.value.trim());
    if (alive && current === stamp) results.value = data;
  } catch (e) {
    if (alive && current === stamp) error.value = e.message;
  } finally {
    if (alive && current === stamp) loading.value = false;
  }
}
async function detail(id: string) {
  const mutationStamp = stamp,
    current = ++detailStamp;
  busy.value = true;
  error.value = '';
  try {
    const data = await fetchPerson(id);
    if (alive && stamp === mutationStamp && current === detailStamp) person.value = data;
  } catch (e) {
    if (alive && stamp === mutationStamp && current === detailStamp) error.value = e.message;
  } finally {
    if (alive && current === detailStamp) busy.value = false;
  }
}
function edit(value: any = null) {
  draft.value = value
    ? { ...value }
    : {
        name: '',
        category: '其他',
        description: '',
        tags: '',
        birthday: '',
        phone: '',
        email: '',
        school: '',
        socialLinks: '',
        notes: '',
        avatar: '',
      };
  formError.value = '';
}
async function save() {
  const mutationStamp = stamp;
  if (busy.value) return;
  if (!draft.value.name.trim()) {
    formError.value = '请输入姓名';
    return;
  }
  busy.value = true;
  formError.value = '';
  try {
    await savePerson(draft.value);
    if (!alive || stamp !== mutationStamp) return;
    const id = draft.value.id;
    draft.value = null;
    await load();
    if (id) await detail(id);
  } catch (e) {
    formError.value = e.message;
  } finally {
    busy.value = false;
  }
}
async function remove() {
  const mutationStamp = stamp;
  const id = String(person.value.id);
  await deletePerson(id);
  if (!alive || stamp !== mutationStamp) return;
  person.value = null;
  graph.value = {
    nodes: graph.value.nodes.filter((item) => item.id !== id),
    edges: graph.value.edges.filter((edge) => edge.source !== id && edge.target !== id),
  };
}
function editRelation(value: any = null) {
  relation.value = value
    ? { ...value, sourcePersonId: person.value.id, targetPersonId: value.target.id }
    : {
        sourcePersonId: person.value.id,
        targetPersonId: '',
        relationType: '朋友',
        direction: '双向',
        description: '',
        tags: '',
      };
  formError.value = '';
}
function targetLabel(item: any) {
  return graph.value.nodes.filter((value) => value.name === item.name).length > 1
    ? item.name + ' · ' + item.id
    : item.name;
}
const targetName = computed({
  get: () => {
    const item = graph.value.nodes.find((item) => item.id === relation.value?.targetPersonId);
    return item ? targetLabel(item) : '';
  },
  set: (value) => {
    relation.value.targetPersonId =
      graph.value.nodes.find((item) => targetLabel(item) === value)?.id || '';
  },
});
async function saveRel() {
  const mutationStamp = stamp;
  if (busy.value) return;
  if (
    !relation.value.targetPersonId ||
    relation.value.sourcePersonId === relation.value.targetPersonId
  ) {
    formError.value = '请选择其他人物';
    return;
  }
  busy.value = true;
  formError.value = '';
  try {
    await saveRelationship(relation.value);
    if (!alive || stamp !== mutationStamp) return;
    relation.value = null;
    await detail(person.value.id);
    await load();
  } catch (e) {
    formError.value = e.message;
  } finally {
    busy.value = false;
  }
}
async function removeRel(value: any) {
  const mutationStamp = stamp;
  await deleteRelationship({
    sourcePersonId: person.value.id,
    targetPersonId: value.target.id,
    relationType: value.relationType,
  });
  if (!alive || stamp !== mutationStamp) return;
  person.value.relationships = person.value.relationships.filter((item) => item.id !== value.id);
  await load();
}
function nodeName(id: string) {
  return graph.value.nodes.find((item) => item.id === id)?.name || id;
}
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="关系图谱" back @back="uni.navigateBack()" /><view
      class="body ui-page-body"
      :class="themeClass('body')"
      >
      <view class="search-row ui-row ui-section">
        <view class="search-box" :class="themeClass('search-box')">
          <input class="search-input" :class="themeClass('search-input')" aria-label="搜索人物" placeholder="搜索人物" v-model="keyword" confirm-type="search" @confirm="search" />
          <MobileButton v-if="keyword || results" label="清空搜索" icon="ant-design:close-outlined" variant="quiet" @click="clearSearch" />
        </view>
        <MobileButton label="搜索" icon="ant-design:search-outlined" variant="quiet" :loading="loading" @click="search" />
        <MobileButton label="新增人物" icon="ant-design:plus-outlined" @click="edit()" />
      </view>
      <view class="category-tabs ui-row ui-section">
        <button v-for="item in categories" :key="item" role="button" :aria-label="'分类：' + item" :aria-pressed="category === item" class="category-tab" :class="[themeClass('category-tab'), { 'category-tab-active': category === item }]" @click="category = item">
          <view v-if="item !== '全部'" class="category-dot" :style="{ backgroundColor: categoryColors[item] }" />
          <text class="ui-type-label">{{ item }}</text>
        </button>
      </view>
      <PageState skeleton="graph" :loading="loading || busy" :error="error" :empty="!loading && !filteredNodes.length" empty-text="暂无人物" @retry="load">
<template #loading><view class="graph-panel" :class="themeClass('graph-panel')"><view class="topology" :style="{ height: canvasHeight + 'px' }"><LoadingIndicator label="正在加载关系图谱" /></view></view></template>
        <view v-if="results !== null" class="search-results ui-section" :class="themeClass('search-results')">
          <text class="graph-summary" :class="themeClass('graph-summary')">{{ people.length ? '搜索结果 · ' + people.length : '未找到匹配人物' }}</text>
          <view class="people ui-row">
            <MobileButton v-for="item in people" :key="item.id" :label="item.name" variant="quiet" :loading="busy" @click="detail(item.id)" />
          </view>
        </view>
        <view v-if="filteredNodes.length" class="graph-panel" :class="themeClass('graph-panel')">
          <view class="graph-toolbar ui-row">
            <text class="graph-summary" :class="themeClass('graph-summary')">{{ filteredNodes.length }} 人 · {{ filteredEdges.length }} 条关系</text>
            <MobileButton label="放大图谱" icon="ant-design:zoom-in-outlined" variant="quiet" @click="changeZoom(1.25)" />
            <MobileButton label="缩小图谱" icon="ant-design:zoom-out-outlined" variant="quiet" @click="changeZoom(0.8)" />
            <MobileButton label="复位图谱" icon="ant-design:fullscreen-outlined" variant="quiet" @click="resetGraph" />
            <MobileButton :label="showLabels ? '隐藏关系名称' : '显示关系名称'" :icon="showLabels ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" variant="quiet" @click="showLabels = !showLabels" />
          </view>
          <view class="topology" :style="{ height: canvasHeight + 'px' }" aria-label="关系拓扑图，可触屏拖动，使用按钮缩放" @touchstart.stop="graphStart" @touchmove.stop.prevent="graphMove">
            <view class="graph-world" :style="{ width: layout.width + 'px', height: layout.height + 'px', transform: 'translate(' + panX + 'px,' + panY + 'px) scale(' + zoom + ')' }">
              <view v-for="(edge, index) in graphEdges" :key="index" class="graph-link" :style="{ left: edge.x + 'px', top: edge.y + 'px', width: edge.length + 'px', backgroundColor: relationColor(edge.relationType), transform: 'rotate(' + edge.angle + 'deg)' }">
                <view class="graph-arrow" :style="{ borderLeftColor: relationColor(edge.relationType) }" />
                <view v-if="edge.direction === '双向'" class="graph-arrow graph-arrow-start" :style="{ borderLeftColor: relationColor(edge.relationType) }" />
              </view>
              <template v-if="showLabels">
                <text v-for="(edge, index) in graphEdges.filter(item => item.showLabel)" :key="'label-' + index" class="graph-edge-label" :class="themeClass('graph-edge-label')" :style="{ left: edge.labelX + 'px', top: edge.labelY + 'px', color: relationColor(edge.relationType) }">{{ edge.relationType }}</text>
              </template>
              <button v-for="node in graphNodes" :key="node.id" role="button" class="graph-node-button ui-type-body" :class="themeClass('graph-node-button')" :aria-label="node.name" :disabled="busy" :style="{ left: node.x - 34 + 'px', top: node.y - 22 + 'px', borderColor: categoryColors[node.category] || '#8392a5' }" @click="graphClick(node.id)">
                <text class="node-name">{{ node.name }}</text>
              </button>
            </view>
          </view>
        </view>
        <view v-if="filteredEdges.length" class="relations-section">
          <button role="button" aria-label="关系明细" :aria-expanded="showRelations" class="relations-toggle" :class="themeClass('relations-toggle')" @click="showRelations = !showRelations">
            <text class="ui-type-label">关系明细 · {{ filteredEdges.length }}</text>
            <AppIcon :name="showRelations ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="14" color="#8b8f99" />
          </button>
          <view v-if="showRelations" class="relation-list">
            <view v-for="(edge, index) in filteredEdges" :key="index" class="relation-row" :class="themeClass('relation-row')">
              <text class="relation-person">{{ nodeName(edge.source) }}</text>
              <view class="relation-kind"><text class="ui-type-badge" :style="{ color: relationColor(edge.relationType) }">{{ edge.relationType }}</text><text class="relation-direction ui-type-badge" :class="themeClass('relation-direction')">{{ edge.direction === '双向' ? '↔' : '→' }}</text></view>
              <text class="relation-person relation-target">{{ nodeName(edge.target) }}</text>
              <text v-if="edge.description" class="relation-description" :class="themeClass('relation-description')">{{ edge.description }}</text>
            </view>
          </view>
        </view>
      </PageState>
      </view
    ><AdaptiveModal
      v-if="person && !draft && !relation"
      :label="person.name"
      :busy="busy"
      @close="person = null"
      ><text class="title">{{ person.name }}</text><text class="detail-caption ui-type-label" :class="themeClass('detail-caption')">{{ person.category }}</text
      ><text
        v-for="key in personDetailFields"
        :key="key"
        class="detail ui-py-xs ui-type-body"
        selectable
        >{{ person[key] }}</text
      ><view class="actions ui-toolbar"
        ><MobileButton label="编辑人物" icon="ant-design:edit-outlined" @click="edit(person)" /><ConfirmAction
          label="删除人物和关联关系"
          :action="remove" /><MobileButton
          label="新增关系"
          icon="ant-design:plus-outlined"
          @click="editRelation()" /></view
      ><view v-for="item in person.relationships" :key="item.id" class="edge ui-card"
        ><text class="edge-title ui-type-body-strong">{{ item.target.name }} · {{ item.relationType }} · {{ item.direction }}</text
        ><text class="detail-caption ui-type-label" :class="themeClass('detail-caption')">{{ item.description }} {{ item.tags }}</text
        ><view class="actions ui-row"
          ><MobileButton
            label="编辑关系"
            icon="ant-design:edit-outlined"
            variant="quiet"
            @click="editRelation(item)" /><ConfirmAction
            label="删除关系"
            :action="() => removeRel(item)" /></view></view></AdaptiveModal
    ><AdaptiveModal v-if="draft" label="人物" :busy="busy" @close="draft = null"
      ><FormField label="姓名" v-model="draft.name" /><FormField
        label="分类"
        kind="selector"
        :options="['亲属', '社会', '情感', '其他']"
        v-model="draft.category" /><FormField label="头像URL" v-model="draft.avatar" /><FormField
        label="介绍"
        kind="textarea"
        v-model="draft.description" /><FormField label="标签" v-model="draft.tags" /><FormField
        label="生日"
        kind="date"
        v-model="draft.birthday" /><FormField label="电话" v-model="draft.phone" /><FormField
        label="邮箱"
        v-model="draft.email" /><FormField label="学校" v-model="draft.school" /><FormField
        label="社交链接"
        kind="textarea"
        v-model="draft.socialLinks" /><FormField
        label="备注"
        kind="textarea"
        v-model="draft.notes" /><text v-if="formError" class="error ui-py-section ui-type-body">{{ formError }}</text
      ><MobileButton label="保存" :loading="busy" @click="save" /></AdaptiveModal
    ><AdaptiveModal v-if="relation" label="关系" :busy="busy" @close="relation = null"
      ><FormField
        label="关联人物"
        kind="selector"
        :options="
          graph.nodes.filter((item) => item.id !== person.id).map((item) => targetLabel(item))
        "
        v-model="targetName" /><FormField
        label="关系类型"
        kind="selector"
        :options="[
          '父母',
          '母亲',
          '父亲',
          '子女',
          '配偶',
          '恋人',
          '兄弟姐妹',
          '朋友',
          '挚友',
          '同学',
          '同事',
          '老师',
          '学生',
          'mentor',
          '前任',
          '暗恋',
          '其他',
        ]"
        v-model="relation.relationType" /><FormField
        label="方向"
        kind="selector"
        :options="['单向', '双向']"
        v-model="relation.direction" /><FormField
        label="说明"
        kind="textarea"
        v-model="relation.description" /><FormField label="标签" v-model="relation.tags" /><text
        v-if="formError"
        class="error ui-py-section ui-type-body"
        >{{ formError }}</text
      ><MobileButton label="保存关系" :loading="busy" @click="saveRel" /></AdaptiveModal
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('label', 'body', 'badge');

.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.search-row { align-items: center; }
.search-box { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; gap: $space-inline; padding-left: $space-card; background-color: #ffffff; border-radius: 12px; }
.search-box-dark { background-color: #1c1e22; }
.search-input { flex: 1; min-width: 0; height: 44px; @include type-style('body'); color: #263248; }
.search-input-dark { color: #e7e9ee; }
.category-tabs { gap: $space-detail; max-width: 440px; }
.category-tab { flex: 1; min-width: 44px; min-height: 44px; margin: 0; padding: 0; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: $space-detail; background-color: transparent; color: $text-secondary-light; border-radius: 12px; @include type-style('label'); }
.category-tab-dark { color: $text-secondary-dark; }
.category-tab-active { background-color: #427bea; color: #ffffff; }
.category-dot { width: 6px; height: 6px; border-radius: 3px; }
.actions { flex-wrap: wrap; }
.graph-panel { overflow: hidden; border-radius: 16px; background-color: #ffffff; }
.graph-panel-dark { background-color: #1c1e22; }
.graph-toolbar { align-items: center; gap: $space-detail; padding: $space-detail $space-inline; }
.topology { width: 100%; position: relative; overflow: hidden; }
.graph-world { position: absolute; transform-origin: 0 0; }
.graph-link { position: absolute; height: 1px; transform-origin: 0 50%; pointer-events: none; overflow: visible; opacity: 0.7; }
/* 节点尺寸属于画布几何约束，与布局函数共享 68 × 44 的碰撞边界。 */
.graph-node-button { position: absolute; width: 68px; height: 44px; margin: 0; padding: 0 $space-detail; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: $space-detail; border: 1px solid; border-radius: 22px; background-color: #ffffff; color: #263248; }
.graph-node-button-dark { background-color: #252830; color: #e7e9ee; }
.node-name { flex: 1; width: 100%; display: block; min-width: 0; text-align: center; @include type-style('caption');  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.graph-arrow { position: absolute; right: 0; top: -3px; width: 0; height: 0; border-top: 3px solid transparent; border-bottom: 3px solid transparent; border-left: 5px solid; }
.graph-arrow-start { right: auto; left: 0; transform: rotate(180deg); }
.graph-edge-label { position: absolute; @include type-style('badge');  white-space: nowrap; transform: translate(-50%, -50%); padding: 0 $space-detail; border-radius: 4px; background-color: #ffffff; pointer-events: none; }
.graph-edge-label-dark { background-color: #1c1e22; }
.graph-summary { flex: 1; color: $text-secondary-light; @include type-style('caption'); }
.search-results { padding: $space-card; border-radius: 12px; background-color: #ffffff; gap: $space-inline; }
.search-results-dark { background-color: #1c1e22; }
.people { flex-wrap: wrap; }
.relations-section { margin-top: $space-section; }
.relations-toggle { width: 100%; min-height: 44px; margin: 0; padding: 0 $space-detail; display: flex; flex-direction: row; justify-content: space-between; align-items: center; background-color: transparent; color: $text-secondary-light; @include type-style('label'); }
.relations-toggle-dark { color: $text-secondary-dark; }
.relation-list { gap: $space-detail; }
.relation-row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-inline; padding: $space-inline $space-card; border-radius: 10px; background-color: #ffffff; }
.relation-row-dark { background-color: #1c1e22; }
.relation-person { flex: 1; min-width: 0; @include type-style('label'); }
.relation-target { text-align: right; }
.relation-kind { align-items: center; @include type-style('badge'); }
.relation-direction { color: $text-secondary-light; }
.relation-description { width: 100%; color: $text-secondary-light; @include type-style('caption'); }
/* #ifdef WEB || MP-WEIXIN */
.graph-node-button::after, .category-tab::after, .relations-toggle::after { border: 0; }
/* #endif */
.edge {
  display: flex;
  flex-direction: column;
}
.title {
  @include type-style('title');

}
.detail {
  display: block;
  @include type-style('body');
  overflow-wrap: anywhere;
}
.edge-title { overflow-wrap: anywhere; }
.detail-caption { @include type-style('label'); color: $text-secondary-light; overflow-wrap: anywhere; }
.detail-caption-dark, .graph-summary-dark, .relation-description-dark, .relation-direction-dark { color: $text-secondary-dark; }
.error {
  color: #dc5454;
  display: block;
}

</style>
