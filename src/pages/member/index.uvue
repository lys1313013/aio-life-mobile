<script setup lang="ts">
import { appTextColor } from '../../services/app-layout.ts'

import FormActions from '../../components/FormActions.uvue';
import { isRequired } from '../../services/form-required.ts';
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onUnmounted, ref } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import MembershipLogo from '../../components/MembershipLogo.uvue';
import { editableProviders } from '../../services/membership-provider.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isDark } from '../../services/theme.ts';
import { memberPayload, addMonthsClamped } from '../../services/records/contracts.ts';
import {
  fetchMembers,
  fetchMemberProviders,
  fetchMemberStats,
  saveMember,
  deleteMember,
} from './services/member.ts';
const rows = ref<any[]>([]),
  stats = ref<any>({}),
  loading = ref(false),
  statsLoading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  statsError = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref(''),
  showDetails = ref(false);
const originalProviderRecord = ref<any>(null);
const providers = ref<any[]>([]), providersLoading = ref(false), providersError = ref('');
let providersGeneration = 0;
const providerOptions = computed(() => editableProviders(providers.value, originalProviderRecord.value));
const providerLabel = (row) => row.name + (row.name === '自定义平台' || providerOptions.value.filter(item => item.name === row.name).length > 1 ? '（' + (row.code || row.id) + '）' : '') + (row.isEnabled === 0 ? '（已停用）' : '');
const selectedProviderLabel = computed(() => { const row = providerOptions.value.find(item => item.id === form.value?.providerId); return row ? providerLabel(row) : '自定义平台'; });
async function loadProviders() {
  const version = ++providersGeneration;
  providersLoading.value = true; providersError.value = '';
  try { const data = await scope.wait(fetchMemberProviders()); if (version === providersGeneration) providers.value = data; }
  catch (reason) { if (reason.name !== 'PageInactiveError' && version === providersGeneration) providersError.value = reason.message; }
  finally { if (version === providersGeneration) providersLoading.value = false; }
}
function changeProvider(label) {
  const row = providerOptions.value.find(item => providerLabel(item) === label);
  form.value.providerId = row?.id || null;
  form.value.providerName = row?.name || '';
  form.value.providerIconKey = row?.iconKey || null;
  if (row) { form.value.provider = row.name; form.value.category = row.category; }
}
const categories = ['video', 'music', 'shopping', 'cloud', 'study', 'game', 'other'],
  categoryLabels = ['视频', '音乐', '购物', '云盘', '学习', '游戏', '其他'];
const cycles = ['week', 'two_weeks', 'month', 'quarter', 'half_year', 'year'],
  cycleLabels = ['周', '两周', '月', '季', '半年', '年'];
const colors = [
    '#1677ff',
    '#52c41a',
    '#faad14',
    '#f5222d',
    '#722ed1',
    '#13c2c2',
    '#eb2f96',
    '#8c8c8c',
  ],
  colorLabels = ['蓝', '绿', '橙', '红', '紫', '青', '粉', '灰'];
const statusCodes = ['active', 'expiring', 'expired'],
  statusLabels = ['生效中', '即将到期', '已过期'];
const sortedMembers = computed(() =>
  [...rows.value].sort((a, b) => {
    const expiredRank = Number(a.status === 'expired') - Number(b.status === 'expired');
    return expiredRank || Number(a.remainingDays || 0) - Number(b.remainingDays || 0);
  }),
);
const metrics = computed(() => [
  { label: '生效中', value: stats.value.activeCount || 0 },
  { label: '本月到期', value: stats.value.expiringThisMonthCount || 0 },
  { label: '即将到期', value: stats.value.expiringCount || 0, alert: true },
]);
const categoryIcons = ['ant-design:video-camera-outlined', 'ant-design:customer-service-outlined', 'ant-design:shopping-outlined', 'ant-design:cloud-outlined', 'ant-design:read-outlined', 'ant-design:trophy-outlined', 'ant-design:appstore-outlined'];
const scope = createRecordScope((clearData) => {
  form.value = null;
  providersGeneration++; providersLoading.value = false; providersError.value = '';
  if (clearData) {
    requestedEdit = '';
    requestedCreate = false;
    rows.value = [];
    providers.value = [];
    stats.value = {};
  }
});
let alive = true,
  generation = 0,
  statsGeneration = 0;
let requestedEdit = '', requestedCreate = false;
onLoad((options) => {
  requestedEdit = options?.editId || '';
  requestedCreate = options?.create === '1';
});
onUnmounted(() => {
  alive = false;
  generation++;
  statsGeneration++;
});
onShow(() => load());
async function loadStats() {
  const current = ++statsGeneration;
  statsLoading.value = true;
  statsError.value = '';
  try {
    const data = await scope.wait(fetchMemberStats());
    if (alive && current === statsGeneration) stats.value = data;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === statsGeneration) statsError.value = e.message;
  } finally {
    if (current === statsGeneration) statsLoading.value = false;
  }
}
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  const statsRequest = loadStats();
  try {
    const data = await scope.wait(fetchMembers());
    if (alive && current === generation) {
      rows.value = data;
      if (requestedEdit) {
        const selected = data.find((item) => item.id === requestedEdit);
        if (!selected) throw Error('会员记录不存在或已删除');
        open(selected);
        requestedEdit = '';
        requestedCreate = false;
      } else if (requestedCreate) {
        requestedCreate = false;
        open();
      }
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    await statsRequest;
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  originalProviderRecord.value = item ? { ...item } : null;
  formError.value = '';
  showDetails.value = false;
  form.value = item
    ? { ...item }
    : {
        name: '',
        provider: '',
        providerId: null,
        category: 'other',
        startDate: '',
        expiryDate: '',
        price: '',
        monthlyAmount: '',
        billingCycle: 'month',
        autoRenew: 0,
        note: '',
        color: colors[0],
      };
  loadProviders();
}
function quickDate(months) {
  form.value.expiryDate = addMonthsClamped(
    form.value.startDate || new Date().toLocaleDateString('sv-SE'),
    months,
  );
}
async function save() {
  if (saving.value) return;
  let payload;
  try {
    payload = memberPayload(form.value);
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
    return;
  }
  saving.value = true;
  formError.value = '';
  try {
    const saved = await scope.wait(saveMember(payload));
    const index = rows.value.findIndex((r) => r.id === saved.id);
    if (index >= 0) rows.value[index] = saved;
    else rows.value.push(saved);
    form.value = null;
    loadStats();
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  await scope.wait(deleteMember(item.id));
  rows.value = rows.value.filter((r) => r.id !== item.id);
  if (form.value?.id === item.id) form.value = null;
  loadStats();
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)">
    <view class="member-page ui-page-body" :class="{ 'member-page-dark': isDark }">
      <PageHeader title="订阅" :back="true" @back="uni.navigateBack()" />
      <PageState skeleton="metrics" :loading="statsLoading" :error="statsError" @retry="loadStats">
        <view class="member-summary ui-section">
          <view class="summary-cost">
            <text class="metric-label" :class="{ 'secondary-text-dark': isDark }">当前月均</text>
            <text class="summary-amount" :class="{ 'text-dark': isDark }">¥{{ Number(stats.monthlyAmount || 0).toFixed(2) }}</text>
          </view>
          <view class="metrics">
            <view v-for="metric in metrics" :key="metric.label" class="member-metric">
              <text class="metric-label" :class="{ 'secondary-text-dark': isDark }">{{ metric.label }}</text>
              <text class="metric-value" :class="{ 'text-dark': isDark, 'metric-alert': metric.alert && metric.value > 0, 'metric-alert-dark': isDark && metric.alert && metric.value > 0 }">{{ metric.value }}</text>
            </view>
          </view>
        </view>
      </PageState>
      <PageState skeleton="list" :loading="loading" :error="error" :empty="!sortedMembers.length" @retry="load()">
<template #loading><view class="member-grid" ><view v-for="n in 6" :key="n" class="member-card" :class="{ 'surface-dark': isDark, 'text-dark': isDark }"><ContentSkeleton variant="tile" /></view></view></template>

        <view class="member-grid">
          <button role="button" tabindex="0" v-for="item in sortedMembers" :key="item.id" class="member-card ui-type-body" :class="{ 'surface-dark': isDark, 'text-dark': isDark }" :aria-label="'编辑订阅：' + item.name" @click="open(item)" @keydown.enter.prevent="open(item)" @keydown.space.prevent="open(item)">
            <view class="card-heading">
              <MembershipLogo :icon-key="item.providerIconKey" :category="item.category" :name="item.providerName || item.provider" :size="24" />
              <text class="member-title">{{ item.name }}</text>
              <AppIcon v-if="item.autoRenew === 1" name="ant-design:sync-outlined" :size="14" color="#4285ed" />
            </view>
            <text v-if="item.providerName || item.provider" class="member-provider" :class="{ 'secondary-text-dark': isDark }">{{ item.providerName || item.provider }}</text>
            <view class="member-tags">
              <text class="member-status" :class="'member-status-' + item.status">{{ statusLabels[statusCodes.indexOf(item.status)] || item.status }}</text>
              <view class="category-tag" :class="{ 'category-tag-dark': isDark }"><AppIcon :name="categoryIcons[categories.indexOf(item.category)] || categoryIcons[6]" :size="12" /><text class="category-label">{{ categoryLabels[categories.indexOf(item.category)] || '其他' }}</text></view>
            </view>
            <view class="expiry-row">
              <view class="expiry-date" :class="{ 'secondary-text-dark': isDark }"><AppIcon name="ant-design:calendar-outlined" :size="12" /><text class="expiry-date-text" :class="{ 'secondary-text-dark': isDark }">{{ item.expiryDate }}</text></view>
              <text class="remaining-days" :class="'member-status-' + item.status">{{ item.status === 'expired' ? '已过期' : '剩 ' + item.remainingDays + ' 天' }}</text>
            </view>
            <view class="member-price" :class="{ 'member-price-dark': isDark }">
              <text class="member-secondary" :class="{ 'secondary-text-dark': isDark }">{{ cycleLabels[cycles.indexOf(item.billingCycle)] || '月' }} ¥{{ Number(item.price || 0).toFixed(2) }}</text>
              <text class="monthly-price">月均 ¥{{ Number(item.monthlyAmount || 0).toFixed(2) }}</text>
            </view>
          </button>
        </view>
      </PageState>
      <AdaptiveModal
        v-if="form"
        :label="form.id ? '编辑订阅' : '新增订阅'"
        :busy="saving"
        :content-key="String(showDetails) + formError + selectedProviderLabel + providersError"
        @close="form = null"
      >
        <FormField :required="isRequired('member', 'name')" appearance="soft" label="名称" placeholder="请输入订阅名称" v-model="form.name" />
        <view class="ui-field-row">
          <FormField v-if="form.providerId" appearance="soft" compact stretch label="平台" kind="selector" :model-value="providersLoading ? '加载中…' : selectedProviderLabel" :options="['自定义平台', ...providerOptions.map(providerLabel)]" :disabled="providersLoading || !!providersError || saving" @update:model-value="changeProvider" />
          <FormField v-else appearance="soft" compact stretch label="平台">
            <view class="custom-provider" :class="{ 'custom-provider-dark': isDark }">
              <input class="custom-provider-input" :style="appTextColor()" aria-label="自定义平台" :value="form.provider" :disabled="saving" placeholder="自定义平台" @input="form.provider = $event.detail.value" />
              <picker class="custom-provider-picker" mode="selector" aria-label="选择会员平台" :range="['自定义平台', ...providerOptions.map(providerLabel)]" :value="0" :disabled="providersLoading || !!providersError || saving" @change="changeProvider(['自定义平台', ...providerOptions.map(providerLabel)][$event.detail.value])">
                <view class="custom-provider-trigger"><AppIcon :name="providersLoading ? 'ant-design:loading-outlined' : 'ant-design:down-outlined'" :size="14" /></view>
              </picker>
            </view>
          </FormField>
          <FormField appearance="soft"
            compact stretch label="分类" kind="selector"
            :model-value="categoryLabels[categories.indexOf(form.category)] || form.category"
            :options="categoryLabels"
            @update:model-value="form.category = categories[categoryLabels.indexOf($event)]"
          />
        </view>
        <view v-if="providersError" class="ui-row ui-section"><text class="member-error ui-type-body">{{ providersError }}</text><MobileButton label="重试平台加载" icon="ant-design:reload-outlined" variant="quiet" :loading="providersLoading" @click="loadProviders" /></view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="开通日期" kind="date" v-model="form.startDate" />
          <FormField :required="isRequired('member', 'expiryDate')" appearance="soft" compact stretch label="到期日期" kind="date" v-model="form.expiryDate" />
        </view>
        <view class="quick-dates ui-row ui-section">
          <MobileButton compact label="1月" variant="quiet" @click="quickDate(1)" />
          <MobileButton compact label="1季度" variant="quiet" @click="quickDate(3)" />
          <MobileButton compact label="半年" variant="quiet" @click="quickDate(6)" />
          <MobileButton compact label="1年" variant="quiet" @click="quickDate(12)" />
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="价格" input-type="digit" v-model="form.price" />
          <FormField appearance="soft"
            compact stretch label="计费周期" kind="selector"
            :model-value="cycleLabels[cycles.indexOf(form.billingCycle)]"
            :options="cycleLabels"
            @update:model-value="form.billingCycle = cycles[cycleLabels.indexOf($event)]"
          />
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="当前月均" input-type="digit" v-model="form.monthlyAmount" />
          <FormField appearance="soft"
            compact stretch label="自动续费" kind="selector"
            :model-value="form.autoRenew === 1 ? '开启' : '关闭'"
            :options="['开启', '关闭']"
            @update:model-value="form.autoRenew = $event === '开启' ? 1 : 0"
          />
        </view>
        <button :style="appTextColor()"
          class="details-toggle" role="button" aria-label="颜色与备注"
          :aria-expanded="showDetails" :disabled="saving"
          @click="showDetails = !showDetails"
        >
          <text class="ui-type-body">颜色与备注</text>
          <AppIcon v-if="form.note" name="ant-design:file-text-outlined" :size="14" aria-label="已填写备注" />
          <view class="action-spacer" />
          <AppIcon :name="showDetails ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="14" />
        </button>
        <view v-if="showDetails" class="ui-mt-sm">
          <FormField appearance="soft"
            label="颜色" kind="selector"
            :model-value="colorLabels[colors.indexOf(form.color)] || '蓝'"
            :options="colorLabels"
            @update:model-value="form.color = colors[colorLabels.indexOf($event)]"
          />
          <FormField appearance="soft" compact label="备注" kind="textarea" v-model="form.note" />
        </view>
        <text v-if="formError" class="member-error ui-mt-section ui-type-body" role="alert">{{ formError }}</text>
        <FormActions>
          <template #secondary><ConfirmAction v-if="form.id && !saving" label="删除订阅" :action="() => remove(form)" /></template>
          <MobileButton label="取消" variant="quiet" :disabled="saving" @click="form = null" />
          <MobileButton label="保存" :loading="saving" @click="save" />
        </FormActions>
      </AdaptiveModal>
    </view>
    <template #fixed>
      <FloatingActionButton v-if="!form" label="新增订阅" :disabled="loading" @click="open()" />
    </template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

/* 为悬浮新增按钮预留滚动空间，确保末行卡片可完整露出。 */
.member-page { color: #27272a; padding-bottom: calc(56px + #{$space-page} + #{$space-inline}); }
.member-page-dark { color: #eeeeef; }
.custom-provider { flex-direction: row; align-items: center; min-width: 0; min-height: $space-controlMin; background-color: #f2f4f7; border-radius: 10px; }
.custom-provider-dark { background-color: #272a30; }
.custom-provider-input { flex: 1; min-width: 0; height: $space-controlMin; padding-left: $space-card; @include type-style('body'); }
.custom-provider-picker { width: $space-controlMin; flex-shrink: 0; }
.custom-provider-trigger { height: $space-controlMin; width: $space-controlMin; align-items: center; justify-content: center; }
.toolbar { flex-direction: row; align-items: center; }
.member-summary { display: flex; flex-direction: column; gap: $space-section; padding: $space-inline 0 $space-section; }
.summary-cost { min-width: 0; gap: $space-detail; }
.summary-amount { color: #27272a; @include type-style('hero'); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.metrics { display: flex; flex-direction: row; gap: $space-inline; }
.member-metric { flex: 1; min-width: 0; gap: $space-detail; }
.metric-label { color: $text-secondary-light; @include type-style('caption'); }
.metric-value { color: #27272a; @include type-style('metric-compact'); font-variant-numeric: tabular-nums; }
.member-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-section; }
.member-card { display: flex; flex-direction: column; width: calc((100% - #{$space-section}) / 2); min-width: 0; box-sizing: border-box; margin: 0; padding: $space-card; gap: $space-section; color: #27272a; text-align: left; line-height: type-leading('normal'); background-color: #ffffff; border: 1px solid #e4e7ec; border-radius: 16px; }
.card-heading { flex-direction: row; align-items: center; gap: $space-detail; min-height: 22px; }
.member-title { flex: 1; min-width: 0; @include type-style('title');   overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-provider { color: $text-secondary-light; @include type-style('caption'); margin-top: -$space-inline; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-tags { flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-detail; }
.member-status { @include type-style('badge-strong');  padding: $space-detail;  border-radius: 6px; }
.member-status-active { color: #35a879; background-color: rgba(53, 168, 121, 0.10); }
.member-status-expiring { color: #ce9424; background-color: rgba(217, 161, 38, 0.10); }
.member-status-expired { color: #9097a2; background-color: rgba(139, 143, 153, 0.10); }
.category-tag { flex-direction: row; align-items: center; gap: $space-detail; padding: $space-detail; @include type-style('badge');  background-color: #f1f3f6; border-radius: 6px; color: #667080; }
.category-label { @include type-style('badge');  }
.expiry-date-text { @include type-style('badge');  color: $text-secondary-light; }
.category-tag-dark { background-color: #292c32; color: #c0c4cd; }
.expiry-row { flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-detail; margin-top: auto; }
.expiry-date { flex-direction: row; align-items: center; gap: $space-detail; @include type-style('badge'); color: $text-secondary-light;  }
.remaining-days { margin-left: auto; padding: 0 $space-detail; border-radius: 8px; @include type-style('badge-strong');   }
.member-price { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: $space-detail; padding-top: $space-inline; border-top: 1px dashed #e4e7ec; }
.member-price-dark { border-color: #30343b; }
.member-secondary { color: $text-secondary-light; @include type-style('badge');  }
.monthly-price { margin-left: auto; @include type-style('caption-strong');   }
.surface-dark { background-color: #1c1e22; border-color: #33363b; }
.text-dark { color: #eeeeef; }
.member-error { color: #e05252; }
.quick-dates { flex-direction: row; flex-wrap: wrap; }
.details-toggle { display: flex; flex-direction: row; align-items: center; gap: $space-inline; width: 100%; min-height: $space-controlMin; margin: 0; padding: 0; border: 0; background-color: transparent;
/* #ifndef APP */
color: inherit;
/* #endif */
 @include type-style('body'); text-align: left; }
.action-spacer { flex: 1; }
/* #ifdef WEB || MP-WEIXIN */
.member-card::after { border: 0; }
.details-toggle::after { border: 0; }
/* #endif */
/* #ifdef WEB */
.member-card:focus-visible { outline: 2px solid #4285ed; outline-offset: 2px; }
/* #endif */
@media (min-width: 700px) {
  .member-summary { flex-direction: row; align-items: center; }
  .summary-cost { flex: 1; }
  .metrics { flex: 2; }
  .member-card { width: calc((100% - #{$space-section} * 2) / 3); }
}
@media (min-width: 1100px) {
  .member-card { width: calc((100% - #{$space-section} * 3) / 4); }
}

.secondary-text-dark { color: $text-secondary-dark; }
.metric-alert { color: #b7791f; }
.metric-alert-dark { color: #e4b45e; }
</style>
