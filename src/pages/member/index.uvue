<script setup lang="ts">
import { computed, onUnmounted, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { isDark } from '../../services/theme.ts';
import { memberPayload, addMonthsClamped } from '../../services/records/contracts.ts';
import {
  fetchMembers,
  fetchMemberStats,
  saveMember,
  deleteMember,
} from '../../services/records/member.ts';
const rows = ref<any[]>([]),
  stats = ref<any>({}),
  loading = ref(false),
  statsLoading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  statsError = ref(''),
  form = ref<any>(null),
  saving = ref(false),
  formError = ref('');
const categories = ['video', 'music', 'shopping', 'cloud', 'study', 'game', 'other'],
  categoryLabels = ['视频', '音乐', '购物', '云盘', '学习', '游戏', '其他'];
const cycles = ['week', 'two_weeks', 'month', 'quarter', 'half_year', 'year'],
  cycleLabels = ['周', '两周', '月', '季', '半年', '年'];
const colors = [
    '#1677ff',
    '#52c41a',
    '#faad14',
    '#f5222d',
    '#722ed1',
    '#13c2c2',
    '#eb2f96',
    '#8c8c8c',
  ],
  colorLabels = ['蓝', '绿', '橙', '红', '紫', '青', '粉', '灰'];
const keyword = ref(''),
  categoryFilter = ref('全部分类'),
  statusFilter = ref('全部状态');
const statusCodes = ['active', 'expiring', 'expired'],
  statusLabels = ['生效中', '即将到期', '已过期'];
const filtered = computed(() =>
  rows.value.filter(
    (item) =>
      (!keyword.value ||
        [item.name, item.provider, item.note].some((text) =>
          (text || '').includes(keyword.value),
        )) &&
      (categoryFilter.value === '全部分类' ||
        item.category === categories[categoryLabels.indexOf(categoryFilter.value)]) &&
      (statusFilter.value === '全部状态' ||
        item.status === statusCodes[statusLabels.indexOf(statusFilter.value)]),
  ),
);
const scope = createRecordScope((clearData) => {
  form.value = null;
  if (clearData) {
    rows.value = [];
    stats.value = {};
  }
});
let alive = true,
  generation = 0,
  statsGeneration = 0;
onUnmounted(() => {
  alive = false;
  generation++;
  statsGeneration++;
});
onShow(() => load());
async function loadStats() {
  const current = ++statsGeneration;
  statsLoading.value = true;
  statsError.value = '';
  try {
    const data = await scope.wait(fetchMemberStats());
    if (alive && current === statsGeneration) stats.value = data;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === statsGeneration) statsError.value = e.message;
  } finally {
    if (current === statsGeneration) statsLoading.value = false;
  }
}
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  const statsRequest = loadStats();
  try {
    const data = await scope.wait(fetchMembers());
    if (alive && current === generation) rows.value = data;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    await statsRequest;
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function open(item = null) {
  formError.value = '';
  form.value = item
    ? { ...item }
    : {
        name: '',
        provider: '',
        category: 'other',
        startDate: '',
        expiryDate: '',
        price: '',
        monthlyAmount: '',
        billingCycle: 'month',
        autoRenew: 0,
        note: '',
        color: colors[0],
      };
}
function quickDate(months) {
  form.value.expiryDate = addMonthsClamped(
    form.value.startDate || new Date().toLocaleDateString('sv-SE'),
    months,
  );
}
async function save() {
  if (saving.value) return;
  let payload;
  try {
    payload = memberPayload(form.value);
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
    return;
  }
  saving.value = true;
  formError.value = '';
  try {
    const saved = await scope.wait(saveMember(payload));
    const index = rows.value.findIndex((r) => r.id === saved.id);
    if (index >= 0) rows.value[index] = saved;
    else rows.value.push(saved);
    form.value = null;
    loadStats();
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  await scope.wait(deleteMember(item.id));
  rows.value = rows.value.filter((r) => r.id !== item.id);
  loadStats();
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)"
    ><view class="member-page ui-page-body" :class="{ 'member-page-dark': isDark }"
      ><PageHeader title="订阅" :back="true" @back="uni.navigateBack()" /><view
        class="ui-toolbar"
        ><FormField compact stretch label="搜索订阅" v-model="keyword" /><MobileButton
          label="新增订阅"
          icon="ant-design:plus-outlined"
          @click="open()" /></view
      ><view class="filters ui-field-row"
        ><FormField
          compact
          stretch
          label="分类"
          kind="selector"
          v-model="categoryFilter"
          :options="['全部分类', ...categoryLabels]" /><FormField
          compact
          stretch
          label="状态"
          kind="selector"
          v-model="statusFilter"
          :options="['全部状态', ...statusLabels]"
      /></view>
      <PageState :loading="statsLoading" :error="statsError" @retry="loadStats"
        ><view class="metrics ui-row ui-section"
          ><MetricCard label="生效中" :value="stats.activeCount || 0" /><MetricCard
            label="即将到期"
            :value="stats.expiringCount || 0" /><MetricCard
            label="本月到期"
            :value="stats.expiringThisMonthCount || 0" /><MetricCard
            label="当前月均"
            :value="stats.monthlyAmount || 0"
            unit="元" /></view
      ></PageState>
      <PageState
        :loading="loading"
        :error="error"
        :empty="!filtered.length"
        @retry="load()"
        ><view class="member-grid ui-gap-md"
          ><view
            v-for="item in filtered"
            :key="item.id"
            class="member-card ui-card"
            :class="{ 'member-card-dark': isDark }"
            ><view class="toolbar ui-row"
              ><text class="member-title">{{ item.name }}</text
              ><MobileButton
                label="编辑订阅"
                icon="ant-design:edit-outlined"
                variant="quiet"
                @click="open(item)" /><ConfirmAction
                label="删除订阅"
                :action="() => remove(item)" /></view
            ><text class="member-secondary"
              ><text class="member-status" :class="'member-status-' + item.status">{{
                statusLabels[statusCodes.indexOf(item.status)]
              }}</text>
              ·
              {{ categoryLabels[categories.indexOf(item.category)] || item.category
              }}{{ item.provider ? ' · ' + item.provider : '' }}</text
            ><text class="member-secondary"
              >{{ item.expiryDate }} ·
              {{
                item.remainingDays >= 0
                  ? '剩余 ' + item.remainingDays + ' 天'
                  : '已过期 ' + Math.abs(item.remainingDays) + ' 天'
              }}</text
            ><view class="member-price ui-row"
              ><text class="member-secondary"
                >{{ item.price || 0 }} 元 /
                {{
                  cycleLabels[cycles.indexOf(item.billingCycle)] || item.billingCycle
                }}</text
              ><text class="monthly-price"
                >月均 ¥{{ Number(item.monthlyAmount || 0).toFixed(2) }}</text
              ></view
            ><text v-if="item.autoRenew === 1" class="member-secondary">自动续费</text
            ><text v-if="item.note" class="member-content">{{ item.note }}</text></view
          ></view
        ></PageState
      >
      <AdaptiveModal v-if="form" label="编辑订阅" :busy="saving" @close="form = null"
        ><FormField label="名称" v-model="form.name" /><FormField
          label="平台"
          v-model="form.provider" /><FormField
          label="分类"
          kind="selector"
          :model-value="
            categoryLabels[categories.indexOf(form.category)] || form.category
          "
          :options="categoryLabels"
          @update:model-value="
            form.category = categories[categoryLabels.indexOf($event)]
          " /><FormField
          label="开通日期"
          kind="date"
          v-model="form.startDate" /><FormField
          label="到期日期"
          kind="date"
          v-model="form.expiryDate" /><view class="quick-dates ui-row ui-section"
          ><MobileButton label="1月" variant="quiet" @click="quickDate(1)" /><MobileButton
            label="1季度"
            variant="quiet"
            @click="quickDate(3)" /><MobileButton
            label="半年"
            variant="quiet"
            @click="quickDate(6)" /><MobileButton
            label="1年"
            variant="quiet"
            @click="quickDate(12)" /></view
        ><FormField label="价格" input-type="digit" v-model="form.price" /><FormField
          label="计费周期"
          kind="selector"
          :model-value="cycleLabels[cycles.indexOf(form.billingCycle)]"
          :options="cycleLabels"
          @update:model-value="
            form.billingCycle = cycles[cycleLabels.indexOf($event)]
          " /><FormField
          label="当前月均"
          input-type="digit"
          v-model="form.monthlyAmount" /><FormField
          label="自动续费"
          kind="selector"
          :model-value="form.autoRenew === 1 ? '开启' : '关闭'"
          :options="['开启', '关闭']"
          @update:model-value="form.autoRenew = $event === '开启' ? 1 : 0" /><FormField
          label="颜色"
          kind="selector"
          :model-value="colorLabels[colors.indexOf(form.color)] || '蓝'"
          :options="colorLabels"
          @update:model-value="
            form.color = colors[colorLabels.indexOf($event)]
          " /><FormField label="备注" kind="textarea" v-model="form.note" /><text
          v-if="formError"
          class="member-error ui-section"
          >{{ formError }}</text
        ><view class="toolbar ui-row"
          ><MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving"
            @click="form = null" /><MobileButton
            label="保存"
            :loading="saving"
            @click="save" /></view
      ></AdaptiveModal> </view
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.member-page {
  color: #27272a;
}
.member-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.filters {
  flex-direction: row;
  flex-wrap: wrap;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.member-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.member-price {
  justify-content: space-between;
  align-items: center;
}
.monthly-price {
  font-size: 17px;
  font-weight: 600;
}
.member-status {
  font-size: 12px;
}
.member-status-active {
  color: #389367;
}
.member-status-expiring {
  color: #b78124;
}
.member-status-expired {
  color: #8b8f99;
}
.member-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 16px;
}
.member-card-dark {
  background-color: #1c1e22;
}
.member-title {
  flex: 1;
  font-size: 17px;
  font-weight: 600;
}
.member-content {
  font-size: 14px;
  line-height: 22px;
}
.member-secondary {
  color: #8b8f99;
  font-size: 13px;
}
.member-error {
  color: #e05252;
}
@media (min-width: 600px) {
  .member-card {
    width: calc((100% - #{$space-section}) / 2);
  }
}
@media (min-width: 1000px) {
  .member-card {
    width: calc((100% - #{$space-section} * 2) / 3);
  }
}
.quick-dates {
  flex-direction: row;
  flex-wrap: wrap;
}
@media (min-width: 700px) {
  .metrics {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
</style>
