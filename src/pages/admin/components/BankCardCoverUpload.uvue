<script setup lang="ts">
import { computed, getCurrentInstance, nextTick, onUnmounted, ref } from 'vue';
import { session } from '../../../services/session.ts';
import { uploadAttachment } from '../../../services/attachments.ts';
import { coverPlacement } from '../services/bank-card-covers.ts';
import MobileButton from '../../../components/MobileButton.uvue';
import FormActions from '../../../components/FormActions.uvue';
import FormField from '../../../components/FormField.uvue';
const props = defineProps<{ disabled: boolean; fileId: string }>();
const emit = defineEmits(['change', 'busy']);
const source = ref(''), mode = ref('完整'), zoom = ref(100), busy = ref(false), error = ref('');
const instance = getCurrentInstance();
const canvasId = 'bank-card-cover-upload-' + instance?.uid;
let active = true, width = 0, height = 0;
const imageStyle = computed(() => ({ transform: 'scale(' + (mode.value === '填满' ? zoom.value / 100 : 1) + ')' }));
function setBusy(value) { busy.value = value; emit('busy', value || !!source.value); }
function clear() {
  // #ifdef WEB
  if (source.value.startsWith('blob:')) URL.revokeObjectURL(source.value);
  // #endif
  source.value = ''; error.value = ''; emit('busy', false);
}
async function choose() {
  if (props.disabled || busy.value) return;
  const token = session.token;
  setBusy(true); error.value = '';
  try {
    const result: any = await new Promise((resolve, reject) => uni.chooseImage({ count: 1, sizeType: ['original'], success: resolve, fail: reject }));
    if (!active || token !== session.token) return;
    const path = result.tempFilePaths[0];
    const size = result.tempFiles?.[0]?.size;
    if (typeof size === 'number' && size > 5 * 1024 * 1024) throw Error('请选择不超过5MB的PNG或JPEG图片');
    const info: any = await new Promise((resolve, reject) => uni.getImageInfo({ src: path, success: resolve, fail: () => reject(Error('无法读取图片，请重试')) }));
    if (!active || token !== session.token) return;
    let imageType = info.type || '';
    // H5 的 getImageInfo 只返回宽高，原始 File 保留 MIME 类型。
    // #ifdef WEB
    imageType = (result.tempFiles?.[0]?.type || '').replace('image/', '');
    // #endif
    if (!['png', 'jpeg', 'jpg'].includes(String(imageType).toLowerCase())) throw Error('卡面仅支持PNG或JPEG图片');
    coverPlacement(info.width, info.height, 'contain');
    width = info.width; height = info.height; source.value = path; mode.value = '完整'; zoom.value = 100;
  } catch (reason) {
    if (active && token === session.token && !String(reason.errMsg || '').includes('cancel')) error.value = reason.message || '选择图片失败，请重试';
  } finally { if (active) setBusy(false); }
}
function render(): Promise<string> {
  return new Promise((resolve, reject) => {
    uni.createCanvasContextAsync({ id: canvasId, component: instance?.proxy,
      async success(context) {
        try {
          const ctx = context.getContext('2d');
          if (!ctx) throw Error('画布初始化失败');
          ctx.canvas.width = 960; ctx.canvas.height = 605;
          const image = context.createImage();
          await new Promise((done, fail) => { image.onload = done; image.onerror = () => fail(Error('卡面读取失败')); image.src = source.value; });
          const box = coverPlacement(width, height, mode.value === '填满' ? 'cover' : 'contain', zoom.value / 100);
          ctx.clearRect(0, 0, 960, 605); ctx.drawImage(image, box.x, box.y, box.width, box.height);
          const data = context.toDataURL('image/png');
          if (!data.startsWith('data:image/png;base64,')) throw Error('图片处理失败');
          if (data.split(',')[1].length * 3 / 4 > 3 * 1024 * 1024) throw Error('处理后的卡面不能超过3MB');
          resolve(data);
        } catch (reason) { reject(reason); }
      }, fail: () => reject(Error('当前平台画布暂不可用，请重试')),
    });
  });
}
async function confirm() {
  if (!source.value || busy.value || props.disabled) return;
  const token = session.token;
  let path = '';
  setBusy(true); error.value = '';
  try {
    await nextTick();
    const data = await render();
    if (!active || token !== session.token) return;
    // #ifdef WEB
    const bytes = uni.base64ToArrayBuffer(data.split(',')[1]);
    path = URL.createObjectURL(new Blob([bytes], { type: 'image/png' }));
    // #endif
    // #ifdef MP-WEIXIN
    path = uni.env.USER_DATA_PATH + '/bank-card-cover-' + Date.now() + '.png';
    // #endif
    // #ifdef APP
    path = uni.env.CACHE_PATH + '/bank-card-cover-' + Date.now() + '.png';
    // #endif
    // #ifndef WEB
    await new Promise((resolve, reject) => uni.getFileSystemManager().writeFile({ filePath: path, data: uni.base64ToArrayBuffer(data.split(',')[1]), success: resolve, fail: () => reject(Error('卡面文件生成失败')) }));
    // #endif
    if (!active || token !== session.token) return;
    const result = await uploadAttachment('/system/bank-card-covers/upload', path);
    if (active && token === session.token) { emit('change', result.id); clear(); }
  } catch (reason) {
    if (active && token === session.token) error.value = reason.message || '上传失败，请重试';
  } finally {
    // #ifdef WEB
    if (path.startsWith('blob:')) URL.revokeObjectURL(path);
    // #endif
    // #ifndef WEB
    if (path) uni.getFileSystemManager().unlink({ filePath: path });
    // #endif
    if (active) setBusy(false);
  }
}
onUnmounted(() => { active = false; clear(); });
</script>
<template>
  <view class="cover-upload">
    <template v-if="source">
      <view class="crop-preview"><image class="crop-image" :src="source" :mode="mode === '填满' ? 'aspectFill' : 'aspectFit'" :style="imageStyle" aria-label="调整卡面预览" /></view>
      <FormField label="图片适配" kind="selector" :options="['完整', '填满']" v-model="mode" :disabled="busy" />
      <slider v-if="mode === '填满'" :value="zoom" :min="100" :max="300" :step="5" :disabled="busy" aria-label="卡面缩放" @changing="zoom = $event.detail.value" @change="zoom = $event.detail.value" />
      <FormActions><MobileButton label="取消调整" variant="quiet" :disabled="busy" @click="clear" /><MobileButton label="确认上传" :loading="busy" @click="confirm" /></FormActions>
    </template>
    <view v-else class="ui-row"><MobileButton :label="fileId ? '更换卡面' : '上传卡面'" icon="ant-design:upload-outlined" variant="quiet" :disabled="disabled" :loading="busy" @click="choose" /><MobileButton v-if="fileId" label="移除卡面" icon="ant-design:delete-outlined" variant="quiet" :disabled="disabled || busy" @click="emit('change', '')" /></view>
    <text v-if="error" class="upload-error ui-mt-sm" role="alert">{{ error }}</text>
    <canvas :id="canvasId" :canvas-id="canvasId" type="2d" class="upload-canvas" />
  </view>
</template>
<style scoped lang="scss">
@use '../../../styles/spacing.scss';
@use '../../../styles/spacing-tokens' as *;
@use '../../../styles/typography' as *;
.crop-preview { width: 100%; aspect-ratio: 960 / 605; overflow: hidden; border-radius: 14px; background-color: #e6e9ee; margin-bottom: $space-form; }
.crop-image { width: 100%; height: 100%; }
.upload-error { @include type-style('caption'); color: #d44756; }
// 画布尺寸是卡面输出几何规格，不参与表单间距。
.upload-canvas { position: fixed; left: -2000px; top: 0; width: 960px; height: 605px; pointer-events: none; }
</style>
