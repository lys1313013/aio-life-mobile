<script setup lang="ts">
import { currentPageAccess, usePageRefresh } from '../../services/page-refresh.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, ref, watch } from 'vue';
import { onShow, onHide, onUnload } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import PageState from '../../components/PageState.uvue';
import CalendarPicker from '../../components/CalendarPicker.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FormActions from '../../components/FormActions.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import TimeStatistics from '../../components/TimeStatistics.uvue';
import AioChart from '../../components/AioChart.uvue';
import { request } from '../../services/api.ts';
import { restoreSession, session } from '../../services/session.ts';
import { todayDate } from '../../services/dashboard.ts';
import { getPeriodRecords } from '../../services/time.ts';
import {
  categoryPath,
  matchesCategories,
  recordMinutes,
  shiftDate,
  periodRange,
} from '../../services/time-format.ts';
import { durationLabel } from '../../services/dashboard-format.ts';
import { themeClass } from '../../services/theme.ts';
import { createLatestTask } from '../../services/mobile-ui.ts';
const date = ref(todayDate()),
  mode = ref('week'),
  selected = ref<string[]>([]),
  records = ref<any[]>([]),
  previous = ref<any[]>([]),
  categories = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  revision = ref(0);
const showFilters = ref(false);
const draftSelected = ref<string[]>([]);
const task = createLatestTask();
let active = true, shown = false;
const modes = [
  { label: '日', value: 'day' },
  { label: '周', value: 'week' },
  { label: '月', value: 'month' },
];
const range = computed(() => periodRange(date.value, mode.value));
const queryKey = computed(() => mode.value + ':' + date.value);
const loadedQueryKey = ref('');
const loadedOwner = ref('');
const recordsReady = computed(() => !!session.token && loadedOwner.value === session.token && loadedQueryKey.value === queryKey.value);
const cards = computed(() =>
  categories.value
    .filter(
      (category) =>
        category.isTrackTime === 1 &&
        category.isEnabled !== 0 &&
        matchesCategories(category.id, selected.value, categories.value),
    )
    .map((category) => {
      const sum = (rows) =>
        rows
          .filter((row) => matchesCategories(row.categoryId, [category.id], categories.value))
          .reduce((value, row) => value + recordMinutes(row), 0);
      const current = sum(records.value),
        before = sum(previous.value);
      return {
        id: category.id,
        name: categoryPath(category.id, categories.value),
        duration: durationLabel(current),
        current,
        before,
        difference: current - before,
      };
    }),
);
function suspend() {
  active = false;
  task.invalidate();
  loading.value = false;
  refreshing.value = false;
}
onHide(suspend);
onUnload(suspend);
function clearRecords() {
  task.invalidate();
  loadedQueryKey.value = '';
  loadedOwner.value = '';
  records.value = [];
  previous.value = [];
  categories.value = [];
  selected.value = [];
  draftSelected.value = [];
  showFilters.value = false;
  error.value = '';
  loading.value = false;
  refreshing.value = false;
}
watch(() => session.token, clearRecords, { flush: 'sync' });
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['timeRecord', 'timeTrackerCategory'] })
onShow(() => {
  active = true;
  restoreSession();
  if (shown && currentPageAccess().expired) clearRecords();
  shown = true;
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
async function load(refresh = false) {
  if (loadedOwner.value && (loadedOwner.value !== session.token || currentPageAccess().expired)) clearRecords();
  const generation = task.begin(),
    token = session.token;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  const currentDate = date.value,
    currentMode = mode.value,
    currentKey = queryKey.value;
  try {
    const [categoryRows, current, prev] = await Promise.all([
      request('/timeTrackerCategory/all'),
      getPeriodRecords(currentDate, currentMode),
      getPeriodRecords(shiftDate(currentDate, -1, currentMode), currentMode),
    ]);
    if (!Array.isArray(categoryRows) || !Array.isArray(current) || !Array.isArray(prev))
      throw Error('统计数据异常');
    if (active && task.isCurrent(generation) && token === session.token) {
      categories.value = categoryRows;
      records.value = current;
      previous.value = prev;
      loadedQueryKey.value = currentKey;
      loadedOwner.value = token;
      revision.value++;
    }
  } catch (reason) {
    if (active && task.isCurrent(generation) && token === session.token)
      error.value = reason.message || '加载失败';
  } finally {
    if (active && task.isCurrent(generation)) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function setMode(value) {
  if (mode.value === value) return;
  mode.value = value;
  load();
}
function setDate(value) {
  if (date.value === value) return;
  date.value = value;
  load();
}
function move(delta) {
  date.value = shiftDate(date.value, delta, mode.value);
  load();
}
function openFilters() {
  draftSelected.value = [...selected.value];
  showFilters.value = true;
}
function toggle(id) {
  draftSelected.value = draftSelected.value.includes(id)
    ? draftSelected.value.filter((value) => value !== id)
    : [...draftSelected.value, id];
}
function applyFilters() {
  selected.value = [...draftSelected.value];
  showFilters.value = false;
}
</script>
<template>
  <view class="time-dashboard-page"
    ><PageHeader title="时间看板" back @back="uni.navigateBack()" /><MobilePage
      :refreshing="refreshing"
      @refresh="load(true)"
      ><view class="time-dashboard-toolbar">
        <view class="time-dashboard-mode-bar">
          <view class="time-dashboard-actions">
            <MobileButton v-for="item in modes" :key="item.value" :label="item.label"
              :variant="mode === item.value ? 'primary' : 'quiet'" @click="setMode(item.value)" />
          </view>
          <view class="time-dashboard-filter-trigger">
            <MobileButton :label="selected.length ? '筛选分类（' + selected.length + '）' : '筛选分类'" icon="ant-design:filter-outlined" :variant="selected.length ? 'primary' : 'quiet'" @click="openFilters" />
          </view>
        </view>
        <view class="time-dashboard-date-row">
          <MobileButton label="上一时段" icon="ant-design:left-outlined" variant="quiet" @click="move(-1)" />
          <CalendarPicker class="time-dashboard-date" label="选择日期" :value="date" @change="setDate">
            <view class="time-dashboard-date-face" :class="themeClass('time-dashboard-date-face')">
              <AppIcon name="ant-design:calendar-outlined" :size="18" color="#8b8f99" />
              <text class="time-dashboard-date-value" :class="themeClass('time-dashboard-date-value')">{{ date }}</text>
            </view>
          </CalendarPicker>
          <MobileButton label="下一时段" icon="ant-design:right-outlined" variant="quiet" @click="move(1)" />
        </view>
        <text v-if="mode !== 'day'" class="time-dashboard-range" :class="themeClass('time-dashboard-range')">{{ range.start }} — {{ range.end }}</text>
      </view>
      <PageState skeleton="dashboard" :content-key="queryKey" :loading="loading" :retain-content="recordsReady" :has-content="recordsReady" :error="error" :empty="recordsReady && !records.length" @retry="load()"
        ><template #loading><view class="time-dashboard-cards ui-row"><view v-for="n in 2" :key="n" class="time-dashboard-card ui-card" :class="themeClass('time-dashboard-card')"><ContentSkeleton variant="summary" /></view></view><ContentSkeleton variant="chart" /><ContentSkeleton variant="distribution" :rows="2" /></template><view v-if="recordsReady" class="time-dashboard-cards ui-row"
          ><view
            v-for="card in cards"
            :key="card.id"
            class="time-dashboard-card ui-card"
            :class="themeClass('time-dashboard-card')"
            ><text class="time-dashboard-name" :class="themeClass('time-dashboard-name')">{{ card.name }}</text
            ><text class="time-dashboard-value" :class="themeClass('time-dashboard-value')">{{ card.duration }}</text
            ><text class="time-dashboard-diff" :class="themeClass('time-dashboard-diff')">{{
              card.difference === 0
                ? '与上期相同'
                : (card.difference > 0 ? '↑ ' : '↓ ') + durationLabel(Math.abs(card.difference))
            }}</text></view
          ></view
        ><AioChart
          v-if="recordsReady && cards.length"
          label="追踪分类与上期对比"
          :labels="cards.map((card) => card.name)"
          :series="[
            { name: '上期', color: '#94a3b8', values: cards.map((card) => card.before) },
            { name: '本期', color: '#427bea', values: cards.map((card) => card.current) },
          ]"
          kind="bar"
          unit="分钟" /><TimeStatistics
          v-if="recordsReady"
          :records="records"
          :categories="categories"
          :selected="selected"
          :date="date"
          :mode="mode"
          :revision="revision" /></PageState></MobilePage
  >
    <AdaptiveModal v-if="showFilters" label="筛选分类" :max-width="420" @close="showFilters = false">
      <view class="time-dashboard-filter-heading">
        <text class="time-dashboard-filter-title" :class="themeClass('time-dashboard-filter-title')">分类筛选</text>
        <MobileButton label="重置" variant="ghost" :disabled="!draftSelected.length" @click="draftSelected = []" />
      </view>
      <text v-if="!categories.length" class="time-dashboard-range" :class="themeClass('time-dashboard-range')">暂无分类</text>
      <view class="time-dashboard-filter-options">
        <MobileButton v-for="category in categories" :key="category.id"
          :label="categoryPath(category.id, categories)"
          :variant="draftSelected.includes(category.id) ? 'primary' : 'quiet'"
          :aria-pressed="draftSelected.includes(category.id)"
          @click="toggle(category.id)" />
      </view>
      <template #footer>
        <FormActions>
          <MobileButton label="取消" variant="quiet" @click="showFilters = false" />
          <MobileButton label="应用筛选" @click="applyFilters" />
        </FormActions>
      </template>
    </AdaptiveModal>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.time-dashboard-page {
  height: 100%;
  flex: 1;
  min-height: 0;
}
.time-dashboard-toolbar { gap: $space-inline; margin-bottom: $space-section; }
.time-dashboard-mode-bar { flex-direction: row; align-items: center; justify-content: space-between; gap: $space-inline; }
.time-dashboard-actions, .time-dashboard-date-row, .time-dashboard-filter-trigger { flex-direction: row; align-items: center; gap: $space-inline; }
.time-dashboard-filter-trigger { min-width: 0; }
.time-dashboard-date { flex: 1; min-width: 0; }
.time-dashboard-date-face { flex-direction: row; align-items: center; justify-content: center; gap: $space-inline; min-height: $space-controlMin; border-radius: 12px; background-color: #ffffff; }
.time-dashboard-date-face-dark { background-color: #1c1e22; }
.time-dashboard-date-value { @include type-style('body'); color: #27272a; }
.time-dashboard-range { color: $text-secondary-light; @include type-style('label'); }
.time-dashboard-filter-heading { flex-direction: row; justify-content: space-between; align-items: center; gap: $space-inline; margin-bottom: $space-section; }
.time-dashboard-filter-title { @include type-style('title'); color: #27272a; }
.time-dashboard-filter-options { flex-direction: row; flex-wrap: wrap; gap: $space-inline; }
.time-dashboard-range-dark { color: $text-secondary-dark; }
.time-dashboard-date-value-dark, .time-dashboard-filter-title-dark { color: #eeeeef; }
.time-dashboard-cards {
  flex-direction: row;
  flex-wrap: wrap;

}
.time-dashboard-card {

  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;
  min-width: 150px;
  flex: 1;

}
.time-dashboard-card-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.time-dashboard-name {
  @include type-style('body');
  color: #27272a;
}
.time-dashboard-value {
  @include type-style('metric');
  color: #27272a;
}
.time-dashboard-diff {
  @include type-style('label');
  color: $text-secondary-light;
}
.time-dashboard-name-dark, .time-dashboard-value-dark { color: #eeeeef; }
.time-dashboard-diff-dark { color: $text-secondary-dark; }
</style>
