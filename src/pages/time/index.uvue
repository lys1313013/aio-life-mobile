  background-color: #4e7ee3;
  font-size: 30px;
  box-shadow: 0 4px 16px rgba(78, 126, 227, 0.25);
}
@media (prefers-color-scheme: dark) {
  .date-value,
  .total-value,
  .record-name,
  .section-label {
    color: #eeeeef;
  }
  .record-duration,
  .date-step,
  .filter-label,
  .stat-name {
    color: #b4b4bd;
  }
  .record-list,
  .stats-card,
  .period-active {
    background-color: #1c1e22;
  }
  .period-tabs,
  .stat-track {
    background-color: #282b32;
  }
  .period-active {
    color: #8eb1fb;
  }
}
/* #ifdef WEB || MP-WEIXIN */
.period-tab::after,
.today-button::after,
.record-row::after,
.add-record::after {
  border: 0;
}
