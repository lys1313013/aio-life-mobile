<script setup lang="ts">
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { isDark, themeClass } from '../../services/theme.ts'
import { useRefreshTheme } from '../../services/refresh-theme.ts'
const refreshTheme = useRefreshTheme()
import { takeRecordChange } from '../../services/time-changes.ts'
import { nextTick, computed, ref } from 'vue'
import { onShow, onHide } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import FloatingActionButton from '../../components/FloatingActionButton.uvue'
import AdaptiveModal from '../../components/AdaptiveModal.uvue'
import CategoryIcon from '../../components/CategoryIcon.uvue'
import TimeRecordCards from '../../components/TimeRecordCards.uvue'
import TimeStatistics from '../../components/TimeStatistics.uvue'
import TimeTimeline from '../../components/TimeTimeline.uvue'
import TimeRecordEditor from '../../components/TimeRecordEditor.uvue'
import { todayDate } from '../../services/dashboard.ts'
import type { Category, TimeRecord } from '../../services/dashboard.ts'
import { getCategories, getPeriodRecords } from '../../services/time.ts'
import {
  categoryPath,
  categoryMatches,
  matchesCategories,
  periodRange,
  shiftDate,
  recordMinutes,
} from '../../services/time-format.ts'
import { durationLabel } from '../../services/dashboard-format.ts'
import { restoreSession, session } from '../../services/session.ts'

const date = ref(todayDate())
const mode = ref('day')
const showFilters = ref(false)
const selectedCategories = ref<string[]>([])
const draftCategories = ref<string[]>([])
let savedView = 'timeline'
try {
  savedView =
    uni.getStorageSync('time-tracker-view-mode') === 'card'
      ? 'card'
      : 'timeline'
} catch (_) {
  /* 默认时间轴 */
}
const viewMode = ref(savedView)
const revision = ref(0)
function selectView(value: string) {
  viewMode.value = value
  try {
    uni.setStorageSync('time-tracker-view-mode', value)
  } catch (_) {
    /* 存储不可用时仍可切换视图 */
  }
}
function openFilters() {
  draftCategories.value = [...selectedCategories.value]
  showFilters.value = true
}
function toggleFilter(id: string) {
  draftCategories.value = draftCategories.value.includes(id)
    ? draftCategories.value.filter((value) => value !== id)
    : [...draftCategories.value, id]
}
function applyFilters() {
  selectedCategories.value = [...draftCategories.value]
  showFilters.value = false
}
const editor = ref<{ recordId: string; initialDate: string } | null>(null)
const modeOptions = [
  { key: 'day', label: '日' },
  { key: 'week', label: '周' },
  { key: 'month', label: '月' },
]
const loading = ref(false),
  refreshing = ref(false)
const errorText = ref('')
const categories = ref<Category[]>([]),
  records = ref<TimeRecord[]>([]),
  previous = ref<TimeRecord[]>([])
const range = computed(() => periodRange(date.value, mode.value))
const filtered = computed(() =>
  records.value.filter((r) =>
    matchesCategories(r.categoryId, selectedCategories.value, categories.value),
  ),
)
const filterLabel = computed(() =>
  selectedCategories.value.length === 0
    ? '全部分类'
    : selectedCategories.value.length === 1
      ? categoryPath(selectedCategories.value[0], categories.value)
      : selectedCategories.value.length + ' 个分类',
)
const comparisons = computed(() =>
  categories.value
    .filter((c) => c.isTrackTime === 1 && c.isEnabled !== 0)
    .map((c) => {
      const sum = (items: TimeRecord[]) =>
        items
          .filter((r) => categoryMatches(r.categoryId, c.id, categories.value))
          .reduce((total, r) => total + recordMinutes(r), 0)
      return {
        id: c.id,
        name: categoryPath(c.id, categories.value),
        minutes: sum(records.value),
        diff: sum(records.value) - sum(previous.value),
      }
    }),
)
const total = computed(() =>
  filtered.value.reduce((sum, r) => sum + recordMinutes(r), 0),
)
const unrecorded = computed(() =>
  Math.max(
    0,
    range.value.days * 1440 -
      records.value.reduce((sum, r) => sum + recordMinutes(r), 0),
  ),
)
const recordedDays = computed(
  () => new Set(records.value.map((r) => r.date)).size,
)
const average = computed(() =>
  Math.round(total.value / Math.max(1, recordedDays.value)),
)
let generation = 0
onShow(() => {
  restoreSession()
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  if (applyRecordChange()) return
  load()
})
onHide(() => {
  editor.value = null
  showFilters.value = false
  generation++
  loading.value = false
  refreshing.value = false
})
function applyRecordChange() {
  const change = takeRecordChange()
  if (change) {
    records.value = records.value.filter(
      (r) => r.id !== change.deletedId && r.id !== change.record?.id,
    )
    previous.value = previous.value.filter(
      (r) => r.id !== change.deletedId && r.id !== change.record?.id,
    )
    const item = change.record
    const previousRange = periodRange(
      shiftDate(date.value, -1, mode.value),
      mode.value,
    )
    if (
      item?.date &&
      item.date >= previousRange.start &&
      item.date <= previousRange.end
    )
      previous.value.push(item)
    if (
      item?.date &&
      item.date >= range.value.start &&
      item.date <= range.value.end
    )
      records.value.push(item)
    revision.value++
    return true
  }
  return false
}
async function load() {
  const requestId = ++generation,
    token = session.token
  const targetDate = date.value,
    targetMode = mode.value
  loading.value = true
  errorText.value = ''
  try {
    const [cats, current, prev] = await Promise.all([
      getCategories(),
      getPeriodRecords(targetDate, targetMode),
      getPeriodRecords(shiftDate(targetDate, -1, targetMode), targetMode),
    ])
    if (requestId !== generation || session.token !== token) return
    categories.value = cats
    records.value = current
    previous.value = prev
    revision.value++
  } catch (error) {
    if (requestId !== generation) return
    if (error.name === 'SessionExpiredError') {
      uni.reLaunch({ url: '/pages/login/index' })
      return
    }
    errorText.value = error.message || '加载失败，请重试'
  } finally {
    if (requestId === generation) loading.value = false
  }
}
async function pullRefresh() {
  if (refreshing.value) return
  refreshing.value = true
  await nextTick()
  try {
    await load()
  } finally {
    refreshing.value = false
  }
}
function changePeriod() {
  records.value = []
  previous.value = []
  load()
}
function selectDate(event) {
  date.value = event.detail.value
  changePeriod()
}
function moveDate(days: number) {
  date.value = shiftDate(date.value, days, mode.value)
  changePeriod()
}
function selectMode(value: string) {
  if (mode.value !== value) {
    mode.value = value
    changePeriod()
  }
}
function edit(record: TimeRecord | null = null) {
  editor.value = {
    recordId: record?.id || '',
    initialDate: record?.date || date.value,
  }
}
function closeEditor() {
  editor.value = null
  applyRecordChange()
}
function goToday() {
  date.value = todayDate()
  changePeriod()
}
</script>

<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="时迹">
      <view class="date-switch" :class="themeClass('date-switch')">
        <button role="button" class="date-step" hover-class="control-pressed" :hover-stay-time="100" :aria-label="mode === 'day' ? '前一天' : '上一周期'" @click="moveDate(-1)"><AppIcon name="ant-design:left-outlined" :size="16" /></button>
        <picker mode="date" aria-label="选择日期" :value="date" @change="selectDate"><view class="date-picker"><text class="date-value" :class="themeClass('date-value')">{{ date }}</text></view></picker>
        <button role="button" class="date-step" hover-class="control-pressed" :hover-stay-time="100" :aria-label="mode === 'day' ? '后一天' : '下一周期'" @click="moveDate(1)"><AppIcon name="ant-design:right-outlined" :size="16" /></button>
      </view>
    </PageHeader>
    <scroll-view
      scroll-y
      class="tab-scroll"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      refresher-background="transparent"
      :refresher-default-style="refreshTheme"
      @refresherrefresh="pullRefresh"
    >
      <view class="tab-content time-content ui-page-inset ui-tab-page-inset">
        <scroll-view direction="horizontal" :scroll-x="true" :show-scrollbar="false" class="time-toolbar-scroll ui-section">
        <view class="time-toolbar ui-toolbar" :class="{ 'time-toolbar-with-today': date !== todayDate() }">
          <view class="toolbar-date-group ui-row">
            <button role="button" class="filter-trigger" hover-class="control-pressed" :hover-stay-time="100" :class="[themeClass(['filter-trigger', { 'filter-active': selectedCategories.length > 0 }]), { 'filter-active': selectedCategories.length > 0 }]" aria-label="筛选分类" :aria-description="filterLabel" @click="openFilters">
              <AppIcon name="ant-design:filter-outlined" :color="selectedCategories.length ? (isDark ? '#a9c3ff' : '#427bea') : (isDark ? '#a4a8b2' : '#737985')" />
              <view v-if="selectedCategories.length" class="filter-dot" />
            </button>
          </view>
          <view class="toolbar-view-group ui-row">
            <view class="period-tabs" :class="themeClass('period-tabs')">
              <button v-for="item in modeOptions" :key="item.key" role="button" :aria-label="item.label + '视图'" :aria-pressed="mode === item.key" class="period-tab" hover-class="control-pressed" :hover-stay-time="100" :class="[{ 'period-active': mode === item.key }, themeClass(['period-tab', { 'period-active': mode === item.key }])]" @click="selectMode(item.key)">{{ item.label }}</button>
            </view>
            <view class="view-tabs" :class="themeClass('view-tabs')">
              <button role="button" class="view-tab" hover-class="control-pressed" :hover-stay-time="100" :class="[{ 'view-active': viewMode === 'timeline' }, themeClass({ 'view-active': viewMode === 'timeline' })]" aria-label="时间轴视图" :aria-pressed="viewMode === 'timeline'" @click="selectView('timeline')"><AppIcon name="ant-design:clock-circle-outlined" :color="viewMode === 'timeline' ? (isDark ? '#a9c3ff' : '#427bea') : (isDark ? '#a4a8b2' : '#737985')" /></button>
              <button role="button" class="view-tab" hover-class="control-pressed" :hover-stay-time="100" :class="[{ 'view-active': viewMode === 'card' }, themeClass({ 'view-active': viewMode === 'card' })]" aria-label="卡片视图" :aria-pressed="viewMode === 'card'" @click="selectView('card')"><AppIcon name="ant-design:appstore-outlined" :color="viewMode === 'card' ? (isDark ? '#a9c3ff' : '#427bea') : (isDark ? '#a4a8b2' : '#737985')" /></button>
            </view>
            <button v-if="date !== todayDate()" role="button" class="today-button today-surface" :class="themeClass('today-surface')" hover-class="control-pressed" :hover-stay-time="100" aria-label="回到今天" @click="goToday"><AppIcon name="ant-design:calendar-outlined" color="#5b8ff9" /></button>
          </view>
        </view>
        </scroll-view>
        <view
          v-if="errorText"
          class="state-card"
          :class="themeClass('state-card')"
          ><text
            class="error-text"
            role="alert"
            :class="themeClass('error-text')"
            >{{ errorText }}</text
          ><button role="button" class="text-action" @click="load">
            重试时迹记录
          </button></view
        >
        <template
          v-if="
            !errorText || records.length > 0
          "
        >
          <view class="time-layout ui-gap-md">
          <view class="time-main-panel" :aria-busy="loading">
          <LoadingIndicator v-if="loading && !refreshing && records.length" floating label="正在更新时迹" />
          <TimeTimeline
            v-if="viewMode === 'timeline'"
            :key="mode + date"
            :loading="loading && !records.length"
            :records="records"
            :selected="selectedCategories"
            :categories="categories"
            :start-date="range.start"
            :days="range.days"
            @edit="edit"
          />
          <TimeRecordCards
            v-else
            :loading="loading && !records.length"
            :records="filtered"
            :show-date="mode !== 'day'"
            :categories="categories"
            @edit="edit"
          />
          </view>
          <view class="time-stats-panel">
            <view v-if="loading && !records.length" class="time-pending-stats">
              <ContentSkeleton variant="metrics" :metrics="2" label="正在加载时间统计" />
              <ContentSkeleton variant="chart" />
              <ContentSkeleton variant="distribution" :rows="2" />
            </view>
            <template v-else><view class="summary-grid ui-row ui-mb-section">
              <view class="summary-card ui-pad-card" :class="themeClass('summary-card')"><text class="summary-label" :class="themeClass('summary-label')">时长</text><text class="summary-value" :class="themeClass('summary-value')">{{ durationLabel(total) }}</text></view>
              <view v-if="!selectedCategories.length" class="summary-card ui-pad-card" :class="themeClass('summary-card')"><text class="summary-label" :class="themeClass('summary-label')">空闲</text><text class="summary-value" :class="themeClass('summary-value')">{{ durationLabel(unrecorded) }}</text></view>
              <view v-else-if="mode !== 'day'" class="summary-card ui-pad-card" :class="themeClass('summary-card')"><text class="summary-label" :class="themeClass('summary-label')">平均</text><text class="summary-value" :class="themeClass('summary-value')">{{ durationLabel(average) }}</text></view>
              <view v-for="item in comparisons" :key="item.id" class="summary-card tracked-item ui-pad-card" :class="themeClass('summary-card')">
                <view class="summary-heading"><text class="summary-label" :class="themeClass('summary-label')">{{ item.name }}</text><text class="summary-diff" :class="[themeClass('summary-diff'), { 'diff-up': item.diff > 0, 'diff-down': item.diff < 0 }]">{{ item.diff === 0 ? '−' : (item.diff > 0 ? '↑ ' : '↓ ') + durationLabel(Math.abs(item.diff)) }}</text></view>
                <text class="summary-value" :class="themeClass('summary-value')">{{ durationLabel(item.minutes) }}</text>
              </view>
            </view>
            <TimeStatistics :records="records" :categories="categories" :selected="selectedCategories" :date="date" :mode="mode" :revision="revision" /></template>
          </view>
          </view>
          <view
            v-if="!loading && filtered.length === 0 && !errorText"
            class="state-card"
            :class="themeClass('state-card')"
            ><text class="empty-title" :class="themeClass('empty-title')">{{
              selectedCategories.length
                ? '这个分类暂无记录'
                : '这段时间还没有记录'
            }}</text
            ><text class="muted-text">点击右下角，记下你的时间</text></view
          >
        </template>
      </view>
    </scroll-view>
    <SecondaryUnlock />
    <FloatingActionButton
      label="新增时迹"
      :disabled="loading || !!errorText"
      @click="edit()"
    />
    <AdaptiveModal
      v-if="showFilters"
      label="筛选分类"
      @close="showFilters = false"
    >
      <view class="filter-heading ui-mb-sm"
        ><text class="filter-title" :class="themeClass('filter-title')"
          >分类筛选</text
        ><button
          role="button"
          class="today-button"
          @click="draftCategories = []"
        >
          重置
        </button></view
      >
      <text v-if="!categories.length" class="muted-text">暂无分类</text>
      <button
        v-for="item in categories"
        :key="item.id"
        role="button"
        class="filter-option ui-px-card ui-py-sm ui-type-body"
        :class="{ 'filter-option-active': draftCategories.includes(item.id) }"
        :aria-label="'筛选 ' + categoryPath(item.id, categories)"
        :aria-pressed="draftCategories.includes(item.id)"
        @click="toggleFilter(item.id)"
      >
        <CategoryIcon :icon="item.icon" :color="item.color" :size="22" /><text
          class="filter-option-name ui-ml-section"
          :class="themeClass('filter-option-name')"
          >{{ categoryPath(item.id, categories) }}</text
        ><AppIcon v-if="draftCategories.includes(item.id)" name="ant-design:check-outlined" color="#5b8ff9" />
      </button>
      <view class="filter-footer ui-mt-section"
        ><button
          role="button"
          class="filter-cancel ui-mr-section"
          @click="showFilters = false"
        >
          取消</button
        ><button role="button" class="filter-apply" @click="applyFilters">
          应用筛选
        </button></view
      >
    </AdaptiveModal>
    <TimeRecordEditor
      v-if="editor"
      :record-id="editor.recordId"
      :initial-date="editor.initialDate"
      @close="closeEditor"
    />
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/text-colors' as *;
@include type-utilities('body');

.time-content { max-width: $space-contentMax; }
.time-toolbar-scroll { width: 100%; }
// 保留触控尺寸，分段底座内缩；非今日的窄屏工具栏仍可横向滚动。
.time-toolbar { width: 100%; min-width: 6 * $space-controlMin + 2 * $space-inline + 4 * $space-tight; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; margin-bottom: 0; }
.time-toolbar-with-today { min-width: 7 * $space-controlMin + 3 * $space-inline + 4 * $space-tight; }
.toolbar-date-group, .toolbar-view-group { flex-direction: row; flex-wrap: nowrap; flex-shrink: 0; align-items: center; }
.date-switch, .period-tabs, .view-tabs { flex-direction: row; flex-shrink: 0; align-items: center; background-color: #e7eaef; border-radius: 15px; }
.period-tabs, .view-tabs { padding: $space-tight; }
.date-switch { background-color: #ffffff; border-radius: 14px; }
.date-step, .period-tab, .view-tab, .filter-trigger, .today-button { display: flex; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; width: $space-controlMin; height: $space-controlMin; line-height: $space-controlMin; margin: 0; padding: 0; border: 0; border-radius: 12px; background-color: transparent; color: #737985; @include type-style('body'); }
.date-picker { width: 88px; min-height: $space-controlMin; box-sizing: border-box; align-items: center; justify-content: center; padding: 0 $space-micro; }
.date-value { @include type-style('label-strong');  color: #343944; }
.filter-trigger, .today-surface { position: relative; border-radius: 14px; background-color: #e7eaef; }
.filter-active { background-color: #e3ecff; }
.filter-dot { position: absolute; top: $space-inline; right: $space-inline; width: 5px; height: 5px; border-radius: 3px; background-color: #5b8ff9; }
.period-active, .view-active { color: #427bea; font-weight: type-weight('medium'); background-color: #ffffff; box-shadow: 0 1px 4px rgba(28, 39, 61, 0.1); }
.control-pressed { opacity: 0.65; }
/* #ifdef WEB */
.date-step, .period-tab, .view-tab, .filter-trigger, .today-button { transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease, opacity 120ms ease; }
.date-step:focus-visible, .period-tab:focus-visible, .view-tab:focus-visible, .filter-trigger:focus-visible, .today-button:focus-visible { outline: 2px solid #5b8ff9; outline-offset: -2px; }
@media (prefers-reduced-motion: reduce) {
  .date-step, .period-tab, .view-tab, .filter-trigger, .today-button { transition: none; }
}
/* #endif */
.time-pending-stats { gap: $space-section; }
.time-main-panel, .time-stats-panel { min-width: 0; }
.time-main-panel { position: relative; }
.summary-grid { flex-direction: row; flex-wrap: wrap;   }
.summary-card { flex: 1; min-width: 100px; height: 86px;  background-color: #ffffff; border-radius: 8px; justify-content: space-between; }
.summary-heading { flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: $space-micro; }
.summary-label { @include type-style('badge'); color: $text-secondary-light; }
.summary-value { @include type-style('metric-compact');   color: #27272a; text-align: center; }
.summary-diff { @include type-style('chart-label'); color: $text-secondary-light; }
.summary-label-dark, .summary-diff-dark { color: $text-secondary-dark; }
.diff-up { color: #e05260; }
.diff-down { color: #20a574; }
.date-value-dark, .summary-value-dark { color: #eeeeef; }
.summary-card-dark { background-color: #1c1e22; }
.date-switch-dark, .period-tabs-dark, .view-tabs-dark, .filter-trigger-dark, .today-surface-dark { background-color: #202228; }
.period-tab-dark { color: #a4a8b2; }
.period-active-dark, .view-active-dark { background-color: #363b46; color: #a9c3ff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22); }
.filter-active-dark { background-color: #2c3953; }
@media (min-width: 1025px) {
  .time-layout { flex-direction: row; align-items: flex-start; }
  .time-main-panel { flex: 1; }
  .time-stats-panel { flex: 1; }
}
.filter-heading {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;

}
.filter-title {
  @include type-style('title');

  color: #27272a;
}
.filter-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 48px;
  width: 100%;
  margin: 0;

  border: 0;
  border-radius: 10px;
  background-color: transparent;
  text-align: left;
  line-height: type-line('body');
}
.filter-option-active {
  background-color: rgba(78, 126, 227, 0.12);
}
.filter-option-name {
  flex: 1;
  color: #52525b;
  @include type-style('body');

}
.filter-check {
  color: #4e7ee3;
  width: 24px;
  @include type-style('title');
  text-align: right;
}
.filter-footer {
  flex-direction: row;

}
.filter-cancel,
.filter-apply {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 44px;
  line-height: $space-controlMin;
  border: 0;
  border-radius: 10px;
  margin: 0;
  @include type-style('body');
}
.filter-cancel {
  background-color: transparent;
  color: #8b8f99;

}
.filter-apply {
  background-color: #4e7ee3;
  color: #ffffff;
}
.filter-title-dark, .filter-option-name-dark { color: #eeeeef; }
/* #ifdef WEB || MP-WEIXIN */
.date-step::after,
.period-tab::after,
.today-button::after,
.stats-toggle::after,
.filter-trigger::after,
.view-tab::after,
.filter-option::after,
.filter-cancel::after,
.filter-apply::after {
  border: 0;
}
/* #endif */

</style>
