}
.day-group {
  margin-bottom: 20px;
}
.day-heading {
  flex-direction: row;
  justify-content: space-between;
  margin: 0 4px 10px;
}
.record-list {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 0 16px;
}
