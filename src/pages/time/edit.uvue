<script setup lang="ts">
import ModalMotion from "../../components/ModalMotion.uvue";
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { themeClass } from '../../services/theme.ts'
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import TimeRecordEditor from '../../components/TimeRecordEditor.uvue'
const options = ref<{ recordId?: string; initialDate?: string } | null>(null)
onLoad((query) => {
  options.value = { recordId: query.id, initialDate: query.date }
})
function close() {
  uni.navigateBack()
}
</script>
<template>
  <view class="tab-page"
     :class="themeClass('tab-page')"><ModalMotion><TimeRecordEditor
      v-if="options"
      :record-id="options.recordId"
      :initial-date="options.initialDate"
      @close="close"
  /></ModalMotion><SecondaryUnlock />
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
</style>
