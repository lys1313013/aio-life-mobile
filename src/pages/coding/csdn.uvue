<script setup lang="ts">
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import { onMounted, onUnmounted, ref } from 'vue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import PageState from '../../components/PageState.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import {
  fetchCodingBindings,
  fetchCsdnStats,
  fetchCsdnArticles,
  openExternal,
} from '../../services/domains/coding.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { themeClass } from '../../services/theme.ts';
const stats = ref<any>(null),
  articles = ref<any[]>([]),
  username = ref(''),
  loading = ref(false),
  refreshing = ref(false),
  error = ref('');
let alive = true,
  stamp = 0;
onUnmounted(() => {
  alive = false;
  stamp++;
});
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const bindings = await fetchCodingBindings();
    const account = bindings.find((item) => item.platform === 'csdn');
    if (!account?.platformUsername) throw new Error('请先绑定 CSDN 账号');
    const data = await Promise.allSettled([
      fetchCsdnStats(account.platformUsername),
      fetchCsdnArticles(account.platformUsername),
    ]);
    if (!alive || stamp !== current) return;
    username.value = account.platformUsername;
    data.forEach((item, index) => {
      if (item.status === 'fulfilled') {
        if (index === 0) stats.value = item.value;
        else articles.value = item.value;
      } else error.value += (error.value ? '；' : '') + item.reason.message;
    });
  } catch (e) {
    if (alive && stamp === current) error.value = e.message;
  } finally {
    if (alive && stamp === current) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    stats.value = null;
    articles.value = [];
    loading.value = false;
    refreshing.value = false;
  },
);
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="CSDN" back @back="uni.navigateBack()" /><view
      class="body ui-page-body"
      :class="themeClass('body')"
      ><view class="actions ui-toolbar"
        ><text class="account-name">{{ username }}</text
        ><MobileButton
          label="账号绑定"
          icon="ant-design:setting-outlined"
          variant="quiet"
          @click="uni.navigateTo({ url: '/pages/profile/bindings' })" /></view
      ><PageState :has-content="!!stats || articles.length > 0" skeleton="articles" :loading="loading" :error="error" @retry="load"
        >
<template #loading><view class="metrics ui-row ui-section"><MetricCard v-for="label in ['总访问量', '原创数', '全站排名', '粉丝数', '获赞数', '评论']" :key="label" :label="label" value="" loading /></view><text class="heading ui-section">近期文章</text><view v-for="n in 3" :key="n" class="article ui-card" :class="themeClass('article')"><ContentSkeleton variant="tile" /></view></template>
<view v-if="stats" class="metrics ui-row ui-section"
          ><MetricCard label="总访问量" :value="String(stats.viewCount)" /><MetricCard
            label="原创数"
            :value="String(stats.originalCount)" /><MetricCard
            label="全站排名"
            :value="String(stats.rank)" /><MetricCard
            label="粉丝数"
            :value="String(stats.fansCount)" /><MetricCard
            label="获赞数"
            :value="String(stats.likeCount)" /><MetricCard
            label="评论"
            :value="String(stats.commentCount || 0)" /></view
        ><text class="heading ui-section">近期文章</text><view v-if="!articles.length" class="article empty ui-card" :class="themeClass('article')"><text class="muted" :class="themeClass('muted')">暂无近期文章</text></view><view v-for="item in articles" :key="item.id" class="article ui-card" :class="themeClass('article')"
          ><view class="record-head"><text class="record-title record-copy">{{ item.title }}</text><MobileButton label="打开文章" icon="ant-design:export-outlined" variant="quiet" @click="openExternal(item.url)" /></view>
          <text v-if="item.description" class="record-description" :class="themeClass('description')">{{ item.description }}</text>
          <view class="meta-list"><text class="meta-item" :class="themeClass('meta-item')">{{ item.postTime }}</text><view class="meta-item" :class="themeClass('meta-item')" :aria-label="'浏览 ' + item.viewCount"><AppIcon name="ant-design:eye-outlined" :size="13" /><text class="meta-value">{{ item.viewCount }}</text></view><view class="meta-item" :class="themeClass('meta-item')" :aria-label="'评论 ' + item.commentCount"><AppIcon name="ant-design:message-outlined" :size="13" /><text class="meta-value">{{ item.commentCount }}</text></view><view class="meta-item" :class="themeClass('meta-item')" :aria-label="'点赞 ' + (item.likeCount || 0)"><AppIcon name="ant-design:like-outlined" :size="13" /><text class="meta-value">{{ item.likeCount || 0 }}</text></view><view class="meta-item" :class="themeClass('meta-item')" :aria-label="'收藏 ' + (item.collectCount || 0)"><AppIcon name="ant-design:star-outlined" :size="13" /><text class="meta-value">{{ item.collectCount || 0 }}</text></view></view></view></PageState></view
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.actions {
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-inline;
}
@media (min-width: 768px) {
  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
.article {
  background-color: #ffffff;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
}
.title {
  @include type-style('title');

}
.muted {
  @include type-style('label');
  color: $text-secondary-light;
}
.record-dark, .article-dark { background-color: #1c1e22; }
.heading { display: block; @include type-style('title');  }
.empty { min-height: 88px; align-items: center; justify-content: center; }

.actions { align-items: center; justify-content: space-between; }
.account-name { @include type-style('body-strong');  overflow-wrap: anywhere; }
.record-head { display: flex; flex-direction: row; align-items: center; gap: $space-inline; }
.record-copy { flex: 1; min-width: 0; gap: $space-detail; }
.record-title { @include type-style('body-strong');   overflow-wrap: anywhere; }
.record-description { @include type-style('label');  color: $text-secondary-light; overflow-wrap: anywhere; }
.meta-list { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-inline; }
.meta-item { display: flex; flex-direction: row; align-items: center; gap: $space-detail; @include type-style('caption'); color: $text-secondary-light; }
.description-dark, .muted-dark, .meta-item-dark, .repo-label-dark { color: $text-secondary-dark; }

.meta-value { @include type-style('caption'); }
</style>
