<script setup lang="ts">
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import { computed, onUnmounted, reactive, ref } from 'vue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import PageState from '../../components/PageState.uvue';
import FormField from '../../components/FormField.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import {
  fetchCodingBindings,
  fetchCommits,
  fetchRepos,
  fetchRepoContributors,
  fetchRepoInfo,
  fetchGithubCalendar,
  calendarSummary,
  openExternal,
} from '../../services/domains/coding.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { themeClass } from '../../services/theme.ts';
const username = ref(''),
  repos = ref<any[]>([]),
  commits = ref<any[]>([]),
  days = ref<any[]>([]),
  total = ref(0),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  keyword = ref(''),
  kind = ref('全部'),
  sort = ref('最近推送'),
  page = ref(1),
  hasMore = ref(false),
  moreBusy = ref(false),
  moreError = ref('');
const sections = reactive({
  calendar: { loading: true, error: '' },
  repos: { loading: true, error: '' },
  commits: { loading: true, error: '' },
});
let alive = true,
  stamp = 0,
  token = '';
onUnmounted(() => {
  alive = false;
  stamp++;
  token = '';
});
const filtered = computed(() =>
  repos.value
    .filter(
      (item) =>
        (kind.value === '全部' || (kind.value === '原创' ? !item.fork : item.fork)) &&
        (item.name + ' ' + (item.description || ''))
          .toLowerCase()
          .includes(keyword.value.toLowerCase()),
    )
    .sort((a, b) =>
      sort.value === 'Star'
        ? b.stargazers_count - a.stargazers_count
        : sort.value === '我的提交'
          ? Number(b.myCommits || 0) - Number(a.myCommits || 0)
          : String(b.pushed_at).localeCompare(String(a.pushed_at)),
    ),
);
const today = new Date();
const todayKey =
  today.getFullYear() +
  '-' +
  String(today.getMonth() + 1).padStart(2, '0') +
  '-' +
  String(today.getDate()).padStart(2, '0');
const summary = computed(() => calendarSummary(days.value, todayKey));
async function load(section = '') {
  if (section ? sections[section].loading : loading.value) return;
  const current = section ? stamp : ++stamp;
  if (!section) repos.value.forEach(repo => { repo.statsBusy = false; });
  const keys = section ? [section] : ['calendar', 'repos', 'commits'];
  if (keys.includes('commits')) moreError.value = '';
  loading.value = true;
  error.value = '';
  keys.forEach(key => { sections[key].loading = true; sections[key].error = ''; });
  try {
    const bindings = await fetchCodingBindings(true);
    if (!alive || stamp !== current) return;
    const account = bindings.find((item) => item.platform === 'github');
    if (!account?.platformUsername) throw new Error('请先绑定 GitHub 账号');
    username.value = account.platformUsername;
    token = account.accessToken || '';
    await Promise.all(keys.map(async key => {
      try {
        if (key === 'calendar') {
          const result = await fetchGithubCalendar(username.value, token);
          if (!alive || stamp !== current) return;
          const calendar = result.data.user.contributionsCollection.contributionCalendar;
          total.value = calendar.totalContributions;
          days.value = calendar.weeks.flatMap(week => week.contributionDays.map(day => ({ date: day.date, count: day.contributionCount })));
        } else if (key === 'repos') {
          const result = await fetchRepos(username.value, token);
          if (!alive || stamp !== current) return;
          repos.value = result.map(repo => ({ ...repo, myCommits: null, statsBusy: true }));
          repoStats(current);
        } else {
          const result = await fetchCommits();
          if (!alive || stamp !== current) return;
          commits.value = result;
          page.value = 1;
          hasMore.value = result.length === 20;
        }
      } catch (reason) {
        if (alive && stamp === current) sections[key].error = reason.message || '加载失败';
      } finally {
        if (alive && stamp === current) sections[key].loading = false;
      }
    }));
  } catch (reason) {
    if (alive && stamp === current) {
      error.value = reason.message;
      keys.forEach(key => { sections[key].loading = false; });
    }
  } finally {
    if (alive && stamp === current) {
      loading.value = Object.values(sections).some(state => state.loading);
      if (!loading.value) refreshing.value = false;
    }
  }
}
async function repoStats(current: number) {
  for (const repo of repos.value.slice(0, 30)) {
    if (!alive || stamp !== current) return;
    try {
      const contributors = await fetchRepoContributors(repo.full_name, token);
      if (!alive || stamp !== current) return;
      repo.myCommits =
        contributors.find(
          (item) => String(item.login).toLowerCase() === username.value.toLowerCase(),
        )?.contributions || 0;
      if (repo.fork) {
        const data = await fetchRepoInfo(repo.full_name, token);
        if (!alive || stamp !== current) return;
        repo.sourceStars = data.parent?.stargazers_count;
      }
    } catch (e) {
      repo.statsError = e.message;
    } finally {
      repo.statsBusy = false;
    }
  }
  if (alive && stamp === current)
    repos.value.forEach((repo) => {
      repo.statsBusy = false;
    });
}
async function more() {
  if (!alive || moreBusy.value || loading.value || error.value || sections.commits.error || !hasMore.value) return;
  const current = stamp;
  moreBusy.value = true;
  moreError.value = '';
  try {
    const rows = await fetchCommits(page.value + 1);
    if (alive && current === stamp) {
      commits.value = [...commits.value, ...rows];
      page.value++;
      hasMore.value = rows.length === 20;
    }
  } catch (e) {
    if (alive && current === stamp) moreError.value = e.message || '加载失败，请重试';
  } finally {
    moreBusy.value = false;
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    token = '';
    repos.value = [];
    commits.value = [];
    days.value = [];
    hasMore.value = false;
    moreError.value = '';
    Object.values(sections).forEach(section => { section.loading = false; section.error = ''; });
    loading.value = false;
    refreshing.value = false;
  },
);
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @reachbottom="more()"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="GitHub" back @back="uni.navigateBack()" /><view
      class="body ui-page-body"
      :class="themeClass('body')"
      ><view class="actions ui-toolbar"
        ><text class="account-name">{{ username }}</text
        ><MobileButton
          label="账号绑定"
          icon="ant-design:setting-outlined"
          variant="quiet"
          @click="uni.navigateTo({ url: '/pages/profile/bindings' })" /></view
      ><PageState v-if="error" :error="error" @retry="load()" />
      <template v-if="!error || username"><PageState skeleton="calendar" :loading="sections.calendar.loading" :error="sections.calendar.error" @retry="load('calendar')"
        ><view class="metrics ui-row ui-section"
          ><MetricCard label="过去一年提交" :value="String(total)" /><MetricCard
            label="今日提交次数"
            :value="String(summary.today)" /><MetricCard
            label="连续提交"
            :value="String(summary.streak)"
            unit="天" /><MetricCard label="活跃天数" :value="String(summary.active)" unit="天" /></view
        ><scroll-view scroll-x class="calendar-scroll ui-card" :class="themeClass('calendar-scroll')"
          ><view class="calendar ui-gap-xs"
            ><view
              v-for="day in days"
              :key="day.date"
              class="day"
              :class="day.count > 0 ? 'active-day' : themeClass('day')"
              :aria-label="day.date + ' ' + day.count + ' 次贡献'"
              @click="
                uni.showToast({ title: day.date + ' · ' + day.count, icon: 'none' })
              " /></view></scroll-view
        ></PageState><text class="heading ui-section">仓库</text><FormField label="搜索仓库" placeholder="仓库名称或简介" v-model="keyword" /><view
          class="filters ui-field-row"
          ><FormField
            label="类型"
            kind="selector"
            compact stretch :options="['全部', '原创', 'Fork']"
            v-model="kind" /><FormField
            label="排序"
            kind="selector"
            compact stretch :options="['最近推送', 'Star', '我的提交']"
            v-model="sort" /></view
        ><PageState skeleton="list" :loading="sections.repos.loading" :error="sections.repos.error" :empty="!filtered.length" empty-text="暂无仓库" @retry="load('repos')"><view v-for="repo in filtered" :key="repo.id" class="record ui-card" :class="themeClass('record')">
          <view class="record-head">
            <view class="record-copy"><view class="meta-list"><text class="record-title">{{ repo.name }}</text><AppIcon v-if="repo.fork" name="ant-design:fork-outlined" :size="14" /></view><text v-if="repo.description" class="record-description" :class="themeClass('description')">{{ repo.description }}</text></view>
            <MobileButton label="打开仓库" icon="ant-design:export-outlined" variant="quiet" @click="openExternal(repo.html_url)" />
          </view>
          <view class="meta-list">
            <text v-if="repo.language" class="language">{{ repo.language }}</text>
            <view class="meta-item" :aria-label="repo.stargazers_count + ' Stars'"><AppIcon name="ant-design:star-outlined" :size="13" /><text class="meta-value">{{ repo.stargazers_count }}</text></view>
            <view class="meta-item" :aria-label="repo.forks_count + ' Forks'"><AppIcon name="ant-design:fork-outlined" :size="13" /><text class="meta-value">{{ repo.forks_count }}</text></view>
            <view class="meta-item"><text>我的提交</text><LoadingIndicator v-if="repo.statsBusy" compact label="正在加载仓库提交数" /><text v-else>{{ repo.myCommits ?? '—' }}</text></view>
            <text v-if="repo.sourceStars != null" class="meta-item">来源 Star {{ repo.sourceStars }}</text>
          </view>
          <text v-if="repo.statsError" class="error">{{ repo.statsError }}</text>
        </view>
        </PageState><text class="heading ui-section">最近提交</text>
        <PageState skeleton="timeline" :loading="sections.commits.loading" :error="sections.commits.error" :empty="!commits.length" empty-text="暂无提交" @retry="load('commits')">
        <view v-for="(item, index) in commits" :key="item.id || index" class="record ui-card" :class="themeClass('record')">
          <view class="record-head"><view class="record-copy"><text class="repo-label">{{ item.repo }}</text><text class="record-title">{{ item.message }}</text></view><MobileButton label="打开提交" icon="ant-design:export-outlined" variant="quiet" @click="openExternal(item.commitUrl || item.repoUrl)" /></view>
          <text class="muted">{{ item.date }} · {{ item.actor }}</text>
        </view>
        <LoadingIndicator v-if="moreBusy" compact label="正在加载更多" />
        <PageState v-else-if="moreError" :error="moreError" @retry="more()" />
        </PageState></template></view
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.actions {
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-inline;
}
@media (min-width: 768px) {
  .metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
.filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.record {
  background-color: #ffffff;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 18px;
  font-weight: 600;
}
.muted {
  font-size: 13px;
  color: #718096;
}
.heading {
  font-size: 17px;
  font-weight: 600;
  display: block;
}
.calendar-scroll {
  width: 100%;
}
.calendar {
  display: flex;
  flex-wrap: wrap;
  width: 760px;
  height: 110px;
  flex-direction: column;
}
.day {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  background-color: #dbe3df;
}
.active-day {
  background-color: #3d9974;
}
.error {
  color: #dc5454;
}
.record-dark, .article-dark { background-color: #1c1e22; }

.actions { align-items: center; justify-content: space-between; }
.account-name { font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
.record-head { display: flex; flex-direction: row; align-items: center; gap: $space-inline; }
.record-copy { flex: 1; min-width: 0; gap: $space-detail; }
.record-title { font-size: 15px; line-height: 22px; font-weight: 600; overflow-wrap: anywhere; }
.record-description { font-size: 13px; line-height: 20px; color: #687386; overflow-wrap: anywhere; }
.meta-list { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-inline; }
.meta-item { display: flex; flex-direction: row; align-items: center; gap: $space-detail; font-size: 12px; color: #788394; }
.description-dark { color: #a6aab4; }


.language { color: #537cac; background-color: rgba(83,124,172,.1); border-radius: 5px; padding: $space-micro $space-detail; font-size: 12px; }
.repo-label { font-size: 12px; color: #638fcb; }
.calendar-scroll { box-sizing: border-box; border-radius: 14px; background-color: #ffffff; }
.calendar-scroll-dark { background-color: #1c1e22; }
.meta-value { font-size: 12px; }
.day-dark { background-color: #2d3433; }
</style>
