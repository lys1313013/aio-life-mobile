<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { useAppLayout } from '../../services/app-layout.ts'
const { appGridItem } = useAppLayout()

import { isRequired, missingRequired } from '../../services/form-required.ts';
import { computed, ref, watch } from 'vue';
import { onShow, onHide, onUnload } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import FormActions from '../../components/FormActions.uvue';
import PageState from '../../components/PageState.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { request } from '../../services/api.ts';
import { session, restoreSession } from '../../services/session.ts';
import { isDark, themeClass } from '../../services/theme.ts';
import {
  encryptSecret,
  decryptSecret,
  newSalt,
  randomPassword,
} from './services/vault-crypto.ts';
const rows = ref<any[]>([]),
  categories = ref<string[]>([]),
  query = ref(''),
  category = ref('全部'),
  loading = ref(false),
  saving = ref(false),
  editingId = ref(''),
  copyingId = ref(''),
  error = ref(''),
  formError = ref(''),
  ready = ref(false),
  editing = ref(false),
  unlocking = ref(false),
  master = ref(''),
  password = ref(''),
  confirm = ref(''),
  form = ref<any>({}),
  generator = ref(false);
const generation = ref<any>({
  length: '16',
  uppercase: true,
  lowercase: true,
  numbers: true,
  symbols: false,
  excludeAmbiguous: false,
});
const optionNames = {
  uppercase: '大写字母',
  lowercase: '小写字母',
  numbers: '数字',
  symbols: '符号',
  excludeAmbiguous: '排除易混淆字符',
};
const filtered = computed(() =>
  rows.value
    .filter(
      (x) =>
        (category.value === '全部' || x.category === category.value) &&
        (!query.value ||
          ((x.title || '') + ' ' + (x.website || ''))
            .toLowerCase()
            .includes(query.value.toLowerCase())),
    )
    .sort((a, b) => Number(b.favorite) - Number(a.favorite)),
);
let version = 0,
  active = true,
  lastActivity = 0,
  timer: any = null,
  pendingAction: any = null;
watch(
  () => session.token,
  () => {
    version++;
    lock();
    rows.value = [];
    categories.value = [];
    ready.value = false;
    error.value = '';
    formError.value = '';
  },
  { flush: 'sync' },
);
function touch() {
  lastActivity = Date.now();
}
function lock() {
  pendingAction = null;
  master.value = '';
  password.value = '';
  confirm.value = '';
  editing.value = false;
  unlocking.value = false;
  form.value = {};
  rows.value = rows.value.map(({ plainUsername, plainPassword, plainRemark, ...item }) => item);
}
onShow(() => {
  active = true;
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  load();
  timer = setInterval(() => {
    if (master.value && Date.now() - lastActivity > 30 * 60 * 1000) lock();
  }, 15000);
});
onHide(() => {
  active = false;
  version++;
  lock();
  clearInterval(timer);
});
onUnload(() => {
  lock();
  clearInterval(timer);
});
async function load() {
  const v = ++version,
    token = session.token;
  loading.value = true;
  error.value = '';
  try {
    const [list, cats]: any = await Promise.all([
      request('/password/list'),
      request('/password/categories'),
    ]);
    if (!Array.isArray(list) || !Array.isArray(cats)) throw new Error('密码库数据异常');
    if (!active || v !== version || token !== session.token) return;
    rows.value = list;
    categories.value = Array.from(
      new Set([...cats, '工作', '生活', '学习', '金融', '社交', '游戏', '其他']),
    );
    ready.value = true;
  } catch (e) {
    if (active && v === version) error.value = e.message;
  } finally {
    if (v === version) loading.value = false;
  }
}
async function plain(row, key) {
  return {
    ...row,
    plainUsername:
      row.username && /^[0-9a-f]{32,}$/i.test(row.username)
        ? await decryptSecret(row.username, key, row.salt)
        : row.username || '',
    plainPassword: await decryptSecret(row.password, key, row.salt),
    plainRemark: row.remark ? await decryptSecret(row.remark, key, row.salt) : '',
  };
}
function askUnlock(action = null) {
  pendingAction = typeof action === 'function' ? action : null;
  password.value = '';
  confirm.value = '';
  formError.value = '';
  unlocking.value = true;
}
async function unlock() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const v = version,
    token = session.token,
    key = password.value;
  try {
    if (missingRequired('vaultUnlock', { password: key }, 'password')) throw new Error('请输入主密码');
    if (!rows.value.length && (key.length < 6 || key !== confirm.value))
      throw new Error('主密码至少6位，且两次输入一致');
    if (rows.value.length)
      await decryptSecret(rows.value[0].password, key, rows.value[0].salt);
    // 卡片只展示元数据；解锁只验证一次，避免微信端逐字段派生全库密钥。
    if (!active || v !== version || token !== session.token) return;
    master.value = key;
    password.value = '';
    confirm.value = '';
    unlocking.value = false;
    touch();
    const action = pendingAction;
    pendingAction = null;
    if (action) {
      saving.value = false;
      await action();
    }
  } catch (e) {
    if (active && v === version)
      formError.value = rows.value.length ? '主密码不正确或记录无法解密' : e.message;
  } finally {
    saving.value = false;
  }
}
async function edit(row = null) {
  if (saving.value) return;
  if (!master.value) {
    askUnlock(() => edit(row));
    return;
  }
  touch();
  formError.value = '';
  editingId.value = row?.id || '';
  saving.value = true;
  const token = session.token,
    v = version,
    key = master.value;
  try {
    if (row) {
      const full: any = await request('/password/' + encodeURIComponent(row.id));
      const value = await plain(full, key);
      if (!active || v !== version || token !== session.token) return;
      form.value = {
        ...full,
        username: value.plainUsername,
        password: value.plainPassword,
        remark: value.plainRemark,
      };
    } else
      form.value = {
        title: '',
        website: '',
        category: '其他',
        username: '',
        password: '',
        remark: '',
        salt: '',
        favorite: false,
      };
    editing.value = true;
  } catch (e) {
    error.value = e.message;
  } finally {
    saving.value = false;
    editingId.value = '';
  }
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const token = session.token,
    v = version,
    key = master.value;
  try {
    if (!key) throw new Error('请先解锁');
    if (missingRequired('vault', form.value)) throw new Error('请填写标题和密码');
    const salt = form.value.salt || (await newSalt());
    const payload = {
      title: form.value.title.trim(),
      website: form.value.website,
      category: form.value.category,
      username: await encryptSecret(form.value.username, key, salt),
      password: await encryptSecret(form.value.password, key, salt),
      remark: form.value.remark ? await encryptSecret(form.value.remark, key, salt) : '',
      favorite: !!form.value.favorite,
      salt,
    };
    if (!active || token !== session.token || v !== version) return;
    await request(
      '/password' + (form.value.id ? '/' + encodeURIComponent(form.value.id) : ''),
      form.value.id ? 'PUT' : 'POST',
      payload,
    );
    if (!active || token !== session.token) return;
    editing.value = false;
    form.value = {};
    touch();
    await load();
  } catch (e) {
    if (active) formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(row) {
  if (!master.value) throw new Error('请先解锁密码库');
  const token = session.token,
    v = version;
  await request('/password/' + encodeURIComponent(row.id), 'DELETE');
  if (!active || token !== session.token || v !== version) return;
  rows.value = rows.value.filter((x) => x.id !== row.id);
  editing.value = false;
  form.value = {};
  touch();
}
async function copyPassword(id: string) {
  if (copyingId.value) return;
  if (!master.value) {
    // 解锁后重新读取当前记录，不能复制解锁前闭包里的空明文。
    askUnlock(() => copyPassword(id));
    return;
  }
  const row = rows.value.find((item) => item.id === id);
  if (!row) return;
  const key = master.value,
    token = session.token,
    v = version;
  copyingId.value = id;
  try {
    const value = await decryptSecret(row.password, key, row.salt);
    if (!active || v !== version || token !== session.token || key !== master.value) return;
    await new Promise<void>((resolve, reject) => uni.setClipboardData({
      data: value,
      success: () => resolve(),
      fail: () => reject(new Error('复制失败，请重试')),
    }));
    touch();
  } catch (e) {
    if (active && v === version && token === session.token && key === master.value)
      uni.showToast({ title: e.message || '该记录无法解密，请检查主密码', icon: 'none' });
  } finally {
    copyingId.value = '';
  }
}
async function generate() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const v = version,
    token = session.token;
  try {
    const value = await randomPassword(generation.value);
    if (active && v === version && token === session.token && editing.value)
      form.value.password = value;
  } catch (e) {
    if (active && v === version) formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
function back() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/life/index' }) });
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="密码管理" back @back="back">
      <text class="vault-page-title" :class="themeClass('vault-page-title')">密码管理</text>
      <MobileButton
        :label="master ? '锁定' : '解锁'"
        :icon="master ? 'ant-design:unlock-outlined' : 'ant-design:lock-outlined'"
        variant="ghost"
        :disabled="!ready"
        @click="master ? lock() : askUnlock()"
      />
    </PageHeader>
    <MobilePage :refreshing="loading" @refresh="load">
      <view class="ui-page-body">
        <view class="vault-tools ui-section">
          <view class="vault-search" :class="themeClass('vault-search')">
            <AppIcon name="ant-design:search-outlined" :size="18" />
            <FormField compact stretch hide-label label="搜索"><input class="vault-search-input" :class="themeClass('vault-search-input')"
              aria-label="搜索" placeholder="搜索标题或网站" :value="query"
              @input="query = $event.detail.value" /></FormField>
            <MobileButton v-if="query" label="清空搜索" icon="ant-design:close-outlined"
              variant="ghost" @click="query = ''" />
          </view>
          <view class="vault-filter">
            <FormField compact stretch hide-label label="分类" kind="selector"
              :options="['全部', ...categories]" v-model="category" />
          </view>
        </view>
        <PageState :loading="loading" :error="error" :has-content="ready" @retry="load">
          <template #loading>
            <view class="vault-grid ui-gap-section" role="status" aria-label="正在加载密码记录">
              <view v-for="n in 6" :key="n" :style="appGridItem(1, 'section', [[768, 2]], false)"
                class="vault-card ui-pad-card" :class="themeClass('vault-card')" aria-hidden="true">
                <view class="vault-card-header"><view class="vault-skeleton-title" :class="themeClass('vault-skeleton-shape')" /></view>
                <view class="vault-card-footer"><view class="vault-skeleton-label" :class="themeClass('vault-skeleton-shape')" /></view>
              </view>
            </view>
          </template>
          <view v-if="ready && !filtered.length" class="vault-empty ui-pad-card">
            <text class="vault-empty-text" :class="themeClass('vault-empty-text')">{{ query || category !== '全部' ? '没有匹配的密码' : '暂无密码记录' }}</text>
          </view>
          <view v-else class="vault-grid ui-gap-section">
            <view v-for="row in filtered" :key="row.id"
              :style="appGridItem(1, 'section', [[768, 2]], false)"
              class="vault-card ui-pad-card" :class="themeClass('vault-card')"
              role="button" tabindex="0" :aria-label="'编辑密码：' + row.title"
              :aria-busy="saving && editingId === row.id"
              @click="edit(row)" @keydown.enter.self="edit(row)" @keydown.space.self.prevent="edit(row)">
              <view class="vault-card-header">
                <text class="vault-title">{{ row.title }}</text>
                <view v-if="row.favorite" class="vault-favorite" role="img" aria-label="已收藏">
                  <AppIcon name="ant-design:star-filled" :size="20" :color="isDark ? '#f6c94c' : '#bd8700'" />
                </view>
              </view>
              <text v-if="row.website" class="vault-website" :class="themeClass('vault-website')">{{ row.website }}</text>
              <view class="vault-card-footer">
                <view v-if="row.category" class="vault-category-tag" :class="themeClass('vault-category-tag')">
                  <text class="vault-category" :class="themeClass('vault-category')">{{ row.category }}</text>
                </view>
                <view class="vault-copy" @click.stop @keydown.stop>
                  <MobileButton label="复制密码" icon="ant-design:copy-outlined" variant="ghost"
                    :loading="copyingId === row.id"
                    @click="copyPassword(row.id)" />
                </view>
              </view>
              <LoadingIndicator v-if="saving && editingId === row.id" floating label="正在打开密码记录" />
            </view>
          </view>
        </PageState>
      </view>
      <template #fixed><FloatingActionButton label="新增密码" :loading="saving && !editingId" :disabled="!ready" @click="edit()" /></template>
    </MobilePage
    ><AdaptiveModal
      v-if="unlocking"
      label="解锁密码库"
      :busy="saving"
      :max-width="440"
      @close="unlocking = false"
      ><FormField :required="isRequired('vaultUnlock', 'password')" label="主密码" kind="password" :disabled="saving" v-model="password" /><FormField :required="isRequired('vaultUnlock', 'confirm', { initialized: rows.length > 0 })"
        v-if="!rows.length"
        label="确认主密码"
        kind="password"
        :disabled="saving"
        v-model="confirm" /><text v-if="formError" class="error-text" role="alert">{{
        formError
      }}</text
      ><FormActions><MobileButton label="取消" variant="quiet" :disabled="saving" @click="unlocking = false" /><MobileButton label="解锁" :loading="saving" @click="unlock" /></FormActions></AdaptiveModal
    ><AdaptiveModal
      v-if="editing"
      label="密码记录"
      :busy="saving"
      :max-width="520"
      @close="editing = false"
      ><FormField :required="isRequired('vault', 'title')" label="标题" v-model="form.title" /><FormField
        label="网站"
        v-model="form.website" /><FormField label="分类" v-model="form.category" /><FormField
        label="账号"
        v-model="form.username" /><FormField :required="isRequired('vault', 'password')"
        label="密码"
        kind="password"
        v-model="form.password" /><MobileButton
        label="密码生成器"
        variant="quiet"
        @click="generator = !generator" /><view v-if="generator"
        ><FormField label="长度" input-type="number" v-model="generation.length" /><view
          v-for="(label, key) in optionNames"
          :key="key"
          class="vault-row ui-row"
          ><text class="vault-value">{{ label }}</text
          ><MobileSwitch
            :checked="generation[key]"
            :aria-label="label"
            @change="generation[key] = $event.detail.value" /></view
        ><MobileButton label="生成密码" :loading="saving" @click="generate" /></view
      ><FormField label="备注" kind="textarea" v-model="form.remark" /><view class="vault-row ui-row"
        ><text class="vault-value">收藏</text
        ><MobileSwitch
          :checked="form.favorite"
          aria-label="收藏密码"
          @change="form.favorite = $event.detail.value" /></view
      ><text v-if="formError" class="error-text" role="alert">{{ formError }}</text
      ><FormActions><template #secondary><ConfirmAction v-if="form.id" label="删除密码" :message="'删除' + form.title + '？'" :action="() => remove(form)" /></template><MobileButton label="取消" variant="quiet" :disabled="saving" @click="editing = false" /><MobileButton label="保存" :loading="saving" @click="save" /></FormActions></AdaptiveModal
  ></view>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/text-colors' as *;
.vault-page-title {
  flex: 1;
  @include type-style('title');
  color: #242428;
}
.vault-page-title-dark { color: #eeeeef; }
.vault-tools {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
}
.vault-search {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;
  padding-left: $space-card;
  gap: $space-inline;
  border-radius: 10px;
  background-color: #fff;
}
.vault-search-dark { background-color: #1c1e22; }
.vault-search-input {
  flex: 1;
  min-width: 0;
  height: $space-controlMin;
  @include type-style('body');
  color: #27272a;
}
.vault-search-input-dark { color: #eeeeef; }
.vault-filter {
  // 分类选择器保留两字分类与下拉箭头的空间。
  width: 100px;
  flex-shrink: 0;
}
.vault-grid {
  /* #ifndef APP */
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
  /* #endif */
  /* #ifdef APP */
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  /* #endif */
}
@media (min-width: 768px) {
  .vault-grid {
    @include grid-columns(2);
  }
}
.vault-card {
  position: relative;
  gap: $space-detail;
  min-width: 0;
  margin-bottom: 0;
  background-color: #fff;
  color: #27272a;
  border-radius: 16px;
}
.vault-card-dark { background-color: #1c1e22; color: #eeeeef; }
.vault-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: type-line('brand');
  gap: $space-inline;
}
.vault-title { flex: 1; min-width: 0; @include type-style('brand'); overflow-wrap: anywhere; }
.vault-website { @include type-style('caption'); color: $text-secondary-light; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vault-website-dark { color: $text-secondary-dark; }
.vault-favorite { width: $space-controlMin; flex-shrink: 0; align-items: center; justify-content: center; }
.vault-card-footer { display: flex; flex-direction: row; align-items: center; min-height: $space-controlMin; gap: $space-inline; }
.vault-category-tag { padding: $space-micro $space-inline; border-radius: 6px; background-color: #eef0f4; }
.vault-category-tag-dark { background-color: #2b2e35; }
.vault-category {
  @include type-style('label');
  color: $text-secondary-light;
}
.vault-category-dark { color: $text-secondary-dark; }
.vault-copy { margin-left: auto; flex-shrink: 0; }
.vault-skeleton-title { height: type-line('brand'); width: 50%; border-radius: 6px; background-color: #e8ecf1; }
.vault-skeleton-label { height: type-line('brand'); width: $space-controlMin; border-radius: 6px; background-color: #e8ecf1; }
.vault-skeleton-shape-dark { background-color: #30343c; }
.vault-empty { align-items: center; }
.vault-empty-text { @include type-style('body'); color: $text-secondary-light; text-align: center; }
.vault-empty-text-dark { color: $text-secondary-dark; }
.vault-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  min-height: $space-controlMin;
}
.vault-value {
  flex: 1;
  min-width: 0;
  @include type-style('body');
  word-break: break-all;
}

</style>
