<script setup lang="ts">
import CategoryTabs from "../../components/CategoryTabs.uvue";
import { readPageTotal, mergePageItems, hasMorePageItems } from '../../services/pagination.ts';
import { fetchDictionary } from '../../services/dictionary.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { useAppLayout, appTextColor } from '../../services/app-layout.ts'
const { appGridItem } = useAppLayout()

import { buttonLabelClasses } from '../../services/button-label.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import iconCatalog from '../../services/icons/catalog.ts';
import { computed, onUnmounted, ref, watch } from 'vue';
import CategoryPager from '../../components/CategoryPager.uvue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import { authFileUrl } from '../../services/attachments.ts';
import { session } from '../../services/session.ts';
import { isDark } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import { fetchDevicePage } from '../../services/devices.ts';
import DeviceRecordEditor from '../../components/record-editors/DeviceRecordEditor.uvue';
const rows = ref<any[]>([]),
  types = ref<any[]>([]),
  statuses = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  typeFilter = ref(''),
  keyword = ref('');
const photos = ref<Record<string, string>>({}),
  loadedPhotoUrls = ref<Record<string, string>>({}),
  photoBusy = ref<Record<string, boolean>>({}),
  photoErrors = ref<Record<string, string>>({});
const form = ref<any>(null);
const deviceTypeVisuals = computed(() => Object.fromEntries(types.value.map((type) => {
  const icon = type.icon?.trim();
  return [type.id, {
    icon: iconCatalog.icons[icon] ? icon : 'solar:devices-line-duotone',
    color: /^#[\da-f]{6}$/i.test(type.color || '') ? type.color : undefined,
  }];
})));
function deviceVisual(type: string) {
  return deviceTypeVisuals.value[type] || { icon: 'solar:devices-line-duotone' };
}
// 分类以完整设备列表为准，搜索和切换分类不会让其他有数据的分类消失。
const availableTypes = computed(() => {
  const used = new Set(rows.value.map((item) => item.type));
  return types.value.filter((type) => used.has(type.id));
});
const typeTabs = computed(() => [
  { id: '', label: '全部' },
  ...availableTypes.value.map((type) => ({ id: type.id, label: type.dictLabel || type.label })),
]);
watch(availableTypes, (options) => {
  if (typeFilter.value && !options.some((type) => type.id === typeFilter.value)) typeFilter.value = '';
});
const activePage = computed(() => Math.max(0, typeTabs.value.findIndex(type => type.id === typeFilter.value)));
const visibleTab = ref('');
const pager = ref(null);
function pageChanged(index) {
  const type = typeTabs.value[index];
  if (!type || form.value) return;
  typeFilter.value = type.id;
  visibleTab.value = 'device-type-' + index;
}
function selectType(id: string) {
  if (id === typeFilter.value || form.value) return;
  typeFilter.value = id;
}
let requestedEdit = '';
let requestedCreate = false;
onLoad((options) => {
  requestedEdit = String(options?.id || '');
  requestedCreate = options?.create === '1';
});
const scope = createRecordScope((clear) => {
  form.value = null;
  photoBusy.value = {};
  if (clear) {
    requestedEdit = '';
    requestedCreate = false;
    photos.value = {};
    loadedPhotoUrls.value = {};
    photoErrors.value = {};
    rows.value = [];
    types.value = [];
    statuses.value = [];
    typeFilter.value = '';
  }
});
// 每一页都有自己的统计和列表，拖动过程中两页同时存在，不在松手后替换内容。
const devicePages = computed(() => typeTabs.value.map(type => {
  const items = rows.value.filter(item =>
    (!type.id || item.type === type.id) &&
    (!keyword.value || (item.name + ' ' + item.spec + ' ' + item.remark).includes(keyword.value)),
  );
  return {
    id: type.id,
    items,
    amount: items.reduce((sum, item) => sum + Number(item.purchasePrice || 0), 0).toFixed(2),
    dailyCost: items.reduce((sum, item) => sum + Number(item.purchasePrice || 0) / usageDays(item), 0).toFixed(2),
    statusCounts: ['1', '4', '2', '3'].map(status => ({
      status, count: items.filter(item => String(item.status) === status).length,
    })),
  };
}));
let alive = true,
  generation = 0;
onUnmounted(() => {
  alive = false;
  generation++;
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['device', 'userDictData', 'userDictType'] })
onShow(() => {
  refreshOnShow();
  rows.value.forEach(item => { if (item.fileId && !photos.value[item.id] && !photoBusy.value[item.id] && !photoErrors.value[item.id]) void loadPhoto(item); });
});
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    const [typeDict, statusDict] = await scope.wait(
      Promise.all([
        fetchDictionary('device_type', true),
        fetchDictionary('device_status'),
      ]),
    );
    if (!alive || current !== generation) return;
    let data = [];
    let page = 1;
    while (true) {
      const response = await scope.wait(fetchDevicePage(page++));
      if (!alive || current !== generation) return;
      const total = readPageTotal(response.total);
      data = mergePageItems(data, response.items);
      if (!hasMorePageItems(data.length, total, response.items.length === 0)) break;
    }
    if (alive && current === generation) {
      rows.value = data;
      types.value = typeDict.dictDetailList || [];
      statuses.value = statusDict.dictDetailList || [];
      data.forEach((item) => {
        if (item.fileId) loadPhoto(item);
      });
      if (requestedEdit) {
        const selected = data.find((item) => item.id === requestedEdit);
        if (!selected) throw new Error('记录不存在或已删除');
        loading.value = false;
        open(selected);
        requestedEdit = '';
      } else if (requestedCreate) {
        loading.value = false;
        open();
        requestedCreate = false;
      }
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
async function loadPhoto(item) {
  const current = generation,
    token = session.token;
  photoBusy.value = { ...photoBusy.value, [item.id]: true };
  photoErrors.value = { ...photoErrors.value, [item.id]: '' };
  try {
    const url = await scope.wait(authFileUrl(item.fileId));
    if (alive && current === generation && token === session.token)
      photos.value = { ...photos.value, [item.id]: url };
  } catch (e) {
    if (
      e.name !== 'PageInactiveError' &&
      alive &&
      current === generation &&
      token === session.token
    )
      photoErrors.value = { ...photoErrors.value, [item.id]: e.message };
  } finally {
    if (alive && current === generation && token === session.token)
      photoBusy.value = { ...photoBusy.value, [item.id]: false };
  }
}
function photoFailed(id: string) {
  photos.value = { ...photos.value, [id]: '' };
  loadedPhotoUrls.value = { ...loadedPhotoUrls.value, [id]: '' };
  photoErrors.value = { ...photoErrors.value, [id]: '图片加载失败' };
}
function usageDays(item) {
  if (!item.purchaseDate) return 1;
  const difference =
    (new Date(item.endDate || new Date()).getTime() -
      new Date(item.purchaseDate).getTime()) /
    86400000;
  return Math.max(1, Math.floor(difference));
}
function statusName(value) {
  return (
    statuses.value.find((item) => String(item.value) === String(value))?.label ||
    { '1': '使用中', '2': '已损坏', '3': '已送人', '4': '吃灰中' }[value] ||
    value
  );
}
const editorOrigin = ref('50% 50%');
function open(item = null, event: any = null) {
  if (pager.value?.ignoreClick()) return;
  if (loading.value) return;
  const info = uni.getWindowInfo();
  const point = event?.touches?.[0] || event?.changedTouches?.[0] || event?.detail || event;
  const x = point?.clientX ?? point?.x;
  const y = point?.clientY ?? point?.y;
  editorOrigin.value = typeof x === 'number' && typeof y === 'number'
    ? Math.max(0, Math.min(100, x / info.windowWidth * 100)) + '% ' + Math.max(0, Math.min(100, y / info.windowHeight * 100)) + '%'
    : '50% 50%';
  form.value = item
    ? {
        ...item,
        files: item.fileId ? [{ id: item.fileId, fileName: item.name + ' 图片' }] : [],
      }
    : {
        name: '',
        spec: '',
        type:
          typeFilter.value ||
          types.value[0]?.id ||
          '',
        status: '1',
        purchaseDate: '',
        endDate: '',
        purchasePrice: '',
        purchasePlace: '',
        remark: '',
        fileId: '',
        files: [],
      };
}
function deviceSaved(payload) {
  if (payload.id) {
    const index = rows.value.findIndex((item) => item.id === payload.id);
    if (index >= 0) rows.value[index] = payload;
    else void load();
    if (payload.fileId) void loadPhoto(payload);
    else photos.value = { ...photos.value, [payload.id]: '' };
  } else void load();
  form.value = null;
}
function deviceDeleted(id: string) {
  rows.value = rows.value.filter(item => item.id !== id);
  form.value = null;
}
</script>
<template>
  <MobilePage :scroll-locked="true" :refresh-disabled="true"
    ><view class="goods-page ui-page-body" :class="{ 'goods-page-dark': isDark }"
      ><PageHeader title="设备" :back="true" @back="uni.navigateBack()" /><view
        class="ui-toolbar"
        ><FormField compact stretch hide-label label="搜索设备" placeholder="搜索设备、配置…" v-model="keyword" /></view
      ><CategoryTabs v-if="availableTypes.length" class="device-type-scroll ui-section" :items="typeTabs" :current="activePage" variant="underline" label="设备类型筛选" id-prefix="device-type" item-class="device-type-tab" :disabled="!!form" @change="selectType(typeTabs[$event].id)" />
      <CategoryPager ref="pager" class="device-pager" :items="devicePages" :current="activePage" :disabled="!!form" :refreshing="refreshing" tabs-selector=".device-type-scroll" @change="pageChanged" @refresh="load(true)"><template #default="{ item: devicePage, active }"><view class="device-page-content" :class="{ 'device-page-active': active }">
      <view class="metrics ui-row ui-section"
        ><MetricCard :style="appGridItem(2, 'section', [[700, 3]], true)" :loading="loading && !rows.length"
          class="metric-wide"
          label="总资产"
          :value="devicePage.amount"
          unit="元" /><MetricCard :style="appGridItem(2, 'section', [[700, 3]], false)" :loading="loading && !rows.length" label="资产数量" :value="devicePage.items.length" /><MetricCard :style="appGridItem(2, 'section', [[700, 3]], false)" :loading="loading && !rows.length" label="每日成本" :value="devicePage.dailyCost" unit="元" /></view
      ><view class="status-summary ui-row ui-section"
        ><text
          v-for="entry in devicePage.statusCounts"
          :key="entry.status"
          class="status-tag"
          :class="'status-' + entry.status"
          >{{ statusName(entry.status) }} {{ entry.count }}</text
        ></view
      ><PageState skeleton="list"
        :loading="loading"
        :error="error"
        :empty="!devicePage.items.length"
        @retry="load()"
        >
<template #loading><view class="goods-grid ui-gap-md" ><view v-for="n in 6" :key="n" class="goods-card ui-pad-card ui-gap-sm" :class="{ 'goods-card-dark': isDark }"><view class="goods-media" :class="{ 'goods-media-dark': isDark }"><view class="goods-image-skeleton"><ContentSkeleton variant="cover" label="正在加载设备图片" /></view></view><ContentSkeleton variant="tile" /></view></view></template>
<view class="goods-grid ui-gap-md"
          ><view
            v-for="item in devicePage.items"
            :key="item.id"
            class="goods-card ui-pad-card ui-gap-sm"
            :class="{ 'goods-card-dark': isDark }"
            ><view class="goods-media" :class="{ 'goods-media-dark': isDark, 'goods-media-loaded': photos[item.id] && loadedPhotoUrls[item.id] === photos[item.id] }"
              ><image
                v-if="photos[item.id]"
                class="goods-photo"
                :src="photos[item.id]"
                mode="aspectFit"
                :aria-label="item.name + '图片'"
                @load="loadedPhotoUrls[item.id] = photos[item.id]"
                @error="photoFailed(item.id)"
                @click="open(item, $event)"
              /><view
                v-if="item.fileId && !photoErrors[item.id] && (!photos[item.id] || loadedPhotoUrls[item.id] !== photos[item.id])"
                class="goods-image-skeleton"
                ><ContentSkeleton variant="cover" label="正在加载设备图片" /></view
              ><view v-else-if="!photos[item.id]" class="goods-placeholder" :class="{ 'secondary-text-dark': isDark }"
                ><AppIcon
                  :name="deviceVisual(item.type).icon"
                  :color="deviceVisual(item.type).color"
                  :size="64"
                /><MobileButton
                  v-if="photoErrors[item.id]"
                  label="重试设备图片"
                  variant="quiet"
                  @click="loadPhoto(item)" /></view
              ></view
            ><button :style="appTextColor()" role="button" class="goods-title-button ui-type-body" aria-label="编辑设备" @click="open(item, $event)"><text class="goods-title">{{ item.name }}</text></button
            ><text v-if="item.spec" class="goods-content" :class="{ 'secondary-text-dark': isDark }">{{ item.spec }}</text
            ><text v-if="item.purchasePlace" class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">{{ item.purchasePlace }}</text
            ><text v-if="item.remark" class="goods-content" :class="{ 'secondary-text-dark': isDark }">{{ item.remark }}</text
            ><view class="goods-cost-summary"><text class="goods-price">¥ {{ item.purchasePrice || 0 }}</text
            ><text class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">{{ item.purchaseDate || '—' }} · {{ usageDays(item) }} 天</text
            ><view class="goods-footer"><text class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">日均 ¥ {{ (Number(item.purchasePrice || 0) / usageDays(item)).toFixed(2) }}</text
            ><text class="goods-badge status-tag" :class="'status-' + item.status">{{ statusName(item.status) }}</text></view></view
            ></view
          ></view
        ></PageState
      >
          </view></template></CategoryPager>
      <DeviceRecordEditor v-if="form" :record="form" :editor-options="{ types, statuses }" :opening-origin="editorOrigin" @close="form = null" @saved="deviceSaved" @deleted="deviceDeleted" /> </view
  >
    <template #fixed>
      <FloatingActionButton v-if="!form" label="新增设备" :disabled="loading || !!error" @click="open(null, $event)" />
    </template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use "./goods-media";
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.goods-page {
  color: #27272a;

}
.goods-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.device-type-scroll {
  width: 100%;
  min-width: 0;
  white-space: nowrap;
}

.metrics {

@include grid-layout;

@include grid-columns(2);

}
.metric-wide {
/* #ifndef APP */
grid-column: 1 / -1;
/* #endif */
 }
.goods-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.goods-card {
  position: relative;
  width: calc((100% - #{$space-section}) / 2);
  min-width: 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 16px;
}
.goods-card-dark {
  background-color: #1c1e22;
}
.goods-title {
  flex: 1;
  @include type-style('body-strong');

}
.goods-content {
  @include type-style('caption');

  color: $text-secondary-light;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-secondary {
  color: $text-secondary-light;
  @include type-style('badge');

  overflow-wrap: anywhere;
}
.goods-media,
.goods-photo,
.goods-placeholder {
  width: 100%;
  height: 150px;
}
.goods-placeholder {
  align-items: center;
  justify-content: center;
  color: $text-secondary-light;
}
.goods-badge {
  flex-shrink: 0;
  margin-left: auto;
}
.goods-footer {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: $space-detail;
}
.status-summary {
  flex-wrap: wrap;
}
.status-tag {
  padding: $space-detail $space-inline;
  border-radius: 12px;
  @include type-style('caption');
}
.status-1 {
  background-color: rgba(56, 147, 103, 0.14);
  color: #389367;
}
.status-4 {
  background-color: rgba(170, 128, 26, 0.14);
  color: #aa801a;
}
.status-2 {
  background-color: rgba(189, 80, 80, 0.14);
  color: #bd5050;
}
.status-3 {
  background-color: rgba(104, 115, 133, 0.14);
  color: #687385;
}
@media (min-width: 700px) {
  .goods-card {
    width: calc((100% - #{$space-section} * 2) / 3);
  }
}
@media (min-width: 1000px) {
  .goods-card {
    width: calc((100% - #{$space-section} * 3) / 4);
  }
}
.goods-error {
  color: #e05252;
}
@media (min-width: 700px) {
  .metric-wide {
/* #ifndef APP */
grid-column: auto;
/* #endif */
 }
  .metrics {

@include grid-columns(3);

  }
}
.goods-title-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;

/* #ifndef APP */
color: inherit;
/* #endif */

  text-align: left;
  line-height: type-line('body');
}
.goods-cost-summary { margin-top: auto; gap: $space-inline; }
.goods-price { @include type-style('body-strong');  }
.goods-title-button { @include borderless-button; }

.secondary-text-dark { color: $text-secondary-dark; }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }

</style>
