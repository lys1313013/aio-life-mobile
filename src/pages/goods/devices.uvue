<script setup lang="ts">
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onUnmounted, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import PageState from '../../components/PageState.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import AttachmentField from '../../components/AttachmentField.uvue';
import { authFileUrl } from '../../services/attachments.ts';
import { session } from '../../services/session.ts';
import { isDark } from '../../services/theme.ts';
import { createRecordScope } from '../../services/records/page-scope.ts';
import {
  fetchDevicePage,
  fetchDictionary,
  saveDevice,
  deleteDevice,
} from '../../services/records/goods.ts';
const rows = ref<any[]>([]),
  types = ref<any[]>([]),
  statuses = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(''),
  typeFilter = ref('全部类型'),
  keyword = ref('');
const photos = ref<Record<string, string>>({}),
  photoBusy = ref<Record<string, boolean>>({}),
  photoErrors = ref<Record<string, string>>({});
const form = ref<any>(null),
  saving = ref(false),
  deleting = ref(false),
  formError = ref(''),
  attachmentBusy = ref(false),
  created = ref(false);
const scope = createRecordScope((clear) => {
  form.value = null;
  photos.value = {};
  photoBusy.value = {};
  photoErrors.value = {};
  if (clear) {
    rows.value = [];
    types.value = [];
    statuses.value = [];
  }
});
const filtered = computed(() =>
  rows.value.filter(
    (item) =>
      !keyword.value ||
      (item.name + ' ' + item.spec + ' ' + item.remark).includes(keyword.value),
  ),
);
const amount = computed(() =>
  filtered.value
    .reduce((sum, item) => sum + Number(item.purchasePrice || 0), 0)
    .toFixed(2),
);
const dailyCost = computed(() =>
  filtered.value
    .reduce((sum, item) => sum + Number(item.purchasePrice || 0) / usageDays(item), 0)
    .toFixed(2),
);
let alive = true,
  generation = 0;
onUnmounted(() => {
  alive = false;
  generation++;
});
onShow(() => load());
async function load(refresh = false) {
  const current = ++generation;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    const [typeDict, statusDict] = await scope.wait(
      Promise.all([
        fetchDictionary('device_type', true),
        fetchDictionary('device_status'),
      ]),
    );
    const typeId =
      (typeDict.dictDetailList || []).find(
        (item) => (item.dictLabel || item.label) === typeFilter.value,
      )?.id || '';
    const data = [];
    let page = 1;
    while (true) {
      const response = await scope.wait(fetchDevicePage(page++, typeId));
      data.push(...response.items);
      if (data.length >= response.total || response.items.length < 100) break;
    }
    if (alive && current === generation) {
      rows.value = data;
      types.value = typeDict.dictDetailList || [];
      statuses.value = statusDict.dictDetailList || [];
      data.forEach((item) => {
        if (item.fileId) loadPhoto(item);
      });
    }
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    if (current === generation) error.value = e.message;
  } finally {
    if (current === generation) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
async function loadPhoto(item) {
  const current = generation,
    token = session.token;
  photoBusy.value = { ...photoBusy.value, [item.id]: true };
  photoErrors.value = { ...photoErrors.value, [item.id]: '' };
  try {
    const url = await scope.wait(authFileUrl(item.fileId));
    if (alive && current === generation && token === session.token)
      photos.value = { ...photos.value, [item.id]: url };
  } catch (e) {
    if (
      e.name !== 'PageInactiveError' &&
      alive &&
      current === generation &&
      token === session.token
    )
      photoErrors.value = { ...photoErrors.value, [item.id]: e.message };
  } finally {
    if (alive && current === generation && token === session.token)
      photoBusy.value = { ...photoBusy.value, [item.id]: false };
  }
}
const statusCounts = computed(() =>
  ['1', '4', '2', '3'].map((status) => ({
    status,
    count: filtered.value.filter((item) => String(item.status) === status).length,
  })),
);
function usageDays(item) {
  if (!item.purchaseDate) return 1;
  const difference =
    (new Date(item.endDate || new Date()).getTime() -
      new Date(item.purchaseDate).getTime()) /
    86400000;
  return Math.max(1, Math.floor(difference));
}
function statusName(value) {
  return (
    statuses.value.find((item) => String(item.value) === String(value))?.label ||
    { '1': '使用中', '2': '已损坏', '3': '已送人', '4': '吃灰中' }[value] ||
    value
  );
}
function open(item = null) {
  created.value = false;
  formError.value = '';
  form.value = item
    ? {
        ...item,
        files: item.fileId ? [{ id: item.fileId, fileName: item.name + ' 图片' }] : [],
      }
    : {
        name: '',
        spec: '',
        type:
          types.value.find((t) => (t.dictLabel || t.label) === typeFilter.value)?.id ||
          types.value[0]?.id ||
          '',
        status: '1',
        purchaseDate: '',
        endDate: '',
        purchasePrice: '',
        purchasePlace: '',
        remark: '',
        fileId: '',
        files: [],
      };
}
async function save() {
  if (saving.value || deleting.value || attachmentBusy.value) return;
  if (!form.value.name.trim()) {
    formError.value = '请输入设备名称';
    return;
  }
  const price = form.value.purchasePrice === '' ? null : Number(form.value.purchasePrice);
  if (price != null && (!Number.isFinite(price) || price < 0)) {
    formError.value = '购买价格必须为非负数字';
    return;
  }
  if (
    form.value.endDate &&
    form.value.purchaseDate &&
    form.value.endDate < form.value.purchaseDate
  ) {
    formError.value = '结束日期不能早于购买日期';
    return;
  }
  const payload = {
    ...form.value,
    name: form.value.name.trim(),
    purchasePrice: price,
    purchaseDate: form.value.purchaseDate || null,
    endDate: form.value.endDate || null,
    fileId: form.value.files.at(-1)?.id || '',
  };
  delete payload.files;
  saving.value = true;
  formError.value = '';
  try {
    if (!created.value) {
      await scope.wait(saveDevice(payload));
      if (!payload.id) created.value = true;
    }
    if (payload.id) {
      const index = rows.value.findIndex((item) => item.id === payload.id);
      if (index >= 0) rows.value[index] = payload;
    } else {
      const data = [];
      let page = 1;
      while (true) {
        const response = await scope.wait(fetchDevicePage(page++, payload.type));
        data.push(...response.items);
        if (data.length >= response.total || response.items.length < 100) break;
      }
      rows.value = data;
      typeFilter.value =
        types.value.find((t) => t.id === payload.type)?.dictLabel || '全部类型';
    }
    form.value = null;
  } catch (e) {
    if (e.name === 'PageInactiveError') return;
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(item) {
  if (saving.value || deleting.value || attachmentBusy.value) return;
  deleting.value = true;
  try {
    await scope.wait(deleteDevice(item.id));
    rows.value = rows.value.filter((r) => r.id !== item.id);
    if (form.value?.id === item.id) form.value = null;
  } finally {
    deleting.value = false;
  }
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="load(true)"
    ><view class="goods-page ui-page-body" :class="{ 'goods-page-dark': isDark }"
      ><PageHeader title="设备" :back="true" @back="uni.navigateBack()" /><view
        class="ui-toolbar"
        ><FormField compact stretch hide-label label="搜索设备" placeholder="搜索设备、配置…" v-model="keyword" /><MobileButton
          label="新增设备"
          icon="ant-design:plus-outlined"
          :disabled="loading || !!error"
          @click="open()" /></view
      ><scroll-view
        direction="horizontal"
        :scroll-x="true"
        :show-scrollbar="false"
        class="device-type-scroll ui-section"
      ><view class="device-type-tabs" aria-label="设备类型筛选"
        ><button
          v-for="label in ['全部类型', ...types.map((t) => t.dictLabel || t.label)]"
          :key="label"
          role="button"
          class="device-type-tab"
          :class="{ 'device-type-tab-active': typeFilter === label, 'device-type-tab-active-dark': typeFilter === label && isDark }"
          :aria-pressed="typeFilter === label"
          @click="typeFilter !== label && (typeFilter = label, load())"
        >{{ label === '全部类型' ? '全部' : label }}</button
      ></view></scroll-view><view class="metrics ui-row ui-section"
        ><MetricCard :loading="loading && !rows.length"
          class="metric-wide"
          label="总资产"
          :value="amount"
          unit="元" /><MetricCard :loading="loading && !rows.length" label="资产数量" :value="filtered.length" /><MetricCard :loading="loading && !rows.length" label="每日成本" :value="dailyCost" unit="元" /></view
      ><view class="status-summary ui-row ui-section"
        ><text
          v-for="entry in statusCounts"
          :key="entry.status"
          class="status-tag"
          :class="'status-' + entry.status"
          >{{ statusName(entry.status) }} {{ entry.count }}</text
        ></view
      ><PageState skeleton="list"
        :loading="loading"
        :error="error"
        :empty="!filtered.length"
        @retry="load()"
        >
<template #loading><view class="goods-grid ui-gap-md" ><view v-for="n in 6" :key="n" class="goods-card ui-pad-card ui-gap-sm" :class="{ 'goods-card-dark': isDark }"><view class="goods-media goods-placeholder"><ContentSkeleton variant="cover" /></view><ContentSkeleton variant="tile" /></view></view></template>
<view class="goods-grid ui-gap-md"
          ><view
            v-for="item in filtered"
            :key="item.id"
            class="goods-card ui-pad-card ui-gap-sm"
            :class="{ 'goods-card-dark': isDark }"
            ><view class="goods-media"
              ><image
                v-if="photos[item.id]"
                class="goods-photo"
                :src="photos[item.id]"
                mode="aspectFit"
                :aria-label="item.name + '图片'"
                @click="open(item)"
              /><view v-else class="goods-placeholder" :class="{ 'secondary-text-dark': isDark }"
                ><text class="ui-type-body">{{ photoBusy[item.id] ? '加载图片…' : '设备' }}</text
                ><MobileButton
                  v-if="photoErrors[item.id]"
                  label="重试设备图片"
                  variant="quiet"
                  @click="loadPhoto(item)" /></view
              ><text class="goods-badge status-tag" :class="'status-' + item.status">{{
                statusName(item.status)
              }}</text></view
            ><button role="button" class="goods-title-button ui-type-body" aria-label="编辑设备" @click="open(item)"><text class="goods-title">{{ item.name }}</text></button
            ><text v-if="item.spec" class="goods-content" :class="{ 'secondary-text-dark': isDark }">{{ item.spec }}</text
            ><text class="goods-price">¥ {{ item.purchasePrice || 0 }}</text
            ><text class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">{{ item.purchaseDate || '—' }} · {{ usageDays(item) }} 天</text
            ><text class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">日均 ¥ {{ (Number(item.purchasePrice || 0) / usageDays(item)).toFixed(2) }}</text
            ><text v-if="item.purchasePlace" class="goods-secondary" :class="{ 'secondary-text-dark': isDark }">{{ item.purchasePlace }}</text
            ><text v-if="item.remark" class="goods-content" :class="{ 'secondary-text-dark': isDark }">{{ item.remark }}</text
            ></view
          ></view
        ></PageState
      >
      <AdaptiveModal
        v-if="form"
        label="编辑设备"
        :max-width="520"
        :show-close="false"
        :busy="saving || deleting || attachmentBusy"
        @close="form = null"
      >
        <view class="device-editor-header ui-row ui-section">
          <text class="device-editor-title">{{ form.id ? '编辑设备' : '新增设备' }}</text>
          <MobileButton label="关闭" icon="ant-design:close-outlined" variant="quiet" compact
            :disabled="saving || deleting || attachmentBusy" @click="form = null" />
        </view>
        <FormField appearance="soft" label="名称" placeholder="设备名称" v-model="form.name" />
        <FormField appearance="soft" label="配置" placeholder="型号、容量等" v-model="form.spec" />
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="类型" kind="selector"
            :model-value="types.find((t) => t.id === form.type)?.dictLabel || types.find((t) => t.id === form.type)?.label || ''"
            :options="types.map((t) => t.dictLabel || t.label)"
            @update:model-value="form.type = types.find((t) => (t.dictLabel || t.label) === $event)?.id || ''" />
          <FormField appearance="soft" compact stretch label="状态" kind="selector"
            :model-value="statusName(form.status)"
            :options="statuses.map((t) => t.label)"
            @update:model-value="form.status = String(statuses.find((t) => t.label === $event)?.value || '1')" />
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="购买价格" placeholder="¥ 0.00" input-type="digit" v-model="form.purchasePrice" />
          <FormField appearance="soft" compact stretch label="购买平台" placeholder="选填" v-model="form.purchasePlace" />
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="购买日期" kind="date" v-model="form.purchaseDate" />
          <FormField appearance="soft" compact stretch label="退役日期" kind="date" placeholder="未退役" v-model="form.endDate" />
        </view>
        <FormField appearance="soft" label="备注" kind="textarea" placeholder="选填" v-model="form.remark" />
        <AttachmentField
          :files="form.files"
          upload-path="/file/upload"
          :form-data="{ bizType: 'device' }"
          :disabled="saving || deleting"
          @update:files="form.files = $event.slice(-1)"
          @busy-change="attachmentBusy = $event" /><text
          v-if="formError"
          class="goods-error ui-section ui-type-body"
          >{{ formError }}</text
        ><view class="toolbar ui-row"
          ><ConfirmAction
            v-if="form.id"
            label="删除设备"
            :message="'确定删除设备「' + form.name + '」？'"
            :action="() => remove(form)"
          ><template #default="{ open: confirm, busy }"><MobileButton
            label="删除设备"
            icon="ant-design:delete-outlined"
            variant="quiet"
            :loading="busy"
            :disabled="saving || attachmentBusy"
            @click="confirm"
          /></template></ConfirmAction><view class="action-spacer" /><MobileButton
            label="取消"
            variant="quiet"
            :disabled="saving || deleting || attachmentBusy"
            @click="form = null"><text class="device-editor-action">取消</text></MobileButton><MobileButton
            :label="created ? '重新读取' : '保存'"
            :loading="saving"
            :disabled="deleting || attachmentBusy"
            @click="save"><text class="device-editor-action">{{ created ? '重新读取' : '保存' }}</text></MobileButton></view
      ></AdaptiveModal> </view
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.goods-page {
  color: #27272a;
}
.goods-page-dark {
  color: #eeeeef;
}
.toolbar {
  flex-direction: row;
  align-items: center;
}
.action-spacer { flex: 1; }
.device-editor-header { align-items: center; justify-content: space-between; }
.device-editor-title { @include type-style('title');   }
.device-editor-action { @include type-style('body');   }
.device-type-scroll {
  width: 100%;
  white-space: nowrap;
}
.device-type-tabs {
  display: flex;
  // 内容按全部标签撑开，避免 view 将超出视口的标签裁掉。
  width: max-content;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: $space-inline;
}
.device-type-tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: $space-controlMin;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0 $space-detail;
  border: 0;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  background: transparent;
  color: inherit;
  @include type-style('body');

  white-space: nowrap;
}
.device-type-tab-active {
  color: #2563eb;
  border-bottom-color: #2563eb;
}
.device-type-tab-active-dark {
  color: #6c9cff;
  border-bottom-color: #6c9cff;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.metric-wide { grid-column: 1 / -1; }
.goods-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.goods-card {
  position: relative;
  width: calc((100% - #{$space-section}) / 2);
  min-width: 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 16px;
}
.goods-card-dark {
  background-color: #1c1e22;
}
.goods-title {
  flex: 1;
  @include type-style('body-strong');

}
.goods-content {
  @include type-style('caption');

  color: $text-secondary-light;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.goods-secondary {
  color: $text-secondary-light;
  @include type-style('badge');

  overflow-wrap: anywhere;
}
.goods-media {
  position: relative;
  border-radius: 10px;
  background-color: rgba(128, 134, 146, 0.06);
}
.goods-photo,
.goods-placeholder {
  width: 100%;
  height: 150px;
}
.goods-placeholder {
  align-items: center;
  justify-content: center;
  color: $text-secondary-light;
}
.goods-badge {
  position: absolute;
  top: $space-detail;
  left: $space-detail;
}
.status-summary {
  flex-wrap: wrap;
}
.status-tag {
  padding: $space-detail $space-inline;
  border-radius: 12px;
  @include type-style('caption');
}
.status-1 {
  background-color: rgba(56, 147, 103, 0.14);
  color: #389367;
}
.status-4 {
  background-color: rgba(170, 128, 26, 0.14);
  color: #aa801a;
}
.status-2 {
  background-color: rgba(189, 80, 80, 0.14);
  color: #bd5050;
}
.status-3 {
  background-color: rgba(104, 115, 133, 0.14);
  color: #687385;
}
@media (min-width: 700px) {
  .goods-card {
    width: calc((100% - #{$space-section} * 2) / 3);
  }
}
@media (min-width: 1000px) {
  .goods-card {
    width: calc((100% - #{$space-section} * 3) / 4);
  }
}
.goods-error {
  color: #e05252;
}
@media (min-width: 700px) {
  .metric-wide { grid-column: auto; }
  .metrics {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
.goods-title-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  line-height: type-line('body');
}
.goods-price { @include type-style('body-strong');  }
/* #ifdef WEB || MP-WEIXIN */
.goods-title-button::after, .device-type-tab::after { border: 0; }
/* #endif */

.secondary-text-dark { color: $text-secondary-dark; }
</style>
