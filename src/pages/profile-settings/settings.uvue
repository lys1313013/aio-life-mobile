<script setup lang="ts">
import PageState from "../../components/PageState.uvue";
import AvatarPickerButton from '../../components/AvatarPickerButton.uvue'
import { usePageRefresh } from '../../services/page-refresh.ts'
import FormActions from '../../components/FormActions.uvue'
import MobileButton from '../../components/MobileButton.uvue'
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { themeClass } from '../../services/theme.ts'
import { computed, ref, watch } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import { fetchUser, request, uploadAvatar } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'

const loading = ref(false)
const saving = ref(false)
const uploading = ref(false)
const ready = ref(false)
const errorText = ref('')
const loadError = ref('')
const form = ref<{ nickname: string; introduction: string; avatarFileId: string | null; avatarUrl: string }>({ nickname: '', introduction: '', avatarFileId: null, avatarUrl: '' })
const email = computed(() => session.user?.email || '未设置')
let active = false, revision = 0
let avatarSelection: { token: string; version: number } | null = null
function clearPage() {
  revision++
  avatarSelection = null
  ready.value = false
  loading.value = false
  saving.value = false
  uploading.value = false
  errorText.value = ''
  loadError.value = ''
  form.value = { nickname: '', introduction: '', avatarFileId: null, avatarUrl: '' }
}
function suspend() {
  active = false; revision++
  loading.value = false; saving.value = false; uploading.value = false
  avatarSelection = null
}
watch(() => session.token, () => {
  clearPage()
  if (active && session.token) load()
}, { flush: 'sync' })
onHide(suspend)
onUnload(() => { suspend(); clearPage() })
const refreshOnShow = usePageRefresh(load, { loading: () => loading.value, error: () => loadError.value, keys: () => ['users', 'user'] })
onShow(() => {
  restoreSession()
  active = true
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  refreshOnShow()
})
function current(token, version) { return active && token === session.token && version === revision }
function failure(error) {
  if (!active) return
  if (error.name === 'SessionExpiredError') {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  errorText.value = error.message || '操作失败，请重试'
}
async function load() {
  if (loading.value) return
  loading.value = true
  loadError.value = ''
  const token = session.token, version = revision
  try {
    const user = await fetchUser()
    if (!current(token, version)) return
    form.value = {
      nickname: user.nickname,
      introduction: user.introduction,
      avatarFileId: user.avatarFileId,
      avatarUrl: user.avatarUrl
    }
    ready.value = true
  } catch (error) {
    if (current(token, version)) {
      if (error.name === 'SessionExpiredError') failure(error)
      else loadError.value = error.message || '加载失败，请重试'
    }
  } finally {
    if (current(token, version)) loading.value = false
  }
}
async function uploadSelectedAvatar(filePath: string, token: string, version: number) {
  if (!current(token, version) || !filePath || uploading.value || saving.value || !ready.value) return
  uploading.value = true
  errorText.value = ''
  try {
    const uploaded = await uploadAvatar(filePath)
    if (current(token, version)) {
      form.value.avatarFileId = uploaded.id
      form.value.avatarUrl = uploaded.fileUrl
    }
  } catch (error) {
    if (current(token, version)) failure(error)
  } finally {
    if (current(token, version)) uploading.value = false
  }
}
function beginAvatarSelection() {
  if (!active || uploading.value || saving.value || !ready.value) return
  avatarSelection = { token: session.token, version: revision }
}
function chooseAvatar(event: { detail?: { avatarUrl?: string } }) {
  const selection = avatarSelection
  avatarSelection = null
  const filePath = event.detail?.avatarUrl
  if (!selection || !filePath) return
  return uploadSelectedAvatar(filePath, selection.token, selection.version)
}
function avatarError(event: { detail?: { errMsg?: string } }) {
  const selection = avatarSelection
  avatarSelection = null
  if (!selection || !current(selection.token, selection.version)) return
  if (event.detail?.errMsg?.toLowerCase().includes('cancel')) return
  errorText.value = '无法选择头像，请重试'
}
async function save() {
  if (!ready.value || saving.value || uploading.value) return
  const nickname = form.value.nickname.trim()
  if (!nickname) {
    errorText.value = '请输入昵称'
    return
  }
  saving.value = true
  errorText.value = ''
  const token = session.token, version = revision
  const data = { nickname, introduction: form.value.introduction, avatarFileId: form.value.avatarFileId }
  try {
    await request('/users', 'PUT', data)
    if (!current(token, version)) return
    if (session.user)
      session.user = { ...session.user, ...data, avatarUrl: form.value.avatarUrl, name: nickname }
    // 保存绑定后重新获取服务端公共 URL，避免继续展示临时上传预览地址。
    await fetchUser()
    if (!current(token, version)) return
    uni.showToast({ title: '已保存', icon: 'success' })
    back()
  } catch (error) {
    if (current(token, version)) failure(error)
  } finally {
    if (current(token, version)) saving.value = false
  }
}
function back() {
  uni.navigateBack({
    fail: () => uni.switchTab({ url: '/pages/profile/index' })
  })
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="编辑资料" back @back="!saving && !uploading && back()" />
    <scroll-view scroll-y class="tab-scroll">
      <view class="tab-content ui-page-inset">
        <PageState :loading="loading" :has-content="ready" :content-key="session.token" :error="loadError" @retry="load">
          <template #loading>
            <view class="settings-card ui-card settings-skeleton" :class="themeClass('settings-card')" role="status" aria-label="正在加载个人资料">
              <view class="avatar-section ui-mb-section" aria-hidden="true">
                <view class="settings-avatar settings-placeholder" :class="themeClass('settings-placeholder')" />
                <view class="avatar-actions settings-skeleton-avatar-action"><text class="settings-label settings-skeleton-copy settings-placeholder" :class="themeClass('settings-placeholder')">更换头像</text></view>
              </view>
              <view class="settings-inline-row" aria-hidden="true">
                <text class="settings-label settings-inline-label settings-skeleton-copy settings-placeholder" :class="themeClass('settings-placeholder')">昵称</text>
                <view class="settings-input settings-placeholder" :class="themeClass('settings-placeholder')" />
              </view>
              <view class="settings-inline-row" aria-hidden="true">
                <text class="settings-label settings-inline-label settings-skeleton-copy settings-placeholder" :class="themeClass('settings-placeholder')">邮箱</text>
                <view class="settings-readonly ui-px-card"><text class="settings-skeleton-email settings-skeleton-copy settings-placeholder" :class="themeClass('settings-placeholder')">{{ email }}</text></view>
              </view>
              <view class="settings-skeleton-heading ui-mb-section ui-mt-section" aria-hidden="true"><text class="settings-label settings-skeleton-copy settings-placeholder" :class="themeClass('settings-placeholder')">签名</text></view>
              <view class="settings-textarea ui-pad-card settings-placeholder" :class="themeClass('settings-placeholder')" aria-hidden="true" />
              <FormActions class="ui-mt-section">
                <view v-for="action in ['取消', '保存']" :key="action" class="settings-skeleton-action settings-placeholder" :class="[themeClass('settings-placeholder'), { 'settings-skeleton-save': action === '保存' }]" aria-hidden="true"><text class="settings-skeleton-copy ui-type-body">{{ action }}</text></view>
              </FormActions>
            </view>
          </template>
        <text v-if="errorText" class="settings-error ui-type-body" role="alert">{{ errorText }}</text>
        <view
          v-if="ready"
          class="settings-card ui-card"
          :class="themeClass('settings-card')"
        >
          <view class="avatar-section ui-mb-section">
            <image
              v-if="form.avatarUrl"
              class="settings-avatar"
              :src="form.avatarUrl"
              mode="aspectFill"
            />
            <view
              v-else
              class="settings-avatar avatar-fallback"
              :class="themeClass('avatar-fallback')"
              ><text
                class="avatar-initial"
                :class="themeClass('avatar-initial')"
                >{{ (form.nickname || '我').slice(0, 1) }}</text
              ></view
            >
            <view class="avatar-actions">
              <AvatarPickerButton :disabled="uploading || saving || !ready" :loading="uploading"
                @start="beginAvatarSelection" @selected="chooseAvatar" @error="avatarError" />
            </view>
          </view>
          <view class="settings-inline-row">
            <text class="settings-label settings-inline-label" :class="themeClass('settings-label')">昵称</text>
            <input
              v-model="form.nickname"
              class="settings-input ui-px-card"
              aria-label="昵称"
              placeholder="怎么称呼你"
              :maxlength="64"
              :disabled="saving" :aria-disabled="saving"
              :class="themeClass('settings-input')"
            />
          </view>
          <view class="settings-inline-row">
            <text class="settings-label settings-inline-label" :class="themeClass('settings-label')">邮箱</text>
            <text class="settings-readonly ui-px-card" :class="themeClass('settings-readonly')" selectable>{{ email }}</text>
          </view>
          <text class="settings-label ui-mb-section ui-mt-section" :class="themeClass('settings-label')"
            >签名</text
          >
          <textarea
            v-model="form.introduction"
            class="settings-textarea ui-pad-card"
            aria-label="签名"
            placeholder="写一句你喜欢的话"
            :maxlength="255"
            :disabled="saving" :aria-disabled="saving"
            :class="themeClass('settings-textarea')"
          />
          <FormActions class="ui-mt-section">
            <MobileButton label="取消" variant="quiet" :disabled="saving || uploading" @click="back" />
            <MobileButton label="保存" :loading="saving" :disabled="uploading" @click="save" />
          </FormActions>
        </view>
        </PageState>
      </view>
    </scroll-view>
  <SecondaryUnlock />
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/skeleton';
@use '../../styles/theme-tokens' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.settings-placeholder { @include skeleton.shape; }
.settings-card {

  background-color: #ffffff;
  border-radius: 18px;
}
.settings-error { color: #d03050; }
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: $space-inline;
}
.settings-avatar {
  width: 72px;
  height: 72px;
  border-radius: 36px;
}
.avatar-fallback {
  background-color: #e3ebfc;
  align-items: center;
  justify-content: center;
}
.avatar-initial {
  color: #4f78c4;
  @include type-style('avatar');
}
.settings-label {
  color: #52525b;
  @include type-style('label');

}
.settings-inline-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  min-height: $space-controlMin;
}
.settings-inline-label {
  flex-shrink: 0;
}
.settings-input {
  flex: 1;
  min-width: 0;
  height: 48px;

  border-radius: 12px;
  background-color: #f5f6f8;
  color: #27272a;
  @include type-style('body');
}
.settings-readonly {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  color: $text-secondary-light;
  @include type-style('body');

}
.settings-textarea {
  width: 100%;
  height: 120px;

  border-radius: 12px;
  background-color: #f5f6f8;
  color: #27272a;
  @include type-style('body');
}
.settings-skeleton-action {
  min-height: $space-controlMin;
  min-width: $space-controlMin;
  padding: 0 $space-card;
  border-radius: 12px;
  box-sizing: border-box;
  justify-content: center;
}

.settings-card-dark {
  background-color: #1c1e22;
}
.settings-label-dark {
  color: #b4b4bd;
}
.settings-input-dark,
.settings-textarea-dark {
  color: #eeeeef;
  background-color: #282a30;
}
.avatar-fallback-dark {
  background-color: #243451;
}
.avatar-initial-dark {
  color: #9dbcfa;
}


.settings-readonly-dark {
  color: $text-secondary-dark;
}

.settings-placeholder { background-color: $theme-skeleton-light; }
.settings-placeholder-dark { @include skeleton.dark; }
.settings-skeleton { @include skeleton.pulse; }
.settings-skeleton-avatar-action { min-height: $space-controlMin; }
.settings-skeleton-copy { color: transparent; }
.settings-skeleton-email { align-self: flex-start; max-width: 100%; @include type-style('body'); }
.settings-skeleton-heading { flex-direction: row; }
@include skeleton.motion('.settings-skeleton');
</style>
