<script setup lang="ts">
import { computed } from 'vue';
import FormField from '../../components/FormField.uvue';
import { themeClass } from '../../services/theme.ts';
const props = withDefaults(defineProps<{ label: string; modelValue: string; disabled?: boolean }>(), { disabled: false });
const emit = defineEmits(['update:modelValue']);
const today = new Date(Date.now() + 8 * 3600000).toISOString().slice(0, 10);
const pickerDate = computed(() => props.modelValue || today);
function changeDate(event) { emit('update:modelValue', String(event.detail.value)); }
</script>
<template>
  <FormField :label="label" compact stretch :disabled="disabled">
    <template #labelAction><view class="date-label-action"><slot name="action" /></view></template>
    <view class="date-controls" :class="themeClass('date-controls')">
      <picker class="date-value" mode="date" :value="pickerDate" :end="today" fields="day" start="1000-01-01" :disabled="disabled" :aria-label="label" @change="changeDate"><text class="date-text" :class="themeClass('date-text')">{{ modelValue ? modelValue.replaceAll('-', '.') : '请选择' }}</text></picker>
    </view>
  </FormField>
</template>
<style scoped lang="scss">
@use '../../styles/spacing-tokens' as *;
@use '../../styles/typography' as *;
.date-label-action { min-height: $space-controlMin; display: flex; align-items: center; }
.date-controls { display: flex; flex-direction: row; align-items: center; min-height: $space-controlMin; border: 1px solid #e4e6eb; border-radius: 8px; background-color: #fff; }
.date-controls-dark { background-color: #1c1e22; border-color: #373b44; }
.date-value { flex: 1; min-width: 0; padding: $space-inline; }
.date-text { @include type-style('body'); color: #27272a; }
.date-text-dark { color: #eeeeef; }
</style>
