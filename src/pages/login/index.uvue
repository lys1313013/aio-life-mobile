<script setup lang="ts">
import AppIcon from '../../components/AppIcon.uvue'
import FormField from '../../components/FormField.uvue'
import PageHeader from '../../components/PageHeader.uvue'
import { themeClass } from '../../services/theme.ts'
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { login } from '../../services/api.ts'
import { validateCredentials, readPhoneCode } from '../../services/contract.ts'
import { restoreSession, session } from '../../services/session.ts'
import { fetchWechatEnabled, startWechatLogin, loginWithWechatPhone, bindWechatAccount, initializeWechatPassword } from '../../services/wechat-auth.ts'

const username = ref('')
const password = ref('')
const passwordVisible = ref(false)
const newPasswordVisible = ref(false)
const confirmPasswordVisible = ref(false)
const busy = ref(false)
const errorText = ref('')
const mode = ref('password')
const wechatEnabled = ref(false)
const wechatCapabilityFailed = ref(false)
const loginTicket = ref('')
const ticketExpiresAt = ref(0)
const accountUsername = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
let capabilitiesLoaded = false

onShow(async () => {
  restoreSession()
  if (session.token.length > 0) {
    if (mode.value !== 'set-password') goHome()
    return
  }
  // #ifdef MP-WEIXIN
  if (!capabilitiesLoaded) await loadWechatCapabilities()
  // #endif
})

async function loadWechatCapabilities() {
  if (busy.value) return
  busy.value = true
  errorText.value = ''
  wechatCapabilityFailed.value = false
  try {
    wechatEnabled.value = await fetchWechatEnabled()
    if (wechatEnabled.value) mode.value = 'wechat'
    capabilitiesLoaded = true
  } catch (_) {
    wechatCapabilityFailed.value = true
    errorText.value = '暂时无法获取微信登录方式，可重试或使用账号密码登录'
  } finally { busy.value = false }
}

function goHome() { uni.reLaunch({ url: '/pages/home/index' }) }

function switchMode(next) {
  if (busy.value) return
  mode.value = next
  resetPasswordVisibility()
  errorText.value = ''
  password.value = ''
  if (next !== 'bind') {
    loginTicket.value = ''
    ticketExpiresAt.value = 0
  }
}

function openAuth(mode: string) { if (!busy.value) uni.navigateTo({ url: '/pages/auth/index?mode=' + mode }) }
function resetPasswordVisibility() {
  passwordVisible.value = false
  newPasswordVisible.value = false
  confirmPasswordVisible.value = false
}

function acceptWechat(result) {
  resetPasswordVisibility()
  if (result.status === 'LOGGED_IN') {
    loginTicket.value = ''
    password.value = ''
    if (!result.hasPassword) {
      accountUsername.value = result.accountUsername
      mode.value = 'set-password'
    } else goHome()
    return
  }
  loginTicket.value = result.loginTicket
  ticketExpiresAt.value = Date.now() + result.expiresIn * 1000
  mode.value = result.status === 'BIND_REQUIRED' ? 'bind' : 'phone'
  if (result.status === 'BIND_REQUIRED') errorText.value = '请登录原账号，验证后绑定微信'
}

function requireTicket() {
  if (loginTicket.value.length === 0 || Date.now() >= ticketExpiresAt.value) {
    switchMode('wechat')
    throw new Error('登录已超时，请重新微信登录')
  }
}

async function wechatLogin() {
  if (busy.value) return
  errorText.value = ''
  busy.value = true
  try { acceptWechat(await startWechatLogin()) }
  catch (error) { errorText.value = error.message || '微信登录失败，请重试' }
  finally { busy.value = false }
}

async function phoneAuthorized(event) {
  if (busy.value) return
  errorText.value = ''
  // 拒绝授权不消费票据，可在有效期内重新授权。
  let code = ''
  try { requireTicket(); code = readPhoneCode(event.detail) }
  catch (error) { errorText.value = error.message; return }
  busy.value = true
  try { acceptWechat(await loginWithWechatPhone(loginTicket.value, code)) }
  catch (error) {
    loginTicket.value = ''
    mode.value = 'wechat'
    errorText.value = error.message || '手机号验证失败，请重新微信登录'
  } finally { busy.value = false }
}

async function submit() {
  if (busy.value) return
  errorText.value = validateCredentials(username.value, password.value)
  if (errorText.value.length > 0) return
  if (mode.value === 'bind') {
    try { requireTicket() }
    catch (error) { errorText.value = error.message; return }
  }
  busy.value = true
  try {
    if (mode.value === 'bind') acceptWechat(await bindWechatAccount(loginTicket.value, username.value, password.value))
    else { await login(username.value, password.value); goHome() }
    password.value = ''
  } catch (error) {
    errorText.value = error.message || '登录失败，请重试'
    // 绑定票据可能已消费，重新识别微信身份后才能再次绑定。
    if (mode.value === 'bind') { loginTicket.value = ''; mode.value = 'wechat' }
  } finally { busy.value = false }
}

async function setPassword() {
  if (busy.value) return
  errorText.value = ''
  if (newPassword.value.length < 8 || newPassword.value.length > 128 || newPassword.value.trim().length === 0) {
    errorText.value = '密码长度需为 8–128 位'; return
  }
  if (newPassword.value !== confirmPassword.value) { errorText.value = '两次输入的密码不一致'; return }
  busy.value = true
  try {
    await initializeWechatPassword(newPassword.value)
    newPassword.value = ''; confirmPassword.value = ''
    goHome()
  } catch (error) {
    errorText.value = error.message || '设置失败，请重试'
    if (session.token.length === 0) {
      mode.value = wechatEnabled.value ? 'wechat' : 'password'
      newPassword.value = ''; confirmPassword.value = ''
    }
  }
  finally { busy.value = false }
}
</script>

<template>
  <view class="page login-page" :class="themeClass('login-page')">
    <!-- #ifndef WEB -->
    <PageHeader title="人生仪表盘">
      <view class="login-brand">
        <image class="login-logo" src="/static/login-logo.png" mode="aspectFit" />
        <text class="login-brand-name" :class="themeClass('login-brand-name')">人生仪表盘</text>
      </view>
    </PageHeader>
    <!-- #endif -->
    <!-- #ifdef WEB -->
    <view class="login-header">
      <view class="login-brand">
        <image class="login-logo" src="/static/login-logo.png" mode="aspectFit" />
        <text class="login-brand-name" :class="themeClass('login-brand-name')">人生仪表盘</text>
      </view>
    </view>
    <!-- #endif -->
    <view class="login-main">
      <view class="login-content">
        <text class="login-title ink" :class="themeClass('ink')">{{ mode === 'set-password' ? '设置登录密码' : mode === 'bind' ? '绑定已有账号' : '欢迎回来' }}</text>
        <text class="login-subtitle muted" :class="themeClass('muted')">{{ mode === 'set-password' ? '设置密码，下次也可使用账号登录。' : mode === 'bind' ? '登录后，将微信绑定到你的账号。' : '让生活，有迹可循。' }}</text>

        <view class="login-form">
          <!-- #ifdef MP-WEIXIN -->
          <view v-if="mode === 'wechat'">
            <button class="primary-button" :loading="busy" :disabled="busy" @click="wechatLogin">微信登录</button>
            <button class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="switchMode('password')" :class="themeClass('muted')">账号密码登录</button>
          </view>
          <view v-if="mode === 'phone'">
            <button class="primary-button" :open-type="busy ? '' : 'getPhoneNumber'" :loading="busy" :disabled="busy" @getphonenumber="phoneAuthorized">授权手机号并注册</button>
            <text class="phone-note muted ui-mt-section" :class="themeClass('muted')">首次使用将创建账号，已有账号请先登录绑定。</text>
            <button class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="switchMode('bind')" :class="themeClass('muted')">已有账号，登录并绑定</button>
            <button class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="switchMode('wechat')" :class="themeClass('muted')">返回微信登录</button>
          </view>
          <view v-if="mode === 'set-password'">
            <text class="field-label ink" :class="themeClass('ink')">设置登录密码</text>
            <text class="account-note muted ui-mb-section" :selectable="true" :class="themeClass('muted')">登录账号：{{ accountUsername }}</text>
            <view class="password-field">
              <input v-model="newPassword" class="field-input password-input ui-px-card" placeholder="设置密码，至少 8 位" :password="!newPasswordVisible" :disabled="busy" :maxlength="128" aria-label="设置密码" :class="themeClass('field-input')" />
              <button role="button" class="password-toggle ui-type-body" :disabled="busy" :aria-label="newPasswordVisible ? '隐藏设置密码' : '显示设置密码'" :aria-pressed="newPasswordVisible" @click="newPasswordVisible = !newPasswordVisible">
                <AppIcon :name="newPasswordVisible ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" color="#8b8f99" />
              </button>
            </view>
            <view class="password-field password-label ui-mt-section">
              <input v-model="confirmPassword" class="field-input password-input ui-px-card" placeholder="再次输入密码" :password="!confirmPasswordVisible" :disabled="busy" :maxlength="128" aria-label="确认密码" @confirm="setPassword" :class="themeClass('field-input')" />
              <button role="button" class="password-toggle ui-type-body" :disabled="busy" :aria-label="confirmPasswordVisible ? '隐藏确认密码' : '显示确认密码'" :aria-pressed="confirmPasswordVisible" @click="confirmPasswordVisible = !confirmPasswordVisible">
                <AppIcon :name="confirmPasswordVisible ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" color="#8b8f99" />
              </button>
            </view>
            <button class="primary-button password-label ui-mt-section" :loading="busy" :disabled="busy" @click="setPassword">设置并进入</button>
            <button class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="goHome" :class="themeClass('muted')">暂不设置</button>
          </view>
          <!-- #endif -->
          <view v-if="mode === 'password' || mode === 'bind'">
            <FormField label="账号" hide-label>
              <input v-model="username" class="field-input ui-px-card" placeholder="请输入账号" :disabled="busy" :maxlength="100" confirm-type="next" aria-label="账号" :class="themeClass('field-input')" />
            </FormField>
            <FormField label="密码" hide-label compact>
              <view class="password-field">
                <input v-model="password" class="field-input password-input ui-px-card" placeholder="请输入密码" :password="!passwordVisible" :disabled="busy" :maxlength="200" confirm-type="go" aria-label="密码" @confirm="submit" :class="themeClass('field-input')" />
                <button role="button" class="password-toggle ui-type-body" :disabled="busy" :aria-label="passwordVisible ? '隐藏密码' : '显示密码'" :aria-pressed="passwordVisible" @click="passwordVisible = !passwordVisible">
                  <AppIcon :name="passwordVisible ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" color="#8b8f99" />
                </button>
              </view>
            </FormField>
            <view class="recovery-row">
              <button role="button" class="text-button auth-link" :class="themeClass('auth-link')" :disabled="busy" @click="openAuth('reset')">忘记密码</button>
            </view>
            <button class="ui-type-body" role="button" :class="['primary-button', busy ? 'primary-disabled' : '']" :loading="busy" :disabled="busy" :aria-disabled="busy" @click="submit">{{ busy ? '正在登录' : (mode === 'bind' ? '登录并绑定微信' : '登录') }}</button>
            <view class="register-row">
              <text class="register-note muted" :class="themeClass('muted')">还没有账号？</text>
              <button role="button" class="text-button auth-link" :class="themeClass('auth-link')" :disabled="busy" @click="openAuth('register')">注册账号</button>
            </view>
            <!-- #ifdef MP-WEIXIN -->
            <button v-if="wechatCapabilityFailed" class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="loadWechatCapabilities" :class="themeClass('muted')">重试微信登录</button>
            <button v-if="wechatEnabled" class="text-button muted ui-pad-sm ui-mt-section" :disabled="busy" @click="switchMode('wechat')" :class="themeClass('muted')">微信登录</button>
            <!-- #endif -->
          </view>
          <view v-if="errorText" class="form-message">
            <text class="error-text" role="alert" :class="themeClass('error-text')">{{ errorText }}</text>
          </view>
        </view>
      </view>

    </view>
    <text class="login-footer muted" :class="themeClass('muted')">All in One · 人生仪表盘</text>
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.login-page { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; background-color: #fafafa; }
.login-page-dark { background-color: #111215; }
.login-header { padding: $space-modal $space-page; padding-top: calc($space-modal + env(safe-area-inset-top)); }
.login-brand { display: flex; flex-direction: row; align-items: center; gap: $space-inline; }
.login-logo { width: 34px; height: 34px; border-radius: 9px; }
.login-brand-name { @include type-style('brand');  color: #27272a; }
.login-brand-name-dark { color: #eeeeef; }
.login-main { display: flex; flex: 1; justify-content: center; padding: $space-overlayBlock $space-page; }
// 登录表单限制行宽，避免平板和桌面输入框横向拉伸；页面边距只由 login-main 提供。
.login-content { width: 100%; max-width: 400px; align-self: center; }
.ink { color: #27272a; }
.ink-dark { color: #eeeeef; }
.muted { color: #71717a; }
.muted-dark { color: #a1a1aa; }
.login-title { @include type-style('hero');   }
.login-subtitle { margin-top: $space-inline; @include type-style('body');  }
.login-form { margin-top: $space-overlayBlock; }
.field-label { @include type-style('label'); margin-bottom: $space-inline; }
.field-input { box-sizing: border-box; height: 48px; border: 1px solid #dedee3; border-radius: 8px; background-color: #fafafa; color: #27272a; @include type-style('body'); }
.field-input-dark { background-color: #18191d; border-color: #36383f; color: #eeeeef; }
.password-field { position: relative; }
.password-input { padding-right: ($space-controlMin + $space-detail); }
.password-toggle { display: flex; flex-direction: row; position: absolute; right: $space-micro; top: $space-micro; width: $space-controlMin; height: $space-controlMin; padding: 0; margin: 0; border: 0; border-radius: 8px; background-color: transparent; align-items: center; justify-content: center; }
.primary-button { display: flex; flex-direction: row; height: 48px; border-radius: 8px; background-color: #427bea; @include type-style('body'); line-height: type-leading('tallControl'); }
.recovery-row { display: flex; flex-direction: row; justify-content: flex-end; margin-bottom: $space-inline; }
.register-row { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: $space-detail; margin-top: $space-inline; }
.register-note { @include type-style('body');  }
.auth-link { color: #356bd4; }
.auth-link-dark { color: #80aaff; }
.form-message { padding-top: $space-inline; }
.login-footer { padding: $space-modal $space-page; padding-bottom: calc($space-overlayBlock + env(safe-area-inset-bottom)); text-align: center; @include type-style('caption');  }
.text-button { display: flex; flex-direction: row; align-items: center; justify-content: center; min-height: $space-controlMin; margin: 0; padding: 0; border: 0; border-radius: 8px; background-color: transparent; @include type-style('body');  }
.phone-note { @include type-style('caption');  text-align: center; }
.account-note { @include type-style('label');  }
/* #ifdef WEB || MP-WEIXIN */
.text-button::after, .password-toggle::after { border: 0; }
.field-input:focus-within { border-color: #427bea; }
.text-button:focus-visible, .password-toggle:focus-visible, .primary-button:focus-visible { outline: 2px solid #427bea; outline-offset: 2px; }
/* #endif */

</style>
