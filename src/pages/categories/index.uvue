<script setup lang="ts">
import ModalMotion from "../../components/ModalMotion.uvue";
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { isRequired } from '../../services/form-required.ts';
import AppIcon from '../../components/AppIcon.uvue'
import { computed, getCurrentInstance, nextTick, ref } from 'vue';
import { onHide, onLoad, onShow, onUnload } from '@dcloudio/uni-app';
import PageSearch from '../../components/PageSearch.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FormField from '../../components/FormField.uvue';
import FormActions from '../../components/FormActions.uvue';
import CategoryIcon from '../../components/CategoryIcon.uvue';
import catalog from '../../services/icons/catalog.ts';
import { isThemeDark, themeClass } from '../../services/theme.ts';
import { fetchUser } from '../../services/api.ts';
import { restoreSession, session } from '../../services/session.ts';
import { createLatestTask } from '../../services/mobile-ui.ts';
import { siblingSort, orderCategories } from '../../services/admin/contract.ts';
import spacing from '../../styles/spacing.json';
import {
  listCategories,
  saveCategory,
  changeCategory,
  deleteCategory,
  sortCategories,
} from './services/categories.ts';
const modalMotion0 = ref<{ close: () => void } | null>(null);

const admin = ref(false);
const rows = ref<any[]>([]);
const loading = ref(false);
const loaded = ref(false);
const refreshing = ref(false);
const error = ref('');
const busyId = ref('');
const saving = ref(false);
const opened = ref(false);
const editorError = ref('');
const searchOpen = ref(false);
const search = ref('');
const expandedActions = ref('');
const menuDeleteColor = computed(() => isThemeDark() ? '#ff707a' : '#b91c1c');
const menuScrollTop = ref(0);
const menuBottomSpace = ref(0);
const instance = getCurrentInstance();
let currentScrollTop = 0;
function onCategoryScroll(event) {
  currentScrollTop = event.detail.scrollTop;
}
function dismissActions() {
  expandedActions.value = '';
  menuBottomSpace.value = 0;
}
async function toggleActions(id: string) {
  if (loading.value || busyId.value) return;
  if (expandedActions.value === id) {
    dismissActions();
    return;
  }
  menuScrollTop.value = currentScrollTop;
  expandedActions.value = id;
  await nextTick();
  if (expandedActions.value !== id) return;
  uni.createSelectorQuery().in(instance?.proxy)
    .select('.category-menu').boundingClientRect()
    .select('.category-menu-space').boundingClientRect()
    .exec(async (rects) => {
      const menu = rects?.[0], space = rects?.[1];
      if (!menu || !space || expandedActions.value !== id) return;
      // 补足列表末尾的空间，避免 Vapor 的容器裁切，并避开右下角新增按钮。
      const bottomInset = spacing.controlMin + spacing.overlayBlock;
      const overflow = Math.ceil(menu.bottom + bottomInset - uni.getWindowInfo().windowHeight);
      const reserve = overflow > 0 ? bottomInset : spacing.detail;
      menuBottomSpace.value = Math.max(0, Math.ceil(menu.bottom - space.top + reserve));
      if (overflow <= 0) return;
      const target = currentScrollTop + overflow;
      await nextTick();
      if (expandedActions.value === id) menuScrollTop.value = target;
    });
}
function dismissPageControls() {
  searchOpen.value = false;
  dismissActions();
}
const searchQuery = computed(() => search.value.trim().toLowerCase());
const collapsed = ref<string[]>([]);
const original = ref<any>(null);
const form = ref<any>({});
const showDescription = ref(false);
const showColorValue = ref(false);
const showIconValue = ref(false);
const iconPickerOpen = ref(false);
const iconSearch = ref('');
const task = createLatestTask();
let active = true;
const icons = Object.keys(catalog.icons);
// 与 Web 我的分类保持相同的预设色；已有自定义色不做转换。
const colorPresets = ['#1890ff', '#52c41a', '#faad14', '#f5222d', '#722ed1', '#13c2c2', '#eb2f96', '#fa8c16', '#a0d911', '#2f54eb'];
const filteredIcons = computed(() => icons.filter((icon) => icon.toLowerCase().includes(iconSearch.value.trim().toLowerCase())));
function openIconPicker() {
  iconSearch.value = '';
  iconPickerOpen.value = true;
}
function selectIcon(icon: string) {
  form.value.icon = icon;
  iconPickerOpen.value = false;
}
const shown = computed(() =>
  orderCategories(rows.value).filter(
    (row) =>
      String(row.name || '').toLowerCase().includes(searchQuery.value) &&
      (searchQuery.value || !row.parentId || !collapsed.value.includes(row.parentId)),
  ),
);
const parents = computed(() => [
  { id: '', name: '无（一级分类）' },
  ...rows.value.filter(
    (row) =>
      !row.parentId &&
      row.id !== form.value.id &&
      !rows.value.some((child) => child.parentId === form.value.id),
  ),
]);
const parentName = computed(
  () => parents.value.find((row) => row.id === form.value.parentId)?.name || parents.value[0].name,
);
function selectParent(value) {
  const id = parents.value.find((row) => row.name === value)?.id || '';
  form.value.parentId = id || null;
  form.value.inheritParent = false;
}
onLoad((options) => {
  admin.value = options?.admin === '1';
});
onHide(dismissActions);
onUnload(() => {
  active = false;
  task.invalidate();
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['timeTrackerCategory'] })
onShow(() => {
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
async function load(refresh = false) {
  dismissActions();
  const generation = task.begin(),
    token = session.token;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    if (!session.user) await fetchUser();
    if (admin.value && !session.user?.roles?.includes('admin'))
      throw Error('当前账号没有管理员权限');
    const result = await listCategories(admin.value);
    if (active && task.isCurrent(generation) && token === session.token) {
      rows.value = result;
      loaded.value = true;
    }
  } catch (reason) {
    if (active && task.isCurrent(generation)) error.value = reason.message || '加载失败';
  } finally {
    if (active && task.isCurrent(generation)) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function edit(row = null, parentId = '') {
  if (loading.value || busyId.value) return;
  dismissActions();
  original.value = row;
  form.value = row
    ? { ...row, parentId: row.parentId || '', inheritParent: !!row.inheritParent }
    : {
        parentId,
        name: '',
        color: '#427bea',
        icon: '',
        description: '',
        isTrackTime: 0,
        isEnabled: 1,
        sortOrder:
          Math.max(
            -10,
            ...rows.value
              .filter((row) => (row.parentId || '') === parentId)
              .map((row) => row.sortOrder || 0),
          ) + 10,
      };
  editorError.value = '';
  showDescription.value = false;
  showColorValue.value = false;
  showIconValue.value = false;
  iconPickerOpen.value = false;
  opened.value = true;
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  editorError.value = '';
  const token = session.token;
  try {
    await saveCategory(form.value, original.value, admin.value);
    if (active && token === session.token) {
      opened.value = false;
      await load();
    }
  } catch (reason) {
    if (active && token === session.token) editorError.value = reason.message || '保存失败';
  } finally {
    saving.value = false;
  }
}
async function change(row, changes) {
  if (busyId.value || loading.value) return;
  busyId.value = row.id;
  error.value = '';
  const token = session.token;
  try {
    await changeCategory(row, changes, admin.value);
    if (active && token === session.token) await load();
  } catch (reason) {
    if (active && token === session.token) error.value = reason.message || '操作失败';
  } finally {
    busyId.value = '';
  }
}
function toggleVisibility(row) {
  return change(row, { isEnabled: row.isEnabled === 0 ? 1 : 0 });
}
async function remove(row) {
  await deleteCategory(row, admin.value);
  if (active) await load();
}
async function move(row, delta) {
  if (busyId.value) return;
  const sorted = siblingSort(rows.value, row, delta);
  if (!sorted.length) return;
  busyId.value = row.id;
  const token = session.token;
  try {
    if (admin.value) {
      for (const item of sorted)
        await changeCategory(
          rows.value.find((row) => row.id === item.id),
          { sortOrder: item.sortOrder },
          true,
        );
    } else await sortCategories(sorted);
    if (active && token === session.token) await load();
  } catch (reason) {
    if (active && token === session.token) {
      error.value = reason.message || '排序失败';
      await load();
    }
  } finally {
    busyId.value = '';
  }
}
function toggle(row) {
  collapsed.value = collapsed.value.includes(row.id)
    ? collapsed.value.filter((id) => id !== row.id)
    : [...collapsed.value, row.id];
}
function hasChildren(row) {
  return rows.value.some((child) => child.parentId === row.id);
}
function privateCategory(row) {
  return !row.preset && !row.templateId;
}
</script>
<template>
  <view class="category-page" @click="dismissPageControls">
    <PageSearch v-model="search" v-model:open="searchOpen" title="时迹分类" label="搜索分类" back
      @update:open="dismissActions"
      @back="uni.navigateBack()" />
    <MobilePage :refreshing="refreshing" :scroll-top="menuScrollTop" @refresh="load(true)" @scroll="onCategoryScroll">
      <PageState :has-content="loaded" :loading="loading" :error="error" :empty="!shown.length" :empty-text="searchQuery ? '未找到匹配分类' : '暂无分类'" @retry="load()">
        <template #loading>
          <view class="category-loading" role="status" aria-label="正在加载分类" aria-live="polite">
            <view v-for="skeletonRowIndex in 5" :key="skeletonRowIndex" class="category-card category-card-skeleton" :class="themeClass('category-card')" aria-hidden="true">
              <view class="category-placeholder category-placeholder-icon" :class="themeClass('category-placeholder')" />
              <view class="category-summary"><view class="category-placeholder category-placeholder-name" :class="themeClass('category-placeholder')" /></view>
              <view class="category-actions"><view v-for="skeletonActionIndex in 2" :key="skeletonActionIndex" class="category-placeholder-action"><view class="category-placeholder category-placeholder-icon" :class="themeClass('category-placeholder')" /></view></view>
            </view>
          </view>
        </template>
        <view v-if="searchQuery && !shown.length && !loading && !error" class="category-search-empty">
          <MobileButton label="清空搜索" variant="quiet" @click="search = ''" />
        </view>
        <view
          v-for="row in shown"
          :key="row.id"
          class="category-card"
          :class="themeClass('category-card')"
        >
          <button
            hover-class="none"
            role="button"
            class="category-heading"
            :aria-label="'编辑分类：' + row.name"
            :disabled="!!busyId || loading"
            :tabindex="busyId || loading ? -1 : 0"
            @click="edit(row)"
            @keydown.enter.prevent="edit(row)"
            @keydown.space.prevent="edit(row)"
          >
            <CategoryIcon :icon="row.icon" :color="row.color" />
            <AppIcon v-if="row.parentId" name="lucide:corner-down-right" :size="16" />
            <view class="category-summary">
              <text class="category-name" :class="themeClass('category-name')">{{ row.name }}</text>
              <view v-if="row.isTrackTime === 1 || row.isEnabled === 0" class="category-summary-meta">
                <text v-if="row.isTrackTime === 1" class="category-meta" :class="themeClass('category-meta')">参与统计</text>
                <text v-if="row.isEnabled === 0" class="category-meta" :class="themeClass('category-meta')">已隐藏</text>
              </view>
            </view>
          </button>
          <view class="category-actions ui-row">
            <MobileButton
              v-if="hasChildren(row)"
              :label="collapsed.includes(row.id) ? '展开子分类' : '收起子分类'"
              :icon="collapsed.includes(row.id) ? 'ant-design:right-outlined' : 'ant-design:down-outlined'"
              variant="ghost"
              @click="toggle(row)"
            />
            <view class="category-menu-anchor" @click.stop @keydown.esc="dismissActions">
              <MobileButton
                label="更多分类操作"
                icon="ant-design:more-outlined"
                variant="ghost"
                :aria-expanded="expandedActions === row.id"
                :disabled="!!busyId || loading"
                :tabindex="busyId || loading ? -1 : 0"
                @click="toggleActions(row.id)"
                @keydown.enter.prevent="toggleActions(row.id)"
                @keydown.space.prevent="toggleActions(row.id)"
              />
              <view v-if="expandedActions === row.id" class="category-menu" :class="themeClass('category-menu')" role="group" :aria-label="row.name + '的分类操作'">
                <button
                  v-if="!row.parentId"
                  hover-class="none"
                  role="button"
                  class="category-menu-item"
                  aria-label="新增子分类"
                  :disabled="!!busyId || loading"
                  :tabindex="busyId || loading ? -1 : 0"
                  @click="edit(null, row.id)"
                  @keydown.enter.prevent="edit(null, row.id)"
                  @keydown.space.prevent="edit(null, row.id)"
                >
                  <AppIcon name="ant-design:plus-outlined" :size="16" />
                  <text class="category-menu-label" :class="themeClass('category-menu-label')">新增子分类</text>
                </button>
                <button
                  hover-class="none"
                  role="button"
                  class="category-menu-item"
                  :aria-label="row.isEnabled === 0 ? '恢复分类' : '隐藏分类'"
                  :aria-busy="busyId === row.id"
                  :loading="busyId === row.id"
                  :disabled="!!busyId || loading"
                  :tabindex="busyId || loading ? -1 : 0"
                  @click="toggleVisibility(row)"
                  @keydown.enter.prevent="toggleVisibility(row)"
                  @keydown.space.prevent="toggleVisibility(row)"
                >
                  <AppIcon v-if="busyId !== row.id" :name="row.isEnabled === 0 ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" :size="16" />
                  <text class="category-menu-label" :class="themeClass('category-menu-label')">{{ row.isEnabled === 0 ? '恢复分类' : '隐藏分类' }}</text>
                </button>
                <view v-if="admin || privateCategory(row)" class="category-menu-delete" :class="themeClass('category-menu-delete')">
                  <ConfirmAction
                    label="删除分类"
                    message="确定删除分类？已有记录或子分类时无法删除。"
                    :trigger-disabled="!!busyId || loading"
                    :action="() => remove(row)"
                  >
                    <template #default="{ open, busy }">
                      <button
                        hover-class="none"
                        role="button"
                        class="category-menu-item"
                        aria-label="删除分类"
                        :aria-busy="busy"
                        :loading="busy"
                        :disabled="busy || !!busyId || loading"
                        :tabindex="busy || busyId || loading ? -1 : 0"
                        @click="open"
                        @keydown.enter.prevent="open"
                        @keydown.space.prevent="open"
                      >
                        <AppIcon v-if="!busy" name="ant-design:delete-outlined" :size="16" :color="menuDeleteColor" />
                        <text class="category-menu-label" :style="{ color: menuDeleteColor }">删除分类</text>
                      </button>
                    </template>
                  </ConfirmAction>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="category-menu-space" :style="{ height: menuBottomSpace + 'px' }" aria-hidden="true" />
      </PageState>
      <template #fixed
        ><FloatingActionButton :disabled="loading || !!busyId" @click="edit()"
      /></template>
    </MobilePage>
    <ModalMotion><AdaptiveModal ref="modalMotion0"
      v-if="opened"
      label="编辑分类"
      :busy="saving"
      :content-key="editorError + showDescription + showColorValue + showIconValue"
      @close="opened = false"
    >
      <view class="category-editor">
        <view class="category-preview" :class="themeClass('category-preview')">
          <CategoryIcon :icon="form.icon" :color="form.color" :size="28" />
          <text class="category-preview-name" :class="themeClass('category-preview-name')">{{ form.name || '新分类' }}</text>
        </view>
        <FormField appearance="soft" :required="isRequired('category', 'name')" label="分类名称" v-model="form.name" :disabled="saving" />
        <FormField
          appearance="soft"
          label="上级分类"
          kind="selector"
          :model-value="parentName"
          :options="parents.map((row) => row.name)"
          :disabled="saving"
          @update:model-value="selectParent"
        />
        <FormField appearance="soft" :required="isRequired('category', 'color')" label="颜色">
          <template #labelAction>
            <button hover-class="none" role="button" class="category-inline-action" :class="themeClass('category-inline-action')" :disabled="saving" :aria-expanded="showColorValue" aria-label="自定义颜色" @click="showColorValue = !showColorValue">
              <view class="category-current-color" :style="{ backgroundColor: form.color }" />
              <AppIcon name="ant-design:edit-outlined" :size="16" />
            </button>
          </template>
          <view class="category-palette">
            <button hover-class="none" role="button" v-for="color in colorPresets" :key="color" class="category-color-option" :class="[{ 'category-color-selected': form.color?.toLowerCase() === color }, themeClass('category-color-option')]" :aria-label="'选择颜色 ' + color" :aria-pressed="form.color?.toLowerCase() === color" :disabled="saving" @click="form.color = color">
              <view class="category-color-swatch" :style="{ backgroundColor: color }">
                <AppIcon v-if="form.color?.toLowerCase() === color" name="ant-design:check-outlined" color="#ffffff" :size="16" />
              </view>
            </button>
          </view>
        </FormField>
        <FormField v-if="showColorValue" appearance="soft" label="自定义颜色值" v-model="form.color" placeholder="#1890ff" :disabled="saving" />
        <FormField appearance="soft" label="图标">
          <view class="category-icon-control" :class="themeClass('category-icon-control')">
            <button hover-class="none" role="button" class="category-icon-trigger" :disabled="saving" aria-label="选择分类图标" @click="openIconPicker">
              <CategoryIcon :icon="form.icon" :color="form.color" />
              <text class="category-control-text" :class="themeClass('category-control-text')">{{ form.icon ? '更换图标' : '选择图标' }}</text>
              <AppIcon name="ant-design:right-outlined" :size="14" />
            </button>
            <MobileButton label="自定义图标" icon="ant-design:edit-outlined" variant="quiet" :disabled="saving" @click="showIconValue = !showIconValue" />
            <MobileButton v-if="form.icon" label="清除图标" icon="ant-design:close-outlined" variant="quiet" :disabled="saving" @click="form.icon = ''" />
          </view>
        </FormField>
        <FormField v-if="showIconValue" appearance="soft" label="图标名称" v-model="form.icon" placeholder="如 lucide:book-open" :disabled="saving" />
        <view class="category-toggles">
          <view class="category-toggle">
            <text class="category-toggle-label" :class="themeClass('category-toggle-label')">显示时长统计卡</text>
            <MobileSwitch :checked="form.isTrackTime === 1" :disabled="saving" aria-label="显示时长统计卡" @change="(event) => (form.isTrackTime = event.detail.value ? 1 : 0)" />
          </view>
          <view class="category-toggle">
            <text class="category-toggle-label" :class="themeClass('category-toggle-label')">启用分类</text>
            <MobileSwitch :checked="form.isEnabled === 1" :disabled="saving" aria-label="启用分类" @change="(event) => (form.isEnabled = event.detail.value ? 1 : 0)" />
          </view>
        </view>
        <button hover-class="none" role="button" class="category-description-toggle" :disabled="saving" :aria-expanded="showDescription" aria-label="分类描述" @click="showDescription = !showDescription">
          <text class="category-toggle-label" :class="themeClass('category-toggle-label')">描述</text>
          <text class="category-description-summary" :class="themeClass('category-description-summary')">{{ form.description ? '已填写' : '选填' }}</text>
          <AppIcon :name="showDescription ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="12" />
        </button>
        <FormField v-if="showDescription" appearance="soft" label="描述" hide-label kind="textarea" v-model="form.description" :disabled="saving" />
        <FormField v-if="admin" appearance="soft" label="排序" :model-value="String(form.sortOrder || 0)" input-type="number" :disabled="saving" @update:model-value="(value) => (form.sortOrder = Number(value))" />
        <text v-if="editorError" class="category-error ui-mb-section ui-type-body" role="alert">{{ editorError }}</text>
      </view>
      <template #footer><FormActions>
        <template v-if="original" #secondary>
          <MobileButton label="上移分类" icon="ant-design:arrow-up-outlined" variant="quiet" :disabled="!!busyId || saving" @click="move(original, -1)" />
          <MobileButton label="下移分类" icon="ant-design:arrow-down-outlined" variant="quiet" :disabled="!!busyId || saving" @click="move(original, 1)" />
        </template>
        <MobileButton label="取消" variant="quiet" :disabled="saving" @click="modalMotion0?.close()" />
        <MobileButton label="保存" :loading="saving" @click="save" />
      </FormActions></template>
    </AdaptiveModal></ModalMotion>
    <ModalMotion><AdaptiveModal v-if="opened && iconPickerOpen" label="选择分类图标" show-close :max-width="520" :content-key="iconSearch" @close="iconPickerOpen = false">
      <FormField appearance="soft" label="搜索图标" :model-value="iconSearch" placeholder="输入图标名称，如 book" @update:model-value="(value) => (iconSearch = value)" />
      <view class="category-icon-grid">
        <button hover-class="none" role="button" v-for="icon in filteredIcons" :key="icon" class="category-icon-option" :class="[{ 'category-icon-selected': form.icon === icon }, themeClass('category-icon-option')]" :aria-label="'选择图标 ' + icon" :aria-pressed="form.icon === icon" @click="selectIcon(icon)">
          <CategoryIcon :icon="icon" :color="form.color" :size="24" />
        </button>
      </view>
      <text v-if="!filteredIcons.length" class="category-empty" :class="themeClass('category-description-summary')">没有匹配的图标，可返回输入自定义图标名称</text>
    </AdaptiveModal></ModalMotion>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/form-control' as form-control;
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/skeleton' as skeleton;
@include type-utilities('body');
@include skeleton.motion('.category-loading');

.category-page {
  flex: 1;
  height: 100%;
  min-height: 0;
}
.category-card {
  background-color: #ffffff;
  color: #27272a;
  border-radius: 12px;
  padding: $space-inline $space-card;
  margin-bottom: $space-inline;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;

  overflow: visible;
}
.category-card-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.category-heading {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;
  flex-direction: row;
  gap: $space-inline;
  align-items: center;
  margin: 0;
  padding: 0;
  border: 0;
  text-align: left;
