<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { isRequired } from '../../services/form-required.ts';
import AppIcon from '../../components/AppIcon.uvue'
import { computed, ref } from 'vue';
import { onLoad, onShow, onUnload } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FormField from '../../components/FormField.uvue';
import FormActions from '../../components/FormActions.uvue';
import CategoryIcon from '../../components/CategoryIcon.uvue';
import catalog from '../../services/icons/catalog.ts';
import { themeClass } from '../../services/theme.ts';
import { fetchUser } from '../../services/api.ts';
import { restoreSession, session } from '../../services/session.ts';
import { createLatestTask } from '../../services/mobile-ui.ts';
import { siblingSort, orderCategories } from '../../services/admin/contract.ts';
import {
  listCategories,
  saveCategory,
  changeCategory,
  deleteCategory,
  sortCategories,
} from './services/categories.ts';
const admin = ref(false);
const rows = ref<any[]>([]);
const loading = ref(false);
const refreshing = ref(false);
const error = ref('');
const busyId = ref('');
const saving = ref(false);
const opened = ref(false);
const editorError = ref('');
const search = ref('');
const expandedActions = ref('');
const searchQuery = computed(() => search.value.trim().toLowerCase());
const collapsed = ref<string[]>([]);
const original = ref<any>(null);
const form = ref<any>({});
const showDescription = ref(false);
const showColorValue = ref(false);
const showIconValue = ref(false);
const iconPickerOpen = ref(false);
const iconSearch = ref('');
const task = createLatestTask();
let active = true;
const icons = Object.keys(catalog.icons);
// 与 Web 我的分类保持相同的预设色；已有自定义色不做转换。
const colorPresets = ['#1890ff', '#52c41a', '#faad14', '#f5222d', '#722ed1', '#13c2c2', '#eb2f96', '#fa8c16', '#a0d911', '#2f54eb'];
const filteredIcons = computed(() => icons.filter((icon) => icon.toLowerCase().includes(iconSearch.value.trim().toLowerCase())));
function openIconPicker() {
  iconSearch.value = '';
  iconPickerOpen.value = true;
}
function selectIcon(icon: string) {
  form.value.icon = icon;
  iconPickerOpen.value = false;
}
const shown = computed(() =>
  orderCategories(rows.value).filter(
    (row) =>
      String(row.name || '').toLowerCase().includes(searchQuery.value) &&
      (searchQuery.value || !row.parentId || !collapsed.value.includes(row.parentId)),
  ),
);
const parents = computed(() => [
  { id: '0', name: '无（一级分类）' },
  ...rows.value.filter(
    (row) =>
      (!row.parentId || row.parentId === '0') &&
      row.id !== form.value.id &&
      !rows.value.some((child) => child.parentId === form.value.id),
  ),
]);
const parentName = computed(
  () => parents.value.find((row) => row.id === form.value.parentId)?.name || parents.value[0].name,
);
const types = ['必须', '积极', '休闲'];
onLoad((options) => {
  admin.value = options?.admin === '1';
});
onUnload(() => {
  active = false;
  task.invalidate();
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['timeTrackerCategory'] })
onShow(() => {
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
async function load(refresh = false) {
  const generation = task.begin(),
    token = session.token;
  loading.value = true;
  refreshing.value = refresh;
  error.value = '';
  try {
    if (!session.user) await fetchUser();
    if (admin.value && !session.user?.roles?.includes('admin'))
      throw Error('当前账号没有管理员权限');
    const result = await listCategories(admin.value);
    if (active && task.isCurrent(generation) && token === session.token) rows.value = result;
  } catch (reason) {
    if (active && task.isCurrent(generation)) error.value = reason.message || '加载失败';
  } finally {
    if (active && task.isCurrent(generation)) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function edit(row = null, parentId = '0') {
  if (loading.value || busyId.value) return;
  expandedActions.value = '';
  original.value = row;
  form.value = row
    ? { ...row, parentId: row.parentId || '0' }
    : {
        parentId,
        name: '',
        color: '#427bea',
        icon: '',
        description: '',
        isTrackTime: 0,
        isEnabled: 1,
        sort:
          Math.max(
            -10,
            ...rows.value
              .filter((row) => (row.parentId || '0') === parentId)
              .map((row) => row.sort || 0),
          ) + 10,
        timeType: 1,
      };
  editorError.value = '';
  showDescription.value = false;
  showColorValue.value = false;
  showIconValue.value = false;
  iconPickerOpen.value = false;
  opened.value = true;
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  editorError.value = '';
  const token = session.token;
  try {
    await saveCategory(form.value, original.value, admin.value);
    if (active && token === session.token) {
      opened.value = false;
      await load();
    }
  } catch (reason) {
    if (active && token === session.token) editorError.value = reason.message || '保存失败';
  } finally {
    saving.value = false;
  }
}
async function change(row, changes) {
  if (busyId.value) return;
  busyId.value = row.id;
  error.value = '';
  const token = session.token;
  try {
    await changeCategory(row, changes, admin.value);
    if (active && token === session.token) await load();
  } catch (reason) {
    if (active && token === session.token) error.value = reason.message || '操作失败';
  } finally {
    busyId.value = '';
  }
}
async function remove(row) {
  await deleteCategory(row, admin.value);
  if (active) await load();
}
async function move(row, delta) {
  if (busyId.value) return;
  const sorted = siblingSort(rows.value, row, delta);
  if (!sorted.length) return;
  busyId.value = row.id;
  const token = session.token;
  try {
    if (admin.value) {
      for (const item of sorted)
        await changeCategory(
          rows.value.find((row) => row.id === item.id),
          { sort: item.sort },
          true,
        );
    } else await sortCategories(sorted);
    if (active && token === session.token) await load();
  } catch (reason) {
    if (active && token === session.token) {
      error.value = reason.message || '排序失败';
      await load();
    }
  } finally {
    busyId.value = '';
  }
}
function toggle(row) {
  collapsed.value = collapsed.value.includes(row.id)
    ? collapsed.value.filter((id) => id !== row.id)
    : [...collapsed.value, row.id];
}
function hasChildren(row) {
  return rows.value.some((child) => child.parentId === row.id);
}
function privateCategory(row) {
  return row.userId !== '0' && !row.templateId;
}
</script>
<template>
  <view class="category-page"
    ><PageHeader
      :title="admin ? '公共分类管理' : '我的分类'"
      back
      @back="uni.navigateBack()" /><MobilePage :refreshing="refreshing" @refresh="load(true)">
      <FormField label="搜索分类" v-model="search" />
      <PageState skeleton="list" :loading="loading" :error="error" :empty="!shown.length" :empty-text="searchQuery ? '未找到匹配分类' : '暂无分类'" @retry="load()">
        <view v-if="searchQuery && !shown.length && !loading && !error" class="category-search-empty">
          <MobileButton label="清空搜索" variant="quiet" @click="search = ''" />
        </view>
        <view
          v-for="row in shown"
          :key="row.id"
          class="category-card ui-card"
          :class="themeClass('category-card')"
        >
          <view class="category-heading ui-row">
            <CategoryIcon :icon="row.icon" :color="row.color" />
            <AppIcon v-if="row.parentId && row.parentId !== '0'" name="lucide:corner-down-right" :size="16" />
            <view class="category-summary">
              <text class="category-name" :class="themeClass('category-name')">{{ row.name }}</text>
              <view class="category-summary-meta">
                <text class="category-type" :class="['category-type-' + (row.timeType || 1), themeClass('category-type-' + (row.timeType || 1))]">{{ types[(row.timeType || 1) - 1] }}</text>
                <text v-if="row.isTrackTime === 1" class="category-meta" :class="themeClass('category-meta')">参与统计</text>
                <text v-if="row.isEnabled === 0" class="category-meta" :class="themeClass('category-meta')">已隐藏</text>
              </view>
            </view>
            <MobileButton
              v-if="hasChildren(row)"
              :label="collapsed.includes(row.id) ? '展开子分类' : '收起子分类'"
              :icon="collapsed.includes(row.id) ? 'ant-design:right-outlined' : 'ant-design:down-outlined'"
              variant="quiet"
              @click="toggle(row)"
            />
          </view>
          <view class="category-actions ui-row"
            ><MobileButton
              label="编辑分类"
              icon="ant-design:edit-outlined"
              variant="quiet"
              :disabled="!!busyId || loading"
              @click="edit(row)" />
            <MobileButton label="更多分类操作" :icon="expandedActions === row.id ? 'ant-design:up-outlined' : 'lucide:ellipsis'" variant="ghost" :aria-expanded="expandedActions === row.id" :disabled="!!busyId || loading" @click="expandedActions = expandedActions === row.id ? '' : row.id" />
          </view>
          <view v-if="expandedActions === row.id" class="category-extra-actions">
            <MobileButton
              v-if="!row.parentId || row.parentId === '0'"
              label="新增子分类"
              icon="ant-design:plus-outlined"
              variant="quiet"
              :disabled="!!busyId || loading"
              @click="edit(null, row.id)" /><MobileButton
              :label="row.isEnabled === 0 ? '恢复分类' : '隐藏分类'"
              :icon="row.isEnabled === 0 ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'"
              variant="quiet"
              :loading="busyId === row.id"
              :disabled="!!busyId || loading"
              @click="change(row, { isEnabled: row.isEnabled === 0 ? 1 : 0 })" /><ConfirmAction
              v-if="admin || privateCategory(row)"
              label="删除分类"
              message="确定删除分类？已有记录或子分类时无法删除。"
              :action="() => remove(row)"
            />
          </view>
        </view>
      </PageState>
      <template #fixed
        ><FloatingActionButton :disabled="loading || !!busyId" @click="edit()"
      /></template>
    </MobilePage>
    <AdaptiveModal
      v-if="opened"
      label="编辑分类"
      :busy="saving"
      :content-key="editorError + showDescription + showColorValue + showIconValue"
      @close="opened = false"
    >
      <view class="category-editor">
        <view class="category-preview" :class="themeClass('category-preview')">
          <CategoryIcon :icon="form.icon" :color="form.color" :size="28" />
          <text class="category-preview-name" :class="themeClass('category-preview-name')">{{ form.name || '新分类' }}</text>
        </view>
        <FormField appearance="soft" :required="isRequired('category', 'name')" label="分类名称" v-model="form.name" :disabled="saving" />
        <FormField
          appearance="soft"
          label="上级分类"
          kind="selector"
          :model-value="parentName"
          :options="parents.map((row) => row.name)"
          :disabled="saving"
          @update:model-value="(value) => (form.parentId = parents.find((row) => row.name === value)?.id || '0')"
        />
        <FormField appearance="soft" :required="isRequired('category', 'color')" label="颜色">
          <template #labelAction>
            <button role="button" class="category-inline-action" :class="themeClass('category-inline-action')" :disabled="saving" :aria-expanded="showColorValue" aria-label="自定义颜色" @click="showColorValue = !showColorValue">
              <view class="category-current-color" :style="{ backgroundColor: form.color }" />
              <AppIcon name="ant-design:edit-outlined" :size="16" />
            </button>
          </template>
          <view class="category-palette">
            <button role="button" v-for="color in colorPresets" :key="color" class="category-color-option" :class="[{ 'category-color-selected': form.color?.toLowerCase() === color }, themeClass('category-color-option')]" :aria-label="'选择颜色 ' + color" :aria-pressed="form.color?.toLowerCase() === color" :disabled="saving" @click="form.color = color">
              <view class="category-color-swatch" :style="{ backgroundColor: color }">
                <AppIcon v-if="form.color?.toLowerCase() === color" name="ant-design:check-outlined" color="#ffffff" :size="16" />
              </view>
            </button>
          </view>
        </FormField>
        <FormField v-if="showColorValue" appearance="soft" label="自定义颜色值" v-model="form.color" placeholder="#1890ff" :disabled="saving" />
        <FormField appearance="soft" label="图标">
          <view class="category-icon-control" :class="themeClass('category-icon-control')">
            <button role="button" class="category-icon-trigger" :disabled="saving" aria-label="选择分类图标" @click="openIconPicker">
              <CategoryIcon :icon="form.icon" :color="form.color" />
              <text class="category-control-text" :class="themeClass('category-control-text')">{{ form.icon ? '更换图标' : '选择图标' }}</text>
              <AppIcon name="ant-design:right-outlined" :size="14" />
            </button>
            <MobileButton label="自定义图标" icon="ant-design:edit-outlined" variant="quiet" :disabled="saving" @click="showIconValue = !showIconValue" />
            <MobileButton v-if="form.icon" label="清除图标" icon="ant-design:close-outlined" variant="quiet" :disabled="saving" @click="form.icon = ''" />
          </view>
        </FormField>
        <FormField v-if="showIconValue" appearance="soft" label="图标名称" v-model="form.icon" placeholder="如 lucide:book-open" :disabled="saving" />
        <FormField
          appearance="soft"
          label="时间类型"
          kind="selector"
          :model-value="types[(form.timeType || 1) - 1]"
          :options="types"
          :disabled="saving"
          @update:model-value="(value) => (form.timeType = types.indexOf(value) + 1)"
        />
        <view class="category-toggle-row">
          <view class="category-toggle" :class="themeClass('category-toggle')">
            <text class="category-toggle-label" :class="themeClass('category-toggle-label')">卡片统计</text>
            <MobileSwitch :checked="form.isTrackTime === 1" :disabled="saving" aria-label="卡片统计" @change="(event) => (form.isTrackTime = event.detail.value ? 1 : 0)" />
          </view>
          <view class="category-toggle" :class="themeClass('category-toggle')">
            <text class="category-toggle-label" :class="themeClass('category-toggle-label')">启用</text>
            <MobileSwitch :checked="form.isEnabled === 1" :disabled="saving" aria-label="启用分类" @change="(event) => (form.isEnabled = event.detail.value ? 1 : 0)" />
          </view>
        </view>
        <button role="button" class="category-description-toggle" :disabled="saving" :aria-expanded="showDescription" aria-label="分类描述" @click="showDescription = !showDescription">
          <text class="category-toggle-label" :class="themeClass('category-toggle-label')">描述</text>
          <text class="category-description-summary" :class="themeClass('category-description-summary')">{{ form.description ? '已填写' : '选填' }}</text>
          <AppIcon :name="showDescription ? 'ant-design:up-outlined' : 'ant-design:down-outlined'" :size="12" />
        </button>
        <FormField v-if="showDescription" appearance="soft" label="描述" hide-label kind="textarea" v-model="form.description" :disabled="saving" />
        <FormField v-if="admin" appearance="soft" label="排序" :model-value="String(form.sort || 0)" input-type="number" :disabled="saving" @update:model-value="(value) => (form.sort = Number(value))" />
        <text v-if="editorError" class="category-error ui-mb-section ui-type-body" role="alert">{{ editorError }}</text>
      </view>
      <FormActions>
        <template v-if="original" #secondary>
          <MobileButton label="上移分类" icon="ant-design:arrow-up-outlined" variant="quiet" :disabled="!!busyId || saving" @click="move(original, -1)" />
          <MobileButton label="下移分类" icon="ant-design:arrow-down-outlined" variant="quiet" :disabled="!!busyId || saving" @click="move(original, 1)" />
        </template>
        <MobileButton label="取消" variant="quiet" :disabled="saving" @click="opened = false" />
        <MobileButton label="保存" :loading="saving" @click="save" />
      </FormActions>
    </AdaptiveModal>
    <AdaptiveModal v-if="opened && iconPickerOpen" label="选择分类图标" show-close :max-width="520" :content-key="iconSearch" @close="iconPickerOpen = false">
      <FormField appearance="soft" label="搜索图标" :model-value="iconSearch" placeholder="输入图标名称，如 book" @update:model-value="(value) => (iconSearch = value)" />
      <view class="category-icon-grid">
        <button role="button" v-for="icon in filteredIcons" :key="icon" class="category-icon-option" :class="[{ 'category-icon-selected': form.icon === icon }, themeClass('category-icon-option')]" :aria-label="'选择图标 ' + icon" :aria-pressed="form.icon === icon" @click="selectIcon(icon)">
          <CategoryIcon :icon="icon" :color="form.color" :size="24" />
        </button>
      </view>
      <text v-if="!filteredIcons.length" class="category-empty" :class="themeClass('category-description-summary')">没有匹配的图标，可返回输入自定义图标名称</text>
    </AdaptiveModal>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.category-page {
  flex: 1;
  height: 100%;
  min-height: 0;
}
.category-card {
  background-color: #ffffff;
  color: #27272a;
  border-radius: 8px;
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: $space-inline;

  overflow: visible;
}
.category-card-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.category-heading {
  flex: 1;
  min-width: 0;
  flex-direction: row;
  gap: $space-inline;
  align-items: center;
}
.category-summary { flex: 1; min-width: 0; gap: $space-detail; }
.category-summary-meta { flex-direction: row; flex-wrap: wrap; align-items: center; gap: $space-inline; }
.category-type { @include type-style('caption'); padding: 0 $space-detail; border-radius: 4px; }
// 与 Web TIME_TYPE_CONFIG 的蓝 / 绿 / 琥珀语义一致，浅底提高列表辨识度。
.category-type-1 { color: #1d4ed8; background-color: #eff6ff; }
.category-type-2 { color: #047857; background-color: #ecfdf5; }
.category-type-3 { color: #92400e; background-color: #fffbeb; }
.category-type-1-dark { color: #93c5fd; background-color: #1e3a5f; }
.category-type-2-dark { color: #6ee7b7; background-color: #064e3b; }
.category-type-3-dark { color: #fcd34d; background-color: #573b16; }
.category-name {
  color: #27272a;
  min-width: 0;
  flex: 1;
  @include type-style('title');
}
.category-name-dark { color: #eeeeef; }
.category-meta {
  color: #808692;
  @include type-style('caption');

}
.category-meta-dark { color: #a0a6b1; }
.category-actions {
  flex-direction: row;
  flex-shrink: 0;
  overflow: visible;
}
.category-extra-actions { width: 100%; flex-direction: row; justify-content: flex-end; gap: $space-inline; }
.category-search-empty { align-items: center; padding-bottom: $space-section; }
.category-error {
  color: #e05260;

}
.category-editor { min-width: 0; }
.category-preview {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  padding: $space-card;
  margin-bottom: $space-form;
  border-radius: 12px;
  background-color: #f2f4f7;
}
.category-preview-dark { background-color: #272a30; }
.category-preview-name {
  @include type-style('title');
  color: #27272a;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.category-preview-name-dark { color: #eeeeef; }
.category-inline-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: $space-inline;
  min-width: $space-controlMin;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0 $space-inline;
  border: 0;
  background-color: transparent;
  color: #707784;
}
.category-inline-action-dark { color: #a0a6b1; }
.category-current-color { width: 16px; height: 16px; border-radius: 50%; }
.category-palette { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-detail; }
.category-color-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  min-width: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 50%;
  background-color: transparent;
}
.category-color-option-dark { background-color: transparent; }
.category-color-selected { border-color: #8995a6; }
.category-color-swatch { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.category-icon-control { display: flex; flex-direction: row; align-items: center; border-radius: 10px; background-color: #f2f4f7; padding-right: $space-detail; }
.category-icon-control-dark { background-color: #272a30; }
.category-icon-trigger { display: flex; flex-direction: row; align-items: center; gap: $space-inline; flex: 1; min-width: 0; min-height: $space-controlMin; margin: 0; padding: 0 $space-card; border: 0; background-color: transparent; }
.category-control-text { @include type-style('body'); color: #27272a; flex: 1; text-align: left; }
.category-control-text-dark { color: #dce0e7; }
.category-toggle-row { display: flex; flex-direction: row; gap: $space-inline; margin-bottom: $space-form; }
.category-toggle { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: $space-detail; flex: 1; min-width: 0; min-height: $space-controlMin; }
.category-toggle-label { @include type-style('label'); color: #707784; }
.category-toggle-label-dark { color: #a0a6b1; }
.category-description-toggle { display: flex; flex-direction: row; align-items: center; gap: $space-inline; min-height: $space-controlMin; margin: 0 0 $space-detail; padding: 0; border: 0; background-color: transparent; }
.category-description-summary { @include type-style('caption'); color: #808692; flex: 1; text-align: right; }
.category-description-summary-dark { color: #a0a6b1; }
.category-icon-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: $space-inline; }
.category-icon-option { display: flex; align-items: center; justify-content: center; width: $space-controlMin; height: $space-controlMin; margin: 0; padding: 0; border: 1px solid transparent; border-radius: 10px; background-color: #f2f4f7; }
.category-icon-option-dark { background-color: #272a30; }
