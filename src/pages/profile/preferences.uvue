<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import { buttonLabelClasses } from '../../services/button-label.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { isRequired } from '../../services/form-required.ts';
import { computed, ref, watch } from 'vue';
import { onLoad, onHide, onShow } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import FormActions from '../../components/FormActions.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { logout, request } from '../../services/api.ts';
import { session, restoreSession } from '../../services/session.ts';
import { clearLifeCatalogCache } from '../../services/life-catalog-cache.ts';
import type { ThemeMode } from '../../services/theme.ts';
import { isDark, themeClass, setThemeMode, theme } from '../../services/theme.ts';
import {
  flattenMenuOptions,
  passwordPayload,
} from '../../services/preferences-contract.ts';
const titles = {
  general: '设置',
  password: '修改密码',
  menus: '菜单显示',
  system: '系统设置',
};
const mode = ref('general');
const supportLinks = [
  { title: '隐私政策', path: '/pages/auth/policy?kind=privacy', icon: 'mdi:shield-account-outline' },
  { title: '服务条款', path: '/pages/auth/policy?kind=terms', icon: 'lucide:file-text' },
  { title: '关于', path: '/pages/about/index', icon: 'lucide:copyright' },
  { title: '反馈', path: '/pages/records/feedback', icon: 'ant-design:comment-outlined' },
];
const themePickerOpen = ref(false);
const leaving = ref(false);
const confirmLogout = ref(false);
const themeLabel = computed(() => ({ system: '跟随系统', light: '浅色', dark: '深色' })[theme.mode]);
async function signOut() {
  if (leaving.value) return;
  leaving.value = true;
  try { await logout(); }
  catch (_) { uni.showToast({ title: '已退出本机，服务端会话退出未完成', icon: 'none' }); }
  finally { uni.reLaunch({ url: '/pages/login/index' }); leaving.value = false; }
}
const themeOptions: { label: string; value: ThemeMode }[] = [
  { label: '跟随系统', value: 'system' },
  { label: '浅色', value: 'light' },
  { label: '深色', value: 'dark' },
];
function openPage(path: string) {
  uni.navigateTo({ url: path });
}
function changeTheme(mode: ThemeMode) {
  try {
    setThemeMode(mode);
    themePickerOpen.value = false;
  } catch (error) {
    uni.showToast({ title: error.message, icon: 'none' });
  }
}
const title = computed(() => titles[mode.value] || '设置');
const loading = ref(false),
  saving = ref(false),
  ready = ref(false),
  error = ref(''),
  formError = ref('');
const menuItems = ref<any[]>([]),
  menuRoots = ref<any[]>([]),
  hidden = ref<string[]>([]),
  menuQuery = ref(''),
  collapsedMenuGroups = ref<string[]>([]);
const menuGroups = computed(() => {
  const query = menuQuery.value.trim().toLowerCase();
  return menuRoots.value.map((root) => {
    const grouped = !!root.children?.length;
    const items = flattenMenuOptions(grouped ? root.children : [root], grouped ? [root.title] : [])
      .map((item) => ({ ...item, label: grouped ? item.title.slice(root.title.length + 3) : item.title }))
      .filter((item) => !query || item.title.toLowerCase().includes(query));
    return { id: root.id, title: grouped ? root.title : '', items };
  }).filter((group) => group.items.length);
});
function toggleMenuGroup(id: string) {
  collapsedMenuGroups.value = collapsedMenuGroups.value.includes(id)
    ? collapsedMenuGroups.value.filter((value) => value !== id)
    : [...collapsedMenuGroups.value, id];
}
const form = ref<any>({ oldPassword: '', password: '', confirm: '' });
let revision = 0,
  active = true;
watch(
  () => session.token,
  () => {
    revision++;
    menuItems.value = [];
    menuRoots.value = [];
    menuQuery.value = '';
    collapsedMenuGroups.value = [];
    hidden.value = [];
    resetPasswordForm();
    ready.value = false;
    error.value = '';
  },
  { flush: 'sync' },
);
onLoad((options) => {
  mode.value = Object.keys(titles).includes(options?.section || '') ? options.section : 'general';
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['menu', 'user', 'users'] })
onShow(() => {
  active = true;
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
onHide(() => {
  active = false;
  confirmLogout.value = false;
  themePickerOpen.value = false;
  revision++;
  resetPasswordForm();
  loading.value = false;
});
async function load() {
  const version = ++revision,
    token = session.token;
  loading.value = true;
  error.value = '';
  try {
    if (mode.value === 'menus') {
      const data: any = await request('/menu/preferences?client=mobile');
      const flat = flattenMenuOptions(data.menus, [], false, data.hiddenMenuIds);
      if (!active || version !== revision || token !== session.token) return;
      menuItems.value = flat;
      menuRoots.value = data.menus;
      hidden.value = flat.filter((x) => x.hidden).map((x) => x.id);
    }
    if (version === revision && active) ready.value = true;
  } catch (reason) {
    if (version === revision && active) {
      error.value = reason.message;
      if (!session.token) uni.reLaunch({ url: '/pages/login/index' });
    }
  } finally {
    if (version === revision) loading.value = false;
  }
}
function resetPasswordForm() {
  formError.value = '';
  form.value = { oldPassword: '', password: '', confirm: '' };
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const token = session.token,
    version = revision;
  try {
    if (mode.value === 'password')
      await request('/auth/change-password', 'POST', passwordPayload(form.value));
    if (!active || token !== session.token || version !== revision) return;
    resetPasswordForm();
    uni.showToast({ title: '密码修改成功', icon: 'success' });
  } catch (reason) {
    if (active && token === session.token && version === revision) formError.value = reason.message;
  } finally {
    saving.value = false;
  }
}
function toggle(id) {
  if (saving.value) return;
  hidden.value = hidden.value.includes(id)
    ? hidden.value.filter((x) => x !== id)
    : [...hidden.value, id];
}
async function saveMenus() {
  if (saving.value || !ready.value) return;
  saving.value = true;
  error.value = '';
  try {
    const token = session.token;
    await request('/menu/preferences?client=mobile', 'PUT', { menuIds: hidden.value });
    if (!active || token !== session.token) return;
    uni.showToast({ title: '已保存', icon: 'success' });
  } catch (reason) {
    error.value = reason.message;
  } finally {
    saving.value = false;
  }
}
async function resetMenus() {
  await request('/menu/preferences?client=mobile', 'DELETE');
  await load();
}
async function clearCache() {
  clearLifeCatalogCache();
  const keys = uni.getStorageInfoSync().keys;
  for (const key of keys)
    if (
      key.startsWith('aio-life-mobile.') &&
      !['aio-life-mobile.access-token.v1', 'aio-life-mobile.theme.v1'].includes(key) &&
      !key.includes('password-vault')
    )
      uni.removeStorageSync(key);
  uni.reLaunch({ url: '/pages/home/index' });
}
function back() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/profile/index' }) });
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader :title="title" back :actions-min-width="mode === 'menus' ? 96 : 0" @back="back">
      <template v-if="mode === 'menus'" #actions>
        <ConfirmAction
          label="恢复默认菜单"
          message="恢复全部菜单的默认显示设置？"
          :action="resetMenus"
          v-if="ready && !loading && !saving"
          icon="ant-design:undo-outlined"
          :danger="false"
        />
        <MobileButton label="保存" icon="ant-design:check-outlined" variant="ghost" :loading="saving" :disabled="!ready || loading" @click="saveMenus" />
      </template>
    </PageHeader>
    <MobilePage :refreshing="loading" @refresh="load">
      <view v-if="mode === 'general'" class="ui-page-body ui-gap-section">
        <view class="preference-surface ui-pad-card" :class="themeClass('preference-surface')">
          <button role="button" class="settings-entry" aria-label="外观" @click="themePickerOpen = true">
            <AppIcon name="lucide:moon" /><text class="entry-label" :class="themeClass('entry-label')">外观</text><text class="theme-value" :class="themeClass('theme-value')">{{ themeLabel }}</text><AppIcon name="ant-design:right-outlined" :size="16" />
          </button>
          <button v-for="entry in supportLinks" :key="entry.path" role="button" class="settings-entry" :aria-label="entry.title" @click="openPage(entry.path)">
            <AppIcon :name="entry.icon" /><text class="entry-label" :class="themeClass('entry-label')">{{ entry.title }}</text><AppIcon name="ant-design:right-outlined" :size="16" />
          </button>
        </view>
        <view class="signout-anchor">
          <view
            v-if="confirmLogout"
            class="signout-confirm"
            :class="themeClass('signout-confirm')"
            role="alertdialog"
            aria-label="退出当前账号？"
            ><text class="signout-message" :class="themeClass('signout-message')"
              >退出当前账号？</text
            ><view class="signout-actions"
              ><MobileButton
                label="取消"
                compact
                variant="quiet"
                :disabled="leaving"
                @click="confirmLogout = false"
              /><MobileButton
                label="退出"
                compact
                :danger="true"
                :loading="leaving"
                @click="signOut"
              /></view
            ><view class="signout-arrow" :class="themeClass('signout-arrow')" /></view
          >
          <button
            role="button"
            class="signout-button"
            :aria-expanded="confirmLogout"
            :disabled="leaving" :aria-disabled="leaving"
            @click="confirmLogout = !confirmLogout"
            :class="themeClass('signout-button')"
          ><AppIcon name="ant-design:export-outlined" :color="isDark ? '#ed9191' : '#c65353'" /><text :class="buttonLabelClasses(['signout-button', themeClass('signout-button')])">退出登录</text></button>
        </view>
      </view>
      <PageState v-else skeleton="form" :loading="loading" :error="error" @retry="load">
        <view v-if="mode === 'password'" class="ui-page-body">
          <view class="preference-surface ui-card" :class="themeClass('preference-surface')" role="form" aria-label="修改密码">
            <FormField :required="isRequired('password', 'oldPassword')" label="旧密码" kind="password" v-model="form.oldPassword" :disabled="saving" />
            <FormField :required="isRequired('password', 'password')" label="新密码" kind="password" v-model="form.password" :disabled="saving" />
            <FormField :required="isRequired('password', 'confirm')" label="确认密码" kind="password" v-model="form.confirm" :disabled="saving" />
            <text v-if="formError" class="error-text" role="alert">{{ formError }}</text>
            <FormActions>
              <MobileButton label="取消" variant="quiet" :disabled="saving" @click="back" />
              <MobileButton label="保存" :loading="saving" @click="save" />
            </FormActions>
          </view>
        </view>
        <view v-if="mode === 'menus' && ready" class="ui-page-body ui-gap-section">
          <FormField label="搜索菜单" placeholder="搜索菜单" v-model="menuQuery" compact />
          <view v-for="group in menuGroups" :key="group.id" class="preference-surface ui-pad-card" :class="themeClass('preference-surface')">
            <button v-if="group.title" role="button" class="menu-group-toggle" :aria-label="(collapsedMenuGroups.includes(group.id) && !menuQuery.trim() ? '展开' : '收起') + group.title" :aria-expanded="!!menuQuery.trim() || !collapsedMenuGroups.includes(group.id)" @click="toggleMenuGroup(group.id)">
              <text class="menu-group-title" :class="themeClass('menu-group-title')">{{ group.title }}</text>
              <AppIcon :name="collapsedMenuGroups.includes(group.id) && !menuQuery.trim() ? 'ant-design:right-outlined' : 'ant-design:down-outlined'" :size="16" />
            </button>
            <view v-if="!group.title || menuQuery.trim() || !collapsedMenuGroups.includes(group.id)">
              <view v-for="item in group.items" :key="item.id" class="preference-row ui-row">
                <text class="preference-name" :class="themeClass('preference-name')">{{ item.label }}</text>
                <MobileSwitch :checked="!hidden.includes(item.id)" :disabled="saving" :aria-label="'显示' + item.title" @change="toggle(item.id)" />
              </view>
            </view>
          </view>
          <view v-if="!menuGroups.length" class="menu-empty">
            <text class="preference-name" :class="themeClass('preference-name')">{{ menuQuery.trim() ? '未找到匹配菜单' : '暂无可配置菜单' }}</text>
            <MobileButton v-if="menuQuery.trim()" label="清空搜索" variant="ghost" @click="menuQuery = ''" />
          </view>
        </view>
        <view
          v-if="mode === 'system'"
          class="preference-surface ui-card"
          :class="themeClass('preference-surface')"
        >
          <FormField
            label="主题"
            kind="selector"
            :options="['跟随系统', '浅色', '深色']"
            :model-value="
              ['跟随系统', '浅色', '深色'][['system', 'light', 'dark'].indexOf(theme.mode)]
            "
            @update:model-value="
              (v) =>
                setThemeMode(['system', 'light', 'dark'][['跟随系统', '浅色', '深色'].indexOf(v)])
            "
          />
          <view class="preference-row ui-row"
            ><text class="preference-name">清除缓存</text
            ><ConfirmAction
              label="清除缓存"
              message="清除本机显示缓存并返回首页，保留登录状态和主题。"
              :action="clearCache"
              icon="ant-design:undo-outlined"
          /></view>
        </view>
      </PageState>
    </MobilePage>
    <AdaptiveModal v-if="themePickerOpen" label="外观" :max-width="360" :show-close="true" @close="themePickerOpen = false">
      <button v-for="option in themeOptions" :key="option.value" role="button" class="theme-option" :aria-label="option.label" :aria-pressed="theme.mode === option.value" @click="changeTheme(option.value)">
        <text class="entry-label" :class="themeClass('entry-label')">{{ option.label }}</text><AppIcon v-if="theme.mode === option.value" name="ant-design:check-outlined" />
      </button>
    </AdaptiveModal>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.settings-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: $space-controlMin + $space-detail;
  gap: $space-section;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
.entry-label { flex: 1; text-align: left; @include type-style('body'); color: #27272a; }
.entry-label-dark { color: #eeeeef; }
.theme-value { @include type-style('caption'); color: #71717a; }
.theme-value-dark { color: #9c9ca6; }
.theme-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: $space-controlMin;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
.signout-button,
.settings-entry,
.theme-option { @include borderless-button; }

.preference-surface {
  background-color: #fff;
  color: #27272a;
  border-radius: 14px;

}
.preference-surface-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.preference-row {
  flex-direction: row;
  align-items: center;
  min-height: 52px;

}
.preference-name {
  flex: 1;
  min-width: 0;
  @include type-style('body');
  color: #27272a;
}
.preference-name-dark { color: #eeeeef; }
.menu-group-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0;
  gap: $space-inline;
  background-color: transparent;
  border: 0;
}
.menu-group-title { flex: 1; text-align: left; @include type-style('body-strong'); color: #27272a; }
.menu-group-title-dark { color: #eeeeef; }
.menu-empty { align-items: center; gap: $space-inline; padding: $space-section; }
.menu-group-toggle { @include borderless-button; }
.preference-actions {
  flex-direction: row;

  align-items: center;

}
.signout-anchor {
  position: relative;
  // 提升整个锚点层级，让向上展开的确认框覆盖前一张菜单卡片。
  z-index: 3;
  overflow: visible;
}
.signout-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: $space-controlMin + $space-detail;
  gap: $space-inline;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14px;
  background-color: #ffffff;
  color: #c65353;
  @include type-style('body');
  line-height: type-leading('tallControl');
}
.signout-confirm {
  position: absolute;
  bottom: calc(100% + $space-inline);
  z-index: 2;
  left: 50%;
  transform: translateX(-50%);
  // 限制浮层宽度，手机与宽屏都保持紧凑，并避免窄屏溢出。
  width: 264px;

@include shrink-content;

  box-sizing: border-box;
  overflow: visible;
  padding: $space-modal;
  // 按钮自带透明触摸边缘，底部只留细节间距，避免留白叠加。
  padding-bottom: $space-detail;
  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
}
.signout-message {
  @include type-style('body-strong');
  color: #27272a;
}
.signout-message-dark { color: #eeeeef; }
.signout-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: $space-inline;
  margin-top: $space-section;
}
.signout-arrow {
  // 小箭头是定位几何，指向下方退出入口。
  position: absolute;
  bottom: -5px;
  left: 50%;
  width: 10px;
  height: 10px;
  transform: translateX(-50%) rotate(45deg);
  background-color: #ffffff;
}

.signout-button-dark {
  background-color: #1c1e22;
}
.signout-button-dark {
  color: #ed9191;
}
.signout-confirm-dark {
  color: #eeeeef;
  background-color: #303238;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.32);
}
.signout-arrow-dark {
  background-color: #303238;
}

.signout-button-label { color: #c65353; @include type-style('body'); }
.signout-button-dark-label { color: #ed9191; }
</style>
