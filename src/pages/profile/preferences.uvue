<script setup lang="ts">
import { isRequired, missingRequired } from '../../services/form-required.ts';
import { computed, ref, watch } from 'vue';
import { onLoad, onHide, onShow } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { request } from '../../services/api.ts';
import { session, restoreSession } from '../../services/session.ts';
import { clearLifeCatalogCache } from '../../services/life-catalog-cache.ts';
import { themeClass, setThemeMode, theme } from '../../services/theme.ts';
import {
  flattenMenuOptions,
  passwordPayload,
  llmPayload,
} from '../../services/preferences-contract.ts';
const titles = {
  password: '修改密码',
  menus: '菜单显示',
  keys: 'API Key',
  llm: '大模型配置',
  system: '系统设置',
};
const mode = ref('password');
const title = computed(() => titles[mode.value] || '设置');
const loading = ref(false),
  saving = ref(false),
  ready = ref(false),
  error = ref(''),
  formError = ref(''),
  editing = ref(false);
const items = ref<any[]>([]),
  menuItems = ref<any[]>([]),
  hidden = ref<string[]>([]);
const generatedKey = ref('');
const form = ref<any>({});
let revision = 0,
  active = true;
const expiry = ['永不过期', '1 天', '7 天', '30 天'];
const presetNames = [
  '自定义',
  'OpenAI',
  'DeepSeek',
  '硅基流动',
  '阿里百炼',
  'Kimi',
  'MiniMax',
  '美团',
  '魔搭',
  'Ollama',
];
const presets = [
  null,
  ['gpt-4o', 'https://api.openai.com/v1'],
  ['deepseek-chat', 'https://api.deepseek.com'],
  ['deepseek-ai/DeepSeek-V3', 'https://api.siliconflow.cn/v1'],
  ['qwen-plus', 'https://dashscope.aliyuncs.com/compatible-mode/v1'],
  ['moonshot-v1-8k', 'https://api.moonshot.cn/v1'],
  ['MiniMax-M2.7', 'https://api.minimaxi.com/v1'],
  ['LongCat-Flash-Chat', 'https://api.longcat.chat/openai'],
  ['qwen-max', 'https://api-inference.modelscope.cn/v1'],
  ['llama3.2', 'http://localhost:11434/v1'],
];
function usePreset(name) {
  form.value.preset = name;
  const p = presets[presetNames.indexOf(name)];
  if (p) {
    form.value.modelName = p[0];
    form.value.baseUrl = p[1];
  }
}
watch(
  () => session.token,
  () => {
    revision++;
    items.value = [];
    menuItems.value = [];
    hidden.value = [];
    form.value = {};
    generatedKey.value = '';
    editing.value = false;
    ready.value = false;
    error.value = '';
    formError.value = '';
  },
  { flush: 'sync' },
);
onLoad((options) => {
  mode.value = Object.keys(titles).includes(options?.section || '') ? options.section : 'password';
});
onShow(() => {
  active = true;
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  load();
});
onHide(() => {
  active = false;
  revision++;
  editing.value = false;
  generatedKey.value = '';
  form.value = {};
  ready.value = false;
});
async function load() {
  const version = ++revision,
    token = session.token;
  loading.value = true;
  error.value = '';
  try {
    if (mode.value === 'menus') {
      const data: any = await request('/menu/preferences');
      const flat = flattenMenuOptions(data.menus, [], false, data.hiddenMenuIds);
      if (!active || version !== revision || token !== session.token) return;
      menuItems.value = flat;
      hidden.value = flat.filter((x) => x.hidden).map((x) => x.id);
    } else if (mode.value === 'keys' || mode.value === 'llm') {
      const data: any = await request(mode.value === 'keys' ? '/api-key/list' : '/llm/key/list');
      if (!Array.isArray(data)) throw new Error('列表数据异常');
      if (!active || version !== revision || token !== session.token) return;
      items.value = data;
    }
    if (version === revision && active) ready.value = true;
  } catch (reason) {
    if (version === revision && active) {
      error.value = reason.message;
      if (!session.token) uni.reLaunch({ url: '/pages/login/index' });
    }
  } finally {
    if (version === revision) loading.value = false;
  }
}
function edit(row = null) {
  formError.value = '';
  form.value =
    mode.value === 'password'
      ? { oldPassword: '', password: '', confirm: '' }
      : mode.value === 'keys'
        ? { remark: '', expiry: expiry[0] }
        : {
            id: row?.id || '',
            modelName: row?.modelName || '',
            baseUrl: row?.baseUrl || '',
            apiKey: '',
            isDefault: row?.isDefault === 1,
            preset: '自定义',
          };
  editing.value = true;
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const token = session.token,
    version = revision;
  try {
    if (mode.value === 'password')
      await request('/auth/change-password', 'POST', passwordPayload(form.value));
    else if (mode.value === 'keys') {
      if (missingRequired('apiKey', form.value)) throw new Error('请输入备注');
      const data: any = await request('/api-key/generate', 'POST', {
        remark: form.value.remark.trim(),
        expireDays: [0, 1, 7, 30][expiry.indexOf(form.value.expiry)],
      });
      if (!data?.apiKey) throw new Error('生成结果异常');
      if (active && token === session.token && version === revision)
        generatedKey.value = data.apiKey;
    } else if (mode.value === 'llm')
      await request('/llm/key', form.value.id ? 'PUT' : 'POST', llmPayload(form.value));
    if (!active || token !== session.token || version !== revision) return;
    editing.value = false;
    form.value = {};
    await load();
  } catch (reason) {
    if (active && token === session.token) formError.value = reason.message;
  } finally {
    saving.value = false;
  }
}
async function remove(row) {
  const token = session.token;
  await request(
    (mode.value === 'keys' ? '/api-key/' : '/llm/key/') + encodeURIComponent(row.id),
    'DELETE',
  );
  if (token === session.token && active) items.value = items.value.filter((x) => x.id !== row.id);
}
const defaultBusy = ref('');
async function setDefault(row) {
  if (defaultBusy.value) return;
  defaultBusy.value = row.id;
  const token = session.token,
    v = revision;
  try {
    await request('/llm/key/default/' + encodeURIComponent(row.id), 'PUT');
    if (!active || token !== session.token || v !== revision) return;
    items.value = items.value.map((x) => ({ ...x, isDefault: x.id === row.id ? 1 : 0 }));
  } catch (reason) {
    error.value = reason.message;
  } finally {
    defaultBusy.value = '';
  }
}
function toggle(id) {
  if (saving.value) return;
  hidden.value = hidden.value.includes(id)
    ? hidden.value.filter((x) => x !== id)
    : [...hidden.value, id];
}
async function saveMenus() {
  if (saving.value || !ready.value) return;
  saving.value = true;
  error.value = '';
  try {
    const token = session.token;
    await request('/menu/preferences', 'PUT', { menuIds: hidden.value });
    if (!active || token !== session.token) return;
    uni.showToast({ title: '已保存', icon: 'success' });
  } catch (reason) {
    error.value = reason.message;
  } finally {
    saving.value = false;
  }
}
async function resetMenus() {
  await request('/menu/preferences', 'DELETE');
  await load();
}
async function clearCache() {
  clearLifeCatalogCache();
  const keys = uni.getStorageInfoSync().keys;
  for (const key of keys)
    if (
      key.startsWith('aio-life-mobile.') &&
      !['aio-life-mobile.access-token.v1', 'aio-life-mobile.theme.v1'].includes(key) &&
      !key.includes('password-vault')
    )
      uni.removeStorageSync(key);
  uni.reLaunch({ url: '/pages/home/index' });
}
function mask(value) {
  const s = String(value || '');
  return s.length > 12 ? s.slice(0, 8) + '…' + s.slice(-4) : '••••••••';
}
function back() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/profile/index' }) });
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader :title="title" back @back="back" />
    <MobilePage :refreshing="loading" @refresh="load">
      <PageState skeleton="form" :loading="loading" :error="error" @retry="load">
        <view
          v-if="mode === 'password'"
          class="preference-surface ui-card"
          :class="themeClass('preference-surface')"
          ><MobileButton label="修改密码" @click="edit()"
        /></view>
        <view
          v-if="mode === 'menus' && ready"
          class="preference-surface ui-card"
          :class="themeClass('preference-surface')"
        >
          <view v-for="item in menuItems" :key="item.id" class="preference-row ui-row"
            ><text class="preference-name">{{ item.title }}</text
            ><switch
              :checked="!hidden.includes(item.id)"
              :disabled="saving"
              :aria-label="'显示' + item.title"
              @change="toggle(item.id)"
          /></view>
          <view class="preference-actions ui-row ui-mt-section"
            ><MobileButton label="保存" :loading="saving" @click="saveMenus" /><ConfirmAction
              label="恢复默认菜单"
              message="恢复全部菜单的默认显示设置？"
              :action="resetMenus"
              icon="ant-design:undo-outlined"
              :danger="false"
          /></view>
        </view>
        <view v-if="mode === 'keys' || mode === 'llm'" class="preference-list ui-page-body">
          <MobileButton label="新增" icon="ant-design:plus-outlined" :disabled="!ready" @click="edit()" />
          <PageState :empty="ready && !items.length" />
          <view
            v-for="item in items"
            :key="item.id"
            class="preference-surface ui-card"
            :class="themeClass('preference-surface')"
          >
            <text class="preference-title">{{
              mode === 'keys' ? item.remark : item.modelName
            }}</text
            ><text class="preference-detail" :class="themeClass('preference-detail')">{{ mode === 'llm' ? (item.hasApiKey ? '******' : '') : mask(item.apiKey) }}</text>
            <text v-if="mode === 'keys'" class="preference-detail" :class="themeClass('preference-detail')"
              >{{ item.expiredAt || '永不过期' }} · {{ item.createTime }}</text
            >
            <text v-else class="preference-detail" :class="themeClass('preference-detail')">{{ item.baseUrl }}</text>
            <view class="preference-actions ui-row ui-mt-section"
              ><MobileButton
                v-if="mode === 'llm'"
                label="编辑"
                icon="ant-design:edit-outlined"
                variant="quiet"
                @click="edit(item)" /><MobileButton
                v-if="mode === 'llm'"
                :label="item.isDefault === 1 ? '默认模型' : '设为默认'"
                :icon="item.isDefault === 1 ? 'ant-design:star-filled' : 'ant-design:star-outlined'"
                variant="quiet"
                :disabled="item.isDefault === 1 || !!defaultBusy"
                :loading="defaultBusy === item.id"
                @click="setDefault(item)" /><ConfirmAction
                label="删除"
                :message="'删除' + (item.remark || item.modelName) + '？'"
                :action="() => remove(item)"
            /></view>
          </view>
        </view>
        <view
          v-if="mode === 'system'"
          class="preference-surface ui-card"
          :class="themeClass('preference-surface')"
        >
          <FormField
            label="主题"
            kind="selector"
            :options="['跟随系统', '浅色', '深色']"
            :model-value="
              ['跟随系统', '浅色', '深色'][['system', 'light', 'dark'].indexOf(theme.mode)]
            "
            @update:model-value="
              (v) =>
                setThemeMode(['system', 'light', 'dark'][['跟随系统', '浅色', '深色'].indexOf(v)])
            "
          />
          <view class="preference-row ui-row"
            ><text class="preference-name">清除缓存</text
            ><ConfirmAction
              label="清除缓存"
              message="清除本机显示缓存并返回首页，保留登录状态和主题。"
              :action="clearCache"
              icon="ant-design:undo-outlined"
          /></view>
        </view>
      </PageState>
    </MobilePage>
    <AdaptiveModal
      v-if="editing"
      :label="title"
      :busy="saving"
      :max-width="520"
      @close="editing = false"
    >
      <view v-if="mode === 'password'"
        ><FormField :required="isRequired('password', 'oldPassword')" label="旧密码" kind="password" v-model="form.oldPassword" /><FormField :required="isRequired('password', 'password')"
          label="新密码"
          kind="password"
          v-model="form.password" /><FormField :required="isRequired('password', 'confirm')"
          label="确认密码"
          kind="password"
          v-model="form.confirm"
      /></view>
      <view v-if="mode === 'keys'"
        ><FormField :required="isRequired('apiKey', 'remark')" label="备注" v-model="form.remark" /><FormField
          label="有效期"
          kind="selector"
          :options="expiry"
          v-model="form.expiry"
      /></view>
      <view v-if="mode === 'llm'"
        ><FormField
          label="服务商"
          kind="selector"
          :options="presetNames"
          :model-value="form.preset"
          @update:model-value="usePreset" /><FormField :required="isRequired('llm', 'modelName', form)"
          label="模型名称"
          v-model="form.modelName" /><FormField :required="isRequired('llm', 'baseUrl', form)" label="接口地址" v-model="form.baseUrl" /><FormField :required="isRequired('llm', 'apiKey', form)"
          label="API Key"
          kind="password"
          v-model="form.apiKey"
          :placeholder="form.id ? '留空保留原密钥' : ''" /><view class="preference-row ui-row"
          ><text class="preference-field-label" :class="themeClass('preference-field-label')">默认模型</text
          ><switch
            :checked="form.isDefault"
            aria-label="默认模型"
            @change="form.isDefault = $event.detail.value" /></view
      ></view>
      <text v-if="formError" class="error-text" role="alert">{{ formError }}</text
      ><MobileButton label="保存" :loading="saving" @click="save" />
    </AdaptiveModal>
    <AdaptiveModal
      v-if="generatedKey"
      label="新 API Key"
      :max-width="520"
      @close="generatedKey = ''"
    >
      <text class="preference-detail" :class="themeClass('preference-detail')">仅本次显示完整密钥，请妥善保存。</text
      ><text class="preference-secret ui-mb-section ui-mt-section" selectable>{{ generatedKey }}</text
      ><MobileButton label="复制" icon="ant-design:copy-outlined" @click="uni.setClipboardData({ data: generatedKey })" />
    </AdaptiveModal>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.preference-list {

}
.preference-surface {
  background-color: #fff;
  color: #27272a;
  border-radius: 14px;

}
.preference-surface-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.preference-row {
  flex-direction: row;
  align-items: center;
  min-height: 52px;

}
.preference-name {
  flex: 1;
  @include type-style('body');
}
.preference-actions {
  flex-direction: row;

  align-items: center;

}
.preference-title {
  @include type-style('title');

}
.preference-detail {
  @include type-style('label');

  color: $text-secondary-light;
}
.preference-secret {
  @include type-style('body');

  word-break: break-all;

}

.preference-detail-dark {
  color: $text-secondary-dark;
}
.preference-field-label {
  @include type-style('label');
  color: #27272a;
}
.preference-field-label-dark {
  color: #eeeeef;
}
</style>
