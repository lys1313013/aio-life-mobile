<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import { buttonLabelClasses } from '../../services/button-label.ts';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { isRequired } from '../../services/form-required.ts';
import { computed, ref, watch } from 'vue';
import { onLoad, onHide, onShow, onUnload } from '@dcloudio/uni-app';
import PageSearch from '../../components/PageSearch.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import FormActions from '../../components/FormActions.uvue';
import PageState from '../../components/PageState.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import { logout, request } from '../../services/api.ts';
import { session, restoreSession } from '../../services/session.ts';
import { clearClientData } from '../../services/client-reset.ts';
import { isThemeDark, themeClass, themePalette, setThemeMode } from '../../services/theme.ts';
import { themeTransitionDuration } from '../../services/theme-transition.ts';
import { useWeixinThemeReveal } from './weixin-theme-reveal.ts';
// #ifdef MP-WEIXIN
import { secondaryLock } from '../../services/secondary-lock.ts';
// #endif
// #ifndef MP-WEIXIN
import { animateThemeChange } from '../../services/theme-transition.ts';
// #endif
import {
  flattenMenuOptions,
  passwordPayload,
} from '../../services/preferences-contract.ts';
const titles = {
  general: '设置',
  password: '修改密码',
  menus: '菜单显示',
  system: '系统设置',
};
const mode = ref('general');
const supportLinks = [
  { title: '数据导出', path: '/pages/data-export/index', icon: 'ant-design:download-outlined' },
  { title: '反馈', path: '/pages/records/feedback', icon: 'ant-design:comment-outlined' },
  { title: '隐私政策', path: '/pages/auth/policy?kind=privacy', icon: 'mdi:shield-account-outline' },
  { title: '服务条款', path: '/pages/auth/policy?kind=terms', icon: 'lucide:file-text' },
  { title: '关于', path: '/pages/about/index', icon: 'lucide:copyright' },
];
const leaving = ref(false);
const confirmLogout = ref(false);
async function signOut() {
  if (leaving.value) return;
  leaving.value = true;
  try { await logout(); }
  catch (_) { uni.showToast({ title: '已退出本机，服务端会话退出未完成', icon: 'none' }); }
  finally { uni.reLaunch({ url: '/pages/login/index' }); leaving.value = false; }
}
function openPage(path: string) {
  uni.navigateTo({ url: path });
}
const themeChanging = ref(false);
const { revealMode, revealTheme, finishReveal } = useWeixinThemeReveal();
const themeLayers = computed(() => {
  // 微信的子组件需要收到显式主题值，避免移除属性时保留上一帧的颜色。
  let liveAppearance: 'light' | 'dark' | undefined;
  // #ifdef MP-WEIXIN
  liveAppearance = revealMode.value || isThemeDark() ? 'dark' : 'light';
  // #endif
  const live = { id: 'live', preview: false, appearance: liveAppearance };
  return revealMode.value ? [live, { id: 'preview', preview: true, appearance: 'light' as const }] : [live];
});
const revealStyle = { '--settings-theme-duration': themeTransitionDuration + 'ms' };
let settingsScrollTop = 0;
function rememberSettingsScroll(event: { detail: { scrollTop: number } }) {
  settingsScrollTop = Math.max(0, event.detail.scrollTop);
}
// #ifdef MP-WEIXIN
watch(() => secondaryLock.visible, visible => { if (visible) finishReveal(); }, { flush: 'sync' });
onUnload(finishReveal);
// #endif
async function changeTheme(event: { detail: { value: boolean } }) {
  if (!active || themeChanging.value) return;
  const appearance = event.detail.value ? 'dark' : 'light';
  const update = () => setThemeMode(appearance);
  themeChanging.value = true;
  try {
    // #ifdef MP-WEIXIN
    await revealTheme(appearance, update);
    // #endif
    // #ifndef MP-WEIXIN
    await animateThemeChange(update);
    // #endif
  } catch (error) {
    uni.showToast({ title: error.message || '切换失败，请重试', icon: 'none' });
  } finally {
    themeChanging.value = false;
  }
}
const title = computed(() => titles[mode.value] || '设置');
const loading = ref(false),
  saving = ref(false),
  ready = ref(false),
  error = ref(''),
  formError = ref('');
const menuItems = ref<any[]>([]),
  menuRoots = ref<any[]>([]),
  hidden = ref<string[]>([]),
  menuQuery = ref(''),
  searchOpen = ref(false),
  collapsedMenuGroups = ref<string[]>([]);
const menuGroups = computed(() => {
  const query = menuQuery.value.trim().toLowerCase();
  return menuRoots.value.map((root) => {
    const grouped = !!root.children?.length;
    const items = flattenMenuOptions(grouped ? root.children : [root], grouped ? [root.title] : [])
      .map((item) => ({ ...item, label: grouped ? item.title.slice(root.title.length + 3) : item.title }))
      .filter((item) => !query || item.title.toLowerCase().includes(query));
    return { id: root.id, title: grouped ? root.title : '', items };
  }).filter((group) => group.items.length);
});
function toggleMenuGroup(id: string) {
  collapsedMenuGroups.value = collapsedMenuGroups.value.includes(id)
    ? collapsedMenuGroups.value.filter((value) => value !== id)
    : [...collapsedMenuGroups.value, id];
}
const form = ref<any>({ oldPassword: '', password: '', confirm: '' });
let revision = 0,
  active = true;
watch(
  () => session.token,
  () => {
    // #ifdef MP-WEIXIN
    finishReveal();
    // #endif
    revision++;
    menuItems.value = [];
    menuRoots.value = [];
    menuQuery.value = '';
    collapsedMenuGroups.value = [];
    hidden.value = [];
    resetPasswordForm();
    ready.value = false;
    error.value = '';
  },
  { flush: 'sync' },
);
onLoad((options) => {
  mode.value = Object.keys(titles).includes(options?.section || '') ? options.section : 'general';
});
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['menu', 'user', 'users'] })
onShow(() => {
  active = true;
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
onHide(() => {
  active = false;
  // #ifdef MP-WEIXIN
  finishReveal();
  // #endif
  confirmLogout.value = false;
  revision++;
  resetPasswordForm();
  loading.value = false;
});
async function load() {
  const version = ++revision,
    token = session.token;
  loading.value = true;
  error.value = '';
  try {
    if (mode.value === 'menus') {
      const data: any = await request('/menu/preferences?client=mobile');
      const flat = flattenMenuOptions(data.menus, [], false, data.hiddenMenuIds);
      if (!active || version !== revision || token !== session.token) return;
      menuItems.value = flat;
      menuRoots.value = data.menus;
      hidden.value = flat.filter((x) => x.hidden).map((x) => x.id);
    }
    if (version === revision && active) ready.value = true;
  } catch (reason) {
    if (version === revision && active) {
      error.value = reason.message;
      if (!session.token) uni.reLaunch({ url: '/pages/login/index' });
    }
  } finally {
    if (version === revision) loading.value = false;
  }
}
function resetPasswordForm() {
  formError.value = '';
  form.value = { oldPassword: '', password: '', confirm: '' };
}
async function save() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const token = session.token,
    version = revision;
  try {
    if (mode.value === 'password')
      await request('/auth/change-password', 'POST', passwordPayload(form.value));
    if (!active || token !== session.token || version !== revision) return;
    resetPasswordForm();
    uni.showToast({ title: '密码修改成功', icon: 'success' });
  } catch (reason) {
    if (active && token === session.token && version === revision) formError.value = reason.message;
  } finally {
    saving.value = false;
  }
}
function toggle(id) {
  if (saving.value) return;
  hidden.value = hidden.value.includes(id)
    ? hidden.value.filter((x) => x !== id)
    : [...hidden.value, id];
}
async function saveMenus() {
  if (saving.value || !ready.value) return;
  saving.value = true;
  error.value = '';
  try {
    const token = session.token;
    await request('/menu/preferences?client=mobile', 'PUT', { menuIds: hidden.value });
    if (!active || token !== session.token) return;
    uni.showToast({ title: '已保存', icon: 'success' });
  } catch (reason) {
    error.value = reason.message;
  } finally {
    saving.value = false;
  }
}
async function resetMenus() {
  await request('/menu/preferences?client=mobile', 'DELETE');
  await load();
}
async function clearCache() {
  await clearClientData();
  uni.reLaunch({ url: '/pages/login/index' });
}
function back() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/profile/index' }) });
}
</script>
<template>
  <template v-for="layer in themeLayers" :key="layer.id">
  <view class="tab-page"
    :class="[
      themeClass('tab-page', layer.appearance),
      layer.preview ? 'settings-theme-overlay' : '',
      layer.preview && revealMode === 'dark' ? 'settings-theme-overlay-closing' : '',
    ]"
    :aria-hidden="layer.preview || undefined"
    :style="layer.preview ? revealStyle : {}"
    @animationend.self="layer.preview && finishReveal()"
  >
    <PageSearch :title="title" v-model="menuQuery" v-model:open="searchOpen" label="搜索菜单" :enabled="mode === 'menus' && ready" :appearance="layer.appearance" back :actions-min-width="mode === 'menus' ? 96 : 0" @back="back">
      <template v-if="mode === 'menus'" #actions>
        <ConfirmAction
          label="恢复默认菜单"
          message="恢复全部菜单的默认显示设置？"
          :action="resetMenus"
          v-if="ready && !loading && !saving"
          icon="ant-design:undo-outlined"
          :danger="false"
        />
        <MobileButton label="保存" icon="ant-design:check-outlined" variant="ghost" :loading="saving" :disabled="!ready || loading" @click="saveMenus" />
      </template>
    </PageSearch>
    <MobilePage :refreshing="loading" @refresh="load"
      :style="layer.appearance ? { backgroundColor: themePalette(layer.appearance).backgroundColor } : {}"
      :requires-auth="!layer.preview" :refresh-disabled="layer.preview"
      :scroll-top="layer.preview ? settingsScrollTop : undefined"
      @scroll="!layer.preview && rememberSettingsScroll($event)"
    >
      <view v-if="mode === 'general'" class="ui-page-body">
        <view class="preference-surface ui-px-card" :class="themeClass('preference-surface', layer.appearance)">
          <view class="settings-entry">
            <text class="entry-label" :class="themeClass('entry-label', layer.appearance)">深色模式</text>
            <view class="theme-switch-control"><MobileSwitch :checked="isThemeDark(layer.appearance)" :appearance="layer.appearance" :disabled="themeChanging && !revealMode" aria-label="深色模式" @change="changeTheme" /></view>
          </view>
        </view>
        <view class="preference-surface ui-pad-card ui-mt-section" :class="themeClass('preference-surface', layer.appearance)">
          <button hover-class="none" v-for="entry in supportLinks" :key="entry.path" role="button" class="settings-entry" :aria-label="entry.title" @click="openPage(entry.path)">
            <view class="settings-entry-icon ui-mr-section"><AppIcon :name="entry.icon" :appearance="layer.appearance" /></view>
            <text class="entry-label" :class="themeClass('entry-label', layer.appearance)">{{ entry.title }}</text>
            <view class="settings-entry-icon ui-ml-section"><AppIcon name="ant-design:right-outlined" :size="16" :appearance="layer.appearance" /></view>
          </button>
        </view>
        <view class="signout-anchor ui-mt-section">
          <view
            v-if="confirmLogout"
            class="signout-confirm"
            :class="themeClass('signout-confirm', layer.appearance)"
            role="alertdialog"
            aria-label="退出当前账号？"
            ><text class="signout-message" :class="themeClass('signout-message', layer.appearance)"
              >退出当前账号？</text
            ><view class="signout-actions"
              ><MobileButton
                label="取消"
                compact
                variant="quiet"
                :appearance="layer.appearance"
                :disabled="leaving"
                @click="confirmLogout = false"
              /><MobileButton
                label="退出"
                compact
                :appearance="layer.appearance"
                :danger="true"
                :loading="leaving"
                @click="signOut"
              /></view
            ><view class="signout-arrow" :class="themeClass('signout-arrow', layer.appearance)" /></view
          >
          <button hover-class="none"
            role="button"
            class="signout-button"
            :aria-expanded="confirmLogout"
            :disabled="leaving" :aria-disabled="leaving"
            @click="confirmLogout = !confirmLogout"
            :class="themeClass('signout-button', layer.appearance)"
          ><text :class="buttonLabelClasses(['signout-button', themeClass('signout-button', layer.appearance)])">退出登录</text></button>
        </view>
      </view>
      <PageState v-else skeleton="form" :loading="loading" :error="error" @retry="load">
        <view v-if="mode === 'password'" class="ui-page-body">
          <view class="preference-surface ui-card" :class="themeClass('preference-surface')" role="form" aria-label="修改密码">
            <FormField :required="isRequired('password', 'oldPassword')" label="旧密码" kind="password" v-model="form.oldPassword" :disabled="saving" />
            <FormField :required="isRequired('password', 'password')" label="新密码" kind="password" v-model="form.password" :disabled="saving" />
            <FormField :required="isRequired('password', 'confirm')" label="确认密码" kind="password" v-model="form.confirm" :disabled="saving" />
            <text v-if="formError" class="error-text" role="alert">{{ formError }}</text>
            <FormActions>
              <MobileButton label="取消" variant="quiet" :disabled="saving" @click="back" />
              <MobileButton label="保存" :loading="saving" @click="save" />
            </FormActions>
          </view>
        </view>
        <view v-if="mode === 'menus' && ready" class="ui-page-body" @click="searchOpen = false">
          <view v-for="group in menuGroups" :key="group.id" class="preference-surface ui-pad-card ui-mt-section" :class="themeClass('preference-surface')">
            <button hover-class="none" v-if="group.title" role="button" class="menu-group-toggle" :aria-label="(collapsedMenuGroups.includes(group.id) && !menuQuery.trim() ? '展开' : '收起') + group.title" :aria-expanded="!!menuQuery.trim() || !collapsedMenuGroups.includes(group.id)" @click="toggleMenuGroup(group.id)">
              <text class="menu-group-title" :class="themeClass('menu-group-title')">{{ group.title }}</text>
              <AppIcon :name="collapsedMenuGroups.includes(group.id) && !menuQuery.trim() ? 'ant-design:right-outlined' : 'ant-design:down-outlined'" :size="16" />
            </button>
            <view v-if="!group.title || menuQuery.trim() || !collapsedMenuGroups.includes(group.id)">
              <view v-for="item in group.items" :key="item.id" class="preference-row ui-row">
                <text class="preference-name" :class="themeClass('preference-name')">{{ item.label }}</text>
                <MobileSwitch :checked="!hidden.includes(item.id)" :disabled="saving" :aria-label="'显示' + item.title" @change="toggle(item.id)" />
              </view>
            </view>
          </view>
          <view v-if="!menuGroups.length" class="menu-empty ui-mt-section">
            <text class="preference-name" :class="themeClass('preference-name')">{{ menuQuery.trim() ? '未找到匹配菜单' : '暂无可配置菜单' }}</text>
            <MobileButton v-if="menuQuery.trim()" label="清空搜索" variant="ghost" @click="menuQuery = ''" />
          </view>
        </view>
        <view
          v-if="mode === 'system'"
          class="preference-surface ui-card"
          :class="themeClass('preference-surface', layer.appearance)"
        >
          <view class="preference-row ui-row">
            <text class="preference-name" :class="themeClass('preference-name', layer.appearance)">深色模式</text>
            <view class="theme-switch-control"><MobileSwitch :checked="isThemeDark(layer.appearance)" :appearance="layer.appearance" :disabled="themeChanging && !revealMode" aria-label="深色模式" @change="changeTheme" /></view>
          </view>
          <view class="preference-row ui-row"
            ><text class="preference-name" :class="themeClass('preference-name', layer.appearance)">清除缓存</text
            ><ConfirmAction
              label="清除缓存"
              message="清除本机缓存、登录状态和本地设置，需要重新登录。云端数据不受影响，请先保存未提交的内容。"
              :action="clearCache"
              icon="ant-design:undo-outlined"
              :trigger-appearance="layer.appearance"
          /></view>
        </view>
      </PageState>
    </MobilePage>
  </view>
  </template>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.settings-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: $space-controlMin + $space-detail;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
}
.entry-label { flex: 1; text-align: left; @include type-style('body'); color: #27272a; }
.entry-label-dark { color: #eeeeef; }
.settings-entry-icon { flex-shrink: 0; }
.theme-switch-control { flex-shrink: 0; }
/* #ifdef APP */
.entry-label, .preference-surface, .preference-name, .signout-button {
  transition: background-color 800ms ease-in, color 800ms ease-in;
}
/* #endif */
/* #ifdef MP-WEIXIN */
.settings-theme-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  pointer-events: none;
  // 让固定定位的公共导航栏跟随这一层一起裁剪。
  transform: translateZ(0);
  animation-name: settings-theme-expand;
  animation-duration: var(--settings-theme-duration);
  animation-timing-function: ease-in;
  animation-fill-mode: both;
}
.settings-theme-overlay-closing { animation-name: settings-theme-contract; }
// circle() 的百分比半径以归一化对角线为基准，142% 覆盖任意窗口的对角。
@keyframes settings-theme-expand {
  from { clip-path: circle(0 at 100% 0); }
  to { clip-path: circle(142% at 100% 0); }
}
@keyframes settings-theme-contract {
  from { clip-path: circle(142% at 100% 0); }
  to { clip-path: circle(0 at 100% 0); }
}
@media (prefers-reduced-motion: reduce) {
  .settings-theme-overlay { animation-duration: 1ms; }
}
@supports not (clip-path: circle(0 at 100% 0)) {
  .settings-theme-overlay { visibility: hidden; animation-duration: 1ms; }
}
/* #endif */
.signout-button,
.settings-entry { @include borderless-button; }

.preference-surface {
  background-color: #fff;
  color: #27272a;
  border-radius: 14px;

}
.preference-surface-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.preference-row {
  flex-direction: row;
  align-items: center;
  min-height: 52px;

}
.preference-name {
  flex: 1;
  min-width: 0;
  @include type-style('body');
  color: #27272a;
}
.preference-name-dark { color: #eeeeef; }
.menu-group-toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding: 0;
  gap: $space-inline;
  background-color: transparent;
  border: 0;
}
.menu-group-title { flex: 1; text-align: left; @include type-style('body-strong'); color: #27272a; }
.menu-group-title-dark { color: #eeeeef; }
.menu-empty { align-items: center; gap: $space-inline; padding: $space-section; }
.menu-group-toggle { @include borderless-button; }
.preference-actions {
  flex-direction: row;

  align-items: center;

}
.signout-anchor {
  position: relative;
  // 提升整个锚点层级，让向上展开的确认框覆盖前一张菜单卡片。
  z-index: 3;
  overflow: visible;
}
.signout-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: $space-controlMin + $space-detail;
  gap: $space-inline;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14px;
  @include button-background(#ffffff);
  color: #c65353;
  @include type-style('body');
  line-height: type-leading('tallControl');
}
.signout-confirm {
  position: absolute;
  bottom: calc(100% + $space-inline);
  z-index: 2;
  left: 50%;
  transform: translateX(-50%);
  // 限制浮层宽度，手机与宽屏都保持紧凑，并避免窄屏溢出。
  width: 264px;

@include shrink-content;

  box-sizing: border-box;
  overflow: visible;
  padding: $space-modal;
  // 按钮自带透明触摸边缘，底部只留细节间距，避免留白叠加。
  padding-bottom: $space-detail;
  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
}
.signout-message {
  @include type-style('body-strong');
  color: #27272a;
}
.signout-message-dark { color: #eeeeef; }
.signout-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: $space-inline;
  margin-top: $space-section;
}
.signout-arrow {
  // 小箭头是定位几何，指向下方退出入口。
  position: absolute;
  bottom: -5px;
  left: 50%;
  width: 10px;
  height: 10px;
  transform: translateX(-50%) rotate(45deg);
  background-color: #ffffff;
}

.signout-button-dark {
  @include button-background(#1c1e22);
}
.signout-button-dark {
  color: #ed9191;
}
.signout-confirm-dark {
  color: #eeeeef;
  background-color: #303238;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.32);
}
.signout-arrow-dark {
  background-color: #303238;
}

.signout-button-label { color: #c65353; @include type-style('body'); }
.signout-button-dark-label { color: #ed9191; }
</style>
