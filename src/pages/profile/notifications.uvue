<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { usePageRefresh } from '../../services/page-refresh.ts'
import { ref, watch } from 'vue';
import { onShow, onHide } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import { request } from '../../services/api.ts';
import { session, restoreSession } from '../../services/session.ts';
import { themeClass } from '../../services/theme.ts';
import { notificationPayload } from '../../services/preferences-contract.ts';
import { subscribeWechatOnce } from './wechat-subscription.ts';
const loading = ref(false),
  saving = ref(false),
  testing = ref(false),
  recipientLoading = ref(false),
  ready = ref(false),
  editing = ref(false),
  error = ref(''),
  formError = ref(''),
  recipientWarning = ref('');
const subscribing = ref(false), wechatError = ref('');
const wechat = ref<any>({ enabled: false, bound: false });
const config = ref<any>({}),
  preferences = ref<any[]>([]),
  recipients = ref<any[]>([]),
  form = ref<any>({});
const channels = { STATION: '站内', EMAIL: '邮件', FEISHU: '飞书', WECHAT_MINI: '微信' };
let revision = 0,
  active = true;
watch(
  () => session.token,
  () => {
    revision++;
    config.value = {};
    preferences.value = [];
    recipients.value = [];
    form.value = {};
    editing.value = false;
    ready.value = false;
    error.value = '';
    formError.value = '';
    wechat.value = { enabled: false, bound: false };
    wechatError.value = '';
  },
  { flush: 'sync' },
);
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => error.value, keys: () => ['notification'] })
onShow(() => {
  active = true;
  restoreSession();
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' });
    return;
  }
  refreshOnShow();
});
onHide(() => {
  active = false;
  revision++;
  editing.value = false;
  form.value = {};
  loading.value = false;
});
async function load() {
  const v = ++revision,
    token = session.token;
  loading.value = true;
  error.value = '';
  try {
    const [c, p, w]: any = await Promise.all([
      request('/notification/channels/feishu'),
      request('/notification/preferences'),
      request('/notification/channels/wechat-mini'),
    ]);
    if (v !== revision || !active || token !== session.token) return;
    if (!Array.isArray(p)) throw new Error('通知偏好数据异常');
    config.value = c;
    preferences.value = p;
    wechat.value = w;
    ready.value = true;
  } catch (e) {
    if (v === revision && active) error.value = e.message;
  } finally {
    if (v === revision) loading.value = false;
  }
}
function edit() {
  form.value = {
    appId: config.value.appId || '',
    appSecret: '',
    openId: config.value.receiverOpenId || '',
    enabled: !!config.value.enabled,
  };
  formError.value = '';
  editing.value = true;
}
async function subscribeWechat() {
  if (subscribing.value || saving.value || !wechat.value.enabled || !wechat.value.bound || !wechat.value.templateId) return;
  const token = session.token, v = revision;
  subscribing.value = true;
  wechatError.value = '';
  try {
    // 必须直接在用户点击调用链中触发；模板已在页面加载时取得，不先等待网络请求。
    await subscribeWechatOnce(wechat.value.templateId);
    if (!active || token !== session.token || v !== revision) return;
    const data: any = await request('/notification/preferences', 'PUT', {
      items: [{ bizType: wechat.value.bizType, channel: 'WECHAT_MINI', enabled: true }],
    });
    if (!active || token !== session.token || v !== revision) return;
    preferences.value = data;
    uni.showToast({ title: '已订阅一次', icon: 'success' });
  } catch (e) {
    if (active && token === session.token && v === revision) wechatError.value = e.message;
  } finally {
    subscribing.value = false;
  }
}
async function testWechat() {
  const token = session.token, v = revision;
  await request('/notification/channels/wechat-mini/test', 'POST');
  if (active && token === session.token && v === revision) uni.showToast({ title: '测试已发送', icon: 'success' });
}
async function saveConfig() {
  if (saving.value) return;
  saving.value = true;
  formError.value = '';
  const token = session.token;
  try {
    const payload: any = { enabled: form.value.enabled };
    for (const key of ['appId', 'appSecret', 'openId'])
      if (form.value[key]?.trim()) payload[key] = form.value[key].trim();
    const result = await request('/notification/channels/feishu', 'PUT', payload);
    if (!active || token !== session.token) return;
    config.value = result;
    editing.value = false;
    form.value = {};
  } catch (e) {
    if (active) formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function recipientsLoad() {
  if (recipientLoading.value) return;
  recipientLoading.value = true;
  formError.value = '';
  const token = session.token,
    v = revision;
  try {
    const data: any = await request('/notification/channels/feishu/recipients');
    if (!active || token !== session.token || v !== revision || !editing.value) return;
    recipients.value = data.items || [];
    recipientWarning.value = data.warning || '';
  } catch (e) {
    formError.value = e.message;
  } finally {
    recipientLoading.value = false;
  }
}
async function savePreferences() {
  if (saving.value || subscribing.value || !ready.value) return;
  saving.value = true;
  error.value = '';
  const token = session.token;
  try {
    const data: any = await request(
      '/notification/preferences',
      'PUT',
      notificationPayload(preferences.value),
    );
    if (active && token === session.token) preferences.value = data;
  } catch (e) {
    if (active) error.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function testChannel() {
  if (testing.value) return;
  testing.value = true;
  error.value = '';
  const token = session.token,
    v = revision;
  try {
    await request('/notification/channels/feishu/test', 'POST');
    if (!active || token !== session.token || v !== revision) return;
    uni.showToast({ title: '测试已发送', icon: 'success' });
  } catch (e) {
    error.value = e.message;
  } finally {
    testing.value = false;
  }
}
async function removeChannel() {
  const token = session.token,
    v = revision;
  await request('/notification/channels/feishu', 'DELETE');
  if (active && token === session.token && v === revision) await load();
}
function back() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/profile/index' }) });
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')"
    ><PageHeader title="消息通知" back @back="back" /><MobilePage
      :refreshing="loading"
      @refresh="load"
      ><PageState skeleton="form" :loading="loading && !ready" :error="error" :has-content="ready" @retry="load"
        ><view v-if="ready" class="notification-panel ui-card" :class="themeClass('notification-panel')"
          ><view class="notification-row ui-row"
            ><text class="notification-name"
              >飞书 ·
              {{ config.enabled ? '已启用' : config.configured ? '已配置' : '未配置' }}</text
            ><MobileButton label="配置飞书" icon="ant-design:edit-outlined" variant="quiet" @click="edit" /></view
          ><text v-if="config.receiverName" class="notification-muted" :class="themeClass('notification-muted')">{{
            config.receiverName
          }}</text
          ><view class="notification-actions ui-row ui-mt-sm"
            ><MobileButton
              v-if="config.configured"
              label="测试通知"
              :loading="testing"
              @click="testChannel" /><ConfirmAction
              v-if="config.configured"
              label="删除飞书配置"
              message="删除飞书应用凭证和接收人配置？"
              :action="removeChannel" /></view></view
        ><view v-if="ready" class="notification-panel ui-card" :class="themeClass('notification-panel')">
          <LoadingIndicator v-if="loading" floating label="正在更新消息通知" />
          <view class="notification-row ui-row">
            <text class="notification-name">微信 · {{ !wechat.enabled ? '未开通' : wechat.bound ? '已绑定' : '待绑定' }}</text>
          </view>
          <text v-if="!wechat.enabled" class="notification-muted" :class="themeClass('notification-muted')">暂未开通订阅消息</text>
          <text v-else-if="!wechat.bound" class="notification-muted" :class="themeClass('notification-muted')">请先通过微信登录绑定当前账号</text>
          <template v-else>
            <!-- #ifdef MP-WEIXIN -->
            <view class="notification-actions ui-row">
              <MobileButton label="订阅一次" :loading="subscribing" :disabled="saving" @click="subscribeWechat" />
              <ConfirmAction label="发送测试" icon="" :danger="false" message="发送测试将消耗一次订阅机会，确认发送？" :action="testWechat" />
            </view>
            <!-- #endif -->
            <!-- #ifndef MP-WEIXIN -->
            <text class="notification-muted" :class="themeClass('notification-muted')">请在微信小程序内订阅</text>
            <!-- #endif -->
          </template>
          <text v-if="wechatError" class="error-text" role="alert">{{ wechatError }}</text>
        </view><view v-if="ready" class="notification-panel ui-card" :class="themeClass('notification-panel')"
          ><view
            v-for="item in preferences.filter((x) => x.visible)"
            :key="item.bizType"
            class="notification-group ui-section"
            ><text class="notification-group-title" :class="themeClass('notification-group-title')">{{ item.description }}</text
            ><view v-for="channel in item.channels" :key="channel.channel" class="notification-row ui-row"
              ><text class="notification-name">{{
                channels[channel.channel] || channel.channel
              }}</text
              ><MobileSwitch
                :checked="channel.enabled"
                :disabled="saving || subscribing || (channel.channel === 'WECHAT_MINI' && (!wechat.enabled || !wechat.bound))"
                :aria-label="item.description + channels[channel.channel]"
                @change="channel.enabled = $event.detail.value" /></view></view
          ><MobileButton
            label="保存"
            :loading="saving"
            @click="savePreferences" /></view></PageState></MobilePage
    ><AdaptiveModal
      v-if="editing"
      label="飞书通知配置"
      :busy="saving"
      :max-width="520"
      @close="editing = false"
      ><FormField label="App ID" v-model="form.appId" /><FormField
        label="App Secret"
        kind="password"
        v-model="form.appSecret"
        :placeholder="config.configured ? '留空保留原凭证' : ''" /><FormField
        label="接收人 Open ID"
        v-model="form.openId" /><MobileButton
        label="选择接收人"
        :loading="recipientLoading"
        @click="recipientsLoad" /><text v-if="recipientWarning" class="notification-muted" :class="themeClass('notification-muted')">{{
        recipientWarning
      }}</text
      ><MobileButton
        v-for="person in recipients"
        :key="person.openId"
        :label="person.name || person.openId"
        variant="quiet"
        @click="form.openId = person.openId" /><view class="notification-row ui-row"
        ><text class="notification-name">启用</text
        ><MobileSwitch
          :checked="form.enabled"
          aria-label="启用飞书通知"
          @change="form.enabled = $event.detail.value" /></view
      ><text v-if="formError" class="error-text" role="alert">{{ formError }}</text
      ><MobileButton label="保存" :loading="saving" @click="saveConfig" /></AdaptiveModal
  ></view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.notification-panel {
  position: relative;
  background-color: #fff;
  color: #27272a;
  border-radius: 14px;

}
.notification-panel-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.notification-row {
  flex-direction: row;
  align-items: center;
  min-height: 48px;

}
.notification-name {
  flex: 1;
  @include type-style('body');

}
.notification-actions {
  flex-direction: row;

  align-items: center;

}
.notification-muted {
  @include type-style('label');
  color: $text-secondary-light;

}
.notification-group-title {
  @include type-style('body-strong');
  color: #27272a;
  margin-bottom: $space-detail;
}
.notification-group-title-dark { color: #eeeeef; }
.notification-group { gap: $space-detail; }
.notification-muted-dark {
  color: $text-secondary-dark;
}
</style>
