<script setup lang="ts">
import { usePageRefresh } from '../../services/page-refresh.ts'
import { buttonLabelClasses } from '../../services/button-label.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { themeClass } from '../../services/theme.ts'
import { computed, ref, watch } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import { fetchUser, request, uploadAvatar } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'

const loading = ref(false)
const saving = ref(false)
const uploading = ref(false)
const ready = ref(false)
const errorText = ref('')
const form = ref<{ nickname: string; introduction: string; avatarFileId: string | null; avatarUrl: string }>({ nickname: '', introduction: '', avatarFileId: null, avatarUrl: '' })
const email = computed(() => session.user?.email || '未设置')
let active = false, revision = 0
// #ifdef MP-WEIXIN
let wechatAvatarSelection: { token: string; version: number } | null = null
// #endif
function clearPage() {
  revision++
  // #ifdef MP-WEIXIN
  wechatAvatarSelection = null
  // #endif
  ready.value = false
  loading.value = false
  saving.value = false
  uploading.value = false
  errorText.value = ''
  form.value = { nickname: '', introduction: '', avatarFileId: null, avatarUrl: '' }
}
function suspend() {
  active = false; revision++
  loading.value = false; saving.value = false; uploading.value = false
  // #ifdef MP-WEIXIN
  wechatAvatarSelection = null
  // #endif
}
watch(() => session.token, () => {
  clearPage()
  if (active && session.token) load()
}, { flush: 'sync' })
onHide(suspend)
onUnload(() => { suspend(); clearPage() })
const refreshOnShow = usePageRefresh(load, { loading: () => loading.value, error: () => errorText.value, keys: () => ['users', 'user'] })
onShow(() => {
  restoreSession()
  active = true
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  refreshOnShow()
})
function current(token, version) { return active && token === session.token && version === revision }
function failure(error) {
  if (!active) return
  if (error.name === 'SessionExpiredError') {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  errorText.value = error.message || '操作失败，请重试'
}
async function load() {
  if (loading.value) return
  loading.value = true
  errorText.value = ''
  const token = session.token, version = revision
  try {
    const user = await fetchUser()
    if (!current(token, version)) return
    form.value = {
      nickname: user.nickname,
      introduction: user.introduction,
      avatarFileId: user.avatarFileId,
      avatarUrl: user.avatarUrl
    }
    ready.value = true
  } catch (error) {
    if (current(token, version)) failure(error)
  } finally {
    if (current(token, version)) loading.value = false
  }
}
async function uploadSelectedAvatar(filePath: string, token: string, version: number) {
  if (!current(token, version) || !filePath || uploading.value || saving.value || !ready.value) return
  uploading.value = true
  errorText.value = ''
  try {
    const uploaded = await uploadAvatar(filePath)
    if (current(token, version)) {
      form.value.avatarFileId = uploaded.id
      form.value.avatarUrl = uploaded.fileUrl
    }
  } catch (error) {
    if (current(token, version)) failure(error)
  } finally {
    if (current(token, version)) uploading.value = false
  }
}
// #ifdef MP-WEIXIN
function beginWechatAvatarSelection() {
  if (!active || uploading.value || saving.value || !ready.value) return
  wechatAvatarSelection = { token: session.token, version: revision }
}
function chooseWechatAvatar(event: { detail?: { avatarUrl?: string } }) {
  const selection = wechatAvatarSelection
  wechatAvatarSelection = null
  const filePath = event.detail?.avatarUrl
  if (!selection || !filePath) return
  return uploadSelectedAvatar(filePath, selection.token, selection.version)
}
function wechatAvatarError(event: { detail?: { errMsg?: string } }) {
  const selection = wechatAvatarSelection
  wechatAvatarSelection = null
  if (!selection || !current(selection.token, selection.version)) return
  if (event.detail?.errMsg?.toLowerCase().includes('cancel')) return
  errorText.value = '无法获取微信头像，请重试或更换头像上传'
}
// #endif
function chooseAvatar() {
  if (uploading.value || saving.value || !ready.value) return
  const token = session.token, version = revision
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    success: (result) => {
      if (!result.tempFilePaths.length) return
      return uploadSelectedAvatar(result.tempFilePaths[0], token, version)
    },
    fail: (error) => {
      if (current(token, version) && !error.errMsg.includes('cancel'))
        errorText.value = '无法选择图片，请重试'
    }
  })
}
async function save() {
  if (!ready.value || saving.value || uploading.value) return
  const nickname = form.value.nickname.trim()
  if (!nickname) {
    errorText.value = '请输入昵称'
    return
  }
  saving.value = true
  errorText.value = ''
  const token = session.token, version = revision
  const data = { nickname, introduction: form.value.introduction, avatarFileId: form.value.avatarFileId }
  try {
    await request('/users', 'PUT', data)
    if (!current(token, version)) return
    if (session.user)
      session.user = { ...session.user, ...data, avatarUrl: form.value.avatarUrl, name: nickname }
    // 保存绑定后重新获取服务端公共 URL，避免继续展示临时上传预览地址。
    await fetchUser()
    if (!current(token, version)) return
    uni.showToast({ title: '已保存', icon: 'success' })
    back()
  } catch (error) {
    if (current(token, version)) failure(error)
  } finally {
    if (current(token, version)) saving.value = false
  }
}
function back() {
  uni.navigateBack({
    fail: () => uni.switchTab({ url: '/pages/profile/index' })
  })
}
</script>
<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="基本设置" back @back="!saving && !uploading && back()" />
    <scroll-view scroll-y class="tab-scroll">
      <view class="tab-content ui-page-inset">
        <view
          v-if="loading"
          class="state-card"
          :class="themeClass('state-card')"
          ><ContentSkeleton variant="form" label="正在加载设置" /></view
        >
        <view v-if="errorText" class="settings-error ui-mb-section"
          ><text
            role="alert"
            class="error-text"
            :class="themeClass('error-text')"
            >{{ errorText }}</text
          ><button
            v-if="!ready"
            role="button"
            class="text-action"
            :disabled="loading" :aria-disabled="loading"
            @click="load"
          ><text :class="buttonLabelClasses(['text-action'])">重试</text></button></view
        >
        <view
          v-if="ready"
          class="settings-card ui-card"
          :class="themeClass('settings-card')"
        >
          <view class="avatar-section ui-mb-section">
            <button
              role="button"
              class="avatar-picker"
              :disabled="uploading || saving" :aria-disabled="uploading || saving"
              aria-label="选择头像图片"
              @click="chooseAvatar"
            >
            <image
              v-if="form.avatarUrl"
              class="settings-avatar"
              :src="form.avatarUrl"
              mode="aspectFill"
            />
            <view
              v-else
              class="settings-avatar avatar-fallback"
              :class="themeClass('avatar-fallback')"
              ><text
                class="avatar-initial"
                :class="themeClass('avatar-initial')"
                >{{ (form.nickname || '我').slice(0, 1) }}</text
              ></view
            >
            </button>
            <view class="avatar-actions">
              <button
                role="button"
                class="avatar-picker"
                :disabled="uploading || saving" :aria-disabled="uploading || saving"
                :loading="uploading"
                aria-label="更换头像"
                @click="chooseAvatar"
              ><text class="settings-link">{{ uploading ? '上传中…' : '更换头像' }}</text></button>
              <!-- #ifdef MP-WEIXIN -->
              <button
                role="button"
                class="avatar-picker"
                :open-type="uploading || saving ? '' : 'chooseAvatar'"
                :disabled="uploading || saving" :aria-disabled="uploading || saving"
                aria-label="从微信获取头像"
                @click="beginWechatAvatarSelection"
                @chooseavatar="chooseWechatAvatar"
                @error="wechatAvatarError"
              ><text class="settings-link">从微信获取</text></button>
              <!-- #endif -->
            </view>
          </view>
          <view class="settings-inline-row">
            <text class="settings-label settings-inline-label" :class="themeClass('settings-label')">昵称</text>
            <input
              v-model="form.nickname"
              class="settings-input ui-px-card"
              aria-label="昵称"
              placeholder="怎么称呼你"
              :maxlength="64"
              :disabled="saving" :aria-disabled="saving"
              :class="themeClass('settings-input')"
            />
          </view>
          <view class="settings-inline-row">
            <text class="settings-label settings-inline-label" :class="themeClass('settings-label')">邮箱</text>
            <text class="settings-readonly ui-px-card" :class="themeClass('settings-readonly')" selectable>{{ email }}</text>
          </view>
          <text class="settings-label ui-mb-section ui-mt-section" :class="themeClass('settings-label')"
            >签名</text
          >
          <textarea
            v-model="form.introduction"
            class="settings-textarea ui-pad-card"
            aria-label="签名"
            placeholder="写一句你喜欢的话"
            :maxlength="255"
            :disabled="saving" :aria-disabled="saving"
            :class="themeClass('settings-textarea')"
          />
          <button
            role="button"
            class="settings-save ui-mt-section"
            :disabled="saving || uploading" :aria-disabled="saving || uploading"
            :loading="saving"
            @click="save"
          >
            <text :class="buttonLabelClasses(['settings-save ui-mt-section'])">{{ saving ? '保存中…' : '保存' }}</text>
          </button>
        </view>
      </view>
    </scroll-view>
  <SecondaryUnlock />
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.settings-card {

  background-color: #ffffff;
  border-radius: 18px;
}
.settings-error {

}
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: $space-inline;
}
.avatar-picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: $space-controlMin;
  min-width: $space-controlMin;
  margin: 0;
  padding: 0;
  background-color: transparent !important;
  border: 0;
}
.settings-avatar {
  width: 72px;
  height: 72px;
  border-radius: 36px;
}
.avatar-fallback {
  background-color: #e3ebfc;
  align-items: center;
  justify-content: center;
}
.avatar-initial {
  color: #4f78c4;
  @include type-style('avatar');
}
.settings-link {
  color: #4e7ee3;
  @include type-style('label');
  line-height: $space-controlMin;
}
.settings-label {
  color: #52525b;
  @include type-style('label');

}
.settings-inline-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  min-height: $space-controlMin;
}
.settings-inline-label {
  flex-shrink: 0;
}
.settings-input {
  flex: 1;
  min-width: 0;
  height: 48px;

  border-radius: 12px;
  background-color: #f5f6f8;
  color: #27272a;
  @include type-style('body');
}
.settings-readonly {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  color: $text-secondary-light;
  @include type-style('body');

}
.settings-textarea {
  width: 100%;
  height: 120px;

  border-radius: 12px;
  background-color: #f5f6f8;
  color: #27272a;
  @include type-style('body');
}
.settings-save {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 48px;
  border: 0;
  border-radius: 12px;
  padding: 0;

  // 保留保存中的对比度，避免框架禁用底色覆盖后出现白字配浅灰底。
  color: #ffffff !important;
  background-color: #4e7ee3 !important;
  @include type-style('body');
  line-height: type-leading('tallControl');
}

.settings-card-dark {
  background-color: #1c1e22;
}
.settings-label-dark {
  color: #b4b4bd;
}
.settings-input-dark,
.settings-textarea-dark {
  color: #eeeeef;
  background-color: #282a30;
}
.avatar-fallback-dark {
  background-color: #243451;
}
.avatar-initial-dark {
  color: #9dbcfa;
}

/* #ifdef WEB || MP-WEIXIN */
.avatar-picker::after,
.settings-save::after {
  border: 0;
}
/* #endif */

.settings-readonly-dark {
  color: $text-secondary-dark;
}

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.text-action-label { @include type-style('body'); color: #5b8ff9; }
.settings-save-label { color: #ffffff; @include type-style('body'); }
</style>
