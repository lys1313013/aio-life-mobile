<script setup lang="ts">
import { useRefreshTheme } from '../../services/refresh-theme.ts'
const refreshTheme = useRefreshTheme()
import { nextTick, computed, ref } from 'vue'
import { onShow, onHide } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import { fetchUser, logout } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'

const user = computed(() => session.user)
const loading = ref(false)
const refreshing = ref(false)
async function pullRefresh() {
  if (refreshing.value) return
  refreshing.value = true
  await nextTick()
  try { if (loadTask) await loadTask; await load() } finally { refreshing.value = false }
}
const leaving = ref(false)
const confirmLogout = ref(false)
const errorText = ref('')
let loadTask: Promise<void> | null = null
let visible = false
onShow(() => {
  visible = true
  restoreSession()
  if (!session.token) { uni.reLaunch({ url: '/pages/login/index' }); return }
  load()
})
onHide(() => { visible = false; confirmLogout.value = false })
function load() {
  if (loadTask) return loadTask
  loadTask = loadProfile().finally(() => { loadTask = null })
  return loadTask
}
async function loadProfile() {
  loading.value = true
  errorText.value = ''
  try { await fetchUser() } catch (error) {
    if (!visible) return
    if (error.name === 'SessionExpiredError') { uni.reLaunch({ url: '/pages/login/index' }); return }
    errorText.value = error.message || '加载失败，请重试'
  } finally { loading.value = false }
}
async function signOut() {
  if (leaving.value) return
  leaving.value = true
  try { await logout() } catch (_) { uni.showToast({ title: '已退出本机，服务端注销未完成', icon: 'none' }) }
  finally { uni.reLaunch({ url: '/pages/login/index' }); leaving.value = false }
}
</script>

<template>
  <view class="tab-page">
    <PageHeader title="我的" />
    <scroll-view scroll-y class="tab-scroll" :refresher-enabled="true" :refresher-triggered="refreshing" refresher-background="transparent" :refresher-default-style="refreshTheme" @refresherrefresh="pullRefresh">
      <view class="tab-content">
        <view v-if="errorText" class="state-card"><text class="error-text" role="alert">{{ errorText }}</text><button role="button" class="text-action" @click="load">重试账户信息</button></view>
        <view v-if="user" class="profile-card">
          <view class="profile-avatar"><text class="avatar-letter">{{ user.name.slice(0, 1) }}</text></view>
          <text class="profile-name">{{ user.name }}</text>
          <text v-if="user.introduction" class="profile-intro">{{ user.introduction }}</text>
        </view>
        <view v-else-if="loading" class="state-card"><text class="muted-text">加载中…</text></view>
        <view v-if="user && (user.username || user.email)" class="account-card">
          <view v-if="user.username" class="account-row"><text class="muted-text">账号</text><text class="account-value">{{ user.username }}</text></view>
          <view v-if="user.email" class="account-row"><text class="muted-text">邮箱</text><text class="account-value">{{ user.email }}</text></view>
        </view>
        <view class="signout-anchor">
          <view v-if="confirmLogout" class="signout-confirm"><text class="empty-title">退出当前账号？</text><view class="signout-actions"><button role="button" class="cancel-button" :disabled="leaving" @click="confirmLogout = false">取消</button><button role="button" class="confirm-button" :disabled="leaving" :loading="leaving" @click="signOut">退出</button></view></view>
          <button role="button" class="signout-button" :disabled="leaving" @click="confirmLogout = !confirmLogout">退出登录</button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<style scoped>
.profile-card { align-items: center; padding: 20px 16px 32px; }
.profile-avatar { height: 64px; width: 64px; border-radius: 32px; background-color: #e3ebfc; align-items: center; justify-content: center; }
.avatar-letter { font-size: 24px; color: #4f78c4; font-weight: 600; }
.profile-name { font-size: 22px; font-weight: 600; color: #27272a; margin-top: 16px; }
.profile-intro { font-size: 13px; color: #71717a; line-height: 22px; margin-top: 8px; text-align: center; }
.account-card { padding: 8px 18px; border-radius: 16px; background-color: #ffffff; }
.account-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 16px 0; }
.account-value { font-size: 14px; color: #27272a; margin-left: 20px; flex-shrink: 1; text-align: right; }
.signout-anchor { position: relative; margin-top: 24px; padding-bottom: 132px; }
.signout-button { width: 100%; height: 48px; line-height: 48px; margin: 0; padding: 0; border: 0; border-radius: 14px; background-color: #ffffff; color: #c65353; font-size: 14px; }
.signout-confirm { position: absolute; top: 58px; right: 0; width: 240px; padding: 18px; border-radius: 14px; background-color: #ffffff; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10); }
.signout-actions { flex-direction: row; justify-content: flex-end; margin-top: 18px; }
.cancel-button, .confirm-button { margin: 0; padding: 4px 16px; border: 0; border-radius: 8px; font-size: 13px; }
.cancel-button { color: #71717a; background-color: #f4f4f5; }
.confirm-button { margin-left: 10px; color: #ffffff; background-color: #4e7ee3; }
@media (prefers-color-scheme: dark) {
  .profile-name, .account-value { color: #eeeeef; }
  .profile-avatar { background-color: #243451; }
  .avatar-letter { color: #9dbcfa; }
  .profile-intro { color: #9c9ca6; }
  .account-card, .signout-button, .signout-confirm { background-color: #1c1e22; }
  .signout-button { color: #ed9191; }
  .cancel-button { color: #b4b4bd; background-color: #303238; }
}
</style>
