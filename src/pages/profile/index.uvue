<script setup lang="ts">
import { usePageRefresh } from '../../services/page-refresh.ts'
import { buttonLabelClasses } from '../../services/button-label.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import MobileButton from '../../components/MobileButton.uvue'
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { themeClass } from '../../services/theme.ts'
import { useRefreshTheme } from '../../services/refresh-theme.ts'
const refreshTheme = useRefreshTheme()
import { nextTick, computed, ref } from 'vue'
import { onShow, onHide } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import { fetchUser, logout } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'

const preferenceLinks = [
  { title: '消息中心', path: '/pages/messages/index' },
  { title: '账号与安全', path: 'account-security' },
  { title: '设置', path: 'preferences?section=general' },
]

function openPage(name: string) {
  uni.navigateTo({ url: name.startsWith('/') ? name : '/pages/profile/' + name })
}
const user = computed(() => session.user)
const loading = ref(false)
const refreshing = ref(false)
async function pullRefresh() {
  if (refreshing.value) return
  refreshing.value = true
  await nextTick()
  try {
    if (loadTask) await loadTask
    await load()
  } finally {
    refreshing.value = false
  }
}
const leaving = ref(false)
const confirmLogout = ref(false)
const errorText = ref('')
let loadTask: Promise<void> | null = null
let visible = false
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => errorText.value, keys: () => ['user', 'users', 'userbinds', 'message'] })
onShow(() => {
  visible = true
  restoreSession()
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  refreshOnShow()
})
onHide(() => {
  visible = false
  confirmLogout.value = false
})
function load() {
  if (loadTask) return loadTask
  loadTask = loadProfile().finally(() => {
    loadTask = null
  })
  return loadTask
}
async function loadProfile() {
  loading.value = true
  errorText.value = ''
  try {
    await fetchUser()
  } catch (error) {
    if (!visible) return
    if (error.name === 'SessionExpiredError') {
      uni.reLaunch({ url: '/pages/login/index' })
      return
    }
    errorText.value = error.message || '加载失败，请重试'
  } finally {
    loading.value = false
  }
}
async function signOut() {
  if (leaving.value) return
  leaving.value = true
  try {
    await logout()
  } catch (_) {
    uni.showToast({ title: '已退出本机，服务端注销未完成', icon: 'none' })
  } finally {
    uni.reLaunch({ url: '/pages/login/index' })
    leaving.value = false
  }
}
</script>

<template>
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="" :actions-min-width="44">
      <template #actions>
        <!-- #ifndef WEB -->
        <button role="button" class="profile-icon-button" aria-label="扫码登录" @click="openPage('/pages/scan-login/index')">
          <AppIcon name="lucide:scan" />
        </button>
        <!-- #endif -->
      </template>
    </PageHeader>
    <scroll-view
      scroll-y
      class="tab-scroll"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      refresher-background="transparent"
      :refresher-default-style="refreshTheme"
      @refresherrefresh="pullRefresh"
    >
      <view class="tab-content ui-page-inset ui-tab-page-inset">
        <view
          v-if="errorText"
          class="state-card"
          :class="themeClass('state-card')"
          ><text
            class="error-text"
            role="alert"
            :class="themeClass('error-text')"
            >{{ errorText }}</text
          ><button role="button" class="text-action" @click="load"><text :class="buttonLabelClasses(['text-action'])">重试账户信息</text></button></view
        >
        <button v-if="user" role="button" class="profile-card ui-pad-card" aria-label="编辑资料" @click="openPage('settings')">
          <image
            v-if="user.avatarUrl"
            class="profile-avatar"
            :src="user.avatarUrl"
            mode="aspectFill"
            :class="themeClass('profile-avatar')"
          />
          <view
            v-else
            class="profile-avatar"
            :class="themeClass('profile-avatar')"
            ><text class="avatar-letter" :class="themeClass('avatar-letter')">{{
              user.name.slice(0, 1)
            }}</text></view
          >
          <view class="profile-details">
          <text class="profile-name" :class="themeClass('profile-name')">{{
            user.name
          }}</text>
          <text
            v-if="user.introduction"
            class="profile-intro"
            :class="themeClass('profile-intro')"
            >{{ user.introduction }}</text
          >
          </view>
        </button>
        <view
          v-else-if="loading"
          class="profile-loading"
          ><ContentSkeleton variant="profile-row" label="正在加载个人资料" /></view
        >
        <view class="profile-menu ui-pad-card ui-mt-section" :class="themeClass('profile-menu')">
          <button v-for="entry in preferenceLinks" :key="entry.path" role="button" class="menu-row ui-type-body" :aria-label="entry.title" @click="openPage(entry.path)"><text class="menu-label" :class="themeClass('menu-label')">{{ entry.title }}</text><AppIcon name="ant-design:right-outlined" /></button>
        </view>
        <view class="signout-anchor ui-mt-section">
          <view
            v-if="confirmLogout"
            class="signout-confirm"
            :class="themeClass('signout-confirm')"
            role="alertdialog"
            aria-label="退出当前账号？"
            ><text class="signout-message"
              >退出当前账号？</text
            ><view class="signout-actions"
              ><MobileButton
                label="取消"
                compact
                variant="quiet"
                :disabled="leaving"
                @click="confirmLogout = false"
              /><MobileButton
                label="退出"
                compact
                :danger="true"
                :loading="leaving"
                @click="signOut"
              /></view
            ><view class="signout-arrow" :class="themeClass('signout-arrow')" /></view
          >
          <button
            role="button"
            class="signout-button"
            :aria-expanded="confirmLogout"
            :disabled="leaving" :aria-disabled="leaving"
            @click="confirmLogout = !confirmLogout"
            :class="themeClass('signout-button')"
          ><text :class="buttonLabelClasses(['signout-button', themeClass('signout-button')])">退出登录</text></button>
        </view>
      </view>
    </scroll-view>
  <SecondaryUnlock />
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.profile-menu {

  border-radius: 16px;
  background-color: #ffffff;

}
.menu-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  border-radius: 0;
}
.menu-label {
  color: #27272a;
  @include type-style('body');
}
/* #ifdef WEB || MP-WEIXIN */
.menu-row::after,
.profile-icon-button::after,
.profile-card::after {
  border: 0;
}
/* #endif */
.profile-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background-color: transparent;
}
.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-section;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding-top: $space-section * 2;
  padding-bottom: $space-section * 2;
  border: 0;
  border-radius: 16px;
  background-color: transparent;
  text-align: left;
}
.profile-details {
  flex: 1;
  min-width: 0;
  gap: $space-detail;
  align-items: flex-start;
}
.profile-avatar {
  flex-shrink: 0;
  height: 72px;
  width: 72px;
  border-radius: 36px;
  background-color: #e3ebfc;
  align-items: center;
  justify-content: center;
}
.avatar-letter {
  @include type-style('avatar');
  color: #4f78c4;

}
.profile-name {
  @include type-style('heading');

  color: #27272a;

}
.profile-intro {
  @include type-style('label');
  color: #71717a;

  text-align: left;
  word-break: break-all;
}
.signout-anchor {
  position: relative;
  // 提升整个锚点层级，让向上展开的确认框覆盖前一张菜单卡片。
  z-index: 3;
  overflow: visible;
}
.signout-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 48px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14px;
  background-color: #ffffff;
  color: #c65353;
  @include type-style('body');
  line-height: type-leading('tallControl');
}
.signout-confirm {
  position: absolute;
  bottom: calc(100% + $space-inline);
  z-index: 2;
  left: 50%;
  transform: translateX(-50%);
  // 限制浮层宽度，手机与宽屏都保持紧凑，并避免窄屏溢出。
  width: 264px;

/* #ifndef APP */
max-width: 100%;
/* #endif */
/* #ifdef APP */
flex-shrink: 1;
/* #endif */

  box-sizing: border-box;
  overflow: visible;
  padding: $space-modal;
  // 按钮自带透明触摸边缘，底部只留细节间距，避免留白叠加。
  padding-bottom: $space-detail;
  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
}
.signout-message {
  @include type-style('body-strong');

}
.signout-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: $space-inline;
  margin-top: $space-section;
}
.signout-arrow {
  // 小箭头是定位几何，指向下方退出入口。
  position: absolute;
  bottom: -5px;
  left: 50%;
  width: 10px;
  height: 10px;
  transform: translateX(-50%) rotate(45deg);
  background-color: #ffffff;
}

@media (min-width: 640px) {
  .profile-menu {
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: $space-section;
  }
  .menu-row {
    width: calc((100% - $space-section) / 2);
  }
}

.profile-menu-dark {
  background-color: #1c1e22;
}
.menu-label-dark {
  color: #eeeeef;
}
.profile-name-dark {
  color: #eeeeef;
}
.profile-avatar-dark {
  background-color: #243451;
}
.avatar-letter-dark {
  color: #9dbcfa;
}
.profile-intro-dark {
  color: #9c9ca6;
}
.signout-button-dark {
  background-color: #1c1e22;
}
.signout-button-dark {
  color: #ed9191;
}
.signout-confirm-dark {
  color: #eeeeef;
  background-color: #303238;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.32);
}
.signout-arrow-dark {
  background-color: #303238;
}

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.text-action-label { @include type-style('body'); color: #5b8ff9; }
.signout-button-label { color: #c65353; @include type-style('body'); }
.signout-button-dark-label { color: #ed9191; }
</style>
