<script setup lang="ts">
// #ifdef MP-WEIXIN
import TabPage from '../../components/TabPage.uvue'
// #endif
import { usePageRefresh } from '../../services/page-refresh.ts'
import { buttonLabelClasses } from '../../services/button-label.ts'
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { isDark, themeClass } from '../../services/theme.ts'
import { useRefreshTheme } from '../../services/refresh-theme.ts'
const refreshTheme = useRefreshTheme()
import { nextTick, computed, ref, watch } from 'vue'
import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
import PageHeader from '../../components/PageHeader.uvue'
import { fetchUser, request } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'

const shortcutLinks = [
  { title: '消息中心', path: '/pages/messages/index', icon: 'ant-design:message-outlined', message: true },
  { title: '账号绑定', path: 'bindings', icon: 'lucide:link', message: false },
  { title: '首页卡片', path: '/pages/home-settings/index', icon: 'lucide:layout-dashboard', message: false },
  { title: '菜单显示', path: 'preferences?section=menus', icon: 'lucide:layout-grid', message: false },
]
const preferenceLinks = [
  { title: '数据导出', path: '/pages/data-export/index', icon: 'ant-design:download-outlined' },
  { title: '消息通知', path: 'notifications', icon: 'lucide:bell' },
  { title: '分类管理', path: '/pages/records/categories', icon: 'lucide:settings-2' },
  { title: '设置', path: 'preferences?section=general', icon: 'ant-design:setting-outlined' },
]

function openPage(name: string) {
  uni.navigateTo({ url: name.startsWith('/') ? name : '/pages/profile/' + name })
}
const user = computed(() => session.user)
const loading = ref(false)
const refreshing = ref(false)
async function pullRefresh() {
  if (refreshing.value) return
  const version = revision
  refreshing.value = true
  await nextTick()
  try {
    if (loadTask) await loadTask
    if (version === revision) await load()
  } finally {
    if (version === revision) refreshing.value = false
  }
}
const errorText = ref('')
const unreadCount = ref(0)
const unreadError = ref('')
// 未读数后台更新；仅用请求状态防重入，不展示加载动画或清空已有角标。
const unreadLoading = ref(false)
const unreadLabel = computed(() => unreadCount.value > 99 ? '99+' : String(unreadCount.value))
const shortcutColor = computed(() => isDark.value ? '#9dbcfa' : '#4e7ee3')
let loadTask: Promise<void> | null = null
let visible = false
let revision = 0
function suspend() {
  revision++
  loadTask = null
  loading.value = false
  unreadLoading.value = false
  refreshing.value = false
}
watch(() => session.token, () => {
  suspend()
  unreadCount.value = 0
  unreadError.value = ''
  errorText.value = ''
}, { flush: 'sync' })
const refreshOnShow = usePageRefresh(() => load(), { loading: () => loading.value, error: () => errorText.value, keys: () => ['user', 'users', 'userbinds', 'message'] })
onShow(() => {
  visible = true
  restoreSession()
  if (!session.token) {
    uni.reLaunch({ url: '/pages/login/index' })
    return
  }
  refreshOnShow()
  loadUnread()
})
onHide(() => {
  visible = false
  suspend()
})
onUnload(() => {
  visible = false
  suspend()
})
function load() {
  if (!visible || !session.token) return Promise.resolve()
  if (loadTask) return loadTask
  const task = Promise.all([loadProfile(), loadUnread()]).then(() => {}).finally(() => {
    if (loadTask === task) loadTask = null
  })
  loadTask = task
  return loadTask
}
async function loadProfile() {
  const version = revision, token = session.token
  loading.value = true
  errorText.value = ''
  try {
    await fetchUser()
  } catch (error) {
    if (!visible || revision !== version || token !== session.token) return
    if (error.name === 'SessionExpiredError') {
      uni.reLaunch({ url: '/pages/login/index' })
      return
    }
    errorText.value = error.message || '加载失败，请重试'
  } finally {
    if (revision === version) loading.value = false
  }
}
async function loadUnread() {
  if (!visible || !session.token || unreadLoading.value) return
  const version = revision, token = session.token
  unreadLoading.value = true
  unreadError.value = ''
  try {
    const data = await request<{ count: number }>('/message/unread-count')
    if (!visible || revision !== version || token !== session.token) return
    if (!data || typeof data.count !== 'number' || !Number.isInteger(data.count) || data.count < 0 || data.count > 2147483647) throw new Error('未读消息数量异常，请重试')
    unreadCount.value = data.count
  } catch (reason) {
    if (visible && revision === version && token === session.token) unreadError.value = reason.message || '未读消息加载失败'
  } finally {
    if (revision === version) unreadLoading.value = false
  }
}
</script>

<template>
  <!-- #ifdef MP-WEIXIN -->
  <TabPage page-path="pages/profile/index">
  <!-- #endif -->
  <view class="tab-page" :class="themeClass('tab-page')">
    <PageHeader title="" :actions-min-width="44">
      <template #actions>
        <!-- #ifndef WEB -->
        <button role="button" class="profile-icon-button" aria-label="扫码登录" @click="openPage('/pages/scan-login/index')">
          <AppIcon name="lucide:scan-line" />
        </button>
        <!-- #endif -->
      </template>
    </PageHeader>
    <scroll-view
      scroll-y
      class="tab-scroll"
      :refresher-enabled="true"
      :refresher-triggered="refreshing"
      refresher-background="transparent"
      :refresher-default-style="refreshTheme"
      @refresherrefresh="pullRefresh"
    >
      <view class="tab-content ui-page-inset ui-tab-page-inset">
        <view
          v-if="errorText"
          class="state-card"
          :class="themeClass('state-card')"
          ><text
            class="error-text"
            role="alert"
            :class="themeClass('error-text')"
            >{{ errorText }}</text
          ><button role="button" class="text-action" @click="load"><text :class="buttonLabelClasses(['text-action'])">重试账户信息</text></button></view
        >
        <button v-if="user" role="button" class="profile-card ui-pad-card" aria-label="编辑资料" @click="openPage('settings')">
          <image
            v-if="user.avatarUrl"
            class="profile-avatar"
            :src="user.avatarUrl"
            mode="aspectFill"
            :class="themeClass('profile-avatar')"
          />
          <view
            v-else
            class="profile-avatar"
            :class="themeClass('profile-avatar')"
            ><text class="avatar-letter" :class="themeClass('avatar-letter')">{{
              user.name.slice(0, 1)
            }}</text></view
          >
          <view class="profile-details">
          <text class="profile-name" :class="themeClass('profile-name')">{{
            user.name
          }}</text>
          <text
            v-if="user.introduction"
            class="profile-intro"
            :class="themeClass('profile-intro')"
            >{{ user.introduction }}</text
          >
          </view>
          <AppIcon name="ant-design:right-outlined" :size="16" />
        </button>
        <view
          v-else-if="loading"
          class="profile-loading"
          ><ContentSkeleton variant="profile-row" label="正在加载个人资料" /></view
        >
        <view class="profile-shortcuts ui-pad-card" :class="themeClass('profile-shortcuts')">
          <button v-for="entry in shortcutLinks" :key="entry.path" role="button" class="shortcut-button" :aria-label="entry.title" @click="openPage(entry.path)">
            <view class="shortcut-icon" :class="themeClass('shortcut-icon')">
              <AppIcon :name="entry.icon" :color="shortcutColor" />
              <text v-if="entry.message && unreadCount > 0" class="unread-badge" :aria-label="unreadCount + '条未读消息'">{{ unreadLabel }}</text>
            </view>
            <text class="shortcut-label" :class="themeClass('shortcut-label')">{{ entry.title }}</text>
          </button>
        </view>
        <view v-if="unreadError" class="unread-error ui-mt-section">
          <text class="error-text" role="alert" :class="themeClass('error-text')">{{ unreadError }}</text>
          <button role="button" class="text-action" aria-label="重试未读消息" :disabled="unreadLoading" @click="loadUnread"><text :class="buttonLabelClasses(['text-action'])">重试</text></button>
        </view>
        <view class="profile-menu ui-pad-card ui-mt-section" :class="themeClass('profile-menu')">
          <button role="button" class="menu-row" aria-label="账号与安全" @click="openPage('account-security')">
            <AppIcon name="mdi:shield-account-outline" /><text class="menu-label" :class="themeClass('menu-label')">账号与安全</text><AppIcon name="ant-design:right-outlined" :size="16" />
          </button>
        </view>
        <view class="profile-menu ui-pad-card ui-mt-section" :class="themeClass('profile-menu')">
          <button v-for="entry in preferenceLinks" :key="entry.path" role="button" class="menu-row" :aria-label="entry.title" @click="openPage(entry.path)"><AppIcon :name="entry.icon" /><text class="menu-label" :class="themeClass('menu-label')">{{ entry.title }}</text><AppIcon name="ant-design:right-outlined" :size="16" /></button>
        </view>
      </view>
    </scroll-view>
  <SecondaryUnlock />
  </view>
  <!-- #ifdef MP-WEIXIN -->
  </TabPage>
  <!-- #endif -->
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.profile-menu {

  border-radius: 16px;
  background-color: #ffffff;

}
.menu-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-section;
  min-height: $space-controlMin + $space-detail;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background-color: transparent;
  border-radius: 0;
}
.menu-label {
  flex: 1;
  text-align: left;
  color: #27272a;
  @include type-style('body');
}
/* #ifdef WEB || MP-WEIXIN */
.shortcut-button::after,
.menu-row::after,
.profile-icon-button::after,
.profile-card::after {
  border: 0;
}
/* #endif */
.profile-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background-color: transparent;
}
.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-section;
  width: 100%;
  min-height: $space-controlMin;
  margin: 0;
  padding-top: $space-section * 2;
  padding-bottom: $space-section * 2;
  border: 0;
  border-radius: 16px;
  background-color: transparent;
  text-align: left;
}
.profile-details {
  flex: 1;
  min-width: 0;
  gap: $space-detail;
  align-items: flex-start;
}
.profile-avatar {
  flex-shrink: 0;
  height: 72px;
  width: 72px;
  border-radius: 36px;
  background-color: #e3ebfc;
  align-items: center;
  justify-content: center;
}
.avatar-letter {
  @include type-style('avatar');
  color: #4f78c4;

}
.profile-name {
  @include type-style('heading');

  color: #27272a;

}
.profile-intro {
  @include type-style('label');
  color: #71717a;

  text-align: left;
  word-break: break-all;
}
.profile-menu-dark {
  background-color: #1c1e22;
}
.menu-label-dark {
  color: #eeeeef;
}
.profile-name-dark {
  color: #eeeeef;
}
.profile-avatar-dark {
  background-color: #243451;
}
.avatar-letter-dark {
  color: #9dbcfa;
}
.profile-intro-dark {
  color: #9c9ca6;
}
/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.text-action-label { @include type-style('body'); color: #5b8ff9; }
.profile-shortcuts {
  display: flex;
  flex-direction: row;
  border-radius: 16px;
  background-color: #ffffff;
}
.profile-shortcuts-dark { background-color: #1c1e22; }
.shortcut-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: $space-controlMin;
  gap: $space-inline;
  padding: $space-detail 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  overflow: visible;
}
.shortcut-icon {
  position: relative;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 12px;
  background-color: #eaf0fc;
}
.shortcut-icon-dark { background-color: #243451; }
.shortcut-label {
  @include type-style('caption');
  color: #27272a;
  text-align: center;
}
.shortcut-label-dark { color: #eeeeef; }
// 未读角标绝对定位，不改变快捷入口的占位高度。
.unread-badge {
  position: absolute;
  top: -$space-detail;
  left: 100%;
  transform: translateX(-50%);
  min-width: 18px;
  padding: 0 $space-detail;
  border-radius: 10px;
  background-color: #c65353;
  color: #ffffff;
  @include type-style('badge-strong');
  text-align: center;
}
.unread-error {
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
}
</style>
