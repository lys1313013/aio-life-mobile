<script setup lang="ts">
import TimeDonut from './TimeDonut.uvue'
import { summaryDonutLabels } from '../../services/dashboard-format.ts'
import { themeClass } from '../../services/theme.ts'
defineProps<{ day: any; dayDate: string; today: string; height: number; active: boolean; loading: boolean; chartActive: boolean; animate: boolean }>()
defineEmits<{ edit: [id: string] }>()
</script>
