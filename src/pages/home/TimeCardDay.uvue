                    </view>
                  </view>
                </view></view><scroll-view scroll-y :show-scrollbar="false" class="recent-times ui-ml-sm"><view class="recent-time-list"
                  ><text v-if="day.recent.length === 0" class="empty-label"
                     :class="themeClass('empty-label')">{{ dayDate === today ? '今日' : dayDate }}暂无记录</text
                  ><button role="button"
                    v-for="record in day.recent"
