<view class="time-layout" :style="{ height: height + 'px' }">
                <view class="timeline-labels"
                  ><text class="axis-label">0</text
                  ><view class="timeline"
                     :class="themeClass('timeline')"><view
                      v-for="block in day.timeline"
                      :key="block.id"
                      class="timeline-block"
                      :style="block"
                    ></view></view
                  ><text class="axis-label">24</text></view
                ><view class="donut-stage"><view
                  class="donut"
                  role="img"
                  :aria-label="(dayDate === today ? '今日' : dayDate) + '已记录 ' + day.total"
                  ><TimeDonut :groups="day.groups" :active="chartActive" :animate-on-mount="animate" /><view v-if="day.groups.length" class="donut-center"><text class="donut-total" :class="themeClass('donut-total')">{{ day.total }}</text></view><view v-for="label in summaryDonutLabels(day.groups)" :key="label.id" class="donut-annotation">
