                    class="time-record" :disabled="!active || loading" :aria-label="'编辑时迹 ' + record.name" @click="$emit('edit', record.id)"
                    :style="{ color: record.color, height: (height / 5) + 'px' }"
                    ><view class="time-record-content"><text :style="{ color: record.color }" class="record-clock">{{ record.startLabel }}</text><text :style="{ color: record.color }" class="record-duration">{{ record.durationLabel }}</text><text :style="{ color: record.color }" class="record-name">{{ record.shortName }}</text></view></button
                  ></view></scroll-view>
              </view>
