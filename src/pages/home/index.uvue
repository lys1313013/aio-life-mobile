<script setup lang="ts">
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import AppIcon from '../../components/AppIcon.uvue'
import SecondaryUnlock from "../../components/SecondaryUnlock.uvue";
import { isDark, themeClass } from '../../services/theme.ts'
import { useRefreshTheme } from '../../services/refresh-theme.ts'
const refreshTheme = useRefreshTheme()
import { nextTick, computed, reactive, ref } from 'vue'
import { onShow, onHide, onUnload, onResize } from '@dcloudio/uni-app'
import DashboardAction from '../../components/DashboardAction.uvue'
import iconCatalog from '../../services/icons/catalog.ts'
import DashboardSection from '../../components/DashboardSection.uvue'
// #ifndef WEB
import PageHeader from '../../components/PageHeader.uvue'
// #endif
import { fetchUser, request } from '../../services/api.ts'
import { restoreSession, session } from '../../services/session.ts'
import {
  getOverview,
  getCard,
  getQuickLinks,
  getThoughts,
  getWatched,
  getExercises,
  getCommits,
  getTime,
} from '../../services/dashboard.ts'
import type {
  OverviewCard,
  QuickLink,
  Thought,
  WatchedTask,
  ExercisePage,
  Commit,
} from '../../services/dashboard.ts'
import TimeRecordEditor from '../../components/TimeRecordEditor.uvue'
import { takeRecordChange } from '../../services/time-changes.ts'
import { elapsedSinceRecord } from '../../services/time-format.ts'
import { todayDate } from '../../services/dashboard.ts'
import { durationLabel, summaryDonutLabels, timeSummary } from '../../services/dashboard-format.ts'
import { openBusinessLink, openQuickNavEditor } from '../../services/navigation.ts'
import { nativeDestination } from '../../services/life-catalog.ts'
import LifeMenuIcon from '../../components/LifeMenuIcon.uvue'
import CategoryIcon from '../../components/CategoryIcon.uvue'
import spacing from '../../styles/spacing.json'

const viewportWidth = ref(uni.getWindowInfo().windowWidth)
const quickIconSize = computed(() => viewportWidth.value < 640 ? 20 : 24)
onResize(event => { viewportWidth.value = event.size.windowWidth })
const loading = ref(false)
const refreshing = ref(false)
async function pullRefresh() {
  if (refreshing.value) return
  refreshing.value = true
  await nextTick()
  try { if (refreshTask) await refreshTask; await refresh() } finally { refreshing.value = false }
}
const errorText = ref('')
const cards = ref<OverviewCard[]>([])
const overview = reactive({ loading: false, error: '' })
const links = ref<QuickLink[]>([])
const thoughts = ref<Thought[]>([])
const watched = ref<WatchedTask[]>([])
const exercise = ref<ExercisePage>({ days: [] })
const commits = ref<Commit[]>([])
const time = ref(timeSummary([], []))
const timeDonutLabels = computed(() => summaryDonutLabels(time.value.groups))
// 卡片高度只由视口决定，加载、失败和内容状态共用，避免请求完成时页面跳动。
function sectionInset(section: string) {
  return spacing.controlMin + (section === 'exercise' ? 0 : spacing.fieldLabel) + spacing.card + spacing.hairline * 2
}
function sectionHeight(section: string) {
  const limit = viewportWidth.value >= 1024 ? 280 : viewportWidth.value >= 640 ? 250 : 240
  // 窄屏图表与记录分两行，记录区域最多显示两行，保持 44px 点击区。
  if (section === 'time' && viewportWidth.value < 375) return sectionInset(section) + 164 + spacing.controlMin * 2
  return limit
}
const timeDate = ref('')
const nowMinutes = ref(0)
let minuteTimer: ReturnType<typeof setInterval> | null = null
function tickTime() {
  const now = new Date()
  nowMinutes.value = now.getHours() * 60 + now.getMinutes()
  if (timeDate.value && timeDate.value !== todayDate()) loadSection('time')
}
const timeElapsed = computed(() => {
  if (timeDate.value !== todayDate()) return ''
  const minutes = elapsedSinceRecord(time.value.recent, nowMinutes.value)
  return minutes == null ? '' : durationLabel(minutes)
})
const timeEditor = ref<{ recordId: string } | null>(null)
function openTimeRecord(id = '') { timeEditor.value = { recordId: id } }
function closeTimeEditor() {
  timeEditor.value = null
  if (takeRecordChange()) {
    loadSection('time'); loadSection('exercise')
    const card = cards.value.find(item => item.type === 'EXERCISE')
    if (card) loadCard(card)
  }
}
const states = reactive({
  time: { loading: false, error: '' },
  links: { loading: false, error: '' },
  thoughts: { loading: false, error: '' },
  watched: { loading: false, error: '' },
  exercise: { loading: false, error: '' },
  commits: { loading: false, error: '' },
})
const githubBound = computed(() =>
  cards.value.some((item) => item.type === 'GITHUB'),
)
const visibleCards = computed(() =>
  cards.value.filter(
    (item) =>
      item.loading || item.error || (item.value !== '' && item.value != null),
  ),
)
const moreExercise = ref(false)
const moreCommits = ref(false)
const moreErrors = reactive({ exercise: '', commits: '' })
const commitPage = ref(1)
const hasMoreCommits = ref(false)
const pageVersions = { exercise: 0, commits: 0 }
const cardTouchY = { exercise: 0, commits: 0 }
function startCardSwipe(key: string, event) { cardTouchY[key] = event.touches[0]?.clientY || 0 }
function finishCardSwipe(key: string, event) {
  const distance = cardTouchY[key] - (event.changedTouches[0]?.clientY || 0)
  const inset = sectionInset(key)
  const rowsHeight = key === 'exercise'
    ? exercise.value.days.reduce((count, day) => count + day.items.length, 0) * 40
    : commits.value.length * 68
  // 内容不足一屏时没有 scrolltolower，仍支持在卡片上向上滑动加载。
  if (distance > 40 && rowsHeight <= sectionHeight(key) - inset) maybeLoadMore(key)
}
function maybeLoadMore(key: string) {
  if (!moreErrors[key]) loadMore(key)
}
let refreshTask: Promise<void> | null = null
let active = true
let redirecting = false

function goLogin() {
  if (redirecting) return
  redirecting = true
  active = false
  uni.reLaunch({ url: '/pages/login/index' })
}
function handleError(error): string {
  if (error.name === 'SessionExpiredError') {
    if (active) {
      uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
      goLogin()
    }
    return ''
  }
  return error.message || '加载失败，请重试'
}
function isCurrent(token: string) {
  return active && session.token === token
}
onShow(() => {
  active = true
  tickTime()
  if (minuteTimer) clearInterval(minuteTimer)
  minuteTimer = setInterval(tickTime, 60000)
  restoreSession()
  if (!session.token) {
    goLogin()
    return
  }
  if (takeRecordChange()) {
    loadSection('time'); loadSection('exercise')
    const card = cards.value.find(item => item.type === 'EXERCISE')
    if (card) loadCard(card)
    return
  }
  refresh()
})
onHide(() => { active = false; timeEditor.value = null; if (minuteTimer) clearInterval(minuteTimer); minuteTimer = null })
onUnload(() => {
  active = false
  if (minuteTimer) clearInterval(minuteTimer)
})

function refresh() {
  if (refreshTask) return refreshTask
  refreshTask = loadHome().finally(() => { refreshTask = null })
  return refreshTask
}
async function loadHome() {
  loading.value = true
  errorText.value = ''
  const token = session.token
  try {
    await fetchUser()
    if (!isCurrent(token)) return
    await Promise.all([
      loadOverview(),
      loadSection('time'),
      loadSection('links'),
      loadSection('thoughts'),
      loadSection('watched'),
      loadSection('exercise'),
    ])
  } catch (error) {
    if (active) errorText.value = handleError(error)
  } finally {
    loading.value = false
  }
}
async function loadOverview() {
  if (overview.loading) return
  overview.loading = true
  overview.error = ''
  const token = session.token
  try {
    const items = await getOverview()
    if (!isCurrent(token)) return
    cards.value = items.map((item) => ({ ...(refreshing.value ? cards.value.find(card => card.type === item.type) : {}), ...item, loading: false, error: '' }))
    await Promise.all([
      ...cards.value.map((item) => loadCard(item)),
      ...(githubBound.value ? [loadSection('commits')] : []),
    ])
  } catch (error) {
    if (active) overview.error = handleError(error)
  } finally {
    overview.loading = false
  }
}
async function loadCard(item: OverviewCard) {
  if (item.loading) return
  item.loading = true
  item.error = ''
  const token = session.token
  try {
    const data = await getCard(item.type)
    if (data == null) throw new Error('卡片数据为空，请重试')
    if (isCurrent(token)) Object.assign(item, data)
  } catch (error) {
    if (active) item.error = handleError(error)
  } finally {
    item.loading = false
  }
}
async function loadSection(key: string) {
  const state = states[key]
  if (state.loading) return
  state.loading = true
  state.error = ''
  if (key === 'exercise' || key === 'commits') pageVersions[key]++
  const token = session.token
  try {
    if (key === 'time') {
      const requestedDate = todayDate()
      const data = await getTime(requestedDate)
      if (isCurrent(token)) {
        time.value = timeSummary(data.categories, data.records)
        timeDate.value = requestedDate
      }
    }
    if (key === 'links') {
      const data = await getQuickLinks()
      if (isCurrent(token))
        links.value = data
          .filter((item) => item.enabled === 1)
          .sort((a, b) => a.sortOrder - b.sortOrder)
    }
    if (key === 'thoughts') {
      const data = await getThoughts()
      if (isCurrent(token)) thoughts.value = data
    }
    if (key === 'watched') {
      const data = await getWatched()
      if (isCurrent(token)) watched.value = data
    }
    if (key === 'exercise') {
      const data = await getExercises()
      if (isCurrent(token)) {
        exercise.value = data
        moreErrors.exercise = ''
      }
    }
    if (key === 'commits') {
      const data = await getCommits()
      if (isCurrent(token)) {
        commits.value = data
        commitPage.value = 1
        hasMoreCommits.value = data.length === 10
        moreErrors.commits = ''
      }
    }
  } catch (error) {
    if (active) state.error = handleError(error)
  } finally {
    state.loading = false
  }
}
async function loadMore(key: string) {
  const isExercise = key === 'exercise'
  if (!active || states[key].loading || (isExercise ? moreExercise.value : moreCommits.value)) return
  if (isExercise ? !exercise.value.hasMore : !hasMoreCommits.value) return
  const busy = isExercise ? moreExercise : moreCommits
  busy.value = true
  moreErrors[key] = ''
  const version = pageVersions[key]
  const token = session.token
  try {
    if (isExercise) {
      const data = await getExercises(exercise.value.lastDate || '')
      if (isCurrent(token) && pageVersions[key] === version)
        exercise.value = {
          ...data,
          days: [...exercise.value.days, ...data.days],
          hasMore: data.hasMore && data.days.length > 0,
        }
    } else {
      const data = await getCommits(commitPage.value + 1)
      if (isCurrent(token) && pageVersions[key] === version) {
        commits.value = [...commits.value, ...data.filter(item => !commits.value.some(existing => existing.id === item.id))]
        commitPage.value++
        hasMoreCommits.value = data.length === 10 && commitPage.value < 100
      }
    }
  } catch (error) {
    if (isCurrent(token) && pageVersions[key] === version) moreErrors[key] = handleError(error)
  } finally {
    busy.value = false
  }
}
function openLink(path: string) { openBusinessLink(path) }
function openOverview(item) {
  if(item.error){loadCard(item);return}
  const destination=item.titleClickUrl || item.iconClickUrl || ''
  if(destination==='action:open-time-tracker-modal' || item.type==='TIME_TRACKER'){openTimeRecord();return}
  if(destination==='action:open-exercise-modal' || item.type==='EXERCISE'){addExercise();return}
  if(destination){openBusinessLink(destination);return}
  const pages={GITHUB:'/coding/github',LEETCODE:'/coding/leetcode'}
  if(pages[item.type])openBusinessLink(pages[item.type])
}
const taskBusy = ref('')
function openWatched(task) {uni.navigateTo({url:'/pages/tasks/todo?detailId='+encodeURIComponent(task.id)+(task.taskId?'&taskId='+encodeURIComponent(task.taskId):'')})}
function openThought(thought) {uni.navigateTo({url:'/pages/records/notes?kind=think&editId='+encodeURIComponent(thought.id)})}
function addThought() { uni.navigateTo({ url: '/pages/records/notes?kind=think&create=1' }) }
function addExercise(){uni.navigateTo({url:'/pages/records/exercise?create=1'})}
async function completeWatched(task) {
  if(taskBusy.value) return
  taskBusy.value=task.id;states.watched.error='';const token=session.token
  try {await request('/taskDetails','PUT',{id:task.id,isCompleted:task.isCompleted===1?0:1});if(isCurrent(token))await loadSection('watched')}
  catch(e){if(isCurrent(token))states.watched.error=e.message}
  finally {taskBusy.value=''}
}

function cardIcon(item: OverviewCard) {
  const icons = {
    LEETCODE: isDark.value ? 'platform:leetcode' : 'devicon:leetcode', GITHUB: 'simple-icons:github',
    EXERCISE: 'mdi:run', TIME_TRACKER: 'lucide:clock',
    READ: 'svg:weread', WEREAD: 'svg:weread', SHANBAY: 'svg:shanbay',
  }
  return icons[item.type] || item.icon || 'lucide:layout-dashboard'
}
function openFeatureSearch() {
  uni.switchTab({ url: '/pages/life/index' })
}
function linkIcon(link: QuickLink) {
  if (iconCatalog.icons[link.icon || ''] || link.icon?.startsWith('svg:')) return link.icon
  const icons = [
    ['待办', 'lucide:list-checks'], ['目标', 'lucide:crosshair'],
    ['时', 'lucide:clock'], ['运动', 'lucide:activity'],
    ['闪念', 'lucide:lightbulb'], ['github', 'simple-icons:github'],
    ['设备', 'lucide:monitor'], ['关系', 'lucide:users'],
    ['用户', 'lucide:users'], ['支出', 'lucide:banknote'],
    ['笔记', 'lucide:file-text'], ['备忘', 'lucide:file-text'],
    ['密码', 'lucide:key-round'],
  ]
  return icons.find(([name]) => link.title.toLowerCase().includes(name))?.[1] || 'lucide:layout-dashboard'
}
function weekday(date: string) {
  return (
    ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][
      new Date(date + 'T12:00:00').getDay()
    ] || ''
  )
}
function shortDate(date: string) {
  return date ? date.slice(5, 16).replace('T', ' ') : ''
}
function trendPoints(points) {
  const values = points.map((point) => point.count)
  const min = Math.min(...values)
  const max = Math.max(...values)
  return points.map((point, index) => ({
    x: points.length === 1 ? 60 : 4 + (index * 56) / (points.length - 1),
    y: max === min ? 14 : 21 - ((point.count - min) / (max - min)) * 14,
  }))
}
function trendLines(points) {
  const dots = trendPoints(points)
  return dots.slice(1).map((point, index) => {
    const previous = dots[index]
    const dx = point.x - previous.x
    const dy = point.y - previous.y
    return {
      left: previous.x + 'px',
      top: previous.y + 'px',
      width: Math.sqrt(dx * dx + dy * dy) + 'px',
      transform: 'rotate(' + (Math.atan2(dy, dx) * 180) / Math.PI + 'deg)',
    }
  })
}
</script>

<template>
  <view class="dashboard-page" :class="themeClass('dashboard-page')">
    <!-- #ifndef WEB -->
    <PageHeader title="">
      <button role="button" class="home-search ui-row ui-px-card" :class="themeClass('home-search')" aria-label="查找功能" @click="openFeatureSearch">
        <AppIcon name="lucide:search" :size="20" color="#8b8f99" />
        <text class="home-search-label">搜索功能</text>
      </button>
    </PageHeader>
    <!-- #endif -->
    <scroll-view scroll-y :show-scrollbar="false" class="dashboard-scroll" :refresher-enabled="true" :refresher-triggered="refreshing" refresher-background="transparent" :refresher-default-style="refreshTheme" @refresherrefresh="pullRefresh"
      ><view class="dashboard-content ui-page-inset ui-tab-page-inset">
        <view v-if="errorText" class="global-error" role="alert"
          ><text class="failure-text" :class="themeClass('failure-text')">{{ errorText }}</text
          ><button role="button" class="text-button ui-pad-sm" @click="refresh">
            重新加载
          </button></view
        >
        <view v-if="overview.error" class="global-error" role="alert"
          ><text class="failure-text" :class="themeClass('failure-text')">{{ overview.error }}</text
          ><button role="button" class="text-button ui-pad-sm" @click="loadOverview">
            重试统计卡片
          </button></view
        >
        <view class="overview-grid">
          <view
            v-if="(loading || overview.loading) && cards.length === 0"
            v-for="n in 4"
            :key="n"
            class="overview-cell ui-pad-xs"
            ><view class="overview-card placeholder-card ui-pad-card"
               :class="themeClass('overview-card')"><ContentSkeleton variant="summary" label="正在加载概览" /></view
            ></view
          >
          <view
            v-for="item in visibleCards"
            :key="item.type"
            class="overview-cell ui-pad-xs"
          >
            <button
              role="button"
              class="overview-card ui-pad-card"
              :aria-label="
                item.error ? '重试' + item.title : item.title
              "
              :disabled="item.loading"
              @click="openOverview(item)"
             :class="themeClass('overview-card')">
              <view v-if="item.loading" class="card-progress"
                ><view class="card-progress-bar"></view
              ></view>
              <view class="stat-top"
                ><view class="stat-name"
                  ><view class="stat-icon"><LifeMenuIcon :icon="cardIcon(item)" :size="18" :color="isDark ? '#d4d4d8' : '#52525b'" /></view><text class="stat-title" :class="themeClass('stat-title')">{{ item.title }}</text></view
                ><text
                  class="stat-value"
                  :style="{ color: item.valueColor || '' }"
                   :class="themeClass('stat-value')">{{
                    item.value == null || item.value === '' ? '—' : item.value
                  }}</text
                ></view
              >
              <view class="stat-bottom"
                ><text class="stat-caption" :class="themeClass('stat-caption')">{{
                  item.error
                    ? '加载失败，点击重试'
                    : item.totalTitle || ''
                }}</text
                ><text class="stat-total" :class="themeClass('stat-total')">{{
                  item.totalValue == null ? '—' : item.totalValue
                }}</text></view
              >
            </button>
          </view>
        <SecondaryUnlock />
  </view>
        <view class="section-grid ui-mt-xs">
          <view class="section-cell ui-pad-xs"
            ><DashboardSection
              title="时迹" skeleton="timeline"
              :height="sectionHeight('time')"
              :loading="states.time.loading && !refreshing"
              :error="states.time.error"
              @refresh="loadSection('time')"
            >
              <template #actions>
                <DashboardAction label="新增时迹" :text="timeElapsed" :disabled="states.time.loading" @click="openTimeRecord()" />
              </template>
              <view class="time-layout">
                <view class="timeline-labels"
                  ><text class="axis-label">0</text
                  ><view class="timeline"
                     :class="themeClass('timeline')"><view
                      v-for="block in time.timeline"
                      :key="block.id"
                      class="timeline-block"
                      :style="block"
                    ></view></view
                  ><text class="axis-label">24</text></view
                >
                <view class="donut-stage"><view
                  class="donut"
                  role="img"
                  :aria-label="'今日已记录 ' + time.total"
                  ><view class="donut-ring" :class="themeClass('donut-ring')"></view
                  ><view
                    v-for="(segment, index) in time.segments"
                    :key="index"
                    class="donut-arm"
                    :style="{ transform: segment.transform }"
                    ><view
                      class="donut-segment"
                      :style="{ backgroundColor: segment.backgroundColor }"
                    ></view></view
                  ><text v-if="time.segments.length" class="donut-total" :class="themeClass('donut-total')">{{
                    time.total
                  }}</text>
                  <view v-for="label in timeDonutLabels" :key="label.id" class="donut-annotation">
                    <view v-for="(line, index) in label.lines" :key="index" class="donut-leader" :style="line" />
                    <view class="donut-label" :class="['donut-label-' + label.side, themeClass('donut-label')]" :style="label.position">
                      <text class="donut-label-name">{{ label.name }}</text>
                      <text class="donut-label-duration">{{ label.duration }}</text>
                    </view>
                  </view>
                </view></view>
                <scroll-view scroll-y :show-scrollbar="false" class="recent-times ui-ml-sm"><view class="recent-time-list"
                  ><text v-if="time.recent.length === 0" class="empty-label"
                     :class="themeClass('empty-label')">今日暂无记录</text
                  ><button role="button"
                    v-for="record in time.recent"
                    :key="record.id"
                    class="time-record" :aria-label="'编辑时迹 ' + record.name" @click="openTimeRecord(record.id)"
                    :style="{ color: record.color }"
                    ><text class="record-clock">{{ record.startLabel }}</text>
                    <text class="record-duration">{{ record.durationLabel }}</text>
                    <text class="record-name">{{ record.shortName }}</text></button
                  ></view></scroll-view>
              </view>
            </DashboardSection></view
          >
          <view class="section-cell ui-pad-xs"
            ><DashboardSection
              title="快捷导航" skeleton="grid"
              :height="sectionHeight('links')"
              :loading="states.links.loading && !refreshing"
              :error="states.links.error"
              @refresh="loadSection('links')"
            >
              <template #actions>
                <DashboardAction label="管理快捷导航" icon="lucide:settings-2" @click="openQuickNavEditor" />
              </template>
              <view v-if="links.length === 0" class="empty-state ui-pad-card"
                ><AppIcon name="ant-design:appstore-outlined" :size="32" color="#8b8f99" /><text class="empty-label" :class="themeClass('empty-label')">暂无快捷方式</text
                ><button
                  role="button"
                  class="text-button ui-pad-sm"
                  @click="openQuickNavEditor"
                >
                  添加常用功能
                </button></view
              >
              <scroll-view v-else scroll-y :show-scrollbar="false" class="quick-scroll"><view class="quick-grid"
                ><button
                  v-for="link in links"
                  :key="link.menuId"
                  role="button"
                  class="quick-link"
                  :aria-label="link.title + (nativeDestination(link.path) ? '' : '（网页版）')"
                  @click="openLink(link.path)"
                >
                  <LifeMenuIcon :icon="linkIcon(link)" :size="quickIconSize" :color="isDark ? '#e4e4e7' : '#27272a'" /><text class="quick-title" :class="themeClass('quick-title')">{{ link.title }}</text><text v-if="!nativeDestination(link.path)" class="quick-platform">网页版</text>
                </button></view></scroll-view>
            </DashboardSection></view
          >
          <view
            v-if="
              states.watched.loading || states.watched.error || watched.length
            "
            class="section-cell ui-pad-xs"
            ><DashboardSection
              title="待办"
              :height="sectionHeight('watched')"
              :loading="states.watched.loading && !refreshing"
              :error="states.watched.error"
              @refresh="loadSection('watched')"
              ><scroll-view scroll-y :show-scrollbar="false" class="list-scroll"
                ><view
                  v-for="task in watched"
                  :key="task.id"
                  class="list-row task-row ui-pad-sm"
                  ><button role="button" class="task-check" :aria-label="task.isCompleted === 1 ? '标记未完成' : '完成待办'" :aria-busy="taskBusy === task.id" :loading="taskBusy === task.id" :disabled="!!taskBusy" @click="completeWatched(task)"><CategoryIcon v-if="taskBusy !== task.id" :icon="task.isCompleted === 1 ? 'lucide:circle-check' : 'lucide:circle'" :size="20" :color="task.isCompleted === 1 ? '#5b8ff9' : isDark ? '#a1a1aa' : '#71717a'" /></button><view class="task-copy" role="button" :aria-label="'编辑待办 '+task.content" @click="openWatched(task)"
                    ><view class="task-main"><text v-if="task.priority === 1 || task.priority === 10 || task.priority === 20" class="task-priority" :class="task.priority === 1 ? 'priority-high' : task.priority === 10 ? 'priority-medium' : 'priority-low'">{{ task.priority === 1 ? '高' : task.priority === 10 ? '中' : '低' }}</text><text class="body-text" :class="[{ completed: task.isCompleted === 1 }, themeClass('body-text')]">{{ task.content }}</text></view>
                    <text v-if="task.taskName" class="tag" :class="themeClass('tag')">{{ task.taskName }}</text></view
                  ></view
                ></scroll-view
              ></DashboardSection
            ></view
          >
          <view class="section-cell ui-pad-xs"
            ><DashboardSection
              title="闪念"
              compact
              :height="sectionHeight('thoughts')"
              :loading="states.thoughts.loading && !refreshing"
              :error="states.thoughts.error"
              @refresh="loadSection('thoughts')"
              ><template #actions><DashboardAction label="新增闪念" @click="addThought" /></template><view v-if="thoughts.length === 0" class="empty-state ui-pad-card"
                ><AppIcon name="ant-design:inbox-outlined" :size="32" color="#8b8f99" /><text class="empty-label" :class="themeClass('empty-label')">暂无固定的闪念</text></view
              ><scroll-view v-else scroll-y :show-scrollbar="false" class="list-scroll"
                ><view
                  v-for="thought in thoughts"
                  :key="thought.id"
                  class="list-row thought-row ui-pad-sm" role="button" :aria-label="'编辑闪念'" @click="openThought(thought)"
                  ><text class="thought-text" :class="themeClass('thought-text')">{{
                    thought.hiddenContent ? '内容已隐藏' : thought.content
                  }}</text
                  ><text class="list-date ui-ml-section">{{
                    (thought.createTime || '').slice(5, 10)
                  }}</text></view
                ></scroll-view
              ></DashboardSection
            ></view
          >
          <view
            v-if="
              states.exercise.loading ||
              states.exercise.error ||
              exercise.days.length
            "
            class="section-cell ui-pad-xs"
            ><DashboardSection
              title="运动"
              icon="mdi:run"
              compact
              flush-top
              :height="sectionHeight('exercise')"
              :loading="states.exercise.loading && !refreshing"
              :error="states.exercise.error"
              @refresh="loadSection('exercise')"
              ><template #actions><DashboardAction label="新增运动" @click="addExercise" /></template><scroll-view scroll-y :show-scrollbar="false" class="list-scroll exercise-scroll" :lower-threshold="40" @scrolltolower="maybeLoadMore('exercise')" @touchstart="startCardSwipe('exercise', $event)" @touchend="finishCardSwipe('exercise', $event)"
                ><view
                  v-for="day in exercise.days"
                  :key="day.date"
                  class="exercise-day"
                  ><view
                    v-for="(item, itemIndex) in day.items"
                    :key="item.exerciseTypeId"
                    class="exercise-item"
                    ><view class="exercise-date"><text v-if="itemIndex === 0" class="day-label" :class="themeClass('day-label')">{{ day.date.slice(5) }}</text><text v-if="itemIndex === 0" class="weekday">{{ weekday(day.date) }}</text></view>
                    <view class="exercise-details">
                      <view class="exercise-main"><CategoryIcon :icon="item.icon || 'mdi:run'" :size="14" :color="item.color || '#5b8ff9'" /><text class="exercise-name" :class="themeClass('exercise-name')">{{ item.typeLabel }}</text><text class="exercise-count" :class="themeClass('exercise-count')">{{ item.count }}</text></view>
                      <text v-if="item.deltaCount != null" class="exercise-delta" :class="item.deltaCount > 0 ? 'delta-up' : item.deltaCount < 0 ? 'delta-down' : ''">{{ item.deltaCount > 0 ? '↑ +' + item.deltaCount : item.deltaCount < 0 ? '↓ ' + item.deltaCount : '—' }}</text>
                    </view
                    ><view
                      v-if="item.trend && item.trend.length"
                      class="trend ui-ml-section"
                      role="img"
                      :aria-label="
                        item.typeLabel +
                        '最近' +
                        item.trend.length +
                        '次记录趋势'
                      "
                      ><view
                        v-for="(line, index) in trendLines(item.trend)"
                        :key="index"
                        class="trend-line"
                        :style="{
                          ...line,
                          backgroundColor: item.color || '#3b82f6',
                        }"
                      ></view
                      ><view
                        v-for="(point, index) in trendPoints(item.trend).slice(-1)"
                        :key="index"
                        class="trend-dot"
                        :style="{
                          left: point.x - 1 + 'px',
                          top: point.y - 1 + 'px',
                          backgroundColor: item.color || '#3b82f6',
                        }"
                      ></view></view></view></view
                > <view v-if="moreExercise || moreErrors.exercise" class="pagination-status">
                  <view v-if="moreExercise" class="pagination-spinner" role="status" aria-label="正在加载更多运动" />
                  <button v-else role="button" class="pagination-retry" aria-label="加载失败，重试更多运动" @click="loadMore('exercise')"><CategoryIcon icon="lucide:rotate-cw" :size="16" :color="isDark ? '#a9bfff' : '#5879ce'" /></button>
                </view></scroll-view
              ></DashboardSection
            ></view
          >
          <view v-if="githubBound" class="section-cell ui-pad-xs"
            ><DashboardSection
              title="最近提交"
              icon="simple-icons:github"
              :height="sectionHeight('commits')"
              :loading="states.commits.loading && !refreshing"
              :error="states.commits.error"
              @refresh="loadSection('commits')"
              ><view v-if="commits.length === 0" class="empty-state ui-pad-card"
                ><text class="empty-label" :class="themeClass('empty-label')">暂无最近提交</text></view
              ><scroll-view v-else scroll-y :show-scrollbar="false" class="list-scroll commits-scroll" :lower-threshold="40" @scrolltolower="maybeLoadMore('commits')" @touchstart="startCardSwipe('commits', $event)" @touchend="finishCardSwipe('commits', $event)"
                ><view
                  v-for="(commit, index) in commits"
                  :key="commit.id || index"
                  class="commit-row"
                  ><view class="commit-top"
                    ><text class="repo-label" :class="themeClass('repo-label')">{{ commit.repo }}</text
                    ><text class="list-date ui-ml-section">{{
                      shortDate(commit.date)
                    }}</text></view
                  ><text class="commit-message" :class="themeClass('commit-message')">{{
                    commit.message
                  }}</text></view
                > <view v-if="moreCommits || moreErrors.commits" class="pagination-status">
                  <view v-if="moreCommits" class="pagination-spinner" role="status" aria-label="正在加载更多提交" />
                  <button v-else role="button" class="pagination-retry" aria-label="加载失败，重试更多提交" @click="loadMore('commits')"><CategoryIcon icon="lucide:rotate-cw" :size="16" :color="isDark ? '#a9bfff' : '#5879ce'" /></button>
                </view></scroll-view
              ></DashboardSection
            ></view
          >
        </view>
      </view></scroll-view
    >
    <TimeRecordEditor v-if="timeEditor" :record-id="timeEditor.recordId" @close="closeTimeEditor" />
  </view>
</template>

