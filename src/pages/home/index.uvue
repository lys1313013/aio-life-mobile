.exercise-name { margin-left: $space-fieldLabel; min-width: 0; flex-shrink: 1; color: #52525b; @include type-style('caption');  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.exercise-count { flex-shrink: 0; color: #27272a; @include type-style('label-strong');   margin-left: $space-fieldLabel; }
.exercise-delta { flex-shrink: 0; color: #92929b; @include type-style('chart-label');  margin-left: $space-inline; }
.delta-up { color: #319d77; }
.delta-down { color: #e26279; }
.trend {
  position: relative;
  width: 64px;
  height: 28px;
  flex-shrink: 0;

  overflow: visible;
}
.trend-line {
  position: absolute;
  height: 1px;
  transform-origin: left center;
  opacity: 0.85;
}
.trend-dot {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 2px;
}
.pagination-status { height: 44px; flex-shrink: 0; align-items: center; justify-content: center; }
.pagination-spinner { width: 14px; height: 14px; border: 2px solid #a9bfff; border-top-color: transparent; border-radius: 7px; animation: pagination-spin 0.8s linear infinite; }
@keyframes pagination-spin { to { transform: rotate(360deg); } }
.pagination-retry { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: 0; padding: 0; border: 0; background-color: transparent; }
.commit-row {
  box-sizing: border-box;
  min-height: 68px;
  padding: $space-inline $space-inline;
}
.commit-top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.repo-label {
  color: #52525b;
  @include type-style('caption-strong');

  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}
.commit-message {
  color: #71717a;
  @include type-style('caption');

  margin-top: $space-tight;
}
.text-button {
  background-color: transparent;
  border: 0;
  color: #5879ce;
  @include type-style('caption');

  margin: 0;
}
.global-error {
  padding: $space-inline $space-section;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.failure-text {
  color: #bc4949;
  @include type-style('caption');
  flex: 1;
}
@media (max-width: 480px) {
  .dashboard-content {

  }
  .overview-card {

    height: 82px;
  }
  .stat-title-text {
    @include type-style('label-strong');
  }
}
@media (min-width: 768px) {
  .overview-cell { width: 25%; }
  .thought-text, .body-text, .repo-label { @include type-style('body'); }
  .commit-message { @include type-style('label');  }
  .list-date { @include type-style('badge'); }
  .task-copy { flex-direction: row; align-items: center; flex-wrap: wrap; }
  .task-dates { width: 100%; }
  .task-main { flex: 1; min-width: 0; }
  .tag { align-self: center; max-width: 72px; margin-top: 0; margin-left: $space-inline; }
  .section-cell {
    width: 50%;
  }
}
@media (min-width: 1400px) {
  .time-record, .record-clock, .record-duration, .record-name { @include type-style('caption'); }
}
@media (min-width: 1200px) {
  /* 内容最大宽度下三列卡片较窄，为圆环标签与记录保留各自空间。 */
  .donut { transform: scale(0.8); }
  .recent-times { width: 100px; }
  .dashboard-content {

  }
  .overview-cell {
    width: 20%;
    flex-grow: 1;

  }
  .overview-card {
    height: 94px;
  }
  .section-cell {
    width: 33.3333%;

  }
}

  .dashboard-page-dark {
    background-color: #111215;
  }
  .overview-card-dark {
    background-color: #1c1e22;
    border-color: #303238;
  }
  .stat-title-text-dark,
  .stat-value-dark,
  .donut-total-dark {
    color: #eeeeef;
  }
  .home-label-dark {
    color: #93b0ff;
  }
  .stat-caption-dark,
  .stat-total-dark,
  .empty-label-dark {
    color: #9c9ca6;
  }
  .body-text-dark,
  .thought-text-dark,
  .quick-title-dark,
  .record-name-dark,
  .day-label-dark,
  .exercise-name-dark,
  .exercise-count-dark,
  .repo-label-dark {
    color: #d0d0d6;
  }
  .timeline-dark,
  .tag-dark,
  .cancel-button-dark {
    background-color: #292d35;
  }
  .donut-ring-dark {
    border-color: #555960;
  }
  .commit-message-dark {
    color: #a6a6b0;
  }
  .failure-text-dark {
    color: #f7a3a3;
  }

.time-skeleton-fill { background-color: #e8e8ed; border-radius: 4px; }
.time-skeleton-fill-dark { background-color: #303238; }
.time-skeleton-ring { border-color: #e8e8ed; }
.time-skeleton-ring-dark { border-color: #303238; }

/* #ifdef WEB || MP-WEIXIN */
.tool-button::after,
.overview-card::after,
.stat-link::after,
.quick-link::after,
.text-button::after,
.pagination-retry::after,
.cancel-button::after,
.confirm-button::after {
  border: 0;
}
/* #endif */

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.text-button-label { color: #5879ce; @include type-style('caption'); }
</style>
