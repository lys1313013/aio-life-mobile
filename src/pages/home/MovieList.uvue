<script setup lang="ts">
import { computed } from 'vue'
import LibraryCover from '../../components/LibraryCover.uvue'
import LoadingIndicator from '../../components/LoadingIndicator.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import { isDark } from '../../services/theme.ts'
import spacing from '../../styles/spacing.json'
import { businessCardMaxHeight } from './services/business-cards.ts'

const props = defineProps<{ rows: any[]; loading: boolean; moreLoading: boolean; error: string }>()
const emit = defineEmits<{ edit: [item: any]; more: []; retry: [] }>()
// 双列三行首屏，海报保持 2:3；高度扣除卡片标题、底部留白和边框。
const bodyMaxHeight = businessCardMaxHeight - spacing.controlMin - spacing.card - spacing.hairline * 2
const rowHeight = bodyMaxHeight / 3
const coverHeight = rowHeight - spacing.inline * 2
const coverWidth = coverHeight * 2 / 3
const pending = computed(() => props.loading && props.rows.length === 0)
const height = computed(() => Math.min(bodyMaxHeight,
  (pending.value ? 3 : Math.ceil(props.rows.length / 2)) * rowHeight
  + (props.moreLoading || props.error ? spacing.controlMin : 0)))
function loadMore() {
  if (!pending.value && !props.loading && !props.moreLoading && !props.error) emit('more')
}
</script>

<template>
  <scroll-view :scroll-y="true" :show-scrollbar="false" :lower-threshold="40" class="movie-scroll" :style="{ height: height + 'px' }" aria-label="观影列表" @scrolltolower="loadMore">
    <view class="movie-grid" :class="{ 'movie-pending': pending }" :role="pending ? 'status' : undefined" :aria-label="pending ? '正在加载观影' : undefined">
      <template v-if="pending">
        <view v-for="index in 6" :key="index" class="movie-cell" :style="{ height: rowHeight + 'px' }" aria-hidden="true">
          <view class="movie-skeleton movie-cover" :class="{ 'movie-skeleton-dark': isDark }" :style="{ width: coverWidth + 'px', height: coverHeight + 'px' }" />
          <view class="movie-copy"><view class="movie-skeleton movie-skeleton-title" :class="{ 'movie-skeleton-dark': isDark }" /><view class="movie-skeleton movie-skeleton-caption" :class="{ 'movie-skeleton-dark': isDark }" /></view>
        </view>
      </template>
      <template v-else>
        <view v-for="item in rows" :key="item.id" class="movie-cell" :style="{ height: rowHeight + 'px' }" role="button" tabindex="0" :aria-label="'编辑' + (item.title || '未命名')" @click="emit('edit', item)" @keydown.enter="emit('edit', item)" @keydown.space.prevent="emit('edit', item)">
          <view class="movie-cover" :style="{ width: coverWidth + 'px', height: coverHeight + 'px' }"><LibraryCover :file-id="item.fileId || ''" :url="item.coverImgUrl || ''" :title="item.title || '未命名'" kind="movie" compact tiny /></view>
          <view class="movie-copy">
            <text class="movie-title" :class="{ 'movie-title-dark': isDark }">{{ item.title || '未命名' }}</text>
            <view class="movie-meta"><view class="movie-dot" :class="{ 'movie-dot-active': item.status === 'in_progress' }" /><text class="movie-caption" :class="{ 'movie-caption-dark': isDark }">{{ item.status === 'in_progress' ? '在看' : '想看' }}</text></view>
          </view>
        </view>
      </template>
    </view>
    <view v-if="moreLoading || error" class="movie-status">
      <LoadingIndicator v-if="moreLoading" compact label="正在加载更多观影" />
      <template v-else><text class="movie-error">{{ error }}</text><button role="button" class="movie-retry" aria-label="重试观影分页" @click="emit('retry')"><AppIcon name="lucide:rotate-cw" :size="18" :color="isDark ? '#9bbcff' : '#5879ce'" /></button></template>
    </view>
  </scroll-view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.movie-scroll { width: 100%; min-height: 0; }
.movie-grid { display: flex; flex-direction: row; flex-wrap: wrap; padding: 0 $space-card; }
.movie-cell { width: 50%; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; gap: $space-inline; padding: $space-detail; min-width: 0; }
.movie-cover { position: relative; flex-shrink: 0; border-radius: 6px; overflow: hidden; }
.movie-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: $space-detail; }
.movie-title { @include type-style('label-strong'); color: #3f3f46; overflow: hidden;
/* #ifndef APP */
display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
/* #endif */
/* #ifdef APP */
max-lines: 2; text-overflow: ellipsis;
/* #endif */
}
.movie-title-dark { color: #ececf0; }
.movie-meta { display: flex; flex-direction: row; align-items: center; gap: $space-detail; }
.movie-dot { width: 4px; height: 4px; border-radius: 50%; background-color: #8b8f99; flex-shrink: 0; }
.movie-dot-active { background-color: #618f9d; }
.movie-caption { @include type-style('caption'); color: #71717a; }
.movie-caption-dark { color: #a6a6b0; }
.movie-skeleton { background-color: #e8ecf1; border-radius: 4px; }
.movie-skeleton-dark { background-color: #30343b; }
.movie-skeleton-title { width: 80%; height: type-line('label-strong'); }
.movie-skeleton-caption { width: 45%; height: type-line('caption'); }
.movie-pending { animation: movie-breathe 1.8s ease-in-out infinite; }
.movie-status { height: $space-controlMin; display: flex; flex-direction: row; align-items: center; padding: 0 $space-card; }
.movie-error { @include type-style('caption'); color: #c26161; flex: 1; min-width: 0; }
.movie-retry { width: $space-controlMin; height: $space-controlMin; display: flex; align-items: center; justify-content: center; padding: 0; margin: 0; background-color: transparent; }
/* #ifdef WEB || MP-WEIXIN */
.movie-retry::after { border: 0; }
/* #endif */
/* #ifdef WEB */
.movie-scroll :deep(.uni-scroll-view) { overscroll-behavior-y: contain; }
/* #endif */
@keyframes movie-breathe { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
@media (prefers-reduced-motion: reduce) { .movie-pending { animation: none; } }
</style>
