<script setup lang="ts">
import { computed, onMounted, onUnmounted, ref, watch } from 'vue'
import AdaptiveModal from '../../components/AdaptiveModal.uvue'
import MobileButton from '../../components/MobileButton.uvue'
import LifeMenuIcon from '../../components/LifeMenuIcon.uvue'
import AppIcon from '../../components/AppIcon.uvue'
import LoadingIndicator from '../../components/LoadingIndicator.uvue'
import { useQuickNavDrag } from './services/use-quick-nav-drag.ts'
import { request } from '../../services/api.ts'
import { saveLifeQuickLinks } from '../../services/life.ts'
import { QUICK_NAV_MAX } from '../../services/life-catalog.ts'
import { menuVisuals } from '../../services/menu-visuals.ts'
import { isDark, themeClass } from '../../services/theme.ts'
import type { QuickLink } from '../../services/dashboard.ts'

const props = withDefaults(defineProps<{ items: QuickLink[]; startPicker?: boolean; saveSignal: number }>(), { startPicker: false })
const emit = defineEmits(['saved', 'busy', 'dragging'])
const draft = ref<QuickLink[]>(props.items.map(item => ({ ...item })))
const candidates = ref<QuickLink[]>([])
const loading = ref(false)
const candidatesLoaded = ref(false)
const saving = ref(false)
const error = ref('')
const saveError = ref('')
const picking = ref(false)
const query = ref('')
const expandedGroups = ref<string[]>([])
let active = true
const drag = useQuickNavDrag({
  items: () => draft.value,
  disabled: () => saving.value || picking.value,
  reorder: ids => {
    const byId = new Map(draft.value.map(item => [item.menuId, item]))
    draft.value = ids.map(id => byId.get(id)!)
  },
  dragging: value => emit('dragging', value),
})
const choices = computed(() => candidates.value.filter(item =>
  !draft.value.some(saved => saved.menuId === item.menuId) &&
  (item.title + ' ' + (item.parentTitle || '')).toLowerCase().includes(query.value.trim().toLowerCase()),
))
// 与 Web 选择器相同，按接口返回的父菜单归组，不在每一行重复父菜单名称。
const choiceGroups = computed(() => {
  const groups = new Map<string, QuickLink[]>()
  for (const item of choices.value) {
    const title = item.parentTitle?.trim() || '其他'
    if (!groups.has(title)) groups.set(title, [])
    groups.get(title)!.push(item)
  }
  return Array.from(groups, ([title, items]) => ({ title, items }))
})
function groupExpanded(title: string) {
  return !!query.value.trim() || expandedGroups.value.includes(title)
}
function toggleGroup(title: string) {
  if (query.value.trim()) return
  expandedGroups.value = expandedGroups.value.includes(title)
    ? expandedGroups.value.filter(item => item !== title) : [...expandedGroups.value, title]
}

async function loadCandidates() {
  if (loading.value || candidatesLoaded.value) return
  loading.value = true
  error.value = ''
  try {
    const available = await request<QuickLink[]>('/quick-nav/candidates?client=mobile')
    if (!active) return
    if (!Array.isArray(available) || available.some(item => !item || typeof item.menuId !== 'string' || typeof item.path !== 'string' || typeof item.title !== 'string'))
      throw new Error('功能目录数据异常，请重试')
    candidates.value = available
    candidatesLoaded.value = true
  } catch (reason) {
    if (active) error.value = reason instanceof Error ? reason.message : '加载失败，请重试'
  } finally {
    if (active) loading.value = false
  }
}
function openPicker() {
  drag.cancel()
  picking.value = true
  void loadCandidates()
}
onMounted(() => { if (props.startPicker && draft.value.length === 0) openPicker() })
onUnmounted(() => { active = false })

function add(item: QuickLink) {
  if (saving.value || draft.value.length >= QUICK_NAV_MAX) return
  draft.value.push({ ...item, enabled: 1, sortOrder: draft.value.length })
  if (draft.value.length >= QUICK_NAV_MAX) picking.value = false
}
function move(index: number, step: number) {
  moveTo(index, index + step)
}
function moveTo(index: number, target: number) {
  const items = [...draft.value]
  if (saving.value || index < 0 || index >= items.length || target < 0 || target >= items.length) return
  const item = items.splice(index, 1)[0]
  items.splice(target, 0, item)
  draft.value = items
}
function remove(index: number) {
  if (saving.value || drag.clickBlocked() || index < 0) return
  drag.cancel()
  draft.value.splice(index, 1)
}
async function persist(items: QuickLink[]) {
  if (saving.value) return
  drag.cancel()
  saving.value = true
  saveError.value = ''
  emit('busy', true)
  try {
    const saved = await saveLifeQuickLinks(items)
    if (active) emit('saved', saved)
  } catch (reason) {
    if (active) saveError.value = reason instanceof Error ? reason.message : '保存失败，请重试'
    throw reason
  } finally {
    if (active) { saving.value = false; emit('busy', false) }
  }
}
async function save() {
  try { await persist(draft.value) } catch { /* 保留卡片内草稿供重试 */ }
}
watch(() => props.saveSignal, () => { void save() })
function visual(item: QuickLink) {
  const value = menuVisuals.menuVisual(item.menuId, { icon: item.icon, iconColor: item.color })
  return { ...value, iconColor: value.iconColor || (isDark.value ? '#e2e4e9' : '#27272a') }
}
</script>

<template>
  <view class="quick-editor">
      <text v-if="saveError" class="quick-editor-error" role="alert">{{ saveError }}</text>
      <view class="quick-editor-grid">
        <view v-for="(item, index) in draft" :key="item.menuId"
          class="quick-editor-tile" :class="[{ 'quick-editor-shifting': !!drag.dragging.value, 'quick-editor-dragging': drag.dragging.value === item.menuId }, themeClass({ 'quick-editor-dragging': drag.dragging.value === item.menuId })]"
          :style="drag.style(item.menuId)">
          <button role="button" class="quick-editor-drag" :aria-label="'拖动排序' + item.title" :disabled="saving" :aria-disabled="saving" :tabindex="saving ? -1 : 0"
            @touchstart.stop="drag.start(item.menuId, $event)" @touchmove.stop="drag.move" @touchend.stop="drag.finish" @touchcancel.stop="drag.cancel" @contextmenu.prevent
            @mousedown.stop="drag.start(item.menuId, $event, true)" @keydown.left.prevent="move(index, -1)" @keydown.right.prevent="move(index, 1)">
            <view class="quick-editor-grip-dots" aria-hidden="true"><view v-for="dot in 6" :key="dot" class="quick-editor-grip-dot" /></view>
            <LifeMenuIcon :icon="visual(item).icon" :size="24" :color="visual(item).iconColor" />
            <text class="quick-editor-title" :class="[themeClass('quick-editor-title'), { 'quick-editor-hidden': item.enabled === 0 }]">{{ item.title }}</text>
          </button>
          <button role="button" class="quick-editor-remove" :aria-label="'移除' + item.title" :disabled="saving" :aria-disabled="saving"
            @touchstart.stop @touchend.stop @mousedown.stop @click.stop="remove(index)">
            <view class="quick-editor-remove-icon"><AppIcon name="ant-design:close-outlined" :size="12" :color="isDark ? '#a1a1aa' : '#71717a'" /></view>
          </button>
        </view>
        <button v-if="draft.length < QUICK_NAV_MAX" role="button" class="quick-editor-add" :class="themeClass('quick-editor-add')" aria-label="添加快捷方式" :disabled="saving" :aria-disabled="saving" @click="openPicker">
          <AppIcon name="ant-design:plus-outlined" :size="24" color="#8b8f99" />
          <text class="quick-editor-add-label">添加</text>
        </button>
      </view>
    <AdaptiveModal v-if="picking" label="添加快捷方式" :max-width="520" @close="picking = false">
      <view class="quick-picker">
        <input v-model="query" class="quick-picker-search" :class="themeClass('quick-picker-search')" aria-label="搜索快捷方式" placeholder="搜索功能" />
        <view v-if="loading" class="quick-editor-state"><LoadingIndicator label="正在加载可添加功能" /></view>
        <view v-else-if="error" class="quick-editor-state"><text class="quick-editor-error" role="alert">{{ error }}</text><MobileButton label="重试加载功能" variant="ghost" @click="loadCandidates" /></view>
        <text v-else-if="!choices.length" class="quick-picker-muted">{{ candidates.length ? '暂无可添加的功能' : '暂无可用功能' }}</text>
        <view v-for="group in choiceGroups" :key="group.title" class="quick-picker-group">
          <button role="button" class="quick-picker-group-toggle" :aria-label="group.title + '分组'" :aria-expanded="groupExpanded(group.title)" @click="toggleGroup(group.title)">
            <AppIcon :name="groupExpanded(group.title) ? 'ant-design:down-outlined' : 'ant-design:right-outlined'" :size="16" color="#8b8f99" />
            <text class="quick-picker-group-title" :class="themeClass('quick-picker-group-title')">{{ group.title }}</text>
            <text class="quick-picker-muted">{{ group.items.length }}</text>
          </button>
          <view v-if="groupExpanded(group.title)" class="quick-picker-children">
            <view v-for="item in group.items" :key="item.menuId" class="quick-picker-choice">
              <LifeMenuIcon :icon="visual(item).icon" :size="20" :color="visual(item).iconColor" />
              <view class="quick-picker-name"><text class="quick-picker-label" :class="themeClass('quick-picker-label')">{{ item.title }}</text></view>
              <MobileButton :label="'添加' + item.title" icon="ant-design:plus-outlined" variant="ghost" :disabled="draft.length >= QUICK_NAV_MAX" @click="add(item)" />
            </view>
          </view>
        </view>
        <view class="quick-picker-footer"><text class="quick-picker-muted">{{ draft.length }}/{{ QUICK_NAV_MAX }}</text><MobileButton label="完成添加" variant="quiet" @click="picking = false" /></view>
      </view>
    </AdaptiveModal>
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/typography' as *;
.quick-editor { min-width: 0; }
.quick-editor-state { min-height: $space-controlMin; align-items: center; justify-content: center; gap: $space-inline; }
.quick-editor-error { @include type-style('caption'); color: #c65353; }
.quick-editor-grid { flex-direction: row; flex-wrap: wrap; }
// 对齐 Web：五列图标网格、左侧手柄、右上角删除；透明边缘保留触控面积。
.quick-editor-tile, .quick-editor-add { box-sizing: border-box; width: 20%; min-width: $space-controlMin; border-radius: $space-inline; }
.quick-editor-tile { position: relative; }
.quick-editor-drag, .quick-editor-add { display: flex; flex-direction: column; min-height: $space-controlMin; align-items: center; justify-content: center; padding: ($space-modal + $space-inline) $space-detail $space-inline; margin: 0; border: 0; background-color: transparent; }
.quick-editor-drag { width: 100%; box-sizing: border-box; cursor: grab; user-select: none; -webkit-touch-callout: none; }
.quick-editor-drag::after, .quick-editor-remove::after, .quick-editor-add::after { border: 0; }
.quick-editor-remove { position: absolute; top: -$space-card; right: -$space-inline; display: flex; width: $space-controlMin; height: $space-controlMin; margin: 0; padding: 0; border: 0; background-color: transparent; }
.quick-editor-remove-icon { position: absolute; top: $space-controlMin - $space-card; right: $space-inline + $space-micro; }
.quick-editor-remove:disabled { opacity: 0.4; }
.quick-editor-shifting { transition: transform 150ms ease; }
.quick-editor-dragging { transition: none; cursor: grabbing; background-color: #eef3ff; box-shadow: 0 $space-detail $space-inline rgba(0, 0, 0, 0.12); }
.quick-editor-dragging-dark { background-color: #28354b; }
.quick-editor-grip-dots { position: absolute; left: $space-micro; top: $space-modal + $space-inline; display: flex; width: 8px; flex-direction: row; flex-wrap: wrap; gap: $space-micro; opacity: 0.3; }
.quick-editor-grip-dot { width: 2px; height: 2px; border-radius: 50%; background-color: #8b8f99; }
.quick-editor-title { @include type-style('caption'); color: #52525b; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: $space-detail; }
.quick-editor-title-dark { color: #eeeeef; }
.quick-editor-hidden { text-decoration: line-through; opacity: 0.5; }
.quick-editor-add-label { @include type-style('caption'); color: #8b8f99; margin-top: $space-detail; }
.quick-picker-muted { @include type-style('caption'); color: #8b8f99; }
.quick-picker-search { min-height: $space-controlMin; margin-bottom: $space-inline; padding: 0 $space-card; border-radius: 10px; background-color: #f0f2f5; @include type-style('body'); }
.quick-picker-search-dark { background-color: #292c32; color: #eeeeef; }
.quick-picker-group { margin-top: $space-inline; }
.quick-picker-group-toggle { display: flex; flex-direction: row; align-items: center; gap: $space-inline; width: 100%; min-height: $space-controlMin; margin: 0; padding: 0; border: 0; background-color: transparent; text-align: left; }
.quick-picker-group-toggle::after { border: 0; }
.quick-picker-group-title { flex: 1; min-width: 0; @include type-style('label'); color: #52525b; }
.quick-picker-group-title-dark { color: #c4c7ce; }
.quick-picker-children { padding-left: $space-modal + $space-inline; gap: $space-inline; padding-bottom: $space-inline; }
.quick-picker-choice { flex-direction: row; align-items: center; min-height: $space-controlMin; gap: $space-inline; }
.quick-picker-name { flex: 1; min-width: 0; }
.quick-picker-label { @include type-style('label'); color: #27272a; }
.quick-picker-label-dark { color: #eeeeef; }
.quick-picker-footer { flex-direction: row; align-items: center; justify-content: space-between; margin-top: $space-section; }
</style>
