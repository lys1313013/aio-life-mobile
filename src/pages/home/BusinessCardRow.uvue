<script setup lang="ts">
import { inject } from 'vue'
import AppIcon from '../../components/AppIcon.uvue'
import LibraryCover from '../../components/LibraryCover.uvue'
import MembershipLogo from '../../components/MembershipLogo.uvue'
import GoalProgressRing from './GoalProgressRing.uvue'
import { isDark } from '../../services/theme.ts'
import { businessCardRowHeight, cardCaption, cardProgress } from './services/business-cards.ts'
const props = defineProps<{ card: any; item: any }>()
const orders = inject<any>('home-business-orders')
const order = orders[props.card.key]
const emit = defineEmits(['edit'])
function title(item) { return item.title || item.name || '未命名' }
// 高频位移只在本行读取，避免拖动时重算整个业务卡片和全部进度环。
function rowStyle() {
  return order ? order.style(props.item.id) : { height: businessCardRowHeight + 'px' }
}
</script>
<template>
  <view class="business-row" :class="[order ? order.classes(item.id) : {}, { 'business-dragging-dark': isDark && order && order.dragging.value === item.id }]" :style="rowStyle()"
    @touchstart.stop="order && order.start(item.id, $event)" @touchmove="order && order.move($event)" @touchend="order && order.finish($event)" @touchcancel="order && order.cancel()"
    @mousedown.stop="order && order.mouseStart(item.id, $event)"
    @keydown.alt.up.prevent="order && order.keyboard(item.id, -1)" @keydown.alt.down.prevent="order && order.keyboard(item.id, 1)">
    <view class="record-link" role="button" tabindex="0" :aria-label="'编辑' + title(item)" @click="emit('edit')" @keydown.enter="emit('edit')" @keydown.space.prevent="emit('edit')">
      <GoalProgressRing v-if="card.key === 'goal'" :percent="cardProgress(card, item) ?? 0" :label="title(item) + '进度'" />
      <view v-else-if="card.paged" class="record-cover"><LibraryCover :file-id="item.fileId || ''" :url="item.coverImgUrl || ''" :title="title(item)" :kind="card.key" compact tiny /></view>
      <text v-else-if="card.key === 'anniversary'" class="record-emoji">{{ item.icon || '🎉' }}</text>
      <MembershipLogo v-else-if="card.key === 'member'" :icon-key="item.providerIconKey" :category="item.category" :name="item.providerName || item.provider || title(item)" :size="22" />
      <view class="record-copy">
        <text class="record-title" :class="{ 'text-dark': isDark }">{{ title(item) }}</text>
        <view v-if="card.key === 'goal'" class="goal-meta">
          <text class="caption" :class="{ 'caption-dark': isDark }">{{ cardCaption(card, item) }}</text>
          <view v-if="item.endDate" class="goal-due" :aria-label="'截止 ' + item.endDate.slice(0, 10)">
            <text class="caption" :class="{ 'caption-dark': isDark }" aria-hidden="true">·</text>
            <AppIcon name="ant-design:calendar-outlined" :size="14" :color="isDark ? '#a6a6b0' : '#71717a'" />
            <text class="caption" :class="{ 'caption-dark': isDark }">{{ item.endDate.slice(0, 10) }}</text>
          </view>
        </view>
        <text v-else class="caption record-caption" :class="{ 'caption-dark': isDark }">{{ cardCaption(card, item) }}</text>
        <view v-if="card.key !== 'goal' && cardProgress(card, item) != null" class="progress-track" :class="{ 'progress-track-dark': isDark }"><view class="progress-fill" :style="{ width: cardProgress(card, item) + '%' }" /></view>
      </view>
      <AppIcon v-if="card.key === 'member' && item.autoRenew === 1" name="lucide:rotate-cw" :size="14" color="#8b8f99" aria-label="自动续费" />
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.business-row { flex-shrink: 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; padding: $space-detail $space-card; }
.business-dragging { position: relative; background-color: #f1f3f6; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12); }
.business-dragging-dark { background-color: #292d33; }
.business-drop-before { box-shadow: inset 0 2px 0 #618f9d; }
.business-drop-after { box-shadow: inset 0 -2px 0 #618f9d; }
.record-link { display: flex; flex-direction: row; flex: 1; min-width: 0; align-items: center; gap: $space-inline; min-height: $space-controlMin; }
.record-cover { width: 32px; height: 48px; flex-shrink: 0; border-radius: 4px; overflow: hidden; }
.record-emoji { @include type-style('glyph-display'); }
.record-copy { flex: 1; min-width: 0; gap: $space-detail; }
.goal-meta { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: $space-detail; }
.goal-due { display: flex; flex-direction: row; align-items: center; gap: $space-detail; flex-shrink: 0; }
.record-title { @include type-style('label-strong'); color: #3f3f46; overflow: hidden;
/* #ifndef APP */
display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
/* #endif */
/* #ifdef APP */
max-lines: 2; text-overflow: ellipsis;
/* #endif */
}
.caption { @include type-style('caption'); color: #71717a; }
.record-caption { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.text-dark { color: #ececf0; }
.caption-dark { color: #a6a6b0; }
.progress-track { height: 3px; border-radius: 3px; background-color: #eef0f3; overflow: hidden; }
.progress-track-dark { background-color: #30343b; }
.progress-fill { height: 3px; background-color: #5879ce; }

/* 仅拖动期间启用合成层，邻行让位不改变列表高度。 */
.business-sort-active { transition: transform 150ms ease; }
.business-dragging { transition: none; }
/* #ifdef WEB */
.business-sort-active { will-change: transform; touch-action: none; user-select: none; }
/* #endif */

</style>
