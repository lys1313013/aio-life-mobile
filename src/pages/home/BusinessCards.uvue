<script setup lang="ts">
import { computed, reactive, watch, onUnmounted } from 'vue'
import AppIcon from '../../components/AppIcon.uvue'
import LibraryCover from '../../components/LibraryCover.uvue'
import ContentSkeleton from '../../components/ContentSkeleton.uvue'
import LoadingIndicator from '../../components/LoadingIndicator.uvue'
import { isDark } from '../../services/theme.ts'
import { request } from '../../services/api.ts'
import { session } from '../../services/session.ts'
import { loadMenuAccess } from '../../services/menu-access-cache.ts'
import { lockedMenuPaths, matchesNativeMenu } from '../../services/life-catalog.ts'
import { isMenuUnlocked } from '../../services/secondary-lock.ts'
import spacing from '../../styles/spacing.json'
import { businessCards as allBusinessCards, businessCardMaxHeight, businessCardRowHeight, cardState, loadBusinessCard, cardCaption, cardProgress } from './services/business-cards.ts'
const props = defineProps<{ active: boolean; only?: string }>()
const businessCards = allBusinessCards.filter(card => !props.only || ({ read: 'reading', member: 'membership' }[card.key] || card.key) === props.only)
const states = reactive(Object.fromEntries(businessCards.map(card => [card.key, cardState()])))
const shown = computed(() => businessCards.filter(card => {
  const state = states[card.key]
  return state.available && (!state.loaded || state.loading || !!state.error || state.locked || state.rows.length > 0)
}))
let epoch = 0
function invalidate(clear = false) {
  epoch++
  for (const card of businessCards) {
    const state = states[card.key]
    state.version++; state.loading = false; state.moreLoading = false; state.busy = false
    if (clear) Object.assign(state, cardState(), { version: state.version })
  }
}
watch(() => session.token, () => invalidate(true), { flush: 'sync' })
onUnmounted(() => invalidate(true))
watch(() => props.active, active => { if (!active) invalidate(true) }, { flush: 'sync' })
defineExpose({ refresh: refreshAll })
async function refreshAll() {
  if (!props.active || !session.token) return
  invalidate()
  const current = epoch
  for (const card of businessCards) states[card.key].loading = true
  try {
    const [config, candidates] = await Promise.all([
      loadMenuAccess(path => request(path, 'GET', null, true, null, true)),
      request('/quick-nav/candidates?client=mobile', 'GET', null, true, null, true),
    ])
    if (!Array.isArray(candidates) || candidates.some(item => !item || typeof item.path !== 'string')) throw new Error('菜单权限数据异常，请重试')
    if (current !== epoch || !props.active) return
    await Promise.all(businessCards.map(card => {
      const state = states[card.key]
      state.available = candidates.some(item => matchesNativeMenu(card.route, item.path))
      if (!state.available) {
        Object.assign(state, cardState(), { version: state.version, available: false, loaded: true })
        return Promise.resolve()
      }
      const locked = lockedMenuPaths(card.route, config.menus, config.ids).some(path => !isMenuUnlocked(path))
      if (locked) {
        state.version++; state.rows = []; state.locked = true; state.loaded = true; state.loading = false; state.error = ''; state.more = false
        return Promise.resolve()
      }
      return load(card)
    }))
  } catch (error) {
    if (current !== epoch || !props.active) return
    for (const card of businessCards) { states[card.key].rows = []; states[card.key].loading = false; states[card.key].error = error.message || '权限检查失败，请重试' }
  }
}
function load(card, more = false) {
  if (!props.active || !session.token || !states[card.key].available) return Promise.resolve()
  // 首页后台加载不主动弹二级密码；服务端要求解锁时立即清除旧内容。
  return loadBusinessCard(card, states[card.key], path => request(path, 'GET', null, true, null, true), more)
}
function nextPage(card) { if (!states[card.key].moreError) void load(card, true) }
function open(card, item = null, create = false) {
  if (!props.active || !states[card.key].available) return
  const suffix = item ? 'editId=' + encodeURIComponent(item.id) : create ? 'create=1&home=1' : ''
  uni.navigateTo({ url: card.route + (suffix ? (card.route.includes('?') ? '&' : '?') + suffix : '') })
}
function listHeight(card) {
  const state = states[card.key]
  const inset = spacing.controlMin + spacing.card + spacing.hairline * 2
  const rows = state.rows.length * businessCardRowHeight
  const status = state.moreLoading || state.moreError || state.error ? spacing.controlMin : 0
  return Math.min(businessCardMaxHeight - inset, rows + status)
}
function title(item) { return item.title || item.name || '未命名' }
async function menu(card, item, index) {
  const state = states[card.key]
  if (state.busy || state.loading) return
  const actions = ['取消固定']
  if (index > 0) actions.push('上移')
  if (index < state.rows.length - 1) actions.push('下移')
  const version = state.version
  uni.showActionSheet({ itemList: actions, success: async result => {
    if (!props.active || state.version !== version || state.busy) return
    state.busy = true
    state.error = ''
    try {
      const action = actions[result.tapIndex]
      if (action === '取消固定') {
        await request(card.endpoint + '/' + encodeURIComponent(item.id) + '/pin', 'PUT', { isPinned: 0 }, true, null, true)
        if (state.version === version) state.rows = state.rows.filter(row => row.id !== item.id)
      } else {
        const ids = state.rows.map(row => row.id)
        const target = action === '上移' ? index - 1 : index + 1
        ;[ids[index], ids[target]] = [ids[target], ids[index]]
        await request(card.endpoint + '/pinned-order', 'PUT', { ids }, true, null, true)
        if (state.version === version) state.rows = ids.map(id => state.rows.find(row => row.id === id))
      }
    } catch (error) {
      if (state.version !== version) return
      if (error.name === 'SecondaryLockRequiredError') { state.rows = []; state.locked = true; state.more = false }
      else state.error = error.message || '操作失败，请重试'
    } finally { if (state.version === version) state.busy = false }
  } })
}
</script>
<template>
    <view v-for="card in shown" :key="card.key" class="business-cell">
      <view class="business-card" :class="{ 'business-card-dark': isDark }" :style="{ maxHeight: businessCardMaxHeight + 'px' }" :aria-label="card.title + '首页卡片'" :aria-busy="states[card.key].loading || states[card.key].busy">
        <view class="business-heading">
          <button role="button" class="heading-link" :aria-label="'查看全部' + card.title" @click="open(card)"><AppIcon :name="card.icon" :size="16" :color="isDark ? '#d4d4d8' : '#52525b'" /><text class="heading-text" :class="{ 'text-dark': isDark }">{{ card.title }}</text></button>
          <LoadingIndicator v-if="states[card.key].loading || states[card.key].busy" compact :label="'正在加载' + card.title" />
          <button role="button" class="icon-action" :aria-label="'新增' + card.title" @click="open(card, null, true)"><AppIcon name="lucide:plus" :size="18" :color="isDark ? '#d4d4d8' : '#52525b'" /></button>
        </view>
        <view v-if="states[card.key].locked" class="card-placeholder"><button role="button" class="lock-action" :aria-label="'解锁' + card.title" @click="open(card)"><AppIcon name="ant-design:lock-outlined" :size="18" color="#8b8f99" /><text class="caption">点击解锁</text></button></view>
        <view v-else-if="!states[card.key].rows.length && states[card.key].loading" class="card-placeholder"><ContentSkeleton compact :rows="2" :label="'正在加载' + card.title" /></view>
        <view v-else-if="!states[card.key].rows.length && states[card.key].error" class="card-placeholder"><text class="error-text">{{ states[card.key].error }}</text><button role="button" class="icon-action" :aria-label="'重试' + card.title" @click="refreshAll"><AppIcon name="lucide:rotate-cw" :size="18" color="#5879ce" /></button></view>
        <scroll-view v-else-if="states[card.key].rows.length" scroll-y :show-scrollbar="false" :lower-threshold="40" class="business-scroll" :style="{ height: listHeight(card) + 'px' }" @scrolltolower="nextPage(card)">
          <view v-for="(item, index) in states[card.key].rows" :key="item.id" class="business-row" :style="{ height: businessCardRowHeight + 'px' }">
            <view class="record-link" role="button" tabindex="0" :aria-label="'编辑' + title(item)" @click="open(card, item)" @keydown.enter="open(card, item)" @keydown.space.prevent="open(card, item)">
              <view v-if="card.paged" class="record-cover"><LibraryCover :file-id="item.fileId || ''" :url="item.coverImgUrl || ''" :title="title(item)" :kind="card.key" compact tiny /></view>
              <text v-else-if="card.key === 'anniversary'" class="record-emoji">{{ item.icon || '🎉' }}</text>
              <AppIcon v-else-if="card.key === 'member'" name="lucide:crown" :size="22" :color="item.color || '#5879ce'" />
              <view class="record-copy"><text class="record-title" :class="{ 'text-dark': isDark }">{{ title(item) }}</text><text class="caption record-caption" :class="{ 'caption-dark': isDark }">{{ cardCaption(card, item) }}</text><view v-if="cardProgress(card, item) != null" class="progress-track" :class="{ 'progress-track-dark': isDark }"><view class="progress-fill" :style="{ width: cardProgress(card, item) + '%' }" /></view></view>
              <AppIcon v-if="card.key === 'member' && item.autoRenew === 1" name="lucide:rotate-cw" :size="14" color="#8b8f99" aria-label="自动续费" />
            </view>
            <button role="button" v-if="card.pinned" class="icon-action" :disabled="states[card.key].busy || states[card.key].loading" :aria-label="title(item) + '固定操作'" @click="menu(card, item, index)"><AppIcon name="lucide:ellipsis" :size="18" color="#8b8f99" /></button>
          </view>
          <view v-if="states[card.key].moreLoading || states[card.key].moreError || states[card.key].error" class="list-status"><LoadingIndicator v-if="states[card.key].moreLoading" compact label="正在加载更多" /><template v-else><text class="error-text status-error">{{ states[card.key].moreError || states[card.key].error }}</text><button role="button" class="icon-action" :aria-label="'重试' + card.title" @click="states[card.key].moreError ? load(card, true) : load(card)"><AppIcon name="lucide:rotate-cw" :size="18" color="#5879ce" /></button></template></view>
        </scroll-view>
      </view>
    </view>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
.business-grid { display: flex; flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin-left: -$space-detail; margin-right: -$space-detail; }
.business-cell { width: 100%; box-sizing: border-box; padding: $space-detail; }
.business-card { box-sizing: border-box; background-color: #ffffff; border: 1px solid #e8e8ed; border-radius: 14px; overflow: hidden; padding-bottom: $space-card; }
.business-card-dark { background-color: #1c1e22; border-color: #303238; }
.business-heading { height: $space-controlMin; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; padding: 0 $space-card; }
.heading-link, .icon-action, .lock-action { display: flex; flex-direction: row; align-items: center; justify-content: center; min-height: $space-controlMin; margin: 0; padding: 0; border: 0; background-color: transparent; }
.heading-link { flex: 1; justify-content: flex-start; gap: $space-inline; }
.heading-text { @include type-style('title'); color: #18181b; }
.icon-action { width: $space-controlMin; flex-shrink: 0; }
.business-scroll { width: 100%; min-height: 0; }
.business-row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; padding: $space-detail $space-card; }
.record-link { display: flex; flex-direction: row; flex: 1; min-width: 0; align-items: center; gap: $space-inline; min-height: $space-controlMin; }
.record-cover { width: 32px; height: 48px; flex-shrink: 0; border-radius: 4px; overflow: hidden; }
.record-emoji { @include type-style('glyph-display'); }
.record-copy { flex: 1; min-width: 0; gap: $space-detail; }
.record-title { @include type-style('label-strong'); color: #3f3f46; overflow: hidden;
/* #ifndef APP */
display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
/* #endif */
/* #ifdef APP */
max-lines: 2; text-overflow: ellipsis;
/* #endif */
}
.caption { @include type-style('caption'); color: #71717a; }
.record-caption { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.text-dark { color: #ececf0; }
.caption-dark { color: #a6a6b0; }
.progress-track { height: 3px; border-radius: 3px; background-color: #eef0f3; overflow: hidden; }
.progress-track-dark { background-color: #30343b; }
.progress-fill { height: 3px; background-color: #5879ce; }
.card-placeholder { padding: $space-inline $space-card; min-height: $space-controlMin; }
.lock-action { gap: $space-inline; }
.list-status { height: $space-controlMin; flex-direction: row; align-items: center; padding: 0 $space-card; }
.error-text { @include type-style('caption'); color: #c26161; }
.status-error { flex: 1; min-width: 0; }
@media (min-width: 768px) { .business-cell { width: 50%; } }
@media (min-width: 1200px) { .business-cell { width: 33.3333%; } }
/* #ifdef WEB || MP-WEIXIN */
.heading-link::after, .icon-action::after, .lock-action::after { border: 0; }
/* #endif */
/* #ifdef WEB */
.business-scroll :deep(.uni-scroll-view) { overscroll-behavior-y: contain; }
/* #endif */
</style>
