<script setup lang="ts">
import { buttonLabelClasses } from '../../services/button-label.ts'
import { computed, getCurrentInstance, nextTick, onMounted, onUnmounted, ref, watch } from 'vue'
// #ifdef MP-WEIXIN
import { modalOpen } from '../../services/modal-presence.ts'
// #endif
import { summaryDonutLabels, summaryDonutRotation } from '../../services/dashboard-format.ts'
import { isDark } from '../../services/theme.ts'

type Group = { id: string; color: string; minutes: number }
type Sector = { id: string; color: string; start: number; end: number }
const props = defineProps<{ groups: Group[]; active: boolean }>()
const instance = getCurrentInstance()
const canvasId = 'home-time-donut-' + instance?.uid
const failed = ref(false)
const canvasVisible = computed(() => {
  // 微信原生 Canvas 可能穿透弹窗，必须移除节点而非只暂停动画。
  // #ifdef MP-WEIXIN
  return props.active && !modalOpen.value
  // #endif
  // #ifndef MP-WEIXIN
  return true
  // #endif
})
let context: any = null
let frame: ReturnType<typeof setTimeout> | null = null
let alive = true
let current: Sector[] = []
let growth = 1
let generation = 0

function sectors(): Sector[] {
  const total = props.groups.reduce((sum, group) => sum + group.minutes, 0)
  let angle = -Math.PI / 2 + summaryDonutRotation(props.groups)
  return props.groups.filter(group => group.minutes > 0).map(group => {
    const start = angle
    angle += group.minutes / total * Math.PI * 2
    return { id: group.id, color: group.color, start, end: angle }
  })
}
function stop() {
  if (frame !== null) clearTimeout(frame)
  frame = null
}
// 圆环、指引线共用 176px 坐标系，避免原生旋转 view 的定位误差。
function fillSector(start: number, end: number, outer: number, color: string) {
  context.beginPath()
  context.arc(88, 88, outer, start, end, false)
  context.arc(88, 88, 35, end, start, true)
  context.closePath()
  context.fillStyle = color
  context.fill()
}
function paint(rows: Sector[]) {
  if (!context || !canvasVisible.value) return
  try {
    context.clearRect(0, 0, 176, 176)
    const outer = 35 + 19 * growth
    if (outer <= 35) return
    // 同色完整底环覆盖抗锯齿接缝，扇区仍使用精确占比，不扩大角度吞掉小分类。
    fillSector(-Math.PI / 2, Math.PI * 1.5, outer,
      rows[0]?.color || (isDark.value ? '#45474d' : '#c9c9cc'))
    for (const row of rows) {
      if (row.end > row.start) fillSector(row.start, row.end, outer, row.color)
    }
    // 标签在最终圆环外缘；动画结束后再接上指引线，避免悬空和穿环。
    if (growth === 1) {
      context.lineWidth = 1
      for (const label of summaryDonutLabels(props.groups)) {
        context.beginPath()
        context.moveTo(label.points[0].x, label.points[0].y)
        for (let index = 1; index < label.points.length; index++) {
          context.lineTo(label.points[index].x, label.points[index].y)
        }
        context.strokeStyle = label.color
        context.stroke()
      }
    }
    failed.value = false
  } catch (_) { stop(); failed.value = true }
}
function update() {
  stop()
  if (!context || !props.active || !canvasVisible.value) return
  current = sectors()
  let reduceMotion = false
  // #ifdef APP
  // 原生首帧直接使用完整环，避免多段动画与外部标签不同步。
  reduceMotion = true
  // #endif
  // #ifdef WEB
  reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  // #endif
  if (reduceMotion || !current.length) {
    growth = 1
    paint(current)
    return
  }
  // 所有扇区使用相同半径和进度，始终组成一个完整圆环。
  const started = Date.now()
  function tick() {
    if (!alive || !props.active || !canvasVisible.value) return
    const progress = Math.min(1, Math.max(0, (Date.now() - started) / 1000))
    growth = progress === 0 || progress === 1 ? progress
      : progress < 0.5 ? Math.pow(2, 20 * progress - 10) / 2
      : (2 - Math.pow(2, -20 * progress + 10)) / 2
    paint(current)
    if (!failed.value && growth < 1) frame = setTimeout(tick, 16)
    else frame = null
  }
  tick()
}
async function initialize(animate = true) {
  if (!alive || !canvasVisible.value) return
  const requestId = ++generation
  stop()
  failed.value = false
  await nextTick()
  if (!alive || !canvasVisible.value || requestId !== generation) return
  uni.createCanvasContextAsync({
    id: canvasId,
    component: instance?.proxy,
    success(canvas) {
      if (!alive || !canvasVisible.value || requestId !== generation) return
      try {
        context = canvas.getContext('2d')
        if (!context) throw new Error('Canvas unavailable')
        // App 的画布尺寸由原生布局管理；Web/微信手动设置高清 backing store。
        // #ifndef APP
        const ratio = uni.getWindowInfo().pixelRatio || 1
        context.canvas.width = Math.round(176 * ratio)
        context.canvas.height = Math.round(176 * ratio)
        // #endif
        context.setTransform(context.canvas.width / 176, 0, 0, context.canvas.height / 176, 0, 0)
        if (animate) update()
        else { current = sectors(); growth = 1; paint(current) }
      } catch (_) { failed.value = true }
    },
    fail() { if (alive && canvasVisible.value && requestId === generation) failed.value = true },
  })
}
onMounted(initialize)
watch(canvasVisible, visible => {
  generation++
  stop()
  context = null
  failed.value = false
  if (visible) initialize(false)
})
watch(() => props.groups, update, { deep: true })
watch(isDark, () => paint(current))
watch(() => props.active, value => {
  stop()
  // A hidden tab resumes at the final state instead of replaying a save animation.
  if (value) { current = sectors(); growth = 1; paint(current) }
})
onUnmounted(() => { alive = false; generation++; stop(); context = null })
</script>

<template>
  <view class="time-donut-renderer">
    <canvas v-if="canvasVisible" :id="canvasId" :canvas-id="canvasId" type="2d" class="time-donut-canvas" aria-hidden="true" />
    <button v-if="failed && canvasVisible" class="time-donut-retry" aria-label="重试时迹图表" @click="initialize()"><text :class="buttonLabelClasses(['time-donut-retry'])">重试</text></button>
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing-tokens' as *;
// 容器正常占位，画布在同一容器内定位。微信组件宿主不能依赖跨层绝对定位，
// 否则滚动或卡片重排后原生画布可能与外部文字分离。
.time-donut-renderer { position: relative; width: 176px; height: 176px; flex-shrink: 0; }
.time-donut-canvas { position: absolute; top: 0; left: 0; width: 176px; height: 176px; }
.time-donut-retry { position: absolute; top: 0; left: 0; min-height: $space-controlMin; min-width: $space-controlMin; margin: 0; padding: 0; @include type-style('caption'); }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.time-donut-retry-label { @include type-style('caption'); }
</style>
