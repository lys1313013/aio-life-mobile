<script setup lang="ts">
import { buttonLabelClasses } from '../../services/button-label.ts'
import { getCurrentInstance, nextTick, onMounted, onUnmounted, ref, watch } from 'vue'
import { isDark } from '../../services/theme.ts'

type Group = { id: string; color: string; minutes: number }
type Sector = { id: string; color: string; start: number; end: number }
const props = defineProps<{ groups: Group[]; active: boolean }>()
const instance = getCurrentInstance()
const canvasId = 'home-time-donut-' + instance?.uid
const failed = ref(false)
let context: any = null
let frame: ReturnType<typeof setTimeout> | null = null
let alive = true
let current: Sector[] = []
let growth: number[] = []

function sectors(): Sector[] {
  const total = props.groups.reduce((sum, group) => sum + group.minutes, 0)
  let angle = -Math.PI / 2
  return props.groups.filter(group => group.minutes > 0).map(group => {
    const start = angle
    angle += group.minutes / total * Math.PI * 2
    return { id: group.id, color: group.color, start, end: angle }
  })
}
function stop() {
  if (frame !== null) clearTimeout(frame)
  frame = null
}
function paint(rows: Sector[]) {
  if (!context) return
  context.clearRect(0, 0, 108, 108)
  if (!rows.length) {
    context.beginPath()
    context.arc(54, 54, 44.5, 0, Math.PI * 2)
    context.lineWidth = 19
    context.strokeStyle = isDark.value ? '#45474d' : '#c9c9cc'
    context.stroke()
    return
  }
  for (let index = 0; index < rows.length; index++) {
    const row = rows[index]
    const thickness = 19 * (growth[index] ?? 1)
    if (row.end - row.start < 0.00001 || thickness <= 0) continue
    context.beginPath()
    // ECharts pie scale: inner radius stays at 35; only the outer radius grows.
    context.arc(54, 54, 35 + thickness / 2, row.start, row.end)
    context.lineWidth = thickness
    context.strokeStyle = row.color
    context.stroke()
  }
}
function update() {
  stop()
  if (!context || !props.active) return
  current = sectors()
  let reduceMotion = false
  // #ifdef WEB
  reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  // #endif
  if (reduceMotion || !current.length) {
    growth = current.map(() => 1)
    paint(current)
    return
  }
  // Web clears and re-renders after saving, including unchanged proportions.
  // Match its 1000ms exponentialInOut radial reveal with a slight sector stagger.
  // Keep angles final throughout: no clockwise sweep or whole-ring zoom.
  const started = Date.now()
  function tick() {
    if (!alive || !props.active) return
    const elapsed = Date.now() - started
    growth = current.map((_, index) => {
      const delay = current.length > 1 ? index / (current.length - 1) * 80 : 0
      const progress = Math.min(1, Math.max(0, (elapsed - delay) / 1000))
      if (progress === 0 || progress === 1) return progress
      return progress < 0.5
        ? Math.pow(2, 20 * progress - 10) / 2
        : (2 - Math.pow(2, -20 * progress + 10)) / 2
    })
    paint(current)
    if (growth.some(value => value < 1)) frame = setTimeout(tick, 16)
    else frame = null
  }
  tick()
}
async function initialize() {
  failed.value = false
  await nextTick()
  if (!alive) return
  uni.createCanvasContextAsync({
    id: canvasId,
    component: instance?.proxy,
    success(canvas) {
      if (!alive) return
      try {
        context = canvas.getContext('2d')
        if (!context) throw new Error('Canvas unavailable')
        const ratio = uni.getWindowInfo().pixelRatio || 1
        context.canvas.width = 108 * ratio
        context.canvas.height = 108 * ratio
        context.scale(ratio, ratio)
        update()
      } catch (_) { failed.value = true }
    },
    fail() { if (alive) failed.value = true },
  })
}
onMounted(initialize)
watch(() => props.groups, update)
watch(isDark, () => paint(current))
watch(() => props.active, value => {
  stop()
  // A hidden tab resumes at the final state instead of replaying a save animation.
  if (value) { current = sectors(); growth = current.map(() => 1); paint(current) }
})
onUnmounted(() => { alive = false; stop(); context = null })
</script>

<template>
  <view class="time-donut-renderer">
    <canvas :id="canvasId" :canvas-id="canvasId" type="2d" class="time-donut-canvas" aria-hidden="true" />
    <button v-if="failed" class="time-donut-retry" aria-label="重试时迹图表" @click="initialize"><text :class="buttonLabelClasses(['time-donut-retry'])">重试</text></button>
  </view>
</template>

<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing-tokens' as *;
// Geometry matches the existing 176px chart and its external labels.
.time-donut-renderer { position: absolute; top: 34px; left: 34px; width: 108px; height: 108px; }
.time-donut-canvas { width: 108px; height: 108px; }
.time-donut-retry { position: absolute; top: 0; left: 0; min-height: $space-controlMin; min-width: $space-controlMin; margin: 0; padding: 0; @include type-style('caption'); }

/* 按钮文字独立声明样式，兼容 App 不继承容器排版。 */
.app-button-label { @include type-style('body'); color: #27272a; }
.app-button-label-dark { color: #eeeeef; }
.time-donut-retry-label { @include type-style('caption'); }
</style>
