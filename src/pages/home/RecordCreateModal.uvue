<script setup lang="ts">
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import { computed, onMounted, onUnmounted, ref } from 'vue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import FormField from '../../components/FormField.uvue';
import LoadingIndicator from '../../components/LoadingIndicator.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import { request } from '../../services/api.ts';
import { todayDate } from '../../services/dashboard.ts';
import { session } from '../../services/session.ts';
import spacing from '../../styles/spacing.json';

const props = defineProps<{ kind: 'think' | 'exercise'; thoughtId?: string }>();
const emit = defineEmits(['close', 'saved', 'deleted']);
const saving = ref(false), loading = ref(false), error = ref('');
const thoughtReady = ref(!props.thoughtId);
const thoughtLoading = computed(() => props.kind === 'think' && loading.value && !thoughtReady.value);
const types = ref<any[]>([]);
const thought = ref({ content: '', isPinned: 0, hiddenContent: false, events: [] as { id?: string; content: string; create_time?: string; createTime?: string }[] });
const exercise = ref({ exerciseTypeId: '', exerciseDate: todayDate(), exerciseCount: '', description: '' });
const exerciseFields = [
  { key: 'exerciseTypeId', label: '运动类型', kind: 'selector', inputType: 'text' },
  { key: 'exerciseDate', label: '运动日期', kind: 'date', inputType: 'text' },
  { key: 'exerciseCount', label: '运动数量', kind: 'text', inputType: 'number' },
  { key: 'description', label: '备注', kind: 'textarea', inputType: 'text' },
];
// 首页与运动页一致：日期和数量并排，类型和备注保留整行。
const exerciseRows = [exerciseFields.slice(0, 1), exerciseFields.slice(1, 3), exerciseFields.slice(3)];
function updateExercise(key: string, value: string) {
  exercise.value[key] = key === 'exerciseTypeId'
    ? types.value.find(type => type.dictLabel === value)?.id || '' : value;
}
// 首页离开时卸载弹窗；晚到的响应不能更新已关闭的表单或其他账号。
const owner = session.token;
let active = true;
onUnmounted(() => { active = false; });
function isCurrent() { return active && owner === session.token; }
const typeName = computed(() => types.value.find(type => type.id === exercise.value.exerciseTypeId)?.dictLabel || '');
const contentKey = computed(() => JSON.stringify([loading.value, error.value, thought.value.events.length]));

async function loadTypes() {
  if (loading.value) return;
  loading.value = true;
  error.value = '';
  try {
    // 首页仅引入新增所需接口，避免将记录分包的整组服务带入微信主包。
    const data = await request<any>('/userDictType/getByDictType', 'GET', { dictType: 'exercise_type' });
    if (!isCurrent()) return;
    types.value = (data.dictDetailList || []).map(type => ({ ...type, dictLabel: type.dictLabel || type.label }));
    exercise.value.exerciseTypeId = types.value[0]?.id || '';
    if (!types.value.length) error.value = '暂无运动类型，请先在运动页配置';
  } catch (e) {
    if (isCurrent()) error.value = e.message;
  } finally {
    loading.value = false;
  }
}
async function loadThought() {
  if (loading.value || !props.thoughtId) return;
  loading.value = true;
  error.value = '';
  try {
    const data = await request<any>('/thought/query', 'GET', { page: 1, pageSize: 1, id: props.thoughtId });
    if (!isCurrent()) return;
    const item = data.items?.find(item => item.id === props.thoughtId);
    if (!item) throw new Error('闪念不存在或已被删除');
    thought.value = {
      content: item.content || '', isPinned: item.isPinned ?? 0, hiddenContent: item.hiddenContent ?? false,
      events: (item.events || []).map(event => ({ ...event })),
    };
    thoughtReady.value = true;
  } catch (e) {
    if (isCurrent()) error.value = e.message;
  } finally {
    loading.value = false;
  }
}
onMounted(() => {
  if (props.kind === 'exercise') loadTypes();
  else if (props.thoughtId) loadThought();
});

async function removeThought() {
  if (saving.value || !thoughtReady.value || !props.thoughtId || !isCurrent()) return;
  saving.value = true;
  try {
    await request('/thought/batchDelete', 'POST', { idList: [props.thoughtId] });
    if (isCurrent()) emit('deleted', props.thoughtId);
  } finally {
    saving.value = false;
  }
}

async function save() {
  if (saving.value || loading.value || !isCurrent() || (props.kind === 'think' && !thoughtReady.value)) return;
  error.value = '';
  let payload;
  if (props.kind === 'think') {
    if (missingRequired('thought', thought.value)) { error.value = '请输入内容'; return; }
    payload = {
      ...thought.value,
      content: thought.value.content.trim(),
      events: thought.value.events.filter(event => event.content.trim()).map(event => ({ ...event, content: event.content.trim() })),
    };
  } else {
    if (missingRequired('exercise', exercise.value)) {
      error.value = '请选择运动类型和日期'; return;
    }
    const count = exercise.value.exerciseCount === '' ? null : Number(exercise.value.exerciseCount);
    if (count != null && (!Number.isInteger(count) || count < 0)) { error.value = '运动数量必须为非负整数'; return; }
    payload = { ...exercise.value, exerciseCount: count };
  }
  saving.value = true;
  try {
    const path = props.kind === 'think' ? '/thought' + (props.thoughtId ? '/' + encodeURIComponent(props.thoughtId) : '') : '/exerciseRecord';
    const result = await request<any>(path, props.thoughtId ? 'PUT' : 'POST', payload);
    if (!isCurrent()) return;
    if (props.kind === 'exercise' && !result) throw new Error('保存失败');
    if (props.thoughtId && !result) throw new Error('保存失败，闪念可能已被删除');
    emit('saved', props.thoughtId ? { ...payload, ...result, id: props.thoughtId } : undefined);
  } catch (e) {
    if (isCurrent()) error.value = e.message;
  } finally {
    saving.value = false;
  }
}
</script>

<template>
  <AdaptiveModal v-if="thoughtLoading" label="正在加载闪念" bare :show-close="false" :max-width="spacing.controlMin" @close="emit('close')">
    <LoadingIndicator ring label="正在加载闪念" />
  </AdaptiveModal>
  <AdaptiveModal v-else :label="kind === 'think' ? (thoughtId ? '编辑闪念' : '新增闪念') : '新增运动记录'" :show-close="false" :busy="saving" :content-key="contentKey" @close="emit('close')">
    <template v-if="kind === 'think' && thoughtReady">
      <FormField :required="isRequired('thought', 'content')" label="内容" kind="textarea" appearance="soft" textarea-size="regular" placeholder="记录此刻的想法…" v-model="thought.content" :disabled="saving" />
      <view v-for="(event, index) in thought.events" :key="index" class="event-fields">
        <FormField :label="'关联事件 ' + (index + 1)" kind="textarea" appearance="soft" textarea-size="compact" placeholder="记录相关事件…" v-model="event.content" :disabled="saving">
          <template #labelAction>
            <MobileButton label="移除此事件" icon="ant-design:close-outlined" variant="ghost" :disabled="saving" @click="thought.events.splice(index, 1)" />
          </template>
        </FormField>
      </view>
    </template>
    <template v-if="kind === 'exercise'">
      <LoadingIndicator v-if="loading" label="正在加载运动类型" />
      <view v-for="(row, index) in exerciseRows" :key="index" class="ui-field-row">
        <FormField v-for="field in row" :key="field.key" compact stretch textarea-size="compact" :required="isRequired('exercise', field.key)" :label="field.label" :kind="field.kind" :input-type="field.inputType" :model-value="field.key === 'exerciseTypeId' ? typeName : exercise[field.key]" :options="field.key === 'exerciseTypeId' ? types.map(type => type.dictLabel) : []" :disabled="saving || (field.key === 'exerciseTypeId' && !types.length)" @update:model-value="updateExercise(field.key, $event)" />
      </view>
    </template>
    <text v-if="error" class="form-error" role="alert">{{ error }}</text>
    <FormActions :stacked="kind === 'think' && thoughtReady">
      <template #secondary>
      <!-- 显式横排容器，避免微信具名插槽包装层挤压图标布局。 -->
      <view v-if="kind === 'think' && thoughtReady" class="thought-tools">
        <ConfirmAction v-if="thoughtId" label="删除闪念" :action="removeThought">
          <template #default="{ open }"><MobileButton label="删除闪念" icon="ant-design:delete-outlined" variant="ghost" :disabled="saving" @click="open" /></template>
        </ConfirmAction>
        <MobileButton label="新增关联事件" icon="ant-design:plus-outlined" variant="ghost" :disabled="saving" @click="thought.events.push({ content: '' })" />
        <MobileButton v-if="thoughtId" :label="thought.hiddenContent ? '显示内容' : '隐藏内容'" :icon="thought.hiddenContent ? 'ant-design:eye-outlined' : 'ant-design:eye-invisible-outlined'" variant="ghost" :disabled="saving" @click="thought.hiddenContent = !thought.hiddenContent" />
        <MobileButton :label="thought.isPinned === 1 ? '取消看板展示' : '展示到看板'" :icon="thought.isPinned === 1 ? 'ant-design:star-filled' : 'ant-design:star-outlined'" variant="ghost" :disabled="saving" @click="thought.isPinned = thought.isPinned === 1 ? 0 : 1" />
      </view>
      <MobileButton v-if="kind === 'think' && !thoughtReady && !loading" label="重试加载闪念" icon="ant-design:reload-outlined" @click="loadThought" />
      <MobileButton v-if="kind === 'exercise' && !types.length" label="重试运动类型" icon="ant-design:reload-outlined" :loading="loading" @click="loadTypes" />
      </template>
        <MobileButton label="取消" variant="quiet" :disabled="saving" @click="emit('close')" />
        <MobileButton label="保存" :loading="saving" :disabled="loading || (kind === 'think' && !thoughtReady) || (kind === 'exercise' && !types.length)" @click="save" />
    </FormActions>
  </AdaptiveModal>
</template>

<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@use '../../styles/typography' as *;
.thought-tools { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; gap: $space-inline; }
.form-error { @include type-style('body'); color: #e05252; margin-bottom: $space-section; }
</style>
