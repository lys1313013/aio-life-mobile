<script setup lang="ts">
import { nextTick, ref } from 'vue'
import { useDomainPage } from '../../services/domains/page-session.ts'
import Ledger from './ledger.uvue'
const mounted = ref(false), visible = ref(false), ledger = ref<any>(null)
useDomainPage(
  async refresh => {
    mounted.value = true; visible.value = true
    await nextTick()
    return ledger.value?.resume(refresh)
  },
  clear => { visible.value = false; ledger.value?.suspend(clear) },
  { loading: () => !!ledger.value?.loading, error: () => ledger.value?.error || '', keys: () => ['income', 'userDictData', 'userDictType'] },
)
</script>
<template><Ledger v-if="mounted" v-show="visible" ref="ledger" kind="income" /></template>

<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
</style>
