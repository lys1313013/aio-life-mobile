  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
}
.card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18px;
  color: #263248;
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.card-dark {
  color: #e7e9ee;
}
.card-face,
.draft-face {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  aspect-ratio: 1.586;
  border-radius: 14px;
  color: #f1f4f9;
  position: relative;
  justify-content: space-between;
  overflow: hidden;
}
// 限制编辑预览的几何尺寸，避免平板上卡面挤占基础字段。
.draft-face { max-width: 360px; margin-left: auto; margin-right: auto; }
.card-chip {
  width: 34px;
  height: 25px;
  border-radius: 6px;
  background-color: #b1ab91;
  opacity: 0.75;
}
.card-caption,
.face-bottom {
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}
.face-bottom {
  @include type-style('caption');
}
.face-heading {
  width: 100%;
  box-sizing: border-box;
  padding-right: calc(#{$space-controlMin} + #{$space-inline});
  min-height: $space-controlMin;
  align-items: center;
}
.face-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.face-middle {
  position: absolute;
  top: 47%;
  left: $space-card;
  right: $space-card;
  min-height: 25px;
  align-items: center;
  justify-content: flex-end;
}
.card-chip { flex-shrink: 0; }
.number-on-image {
  flex: none;
  max-width: 100%;
  padding: $space-detail $space-inline;
  border-radius: 6px;
  background-color: rgba(0, 0, 0, 0.65);
}
.face-bottom {
  position: absolute;
  left: $space-card;
  right: $space-card;
  bottom: $space-card;
  flex-wrap: nowrap;
}
.card-menu-anchor {
  position: absolute;
  top: $space-card;
  right: $space-card;
  overflow: visible;
}
.card-menu-active { z-index: 1200; }
.card-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  color: #f1f4f9;
  background-color: rgba(0, 0, 0, 0.18);
  border-radius: 12px;
}
.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1100;
}
.card-menu {
  position: fixed;
  box-sizing: border-box;
  width: 168px;
  border-radius: 12px;
  background-color: #ffffff;
  color: #263248;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
}
.card-menu-dark { background-color: #292c32; color: #eeeeef; }
.card-menu-item {
  min-height: $space-controlMin;
  width: 100%;
  margin: 0;
  padding: 0 $space-inline;
  align-items: center;
  text-align: left;
  color: inherit;
  background-color: transparent;
  @include type-style('body');
}
.card-menu-danger { color: #dc5454; }
/* #ifdef WEB || MP-WEIXIN */
.card-more::after, .card-menu-item::after { border: 0; }
/* #endif */
.palette {
  flex-wrap: wrap;
}
.color-target {
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.color-dot {
  width: 24px;
  height: 24px;
  border-radius: 50%;
}
.color-selected {
  outline: 2px solid #8b8f99;
  outline-offset: 2px;
}
.draft-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.cover { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 14px; }
.card-face-image { padding: 0; }
.card-meta { color: $text-secondary-light; @include type-style('caption');  overflow-wrap: anywhere; }
.card-name { @include type-style('label'); }
.card-status { color: #c87942; @include type-style('caption'); }
.card-tags { flex-wrap: wrap; }
.card-tag { @include type-style('badge'); color: $text-secondary-light; border-radius: 5px; padding: $space-detail $space-inline; background-color: #80808012; }
.card-caption { min-width: 0; overflow-wrap: anywhere; }
.search-toolbar { flex-wrap: nowrap; }

.title {
  @include type-style('title');

}
.number {
  flex: 1;
  min-width: 0;
  @include type-style('body');

  letter-spacing: type-tracking('number');
  text-align: right;
  overflow-wrap: anywhere;
}
@media (min-width: 600px) {
  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .filters { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
.tags {
}
.error {
