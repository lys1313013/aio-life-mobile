<script setup lang="ts">
import ContentSkeleton from '../../components/ContentSkeleton.uvue';
import { computed, onMounted, onUnmounted, ref } from 'vue';
import spacing from '../../styles/spacing.json';
import AppIcon from '../../components/AppIcon.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import PageState from '../../components/PageState.uvue';
import FormField from '../../components/FormField.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import {
  fetchCards,
  fetchBanks,
  fetchCardTags,
  saveCard,
  deleteCard,
  revealCard,
  saveCardTag,
  deleteCardTag,
} from '../../services/domains/finance.ts';
import { chooseAndUploadAttachment, authFileUrl } from '../../services/attachments.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { themeClass } from '../../services/theme.ts';
const cards = ref<any[]>([]),
  banks = ref<any[]>([]),
  tags = ref<any[]>([]),
  keyword = ref(''),
  type = ref('全部'),
  status = ref('全部'),
  bank = ref('全部'),
  tag = ref('全部');
const coverUrls = ref<Record<string, string>>({}),
  coverErrors = ref<Record<string, string>>({}),
  coverLoading = ref<Record<string, boolean>>({});
const coverBusy = ref(false),
  coverPreview = ref('');
const loading = ref(false),
  refreshing = ref(false),
  saving = ref(false),
  error = ref(''),
  formError = ref(''),
  modal = ref(false),
  tagModal = ref(false),
  moreInfo = ref(false),
  draft = ref<Record<string, any>>({}),
  tagDraft = ref<Record<string, any>>({}),
  revealed = ref<Record<string, string>>({}),
  revealBusy = ref(''),
  menuCardId = ref('');
const menuLeft = ref(0), menuTop = ref(0);
function toggleMenu(card: any) {
  if (menuCardId.value === card.id) { menuCardId.value = ''; return; }
  uni.createSelectorQuery().select('#card-more-' + card.id).boundingClientRect((rect) => {
    if (!alive || !rect || Array.isArray(rect)) return;
    const viewport = uni.getWindowInfo();
    const menuWidth = 168;
    const menuHeight = spacing.controlMin * 4 + spacing.detail * 3 + spacing.inline * 2;
    menuLeft.value = Math.max(spacing.overlayInline, Math.min(rect.right - menuWidth, viewport.windowWidth - spacing.overlayInline - menuWidth));
    const below = rect.bottom + spacing.detail;
    menuTop.value = Math.max(spacing.overlayInline, below + menuHeight <= viewport.windowHeight - spacing.overlayInline ? below : rect.top - menuHeight - spacing.detail);
    menuCardId.value = card.id;
  }).exec();
}
let alive = true,
  stamp = 0;
onUnmounted(() => {
  alive = false;
  stamp++;
  revealed.value = {};
});
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await Promise.all([fetchCards(), fetchBanks(), fetchCardTags()]);
    if (alive && current === stamp) {
      cards.value = data[0];
      banks.value = data[1];
      tags.value = data[2];
      for (const card of cards.value) {
        if (card.coverFileIds?.[0]) loadCover(card, current);
      }
    }
  } catch (e) {
    if (alive && current === stamp) error.value = e.message;
  } finally {
    if (alive && current === stamp) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
async function loadCover(card: any, current = stamp) {
  coverLoading.value = { ...coverLoading.value, [card.id]: true };
  coverErrors.value = { ...coverErrors.value, [card.id]: '' };
  try {
    const url = await authFileUrl(String(card.coverFileIds[0]));
    if (alive && stamp === current)
      coverUrls.value = { ...coverUrls.value, [card.id]: url };
  } catch (e) {
    if (alive && stamp === current)
      coverErrors.value = {
        ...coverErrors.value,
        [card.id]: e.message || '封面加载失败',
      };
  } finally {
    if (alive && stamp === current)
      coverLoading.value = { ...coverLoading.value, [card.id]: false };
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    cards.value = [];
    menuCardId.value = "";
    revealed.value = {};
    coverUrls.value = {};
    coverErrors.value = {};
    coverLoading.value = {};
    coverPreview.value = '';
    coverBusy.value = false;
    draft.value = {};
    modal.value = false;
    tagModal.value = false;
    loading.value = false;
    refreshing.value = false;
  },
);
const statusMap: Record<string, string> = {
  normal: '正常',
  frozen: '冻结',
  lost: '挂失',
  closed: '已注销',
};
const filtered = computed(() =>
  cards.value
    .filter(
      (card) =>
        (type.value === '全部' ||
          (card.cardType === 'credit' ? '信用卡' : '储蓄卡') === type.value) &&
        (status.value === '全部' || statusMap[card.status] === status.value) &&
        (bank.value === '全部' || card.bankName === bank.value) &&
        (tag.value === '全部' || card.tags?.some((item) => item.name === tag.value)) &&
        [card.alias, card.cardName, card.bankName, card.cardNoLast4].some((value) =>
          String(value || '')
            .toLowerCase()
            .includes(keyword.value.trim().toLowerCase()),
        ),
    )
    .sort((a, b) => a.sortOrder - b.sortOrder),
);
async function uploadCover() {
  const mutationStamp = stamp,
    editingDraft = draft.value;
  if (coverBusy.value) return;
  coverBusy.value = true;
  formError.value = '';
  try {
    const file = await chooseAndUploadAttachment('/file/upload', {
      bizType: 'bank_card_cover',
    });
    if (!alive || stamp !== mutationStamp || !modal.value || draft.value !== editingDraft)
      return;
    draft.value.coverFileIds = [String(file.id)];
    const url = await authFileUrl(String(file.id));
    if (!alive || stamp !== mutationStamp || !modal.value || draft.value !== editingDraft)
      return;
    coverPreview.value = url;
  } catch (e) {
    if (alive && stamp === mutationStamp && modal.value && draft.value === editingDraft)
      formError.value = e.message;
  } finally {
    if (alive && stamp === mutationStamp) coverBusy.value = false;
  }
}
function edit(card: any = null) {
  menuCardId.value = "";
  moreInfo.value = false;
  coverPreview.value = card ? coverUrls.value[card.id] || '' : '';
  draft.value = card
    ? {
        ...card,
        tagIds: card.tags.map((item) => String(item.id)),
        coverFileIds: [...(card.coverFileIds || [])],
      }
    : {
        bankId: null,
        customBankName: '',
        cardName: '',
        alias: '',
        cardType: 'debit',
        cardNo: '',
        branchName: '',
        status: 'normal',
        openedDate: '',
        expiryMonth: '',
        creditLimit: '',
        statementDay: '',
        repaymentDay: '',
        coverColor: '#334766',
        coverSourceUrl: '',
        sortOrder: 0,
        remark: '',
        tagIds: [],
        coverFileIds: [],
      };
  formError.value = '';
  modal.value = true;
}
const draftBank = computed({
  get: () =>
    banks.value.find((item) => String(item.id) === String(draft.value.bankId))?.name ||
    '自定义',
  set: (value) => {
    draft.value.bankId = banks.value.find((item) => item.name === value)?.id || null;
  },
});
const draftType = computed({
  get: () => (draft.value.cardType === 'credit' ? '信用卡' : '储蓄卡'),
  set: (value) => {
    draft.value.cardType = value === '信用卡' ? 'credit' : 'debit';
  },
});
const draftStatus = computed({
  get: () => statusMap[draft.value.status] || '正常',
  set: (value) => {
    draft.value.status = Object.keys(statusMap).find((key) => statusMap[key] === value);
  },
});
const draftTagStatus = computed({
  get: () => (tagDraft.value.status === '1' ? '停用' : '启用'),
  set: (value) => {
    tagDraft.value.status = value === '停用' ? '1' : '0';
  },
});
function toggleTag(id: string) {
  draft.value.tagIds = draft.value.tagIds.includes(id)
    ? draft.value.tagIds.filter((item) => item !== id)
    : [...draft.value.tagIds, id];
}
async function save() {
  const mutationStamp = stamp;
  if (saving.value) return;
  formError.value = '';
  if (!draft.value.bankId && !String(draft.value.customBankName || '').trim()) {
    formError.value = '请选择银行或填写自定义银行';
    return;
  }
  if (!draft.value.id && !String(draft.value.cardNo || '').trim()) {
    formError.value = '请输入卡号';
    return;
  }
  if (draft.value.creditLimit !== '' && Number(draft.value.creditLimit) < 0) {
    formError.value = '信用额度不能为负数';
    return;
  }
  for (const key of ['statementDay', 'repaymentDay'])
    if (
      draft.value[key] !== '' &&
      draft.value[key] != null &&
      (!Number.isInteger(Number(draft.value[key])) ||
        Number(draft.value[key]) < 1 ||
        Number(draft.value[key]) > 31)
    ) {
      formError.value = '账单日和还款日必须为1至31';
      return;
    }
  if (draft.value.expiryMonth && !/^\d{4}-\d{2}(-01)?$/.test(draft.value.expiryMonth)) {
    formError.value = '有效期格式为YYYY-MM';
    return;
  }
  saving.value = true;
  try {
    const data = { ...draft.value };
    if (data.expiryMonth && data.expiryMonth.length === 7) data.expiryMonth += '-01';
    if (!data.cardNo) delete data.cardNo;
    for (const key of [
      'openedDate',
      'expiryMonth',
      'creditLimit',
      'statementDay',
      'repaymentDay',
    ])
      if (data[key] === '') data[key] = null;
    const saved: any = await saveCard(data, String(data.id || ''));
    if (!alive || stamp !== mutationStamp) return;
    cards.value = data.id
      ? cards.value.map((item) => (item.id === data.id ? saved : item))
      : [saved, ...cards.value];
    modal.value = false;
  } catch (e) {
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(card: any) {
  const mutationStamp = stamp;
  await deleteCard(String(card.id));
  if (!alive || stamp !== mutationStamp) return;
  cards.value = cards.value.filter((item) => item.id !== card.id);
  delete revealed.value[card.id];
}
function cardNumber(card: any) {
  return revealed.value[card.id]
    ? revealed.value[card.id].replace(/(.{4})/g, '$1 ').trim()
    : [card.cardNoFirst4, '••••', card.cardNoLast4].filter(Boolean).join(' ');
}
async function reveal(card: any, copy = false) {
  menuCardId.value = '';
  if (revealBusy.value) return;
  if (!copy && revealed.value[card.id]) {
    delete revealed.value[card.id];
    return;
  }
  revealBusy.value = card.id;
  const current = stamp;
  try {
    const value = revealed.value[card.id] || await revealCard(String(card.id));
    if (!alive || stamp !== current) return;
    if (copy) {
      uni.setClipboardData({ data: value });
    } else {
      revealed.value = { ...revealed.value, [card.id]: value };
    }
  } catch (e) {
    if (alive && stamp === current) uni.showToast({ title: e.message || '卡号读取失败', icon: 'none' });
  } finally {
    revealBusy.value = '';
  }
}
function editTag(value: any = null) {
  tagDraft.value = value ? { ...value } : { name: '', color: '#419878', status: '0' };
  formError.value = '';
  tagModal.value = true;
}
async function saveTag() {
  const mutationStamp = stamp;
  if (saving.value) return;
  if (!tagDraft.value.name.trim()) {
    formError.value = '请输入标签名称';
    return;
  }
  saving.value = true;
  try {
    const result: any = await saveCardTag(
      tagDraft.value,
      String(tagDraft.value.id || ''),
    );
    if (!alive || stamp !== mutationStamp) return;
    tags.value = tagDraft.value.id
      ? tags.value.map((item) => (item.id === result.id ? result : item))
      : [...tags.value, result];
    tagModal.value = false;
  } catch (e) {
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function removeTag(value: any) {
  const mutationStamp = stamp;
  await deleteCardTag(String(value.id));
  if (!alive || stamp !== mutationStamp) return;
  tags.value = tags.value.filter((item) => item.id !== value.id);
  await load();
}
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="" back @back="uni.navigateBack()" /><view
      class="body ui-page-body"
      :class="themeClass('body')"
      ><view class="actions search-toolbar ui-toolbar"
        ><FormField compact stretch hide-label label="搜索银行卡" placeholder="银行、卡名或尾号" v-model="keyword" /><MobileButton
          label="新增银行卡"
          icon="ant-design:plus-outlined"
          @click="edit()" /><MobileButton
          label="新增标签"
          icon="ant-design:tags-outlined"
          variant="quiet"
          @click="editTag()" /></view
      ><view
        class="filters ui-field-row"
        ><FormField
          compact
          stretch
          label="银行"
          kind="selector"
          :options="['全部', ...Array.from(new Set(cards.map((item) => item.bankName)))]"
          v-model="bank" /><FormField
          compact
          stretch
          label="类型"
          kind="selector"
          :options="['全部', '储蓄卡', '信用卡']"
          v-model="type" /><FormField
          compact
          stretch
          label="状态"
          kind="selector"
          :options="['全部', ...Object.values(statusMap)]"
          v-model="status" /><FormField
          compact
          stretch
          label="标签"
          kind="selector"
          :options="['全部', ...tags.map((item) => item.name)]"
          v-model="tag" /></view
      ><PageState skeleton="list"
        :loading="loading"
        :error="error"
        :empty="!loading && !filtered.length"
        @retry="load"
        >
<template #loading><view class="card-grid ui-gap-md"><view v-for="n in 4" :key="n" class="card ui-gap-sm" :class="themeClass('card')"><view class="card-face ui-pad-card ui-gap-sm"><ContentSkeleton variant="cover" /></view><ContentSkeleton variant="caption" /></view></view></template>
<view class="card-grid ui-gap-md"
          ><view
            v-for="card in filtered"
            :key="card.id"
            class="card ui-gap-sm"
            :class="themeClass('card')"
            ><view
              class="card-face ui-pad-card ui-gap-sm"
              :class="{ 'card-face-image': !!coverUrls[card.id] }"
              :style="{ backgroundColor: card.coverColor || '#334766' }"
              ><image
                v-if="coverUrls[card.id]"
                :src="coverUrls[card.id]"
                mode="aspectFill"
                class="cover"
              /><view v-if="coverErrors[card.id]" class="actions ui-toolbar"
                ><text class="ui-type-body">{{ coverErrors[card.id] }}</text
                ><MobileButton
                  label="重试封面"
                  variant="quiet"
                  :loading="coverLoading[card.id]"
                  @click="loadCover(card)" /></view
              ><view v-if="!coverUrls[card.id]" class="face-heading ui-row">
                <AppIcon name="ant-design:bank-outlined" :size="22" color="#f1f4f9" />
                <text class="title face-title">{{ card.bankName }}</text>
              </view>
              <view class="face-middle ui-row">
                <view v-if="!coverUrls[card.id]" class="card-chip" />
                <text class="number" :class="{ 'number-on-image': !!coverUrls[card.id] }">{{ cardNumber(card) }}</text>
              </view><view v-if="!coverUrls[card.id]" class="face-bottom ui-row"
                ><text class="ui-type-caption">{{ card.cardName || card.bankCode || 'BANK CARD' }}</text
                ><text class="ui-type-caption">{{ card.cardType === 'credit' ? '信用卡' : '储蓄卡' }}</text></view
              ></view
            ><view
              class="card-menu-anchor"
              :class="{ 'card-menu-active': menuCardId === card.id }"
            >
              <ConfirmAction label="删除银行卡" :message="'删除尾号 ' + card.cardNoLast4 + ' 的银行卡？'" :action="() => remove(card)">
                <template #default="{ open, busy }">
                  <button class="card-more ui-type-body" :id="'card-more-' + card.id" role="button" aria-label="银行卡更多操作" aria-haspopup="menu" :aria-expanded="menuCardId === card.id" :loading="revealBusy === card.id || busy" :disabled="revealBusy === card.id || busy" @click="toggleMenu(card)">
                    <AppIcon v-if="revealBusy !== card.id && !busy" name="lucide:ellipsis" :size="24" color="#f1f4f9" />
                  </button>
                  <view v-if="menuCardId === card.id" class="card-menu ui-pad-sm ui-gap-xs" :style="{ left: menuLeft + 'px', top: menuTop + 'px' }" :class="themeClass('card-menu')" role="menu">
                    <button class="card-menu-item ui-row" role="menuitem" @click="reveal(card)"><AppIcon :name="revealed[card.id] ? 'ant-design:eye-invisible-outlined' : 'ant-design:eye-outlined'" :size="18" /><text class="ui-type-body">{{ revealed[card.id] ? '隐藏卡号' : '查看卡号' }}</text></button>
                    <button class="card-menu-item ui-row" role="menuitem" @click="reveal(card, true)"><AppIcon name="ant-design:copy-outlined" :size="18" /><text class="ui-type-body">复制卡号</text></button>
                    <button class="card-menu-item ui-row" role="menuitem" @click="edit(card)"><AppIcon name="ant-design:edit-outlined" :size="18" /><text class="ui-type-body">编辑银行卡</text></button>
                    <button class="card-menu-item card-menu-danger ui-row" role="menuitem" @click="menuCardId = ''; open()"><AppIcon name="ant-design:delete-outlined" :size="18" color="#dc5454" /><text class="ui-type-body">删除银行卡</text></button>
                  </view>
                </template>
              </ConfirmAction>
            </view>
            <view v-if="card.alias || coverUrls[card.id] || card.status !== 'normal'" class="card-caption ui-row"
              ><text class="card-name">{{ card.alias || (coverUrls[card.id] ? card.bankName : '') }}</text
              ><text v-if="card.status !== 'normal'" class="card-status">{{
                statusMap[card.status]
              }}</text></view
            ><text v-if="card.cardType === 'credit'" class="card-meta" :class="themeClass('secondary-text')"
              >额度 {{ card.creditLimit || '—' }} · 账单日
              {{ card.statementDay || '—' }} · 还款日 {{ card.repaymentDay || '—' }}</text
            ><view v-if="card.tags?.length" class="card-tags ui-row"><text v-for="item in card.tags" :key="item.id" class="card-tag" :class="themeClass('secondary-text')">{{ item.name }}</text></view
            ><text v-if="card.remark" class="card-meta" :class="themeClass('secondary-text')">{{ card.remark }}</text
            ></view></view></PageState
      ><view class="tags ui-mt-section"
        ><view v-for="item in tags" :key="item.id" class="actions ui-toolbar"
          ><text class="ui-type-body">{{ item.name }}</text
          ><MobileButton
            label="编辑标签"
            icon="ant-design:edit-outlined"
            variant="quiet"
            @click="editTag(item)" /><ConfirmAction
            label="删除标签"
            :action="() => removeTag(item)" /></view></view></view
    ><view v-if="menuCardId" class="menu-backdrop" @click="menuCardId = ''" />
    <AdaptiveModal v-if="modal" label="银行卡" :busy="saving" @close="modal = false"
      ><view
        class="draft-face ui-pad-card ui-gap-sm"
        :class="{ 'card-face-image': !!coverPreview }"
        :style="{ backgroundColor: draft.coverColor || '#334766' }"
        ><image
          v-if="coverPreview"
          :src="coverPreview"
          mode="aspectFill"
          class="draft-cover"
        /><text v-if="!coverPreview" class="title">{{
          draftBank === '自定义' ? draft.customBankName || '选择银行' : draftBank
        }}</text
        ><view v-if="!coverPreview" class="card-chip" /><text class="ui-type-body" v-if="!coverPreview">{{ draftType }}</text></view
      ><view class="actions ui-toolbar"
        ><MobileButton
          label="上传卡面"
          :loading="coverBusy"
          @click="uploadCover" /><MobileButton
          v-if="draft.coverFileIds?.length"
          label="移除卡面"
          variant="quiet"
          @click="
            draft.coverFileIds = [];
            coverPreview = '';
          " /></view
      ><view class="palette ui-row"
        ><view
          v-for="color in [
            '#334766',
            '#38605C',
            '#685174',
            '#87534F',
            '#716348',
            '#414854',
          ]"
          :key="color"
          class="color-target"
          role="button"
          :aria-label="'卡面颜色 ' + color"
          @click="draft.coverColor = color"
          ><view
            class="color-dot"
            :class="{ 'color-selected': draft.coverColor === color }"
            :style="{ backgroundColor: color }" /></view></view
      ><FormField appearance="soft" label="银行" kind="selector"
        :options="['自定义', ...banks.map((item) => item.name)]" v-model="draftBank" />
      <FormField v-if="!draft.bankId" appearance="soft" label="自定义银行" v-model="draft.customBankName" />
      <view class="ui-field-row">
        <FormField appearance="soft" compact stretch label="卡名称" v-model="draft.cardName" />
        <FormField appearance="soft" compact stretch label="别名" v-model="draft.alias" />
      </view>
      <view class="ui-field-row">
        <FormField appearance="soft" compact stretch label="类型" kind="selector"
          :options="['储蓄卡', '信用卡']" v-model="draftType" />
        <FormField appearance="soft" compact stretch label="状态" kind="selector"
          :options="Object.values(statusMap)" v-model="draftStatus" />
      </view>
      <FormField appearance="soft" :label="draft.id ? '新卡号（留空保留）' : '卡号'" v-model="draft.cardNo" password />
      <MobileButton label="更多信息" variant="quiet" @click="moreInfo = !moreInfo">
        <text class="ui-type-body">更多信息</text>
      </MobileButton>
      <view v-if="moreInfo">
        <FormField appearance="soft" label="开户支行" v-model="draft.branchName" />
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="开户日期" kind="date" v-model="draft.openedDate" />
          <FormField appearance="soft" compact stretch label="到期月份" placeholder="YYYY-MM" v-model="draft.expiryMonth" />
        </view>
        <view v-if="draft.cardType === 'credit'">
          <FormField appearance="soft" label="信用额度" input-type="digit" v-model="draft.creditLimit" />
          <view class="ui-field-row">
            <FormField appearance="soft" compact stretch label="账单日" input-type="number" v-model="draft.statementDay" />
            <FormField appearance="soft" compact stretch label="还款日" input-type="number" v-model="draft.repaymentDay" />
          </view>
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="卡面颜色" v-model="draft.coverColor" />
          <FormField appearance="soft" compact stretch label="排序" input-type="number" v-model="draft.sortOrder" />
        </view>
        <FormField appearance="soft" label="封面来源URL" v-model="draft.coverSourceUrl" />
        <FormField appearance="soft" label="备注" kind="textarea" v-model="draft.remark" />
      </view>
      <view class="actions ui-toolbar"
        ><view v-for="item in tags" :key="item.id" class="actions ui-toolbar"
          ><MobileButton
            :label="item.name"
            :icon="
              draft.tagIds.includes(item.id)
                ? 'ant-design:check-square-outlined'
                : 'ant-design:border-outlined'
            "
            :disabled="item.status !== '0' && !draft.tagIds.includes(item.id)"
            variant="quiet"
            @click="toggleTag(item.id)"
          /><text class="ui-type-body">{{ item.name }}</text></view
        ></view
      ><text v-if="formError" class="error ui-py-section ui-type-body">{{ formError }}</text
      ><view class="actions ui-toolbar"
        ><MobileButton
          label="取消"
          :disabled="saving"
          variant="quiet"
          @click="modal = false" /><MobileButton
          label="保存"
          :loading="saving"
          @click="save" /></view></AdaptiveModal
    ><AdaptiveModal v-if="tagModal" label="标签" :busy="saving" @close="tagModal = false"
      ><FormField label="名称" v-model="tagDraft.name" /><FormField
        label="颜色"
        v-model="tagDraft.color" /><FormField
        label="状态"
        kind="selector"
        :options="['启用', '停用']"
        v-model="draftTagStatus" /><text v-if="formError" class="error ui-py-section ui-type-body">{{
        formError
      }}</text
      ><MobileButton label="保存" :loading="saving" @click="saveTag" /></AdaptiveModal
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
