<script setup lang="ts">
import FormActions from '../../components/FormActions.uvue';
import { isRequired, missingRequired } from '../../services/form-required.ts';
import CardFaceLoading from './components/CardFaceLoading.uvue';
import { computed, nextTick, onMounted, onUnmounted, ref, watch } from 'vue';
import spacing from '../../styles/spacing.json';
import AppIcon from '../../components/AppIcon.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import PageHeader from '../../components/PageHeader.uvue';
import PageState from '../../components/PageState.uvue';
import FormField from '../../components/FormField.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import AdaptiveModal from '../../components/AdaptiveModal.uvue';
import {
  fetchCards,
  fetchCardCoverTemplates,
  fetchBanks,
  fetchCardTags,
  saveCard,
  deleteCard,
  revealCard,
  saveCardTag,
  deleteCardTag,
} from './services/finance.ts';
import { chooseAndUploadAttachment, authFileUrl } from '../../services/attachments.ts';
import { useDomainPage } from '../../services/domains/page-session.ts';
import { themeClass } from '../../services/theme.ts';
function back() {
  // H5 直达或刷新后只有当前页，navigateBack 不会报错，也不会回到站内入口。
  if (getCurrentPages().length <= 1) {
    uni.switchTab({ url: '/pages/life/index' });
    return;
  }
  uni.navigateBack();
}
const cards = ref<any[]>([]),
  banks = ref<any[]>([]),
  tags = ref<any[]>([]);
// 与 Web 的 bank-card/model.ts 保持一致：未自定义时按银行代码选择卡面色。
const cardColors = ['#334766', '#38605C', '#685174', '#87534F', '#716348', '#414854'];
function cardColor(card: Record<string, any>) {
  if (card.coverColor) return card.coverColor;
  const code = banks.value.find((item) => String(item.id) === String(card.bankId))?.code || card.bankCode || '';
  const hash = [...String(code)].reduce((total, char) => total + (char.codePointAt(0) || 0), 0);
  return cardColors[hash % cardColors.length];
}
const coverFileIds = ref<Record<string, string>>({});
const coverAttempts: Record<string, number> = {};
const coverUrls = ref<Record<string, string>>({}),
  coverErrors = ref<Record<string, string>>({}),
  coverLoading = ref<Record<string, boolean>>({});
const coverBusy = ref(false),
  coverPreview = ref('');
const loading = ref(false),
  refreshing = ref(false),
  saving = ref(false),
  error = ref(''),
  formError = ref(''),
  modal = ref(false),
  tagModal = ref(false),
  moreInfo = ref(false),
  draft = ref<Record<string, any>>({}),
  tagDraft = ref<Record<string, any>>({}),
  revealed = ref<Record<string, string>>({}),
  revealBusy = ref(''),
  menuCardId = ref('');
const templateOpen = ref(false), templateLoading = ref(false), templateError = ref('');
const templateImageLoading = ref<Record<string, boolean>>({});
const templates = ref<any[]>([]), templateUrls = ref<Record<string, string>>({}), templateImageErrors = ref<Record<string, string>>({});
let templateStamp = 0;
function coverFile(card: any) { return card.coverTemplateFileId || card.coverFileIds?.[0]; }
function clearCover() {
  draft.value.coverTemplateId = null;
  draft.value.coverTemplateFileId = null;
  draft.value.coverTemplateName = null;
  draft.value.coverFileIds = [];
  draft.value.coverSourceUrl = '';
  coverPreview.value = '';
}
watch(() => [draft.value.bankId, draft.value.cardType], (value, old) => {
  templateStamp++;
  templateOpen.value = false;
  templateLoading.value = false;
  if (draft.value.coverTemplateId && old && (value[0] !== old[0] || value[1] !== old[1]) &&
      (draft.value.bankId !== draft.value.templateBankId || draft.value.cardType !== draft.value.templateCardType)) clearCover();
});
async function loadTemplateImage(item: any, current: number) {
  templateImageErrors.value[item.id] = '';
  templateImageLoading.value[item.id] = true;
  try {
    const url = await authFileUrl(String(item.fileId));
    if (alive && current === templateStamp && modal.value) templateUrls.value[item.id] = url;
  } catch (e) {
    if (alive && current === templateStamp) templateImageErrors.value[item.id] = e.message || '图片加载失败';
  } finally {
    if (alive && current === templateStamp) templateImageLoading.value[item.id] = false;
  }
}
async function openTemplates() {
  if (!draft.value.bankId || templateLoading.value) return;
  const current = ++templateStamp;
  templateOpen.value = true;
  templateLoading.value = true;
  templateError.value = '';
  templates.value = [];
  templateUrls.value = {};
  templateImageErrors.value = {};
  try {
    const result = await fetchCardCoverTemplates(String(draft.value.bankId), draft.value.cardType);
    if (!alive || current !== templateStamp || !modal.value) return;
    templates.value = result;
    await Promise.all(result.map(item => loadTemplateImage(item, current)));
  } catch (e) {
    if (alive && current === templateStamp) templateError.value = e.message;
  } finally {
    if (current === templateStamp) templateLoading.value = false;
  }
}
function selectTemplate(item: any) {
  clearCover();
  draft.value.coverTemplateId = item.id;
  draft.value.coverTemplateFileId = item.fileId;
  draft.value.coverTemplateName = item.name;
  draft.value.templateBankId = draft.value.bankId;
  draft.value.templateCardType = draft.value.cardType;
  coverPreview.value = templateUrls.value[item.id] || '';
  templateOpen.value = false;
}
const menuLeft = ref(0), menuTop = ref(0);
function toggleMenu(card: any) {
  if (menuCardId.value === card.id) { menuCardId.value = ''; return; }
  uni.createSelectorQuery().select('#card-more-' + card.id).boundingClientRect((rect) => {
    if (!alive || !rect || Array.isArray(rect)) return;
    const viewport = uni.getWindowInfo();
    const menuWidth = 168;
    const menuItems = (card.cardNoLast4 ? 3 : 1) + (viewMode.value === 'stack' ? 1 : 0);
    const menuHeight = spacing.controlMin * menuItems + spacing.detail * (menuItems - 1) + spacing.inline * 2;
    menuLeft.value = Math.max(spacing.overlayInline, Math.min(rect.right - menuWidth, viewport.windowWidth - spacing.overlayInline - menuWidth));
    const below = rect.bottom + spacing.detail;
    menuTop.value = Math.max(spacing.overlayInline, below + menuHeight <= viewport.windowHeight - spacing.overlayInline ? below : rect.top - menuHeight - spacing.detail);
    menuCardId.value = card.id;
  }).exec();
}
let alive = true,
  stamp = 0;
onUnmounted(() => {
  finishStackDrag();
  stopStackRebound();
  uni.offWindowResize(measureStackFace);
  alive = false;
  stamp++;
  revealed.value = {};
});
async function load() {
  const current = ++stamp;
  loading.value = true;
  error.value = '';
  try {
    const data = await Promise.all([fetchCards(), fetchBanks(), fetchCardTags()]);
    if (alive && current === stamp) {
      cards.value = data[0];
      banks.value = data[1];
      tags.value = data[2];
      for (const id of Object.keys(coverFileIds.value)) {
        if (!cards.value.some(card => String(card.id) === id && String(coverFile(card) || '') === coverFileIds.value[id])) clearCardCover(id);
      }
      for (const card of cards.value) {
        if (coverFile(card)) loadCover(card, current);
      }
    }
  } catch (e) {
    if (alive && current === stamp) error.value = e.message;
  } finally {
    if (alive && current === stamp) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
function clearCardCover(id: string) {
  coverAttempts[id] = (coverAttempts[id] || 0) + 1;
  delete coverFileIds.value[id];
  delete coverUrls.value[id];
  delete coverErrors.value[id];
  delete coverLoading.value[id];
}
async function loadCover(card: any, current = stamp) {
  const id = String(card.id), fileId = String(coverFile(card));
  // 同一卡面刷新时复用已经显示的图片，不先清空再下载。
  if (coverFileIds.value[id] === fileId && coverUrls.value[id] && !coverLoading.value[id] && !coverErrors.value[id]) return;
  clearCardCover(id);
  const attempt = coverAttempts[id];
  coverFileIds.value[id] = fileId;
  coverLoading.value[id] = true;
  coverErrors.value[id] = '';
  try {
    const url = await authFileUrl(fileId);
    if (alive && stamp === current && coverAttempts[id] === attempt)
      coverUrls.value[id] = url;
    // 下载完成不代表图片可见，交给 image 的 load/error 结束骨架。
  } catch (e) {
    if (alive && stamp === current && coverAttempts[id] === attempt) {
      coverErrors.value[id] = e.message || '封面加载失败';
      coverLoading.value[id] = false;
    }
  }
}
function finishCover(id: string, source: string, failed = false) {
  if (!alive || coverUrls.value[id] !== source) return;
  coverLoading.value[id] = false;
  if (failed) {
    coverErrors.value[id] = '封面加载失败';
    delete coverUrls.value[id];
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    stamp++;
    cards.value = [];
    finishStackDrag();
    stopStackRebound();
    cardTouchActive.value = false;
    expandedCardId.value = '';
    menuCardId.value = "";
    revealed.value = {};
    for (const id of Object.keys(coverFileIds.value)) clearCardCover(id);
    coverUrls.value = {};
    coverErrors.value = {};
    coverLoading.value = {};
    coverPreview.value = '';
    coverBusy.value = false;
    draft.value = {};
    modal.value = false;
    templateStamp++;
    templateOpen.value = false;
    templateLoading.value = false;
    templates.value = [];
    templateUrls.value = {};
    tagModal.value = false;
    loading.value = false;
    refreshing.value = false;
  },
);
const statusMap: Record<string, string> = {
  normal: '正常',
  frozen: '冻结',
  lost: '挂失',
  closed: '已注销',
};
const sortedCards = computed(() =>
  [...cards.value].sort((a, b) => a.sortOrder - b.sortOrder),
);
let savedView = 'stack';
try {
  if (uni.getStorageSync('bank-card-view-mode') === 'grid') savedView = 'grid';
} catch (_) { /* 存储不可用时默认卡包视图 */ }
const viewMode = ref(savedView), expandedCardId = ref('');
// 正常区间松手停留，仅越过两端边界时产生阻尼和回弹。
const stackSpread = ref(0), stackHolding = ref(false);
const stackElastic = ref(0), stackRebounding = ref(false);
let stackReboundTimer: ReturnType<typeof setTimeout> | undefined;
let stackDragPosition = 0;
// 从卡包起手的整段触摸禁用刷新；短划取消长按后仍允许正常滚动。
const cardTouchActive = ref(false);
function finishCardTouch(event: any) {
  if (!event.touches?.length) cardTouchActive.value = false;
}
const stackFaceHeight = ref(184);
const stackPeek = spacing.controlMin + spacing.card + spacing.inline + spacing.detail;
const stackRange = computed(() => Math.max(1, stackFaceHeight.value + spacing.section - stackPeek));
// 回弹几何上限保留至少 44px 的卡片可点选区域，避免卡数多时过度拉伸。
const stackElasticLimit = (stackPeek - spacing.controlMin) * 0.75;
function stopStackRebound(reset = true) {
  if (stackReboundTimer !== undefined) clearTimeout(stackReboundTimer);
  stackReboundTimer = undefined;
  stackRebounding.value = false;
  if (reset) stackElastic.value = 0;
}
function reboundStack() {
  stopStackRebound(false);
  if (Math.abs(stackElastic.value) < 0.1 || !alive) { stackElastic.value = 0; return; }
  const from = stackElastic.value, started = Date.now();
  stackRebounding.value = true;
  function frame() {
    const elapsed = (Date.now() - started) / 1000;
    if (!alive || viewMode.value !== 'stack' || elapsed >= 0.6) { stopStackRebound(); return; }
    // 欠阻尼弹簧：初速为零，轻微越过原位后衰减，避免反复大幅抖动。
    stackElastic.value = from * Math.exp(-12 * elapsed) *
      (Math.cos(18 * elapsed) + 12 / 18 * Math.sin(18 * elapsed));
    stackReboundTimer = setTimeout(frame, 16);
  }
  stackReboundTimer = setTimeout(frame, 16);
}
let stackHoldTimer: ReturnType<typeof setTimeout> | undefined;
let stackTouchId: number | null = null;
let stackStartX = 0, stackStartY = 0, stackLastY = 0;
let suppressStackClickUntil = 0;
let stackTouchInput = false, ignoreStackMouseUntil = 0;
function measureStackFace() {
  nextTick(() => {
    if (!alive || viewMode.value !== 'stack') return;
    uni.createSelectorQuery().select('.card-stack .card-face').boundingClientRect((rect) => {
      if (alive && rect && !Array.isArray(rect) && rect.height > 0) stackFaceHeight.value = rect.height;
    }).exec();
  });
}
onMounted(() => { measureStackFace(); uni.onWindowResize(measureStackFace); });
watch(() => [viewMode.value, cards.value.length, loading.value], measureStackFace);
function stackCardStyle(card: any, index: number) {
  if (viewMode.value !== 'stack' || cardExpanded(card) || index === sortedCards.value.length - 1) return {};
  return { height: (stackPeek + stackRange.value * stackSpread.value + stackElastic.value) + 'px' };
}
function finishStackDrag() {
  if (stackHoldTimer !== undefined) clearTimeout(stackHoldTimer);
  stackHoldTimer = undefined;
  if (stackHolding.value) suppressStackClickUntil = Date.now() + 450;
  stackHolding.value = false;
  stackTouchId = null;
  if (stackTouchInput) ignoreStackMouseUntil = Date.now() + 750;
  stackTouchInput = false;
  reboundStack();
  // #ifdef WEB
  window.removeEventListener('mousemove', moveStackDrag);
  window.removeEventListener('mouseup', finishStackDrag);
  window.removeEventListener('blur', finishStackDrag);
  // #endif
}
function startStackDrag(event: any) {
  if (viewMode.value !== 'stack' || cards.value.length < 2 || menuCardId.value || modal.value) return;
  if (event.type === 'mousedown' && Date.now() < ignoreStackMouseUntil) return;
  if (event.type === 'mousedown' && event.button != null && event.button !== 0) return;
  finishStackDrag();
  if (event.touches && event.touches.length !== 1) return;
  if (!event.touches && event.type !== 'mousedown') return;
  // 回弹中重新按住，接住当前视觉位置，不突然跳回边界。
  stopStackRebound(false);
  const visualPosition = stackSpread.value * stackRange.value + stackElastic.value;
  const boundary = Math.max(0, Math.min(stackRange.value, visualPosition));
  const overshoot = visualPosition - boundary;
  stackDragPosition = boundary + (overshoot === 0 ? 0 :
    Math.sign(overshoot) * -stackElasticLimit / 0.35 *
    Math.log(Math.max(0.001, 1 - Math.abs(overshoot) / stackElasticLimit)));
  stackTouchInput = event.type === 'touchstart';
  const point = event.touches ? event.touches[0] : event;
  stackTouchId = point.identifier ?? 0;
  stackStartX = point.clientX;
  stackStartY = stackLastY = point.clientY;
  suppressStackClickUntil = 0;
  measureStackFace();
  stackHoldTimer = setTimeout(() => {
    stackHoldTimer = undefined;
    if (stackTouchId !== null && alive) stackHolding.value = true;
  }, 220);
  // #ifdef WEB
  if (event.type === 'mousedown') {
    window.addEventListener('mousemove', moveStackDrag);
    window.addEventListener('mouseup', finishStackDrag);
    window.addEventListener('blur', finishStackDrag);
  }
  // #endif
}
function moveStackDrag(event: any) {
  if (stackTouchId === null) return;
  if (event.touches && event.touches.length !== 1) { finishStackDrag(); return; }
  const point = event.touches ? event.touches[0] : event;
  if (event.touches && point.identifier !== stackTouchId) { finishStackDrag(); return; }
  if (!stackHolding.value) {
    if (Math.abs(point.clientX - stackStartX) + Math.abs(point.clientY - stackStartY) > spacing.inline) {
      finishStackDrag(); // 长按前移动交给页面滚动，不接管短划。
      suppressStackClickUntil = Date.now() + 450;
    }
    return;
  }
  event.preventDefault?.();
  event.stopPropagation?.();
  const delta = point.clientY - stackLastY;
  stackLastY = point.clientY;
  stackDragPosition += delta;
  const bounded = Math.max(0, Math.min(stackRange.value, stackDragPosition));
  const overshoot = stackDragPosition - bounded;
  stackSpread.value = bounded / stackRange.value;
  stackElastic.value = Math.sign(overshoot) * stackElasticLimit *
    (1 - Math.exp(-Math.abs(overshoot) * 0.35 / stackElasticLimit));
}
function toggleView() {
  finishStackDrag();
  stopStackRebound();
  viewMode.value = viewMode.value === 'stack' ? 'grid' : 'stack';
  menuCardId.value = '';
  expandedCardId.value = '';
  revealed.value = {};
  try { uni.setStorageSync('bank-card-view-mode', viewMode.value); }
  catch (_) { /* 存储不可用不影响当前切换 */ }
}
function cardExpanded(card: any) {
  return viewMode.value === 'grid' || expandedCardId.value === card.id;
}
function activateCard(card: any) {
  if (Date.now() < suppressStackClickUntil) return;
  if (viewMode.value === 'grid') { edit(card); return; }
  menuCardId.value = '';
  revealed.value = {};
  expandedCardId.value = expandedCardId.value === card.id ? '' : card.id;
}
function cardActionLabel(card: any) {
  const action = viewMode.value === 'grid' ? '编辑' : cardExpanded(card) ? '收起' : '展开';
  return action + '银行卡：' + (card.alias || card.cardName || card.bankName) +
    (card.cardNoLast4 ? ' 尾号 ' + card.cardNoLast4 : '');
}
async function uploadCover() {
  const mutationStamp = stamp,
    editingDraft = draft.value;
  if (coverBusy.value) return;
  coverBusy.value = true;
  formError.value = '';
  try {
    const file = await chooseAndUploadAttachment('/file/upload', {
      bizType: 'bank_card_cover',
    });
    if (!alive || stamp !== mutationStamp || !modal.value || draft.value !== editingDraft)
      return;
    clearCover();
    draft.value.coverFileIds = [String(file.id)];
    const url = await authFileUrl(String(file.id));
    if (!alive || stamp !== mutationStamp || !modal.value || draft.value !== editingDraft)
      return;
    coverPreview.value = url;
  } catch (e) {
    if (alive && stamp === mutationStamp && modal.value && draft.value === editingDraft)
      formError.value = e.message;
  } finally {
    if (alive && stamp === mutationStamp) coverBusy.value = false;
  }
}
function edit(card: any = null) {
  menuCardId.value = "";
  moreInfo.value = false;
  coverPreview.value = card ? coverUrls.value[card.id] || '' : '';
  draft.value = card
    ? {
        ...card,
        templateBankId: card.bankId,
        templateCardType: card.cardType,
        tagIds: card.tags.map((item) => String(item.id)),
        coverFileIds: [...(card.coverFileIds || [])],
      }
    : {
        bankId: null,
        customBankName: '',
        cardName: '',
        alias: '',
        cardType: 'debit',
        cardNo: '',
        branchName: '',
        status: 'normal',
        openedDate: '',
        expiryMonth: '',
        creditLimit: '',
        statementDay: '',
        repaymentDay: '',
        coverTemplateId: null,
        coverColor: null,
        coverSourceUrl: '',
        sortOrder: 0,
        remark: '',
        tagIds: [],
        coverFileIds: [],
      };
  formError.value = '';
  templateStamp++;
  templateOpen.value = false;
  templateLoading.value = false;
  modal.value = true;
}
const draftBank = computed({
  get: () =>
    banks.value.find((item) => String(item.id) === String(draft.value.bankId))?.name ||
    '自定义',
  set: (value) => {
    draft.value.bankId = banks.value.find((item) => item.name === value)?.id || null;
  },
});
const draftType = computed({
  get: () => (draft.value.cardType === 'credit' ? '信用卡' : '储蓄卡'),
  set: (value) => {
    draft.value.cardType = value === '信用卡' ? 'credit' : 'debit';
  },
});
const draftStatus = computed({
  get: () => statusMap[draft.value.status] || '正常',
  set: (value) => {
    draft.value.status = Object.keys(statusMap).find((key) => statusMap[key] === value);
  },
});
const draftTagStatus = computed({
  get: () => (tagDraft.value.status === '1' ? '停用' : '启用'),
  set: (value) => {
    tagDraft.value.status = value === '停用' ? '1' : '0';
  },
});
function toggleTag(id: string) {
  draft.value.tagIds = draft.value.tagIds.includes(id)
    ? draft.value.tagIds.filter((item) => item !== id)
    : [...draft.value.tagIds, id];
}
async function save() {
  const mutationStamp = stamp;
  if (saving.value) return;
  formError.value = '';
  if (missingRequired('card', draft.value)) {
    formError.value = '请选择银行或填写自定义银行';
    return;
  }
  const cardNo = String(draft.value.cardNo || '').trim();
  if (cardNo && !/^[0-9]{12,19}$/.test(cardNo.replace(/[\s-]/g, ''))) {
    formError.value = '请输入12至19位卡号';
    return;
  }
  if (draft.value.creditLimit !== '' && Number(draft.value.creditLimit) < 0) {
    formError.value = '信用额度不能为负数';
    return;
  }
  for (const key of ['statementDay', 'repaymentDay'])
    if (
      draft.value[key] !== '' &&
      draft.value[key] != null &&
      (!Number.isInteger(Number(draft.value[key])) ||
        Number(draft.value[key]) < 1 ||
        Number(draft.value[key]) > 31)
    ) {
      formError.value = '账单日和还款日必须为1至31';
      return;
    }
  if (draft.value.expiryMonth && !/^\d{4}-\d{2}(-01)?$/.test(draft.value.expiryMonth)) {
    formError.value = '有效期格式为YYYY-MM';
    return;
  }
  saving.value = true;
  try {
    const data = { ...draft.value };
    if (data.expiryMonth && data.expiryMonth.length === 7) data.expiryMonth += '-01';
    if (!data.cardNo) delete data.cardNo;
    for (const key of [
      'openedDate',
      'expiryMonth',
      'creditLimit',
      'statementDay',
      'repaymentDay',
    ])
      if (data[key] === '') data[key] = null;
    const saved: any = await saveCard(data, String(data.id || ''));
    if (!alive || stamp !== mutationStamp) return;
    cards.value = data.id
      ? cards.value.map((item) => (item.id === data.id ? saved : item))
      : [saved, ...cards.value];
    if (coverFile(saved)) loadCover(saved, mutationStamp);
    else clearCardCover(String(saved.id));
    modal.value = false;
  } catch (e) {
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(card: any) {
  const mutationStamp = stamp;
  await deleteCard(String(card.id));
  if (!alive || stamp !== mutationStamp) return;
  cards.value = cards.value.filter((item) => item.id !== card.id);
  delete revealed.value[card.id];
  clearCardCover(String(card.id));
}
function cardNumber(card: any) {
  if (!card.cardNoLast4) return '';
  return revealed.value[card.id]
    ? revealed.value[card.id].replace(/(.{4})/g, '$1 ').trim()
    : [card.cardNoFirst4, '••••', card.cardNoLast4].filter(Boolean).join(' ');
}
async function reveal(card: any, copy = false) {
  menuCardId.value = '';
  if (revealBusy.value) return;
  if (!copy && revealed.value[card.id]) {
    delete revealed.value[card.id];
    return;
  }
  revealBusy.value = card.id;
  const current = stamp;
  try {
    const value = revealed.value[card.id] || await revealCard(String(card.id));
    if (!alive || stamp !== current) return;
    if (copy) {
      uni.setClipboardData({ data: value });
    } else {
      revealed.value = { ...revealed.value, [card.id]: value };
    }
  } catch (e) {
    if (alive && stamp === current) uni.showToast({ title: e.message || '卡号读取失败', icon: 'none' });
  } finally {
    revealBusy.value = '';
  }
}
function editTag(value: any = null) {
  tagDraft.value = value ? { ...value } : { name: '', color: '#419878', status: '0' };
  formError.value = '';
  tagModal.value = true;
}
async function saveTag() {
  const mutationStamp = stamp;
  if (saving.value) return;
  if (missingRequired('cardTag', tagDraft.value)) {
    formError.value = '请输入标签名称';
    return;
  }
  saving.value = true;
  try {
    const result: any = await saveCardTag(
      tagDraft.value,
      String(tagDraft.value.id || ''),
    );
    if (!alive || stamp !== mutationStamp) return;
    tags.value = tagDraft.value.id
      ? tags.value.map((item) => (item.id === result.id ? result : item))
      : [...tags.value, result];
    tagModal.value = false;
  } catch (e) {
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function removeTag(value: any) {
  const mutationStamp = stamp;
  await deleteCardTag(String(value.id));
  if (!alive || stamp !== mutationStamp) return;
  tags.value = tags.value.filter((item) => item.id !== value.id);
  await load();
}
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    :scroll-locked="stackHolding"
    :refresh-disabled="cardTouchActive"
    @refresh="
      refreshing = true;
      load();
    "
    ><PageHeader title="" back @back="back">
      <view class="header-actions ui-row">
        <button class="header-action" role="button" :aria-label="viewMode === 'stack' ? '切换为平铺视图' : '切换为堆叠视图'" @click="toggleView">
          <AppIcon :name="viewMode === 'stack' ? 'ant-design:appstore-outlined' : 'mdi:wallet'" :size="20" />
        </button>
        <button class="header-action" role="button" aria-label="新增标签" @click="editTag()">
          <AppIcon name="ant-design:tags-outlined" :size="20" />
        </button>
        <button class="header-action" role="button" aria-label="新增银行卡" @click="edit()">
          <AppIcon name="ant-design:plus-outlined" :size="22" />
        </button>
      </view>
    </PageHeader><view
      class="body ui-page-body"
      :class="themeClass('body')"
      ><PageState skeleton="list"
        :loading="loading"
        :error="error"
        :empty="!loading && !sortedCards.length"
        @retry="load"
        >
<template #loading><view class="card-grid ui-gap-md" :class="{ 'card-stack': viewMode === 'stack' }"><view v-for="n in 4" :key="n" class="card ui-gap-sm" :class="[themeClass('card'), { 'card-stack-folded': viewMode === 'stack' && n < 4 }]"><view class="card-face ui-pad-card ui-gap-sm"><CardFaceLoading :layer="n - 1" /></view></view></view></template>
<view class="card-grid ui-gap-md" :class="{ 'card-stack': viewMode === 'stack', 'card-stack-rebounding': stackRebounding }"
          @touchstart="cardTouchActive = true"
          @touchend="finishCardTouch"
          @touchcancel="cardTouchActive = false"
          ><view
            v-for="(card, cardIndex) in sortedCards"
            :key="card.id"
            class="card ui-gap-sm"
            :style="stackCardStyle(card, cardIndex)"
            :class="[themeClass('card'), { 'card-stack-folded': viewMode === 'stack' && !cardExpanded(card) && cardIndex < sortedCards.length - 1, 'card-stack-expanded': viewMode === 'stack' && cardExpanded(card) }]"
            ><view class="card-face-shell"><view
              class="card-face ui-pad-card ui-gap-sm"
              :class="[themeClass('card-face'), { 'card-face-image': !!coverFile(card), 'card-face-draggable': viewMode === 'stack', 'card-face-dragging': stackHolding }]"
              :style="coverFile(card) ? {} : { backgroundColor: cardColor(card) }"
              :aria-busy="!!coverLoading[card.id]"
              role="button"
              tabindex="0"
              :aria-label="cardActionLabel(card)"
              :aria-expanded="viewMode === 'stack' ? cardExpanded(card) : undefined"
              @touchstart="startStackDrag"
              @touchmove="moveStackDrag"
              @touchend="finishStackDrag"
              @touchcancel="finishStackDrag"
              @mousedown="startStackDrag"
              @contextmenu.prevent
              @click="activateCard(card)"
              @keydown.enter.self.prevent="activateCard(card)"
              @keydown.space.self.prevent="activateCard(card)"
              ><view v-if="!coverFile(card)" class="face-orbit" aria-hidden="true" />
              <image
                v-for="source in coverUrls[card.id] ? [coverUrls[card.id]] : []"
                :key="source"
                :src="source"
                :class="{ 'cover-pending': coverLoading[card.id] }"
                @load="finishCover(card.id, source)"
                @error="finishCover(card.id, source, true)"
                mode="aspectFill"
                class="cover"
              />
              <CardFaceLoading v-if="coverLoading[card.id]" :layer="cardIndex" />
              <view v-if="coverErrors[card.id]" class="cover-error ui-gap-sm" :class="themeClass('cover-error')" role="alert"
                ><text class="ui-type-body">{{ coverErrors[card.id] }}</text
                ><view @click.stop><MobileButton
                  label="重试封面"
                  variant="quiet"
                  :loading="coverLoading[card.id]"
                  @click="loadCover(card)" /></view></view
              ><view v-if="!coverFile(card)" class="face-heading ui-row">
                <view class="bank-mark"><AppIcon name="ant-design:bank-outlined" :size="20" color="#f1f4f9" /></view>
                <text class="title face-title">{{ card.bankName }}</text>
              </view>
              <view v-if="!coverFile(card)" class="face-type-anchor">
                <text class="face-type">{{ card.cardType === 'credit' ? '信用卡' : '储蓄卡' }}</text>
              </view>
              <view v-if="!coverFile(card)" class="face-middle ui-row">
                <view class="card-chip" aria-hidden="true"><view class="chip-core" /><view class="chip-line chip-line-top" /><view class="chip-line chip-line-bottom" /></view>
                <text class="number" :class="{ 'number-revealed': !!revealed[card.id] }">{{ cardNumber(card) }}</text>
              </view><view v-if="!coverFile(card)" class="face-bottom ui-row"
                ><text class="face-product ui-type-caption">{{ card.cardName || card.bankCode || 'BANK CARD' }}</text
                ></view
              ></view
            ><view
              v-if="cardExpanded(card)"
              :class="{ 'card-menu-anchor': !coverFile(card), 'card-menu-active': menuCardId === card.id, 'card-image-footer': !!coverFile(card) }"
            >
              <view v-if="coverFile(card)" class="footer-caption ui-row">
                <text class="card-name footer-name" :class="themeClass('footer-name')">{{ card.alias || card.bankName }}</text>
                <text v-if="card.status !== 'normal'" class="card-status">{{ statusMap[card.status] }}</text>
              </view>
              <text v-if="coverFile(card)" class="number number-outside" :class="themeClass('secondary-text')">{{ cardNumber(card) }}</text>
              <view class="card-menu-control"><ConfirmAction label="删除银行卡" :message="card.cardNoLast4 ? '删除尾号 ' + card.cardNoLast4 + ' 的银行卡？' : '删除' + (card.alias || card.cardName || card.bankName) + '的银行卡？'" :action="() => remove(card)">
                <template #default="{ open, busy }">
                  <button class="card-more ui-type-body" :id="'card-more-' + card.id" role="button" aria-label="银行卡更多操作" aria-haspopup="menu" :aria-expanded="menuCardId === card.id" :loading="revealBusy === card.id || busy" :disabled="revealBusy === card.id || busy" @click="toggleMenu(card)">
                    <AppIcon v-if="revealBusy !== card.id && !busy" name="lucide:ellipsis" :size="20" :color="coverFile(card) ? undefined : '#f1f4f9'" />
                  </button>
                  <view v-if="menuCardId === card.id" class="card-menu ui-pad-sm ui-gap-xs" :style="{ left: menuLeft + 'px', top: menuTop + 'px' }" :class="themeClass('card-menu')" role="menu">
                    <button v-if="viewMode === 'stack'" class="card-menu-item ui-row" role="menuitem" @click="edit(card)"><AppIcon name="ant-design:edit-outlined" :size="18" /><text class="ui-type-body">编辑银行卡</text></button>
                    <button v-if="card.cardNoLast4" class="card-menu-item ui-row" role="menuitem" @click="reveal(card)"><AppIcon :name="revealed[card.id] ? 'ant-design:eye-invisible-outlined' : 'ant-design:eye-outlined'" :size="18" /><text class="ui-type-body">{{ revealed[card.id] ? '隐藏卡号' : '查看卡号' }}</text></button>
                    <button v-if="card.cardNoLast4" class="card-menu-item ui-row" role="menuitem" @click="reveal(card, true)"><AppIcon name="ant-design:copy-outlined" :size="18" /><text class="ui-type-body">复制卡号</text></button>
                    <button class="card-menu-item card-menu-danger ui-row" role="menuitem" @click="menuCardId = ''; open()"><AppIcon name="ant-design:delete-outlined" :size="18" color="#dc5454" /><text class="ui-type-body">删除银行卡</text></button>
                  </view>
                </template>
              </ConfirmAction></view>
            </view></view>
            <view v-if="cardExpanded(card) && !coverFile(card) && (card.alias || card.status !== 'normal')" class="card-caption ui-row"
              ><text class="card-name">{{ card.alias || '' }}</text
              ><text v-if="card.status !== 'normal'" class="card-status">{{
                statusMap[card.status]
              }}</text></view
            ><view v-if="cardExpanded(card) && card.tags?.length" class="card-tags ui-row"><text v-for="item in card.tags" :key="item.id" class="card-tag" :class="themeClass('secondary-text')">{{ item.name }}</text></view
            ><text v-if="cardExpanded(card) && card.remark" class="card-meta" :class="themeClass('secondary-text')">{{ card.remark }}</text
            ></view></view></PageState
      ><view class="tags ui-mt-section"
        ><view v-for="item in tags" :key="item.id" class="actions ui-toolbar"
          ><text class="ui-type-body">{{ item.name }}</text
          ><MobileButton
            label="编辑标签"
            icon="ant-design:edit-outlined"
            variant="quiet"
            @click="editTag(item)" /><ConfirmAction
            label="删除标签"
            :action="() => removeTag(item)" /></view></view></view
    ><view v-if="menuCardId" class="menu-backdrop" @click="menuCardId = ''" />
    <AdaptiveModal v-if="modal" label="银行卡" :busy="saving || coverBusy" @close="modal = false"
      ><view
        class="draft-face ui-pad-card ui-gap-sm"
        :class="{ 'card-face-image': !!coverPreview }"
        :style="{ backgroundColor: cardColor(draft) }"
        ><view v-if="!coverPreview" class="face-orbit" aria-hidden="true" />
        <image
          v-if="coverPreview"
          :src="coverPreview"
          mode="aspectFill"
          class="draft-cover"
        /><text v-if="!coverPreview" class="title">{{
          draftBank === '自定义' ? draft.customBankName || '选择银行' : draftBank
        }}</text
        ><view v-if="!coverPreview" class="card-chip" /><text class="ui-type-body" v-if="!coverPreview">{{ draftType }}</text></view
      ><view class="actions ui-toolbar"
        ><MobileButton
          label="上传卡面"
          :loading="coverBusy"
          @click="uploadCover" /><MobileButton
          v-if="draft.coverTemplateId || draft.coverFileIds?.length"
          label="移除卡面"
          variant="quiet"
          @click="clearCover" />
        <MobileButton label="选择公共卡面" variant="quiet" :disabled="!draft.bankId || coverBusy" :loading="templateLoading" @click="openTemplates" /></view
      ><view v-if="templateOpen" class="ui-stack ui-gap-sm">
        <text v-if="templateError" class="ui-type-caption">{{ templateError }}</text>
        <MobileButton v-if="templateError" label="重试" variant="quiet" @click="openTemplates" />
        <text v-if="!templateLoading && !templateError && templates.length === 0" class="ui-type-caption">暂无匹配卡面</text>
        <view class="template-grid">
          <view v-for="item in templates" :key="item.id" class="ui-stack ui-gap-xs">
            <button role="button" class="template-choice" :aria-label="'选用' + item.name" :disabled="!templateUrls[item.id]" @click="selectTemplate(item)">
              <image v-if="templateUrls[item.id]" :src="templateUrls[item.id]" class="template-image" mode="aspectFit" @error="templateImageErrors[item.id] = '图片加载失败'" />
              <text class="ui-type-label">{{ item.name }}</text>
            </button>
            <MobileButton v-if="templateImageErrors[item.id]" label="重试图片" variant="quiet" :loading="templateImageLoading[item.id]" @click="loadTemplateImage(item, templateStamp)" />
          </view>
        </view>
      </view
      ><view v-if="!draft.coverTemplateId && !draft.coverFileIds?.length" class="palette ui-row"
        ><view
          v-for="color in cardColors"
          :key="color"
          class="color-target"
          role="button"
          :aria-label="'卡面颜色 ' + color"
          @click="draft.coverColor = color"
          ><view
            class="color-dot"
            :class="{ 'color-selected': cardColor(draft) === color }"
            :style="{ backgroundColor: color }" /></view></view
      ><FormField :required="isRequired('card', 'bankId', draft)" appearance="soft" label="银行" kind="selector"
        :options="['自定义', ...banks.map((item) => item.name)]" v-model="draftBank" />
      <FormField :required="isRequired('card', 'customBankName', draft)" v-if="!draft.bankId" appearance="soft" label="自定义银行" v-model="draft.customBankName" />
      <view class="ui-field-row">
        <FormField appearance="soft" compact stretch label="卡名称" v-model="draft.cardName" />
        <FormField appearance="soft" compact stretch label="别名" v-model="draft.alias" />
      </view>
      <view class="ui-field-row">
        <FormField appearance="soft" compact stretch label="类型" kind="selector"
          :options="['储蓄卡', '信用卡']" v-model="draftType" />
        <FormField appearance="soft" compact stretch label="状态" kind="selector"
          :options="Object.values(statusMap)" v-model="draftStatus" />
      </view>
      <FormField appearance="soft" :label="draft.cardNoLast4 ? '新卡号（留空保留）' : '卡号（选填）'" v-model="draft.cardNo" password />
      <MobileButton label="更多信息" variant="quiet" @click="moreInfo = !moreInfo">
        <text class="ui-type-body">更多信息</text>
      </MobileButton>
      <view v-if="moreInfo">
        <FormField appearance="soft" label="开户支行" v-model="draft.branchName" />
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="开户日期" kind="date" v-model="draft.openedDate" />
          <FormField appearance="soft" compact stretch label="到期月份" placeholder="YYYY-MM" v-model="draft.expiryMonth" />
        </view>
        <view v-if="draft.cardType === 'credit'">
          <FormField appearance="soft" label="信用额度" input-type="digit" v-model="draft.creditLimit" />
          <view class="ui-field-row">
            <FormField appearance="soft" compact stretch label="账单日" input-type="number" v-model="draft.statementDay" />
            <FormField appearance="soft" compact stretch label="还款日" input-type="number" v-model="draft.repaymentDay" />
          </view>
        </view>
        <view class="ui-field-row">
          <FormField appearance="soft" compact stretch label="卡面颜色" v-model="draft.coverColor" />
          <FormField appearance="soft" compact stretch label="排序" input-type="number" v-model="draft.sortOrder" />
        </view>
        <FormField appearance="soft" label="封面来源URL" v-model="draft.coverSourceUrl" />
        <FormField appearance="soft" label="备注" kind="textarea" v-model="draft.remark" />
      </view>
      <view class="actions ui-toolbar"
        ><view v-for="item in tags" :key="item.id" class="actions ui-toolbar"
          ><MobileButton
            :label="item.name"
            :icon="
              draft.tagIds.includes(item.id)
                ? 'ant-design:check-square-outlined'
                : 'ant-design:border-outlined'
            "
            :disabled="item.status !== '0' && !draft.tagIds.includes(item.id)"
            variant="quiet"
            @click="toggleTag(item.id)"
          /><text class="ui-type-body">{{ item.name }}</text></view
        ></view
      ><text v-if="formError" class="error ui-py-section ui-type-body">{{ formError }}</text
      ><FormActions>
          <MobileButton
          label="取消"
          :disabled="saving"
          variant="quiet"
          @click="modal = false" /><MobileButton
          label="保存"
          :loading="saving"
          @click="save" />
        </FormActions></AdaptiveModal
    ><AdaptiveModal v-if="tagModal" label="标签" :busy="saving" @close="tagModal = false"
      ><FormField :required="isRequired('cardTag', 'name')" label="名称" v-model="tagDraft.name" /><FormField
        label="颜色"
        v-model="tagDraft.color" /><FormField
        label="状态"
        kind="selector"
        :options="['启用', '停用']"
        v-model="draftTagStatus" /><text v-if="formError" class="error ui-py-section ui-type-body">{{
        formError
      }}</text
      ><MobileButton label="保存" :loading="saving" @click="saveTag" /></AdaptiveModal
  ></MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body', 'caption');

.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.actions {
  flex-wrap: wrap;
}
.header-actions {
  flex: 1;
  justify-content: flex-end;
}
.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: $space-controlMin;
  height: $space-controlMin;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background-color: transparent;
}
.card-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
}
.card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 18px;
  color: #263248;
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.card-face-shell {
  position: relative;
  width: 100%;
  min-width: 0;
}
.card-dark {
  color: #e7e9ee;
}
.card-face,
.draft-face {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  // 接近 Web 实体银行卡的比例，窄屏保留三行信息的最小高度。
  aspect-ratio: 1.7;
  min-height: 184px;
  padding: $space-card + $space-inline;
  background-image: linear-gradient(125deg, #ffffff12, #00000015);
  border-radius: 16px;
  color: #f1f4f9;
  position: relative;
  justify-content: space-between;
  overflow: hidden;
}
// 限制编辑预览的几何尺寸，避免平板上卡面挤占基础字段。
.draft-face { aspect-ratio: 1.586; max-width: 360px; margin-left: auto; margin-right: auto; }
// 芯片为固定尺寸装饰图形，内部线条按芯片几何定位。
.card-chip {
  width: 34px;
  height: 27px;
  box-sizing: border-box;
  border-radius: 6px;
  position: relative;
  overflow: hidden;
  border: $space-hairline solid #ffffff45;
  background-image: linear-gradient(135deg, #e4d6af95, #cbb98740);
}
.chip-core {
  position: absolute;
  left: 9px;
  right: 9px;
  top: 0;
  bottom: 0;
  border-left: $space-hairline solid #ffffff45;
  border-right: $space-hairline solid #ffffff45;
}
.chip-line {
  position: absolute;
  left: 0;
  right: 0;
  height: $space-hairline;
  background-color: #ffffff45;
}
.chip-line-top { top: 8px; }
.chip-line-bottom { bottom: 8px; }
.bank-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #ffffff18;
}
// Web 卡面的同心弧纹；尺寸与偏移属于装饰图形几何，不占内容空间。
.face-orbit {
  position: absolute;
  width: 260px;
  height: 260px;
  right: -115px;
  top: -36px;
  border: $space-hairline solid #ffffff0d;
  border-radius: 50%;
  box-shadow: 0 0 0 26px #ffffff04, 0 0 0 62px #ffffff03;
  pointer-events: none;
}
.card-caption,
.face-bottom {
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}
.face-bottom {
  @include type-style('caption');
}
.face-heading {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding-right: calc(#{$space-controlMin} + #{$space-inline});
  min-height: $space-controlMin;
  align-items: center;
}
.face-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.face-middle {
  position: absolute;
  top: 47%;
  left: $space-card + $space-inline;
  right: $space-card + $space-inline;
  min-height: 27px;
  align-items: center;
  justify-content: flex-end;
}
.card-chip { flex-shrink: 0; }
.face-bottom {
  position: absolute;
  left: $space-card + $space-inline;
  right: $space-card + $space-inline;
  bottom: $space-card + $space-inline;
  min-height: $space-controlMin;
  padding-right: calc(#{$space-controlMin} + #{$space-inline});
  flex-wrap: nowrap;
}
.card-menu-anchor {
  position: absolute;
  bottom: $space-card + $space-inline;
  right: $space-card + $space-inline;
  overflow: visible;
}
.card-menu-active { z-index: 1200; }
.card-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: $space-controlMin;
  height: $space-controlMin;
  margin: 0;
  padding: 0;
  color: #f1f4f9;
  background-color: transparent;
  border-radius: 12px;
}
.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1100;
}
.card-menu {
  position: fixed;
  box-sizing: border-box;
  width: 168px;
  border-radius: 12px;
  background-color: #ffffff;
  color: #263248;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
}
.card-menu-dark { background-color: #292c32; color: #eeeeef; }
.card-menu-item {
  min-height: $space-controlMin;
  width: 100%;
  margin: 0;
  padding: 0 $space-inline;
  align-items: center;
  text-align: left;
  color: inherit;
  background-color: transparent;
  @include type-style('body');
}
.card-menu-danger { color: #dc5454; }
/* #ifdef WEB || MP-WEIXIN */
.header-action::after, .card-more::after, .card-menu-item::after { border: 0; }
/* #endif */
.palette {
  flex-wrap: wrap;
}
.color-target {
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.color-dot {
  width: 24px;
  height: 24px;
  border-radius: 50%;
}
.color-selected {
  outline: 2px solid #8b8f99;
  outline-offset: 2px;
}
.draft-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.cover-error { position: absolute; inset: 0; align-items: center; justify-content: center; background-color: #e8ecf1; color: $text-secondary-light; }
.cover-error-dark { background-color: #30343c; color: $text-secondary-dark; }
.cover { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 16px; }
.cover-pending { visibility: hidden; }
.card-face-image { padding: 0; background-image: none; background-color: #dce3ec; }
.card-face-dark { background-color: #2a3341; }
.card-meta { color: $text-secondary-light; @include type-style('caption');  overflow-wrap: anywhere; }
.card-name { @include type-style('label'); }
.card-status { color: #c87942; @include type-style('caption'); }
.card-tags { flex-wrap: wrap; }
.card-tag { @include type-style('badge'); color: $text-secondary-light; border-radius: 5px; padding: $space-detail $space-inline; background-color: #80808012; }
.card-caption { min-width: 0; overflow-wrap: anywhere; }
.face-product {
  letter-spacing: type-tracking('number');
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  opacity: 0.85;
}
.face-type-anchor {
  position: absolute;
  top: $space-card + $space-inline;
  right: $space-card + $space-inline;
  height: $space-controlMin;
  display: flex;
  align-items: center;
  justify-content: center;
}
.face-type { @include type-style('badge'); width: $space-controlMin; text-align: center; flex-shrink: 0; opacity: 0.7; }

.title {
  @include type-style('title');
  font-weight: type-weight('strong');

}
.number {
  flex: 1;
  min-width: 0;
  @include type-style('metric-small');
  font-family: type-family('mono');
  letter-spacing: type-tracking('number');
  text-align: right;
  overflow-wrap: anywhere;
}
.number-revealed {
  @include type-style('body');
  letter-spacing: type-tracking('normal');
}
// 自定义图片保持完整，银行名称、卡号与操作在卡面外排成一行；菜单不受卡面裁剪。
.card-image-footer {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  min-width: 0;
  padding-top: $space-inline;
}
.footer-caption {
  flex: 1;
  min-width: 0;
  align-items: center;
}
.footer-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #263248;
}
.footer-name-dark { color: #e7e9ee; }
.card-status { flex-shrink: 0; }
.number-outside {
  flex: 0 1 auto;
  max-width: 65%;
  @include type-style('label');
  letter-spacing: type-tracking('normal');
  color: $text-secondary-light;
}
.card-menu-control { flex-shrink: 0; }
@media (min-width: 600px) {
  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
// 卡包限制卡面宽度，避免平板/桌面把实体卡比例放大；不额外添加页面边距。
.card-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
  max-width: 420px;
  margin-left: auto;
  margin-right: auto;
}
// 仅占据顶部可点选区域，完整卡面由后续卡片覆盖，形成真实重叠。
// 高度容纳现有银行标题和至少 44px 触控区，统一取自间距配置。
.card-stack-folded {
  height: $space-controlMin + $space-card + $space-inline + $space-detail;
  flex-shrink: 0;
  overflow: visible;
}
.card-stack-expanded {
  margin-bottom: $space-section;
}
/* #ifdef WEB */
.card-face-draggable {
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
  cursor: grab;
}
.card-face-dragging { cursor: grabbing; }
/* #endif */
.error {
  color: #dc5454;
  display: block;
}

.secondary-text-dark { color: $text-secondary-dark; }
.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-inline;
}
.template-choice {
  padding: $space-detail;
  border: 0;
  background: transparent;
  color: inherit;
  min-height: $space-controlMin;
  display: flex;
  flex-direction: column;
  gap: $space-detail;
}
.template-image { width: 100%; aspect-ratio: 1.586; }
</style>
