<script setup lang="ts">
import { computed, ref, watch } from 'vue';
import ConfirmAction from '../../../components/ConfirmAction.uvue';
import MobileButton from '../../../components/MobileButton.uvue';
import { themeClass } from '../../../services/theme.ts';
import spacing from '../../../styles/spacing.json';

const props = defineProps<{
  row: any;
  kind: string;
  category: string;
  payment: string;
  opened: boolean;
  selecting: boolean;
  selected: boolean;
  first: boolean;
  last: boolean;
  remove: () => Promise<unknown>;
}>();
const expense = computed(() => props.kind === 'expense');
const kindLabel = computed(() => expense.value ? '支出' : '收入');
const emit = defineEmits(['edit', 'select', 'open', 'close']);
// 操作区容纳一个至少 44px 的按钮，两侧留公共行内间距。
const actionWidth = spacing.controlMin + spacing.inline * 2;
const offset = ref(0);
const dragging = ref(false);
let startX = 0, startY = 0, startOffset = 0;
let direction = '', tracking = false, suppressClickUntil = 0;
watch(() => props.opened, (opened) => { offset.value = opened ? -actionWidth : 0; });
watch(() => props.selecting, () => { cancel(); emit('close'); });
const summary = computed(() => {
  const remark = String(props.row.remark || '').trim();
  if (remark && remark !== '/') return remark;
  if (!expense.value) return props.category;
  // 导入描述常附带长订单号；只清理展示文案，原始账目字段保持完整。
  const description = String(props.row.expDesc || '').replace(/[（(]\d{16,}[）)]/g, '').trim();
  if (description && !/^订单[：:]?\s*\d+$/.test(description)) return description;
  return props.row.counterparty || props.category;
});
const date = computed(() => String((expense.value ? props.row.expTime : props.row.incDate) || '').slice(0, 10));
const differentAmount = computed(() => expense.value && props.row.transactionAmt != null &&
  Math.round(Number(props.row.transactionAmt) * 100) !== Math.round(Number(props.row.amt) * 100));
function start(event: any) {
  if (props.selecting || event.touches?.length !== 1) return;
  const point = event.touches[0];
  startX = point.clientX;
  startY = point.clientY;
  startOffset = props.opened ? -actionWidth : 0;
  direction = '';
  tracking = true;
}
function move(event: any) {
  if (!tracking) return;
  if (event.touches?.length !== 1) { cancel(); return; }
  const dx = event.touches[0].clientX - startX;
  const dy = event.touches[0].clientY - startY;
  if (!direction && Math.max(Math.abs(dx), Math.abs(dy)) > 10) {
    direction = Math.abs(dx) > Math.abs(dy) * 1.3 ? 'horizontal' : 'vertical';
  }
  if (direction === 'horizontal') {
    dragging.value = true;
    offset.value = Math.max(-actionWidth, Math.min(0, startOffset + dx));
    suppressClickUntil = Date.now() + 400;
    // 仅横向手势阻止默认行为，纵向仍交给页面滚动/下拉刷新。
    event.preventDefault?.();
  } else if (direction === 'vertical') suppressClickUntil = Date.now() + 400;
}
function finish() {
  if (!tracking) return;
  tracking = false;
  dragging.value = false;
  if (direction !== 'horizontal') return;
  suppressClickUntil = Date.now() + 400;
  const opened = offset.value < -actionWidth / 2;
  offset.value = opened ? -actionWidth : 0;
  emit(opened ? 'open' : 'close');
}
function cancel() {
  tracking = false;
  dragging.value = false;
  offset.value = props.opened ? -actionWidth : 0;
  suppressClickUntil = Date.now() + 400;
}
function activate() {
  if (Date.now() < suppressClickUntil) return;
  if (props.opened) { emit('close'); return; }
  emit(props.selecting ? 'select' : 'edit');
}
</script>
<template>
  <view class="ledger-row" :class="[expense ? 'expense-row' : 'income-row', themeClass('ledger-row'), { 'ledger-row-first': first, 'ledger-row-last': last }]">
    <view v-if="!first" class="ledger-divider" :class="themeClass('ledger-divider')" />
    <view class="ledger-clip">
      <view class="ledger-content" :class="[themeClass('ledger-content'), { 'ledger-dragging': dragging }]"
        :style="{ transform: 'translateX(' + offset + 'px)' }"
        @touchstart="start" @touchmove="move" @touchend="finish" @touchcancel="cancel">
        <view v-if="selecting" class="ledger-select">
          <MobileButton :label="selected ? '取消选择' : '选择'" variant="quiet"
            :icon="selected ? 'ant-design:check-square-outlined' : 'ant-design:border-outlined'" @click="emit('select')" />
        </view>
        <view class="ledger-body" role="button" tabindex="0"
          :aria-label="(selecting ? '选择' : '编辑') + kindLabel + '：' + summary + '，¥' + Number(row.amt).toFixed(2)"
          @click="activate" @keydown.enter.prevent="activate" @keydown.space.prevent="activate">
          <view class="ledger-heading">
            <text class="ledger-summary">{{ summary }}</text>
            <text class="ledger-money" :class="{ 'ledger-money-income': !expense }">¥{{ Number(row.amt).toFixed(2) }}</text>
          </view>
          <view class="ledger-meta">
            <text v-if="expense || summary !== category" class="ledger-detail" :class="themeClass('ledger-detail')">{{ category }}{{ expense ? ' · ' + payment : '' }}</text>
            <text class="ledger-date" :class="themeClass('ledger-detail')">{{ date }}</text>
          </view>
          <text v-if="differentAmount" class="ledger-detail" :class="themeClass('ledger-detail')">交易金额 ¥{{ Number(row.transactionAmt).toFixed(2) }}</text>
        </view>
      </view>
    </view>
    <!-- 确认框放在裁剪区和 transform 外，保持相对于屏幕定位。 -->
    <view v-if="opened && !dragging && !selecting" class="ledger-delete">
      <ConfirmAction :label="'删除' + kindLabel" :action="remove">
        <template #default="{ open, busy }">
          <MobileButton :label="'删除' + kindLabel" icon="ant-design:delete-outlined" danger :loading="busy" @click="open" />
        </template>
      </ConfirmAction>
    </view>
  </view>
</template>
<style scoped lang="scss">
@use '../../../styles/typography' as *;
@use '../../../styles/spacing-tokens' as *;
@use '../../../styles/text-colors' as *;
.ledger-row { position: relative; background-color: #fff; }
.ledger-row-first { border-top-left-radius: 14px; border-top-right-radius: 14px; }
.ledger-row-last { border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.ledger-row-dark { background-color: #1c1e22; }
.ledger-divider { height: $space-hairline; margin: 0 $space-inline; background-color: #edf0f4; }
.ledger-divider-dark { background-color: #30343b; }
.ledger-clip { overflow: hidden; border-radius: inherit; }
.ledger-content { display: flex; flex-direction: row; align-items: center; gap: $space-inline; background-color: #fff; transition: transform 180ms ease; touch-action: pan-y; }
.ledger-content-dark { background-color: #1c1e22; }
.ledger-dragging { transition: none; }
.ledger-select { padding-left: $space-card; flex-shrink: 0; }
.ledger-body { flex: 1; min-width: 0; min-height: $space-controlMin; padding: $space-card; display: flex; flex-direction: column; gap: $space-detail; cursor: pointer; }
.ledger-heading { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; gap: $space-inline; }
.ledger-summary { flex: 1; min-width: 0; @include type-style('body'); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ledger-money { flex-shrink: 0; white-space: nowrap; @include type-style('title'); color: #d67842; }
.ledger-money-income { color: #2f9e75; }
.ledger-meta { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: $space-detail $space-inline; }
.ledger-detail { @include type-style('caption'); color: $text-secondary-light; overflow-wrap: anywhere; }
.ledger-date { margin-left: auto; @include type-style('caption'); color: $text-secondary-light; flex-shrink: 0; }
.ledger-detail-dark { color: $text-secondary-dark; }
.ledger-delete { position: absolute; right: 0; top: 0; bottom: 0; width: $space-controlMin + $space-inline * 2; display: flex; align-items: center; justify-content: center; }
</style>
