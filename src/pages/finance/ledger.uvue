<script setup lang="ts">
import { readPageTotal, hasMorePageItems } from '../../services/pagination.ts';
import { useAppLayout } from '../../services/app-layout.ts'
const { appGridItem } = useAppLayout()

import LedgerOverviewSkeleton from './components/LedgerOverviewSkeleton.uvue';
import { computed, onUnmounted, ref, watch } from 'vue';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FloatingActionButton from '../../components/FloatingActionButton.uvue';
import ConfirmAction from '../../components/ConfirmAction.uvue';
import FormField from '../../components/FormField.uvue';
import PageState from '../../components/PageState.uvue';
import LoadMore from '../../components/LoadMore.uvue';
import MetricCard from '../../components/MetricCard.uvue';
import AioChart from '../../components/AioChart.uvue';
import TypeDistribution from './components/TypeDistribution.uvue';
import LedgerRow from './components/LedgerRow.uvue';
import FinanceRecordModal from './components/FinanceRecordModal.uvue';
import { themeClass } from '../../services/theme.ts';
import {
  fetchLedger,
  fetchDictionary,
  saveLedger,
  deleteLedger,
  deleteExpenses,
  ledgerId,
  fetchFinanceStatistics,
} from './services/finance.ts';
const props = defineProps<{ kind: string; initialCreate?: boolean }>();
let entryConsumed = false;
const expense = computed(() => props.kind === 'expense');
const rows = ref<any[]>([]),
  types = ref<any[]>([]),
  payments = ref<any[]>([]);
const loading = ref(false),
  refreshing = ref(false),
  saving = ref(false),
  error = ref(''),
  formError = ref(''),
  modal = ref(false);
const overviewRows = ref<any[]>([]),
  overviewYear = ref(String(new Date().getFullYear()));
let statisticsSequence = 0;
const statistics = ref<any[]>([]),
  statisticsLoaded = ref(false),
  statisticsBusy = ref(false),
  statisticsPeriod = ref('月度'),
  statisticsError = ref('');
async function loadStatistics() {
  if (!alive || mutationBusy.value) return;
  const current = ++statisticsSequence,
    period = statisticsPeriod.value;
  statisticsBusy.value = true;
  statisticsError.value = '';
  try {
    // 保留月度看板数据，年度明细展开时同步刷新。
    const [monthly, annual] = await Promise.all([
      fetchFinanceStatistics(props.kind, 'Month'),
      ...(period === '年度' ? [fetchFinanceStatistics(props.kind, 'Year')] : []),
    ]);
    if (alive && current === statisticsSequence) {
      statistics.value = (annual || monthly).slice().sort(
        (a, b) => b.year - a.year || (b.month || 0) - (a.month || 0),
      );
      overviewRows.value = monthly;
      statisticsLoaded.value = true;
    }
  } catch (e) {
    if (alive && current === statisticsSequence) statisticsError.value = e.message;
  } finally {
    if (alive && current === statisticsSequence) statisticsBusy.value = false;
  }
}
const overviewYears = computed(() =>
  Array.from(
    new Set([
      String(new Date().getFullYear()),
      ...overviewRows.value.map((row) => String(row.year)),
    ]),
  )
    .sort()
    .reverse(),
);
const yearRows = computed(() =>
  overviewRows.value
    .filter((row) => String(row.year) === overviewYear.value)
    .slice()
    .sort((a, b) => a.month - b.month),
);
function statisticsTotal(rows) {
  return rows.reduce(
    (sum, row) =>
      sum + (row.detail || []).reduce((n, item) => n + Number(item.amt || 0), 0),
    0,
  );
}
const yearAmount = computed(() => statisticsTotal(yearRows.value));
const monthlyAverage = computed(
  () => yearAmount.value / Math.max(1, yearRows.value.length),
);
const distribution = computed(() => {
  const map: Record<string, number> = {};
  yearRows.value.forEach((row) =>
    (row.detail || []).forEach((item) => {
      const name = item.typeName || '未分类';
      map[name] = (map[name] || 0) + Number(item.amt || 0);
    }),
  );
  return Object.entries(map).map(([name, value]) => ({ name, value }));
});
function filterStatistics(group: any, item: any) {
  const month = group.month ? String(group.month).padStart(2, '0') : '01';
  const endMonth = group.month || 12;
  const last = new Date(Number(group.year), Number(endMonth), 0).getDate();
  filters.value.year = String(group.year);
  filters.value.startTime = group.year + '-' + month + '-01';
  filters.value.endTime =
    group.year + '-' + String(endMonth).padStart(2, '0') + '-' + last;
  typeFilter.value = name(types.value, String(item.typeId));
  filters.value[expense.value ? 'expTypeId' : 'incTypeId'] = String(item.typeId);
  load();
}
const total = ref<number | null>(null),
  page = ref(1),
  selected = ref<string[]>([]),
  draft = ref<Record<string, any>>({}),
  continuous = ref(false);
const filters = ref<Record<string, any>>({
  year: '',
  startTime: '',
  endTime: '',
  remark: '',
  counterparty: '',
  expDesc: '',
  incTypeId: '',
  expTypeId: '',
  payTypeId: '',
});
const showFilters = ref(false);
const filterYear = computed({
  get: () => filters.value.year || '全部年份',
  set: (value: string) => { filters.value.year = value === '全部年份' ? '' : value; },
});
const selecting = ref(false);
const openedRow = ref('');
function toggleSelection() {
  selecting.value = !selecting.value;
  selected.value = [];
  openedRow.value = '';
}
const activeFilterCount = computed(() =>
  ['year', 'startTime', 'endTime', 'remark', 'counterparty', 'expDesc', 'payTypeId']
    .filter((key) => expense.value || key !== 'year')
    .filter((key) => String(filters.value[key] || '').trim()).length,
);
const typeFilter = ref('全部类型'),
  payFilter = ref('全部支付方式'),
  sort = ref('日期降序');
const mutationBusy = ref(false);
let version = 0,
  refreshSequence = 0,
  needsReset = false,
  alive = true;
onUnmounted(() => {
  alive = false;
  version++;
  statisticsSequence++;
  refreshSequence++;
});
const sorted = computed(() =>
  [...rows.value].sort((a, b) =>
    sort.value === '金额降序'
      ? Number(b.amt) - Number(a.amt)
      : sort.value === '金额升序'
        ? Number(a.amt) - Number(b.amt)
        : String(b.expTime || b.incDate).localeCompare(String(a.expTime || a.incDate)),
  ),
);
const amount = computed(
  () =>
    rows.value.reduce((sum, row) => sum + Math.round(Number(row.amt || 0) * 100), 0) /
    100,
);
function name(options: any[], id: string) {
  return options.find((item) => String(item.id) === String(id))?.dictLabel || '未分类';
}
const moreError = ref(''), pageEnded = ref(false);
function loadMore() {
  if (loading.value || error.value || moreError.value) return;
  load(false);
}
async function load(reset = true) {
  if (!alive || mutationBusy.value) return;
  reset = reset || needsReset;
  if (!reset && (loading.value || !rows.value.length || !hasMorePageItems(rows.value.length, total.value, pageEnded.value))) return;
  const current = ++version;
  loading.value = true;
  error.value = '';
  moreError.value = '';
  try {
    const nextPage = reset ? 1 : page.value + 1;
    const condition = { ...filters.value, page: nextPage, pageSize: 50 };
    if (expense.value) {
      if (condition.startTime) condition.startTime += ' 00:00:00';
      if (condition.endTime) condition.endTime += ' 23:59:59';
    }
    const result = await fetchLedger(props.kind, condition);
    if (!alive || current !== version) return;
    const nextTotal = readPageTotal(result.total);
    const items = reset ? result.items || [] : [...rows.value, ...(result.items || [])];
    const seen = new Set<string>();
    rows.value = items.filter((item) => {
      const id = ledgerId(item);
      if (seen.has(id)) return false;
      seen.add(id);
      return true;
    });
    pageEnded.value = !(result.items || []).length;
    total.value = nextTotal;
    page.value = nextPage;
    if (reset) { needsReset = false; selected.value = []; openedRow.value = ''; }
  } catch (e) {
    if (alive && current === version) {
      if (reset) error.value = e.message;
      else moreError.value = e.message;
    }
  } finally {
    if (alive && current === version) {
      loading.value = false;
    }
  }
}
async function initialize() {
  if (!alive || mutationBusy.value) return;
  loading.value = true;
  statisticsBusy.value = true;
  error.value = '';
  statisticsError.value = '';
  const mutationStamp = version;
  try {
    const results = await Promise.all([
      fetchDictionary(expense.value ? 'exp_type' : 'income_type'),
      ...(expense.value ? [fetchDictionary('pay_type')] : []),
    ]);
    if (!alive || version !== mutationStamp) return;
    types.value = results[0].dictDetailList || [];
    payments.value = results[1]?.dictDetailList || [];
    await Promise.all([load(), loadStatistics()]);
    if (alive && !error.value && props.initialCreate && !entryConsumed) {
      entryConsumed = true;
      edit();
    }
  } catch (e) {
    if (alive && version === mutationStamp) {
      error.value = e.message; statisticsError.value = e.message;
      loading.value = false; statisticsBusy.value = false;
    }
  }
}
function suspend(clear = false) {
  alive = false; version++; statisticsSequence++; refreshSequence++;
  loading.value = false; statisticsBusy.value = false; refreshing.value = false;
  modal.value = false; selected.value = []; openedRow.value = '';
  draft.value = {}; formError.value = '';
  if (clear) {
    rows.value = []; types.value = []; payments.value = [];
    statistics.value = []; overviewRows.value = []; statisticsLoaded.value = false;
    page.value = 1; total.value = null; pageEnded.value = false; needsReset = false;
    error.value = ''; moreError.value = ''; statisticsError.value = '';
  }
}
function resume(refresh = false) {
  alive = true;
  if (refresh) return initialize();
}
defineExpose({ resume, suspend, loading, error });
async function refresh() {
  if (!alive || mutationBusy.value) return;
  const current = ++refreshSequence;
  refreshing.value = true;
  try { await Promise.all([load(), loadStatistics()]); }
  finally { if (alive && current === refreshSequence) refreshing.value = false; }
}

// 写入与分页共用同一快照边界；不能让写入前的响应覆盖写入后的数据。
async function mutate(action: () => Promise<any>, accepted: () => void) {
  if (!alive) return;
  if (mutationBusy.value) throw new Error('正在更新账单，请稍后重试');
  mutationBusy.value = true;
  version++;
  statisticsSequence++;
  refreshSequence++;
  loading.value = false;
  statisticsBusy.value = false;
  refreshing.value = false;
  try {
    const result = await action();
    if (result === false) throw new Error('记录未更新，请重试');
    if (!alive) return;
    needsReset = true;
    accepted();
  } finally { mutationBusy.value = false; }
  if (alive) await Promise.all([load(), loadStatistics()]);
}
watch(typeFilter, (value) => {
  const id = types.value.find((item) => item.dictLabel === value)?.id || '';
  filters.value[expense.value ? 'expTypeId' : 'incTypeId'] = id;
});
watch(payFilter, (value) => {
  filters.value.payTypeId =
    payments.value.find((item) => item.dictLabel === value)?.id || '';
});
function edit(row: any = null) {
  if (!alive) return;
  const now = new Date(),
    date =
      now.getFullYear() +
      '-' +
      String(now.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(now.getDate()).padStart(2, '0');
  draft.value = row
    ? { ...row, id: ledgerId(row) }
    : {
        amt: '',
        transactionAmt: '',
        incDate: date,
        expTime: date + ' 00:00:00',
        remark: '',
        incTypeId: '',
        expTypeId: '',
        payTypeId: '',
      };
  openedRow.value = '';
  formError.value = '';
  continuous.value = false;
  modal.value = true;
}
async function save() {
  if (saving.value || mutationBusy.value) return;
  saving.value = true;
  formError.value = '';
  try {
    await mutate(() => saveLedger(props.kind, draft.value), () => {
      if (continuous.value && !ledgerId(draft.value)) {
        draft.value = { ...draft.value, amt: '', transactionAmt: '' };
      } else modal.value = false;
    });
  } catch (e) {
    formError.value = e.message;
  } finally {
    saving.value = false;
  }
}
async function remove(row: any) {
  await mutate(() => deleteLedger(props.kind, ledgerId(row)), () => {
    selected.value = selected.value.filter((id) => id !== ledgerId(row));
    openedRow.value = '';
  });
}
async function removeDraft() {
  await remove(draft.value);
  modal.value = false;
}
function toggle(row: any) {
  const id = ledgerId(row);
  selected.value = selected.value.includes(id)
    ? selected.value.filter((item) => item !== id)
    : [...selected.value, id];
}
async function removeSelected() {
  const ids = [...selected.value];
  await mutate(() => deleteExpenses(ids), () => { selected.value = []; });
}
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="refresh" @reachbottom="loadMore">
    <PageHeader :title="expense ? '支出' : '收入'" back @back="uni.navigateBack()" />
    <view class="body ui-page-body" :class="themeClass('body')"
      >
      <view class="tools ledger-toolbar ui-toolbar"
        ><text class="section-title">{{ expense ? '支出明细' : '收入明细' }}</text><view class="filter-trigger"><MobileButton :label="activeFilterCount ? '更多筛选，已启用 ' + activeFilterCount + ' 项条件' : '更多筛选'" icon="ant-design:filter-outlined" variant="quiet" @click="showFilters = !showFilters" /><text v-if="activeFilterCount" class="filter-count">{{ activeFilterCount }}</text></view><MobileButton
          v-if="expense"
          label="导入账单"
          icon="ant-design:import-outlined"
          variant="quiet"
          @click="uni.navigateTo({ url: '/pages/finance/import' })"
      /></view>
      <view class="statistics-panel"
        ><PageState skeleton="overview"
        :loading="statisticsBusy" :has-content="statisticsLoaded"
        :error="statisticsError"
        @retry="types.length ? loadStatistics() : initialize()"
        >
<template #loading><LedgerOverviewSkeleton :kind="kind" v-model:year="overviewYear" :years="overviewYears" /></template>
<view class="finance-summary ui-gap-sm ui-section"
          ><FormField
            compact
            stretch
            hide-label
            label="选择年份"
            kind="selector"
            :options="overviewYears"
            v-model="overviewYear" /><view class="metrics ui-row"
            ><view :style="appGridItem(2, 'section', [[700, 3]], true)" class="summary-total"><MetricCard
              :label="expense ? '总支出' : '总收入'"
              :value="statisticsTotal(overviewRows).toFixed(2)"
              unit="元" /></view><MetricCard :style="appGridItem(2, 'section', [[700, 3]], false)"
              :label="overviewYear + (expense ? '年总支出' : '年总收入')"
              :value="yearAmount.toFixed(2)"
              unit="元" /><MetricCard :style="appGridItem(2, 'section', [[700, 3]], false)"
              :label="expense ? '月均支出' : '月均收入'"
              :value="monthlyAverage.toFixed(2)"
              unit="元" /></view></view
        ><view class="chart-grid ui-gap-md"><AioChart :style="appGridItem(1, 'section', [[700, 2]], false)"
          :label="expense ? '支出走势' : '收入走势'"
          kind="bar"
          period-controls
          :labels="yearRows.map((row) => String(row.month) + '月')"
          :series="[
            {
              name: expense ? '支出' : '收入',
              values: yearRows.map((row) => statisticsTotal([row])),
            },
          ]"
          unit="元" /><TypeDistribution :style="appGridItem(1, 'section', [[700, 2]], false)"
          :label="expense ? '支出类型分布' : '收入类型分布'"
          :items="distribution"
      /></view></PageState>
        <FormField
          label="统计周期"
          kind="selector"
          :options="['月度', '年度']"
          v-model="statisticsPeriod"
          @update:modelValue="loadStatistics" /><PageState skeleton="chart"
          :loading="statisticsBusy"
          :error="statisticsError"
          @retry="types.length ? loadStatistics() : initialize()"
          ><view
            v-for="group in statistics"
            :key="group.year + '-' + group.month"
            class="statistics-card ui-card"
            :class="themeClass('statistics-card')"
            ><view class="statistics-heading"
              ><text class="statistics-period"
              >{{ group.year
              }}{{ group.month ? '-' + String(group.month).padStart(2, '0') : '' }}</text
              ><text class="statistics-total">¥{{ statisticsTotal([group]).toFixed(2) }}</text></view
            ><view
              v-for="item in group.detail"
              :key="item.typeId"
              class="statistics-row"
              ><text class="statistics-category"
                >{{ item.typeName || '未分类' }}</text
              ><text class="statistics-amount">¥{{
                  Number(item.amt).toFixed(2)
                }}</text
              ><view class="statistics-action"><MobileButton
                label="查看对应记录"
                icon="ant-design:export-outlined"
                variant="ghost"
                @click="filterStatistics(group, item)" /></view></view></view></PageState></view
      ><view class="filters ui-field-row">
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)" v-if="!expense || showFilters" compact stretch hide-label label="年份" kind="selector"
          :options="['全部年份', ...overviewYears]" v-model="filterYear" :disabled="mutationBusy" @update:modelValue="!expense && load()" />
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          hide-label
          label="类型"
          kind="selector"
          :options="['全部类型', ...types.map((item) => item.dictLabel)]"
          v-model="typeFilter"
        />
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="expense && showFilters"
          hide-label
          label="支付方式"
          kind="selector"
          :options="['全部支付方式', ...payments.map((item) => item.dictLabel)]"
          v-model="payFilter"
        />
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="showFilters"
          hide-label
          label="起始日期"
          placeholder="起始日期"
          kind="date"
          v-model="filters.startTime"
        /><FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="showFilters"
          hide-label
          label="结束日期"
          placeholder="结束日期"
          kind="date"
          v-model="filters.endTime"
        />
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="expense && showFilters"
          hide-label
          label="备注"
          placeholder="备注"
          v-model="filters.remark"
        /><FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="expense && showFilters"
          hide-label
          label="交易对方"
          placeholder="交易对方"
          v-model="filters.counterparty"
        /><FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          v-if="expense && showFilters"
          hide-label
          label="交易描述"
          placeholder="交易描述"
          v-model="filters.expDesc"
        />
        <FormField :style="appGridItem(2, 'section', [[700, 3]], false)"
          compact
          stretch
          hide-label
          label="排序"
          kind="selector"
          :options="['日期降序', '金额降序', '金额升序']"
          v-model="sort"
        />
      </view>
      <view class="filter-footer ui-row" :class="{ 'filter-footer-loading': loading && !rows.length }"><text v-if="!loading || rows.length" class="summary">{{ total == null ? '已加载 ' + rows.length : total }} 笔 · 已加载合计 ¥{{ amount.toFixed(2) }}</text><view class="ui-row"><MobileButton v-if="expense" :label="selecting ? '退出批量选择' : '批量选择'" :icon="selecting ? 'ant-design:close-outlined' : 'ant-design:check-square-outlined'" variant="quiet" @click="toggleSelection" /><MobileButton label="筛选" icon="ant-design:search-outlined" :loading="loading" @click="load()" /></view></view>
      <ConfirmAction
        v-if="expense && selected.length"
        :label="'删除选中 ' + selected.length + ' 笔'"
        :action="removeSelected"
      />
      <PageState skeleton="list"
        :loading="loading && rows.length === 0"
        :error="error"
        :empty="rows.length === 0"
        @retry="initialize"
      >
        <LedgerRow v-for="(row, index) in sorted" :key="ledgerId(row)"
          :kind="kind" :row="row" :category="name(types, row[expense ? 'expTypeId' : 'incTypeId'])"
          :payment="expense ? name(payments, row.payTypeId) : ''"
          :first="index === 0" :last="index === sorted.length - 1"
          :opened="openedRow === ledgerId(row)" :selecting="expense && selecting" :selected="selected.includes(ledgerId(row))"
          :remove="() => remove(row)" @edit="edit(row)" @select="toggle(row)"
          @open="openedRow = ledgerId(row)" @close="openedRow === ledgerId(row) && (openedRow = '')" />
        <LoadMore :error="moreError" :hasMore="hasMorePageItems(rows.length, total, pageEnded)" :loading="loading" @load="load(false)" />
      </PageState>
    </view>
    <template #fixed>
    <FloatingActionButton v-if="!modal" label="新增" :disabled="loading || !!error || mutationBusy" @click="edit()" />
    <FinanceRecordModal v-if="modal" :kind="kind" :draft="draft" :types="types" :payments="payments"
      :saving="saving" :form-error="formError" v-model:continuous="continuous" :remove="removeDraft"
      @close="modal = false" @save="save" />
    </template>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/platform' as *;
@use '../../styles/typography' as *;
@use '../../styles/text-colors' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.body {
  padding-bottom: 80px; /* 右下角公共悬浮新增按钮避让，保证末条记录可完整滚出。 */
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.finance-summary {
  display: flex;
  flex-direction: column;
}
.summary-total {
/* #ifndef APP */
grid-column: 1 / -1;
/* #endif */
 }
.metrics {

@include grid-layout;

@include grid-columns(2);

}
.filters {

@include grid-layout;

@include grid-columns(2);

}
.tools {
  flex-wrap: wrap;
}
.summary {

@include block-content;

  color: #718096;
}
.statistics-card {
  background-color: #ffffff;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.statistics-card-dark { background-color: #1c1e22; }
.statistics-heading {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: $space-inline;
  margin-bottom: $space-detail;
}
.statistics-period { @include type-style('label'); }
.statistics-total { @include type-style('title'); white-space: nowrap; font-variant-numeric: tabular-nums; }
.statistics-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: $space-inline;
  min-height: $space-controlMin;
}
.statistics-category {
