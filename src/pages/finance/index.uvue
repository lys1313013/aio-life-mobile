<script setup lang="ts">
import { computed, ref } from 'vue'
import MobilePage from '../../components/MobilePage.uvue'
import PageHeader from '../../components/PageHeader.uvue'
import MobileButton from '../../components/MobileButton.uvue'
import FinanceCalendarCard from '../home/FinanceCalendarCard.uvue'
import { useDomainPage } from '../../services/domains/page-session.ts'
import { useWindowResize } from '../../services/window-resize.ts'
const viewportWidth = ref(uni.getWindowInfo().windowWidth)
useWindowResize(() => { viewportWidth.value = uni.getWindowInfo().windowWidth })
const available = ref(true)
const active = ref(false), mounted = ref(false), refreshing = ref(false), calendar = ref(null)
const height = computed(() => viewportWidth.value >= 768 ? 480 : 420)
async function refresh() {
  refreshing.value = true
  try { await calendar.value?.refresh() } finally { refreshing.value = false }
}
useDomainPage(
  changed => { mounted.value = true; active.value = true; if (changed) return calendar.value?.refresh(false) },
  clear => { active.value = false; refreshing.value = false; if (clear) mounted.value = false },
  { loading: () => !!calendar.value?.loading, error: () => calendar.value?.error || '', keys: () => ['income', 'expense', 'userDictData', 'userDictType'] },
)
function navigate(kind: string, create = false) { uni.navigateTo({ url: '/pages/finance/' + kind + (create ? '?create=1' : '') }) }
function create() { uni.showActionSheet({ itemList: ['记支出', '记收入'], success: event => { if (active.value) navigate(event.tapIndex === 0 ? 'expense' : 'income', true) } }) }
</script>
<template>
  <MobilePage :refreshing="refreshing" @refresh="refresh">
    <PageHeader title="收支概览" back @back="uni.navigateBack()" />
    <view class="ui-page-body">
      <view class="finance-actions"><MobileButton label="收入" variant="quiet" @click="navigate('income')" /><MobileButton label="支出" variant="quiet" @click="navigate('expense')" /><MobileButton label="记一笔" icon="ant-design:plus-outlined" @click="create" /></view>
      <FinanceCalendarCard v-if="mounted" ref="calendar" kind="finance" :active="active" :height="height" page @visibility="available = $event" />
      <text v-if="!available" class="finance-unavailable">暂无收支概览访问权限</text>
    </view>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/spacing.scss';
@use '../../styles/typography' as *;
@use '../../styles/spacing-tokens' as *;
.finance-unavailable { @include type-style('body'); color: #71717a; text-align: center; padding: $space-section; }
.finance-actions { flex-direction: row; justify-content: flex-end; gap: $space-inline; margin-bottom: $space-section; }
</style>
