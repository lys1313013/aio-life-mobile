<script setup lang="ts">
import ContentSkeleton from "../../components/ContentSkeleton.uvue";
import { computed, onUnmounted, ref } from "vue";
import MobilePage from "../../components/MobilePage.uvue";
import PageHeader from "../../components/PageHeader.uvue";
import PageState from "../../components/PageState.uvue";
import FormField from "../../components/FormField.uvue";
import MiniChart from "../../components/MiniChart.uvue";
import MetricCard from "../../components/MetricCard.uvue";
import MobileButton from "../../components/MobileButton.uvue";
import FinanceLedger from "./components/FinanceLedger.uvue";
import TypeDistribution from "./components/TypeDistribution.uvue";
import { fetchFinanceStatistics } from "./services/finance.ts";
import { useDomainPage } from "../../services/domains/page-session.ts";
import { themeClass } from "../../services/theme.ts";
const income = ref<any[]>([]),
  expense = ref<any[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  error = ref(""),
  year = ref("全部");
let generation = 0,
  alive = true;
onUnmounted(() => {
  alive = false;
  generation++;
});
async function load() {
  const stamp = ++generation;
  loading.value = true;
  error.value = "";
  try {
    const data = await Promise.all([
      fetchFinanceStatistics("income"),
      fetchFinanceStatistics("expense"),
    ]);
    if (alive && generation === stamp) {
      income.value = data[0];
      expense.value = data[1];
    }
  } catch (e) {
    if (alive && generation === stamp) error.value = e.message;
  } finally {
    if (alive && generation === stamp) {
      loading.value = false;
      refreshing.value = false;
    }
  }
}
useDomainPage(
  () => {
    alive = true;
    load();
  },
  () => {
    alive = false;
    generation++;
    income.value = [];
    expense.value = [];
    loading.value = false;
    refreshing.value = false;
  },
);
const years = computed(() => [
  "全部",
  ...Array.from(
    new Set([...income.value, ...expense.value].map((row) => String(row.year))),
  )
    .sort()
    .reverse(),
]);
function sum(rows: any[]) {
  return (
    rows.reduce(
      (total, row) =>
        total +
        (row.detail || []).reduce(
          (n, item) => n + Math.round(Number(item.amt || 0) * 100),
          0,
        ),
      0,
    ) / 100
  );
}
const filteredIncome = computed(() =>
  income.value.filter(
    (row) => year.value === "全部" || String(row.year) === year.value,
  ),
);
const filteredExpense = computed(() =>
  expense.value.filter(
    (row) => year.value === "全部" || String(row.year) === year.value,
  ),
);
const totalIncome = computed(() => sum(filteredIncome.value)),
  totalExpense = computed(() => sum(filteredExpense.value));
function timeline(a: any[], b: any[], annual = false) {
  const keys = Array.from(
    new Set(
      [...a, ...b].map((row) =>
        annual
          ? String(row.year)
          : row.year + "-" + String(row.month).padStart(2, "0"),
      ),
    ),
  ).sort();
  let deposit = 0,
    cumulativeIncome = 0,
    cumulativeExpense = 0;
  return keys.map((key) => {
    const match = (row: any) =>
      (annual
        ? String(row.year)
        : row.year + "-" + String(row.month).padStart(2, "0")) === key;
    const inc = sum(a.filter(match)),
      exp = sum(b.filter(match));
    deposit = Math.round((deposit + inc - exp) * 100) / 100;
    cumulativeIncome = Math.round((cumulativeIncome + inc) * 100) / 100;
    cumulativeExpense = Math.round((cumulativeExpense + exp) * 100) / 100;
    return {
      key,
      income: inc,
      expense: exp,
      balance: Math.round((inc - exp) * 100) / 100,
      deposit,
      cumulativeIncome,
      cumulativeExpense,
    };
  });
}
const months = computed(() =>
    timeline(filteredIncome.value, filteredExpense.value),
  ),
  annual = computed(() => timeline(income.value, expense.value, true));
function categories(rows: any[]) {
  const map: Record<string, number> = {};
  rows.forEach((row) =>
    (row.detail || []).forEach((item) => {
      const key = item.typeName || "未分类";
      map[key] = (map[key] || 0) + Math.round(Number(item.amt || 0) * 100);
    }),
  );
  return Object.entries(map)
    .map(([name, amount]) => ({ name, amount: amount / 100 }))
    .sort((a, b) => b.amount - a.amount);
}
const incCategories = computed(() => categories(filteredIncome.value)),
  expCategories = computed(() => categories(filteredExpense.value));
const comparisonMode = ref("收支");
const comparisonRows = computed(() =>
  year.value === "全部" ? annual.value : months.value,
);
const comparisonTitle = computed(
  () =>
    (year.value === "全部" ? "年度" : "月度") +
    (comparisonMode.value === "收支" ? "收支对比" : "结余率"),
);
const colors = { income: "#269b72", expense: "#df6573", balance: "#5589e8" };
function money(value: number) {
  return value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}
const metrics = computed(() => [
  {
    label: "总收入",
    value: money(totalIncome.value),
    unit: "元",
    color: colors.income,
  },
  {
    label: "总支出",
    value: money(totalExpense.value),
    unit: "元",
    color: colors.expense,
  },
  {
    label: "总结余",
    value: money(totalIncome.value - totalExpense.value),
    unit: "元",
    color: colors.balance,
  },
  {
    label: "结余率",
    value: (totalIncome.value
      ? ((totalIncome.value - totalExpense.value) / totalIncome.value) * 100
      : 0
    ).toFixed(1),
    unit: "%",
    color: colors.balance,
  },
]);
const categoryGroups = computed(() => [
  {
    key: "income",
    title: "收入构成",
    rows: incCategories.value,
  },
  {
    key: "expense",
    title: "支出构成",
    rows: expCategories.value,
  },
]);
</script>
<template>
  <MobilePage
    :refreshing="refreshing"
    @refresh="
      refreshing = true;
      load();
    "
  >
    <PageHeader title="财务概览" back @back="uni.navigateBack()" />
    <view class="body ui-page-body" :class="themeClass('body')">
      <view class="overview-filter ui-toolbar">
        <text class="muted" :class="themeClass('muted')">统计年份</text>
        <view class="year-field">
          <FormField
            compact
            stretch
            hide-label
            label="年份"
            kind="selector"
            :options="years"
            v-model="year"
          />
        </view>
      </view>
      <PageState
        skeleton="overview"
        :loading="loading"
        :error="error"
        :empty="!loading && !income.length && !expense.length"
        @retry="load"
      >
        <template #loading>
          <view class="metrics ui-section">
            <MetricCard
              v-for="label in ['总收入', '总支出', '总结余', '结余率']"
              :key="label"
              :label="label"
              value=""
              loading
            />
          </view>
          <ContentSkeleton v-for="n in 2" :key="n" variant="chart" />
        </template>
        <template v-if="income.length || expense.length">
          <view class="metrics ui-section">
            <view
              v-for="metric in metrics"
              :key="metric.label"
              class="summary-card"
              :class="themeClass('summary-card')"
            >
              <text class="muted" :class="themeClass('muted')">{{
                metric.label
              }}</text>
              <view class="summary-value" :style="{ color: metric.color }">
                <text class="summary-number">{{ metric.value }}</text
                ><text class="summary-unit">{{ metric.unit }}</text>
              </view>
            </view>
          </view>
          <view class="chart-grid">
            <MiniChart
              compact
              label="月度收支趋势"
              hide-period-selector
              :labels="months.map((row) => row.key)"
              :series="[
                {
                  name: '收入',
                  color: colors.income,
                  values: months.map((row) => row.income),
                },
                {
                  name: '支出',
                  color: colors.expense,
                  values: months.map((row) => row.expense),
                },
                {
                  name: '结余',
                  color: colors.balance,
                  values: months.map((row) => row.balance),
                },
              ]"
              unit="元"
            />
            <MiniChart
              compact
              label="累计结余趋势"
              hide-period-selector
              hide-scale
              hide-values
              show-end-values
              :labels="months.map((row) => row.key)"
              :series="[
                {
                  name: '累计收入',
                  color: colors.income,
                  values: months.map((row) => row.cumulativeIncome),
                },
                {
                  name: '累计支出',
                  color: colors.expense,
                  values: months.map((row) => row.cumulativeExpense),
                },
                {
                  name: '累计结余',
                  color: colors.balance,
                  values: months.map((row) => row.deposit),
                },
              ]"
              unit="元"
            />
          </view>
          <view class="chart-grid">
            <TypeDistribution
              v-for="group in categoryGroups"
              :key="group.key"
              class="category-panel"
              :label="group.title"
              :items="group.rows.map((row) => ({ name: row.name, value: row.amount }))"
              icon-toggle
            />
          </view>
          <FinanceLedger
            :key="year"
            title="月度明细"
            :rows="months"
            show-cumulative
          />
          <MiniChart
            :key="comparisonMode + year"
            compact
            :label="comparisonTitle"
            kind="bar"
            selectable
            :labels="comparisonRows.map((row) => row.key)"
            :series="
              comparisonMode === '收支'
                ? [
                    {
                      name: '收入',
                      color: colors.income,
                      values: comparisonRows.map((row) => row.income),
                    },
                    {
                      name: '支出',
                      color: colors.expense,
                      values: comparisonRows.map((row) => row.expense),
                    },
                    {
                      name: '结余',
                      color: colors.balance,
                      values: comparisonRows.map((row) => row.balance),
                    },
                  ]
                : [
                    {
                      name: '结余率',
                      color: colors.balance,
                      values: comparisonRows.map((row) =>
                        row.income
                          ? Math.round((row.balance / row.income) * 1000) / 10
                          : 0,
                      ),
                    },
                  ]
            "
            :unit="comparisonMode === '收支' ? '元' : '%'"
          >
            <template #actions>
              <view class="comparison-tabs">
                <MobileButton
                  v-for="mode in ['收支', '结余率']"
                  :key="mode"
                  compact
                  :label="mode"
                  :variant="comparisonMode === mode ? 'primary' : 'quiet'"
                  @click="comparisonMode = mode"
                />
              </view>
            </template>
          </MiniChart>
          <FinanceLedger
            :title="year === '全部' ? '年度明细' : '历年明细'"
            :rows="annual"
          />
        </template>
      </PageState>
    </view>
  </MobilePage>
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use "../../styles/text-colors" as *;
@use "../../styles/spacing.scss";
@use "../../styles/spacing-tokens" as *;
@include type-utilities('label');

.body {
  color: #263248;
}
.body-dark {
  color: #e7e9ee;
}
.overview-filter {
  align-items: center;
  justify-content: space-between;
  margin-bottom: $space-section;
}
.year-field {
  width: 132px;
}
.muted {
  @include type-style('caption');
  color: $text-secondary-light;
}
.muted-dark {
  color: $text-secondary-dark;
}
.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: $space-inline;
}
.summary-card {
  min-width: 0;
  padding: $space-card;
  border-radius: 14px;
  background-color: #ffffff;
}
.summary-card-dark {
  background-color: #1c1e22;
}
.summary-value {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
  gap: $space-detail;
  margin-top: $space-inline;
}
.summary-number {
  @include type-style('metric-compact');

  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
.summary-unit {
  @include type-style('badge');
}
.chart-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  column-gap: $space-section;
}
.category-panel {
  align-self: start;
  margin-bottom: $space-section;
}
.comparison-tabs {
  display: flex;
  flex-direction: row;
  gap: $space-detail;
}
@media (max-width: 360px) {
  .summary-number {
    @include type-style('metric-compact');
  }
}
@media (min-width: 700px) {
  .metrics {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .summary-number {
    @include type-style('metric-compact');
  }
  .chart-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

</style>
