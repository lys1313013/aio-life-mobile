<script setup lang="ts">
import MobileSwitch from '../../components/MobileSwitch.uvue';
import { ref } from 'vue';
import { onLoad, onUnload } from '@dcloudio/uni-app';
import PageHeader from '../../components/PageHeader.uvue';
import MobilePage from '../../components/MobilePage.uvue';
import MobileButton from '../../components/MobileButton.uvue';
import FormField from '../../components/FormField.uvue';
import { request } from '../../services/api.ts';
import { authPayload } from './services/contract.ts';
import { themeClass } from '../../services/theme.ts';
import { fetchLegalPolicies, openLegalPolicy, registrationConsent } from '../../services/legal.ts';
const agreed = ref(false), policyVersion = ref(''), policyError = ref(''), policyLoading = ref(false);
async function loadPolicy() {
  if (policyLoading.value) return;
  policyLoading.value = true; policyError.value = '';
  try {
    const value = await fetchLegalPolicies();
    if (!active) return;
    if (policyVersion.value !== value.version) agreed.value = false;
    policyVersion.value = value.version;
  } catch (reason) { if (active) policyError.value = reason.message; }
  finally { if (active) policyLoading.value = false; }
}
const mode = ref('register'),
  form = ref({ username: '', email: '', password: '', confirmPassword: '', code: '' }),
  saving = ref(false),
  sending = ref(false),
  wait = ref(0),
  error = ref(''),
  success = ref(false);
let active = true,
  timer = null;
onLoad((options) => {
  mode.value = options?.mode === 'reset' ? 'reset' : 'register';
  if (mode.value === 'register') loadPolicy();
});
onUnload(() => {
  active = false;
  if (timer) clearInterval(timer);
});
async function send() {
  if (sending.value || wait.value || saving.value) return;
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.value.email.trim())) {
    error.value = '请输入有效邮箱';
    return;
  }
  if (mode.value === 'register') {
    try { registrationConsent(agreed.value, policyVersion.value); }
    catch (reason) { error.value = reason.message; return; }
  }
  sending.value = true;
  error.value = '';
  try {
    await request(
      mode.value === 'register' ? '/auth/sendEmailCode' : '/auth/sendResetPasswordCode',
      'POST',
      { email: form.value.email.trim() },
      false,
    );
    if (active) {
      wait.value = 60;
      timer = setInterval(() => {
        wait.value--;
        if (!wait.value) {
          clearInterval(timer);
          timer = null;
        }
      }, 1000);
    }
  } catch (reason) {
    if (active) error.value = reason.message || '验证码发送失败';
  } finally {
    sending.value = false;
  }
}
async function submit() {
  if (saving.value || sending.value) return;
  saving.value = true;
  error.value = '';
  try {
    if (mode.value === 'register' && !agreed.value) throw Error('请阅读并同意隐私政策和服务条款');
    const data = { ...authPayload(mode.value, form.value), ...(mode.value === 'register' ? registrationConsent(agreed.value, policyVersion.value) : {}) };
    await request(
      mode.value === 'register' ? '/auth/register' : '/auth/resetPassword',
      'POST',
      data,
      false,
    );
    if (active) {
      success.value = true;
      form.value.password = '';
      form.value.confirmPassword = '';
      form.value.code = '';
    }
  } catch (reason) {
    if (active) error.value = reason.message || '操作失败，请重试';
  } finally {
    saving.value = false;
  }
}
</script>
<template>
  <view class="auth-page"
    ><PageHeader
      :title="mode === 'register' ? '注册' : '找回密码'"
      back
      @back="uni.navigateBack()"
    /><MobilePage :requires-auth="false"
      ><view class="auth-card ui-card" :class="themeClass('auth-card')"
        ><template v-if="!success"
          ><FormField
            v-if="mode === 'register'"
            label="用户名"
            v-model="form.username"
            :disabled="saving" /><FormField
            label="邮箱"
            v-model="form.email"
            :disabled="saving || sending" /><FormField
            label="验证码"
            v-model="form.code"
            input-type="number"
            :disabled="saving" /><MobileButton
            :label="wait ? wait + ' 秒后重发' : '发送验证码'"
            variant="quiet"
            :loading="sending"
            :disabled="wait > 0 || saving"
            @click="send" /><FormField
            label="密码"
            kind="password"
            v-model="form.password"
            :disabled="saving" /><FormField
            label="确认密码"
            kind="password"
            v-model="form.confirmPassword"
            :disabled="saving" /><view v-if="mode === 'register'" class="auth-policy ui-field-row"
            ><MobileSwitch
              :checked="agreed"
              aria-label="同意隐私政策和服务条款"
              :disabled="saving"
              @change="(event) => (agreed = event.detail.value)" /><MobileButton
              label="隐私政策"
              variant="quiet"
              @click="openLegalPolicy('privacy')" /><MobileButton
              label="服务条款"
              variant="quiet"
              @click="openLegalPolicy('terms')" /></view
          ><text v-if="policyError && mode === 'register'" class="auth-error" role="alert">{{ policyError }}</text><MobileButton v-if="policyError && mode === 'register'" label="重新加载协议" variant="quiet" :loading="policyLoading" @click="loadPolicy" /><text v-if="error" class="auth-error ui-mb-section" role="alert">{{ error }}</text
          ><MobileButton
            :label="mode === 'register' ? '注册' : '重置密码'"
            :loading="saving"
            :disabled="sending"
            @click="submit" /></template
        ><template v-else
          ><text class="ui-type-body">{{ mode === 'register' ? '注册成功' : '密码已重置' }}</text
          ><MobileButton
            label="返回登录"
            @click="uni.reLaunch({ url: '/pages/login/index' })" /></template></view></MobilePage
    ></view
  >
</template>
<style scoped lang="scss">
@use '../../styles/typography' as *;
@use '../../styles/spacing.scss';
@use '../../styles/spacing-tokens' as *;
@include type-utilities('body');

.auth-page {
  flex: 1;
  height: 100%;
  min-height: 0;
}
.auth-card {

  border-radius: 16px;
  background-color: #ffffff;
  color: #27272a;

}
.auth-card-dark {
  background-color: #1c1e22;
  color: #eeeeef;
}
.auth-error {
  color: #e05260;
  @include type-style('body');

}
.auth-policy {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;

}
.auth-policy-title {
  @include type-style('body-strong');
}
.auth-policy-body {
  @include type-style('prose');
}

</style>
