{
  "name": "aio-life-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "AIO Life 的 uni-app x Vapor 客户端",
  "scripts": {
    "prepare:app": "node scripts/prepare-app.mjs",
    "predev": "npm run theme:generate && npm run spacing:generate && npm run typography:generate && node scripts/patch-uni-h5-picker.cjs",
    "dev": "uni -p h5 --host 127.0.0.1 --port 5180",
    "dev:weixin": "node scripts/run-weixin.mjs dev",
    "weixin:start": "node scripts/weixin-dev.mjs start",
    "weixin:open": "node scripts/weixin-dev.mjs open",
    "weixin:status": "node scripts/weixin-dev.mjs status",
    "weixin:stop": "node scripts/weixin-dev.mjs stop",
    "prebuild": "npm run theme:generate && npm run spacing:generate && npm run typography:generate && node scripts/patch-uni-h5-picker.cjs",
    "build": "uni build -p h5",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort --outDir dist/build/h5",
    "build:weixin": "node scripts/run-weixin.mjs build",
    "pretest": "npm run theme:check && npm run spacing:check && npm run typography:check && npm run tabbar:check && node scripts/patch-uni-h5-picker.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "e2e:check": "node scripts/check-e2e-maintenance.cjs",
    "test:commit": "node scripts/validate-commit.cjs",
    "spacing:generate": "node scripts/generate-spacing.cjs",
    "spacing:check": "node scripts/generate-spacing.cjs --check",
    "icons:sync": "node scripts/sync-business-icons.mjs",
    "icons:check": "node scripts/sync-business-icons.mjs --check",
    "predev:weixin": "npm run theme:generate && npm run spacing:generate && npm run typography:generate && npm run tabbar:generate",
    "prebuild:weixin": "npm run theme:generate && npm run spacing:generate && npm run typography:generate && npm run tabbar:generate",
    "typography:generate": "node scripts/generate-typography.cjs",
    "typography:check": "node scripts/check-typography.cjs",
    "postbuild:weixin": "node scripts/check-weixin-size.cjs",
    "check:weixin-size": "npm run build:weixin",
    "check:weixin-size:only": "node scripts/check-weixin-size.cjs",
    "upload:weixin": "node scripts/upload-weixin.cjs",
    "tabbar:generate": "node scripts/generate-weixin-tab-bar.cjs",
    "tabbar:check": "node scripts/generate-weixin-tab-bar.cjs --check",
    "theme:generate": "node scripts/generate-theme.cjs",
    "theme:check": "node scripts/generate-theme.cjs --check"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030220261016001",
    "@noble/hashes": "^1.8.0",
    "echarts": "^6.1.0",
    "gm-crypto": "^0.1.12",
    "jszip": "^3.10.1",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-uts-v1": "3.0.0-alpha-5030220261016001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030220261016001",
    "@playwright/test": "1.57.0",
    "esbuild": "0.20.2",
    "miniprogram-ci": "2.1.31",
    "sass": "^1.77.8",
    "vite": "5.2.8"
  }
}
